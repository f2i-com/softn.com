// dos_jit.logic — compiles hot 32-bit basic blocks into JavaScript.
//
// The interpreter spends most of its time on overhead rather than work: for
// every emulated instruction it fetches bytes one call at a time, decodes a
// ModR/M byte, dispatches through a table, and calls an operand getter and
// setter. Measured on DOOM, that is around 50 operations of bookkeeping for
// perhaps 5 operations of actual effect.
//
// The decoded-block cache in dos_bc.logic removes the fetch and decode, but
// still makes one indirect call per instruction, and it only handles 16-bit
// code. This goes further: it emits JavaScript source for a whole run of
// instructions and hands it to `new Function`, so a block becomes one call
// into straight-line code with the registers as plain array indices.
//
// A profile of DOOM shows 17 instruction forms covering 90% of everything it
// executes, which is what makes this worth doing: compile those, and end the
// block wherever something unsupported appears so the interpreter can take
// over. Correctness never depends on the compiler being complete.
//
// The one structural trick: when a block ends in a branch back to its own
// start, the body is wrapped in a loop, so an inner rendering loop runs to
// completion inside a single call.

let DOS_JIT_ENABLED = 1;
let DOS_JIT_SLOTS = 16384;
let DOS_JIT_TAG = null;          // physical address occupying each slot
let DOS_JIT_FN = null;           // the compiled function
let DOS_JIT_HOT = null;          // times an address has been reached
let DOS_JIT_HOT_TAG = null;      // which address those counts belong to
let DOS_JIT_CODEPAGE = null;     // one bit per byte of compiled code
// Byte ranges the trace being compiled decoded from, applied once it is known
// the compile succeeded.
let DOS_JIT_SPANS = null;
let DOS_JIT_SPANS_N = 0;
let DOS_JIT_THRESHOLD = 32;    // executions before a trace is worth its budget

// Scalars shared with generated code. Compiled functions cannot see module
// level `let` bindings, so anything they read or write lives here.
//   0 EIP   1 EFLAGS   2 lazy op   3 lazy dst   4 lazy src   5 lazy res
//   6 lazy size   7 cycles   8 VGA unchained   9 bail flag
let DOS_JIT_ST = null;
let DOS_JIT_MASK = null;
let DOS_JIT_SIGN = null;

let DOS_JIT_COMPILED = 0;
let DOS_JIT_CALLS = 0;
let DOS_JIT_INSNS = 0;
let DOS_JIT_STEPS = 0;
let DOS_JIT_FAILED = 0;
let DOS_JIT_TOTAL_INSNS = 0;

// Decode cursor while compiling.
let DOS_JC = 0;
let DOS_JC_OK = 1;

// The host engine meters code compiled at runtime, and the allowance is for
// the life of the VM: source bytes are counted when a function is created and
// never given back, and running out is terminal rather than an exception you
// can catch. So the compiler has to budget itself. These sit well under the
// engine's ceilings (256 compiles, 1 MB of retained source) to leave room for
// anything else in the app that compiles code.
let DOS_JIT_MAX_COMPILES = 6000;
let DOS_JIT_MAX_SOURCE = 15000000;
let DOS_JIT_SOURCE_BYTES = 0;
let DOS_JIT_BUDGET_SPENT = 0;
// The lazy operation the code emitted so far will leave behind, or 0 for none.
// Block entry folds the flags, so this starts at 0 and is exact from there.
let DOS_JIT_PENDING = 0;

function dosJit_init() {
  DOS_JIT_TAG = new Int32Array(DOS_JIT_SLOTS);
  DOS_JIT_FN = new Array(DOS_JIT_SLOTS);
  DOS_JIT_HOT = new Uint16Array(DOS_JIT_SLOTS);
  DOS_JIT_HOT_TAG = new Int32Array(DOS_JIT_SLOTS);
  DOS_JIT_CODEPAGE = new Uint8Array(2097152);   // 16 MB of address space, one bit each
  DOS_JIT_SPANS = new Int32Array(512);
  DOS_JIT_ST = new Uint32Array(16);
  DOS_JIT_MASK = new Uint32Array([0xFFFFFFFF, 0xFF, 0xFFFF, 0xFFFFFFFF, 0xFFFFFFFF]);
  DOS_JIT_SIGN = new Uint32Array([0x80000000, 0x80, 0x8000, 0x80000000, 0x80000000]);
  dosJit_flush();
}

// Note that this does not give the engine's dynamic-code allowance back: what
// has been compiled has been charged for. Flushing is therefore only done when
// correctness demands it, never to reclaim space.
function dosJit_flush() {
  if (DOS_JIT_TAG === null) return;
  for (let i = 0; i < DOS_JIT_SLOTS; i++) {
    DOS_JIT_TAG[i] = -1;
    DOS_JIT_FN[i] = null;
    DOS_JIT_HOT[i] = 0;
    DOS_JIT_HOT_TAG[i] = -1;
  }
  DOS_JIT_CODEPAGE.fill(0);
}

// A write to a byte that was compiled throws the cache away. Anything else,
// including a write to data sitting next to code, is left alone.
function dosJit_touch(addr) {
  if (DOS_JIT_CODEPAGE === null) return;
  let a = addr & 0xFFFFFF;
  if ((DOS_JIT_CODEPAGE[a >>> 3] >> (a & 7)) & 1) dosJit_flush();
}

function dosJit_markCode(from, to) {
  let a = from & 0xFFFFFF;
  let b = to & 0xFFFFFF;
  while (a < b) {
    DOS_JIT_CODEPAGE[a >>> 3] = DOS_JIT_CODEPAGE[a >>> 3] | (1 << (a & 7));
    a++;
  }
}

// ---------------------------------------------------------------------------
// Reading the instruction stream while compiling
// ---------------------------------------------------------------------------

function dosJc_u8() { let v = DOS_RAM[DOS_JC & 0xFFFFFF]; DOS_JC = DOS_JC + 1; return v; }
function dosJc_s8() { let v = dosJc_u8(); return (v < 128) ? v : (v - 256); }
function dosJc_u16() { let a = dosJc_u8(); return a | (dosJc_u8() << 8); }
function dosJc_s16() { let v = dosJc_u16(); return (v < 32768) ? v : (v - 65536); }
function dosJc_u32() {
  let a = dosJc_u8(); let b = dosJc_u8(); let c = dosJc_u8(); let d = dosJc_u8();
  return ((a | (b << 8) | (c << 16) | (d << 24)) >>> 0);
}
function dosJc_s32() { let v = dosJc_u32(); return (v < 2147483648) ? v : (v - 4294967296); }

// ---------------------------------------------------------------------------
// Operand expressions
// ---------------------------------------------------------------------------

function dosJit_reg8Slot(r) { return (r < 4) ? (r * 4) : ((r - 4) * 4 + 1); }

// Which of the eight the trace reads, and which it writes back.
let DOS_JIT_RUSE = 0;
let DOS_JIT_RMOD = 0;

function dosJit_rName(r) { return "e" + r; }

function dosJit_regGet(r, size) {
  if (size === 1) {
    if (r < 4) { DOS_JIT_RUSE = DOS_JIT_RUSE | (1 << r); return "(" + dosJit_rName(r) + "&255)"; }
    let b = r - 4;
    DOS_JIT_RUSE = DOS_JIT_RUSE | (1 << b);
    return "((" + dosJit_rName(b) + ">>>8)&255)";
  }
  DOS_JIT_RUSE = DOS_JIT_RUSE | (1 << r);
  if (size === 2) return "(" + dosJit_rName(r) + "&65535)";
  return dosJit_rName(r);
}

function dosJit_regSet(r, size, expr) {
  if (size === 1) {
    if (r < 4) {
      DOS_JIT_RUSE = DOS_JIT_RUSE | (1 << r);
      DOS_JIT_RMOD = DOS_JIT_RMOD | (1 << r);
      let n = dosJit_rName(r);
      return n + "=((" + n + "&4294967040)|((" + expr + ")&255))>>>0;";
    }
    let b = r - 4;
    DOS_JIT_RUSE = DOS_JIT_RUSE | (1 << b);
    DOS_JIT_RMOD = DOS_JIT_RMOD | (1 << b);
    let n2 = dosJit_rName(b);
    return n2 + "=((" + n2 + "&4294902015)|(((" + expr + ")&255)<<8))>>>0;";
  }
  DOS_JIT_RUSE = DOS_JIT_RUSE | (1 << r);
  DOS_JIT_RMOD = DOS_JIT_RMOD | (1 << r);
  let n3 = dosJit_rName(r);
  if (size === 2) return n3 + "=((" + n3 + "&4294901760)|((" + expr + ")&65535))>>>0;";
  return n3 + "=(" + expr + ")>>>0;";
}

// Address expressions and the stack use the same locals.
function dosJit_rRef(r) {
  DOS_JIT_RUSE = DOS_JIT_RUSE | (1 << r);
  return dosJit_rName(r);
}

// Bytes of the current instruction that hold an immediate the compiled code
// reads live rather than embedding. They are deliberately left out of the
// code map, because rewriting them does not invalidate anything.
let DOS_JIT_IMM_FROM = 0;
let DOS_JIT_IMM_TO = 0;

// An expression that reads `size` bytes from a known address in guest memory.
// The address is constant, so the index is constant too.
function dosJit_liveImm(addr, size, signed) {
  let a = addr & 0xFFFFFF;
  if (size === 1) {
    if (signed) return "((RAM[" + a + "]<<24)>>24)";
    return "RAM[" + a + "]";
  }
  if (size === 2) {
    if ((a & 1) === 0) return signed ? ("((RAM16[" + (a >>> 1) + "]<<16)>>16)") : ("RAM16[" + (a >>> 1) + "]");
    return "(RAM[" + a + "]|(RAM[" + (a + 1) + "]<<8))";
  }
  if ((a & 3) === 0) return "RAM32[" + (a >>> 2) + "]";
  return "((RAM[" + a + "]|(RAM[" + (a + 1) + "]<<8)|(RAM[" + (a + 2) +
         "]<<16)|(RAM[" + (a + 3) + "]<<24))>>>0)";
}

// ModR/M state for the instruction being compiled.
let DOS_JM_MOD = 0;
let DOS_JM_REG = 0;
let DOS_JM_RM = 0;
let DOS_JM_ADDR = "";      // JS expression for the effective address, "" if register
// The same address before it is narrowed to the 16 MB of physical memory. LEA
// hands the program the full 32-bit value and must not see the mask.
let DOS_JM_OFF = "";

// Decode a 32-bit ModR/M (and SIB) into an address expression. Sets
// DOS_JC_OK to 0 for anything not handled, which ends the block.
function dosJit_modrm() {
  let m = dosJc_u8();
  DOS_JM_MOD = (m >> 6) & 3;
  DOS_JM_REG = (m >> 3) & 7;
  DOS_JM_RM = m & 7;
  DOS_JM_ADDR = "";
  DOS_JM_OFF = "";
  if (DOS_JM_MOD === 3) return;

  let base = "";
  if (DOS_JM_RM === 4) {
    let sib = dosJc_u8();
    let scale = 1 << ((sib >> 6) & 3);
    let index = (sib >> 3) & 7;
    let b = sib & 7;
    let parts = [];
    if (b === 5 && DOS_JM_MOD === 0) parts.push(String(dosJc_u32()));
    else parts.push(dosJit_rRef(b));
    if (index !== 4) {
      if (scale === 1) parts.push(dosJit_rRef(index));
      else parts.push(dosJit_rRef(index) + "*" + scale);
    }
    base = parts.join("+");
  } else if (DOS_JM_MOD === 0 && DOS_JM_RM === 5) {
    base = String(dosJc_u32());
  } else {
    base = dosJit_rRef(DOS_JM_RM);
  }

  if (DOS_JM_MOD === 1) {
    let d = dosJc_s8();
    if (d !== 0) base = base + ((d < 0) ? ("-" + (-d)) : ("+" + d));
  } else if (DOS_JM_MOD === 2) {
    let d = dosJc_s32();
    if (d !== 0) base = base + ((d < 0) ? ("-" + (-d)) : ("+" + d));
  }
  DOS_JM_OFF = "((" + base + ")>>>0)";
  DOS_JM_ADDR = "((" + base + ")&16777215)";
}

// A memory read at address temp `t`. VGA memory in unchained mode lives in
// the plane array, so the window is guarded; outside it this is one index.
function dosJit_memRead(tExpr, size) {
  // The operand is parenthesised because `&` and `<` bind more loosely than
  // the operators it is spliced between; without this a compound address
  // like `(ta+4)&16777215` read from the wrong place entirely.
  let t = "(" + tExpr + ")";
  // The VGA window is tested first because, for the program's own data, the
  // first comparison fails and nothing else is evaluated.
  let guard = t + "<720896&&" + t + ">=655360&&vg===1";
  if (size === 1) return "(" + guard + "?RD8(" + t + "):RAM[" + t + "])";
  if (size === 2) {
    return "(" + guard + "?RD16(" + t + "):((" + t + "&1)===0?RAM16[" + t + ">>>1]:RDU16(" + t + ")))";
  }
  return "(" + guard + "?RD32(" + t + "):((" + t + "&3)===0?RAM32[" + t + ">>>2]:RDU32(" + t + ")))";
}

// Writes go through a helper: it carries the code-page barrier for both
// caches and the unchained-VGA path, and writes are a small fraction of
// instructions so one call each is affordable.
// The guard covers the only two reasons a store cannot be a plain array
// write: the page holds code some cache has already compiled or decoded, or
// the address is VGA memory while the card is unchained.
function dosJit_wGuard(tExpr) {
  let t = "(" + tExpr + ")";
  return "(((CP[" + t + ">>>3]>>(" + t + "&7))&1)!==0||(vg===1&&" + t +
         ">=655360&&" + t + "<720896))";
}

function dosJit_memWrite(tExpr, size, valExpr) {
  let t = "(" + tExpr + ")";
  // Inline only the store that actually runs; everything else -- a page that
  // holds compiled code, unchained VGA, an unaligned wider store -- is one
  // helper call, which is also where the write barrier lives.
  let out = "tv=" + valExpr + ";";
  if (size === 1) {
    out += "if(" + dosJit_wGuard(t) + "){W8(" + t + ",tv);}else{RAM[" + t + "]=tv&255;}";
  } else if (size === 2) {
    out += "if(" + dosJit_wGuard(t) + "||(" + t + "&1)!==0){W16(" + t + ",tv);}else{RAM16[" +
           t + ">>>1]=tv&65535;}";
  } else {
    out += "if(" + dosJit_wGuard(t) + "||(" + t + "&3)!==0){W32(" + t + ",tv);}else{RAM32[" +
           t + ">>>2]=tv>>>0;}";
  }
  return out;
}

// ---------------------------------------------------------------------------
// The compiler
// ---------------------------------------------------------------------------

// ALU operation index -> (expression builder, lazy op code). Index follows the
// x86 encoding: 0 ADD, 1 OR, 2 ADC, 3 SBB, 4 AND, 5 SUB, 6 XOR, 7 CMP.
function dosJit_aluExpr(aop, a, b) {
  if (aop === 0) return "(" + a + "+" + b + ")";
  if (aop === 1) return "(" + a + "|" + b + ")";
  if (aop === 4) return "(" + a + "&" + b + ")";
  if (aop === 5) return "(" + a + "-" + b + ")";
  if (aop === 6) return "(" + a + "^" + b + ")";
  if (aop === 7) return "(" + a + "-" + b + ")";
  return "";
}
function dosJit_aluLazy(aop) {
  if (aop === 0) return 1;                 // ADD
  if (aop === 5 || aop === 7) return 2;    // SUB / CMP
  return 3;                                // logic
}
function dosJit_aluSupported(aop) {
  return (aop === 0 || aop === 1 || aop === 4 || aop === 5 || aop === 6 || aop === 7) ? 1 : 0;
}

// Record the lazy flag state for an ALU result.
function dosJit_setFlags(aop, size, dExpr, sExpr, rTmp) {
  DOS_JIT_PENDING = dosJit_aluLazy(aop);
  DOS_JIT_PSIZE = size;
  let mask = (size === 1) ? "255" : ((size === 2) ? "65535" : "4294967295");
  let out = "fo=" + dosJit_aluLazy(aop) +
            ";fd=" + dosJit_narrow(dExpr, size) +
            ";fs=" + dosJit_narrow(sExpr, size) +
            ";fr=" + dosJit_narrow(rTmp, size) +
            ";fz=" + size + ";";
  return out;
}

// Compile one instruction into `body`. Returns 1 if it was handled, 0 to end
// the block. `body` is an array of source lines.
function dosJit_one(body, tmp) {
  let start = DOS_JC;
  DOS_JIT_IMM_FROM = 0;
  DOS_JIT_IMM_TO = 0;
  let op = dosJc_u8();
  let size = 4;

  // Prefixes, in whatever order they appear. Recursing on one of these used to
  // lose an operand-size prefix that came before it, which quietly turned
  // 16-bit instructions into 32-bit ones.
  let pguard = 0;
  while (pguard < 4) {
    pguard++;
    if (op === 0x66) { size = 2; op = dosJc_u8(); continue; }
    // Addresses are flat in 32-bit mode, so a segment override changes nothing.
    if (op === 0x2E || op === 0x3E || op === 0x26 || op === 0x36 ||
        op === 0x64 || op === 0x65) { op = dosJc_u8(); continue; }
    break;
  }

  // ---- two-byte opcodes ----------------------------------------------------
  // Checked before the ALU block: 0x0F is numerically inside its range.
  if (op === 0x0F) {
    let op2 = dosJc_u8();
    if (op2 === 0xB6 || op2 === 0xB7 || op2 === 0xBE || op2 === 0xBF) {
      let srcSize = (op2 === 0xB6 || op2 === 0xBE) ? 1 : 2;
      let signed = (op2 === 0xBE || op2 === 0xBF) ? 1 : 0;
      dosJit_modrm();
      if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
      let srcE = "";
      if (DOS_JM_ADDR === "") srcE = dosJit_regGet(DOS_JM_RM, srcSize);
      else { body.push("ta=" + DOS_JM_ADDR + ";"); srcE = dosJit_memRead("ta", srcSize); }
      let e = srcE;
      if (signed) e = (srcSize === 1) ? ("((" + srcE + "<<24)>>24)") : ("((" + srcE + "<<16)>>16)");
      body.push(dosJit_regSet(DOS_JM_REG, size, e));
      return 1;
    }
    if (op2 >= 0x90 && op2 <= 0x9F) {          // SETcc r/m8
      let cond = dosJit_condExpr(op2 & 0x0F);
      if (cond === "") { DOS_JC = start; return 0; }
      dosJit_modrm();
      if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
      body.push("t0=(" + cond + ")?1:0;");
      if (DOS_JM_ADDR === "") body.push(dosJit_regSet(DOS_JM_RM, 1, "t0"));
      else { body.push("ta=" + DOS_JM_ADDR + ";"); body.push(dosJit_memWrite("ta", 1, "t0")); }
      return 1;
    }
    if ((op2 === 0xA0 || op2 === 0xA8) && size === 4) {   // PUSH FS / PUSH GS
      let sr = (op2 === 0xA0) ? 4 : 5;
      body.push("t0=SEGS[" + sr + "];" + dosJit_rRef(4) + "=(e4-4)>>>0;ta=e4&16777215;");
      DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
      body.push(dosJit_memWrite("ta", 4, "t0"));
      return 1;
    }
    if ((op2 === 0xA1 || op2 === 0xA9) && size === 4) {   // POP FS / POP GS
      let sr2 = (op2 === 0xA1) ? 4 : 5;
      body.push("ta=" + dosJit_rRef(4) + "&16777215;t0=" + dosJit_memRead("ta", 4) +
                ";e4=(e4+4)>>>0;SEGS[" + sr2 + "]=t0&65535;");
      DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
      return 1;
    }
    if (op2 === 0xA4 || op2 === 0xAC) {         // SHLD / SHRD r/m, r, imm8
      dosJit_modrm();
      if (DOS_JC_OK === 0 || DOS_JM_ADDR !== "" || size !== 4) { DOS_JC = start; return 0; }
      let n = dosJc_u8() & 31;
      if (n === 0) return 1;
      let dstE = dosJit_regGet(DOS_JM_RM, 4);
      let srcE = dosJit_regGet(DOS_JM_REG, 4);
      body.push("t0=" + dstE + ";t1=" + srcE + ";");
      if (op2 === 0xAC) body.push("t2=((t0>>>" + n + ")|(t1<<" + (32 - n) + "))>>>0;");
      else body.push("t2=((t0<<" + n + ")|(t1>>>" + (32 - n) + "))>>>0;");
      // The shifted-out bit becomes CF; the rest come from the result.
      if (op2 === 0xAC) body.push("t3=(t0>>>" + (n - 1) + ")&1;");
      else body.push("t3=(t0>>>" + (32 - n) + ")&1;");
      body.push("t1=t2&255;t1^=t1>>4;t1^=t1>>2;t1^=t1>>1;");
      body.push("ST[1]=(ST[1]&~197)|(t3?1:0)|((t1&1)?0:4)|((t2===0)?64:0)|((t2&2147483648)?128:0);");
      body.push("fo=0;");
      DOS_JIT_PENDING = 0;
      body.push(dosJit_regSet(DOS_JM_RM, 4, "t2"));
      return 1;
    }
    if (op2 === 0xAF) {                        // IMUL r32, r/m32
      dosJit_modrm();
      if (DOS_JC_OK === 0 || size !== 4) { DOS_JC = start; return 0; }
      let srcE = "";
      if (DOS_JM_ADDR === "") srcE = dosJit_regGet(DOS_JM_RM, 4);
      else { body.push("ta=" + DOS_JM_ADDR + ";"); srcE = dosJit_memRead("ta", 4); }
      body.push("t0=" + dosJit_regGet(DOS_JM_REG, 4) + "|0;t1=(" + srcE + ")|0;t2=Math.imul(t0,t1)>>>0;");
      body.push(dosJit_regSet(DOS_JM_REG, 4, "t2"));
    body.push("t3=t0*t1;tv=t2&255;tv^=tv>>4;tv^=tv>>2;tv^=tv>>1;" +
              "ST[1]=(ST[1]&~2245)|((t2===0)?64:0)|((t2&2147483648)?128:0)|((tv&1)?0:4)|" +
              "((t3>=-2147483648&&t3<=2147483647)?0:2049);");
      body.push("fo=0;");
      DOS_JIT_PENDING = 0;
      return 1;
    }
    DOS_JC = start;
    return 0;
  }

  // ---- ALU r/m,r and r,r/m and accumulator,imm -----------------------------
  // Only low bits 0-5 are ALU encodings; 6 and 7 are segment pushes, pops and
  // the decimal adjusts, which are handled further down.
  if (op < 0x40 && (op & 7) < 6) {
    let lo = op & 7;
    let aop = (op >> 3) & 7;
    if (dosJit_aluSupported(aop) === 0) { DOS_JC = start; return 0; }
    let store = (aop === 7) ? 0 : 1;

    if (lo === 0 || lo === 1 || lo === 2 || lo === 3) {
      let sz = (lo === 0 || lo === 2) ? 1 : size;
      dosJit_modrm();
      if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
      let regE = dosJit_regGet(DOS_JM_REG, sz);
      let toReg = (lo === 2 || lo === 3);
      if (DOS_JM_ADDR === "") {
        let rmE = dosJit_regGet(DOS_JM_RM, sz);
        let a = toReg ? regE : rmE;
        let b = toReg ? rmE : regE;
        body.push("t0=" + a + ";t1=" + b + ";t2=" + dosJit_aluExpr(aop, "t0", "t1") + ";");
        body.push(dosJit_setFlags(aop, sz, "t0", "t1", "t2"));
        if (store) body.push(toReg ? dosJit_regSet(DOS_JM_REG, sz, "t2") : dosJit_regSet(DOS_JM_RM, sz, "t2"));
      } else {
        body.push("ta=" + DOS_JM_ADDR + ";");
        let memE = dosJit_memRead("ta", sz);
        let a = toReg ? regE : memE;
        let b = toReg ? memE : regE;
        body.push("t0=" + a + ";t1=" + b + ";t2=" + dosJit_aluExpr(aop, "t0", "t1") + ";");
        body.push(dosJit_setFlags(aop, sz, "t0", "t1", "t2"));
        if (store) {
          if (toReg) body.push(dosJit_regSet(DOS_JM_REG, sz, "t2"));
          else body.push(dosJit_memWrite("ta", sz, "t2"));
        }
      }
      return 1;
    }
    if (lo === 4 || lo === 5) {
      let sz = (lo === 4) ? 1 : size;
      let imm = (sz === 1) ? dosJc_u8() : ((sz === 2) ? dosJc_u16() : dosJc_u32());
      let accE = dosJit_regGet(0, sz);
      body.push("t0=" + accE + ";t1=" + imm + ";t2=" + dosJit_aluExpr(aop, "t0", "t1") + ";");
      body.push(dosJit_setFlags(aop, sz, "t0", "t1", "t2"));
      if (store) body.push(dosJit_regSet(0, sz, "t2"));
      return 1;
    }
    DOS_JC = start;
    return 0;
  }

  // ---- INC / DEC r32 -------------------------------------------------------
  if (op >= 0x40 && op <= 0x4F) {
    let r = op & 7;
    let dec = (op >= 0x48) ? 1 : 0;
    let e = dosJit_regGet(r, size);
    // INC and DEC leave CF alone. Rather than fold every flag, carry the one
    // that survives into the flag word with an expression the compiler can
    // write out, because it knows which operation is pending.
    if (DOS_JIT_PENDING !== 0) {
      let cfe = dosJit_flagExpr(0);
      if (cfe === "") body.push(dosJit_spill() + "FC();" + dosJit_reload());
      else body.push("ST[1]=(" + cfe + ")?(ST[1]|1):(ST[1]&~1);");
      DOS_JIT_PENDING = 0;
    }
    body.push("t0=" + e + ";t2=" + (dec ? "(t0-1)" : "(t0+1)") + ";");
    let mask = (size === 2) ? "65535" : "4294967295";
    body.push("fo=" + (dec ? 7 : 6) + ";fd=" + dosJit_narrow("t0", size) +
              ";fs=1;fr=" + dosJit_narrow("t2", size) + ";fz=" + size + ";");
    DOS_JIT_PENDING = dec ? 7 : 6;
    DOS_JIT_PSIZE = size;
    body.push(dosJit_regSet(r, size, "t2"));
    return 1;
  }

  // ---- PUSH / POP r32 ------------------------------------------------------
  if (op >= 0x50 && op <= 0x57) {
    if (size !== 4) { DOS_JC = start; return 0; }
    body.push("t0=" + dosJit_regGet(op & 7, 4) + ";" + dosJit_rRef(4) +
              "=(e4-4)>>>0;ta=e4&16777215;");
    DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
    body.push(dosJit_memWrite("ta", 4, "t0"));
    return 1;
  }
  if (op >= 0x58 && op <= 0x5F) {
    if (size !== 4) { DOS_JC = start; return 0; }
    body.push("ta=" + dosJit_rRef(4) + "&16777215;t0=" + dosJit_memRead("ta", 4) +
              ";e4=(e4+4)>>>0;");
    DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
    body.push(dosJit_regSet(op & 7, 4, "t0"));
    return 1;
  }

  // ---- group 1: ALU r/m, imm ----------------------------------------------
  if (op === 0x80 || op === 0x81 || op === 0x83) {
    let sz = (op === 0x80) ? 1 : size;
    dosJit_modrm();
    if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
    let aop = DOS_JM_REG;
    if (dosJit_aluSupported(aop) === 0) { DOS_JC = start; return 0; }
    let store = (aop === 7) ? 0 : 1;
    // Read the immediate where it lives, so a program that rewrites it is
    // followed without recompiling anything.
    let immAt = DOS_JC >>> 0;
    let immE = "";
    if (op === 0x80) { dosJc_u8(); immE = dosJit_liveImm(immAt, 1, 0); }
    else if (op === 0x83) {
      dosJc_s8();
      immE = (sz === 2) ? ("(" + dosJit_liveImm(immAt, 1, 1) + "&65535)")
                        : ("((" + dosJit_liveImm(immAt, 1, 1) + ")>>>0)");
    } else if (sz === 2) { dosJc_u16(); immE = dosJit_liveImm(immAt, 2, 0); }
    else { dosJc_u32(); immE = dosJit_liveImm(immAt, 4, 0); }
    DOS_JIT_IMM_FROM = immAt;
    DOS_JIT_IMM_TO = DOS_JC >>> 0;
    let imm = immE;
    if (DOS_JM_ADDR === "") {
      body.push("t0=" + dosJit_regGet(DOS_JM_RM, sz) + ";t1=" + imm + ";t2=" + dosJit_aluExpr(aop, "t0", "t1") + ";");
      body.push(dosJit_setFlags(aop, sz, "t0", "t1", "t2"));
      if (store) body.push(dosJit_regSet(DOS_JM_RM, sz, "t2"));
    } else {
      body.push("ta=" + DOS_JM_ADDR + ";t0=" + dosJit_memRead("ta", sz) + ";t1=" + imm + ";t2=" + dosJit_aluExpr(aop, "t0", "t1") + ";");
      body.push(dosJit_setFlags(aop, sz, "t0", "t1", "t2"));
      if (store) body.push(dosJit_memWrite("ta", sz, "t2"));
    }
    return 1;
  }

  // ---- TEST r/m, r ---------------------------------------------------------
  if (op === 0x84 || op === 0x85) {
    let sz = (op === 0x84) ? 1 : size;
    dosJit_modrm();
    if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
    let regE = dosJit_regGet(DOS_JM_REG, sz);
    if (DOS_JM_ADDR === "") body.push("t0=" + dosJit_regGet(DOS_JM_RM, sz) + ";t1=" + regE + ";t2=(t0&t1);");
    else body.push("ta=" + DOS_JM_ADDR + ";t0=" + dosJit_memRead("ta", sz) + ";t1=" + regE + ";t2=(t0&t1);");
    body.push(dosJit_setFlags(4, sz, "t0", "t1", "t2"));
    return 1;
  }

  // ---- MOV r/m,r and r,r/m -------------------------------------------------
  if (op >= 0x88 && op <= 0x8B) {
    let sz = (op === 0x88 || op === 0x8A) ? 1 : size;
    let toReg = (op === 0x8A || op === 0x8B);
    dosJit_modrm();
    if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
    if (DOS_JM_ADDR === "") {
      if (toReg) body.push(dosJit_regSet(DOS_JM_REG, sz, dosJit_regGet(DOS_JM_RM, sz)));
      else body.push(dosJit_regSet(DOS_JM_RM, sz, dosJit_regGet(DOS_JM_REG, sz)));
    } else if (toReg) {
      body.push("ta=" + DOS_JM_ADDR + ";");
      body.push(dosJit_regSet(DOS_JM_REG, sz, dosJit_memRead("ta", sz)));
    } else {
      body.push("ta=" + DOS_JM_ADDR + ";");
      body.push(dosJit_memWrite("ta", sz, dosJit_regGet(DOS_JM_REG, sz)));
    }
    return 1;
  }

  // ---- LEA -----------------------------------------------------------------
  if (op === 0x8D) {
    dosJit_modrm();
    if (DOS_JC_OK === 0 || DOS_JM_ADDR === "") { DOS_JC = start; return 0; }
    body.push("ta=" + DOS_JM_OFF + ";");
    body.push(dosJit_regSet(DOS_JM_REG, size, "ta"));
    return 1;
  }

  // ---- MOV r, imm ----------------------------------------------------------
  if (op >= 0xB0 && op <= 0xB7) { body.push(dosJit_regSet(op & 7, 1, String(dosJc_u8()))); return 1; }
  if (op >= 0xB8 && op <= 0xBF) {
    let imm = (size === 2) ? dosJc_u16() : dosJc_u32();
    body.push(dosJit_regSet(op & 7, size, String(imm)));
    return 1;
  }

  // ---- MOV r/m, imm --------------------------------------------------------
  if (op === 0xC6 || op === 0xC7) {
    let sz = (op === 0xC6) ? 1 : size;
    dosJit_modrm();
    if (DOS_JC_OK === 0 || DOS_JM_REG !== 0) { DOS_JC = start; return 0; }
    let imm = (sz === 1) ? dosJc_u8() : ((sz === 2) ? dosJc_u16() : dosJc_u32());
    if (DOS_JM_ADDR === "") body.push(dosJit_regSet(DOS_JM_RM, sz, String(imm)));
    else { body.push("ta=" + DOS_JM_ADDR + ";"); body.push(dosJit_memWrite("ta", sz, String(imm))); }
    return 1;
  }

  // ---- shifts by an immediate ---------------------------------------------
  if (op === 0xC1 || op === 0xC0 || op === 0xD0 || op === 0xD1) {
    let sz = (op === 0xC0 || op === 0xD0) ? 1 : size;
    dosJit_modrm();
    if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
    let sub = DOS_JM_REG;
    let byOne = (op === 0xD0 || op === 0xD1) ? 1 : 0;
    let n = byOne ? 1 : (dosJc_u8() & 31);
    let isMemSh = (DOS_JM_ADDR !== "");
    if (isMemSh) body.push("ta=" + DOS_JM_ADDR + ";");
    let src = isMemSh ? dosJit_memRead("ta", sz) : dosJit_regGet(DOS_JM_RM, sz);
    if (n === 0) return 1;
    let expr = "";
    if (sub === 4) expr = "(t0<<" + n + ")";                       // SHL
    else if (sub === 5) expr = "(t0>>>" + n + ")";                 // SHR
    else if (sub === 7) {                                          // SAR
      if (sz === 4) expr = "((t0|0)>>" + n + ")";
      else if (sz === 2) expr = "(((t0<<16)>>16)>>" + n + ")";
      else expr = "(((t0<<24)>>24)>>" + n + ")";
    } else { DOS_JC = start; return 0; }
    let mask = (sz === 1) ? "255" : ((sz === 2) ? "65535" : "4294967295");
    let sign = (sz === 1) ? "128" : ((sz === 2) ? "32768" : "2147483648");
    let bits = sz * 8;
    // A shift sets CF from the last bit shifted out, and ZF/SF/PF from the
    // result. Recording it as a lazy logic result would clear that carry, so
    // the flags are written here and the lazy slots emptied.
    body.push("t0=" + src + ";t2=" + dosJit_narrow(expr, sz) + ";");
    if (sub === 4) {
      if (n <= bits) body.push("t3=(t0>>>" + (bits - n) + ")&1;");
      else body.push("t3=0;");
    } else {
      if (n <= bits) body.push("t3=(t0>>>" + (n - 1) + ")&1;");
      else body.push("t3=0;");
    }
    body.push("t1=t2&255;t1^=t1>>4;t1^=t1>>2;t1^=t1>>1;");
    body.push("ST[1]=(ST[1]&~197)|(t3?1:0)|((t1&1)?0:4)|((t2===0)?64:0)|((t2&" + sign + ")?128:0);");
    body.push("fo=0;");
    DOS_JIT_PENDING = 0;
    if (isMemSh) body.push(dosJit_memWrite("ta", sz, "t2"));
    else body.push(dosJit_regSet(DOS_JM_RM, sz, "t2"));
    return 1;
  }

  // ---- PUSHAD / POPAD ------------------------------------------------------
  if (op === 0x60 && size === 4) {
    body.push("t3=" + dosJit_rRef(4) + ";");
    for (let r = 0; r < 8; r++) {
      let v = (r === 4) ? "t3" : dosJit_regGet(r, 4);
      body.push("t0=" + v + ";e4=(e4-4)>>>0;ta=e4&16777215;");
      body.push(dosJit_memWrite("ta", 4, "t0"));
    }
    DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
    return 1;
  }
  if (op === 0x61 && size === 4) {
    for (let r = 7; r >= 0; r--) {
      body.push("ta=" + dosJit_rRef(4) + "&16777215;t0=" + dosJit_memRead("ta", 4) + ";e4=(e4+4)>>>0;");
      if (r !== 4) body.push(dosJit_regSet(r, 4, "t0"));   // ESP is discarded
    }
    DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
    return 1;
  }

  // ---- TEST accumulator, immediate ----------------------------------------
  if (op === 0xA8 || op === 0xA9) {
    let sz = (op === 0xA8) ? 1 : size;
    let imm = (sz === 1) ? dosJc_u8() : ((sz === 2) ? dosJc_u16() : dosJc_u32());
    body.push("t0=" + dosJit_regGet(0, sz) + ";t1=" + imm + ";t2=(t0&t1);");
    body.push(dosJit_setFlags(4, sz, "t0", "t1", "t2"));
    return 1;
  }

  // ---- port output ---------------------------------------------------------
  if (op === 0xEE || op === 0xEF || op === 0xE6 || op === 0xE7) {
    let portE = (op === 0xEE || op === 0xEF) ? dosJit_regGet(2, 2) : String(dosJc_u8());
    if (op === 0xEE || op === 0xE6) {
      body.push("OUT8(" + portE + "," + dosJit_regGet(0, 1) + ");");
    } else {
      body.push("t3=" + portE + ";t0=" + dosJit_regGet(0, size) + ";");
      body.push("OUT8(t3,t0&255);OUT8(t3+1,(t0>>8)&255);");
      if (size === 4) body.push("OUT8(t3+2,(t0>>16)&255);OUT8(t3+3,(t0>>>24)&255);");
    }
    // A port write can switch the card between chained and unchained, and
    // the trace holds that flag in a local from its entry. DOOM's sequencer
    // code flips it and then reads video memory in the same trace, so the
    // local has to be refreshed here or every read after it takes the wrong
    // path.
    body.push("vg=ST[8];");
    return 1;
  }
  if (op === 0xEC || op === 0xE4) {
    let portE2 = (op === 0xEC) ? dosJit_regGet(2, 2) : String(dosJc_u8());
    body.push(dosJit_regSet(0, 1, "IN8(" + portE2 + ")"));
    return 1;
  }

  // ---- shift by CL ---------------------------------------------------------
  if (op === 0xD2 || op === 0xD3) {
    let sz = (op === 0xD2) ? 1 : size;
    dosJit_modrm();
    if (DOS_JC_OK === 0 || DOS_JM_ADDR !== "") { DOS_JC = start; return 0; }
    let sub = DOS_JM_REG;
    if (sub !== 4 && sub !== 5 && sub !== 7) { DOS_JC = start; return 0; }
    let srcR = dosJit_regGet(DOS_JM_RM, sz);
    let sign = dosJit_signLit(sz);
    let bits = sz * 8;
    body.push("t3=" + dosJit_regGet(1, 1) + "&31;");
    // A count of zero leaves every flag alone, so the whole thing is skipped.
    body.push("if(t3!==0){t0=" + srcR + ";");
    if (sub === 4) body.push("t2=" + dosJit_narrow("t0<<t3", sz) + ";t1=(t3<=" + bits + ")?((t0>>>(" + bits + "-t3))&1):0;");
    else if (sub === 5) body.push("t2=" + dosJit_narrow("t0>>>t3", sz) + ";t1=(t0>>>(t3-1))&1;");
    else {
      let sx = (sz === 4) ? "(t0|0)" : ((sz === 2) ? "((t0<<16)>>16)" : "((t0<<24)>>24)");
      body.push("t2=" + dosJit_narrow(sx + ">>t3", sz) + ";t1=(" + sx + ">>(t3-1))&1;");
    }
    body.push("tv=t2&255;tv^=tv>>4;tv^=tv>>2;tv^=tv>>1;");
    body.push("ST[1]=(ST[1]&~197)|(t1?1:0)|((tv&1)?0:4)|((t2===0)?64:0)|((t2&" + sign + ")?128:0);");
    body.push(dosJit_regSet(DOS_JM_RM, sz, "t2"));
    // A zero count leaves every flag as it was, which means whatever result
    // was pending still is. Fold it into the flag word rather than drop it,
    // so that afterwards nothing is pending on either path.
    body.push("}else if(fo!==0){ST[1]=FL(fo,fd,fs,fr,fz,ST[1]);}");
    body.push("fo=0;");
    DOS_JIT_PENDING = 0;
    return 1;
  }

  // ---- segment registers ---------------------------------------------------
  // Flat 32-bit mode keeps these at zero, but programs still move them about,
  // and each one that ended a trace cost more than it was worth.
  if (op === 0x8C) {
    dosJit_modrm();
    if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
    let v = "SEGS[" + (DOS_JM_REG & 7) + "]";
    if (DOS_JM_ADDR === "") body.push(dosJit_regSet(DOS_JM_RM, size, v));
    else { body.push("ta=" + DOS_JM_ADDR + ";"); body.push(dosJit_memWrite("ta", 2, v)); }
    return 1;
  }
  if (op === 0x8E) {
    dosJit_modrm();
    if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
    let src = "";
    if (DOS_JM_ADDR === "") src = dosJit_regGet(DOS_JM_RM, 2);
    else { body.push("ta=" + DOS_JM_ADDR + ";"); src = dosJit_memRead("ta", 2); }
    body.push("SEGS[" + (DOS_JM_REG & 7) + "]=(" + src + ")&65535;");
    return 1;
  }
  if (op === 0x06 || op === 0x0E || op === 0x16 || op === 0x1E) {
    if (size !== 4) { DOS_JC = start; return 0; }
    let sreg = (op === 0x06) ? 0 : ((op === 0x0E) ? 1 : ((op === 0x16) ? 2 : 3));
    body.push("t0=SEGS[" + sreg + "];" + dosJit_rRef(4) + "=(e4-4)>>>0;ta=e4&16777215;");
    DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
    body.push(dosJit_memWrite("ta", 4, "t0"));
    return 1;
  }
  if (op === 0x07 || op === 0x17 || op === 0x1F) {
    if (size !== 4) { DOS_JC = start; return 0; }
    let sreg2 = (op === 0x07) ? 0 : ((op === 0x17) ? 2 : 3);
    body.push("ta=" + dosJit_rRef(4) + "&16777215;t0=" + dosJit_memRead("ta", 4) +
              ";e4=(e4+4)>>>0;SEGS[" + sreg2 + "]=t0&65535;");
    DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
    return 1;
  }

  // ---- multiply and divide -------------------------------------------------
  // The reg field of the ModR/M byte says which group-3 operation this is.
  // Only MUL/IMUL/DIV/IDIV belong here; TEST, NOT and NEG fall through to the
  // group-3 handler below, which is why this peeks rather than decodes.
  if (op === 0xF7 && size === 4 && (((DOS_RAM[DOS_JC & 0xFFFFFF] >> 3) & 7) >= 4)) {
    dosJit_modrm();
    if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
    let sub = DOS_JM_REG;
    let srcE = "";
    if (DOS_JM_ADDR === "") srcE = dosJit_regGet(DOS_JM_RM, 4);
    else { body.push("ta=" + DOS_JM_ADDR + ";"); srcE = dosJit_memRead("ta", 4); }
    body.push("ST[12]=" + dosJit_regGet(0, 4) + ";ST[13]=" + dosJit_regGet(2, 4) +
              ";ST[14]=" + srcE + ";MD(" + sub + ",4);");
    // A divide error stops the CPU, which the interpreter reports; leave the
    // trace so it can do that with EIP pointing at this instruction.
    body.push("if(ST[15]!==0){" + dosJit_spill() + "@@R@@ST[0]=" + (start >>> 0) +
              ";ST[7]=k*3;return k;}");
    body.push("t2=ST[12];t3=ST[13];");
    body.push(dosJit_regSet(0, 4, "t2"));
    body.push(dosJit_regSet(2, 4, "t3"));
    // MUL and IMUL set ZF, SF and PF from the low half, and CF and OF from
    // whether the product fits: for MUL that is a zero high half, for IMUL
    // that the high half is the sign extension of the low. DIV and IDIV leave
    // every flag alone.
    if (sub === 4 || sub === 5) {
      body.push("tv=t2&255;tv^=tv>>4;tv^=tv>>2;tv^=tv>>1;");
      let fits = (sub === 4) ? "(t3===0)"
                             : "((t3===0&&(t2|0)>=0)||(t3===4294967295&&(t2|0)<0))";
      body.push("ST[1]=(ST[1]&~2245)|((t2===0)?64:0)|((t2&2147483648)?128:0)|((tv&1)?0:4)|(" +
                fits + "?0:2049);");
      // The multiply wrote every arithmetic flag; nothing is pending now.
      body.push("fo=0;");
      DOS_JIT_PENDING = 0;
    }
    // A divide changes no flag, so whatever was pending before it still is.
    return 1;
  }

  // ---- flag bits the program sets directly ---------------------------------
  // None of these is part of the lazy set, so the flag word can be touched
  // without disturbing a pending result.
  if (op === 0xFA) { body.push("ST[1]=ST[1]&~512;"); return 1; }   // CLI
  if (op === 0xFB) { body.push("ST[1]=ST[1]|512;"); return 1; }    // STI
  if (op === 0xFC) { body.push("ST[1]=ST[1]&~1024;"); return 1; }  // CLD
  if (op === 0xFD) { body.push("ST[1]=ST[1]|1024;"); return 1; }   // STD

  // ---- LEAVE ---------------------------------------------------------------
  if (op === 0xC9) {
    if (size !== 4) { DOS_JC = start; return 0; }
    body.push(dosJit_rRef(4) + "=" + dosJit_rRef(5) + ";ta=e4&16777215;t0=" +
              dosJit_memRead("ta", 4) + ";e4=(e4+4)>>>0;e5=t0>>>0;");
    DOS_JIT_RMOD = DOS_JIT_RMOD | 16 | 32;
    return 1;
  }

  // ---- IMUL with an immediate ----------------------------------------------
  if (op === 0x69 || op === 0x6B) {
    if (size !== 4) { DOS_JC = start; return 0; }
    dosJit_modrm();
    if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
    let srcE = "";
    if (DOS_JM_ADDR === "") srcE = dosJit_regGet(DOS_JM_RM, 4);
    else { body.push("ta=" + DOS_JM_ADDR + ";"); srcE = dosJit_memRead("ta", 4); }
    body.push("t0=(" + srcE + ")|0;");
    let imm = (op === 0x6B) ? dosJc_s8() : dosJc_s32();
    body.push("t1=" + imm + ";t2=Math.imul(t0,t1)>>>0;");
    body.push(dosJit_regSet(DOS_JM_REG, 4, "t2"));
    body.push("t3=t0*t1;tv=t2&255;tv^=tv>>4;tv^=tv>>2;tv^=tv>>1;" +
              "ST[1]=(ST[1]&~2245)|((t2===0)?64:0)|((t2&2147483648)?128:0)|((tv&1)?0:4)|" +
              "((t3>=-2147483648&&t3<=2147483647)?0:2049);");
    body.push("fo=0;");
    DOS_JIT_PENDING = 0;
    return 1;
  }

  // ---- MOV between the accumulator and an absolute address ------------------
  if (op >= 0xA0 && op <= 0xA3) {
    let sz = (op === 0xA0 || op === 0xA2) ? 1 : size;
    let off = dosJc_u32();
    body.push("ta=" + off + "&16777215;");
    if (op === 0xA0 || op === 0xA1) body.push(dosJit_regSet(0, sz, dosJit_memRead("ta", sz)));
    else body.push(dosJit_memWrite("ta", sz, dosJit_regGet(0, sz)));
    return 1;
  }

  // ---- CWDE / CDQ ----------------------------------------------------------
  if (op === 0x98) {
    if (size === 4) body.push(dosJit_regSet(0, 4, "((" + dosJit_regGet(0, 2) + "<<16)>>16)"));
    else body.push(dosJit_regSet(0, 2, "((" + dosJit_regGet(0, 1) + "<<24)>>24)"));
    return 1;
  }
  if (op === 0x99) {
    if (size === 4) body.push(dosJit_regSet(2, 4, "((" + dosJit_regGet(0, 4) + "|0)>>31)"));
    else body.push(dosJit_regSet(2, 2, "((" + dosJit_regGet(0, 2) + "<<16)>>31)"));
    return 1;
  }

  // ---- group 3: TEST imm, NOT, NEG -----------------------------------------
  if (op === 0xF6 || op === 0xF7) {
    let sz = (op === 0xF6) ? 1 : size;
    dosJit_modrm();
    if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
    let sub = DOS_JM_REG;
    if (sub > 3) { DOS_JC = start; return 0; }   // MUL/IMUL/DIV/IDIV: interpret
    let isMem = (DOS_JM_ADDR !== "");
    if (isMem) body.push("ta=" + DOS_JM_ADDR + ";");
    let getE = isMem ? dosJit_memRead("ta", sz) : dosJit_regGet(DOS_JM_RM, sz);
    if (sub === 0 || sub === 1) {                // TEST r/m, imm
      let imm = (sz === 1) ? dosJc_u8() : ((sz === 2) ? dosJc_u16() : dosJc_u32());
      body.push("t0=" + getE + ";t1=" + imm + ";t2=(t0&t1);");
      body.push(dosJit_setFlags(4, sz, "t0", "t1", "t2"));
      return 1;
    }
    if (sub === 2) {                             // NOT: no flags
      body.push("t2=(~(" + getE + "));");
      if (isMem) body.push(dosJit_memWrite("ta", sz, "t2"));
      else body.push(dosJit_regSet(DOS_JM_RM, sz, "t2"));
      return 1;
    }
    // NEG is SUB from zero, and sets the flags that way.
    body.push("t1=" + getE + ";t0=0;t2=(t0-t1);");
    body.push(dosJit_setFlags(5, sz, "t0", "t1", "t2"));
    if (isMem) body.push(dosJit_memWrite("ta", sz, "t2"));
    else body.push(dosJit_regSet(DOS_JM_RM, sz, "t2"));
    return 1;
  }

  // ---- group 4 and 5: INC / DEC / PUSH on an r/m operand --------------------
  if (op === 0xFE || op === 0xFF) {
    let sz = (op === 0xFE) ? 1 : size;
    dosJit_modrm();
    if (DOS_JC_OK === 0) { DOS_JC = start; return 0; }
    let sub = DOS_JM_REG;
    let isMem = (DOS_JM_ADDR !== "");
    if (sub === 0 || sub === 1) {
      if (isMem) body.push("ta=" + DOS_JM_ADDR + ";");
      let getE = isMem ? dosJit_memRead("ta", sz) : dosJit_regGet(DOS_JM_RM, sz);
      // Carry survives, so anything pending has to be folded into it first.
      if (DOS_JIT_PENDING !== 0) {
        let cfe = dosJit_flagExpr(0);
        if (cfe === "") body.push(dosJit_spill() + "FC();" + dosJit_reload());
        else body.push("ST[1]=(" + cfe + ")?(ST[1]|1):(ST[1]&~1);");
        DOS_JIT_PENDING = 0;
      }
      let dec = (sub === 1) ? 1 : 0;
      body.push("t0=" + getE + ";t2=" + (dec ? "(t0-1)" : "(t0+1)") + ";");
      body.push("fo=" + (dec ? 7 : 6) + ";fd=" + dosJit_narrow("t0", sz) +
                ";fs=1;fr=" + dosJit_narrow("t2", sz) + ";fz=" + sz + ";");
      DOS_JIT_PENDING = dec ? 7 : 6;
      DOS_JIT_PSIZE = sz;
      if (isMem) body.push(dosJit_memWrite("ta", sz, "t2"));
      else body.push(dosJit_regSet(DOS_JM_RM, sz, "t2"));
      return 1;
    }
    if (sub === 6 && op === 0xFF && sz === 4) {   // PUSH r/m32
      if (isMem) { body.push("ta=" + DOS_JM_ADDR + ";t0=" + dosJit_memRead("ta", 4) + ";"); }
      else body.push("t0=" + dosJit_regGet(DOS_JM_RM, 4) + ";");
      body.push(dosJit_rRef(4) + "=(e4-4)>>>0;ta=e4&16777215;");
      DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
      body.push(dosJit_memWrite("ta", 4, "t0"));
      return 1;
    }
    DOS_JC = start;
    return 0;
  }

  // ---- NOP -----------------------------------------------------------------
  if (op === 0x90) return 1;

  DOS_JC = start;
  return 0;
}

// Does this body contain an instruction that relied on the flags being folded?
// Only then does the loop back-edge need a fold at the top.
function dosJit_bodyFolds(body) {
  for (let i = 0; i < body.length; i++) {
    if (body[i].indexOf("fo=6;") >= 0 || body[i].indexOf("fo=7;") >= 0) return 1;
  }
  return 0;
}

// ---------------------------------------------------------------------------
// Constant pooling
// ---------------------------------------------------------------------------
// The engine materialises every integer literal with its own bytecode step, and
// does not lift those out of a loop. Generated code is dense with them --
// register numbers, masks, address bounds, branch targets -- so in a hot trace
// they were about a third of the work. Naming each distinct value once, before
// the loop, turns every later use into a register read.

function dosJit_isIdentChar(c) {
  return (c >= "0" && c <= "9") || (c >= "a" && c <= "z") ||
         (c >= "A" && c <= "Z") || c === "_" || c === "$";
}

let DOS_JIT_POOL_NAMES = null;
let DOS_JIT_POOL_VALUES = null;
let DOS_JIT_POOL_N = 0;

// Rewrite one emitted line, replacing integer literals with pooled names.
function dosJit_poolLine(line) {
  let out = "";
  let i = 0;
  let n = line.length;
  while (i < n) {
    let c = line.charAt(i);
    let prevIdent = (i > 0) ? dosJit_isIdentChar(line.charAt(i - 1)) : false;
    if (c >= "0" && c <= "9" && !prevIdent) {
      let j = i;
      while (j < n) {
        let d = line.charAt(j);
        if (d >= "0" && d <= "9") j++; else break;
      }
      // A digit run touching a following identifier character is part of a
      // name (R32, RAM16), not a literal.
      if (j < n && dosJit_isIdentChar(line.charAt(j))) {
        out = out + line.substring(i, j + 1);
        i = j + 1;
        continue;
      }
      let lit = line.substring(i, j);
      let idx = -1;
      for (let k = 0; k < DOS_JIT_POOL_N; k++) {
        if (DOS_JIT_POOL_VALUES[k] === lit) { idx = k; break; }
      }
      if (idx < 0) {
        idx = DOS_JIT_POOL_N;
        DOS_JIT_POOL_VALUES[idx] = lit;
        DOS_JIT_POOL_NAMES[idx] = "q" + idx;
        DOS_JIT_POOL_N++;
      }
      out = out + DOS_JIT_POOL_NAMES[idx];
      i = j;
      continue;
    }
    out = out + c;
    i++;
  }
  return out;
}

function dosJit_replaceAll(text, find, into) {
  let out = "";
  let i = 0;
  for (;;) {
    let j = text.indexOf(find, i);
    if (j < 0) { out = out + text.substring(i); break; }
    out = out + text.substring(i, j) + into;
    i = j + find.length;
  }
  return out;
}

function dosJit_poolReset() {
  if (DOS_JIT_POOL_NAMES === null) {
    DOS_JIT_POOL_NAMES = new Array(512);
    DOS_JIT_POOL_VALUES = new Array(512);
  }
  DOS_JIT_POOL_N = 0;
}

// The declarations that give those names their values, emitted before the loop.
function dosJit_poolDecl() {
  if (DOS_JIT_POOL_N === 0) return "";
  let parts = [];
  for (let i = 0; i < DOS_JIT_POOL_N; i++) {
    parts.push(DOS_JIT_POOL_NAMES[i] + "=" + DOS_JIT_POOL_VALUES[i]);
  }
  return "let " + parts.join(",") + ";";
}

// ---------------------------------------------------------------------------
// Flags, evaluated inline
// ---------------------------------------------------------------------------
// The compiler knows which operation last set the flags, because it emitted it.
// That means a condition can be turned into an expression over the lazy slots
// with no call and no branch on the operation: the branch a program takes ten
// thousand times costs a handful of array reads.

function dosJit_maskLit(sz) { return (sz === 1) ? "255" : ((sz === 2) ? "65535" : "4294967295"); }

// Narrow an expression to `sz` bytes and keep it unsigned.
function dosJit_narrow(expr, sz) {
  if (sz === 4) return "((" + expr + ")>>>0)";
  return "((" + expr + ")&" + dosJit_maskLit(sz) + ")";
}
function dosJit_signLit(sz) { return (sz === 1) ? "128" : ((sz === 2) ? "32768" : "2147483648"); }

// which: 0 CF, 1 PF, 2 ZF, 3 SF, 4 OF. Returns "" when the pending operation
// cannot answer it inline, in which case the caller folds the flags first.
function dosJit_flagExpr(which) {
  let p = DOS_JIT_PENDING;
  let sz = DOS_JIT_PSIZE;
  let mask = dosJit_maskLit(sz);
  let sign = dosJit_signLit(sz);

  if (p === 0) {
    // Already folded: read the bit out of the flag word.
    if (which === 0) return "((ST[1]&1)!==0)";
    if (which === 1) return "((ST[1]&4)!==0)";
    if (which === 2) return "((ST[1]&64)!==0)";
    if (which === 3) return "((ST[1]&128)!==0)";
    return "((ST[1]&2048)!==0)";
  }
  if (which === 2) return "(fr===0)";
  if (which === 3) return "((fr&" + sign + ")!==0)";
  if (which === 1) return "";                       // parity: fold instead
  if (which === 0) {
    if (p === 1) return "(fr<fd)";                  // ADD
    if (p === 2) return "(fd<fs)";                  // SUB / CMP
    if (p === 3) return "false";                    // logic clears CF
    if (p === 6 || p === 7) return "((ST[1]&1)!==0)"; // INC / DEC leave it
    return "";
  }
  // OF
  if (p === 1) return "((~(fd^fs)&(fd^fr)&" + sign + ")!==0)";
  if (p === 2) return "(((fd^fs)&(fd^fr)&" + sign + ")!==0)";
  if (p === 3) return "false";
  if (p === 6) return "(fr===" + sign + ")";
  if (p === 7) return "(fr===" + (parseInt(sign, 10) - 1) + ")";
  return "";
}

// A full condition code, 0x0-0xF as encoded in Jcc. "" means it needs a fold.
function dosJit_condExpr(code) {
  let cf = dosJit_flagExpr(0);
  let zf = dosJit_flagExpr(2);
  let sf = dosJit_flagExpr(3);
  let of = dosJit_flagExpr(4);
  if (code === 0x0) return of;
  if (code === 0x1) return (of === "") ? "" : ("!" + of);
  if (code === 0x2) return cf;
  if (code === 0x3) return (cf === "") ? "" : ("!" + cf);
  if (code === 0x4) return zf;
  if (code === 0x5) return (zf === "") ? "" : ("!" + zf);
  if (code === 0x6) return (cf === "" || zf === "") ? "" : ("(" + cf + "||" + zf + ")");
  if (code === 0x7) return (cf === "" || zf === "") ? "" : ("!(" + cf + "||" + zf + ")");
  if (code === 0x8) return sf;
  if (code === 0x9) return (sf === "") ? "" : ("!" + sf);
  if (code === 0xA || code === 0xB) return "";      // parity: rare, fold
  if (code === 0xC) return (sf === "" || of === "") ? "" : ("(" + sf + "!==" + of + ")");
  if (code === 0xD) return (sf === "" || of === "") ? "" : ("(" + sf + "===" + of + ")");
  if (code === 0xE) return (sf === "" || of === "" || zf === "") ? "" : ("(" + zf + "||" + sf + "!==" + of + ")");
  if (code === 0xF) return (sf === "" || of === "" || zf === "") ? "" : ("(!" + zf + "&&" + sf + "===" + of + ")");
  return "";
}

// ---------------------------------------------------------------------------
// The trace compiler
// ---------------------------------------------------------------------------
// A basic block ending at the first branch is too short to pay for the call
// into it: DOOM averaged four instructions. So the compiler keeps going
// through conditional branches, emitting an early return for the taken side
// and carrying on down the fall-through, and follows unconditional jumps. A
// hot path becomes one call covering tens of instructions.

let DOS_JIT_PSIZE = 4;
let DOS_JIT_SEEN = null;
let DOS_JIT_SEEN_N = 0;
let DOS_JIT_MAXI = 220;
let DOS_JIT_LOOPCAP = 2048;

function dosJit_seen(addr) {
  for (let i = 0; i < DOS_JIT_SEEN_N; i++) if (DOS_JIT_SEEN[i] === addr) return 1;
  return 0;
}

// Remember that [from, to) was decoded as instructions.
function dosJit_noteSpan(from, to) {
  if (DOS_JIT_SPANS_N + 2 > 512) return;
  DOS_JIT_SPANS[DOS_JIT_SPANS_N] = from;
  DOS_JIT_SPANS[DOS_JIT_SPANS_N + 1] = to;
  DOS_JIT_SPANS_N = DOS_JIT_SPANS_N + 2;
}

// Leaving a trace publishes the flag locals to the shared array, which is
// where the interpreter and the helpers look for them.
function dosJit_spill() {
  return "if(fo!==0){ST[1]=FL(fo,fd,fs,fr,fz,ST[1]);fo=0;}" +
         "ST[2]=fo;ST[3]=fd;ST[4]=fs;ST[5]=fr;ST[6]=fz;";
}

function dosJit_reload() {
  return "fo=ST[2];fd=ST[3];fs=ST[4];fr=ST[5];fz=ST[6];";
}

function dosJit_exit(targetLit) {
  return "@@R@@" + dosJit_spill() + "ST[0]=" + targetLit + ";ST[7]=k*3;return k;";
}

function dosJit_compile(phys) {
  if (DOS_JIT_SEEN === null) DOS_JIT_SEEN = new Int32Array(64);
  DOS_JIT_SPANS_N = 0;
  DOS_JC = phys;
  DOS_JC_OK = 1;
  DOS_JIT_PENDING = 0;
  DOS_JIT_PSIZE = 4;
  DOS_JIT_RUSE = 0;
  DOS_JIT_RMOD = 0;
  DOS_JIT_SEEN_N = 0;
  let body = [];
  let n = 0;
  let follows = 0;
  let loops = 0;
  let ended = 0;

  while (n < DOS_JIT_MAXI) {
    let here = DOS_JC >>> 0;
    if (DOS_JIT_SEEN_N < 64) { DOS_JIT_SEEN[DOS_JIT_SEEN_N] = here; DOS_JIT_SEEN_N++; }
    let peek = DOS_RAM[here & 0xFFFFFF];

    // ---- unconditional jumps: follow them ---------------------------------
    if (peek === 0xEB || peek === 0xE9) {
      DOS_JC = here + 1;
      let d = (peek === 0xEB) ? dosJc_s8() : dosJc_s32();
      let target = (DOS_JC + d) >>> 0;
      dosJit_noteSpan(here, DOS_JC);
      body.push("k++;");
      n++;
      if (target === phys) {
        loops = 1;
        body.push("if(g<" + DOS_JIT_LOOPCAP + "){g++;continue;}" + dosJit_exit(String(phys)));
      } else if (dosJit_seen(target) === 1 || follows >= 24) {
        body.push(dosJit_exit(String(target)));
      } else {
        follows++;
        DOS_JC = target;
        continue;                       // carry on compiling at the target
      }
      ended = 1;
      break;
    }

    // ---- conditional jumps: exit on taken, keep going on fall-through -----
    let ccode = -1;
    let isNear = 0;
    if (peek >= 0x70 && peek <= 0x7F) ccode = peek & 0x0F;
    else if (peek === 0x0F) {
      let p2 = DOS_RAM[(here + 1) & 0xFFFFFF];
      if (p2 >= 0x80 && p2 <= 0x8F) { ccode = p2 & 0x0F; isNear = 1; }
    }
    if (ccode >= 0) {
      let cond = dosJit_condExpr(ccode);
      if (cond === "") {
        // The condition needs the flag word; fold once, then it is readable.
        body.push(dosJit_spill() + "FC();" + dosJit_reload());
        DOS_JIT_PENDING = 0;
        cond = dosJit_condExpr(ccode);
        if (cond === "") { body.push(dosJit_exit(String(here))); ended = 1; break; }
      }
      DOS_JC = here + (isNear ? 2 : 1);
      let d = isNear ? dosJc_s32() : dosJc_s8();
      let fall = DOS_JC >>> 0;
      let target = (DOS_JC + d) >>> 0;
      dosJit_noteSpan(here, DOS_JC);
      body.push("k++;");
      n++;
      if (target === phys) {
        loops = 1;
        body.push("if(" + cond + "){if(g<" + DOS_JIT_LOOPCAP + "){g++;continue;}" +
                  dosJit_exit(String(phys)) + "}");
      } else {
        body.push("if(" + cond + "){" + dosJit_exit(String(target)) + "}");
      }
      continue;                          // fall-through keeps compiling
    }

    // ---- CALL rel32 -------------------------------------------------------
    if (peek === 0xE8) {
      DOS_JC = here + 1;
      let d = dosJc_s32();
      let target = (DOS_JC + d) >>> 0;
      let ret = DOS_JC >>> 0;
      body.push("k++;" + dosJit_rRef(4) + "=(e4-4)>>>0;ta=e4&16777215;");
      DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
      body.push(dosJit_memWrite("ta", 4, String(ret)));
      body.push(dosJit_exit(String(target)));
      dosJit_noteSpan(here, DOS_JC);
      n++;
      ended = 1;
      break;
    }

    // ---- RET imm16 ---------------------------------------------------------
    if (peek === 0xC2) {
      DOS_JC = here + 1;
      let adj = dosJc_u16();
      body.push("k++;ta=" + dosJit_rRef(4) + "&16777215;t0=" + dosJit_memRead("ta", 4) +
                ";e4=(e4+4+" + adj + ")>>>0;");
      DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
      body.push(dosJit_exit("t0"));
      dosJit_noteSpan(here, DOS_JC);
      n++;
      ended = 1;
      break;
    }

    // ---- IRET ---------------------------------------------------------------
    if (peek === 0xCF) {
      body.push("k++;ta=" + dosJit_rRef(4) + "&16777215;t0=" + dosJit_memRead("ta", 4) +
                ";tv=(ta+4)&16777215;t1=" + dosJit_memRead("tv", 4) +
                ";tv=(ta+8)&16777215;t2=" + dosJit_memRead("tv", 4) +
                ";e4=(e4+12)>>>0;SEGS[1]=t1&65535;ST[1]=(t2|2)>>>0;fo=0;");
      DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
      DOS_JIT_PENDING = 0;
      body.push(dosJit_exit("t0"));
      dosJit_noteSpan(here, here + 1);
      n++;
      ended = 1;
      break;
    }

    // ---- indirect call and jump ------------------------------------------
    if (peek === 0xFF) {
      let sub = (DOS_RAM[(here + 1) & 0xFFFFFF] >> 3) & 7;
      if (sub === 2 || sub === 4) {
        DOS_JC = here + 1;
        dosJit_modrm();
        if (DOS_JC_OK === 0) { DOS_JC = here; body.push(dosJit_exit(String(here))); ended = 1; break; }
        if (DOS_JM_ADDR === "") body.push("k++;t0=" + dosJit_regGet(DOS_JM_RM, 4) + ";");
        else body.push("k++;ta=" + DOS_JM_ADDR + ";t0=" + dosJit_memRead("ta", 4) + ";");
        if (sub === 2) {
          let ret = DOS_JC >>> 0;
          body.push(dosJit_rRef(4) + "=(e4-4)>>>0;ta=e4&16777215;");
          DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
          body.push(dosJit_memWrite("ta", 4, String(ret)));
        }
        body.push(dosJit_exit("t0"));
        dosJit_noteSpan(here, DOS_JC);
        n++;
        ended = 1;
        break;
      }
    }

    // ---- RET --------------------------------------------------------------
    if (peek === 0xC3) {
      body.push("k++;ta=" + dosJit_rRef(4) + "&16777215;t0=" + dosJit_memRead("ta", 4) +
                ";e4=(e4+4)>>>0;");
      DOS_JIT_RMOD = DOS_JIT_RMOD | 16;
      body.push(dosJit_exit("t0"));
      dosJit_noteSpan(here, here + 1);
      n++;
      ended = 1;
      break;
    }

    // ---- everything else --------------------------------------------------
    if (dosJit_one(body, 0) === 0) {
      DOS_JC = here;
      body.push(dosJit_exit(String(here)));
      ended = 1;
      break;
    }
    if (DOS_JIT_IMM_TO > DOS_JIT_IMM_FROM) {
      dosJit_noteSpan(here, DOS_JIT_IMM_FROM);
      dosJit_noteSpan(DOS_JIT_IMM_TO, DOS_JC);
    } else {
      dosJit_noteSpan(here, DOS_JC);
    }
    body.push("k++;");
    n++;
  }

  if (n === 0) return null;
  if (ended === 0) body.push(dosJit_exit(String(DOS_JC >>> 0)));

  // Round a loop the lazy slots hold whatever the body left, not the empty
  // state the entry guarantees. Folding once at the top restores it.
  if (loops === 1 && DOS_JIT_PENDING !== 0 && dosJit_bodyFolds(body) === 1) {
    body.unshift(dosJit_spill() + "FC();" + dosJit_reload());
  }

  // The pool has to run over the finished body: a literal is only worth a name
  // once, however many lines mention it.
  // Load the registers the trace touches, and write back the ones it changed.
  let loadParts = [];
  let spillParts = [];
  for (let r = 0; r < 8; r++) {
    if (DOS_JIT_RUSE & (1 << r)) loadParts.push("e" + r + "=R32[" + r + "]");
    if (DOS_JIT_RMOD & (1 << r)) spillParts.push("R32[" + r + "]=e" + r + ";");
  }
  let regLoad = (loadParts.length > 0) ? ("let " + loadParts.join(",") + ";") : "";
  let regSpill = spillParts.join("");
  for (let i = 0; i < body.length; i++) body[i] = dosJit_replaceAll(body[i], "@@R@@", regSpill);

  dosJit_poolReset();
  let pooled = [];
  for (let i = 0; i < body.length; i++) pooled.push(dosJit_poolLine(body[i]));

  let src = "let t0=0,t1=0,t2=0,t3=0,ta=0,tv=0,k=0,g=0;" +
            "let fo=ST[2],fd=ST[3],fs=ST[4],fr=ST[5],fz=ST[6],vg=ST[8];" +
            regLoad + dosJit_poolDecl() +
            "for(;;){" + pooled.join("") + "}";

  // Refuse rather than overrun: an exhausted allowance stops the whole VM.
  if (DOS_JIT_COMPILED >= DOS_JIT_MAX_COMPILES ||
      (DOS_JIT_SOURCE_BYTES + src.length) > DOS_JIT_MAX_SOURCE) {
    DOS_JIT_BUDGET_SPENT = 1;
    return null;
  }
  // The outer function is what the engine compiles; calling it once binds the
  // arrays and helpers as closure variables and returns the trace itself,
  // which then takes only the state array.
  let fn = null;
  try {
    let make = new Function("R32", "R16", "R8", "RAM", "RAM16", "RAM32", "SEGS", "MASK", "SIGN",
                            "W8", "W16", "W32", "RD8", "FC", "CP", "MD", "OUT8", "IN8",
                            "RD16", "RD32", "RDU16", "RDU32", "FL",
                            "return function(ST){" + src + "};");
    fn = make(DOS_REGS32, DOS_REGS16, DOS_REGS8, DOS_RAM, DOS_RAM16, DOS_RAM32,
              DOS_SEGS, DOS_JIT_MASK, DOS_JIT_SIGN,
              dosJit_w8, dosJit_w16, dosJit_w32, dosJit_rd8, dosJit_fc,
              DOS_JIT_CODEPAGE, dosJit_muldiv, dosJit_out8, dosJit_in8,
              dosJit_rd16, dosJit_rd32, dosJit_rdu16, dosJit_rdu32, dosJit_fold);
  } catch (e) {
    DOS_JIT_FAILED++;
    return null;
  }
  DOS_JIT_SOURCE_BYTES = DOS_JIT_SOURCE_BYTES + src.length;
  DOS_JIT_COMPILED++;
  DOS_JIT_TOTAL_INSNS += n;
  for (let i = 0; i + 1 < DOS_JIT_SPANS_N; i = i + 2) {
    dosJit_markCode(DOS_JIT_SPANS[i], DOS_JIT_SPANS[i + 1]);
  }
  return fn;
}

// ---------------------------------------------------------------------------
// Helpers the compiled code calls
// ---------------------------------------------------------------------------

function dosJit_w8(a, v) {
  dosBc_touch(a); dosJit_touch(a);
  if (DOS_VGA_UNCHAINED === 1 && a >= 0xA0000 && a < 0xB0000) { dosVga_writePlanar(a - 0xA0000, v); return; }
  DOS_RAM[a] = v & 0xFF;
}
function dosJit_w16(a, v) { dosJit_w8(a, v); dosJit_w8((a + 1) & 0xFFFFFF, v >> 8); }
function dosJit_w32(a, v) {
  dosJit_w8(a, v); dosJit_w8((a + 1) & 0xFFFFFF, v >> 8);
  dosJit_w8((a + 2) & 0xFFFFFF, v >> 16); dosJit_w8((a + 3) & 0xFFFFFF, v >>> 24);
}
// Fold whatever the lazy slots hold into the flag word, then empty them. The
// interpreter does this through dosCpu_flushFlags on the globals; compiled
// code works on the shared array, so it gets its own path in and out.
function dosJit_fc() {
  if (DOS_JIT_ST[2] === 0) return;
  dosJit_syncOut();
  dosCpu_flushFlags();
  dosJit_syncIn();
}

// Multiply and divide write two registers and can fault, so they go through
// here: operands in ST[12..14], results back in ST[12..13], ST[15] set if the
// operation raised a divide error.
function dosJit_muldiv(sub, size) {
  let lo = DOS_JIT_ST[12] >>> 0;
  let hi = DOS_JIT_ST[13] >>> 0;
  let d = DOS_JIT_ST[14] >>> 0;
  DOS_JIT_ST[15] = 0;
  if (sub === 4) {                       // MUL
    dosOps_umul64(lo, d);
    DOS_JIT_ST[12] = DOS_MUL_LO >>> 0;
    DOS_JIT_ST[13] = DOS_MUL_HI >>> 0;
    return;
  }
  if (sub === 5) {                       // IMUL
    let a = lo | 0;
    let b = d | 0;
    let l = Math.imul(a, b) >>> 0;
    dosOps_umul64(a >>> 0, b >>> 0);
    let h = DOS_MUL_HI;
    if (a < 0) h = (h - (b >>> 0)) >>> 0;
    if (b < 0) h = (h - (a >>> 0)) >>> 0;
    DOS_JIT_ST[12] = l;
    DOS_JIT_ST[13] = h >>> 0;
    return;
  }
  if (d === 0) { DOS_JIT_ST[15] = 1; return; }
  if (sub === 6) {                       // DIV
    if (dosOps_udiv64(hi, lo, d) === 0) { DOS_JIT_ST[15] = 1; return; }
    DOS_JIT_ST[12] = DOS_DIV_Q >>> 0;
    DOS_JIT_ST[13] = DOS_DIV_R >>> 0;
    return;
  }
  // IDIV: divide the magnitudes, then put the signs back.
  let nHi = hi | 0;
  let nLo = lo >>> 0;
  let nNeg = (nHi < 0) ? 1 : 0;
  if (nNeg === 1) { dosOps_neg64(nHi >>> 0, nLo); nHi = DOS_MUL_HI; nLo = DOS_MUL_LO; }
  let dv = d | 0;
  let dNeg = (dv < 0) ? 1 : 0;
  let dAbs = (dNeg === 1) ? ((-dv) >>> 0) : (dv >>> 0);
  if (dosOps_udiv64(nHi >>> 0, nLo >>> 0, dAbs) === 0) { DOS_JIT_ST[15] = 1; return; }
  let q = DOS_DIV_Q >>> 0;
  let r = DOS_DIV_R >>> 0;
  if ((nNeg !== dNeg)) {
    if (q > 2147483648) { DOS_JIT_ST[15] = 1; return; }
    q = (-q) >>> 0;
  } else if (q > 2147483647) { DOS_JIT_ST[15] = 1; return; }
  if (nNeg === 1) r = (-r) >>> 0;
  DOS_JIT_ST[12] = q;
  DOS_JIT_ST[13] = r;
}

function dosJit_out8(port, v) {
  dosMmu_out8(port, v);
  DOS_JIT_ST[8] = DOS_VGA_UNCHAINED;
}
// A port read inside a compiled loop has to see time passing, or a program
// waiting on the retrace bit spins the whole loop cap out before the trace
// exits and the cycle count catches up. Charging a few cycles here keeps the
// bit moving; the trace still adds its own count on exit, so this slightly
// overcounts a rare instruction rather than stalling a common loop.
function dosJit_in8(port) { DOS_TOTAL_CYCLES += 8; return dosMmu_in8(port); }

// Fold a pending lazy result into the flag word. The same arithmetic as
// dosCpu_flushFlags, over the trace's own locals; d, s and r arrive already
// narrowed to the operand size and unsigned.
function dosJit_fold(op, d, sr, r, size, f) {
  let sign = DOS_JIT_SIGN[size & 7];
  let cf = 0;
  let of = 0;
  let af = 0;
  if (op === 1) {
    cf = (r < d) ? 1 : 0;
    of = ((~(d ^ sr) & (d ^ r) & sign) !== 0) ? 1 : 0;
    af = ((d ^ sr ^ r) & 0x10) ? 1 : 0;
  } else if (op === 2) {
    cf = (d < sr) ? 1 : 0;
    of = (((d ^ sr) & (d ^ r) & sign) !== 0) ? 1 : 0;
    af = ((d ^ sr ^ r) & 0x10) ? 1 : 0;
  } else if (op === 3) {
    cf = 0; of = 0; af = 0;
  } else if (op === 6) {
    cf = f & 1;
    of = (r === sign) ? 1 : 0;
    af = ((d ^ 1 ^ r) & 0x10) ? 1 : 0;
  } else if (op === 7) {
    cf = f & 1;
    of = (r === (sign - 1)) ? 1 : 0;
    af = ((d ^ 1 ^ r) & 0x10) ? 1 : 0;
  } else if (op === 8) {
    let cin = f & 1;
    cf = cin ? ((r <= d) ? 1 : 0) : ((r < d) ? 1 : 0);
    of = ((~(d ^ sr) & (d ^ r) & sign) !== 0) ? 1 : 0;
    af = ((d ^ sr ^ r) & 0x10) ? 1 : 0;
  } else if (op === 9) {
    let cin2 = f & 1;
    cf = cin2 ? ((d <= sr) ? 1 : 0) : ((d < sr) ? 1 : 0);
    of = (((d ^ sr) & (d ^ r) & sign) !== 0) ? 1 : 0;
    af = ((d ^ sr ^ r) & 0x10) ? 1 : 0;
  } else {
    cf = f & 1;
    of = (f & 0x800) ? 1 : 0;
    af = (f & 0x10) ? 1 : 0;
  }
  let x = r & 0xFF;
  x = x ^ (x >> 4);
  x = x ^ (x >> 2);
  x = x ^ (x >> 1);
  let out = f & ~0x8D5;
  if (cf) out = out | 1;
  if ((x & 1) === 0) out = out | 4;
  if (af) out = out | 0x10;
  if (r === 0) out = out | 0x40;
  if (r & sign) out = out | 0x80;
  if (of) out = out | 0x800;
  return out >>> 0;
}

function dosJit_rd16(a) { return dosJit_rd8(a) | (dosJit_rd8((a + 1) & 0xFFFFFF) << 8); }
function dosJit_rd32(a) {
  return (dosJit_rd8(a) | (dosJit_rd8((a + 1) & 0xFFFFFF) << 8) |
          (dosJit_rd8((a + 2) & 0xFFFFFF) << 16) | (dosJit_rd8((a + 3) & 0xFFFFFF) << 24)) >>> 0;
}
function dosJit_rdu16(a) { return DOS_RAM[a] | (DOS_RAM[(a + 1) & 0xFFFFFF] << 8); }
function dosJit_rdu32(a) {
  return (DOS_RAM[a] | (DOS_RAM[(a + 1) & 0xFFFFFF] << 8) |
          (DOS_RAM[(a + 2) & 0xFFFFFF] << 16) | (DOS_RAM[(a + 3) & 0xFFFFFF] << 24)) >>> 0;
}

function dosJit_rd8(a) {
  if (DOS_VGA_UNCHAINED === 1 && a >= 0xA0000 && a < 0xB0000) return dosVga_readPlanar(a - 0xA0000);
  return DOS_RAM[a & 0xFFFFFF];
}

// ---------------------------------------------------------------------------
// Running
// ---------------------------------------------------------------------------

function dosJit_syncIn() {
  DOS_JIT_ST[0] = DOS_EIP >>> 0;
  DOS_JIT_ST[9] = 0;
  DOS_JIT_ST[1] = DOS_EFLAGS >>> 0;
  DOS_JIT_ST[2] = DOS_LAZY_OP;
  DOS_JIT_ST[3] = DOS_LAZY_DST >>> 0;
  DOS_JIT_ST[4] = DOS_LAZY_SRC >>> 0;
  DOS_JIT_ST[5] = DOS_LAZY_RES >>> 0;
  DOS_JIT_ST[6] = DOS_LAZY_SIZE;
  DOS_JIT_ST[8] = DOS_VGA_UNCHAINED;
}

function dosJit_syncOut() {
  DOS_EIP = DOS_JIT_ST[0] >>> 0;
  DOS_EFLAGS = DOS_JIT_ST[1] >>> 0;
  DOS_LAZY_OP = DOS_JIT_ST[2];
  DOS_LAZY_DST = DOS_JIT_ST[3] >>> 0;
  DOS_LAZY_SRC = DOS_JIT_ST[4] >>> 0;
  DOS_LAZY_RES = DOS_JIT_ST[5] >>> 0;
  DOS_LAZY_SIZE = DOS_JIT_ST[6];
}

// The 32-bit run loop. Compiled traces run in one call each; everything else
// falls back to the interpreter one instruction at a time.
//
// `synced` says which copy of the machine state is authoritative: 1 for the
// interpreter's globals, 0 for the shared state array the traces work on.
// Trace-to-trace transitions leave it at 0 and copy nothing.
function dosJit_run(budget) {
  if (DOS_JIT_TAG === null) dosJit_init();
  let remaining = budget;
  let synced = 1;
  while (remaining > 0 && !DOS_HALTED) {
    if (DOS_IS_32 !== 1) { if (synced === 0) dosJit_syncOut(); return; }
    let eip = (synced === 1) ? (DOS_EIP >>> 0) : (DOS_JIT_ST[0] >>> 0);
    let phys = eip & 0xFFFFFF;
    let slot = (phys ^ (phys >>> 13)) & (DOS_JIT_SLOTS - 1);
    let fn = null;
    if (DOS_JIT_TAG[slot] === phys) fn = DOS_JIT_FN[slot];
    if (fn === null && DOS_JIT_BUDGET_SPENT === 0) {
      // Count this address in the hotness table, which is separate so that a
      // cold address can never displace a compiled trace.
      let hs = (phys ^ (phys >>> 7) ^ (phys >>> 17)) & (DOS_JIT_SLOTS - 1);
      if (DOS_JIT_HOT_TAG[hs] !== phys) { DOS_JIT_HOT_TAG[hs] = phys; DOS_JIT_HOT[hs] = 0; }
      let h = DOS_JIT_HOT[hs] + 1;
      DOS_JIT_HOT[hs] = h;
      if (h >= DOS_JIT_THRESHOLD) {
        fn = dosJit_compile(phys);
        if (fn === null) {
          DOS_JIT_HOT[hs] = 65535;                  // could not compile: stop trying
        } else {
          DOS_JIT_FN[slot] = fn;
          DOS_JIT_TAG[slot] = phys;
        }
      }
    }
    if (fn === null) {
      // The interpreter works on the globals; bring the state back if a trace
      // left it in the array.
      if (synced === 0) { dosJit_syncOut(); synced = 1; }
      remaining -= dosCpu_step();
      DOS_JIT_STEPS++;
      DOS_BC_INSTR++;
      DOS_INT_CHECK--;
      if (DOS_INT_CHECK <= 0) { DOS_INT_CHECK = DOS_INT_CHECK_EVERY; dosInt_poll(); }
      continue;
    }
    if (synced === 1) {
      // Folding on entry means compiled code never has to reason about a lazy
      // result left behind by the interpreter.
      dosCpu_flushFlags();
      dosJit_syncIn();
      synced = 0;
    }
    let insns = fn(DOS_JIT_ST);
    let cyc = DOS_JIT_ST[7];
    if (cyc < 1) cyc = 1;
    DOS_TOTAL_CYCLES += cyc;
    remaining -= cyc;
    DOS_JIT_CALLS++;
    DOS_JIT_INSNS += insns;
    DOS_BC_INSTR += insns;
    // Interrupt delivery needs the globals; only pay for the copy when one is
    // actually due, which is a cheap test.
    if (dosInt_due() === 1) {
      dosJit_syncOut();
      synced = 1;
      dosInt_poll();
    }
  }
  if (synced === 0) dosJit_syncOut();
}
