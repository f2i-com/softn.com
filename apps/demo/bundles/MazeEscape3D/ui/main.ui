<logic src="../logic/main.logic" />

<style>
.mz-root { position: relative; width: 100%; height: 100%; min-height: 480px; overflow: hidden; background: #0b0e14; font-family: "Segoe UI", system-ui, sans-serif; color: #e6e9f4; user-select: none; }
.mz-scene { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.mz-ovl { position: absolute; pointer-events: none; }
.mz-panel { background: rgba(8, 11, 18, 0.66); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; backdrop-filter: blur(8px); }
.mz-hud { top: 14px; left: 14px; padding: 10px 14px; }
.mz-map { top: 14px; right: 14px; padding: 8px; }
.mz-toast { bottom: 26px; left: 50%; transform: translateX(-50%); padding: 7px 16px; border-radius: 999px; animation: mz-in 200ms ease both; }
@keyframes mz-in { from { opacity: 0; transform: translate(-50%, 6px); } to { opacity: 1; transform: translate(-50%, 0); } }
.mz-vig { top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(110% 100% at 50% 50%, rgba(0,0,0,0) 55%, rgba(0,0,0,0.45) 100%); }
.mz-card-wrap { top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; pointer-events: auto; background: linear-gradient(180deg, rgba(4,6,12,0.3) 0%, rgba(4,6,12,0.6) 100%); }
.mz-card { width: min(520px, calc(100% - 32px)); padding: 32px 34px 28px; text-align: center; background: rgba(8,11,18,0.82); border: 1px solid rgba(255,255,255,0.1); border-radius: 18px; box-shadow: 0 30px 80px rgba(0,0,0,0.65); backdrop-filter: blur(10px); }
.mz-keys { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 20px auto 0; text-align: left; max-width: 340px; }
.mz-kbd { display: inline-block; min-width: 26px; padding: 2px 7px; border-radius: 6px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18); font-family: ui-monospace, monospace; text-align: center; }
.mz-touch { position: absolute; left: 14px; bottom: 20px; pointer-events: auto; }
.mz-touchbar { position: absolute; right: 14px; bottom: 20px; pointer-events: auto; display: flex; gap: 8px; }
@media (max-width: 640px) { .mz-card { padding: 22px 16px; } .mz-map { transform: scale(0.8); transform-origin: top right; } }
</style>

<Box className="mz-root">
  <Loop interval={33} running={true} @tick={gameStep} />

  <Box className="mz-scene">
    <Scene3D
      fill={true}
      objects={objects}
      staticObjects={sceneStatic}
      lights={lights}
      camera={{ position: cameraPos, lookAt: cameraLookAt, fov: 75 }}
      antialias={true}
      shadows={false}
      pointerLock={true}
      pitchLimit={0.9}
      cameraSmoothing={0.4}
      maxPixelRatio={1.25}
      mouseLookSensitivity={0.0024}
      fog={sceneFog}
      background="#0b0e14"
      @click={onSceneClick}
    />
  </Box>
  <Box className="mz-ovl mz-vig" />

  <Box if={started} className="mz-ovl mz-panel mz-hud">
    <Text style={{ display: "block", fontSize: "11px", letterSpacing: "0.14em", color: "#8b93b3" }}>TIME</Text>
    <Text style={{ display: "block", fontSize: "24px", fontWeight: 800, color: "#ffffff", lineHeight: 1.1 }}>{timeText}</Text>
    <Text style={{ display: "block", fontSize: "11px", color: "#8b93b3", marginTop: "4px" }}>{"best " + bestText}</Text>
  </Box>
  <Box if={started} className="mz-ovl mz-panel mz-map">
    <PixelGrid rows={15} cols={15} cellSize={7} items={mapItems} background="rgba(0,0,0,0.35)" />
  </Box>
  <Box if={toast !== ""} className="mz-ovl mz-panel mz-toast"><Text style={{ fontSize: "13px", color: "#ffffff" }}>{toast}</Text></Box>

  <Box if={started && touchMode && !won} className="mz-touch">
    <DPad @press={padPress} @release={padRelease} />
  </Box>
  <Box if={started && touchMode && !won && !paused} className="mz-touchbar">
    <Button variant="ghost" style={{ padding: "10px 16px", borderRadius: "10px", fontWeight: 700, fontSize: "14px", background: "rgba(8,11,18,0.7)", color: "#fff", border: "1px solid rgba(255,255,255,0.15)" }} @click={pauseGame}>Pause</Button>
  </Box>

  <!-- Title -->
  <Box if={!started} className="mz-ovl mz-card-wrap">
    <Box className="mz-card">
      <Text style={{ display: "block", fontSize: "12px", letterSpacing: "0.4em", color: "#4ade80" }}>FIRST PERSON</Text>
      <Text style={{ display: "block", marginTop: "8px", fontSize: "52px", fontWeight: 900, letterSpacing: "-0.03em", lineHeight: 1, color: "#ffffff" }}>Maze Escape</Text>
      <Text style={{ display: "block", marginTop: "12px", fontSize: "15px", color: "#b8c4d6" }}>A different maze every time. Find the golden ring; the map fills in as you go.</Text>
      <Stack direction="horizontal" gap={10} style={{ justifyContent: "center", marginTop: "22px" }}>
        <Button variant="ghost" style={{ padding: "13px 30px", borderRadius: "10px", fontWeight: 800, fontSize: "16px", background: "#4ade80", color: "#052e16", border: "1px solid #4ade80", boxShadow: "0 10px 30px rgba(74,222,128,0.3)" }} @click={startGame}>Start</Button>
      </Stack>
      <Text if={bestText !== "—"} style={{ display: "block", marginTop: "14px", fontSize: "13px", color: "#8b93b3" }}>{"Best time " + bestText}</Text>
      <Button variant="ghost" ariaLabel={muted ? "Turn sound on" : "Turn sound off"} style={{ marginTop: "12px", padding: "7px 14px", borderRadius: "8px", fontSize: "12px", background: "rgba(255,255,255,0.08)", color: muted ? "#8b93b3" : "#fff", border: "1px solid rgba(255,255,255,0.14)" }} @click={toggleMute}>{muted ? "Sound off" : "Sound on"}</Button>
      <Box className="mz-keys">
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="mz-kbd" style={{ fontSize: "11px", color: "#fff" }}>W A S D</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>move · <Text className="mz-kbd" style={{ fontSize: "11px", color: "#fff" }}>Shift</Text> run</Text>
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="mz-kbd" style={{ fontSize: "11px", color: "#fff" }}>Mouse</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>look · <Text className="mz-kbd" style={{ fontSize: "11px", color: "#fff" }}>Esc</Text> pauses · <Text className="mz-kbd" style={{ fontSize: "11px", color: "#fff" }}>M</Text> sound</Text>
      </Box>
    </Box>
  </Box>

  <!-- Paused -->
  <Box if={started && paused && !won} className="mz-ovl mz-card-wrap">
    <Box className="mz-card">
      <Text style={{ display: "block", fontSize: "26px", fontWeight: 800, color: "#ffffff" }}>Paused</Text>
      <Text style={{ display: "block", marginTop: "8px", fontSize: "14px", color: "#c7d2e2" }}>{"Time so far " + timeText}</Text>
      <Stack direction="horizontal" gap={10} style={{ justifyContent: "center", marginTop: "20px", flexWrap: "wrap" }}>
        <Button variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "#4ade80", color: "#052e16", border: "1px solid #4ade80" }} @click={resumeGame}>Resume</Button>
        <Button variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "rgba(255,255,255,0.1)", color: "#fff", border: "1px solid rgba(255,255,255,0.2)" }} @click={startGame}>New maze</Button>
        <Button variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "rgba(255,255,255,0.1)", color: "#fff", border: "1px solid rgba(255,255,255,0.2)" }} @click={backToTitle}>Title</Button>
      </Stack>
    </Box>
  </Box>

  <!-- Won -->
  <Box if={won} className="mz-ovl mz-card-wrap">
    <Box className="mz-card">
      <Text style={{ display: "block", fontSize: "12px", letterSpacing: "0.4em", color: "#fbbf24" }}>YOU ESCAPED</Text>
      <Text style={{ display: "block", marginTop: "8px", fontSize: "44px", fontWeight: 900, color: "#ffffff" }}>{timeText}</Text>
      <Text style={{ display: "block", marginTop: "6px", fontSize: "14px", color: "#c7d2e2" }}>{"Best " + bestText + " · " + steps + " cells explored"}</Text>
      <Stack direction="horizontal" gap={10} style={{ justifyContent: "center", marginTop: "20px", flexWrap: "wrap" }}>
        <Button variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 800, fontSize: "15px", background: "#4ade80", color: "#052e16", border: "1px solid #4ade80" }} @click={startGame}>Another maze</Button>
        <Button variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "rgba(255,255,255,0.1)", color: "#fff", border: "1px solid rgba(255,255,255,0.2)" }} @click={backToTitle}>Title</Button>
      </Stack>
    </Box>
  </Box>
</Box>
