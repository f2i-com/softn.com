<!-- The to-do app's page: the file manifest.json names as "main". -->

<!--
  An import is an include. Wherever the Header, TodoItem or Footer tag is
  written below, that file's markup is put in its place, as if it had been
  typed here. It reads this page's state and calls this page's functions, so
  nothing is passed to it: no attributes, no events, no children.
-->
<import Header from="./components/header.ui" />
<import TodoItem from="./components/todo-item.ui" />
<import Footer from="./components/footer.ui" />

<!-- The state and the functions every name below refers to. -->
<logic src="./app.logic" />

<App>
  <div class="app">
    <Header />

    <main class="main-content">
      <!-- :bind writes what is typed back to newTodoText; .prevent keeps the
           form from reloading the page. -->
      <form class="add-todo-form" @submit.prevent={() => addTodo()}>
        <Input
          type="text"
          placeholder="What needs to be done?"
          :bind={newTodoText}
          flex={1}
        />
        <Button type="submit" variant="primary">Add</Button>
      </form>

      <div class="filter-tabs">
        <Button
          variant={filter === "all" ? "primary" : "ghost"}
          @click={() => setFilter("all")}
        >
          All ({count(todos)})
        </Button>
        <Button
          variant={filter === "active" ? "primary" : "ghost"}
          @click={() => setFilter("active")}
        >
          Active ({count(activeTodos)})
        </Button>
        <Button
          variant={filter === "completed" ? "primary" : "ghost"}
          @click={() => setFilter("completed")}
        >
          Completed ({count(completedTodos)})
        </Button>
      </div>

      <div class="todo-list">
        <!-- The row is placed inside the loop, so it reads the loop's `todo`. -->
        #each (todo in filteredTodos) key={todo.id}
          <TodoItem />
        #empty
          <div class="empty-state">
            <p>Nothing here.</p>
            <p class="hint">Add a todo above, or choose another filter.</p>
          </div>
        #end
      </div>
    </main>

    <Footer />
  </div>
</App>

<!--
  This page's own rules. Each imported page keeps the rules for its markup in
  its own file, and they all join this one stylesheet: after these, in the
  order of the imports above. A rule is not kept to the page it is written
  in, so the class names are chosen not to collide. The colours are the
  theme's, so the app follows light and dark.
-->
<style>
  .app {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .main-content {
    flex: 1;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .add-todo-form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filter-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .todo-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .empty-state {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  .empty-state p {
    margin: 0;
  }

  .empty-state .hint {
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }
</style>
