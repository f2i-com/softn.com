// ---------------------------------------------------------------------------
// Keyboard, wheel, window
// ---------------------------------------------------------------------------
function onKeyDown(e) {
  if (!e) return;
  let tag = e.targetTag || "";
  if (e.targetEditable || tag === "input" || tag === "textarea" || tag === "select") return;
  let key = String(e.key || "");
  let k = key.toLowerCase();
  if (dialog) { return; }
  if (k === " ") { psSpaceHeld = true; return; }
  if (k === "escape") { if (openMenu) { openMenu = ""; return; } if (cropPending || psGesture) { psEndGesture(true); return; } if (psPolygon.length) { psPolygon = []; polygonPending = false; psOverlaySet("gesture", null); return; } if (PS_SEL) { uiGuard(function () { psDeselect(); }); } return; }
  if (k === "enter") { if (cropPending) { applyCrop(); return; } if (tool === "polygon" && psPolygon.length >= 6) { closePolygon(); return; } return; }
  if (uiBusy()) return;
  let mod = e.ctrlKey || e.metaKey;
  if (mod) {
    if (k === "z") { uiGuard(function () { if (e.shiftKey) psRedo(); else psUndo(); }); return; }
    if (k === "y") { uiGuard(function () { psRedo(); }); return; }
    if (k === "a") { uiGuard(function () { psSelectAll(); }); return; }
    if (k === "i" && e.shiftKey) { uiGuard(function () { psInvertSelection(); }); return; }
    if (k === "0") { setFit(); return; }
    if (k === "1") { zoomActual(); return; }
    return;
  }
  if (k === "+" || k === "=") { zoomIn(); return; }
  if (k === "-") { zoomOut(); return; }
  if (k === "delete" || k === "backspace") { uiGuard(function () { psClearSelected(); }); return; }
  if (k === "x") { swapColors(); return; }
  if (k === "d") { defaultColors(); return; }
  if (k === "[") { setBrushSize(brushSize - 5); return; }
  if (k === "]") { setBrushSize(brushSize + 5); return; }
  let combo = (e.shiftKey ? "Shift+" : "") + key.toUpperCase();
  for (let i = 0; i < psTools.length; i++) if (psTools[i][2] === combo) { uiSetTool(psTools[i][0]); return; }
}
function onKeyUp(e) { if (e && e.key === " ") psSpaceHeld = false; }
function onWindowBlur() { psSpaceHeld = false; psEndGesture(true); }
function onWindowResize() { psViewRect = null; psApplyView(); }
function onWheel(e) {
  if (!e || dialog || !psViewRect) return;
  let r = psViewRect;
  if (e.clientX < r.left || e.clientY < r.top || e.clientX > r.left + r.width || e.clientY > r.top + r.height) return;
  if (e.altKey || e.ctrlKey || e.metaKey) { psZoomTo(psGeometry().f * Math.exp(-(e.deltaY || 0) * 0.0015), e.clientX - r.left, e.clientY - r.top); return; }
  if (viewMode === "zoom") { psPanX -= e.deltaX || 0; psPanY -= e.deltaY || 0; psApplyView(); }
}

// ---------------------------------------------------------------------------
// Menus and actions
// ---------------------------------------------------------------------------
function toggleMenu(name) {
  if (openMenu === name) { openMenu = ""; return; }
  openMenu = name;
  let items = psMenus[name] || [], out = [];
  for (let i = 0; i < items.length; i++) { let it = items[i]; if (it[0] === "-") out.push({ id: "sep" + i, label: "", key: "", sep: true }); else out.push({ id: it[1], label: it[0], key: it[2], sep: false }); }
  menuItems = out;
}
function hoverMenu(name) { if (openMenu && openMenu !== name) toggleMenu(name); }
function closeMenus() { openMenu = ""; }
function runMenu(id) { openMenu = ""; runAction(id); }
function runAction(id) {
  if (uiBusy() && id !== "help" && id !== "compatibility" && id !== "about") { uiNotify("Please wait for the current operation to finish.", false); return; }
  if (psGesture) psEndGesture(true);
  uiGuard(function () { psAction(id); });
}
function psAction(id) {
  if (id.indexOf("filter:") === 0) {
    let kind = id.slice(7), d = psFilterDefaults[kind];
    if (!d) { psFilter(kind, 0, null); return; }
    psFilterKind = kind; dlgAmount = d[0]; dlgMin = d[1]; dlgMax = d[2]; dlgStep = d[3];
    dialogTitle = psTitleCase(kind); dialogMessage = "Applies to the active raster layer, inside the current selection. Undo restores the previous pixels.";
    dialog = "filter";
    return;
  }
  switch (id) {
    case "new": psConfirmDiscard(function () { dlgName = "Untitled"; dlgWidth = "1280"; dlgHeight = "800"; dlgBackground = "transparent"; dialog = "new"; }); break;
    case "open": case "place":
      psPlacePending = id === "place";
      if (!psCanPickFiles()) { uiNotify("Use the Open button in the top bar to choose a file.", false); break; }
      softn.files.pickFile({ accept: ".png,.jpg,.jpeg,.gif,.bmp,.psd,.sphoto,image/png,image/jpeg,image/gif,image/bmp", multiple: false }, function (files) { filesChosen(files); });
      break;
    case "demo": psConfirmDiscard(function () { buildDemoDocument(); }); break;
    case "undo": psUndo(); break;
    case "redo": psRedo(); break;
    case "select-all": psSelectAll(); break;
    case "deselect": psDeselect(); break;
    case "invert-selection": psInvertSelection(); break;
    case "feather": dlgRadius = "4"; dialog = "feather"; break;
    case "clear": psClearSelected(); break;
    case "rename": dlgLayerName = psActive().name; dialog = "rename"; break;
    case "edit-mask": { let l = psActive(); if (!l.mask) psFail("Add a layer mask first."); PS_MASKMODE = !PS_MASKMODE; if (PS_MASKMODE) { fgColor = "#ffffff"; bgColor = "#000000"; } uiOnDocument("change"); break; }
    case "edit-text": { let l = psActive(); if (!l.text) psFail("Select a text layer created in Photo Studio. Imported text is rasterised."); psEditingText = true; openTextDialog(l.text); break; }
    case "flip-x": psTransform({ scaleX: -1 }, null); break;
    case "flip-y": psTransform({ scaleY: -1 }, null); break;
    case "transform": dlgDx = "0"; dlgDy = "0"; dlgAngle = "0"; dlgScaleX = "100"; dlgScaleY = "100"; dialog = "transform"; break;
    case "resize": dlgWidth = String(PS_W); dlgHeight = String(PS_H); dlgLock = true; dlgNearest = false; dialog = "resize"; break;
    case "canvas-size": dlgWidth = String(PS_W); dlgHeight = String(PS_H); dlgAnchor = "center"; dialog = "canvas"; break;
    case "crop-selection": psSelectionBoundsJob(function (rect) { uiGuard(function () { psCrop(rect, null); }); }); break;
    case "fit": setFit(); break;
    case "actual": zoomActual(); break;
    case "zoom-in": zoomIn(); break;
    case "zoom-out": zoomOut(); break;
    case "rulers": toggleRulers(); break;
    case "toggle-sidebar": toggleSidebar(); break;
    case "swap-colors": swapColors(); break;
    case "psd": dialogTitle = "Save layered PSD"; dialog = "psd"; break;
    case "project": saveProject(); break;
    case "export": dlgFormat = "png"; dlgQuality = 92; dlgJpegBg = "#ffffff"; dialog = "export"; break;
    case "help": dialog = "help"; break;
    case "compatibility": compatText = PS_WARNINGS.length ? PS_WARNINGS.join("\n\n") : "No import compatibility notices for this document."; dialog = "compat"; break;
    case "about": dialog = "about"; break;
    default: {
      let known = false;
      let names = Object.keys(psMenus);
      for (let i = 0; i < names.length; i++) { let items = psMenus[names[i]]; for (let j = 0; j < items.length; j++) if (items[j][1] === id) known = true; }
      if (!known) psFail("Unknown editor command: " + id);
      psLayerAction(id, null, null);
    }
  }
}
function psConfirmDiscard(next) {
  if (!psDirty()) { next(); return; }
  psPendingAction = next;
  dialog = "discard";
}
function confirmDiscard() { let next = psPendingAction; psPendingAction = null; dialog = ""; if (next) uiGuard(next); }

// ---------------------------------------------------------------------------
// Dialogs
// ---------------------------------------------------------------------------
function closeDialog() { dialog = ""; psPendingAction = null; psPendingPsd = null; }
function selectHistory(index) { /* history is display-only; undo/redo navigate it */ }
function psNum(s, fallback) { let v = Number(s); return Number.isFinite(v) ? v : fallback; }
function applyDialog() {
  let kind = dialog;
  uiGuard(function () {
    if (kind === "new") { dialog = ""; psNewDocument(Math.round(psNum(dlgWidth, 1280)), Math.round(psNum(dlgHeight, 800)), dlgName, dlgBackground); }
    else if (kind === "resize") { dialog = ""; let w = Math.round(psNum(dlgWidth, PS_W)); let h = dlgLock ? Math.max(1, Math.round(PS_H * w / PS_W)) : Math.round(psNum(dlgHeight, PS_H)); psResize(w, h, true, "center", !!dlgNearest, null); }
    else if (kind === "canvas") { dialog = ""; psResize(Math.round(psNum(dlgWidth, PS_W)), Math.round(psNum(dlgHeight, PS_H)), false, dlgAnchor, false, null); }
    else if (kind === "transform") { dialog = ""; psTransform({ dx: psNum(dlgDx, 0), dy: psNum(dlgDy, 0), angle: psNum(dlgAngle, 0), scaleX: psNum(dlgScaleX, 100) / 100, scaleY: psNum(dlgScaleY, 100) / 100 }, null); }
    else if (kind === "filter") { dialog = ""; psFilter(psFilterKind, psNum(dlgAmount, 0), null); }
    else if (kind === "feather") { dialog = ""; psFeatherSelection(psNum(dlgRadius, 4)); }
    else if (kind === "rename") { dialog = ""; psLayerAction("Rename layer", dlgLayerName, null); }
    else if (kind === "text") { dialog = ""; applyTextDialog(); }
    else if (kind === "export") { dialog = ""; exportImage(); }
    else if (kind === "psd") { dialog = ""; savePsd(); }
    else if (kind === "discard") { confirmDiscard(); }
    else dialog = "";
  });
}
function setDialogAmount(v) { dlgAmount = psNum(v, dlgAmount); }
function openTextDialog(t) {
  dlgText = t ? t.text : "Something new."; dlgFont = t ? psFontFamilyKey(t.font) : "sans"; dlgSize = String(t ? t.size : 64); dlgBold = t ? !!t.bold : true; dlgColor = t ? t.color : fgColor;
  dialogTitle = t ? "Edit type layer" : "Add type layer";
  dialog = "text";
}
function psFontFamilyKey(f) { if (f === "Georgia" || f === "serif") return "serif"; if (f === "monospace" || f === "mono") return "mono"; if (f === "Impact" || f === "display") return "display"; return "sans"; }
function applyTextDialog() {
  let l = psActive();
  let prev = psEditingText && l.text ? l.text : null;
  let size = psClamp(Math.round(psNum(dlgSize, 64)), 1, 1000);
  let x = prev ? prev.x : (psTextPoint ? psTextPoint.x : 80), y = prev ? prev.y : (psTextPoint ? psTextPoint.y : 80);
  let color = psIsHex(dlgColor) ? dlgColor : fgColor;
  psAddText(String(dlgText || ""), { x: x, y: y, font: dlgFont, size: size, bold: !!dlgBold, color: color, align: prev ? (prev.align || "left") : "left" }, !!prev, null);
}

// ---------------------------------------------------------------------------
// Layer panel
// ---------------------------------------------------------------------------
function selectLayer(id) { if (uiBusy()) return; psSetActive(id); psRefreshPanels(); psUpdateStatus(); }
function editLayerMask(id) { if (uiBusy()) return; psSetActive(id); let l = psActive(); if (l.mask) { PS_MASKMODE = true; fgColor = "#ffffff"; bgColor = "#000000"; } uiOnDocument("change"); }
function toggleLayerVisible(id) { if (uiBusy()) return; uiGuard(function () { psSetActive(id); psLayerAction("Layer visibility", null, null); }); }
function toggleLayerLock(id) { if (uiBusy()) return; uiGuard(function () { psSetActive(id); psLayerAction("Layer lock", null, null); }); }
function renameLayer(id) { if (uiBusy()) return; psSetActive(id); dlgLayerName = psActive().name; dialog = "rename"; }
function layerButton(action) { runAction(action); }
function setLayerBlend(v) { if (uiBusy()) return; uiGuard(function () { psLayerAction("Layer blend", String(v), null); }); }
function setLayerOpacity(v) { if (uiBusy()) return; let n = psNum(v, NaN); if (!Number.isFinite(n)) return; uiGuard(function () { psLayerAction("Layer opacity", psClamp(n, 0, 100) / 100, null); }); }
function showTab(t) { sidebarTab = t; }

// ---------------------------------------------------------------------------
// Files: open, place, save
// ---------------------------------------------------------------------------
function filesChosen(files) {
  if (!files || !files.length) return;
  let file = files[0];
  if (file.size > PS_MAX_FILE_BYTES) { uiNotify("Files are limited to " + (PS_MAX_FILE_BYTES / 1048576) + " MiB in this edition.", true); return; }
  let place = psPlacePending; psPlacePending = false;
  let name = String(file.name || "image");
  let lower = name.toLowerCase();
  if (lower.slice(-7) === ".sphoto") {
    if (place) { uiNotify("Open projects as documents, not placed layers.", true); return; }
    psConfirmDiscard(function () {
      jobActive = true; jobLabel = "Reading file";
      softn.files.readText(file.ref, function (text) {
        jobActive = psJobsPending() > 0;
        if (typeof text !== "string") { uiNotify("Could not read that file. Choose Allow in the permission bar and try again.", true); return; }
        psOpenProjectJob(name, text, function () { uiNotify("Project opened.", false); }, uiError);
      });
    });
    return;
  }
  let proceed = function () {
    jobActive = true; jobLabel = "Reading file";
    softn.files.readBase64(file.ref, function (dataUrl) {
      jobActive = psJobsPending() > 0;
      if (typeof dataUrl !== "string") { uiNotify("Could not read that file. Choose Allow in the permission bar and try again.", true); return; }
      let bytes;
      try { bytes = psFromBase64(dataUrl); } catch (e) { uiNotify("Could not decode that file.", true); return; }
      psOpenBytes(name, bytes, place);
    });
  };
  if (place) proceed(); else psConfirmDiscard(proceed);
}
function psOpenBytes(name, bytes, place) {
  if (psIsPsd(bytes)) {
    if (place) { uiNotify("Open PSD files as documents.", true); return; }
    psPsdReadJob(bytes, function (psd) {
      if (psd.warnings.length) { psPendingPsd = { name: name, psd: psd }; dialogWarnings = psd.warnings.slice(); psdHasComposite = !!psd.composite; dialog = "psdChoice"; return; }
      uiGuard(function () { psOpenPsdJob(name, psd, "layers", null, uiError); });
    }, uiError);
    return;
  }
  let onImage = function (img) {
    psFitImageJob(img.w, img.h, img.data, function (w, h, data, scaled) {
      uiGuard(function () {
        let warnings = img.warnings ? img.warnings.slice() : [];
        if (scaled) warnings.push("The image was downscaled to " + w + " x " + h + " to fit this edition's " + psMegapixelText() + " megapixel limit.");
        if (place) psPlaceImage(name, w, h, data, function () { if (warnings.length) uiNotify(warnings[0], false); });
        else { psOpenRaster(name, w, h, data, warnings); if (warnings.length) uiNotify(warnings[0], false); }
      });
    }, uiError);
  };
  if (psIsPng(bytes)) psPngDecodeJob(bytes, onImage, uiError);
  else if (psIsJpeg(bytes)) psJpegDecodeJob(bytes, onImage, uiError, { maxPixels: PS_MAX_PIXELS });
  else if (psIsGif(bytes)) psGifDecodeJob(bytes, onImage, uiError);
  else if (psIsBmp(bytes)) psBmpDecodeJob(bytes, onImage, uiError);
  else uiNotify("Open a PNG, JPEG, GIF, BMP, PSD or .sphoto file. WebP and AVIF need the native edition.", true);
}
function psdChoice(choice) {
  let pending = psPendingPsd; psPendingPsd = null; dialog = "";
  if (!pending || choice === "cancel") return;
  uiGuard(function () { psOpenPsdJob(pending.name, pending.psd, choice, function () { uiNotify("Opened with " + pending.psd.warnings.length + " compatibility notice(s). See Help > Compatibility.", false); }, uiError); });
}
function psSaveBytes(name, bytes, mime, done) {
  softn.files.saveFile(name, bytes.toBase64(), { mime: mime, base64: true }, function (r) {
    if (r && r.error) uiNotify(r.error, true); else if (done) done();
  });
}
function exportImage() {
  let format = dlgFormat, quality = psClamp(psNum(dlgQuality, 92), 10, 100), bg = psIsHex(dlgJpegBg) ? dlgJpegBg : "#ffffff";
  psCleanCompositeJob(function (comp) {
    if (format === "jpeg") psJpegEncodeJob(comp, PS_W, PS_H, quality, psHexToRgb(bg), function (bytes) { psSaveBytes(PS_NAME + ".jpg", bytes, "image/jpeg", function () { uiNotify("JPEG download requested. Your layers are unchanged.", false); }); }, uiError);
    else psPngEncodeJob(comp, PS_W, PS_H, function (bytes) { psSaveBytes(PS_NAME + ".png", bytes, "image/png", function () { uiNotify("PNG download requested. Your layers are unchanged.", false); }); }, uiError);
  }, uiError);
}
function savePsd() {
  psCleanCompositeJob(function (comp) {
    psPsdWriteJob(psPsdDocument(comp), function (bytes) {
      psSaveBytes(PS_NAME + ".psd", bytes, "image/vnd.adobe.photoshop", function () {
        let hasText = false; for (let i = 0; i < PS_LAYERS.length; i++) if (PS_LAYERS[i].text) hasText = true;
        if (!hasText && !PS_WARNINGS.length) psMarkSaved();
        uiNotify("PSD download requested. Keep a .sphoto too for editable type.", false);
        uiOnDocument("status");
      });
    }, uiError);
  }, uiError);
}
function saveProject() {
  if (uiBusy()) return;
  psProjectJob(function (json) {
    softn.files.saveFile(PS_NAME + ".sphoto", json, { mime: "application/json" }, function (r) {
      if (r && r.error) { uiNotify(r.error, true); return; }
      psMarkSaved(); uiNotify("Editable project download requested.", false); uiOnDocument("status");
    });
  }, uiError);
}

// ---------------------------------------------------------------------------
// Welcome canvas
// ---------------------------------------------------------------------------
function buildDemoDocument() {
  psNewDocument(1280, 800, "Something yours", "#171c34");
  let w = PS_W, h = PS_H;
  let bg = PS_LAYERS[0].data;
  let steps = [];
  steps.push(psRowStepper(h, psRowsFor(w, PS_STEP_HEAVY_PIXELS), function (y0, y1) { psGradientRows(bg, w, y0, y1, 0, 0, 1280, 800, false, [23, 28, 52], [50, 33, 59], 1, null); }));
  let shape = psAddLayer("Colour studies", null);
  let sd = shape.data;
  steps.push(psRowStepper(h, psRowsFor(w, PS_STEP_HEAVY_PIXELS / 4), function (y0, y1) {
    // Radial halo inside a rotated ellipse.
    let cx = 1100, cy = 460, rx = 410, ry = 570, ang = -0.5, ca = Math.cos(ang), sa = Math.sin(ang);
    for (let y = y0; y < y1; y++) for (let x = 0; x < w; x++) {
      let dx = x + 0.5 - cx, dy = y + 0.5 - cy;
      let ux = (dx * ca + dy * sa) / rx, uy = (-dx * sa + dy * ca) / ry;
      let f = ux * ux + uy * uy;
      if (f > 1.02) continue;
      let edge = f > 0.96 ? (1.02 - f) / 0.06 : 1;
      let hx = x - 1000, hy = y - 380, t = Math.sqrt(hx * hx + hy * hy) / 520;
      let r, g, b;
      if (t < 0.42) { let k = t / 0.42; r = 255 + (233 - 255) * k; g = 209 + (124 - 209) * k; b = 159 + (118 - 159) * k; }
      else if (t < 0.75) { let k = (t - 0.42) / 0.33; r = 233 + (164 - 233) * k; g = 124 + (136 - 124) * k; b = 118 + (224 - 118) * k; }
      else { let k = Math.min(1, (t - 0.75) / 0.25); r = 164 + (84 - 164) * k; g = 136 + (104 - 136) * k; b = 224 + (167 - 224) * k; }
      let i = (y * w + x) * 4;
      sd[i] = r; sd[i + 1] = g; sd[i + 2] = b; sd[i + 3] = (255 * edge + 0.5) | 0;
    }
  }));
  steps.push(psRowStepper(h, psRowsFor(w, PS_STEP_HEAVY_PIXELS / 12), function (y0, y1) {
    // Concentric ellipse rings: twenty tests per pixel, so the slices are small and
    // pixels well outside the outermost ring are skipped before any of them.
    let ang = -0.55, ca = Math.cos(ang), sa = Math.sin(ang);
    let outerRx = 240 + 19 * 12 + 4, outerRy = 370 + 19 * 14 + 4, innerRx = 240 - 4, innerRy = 370 - 4;
    for (let y = y0; y < y1; y++) for (let x = 0; x < w; x++) {
      let dx = x + 0.5 - 1020, dy = y + 0.5 - 440;
      let px = dx * ca + dy * sa, py = -dx * sa + dy * ca;
      let fo = (px * px) / (outerRx * outerRx) + (py * py) / (outerRy * outerRy);
      if (fo > 1) continue;
      let fi = (px * px) / (innerRx * innerRx) + (py * py) / (innerRy * innerRy);
      if (fi < 1) continue;
      let best = 0;
      for (let k = 0; k < 20; k++) {
        let rx = 240 + k * 12, ry = 370 + k * 14;
        let f = (px * px) / (rx * rx) + (py * py) / (ry * ry);
        let gx = 2 * px / (rx * rx), gy = 2 * py / (ry * ry), g = Math.sqrt(gx * gx + gy * gy);
        if (g < 1e-9) continue;
        let d = Math.abs(f - 1) / g;
        let c = 1.2 - d; if (c > 1) c = 1;
        if (c > best) best = c;
      }
      if (best <= 0) continue;
      let a = best * 0.5, i = (y * w + x) * 4, da = sd[i + 3] / 255, oa = a + da * (1 - a), wS = a / oa, wD = 1 - wS;
      sd[i] = (245 * wS + sd[i] * wD + 0.5) | 0; sd[i + 1] = (212 * wS + sd[i + 1] * wD + 0.5) | 0; sd[i + 2] = (191 * wS + sd[i + 2] * wD + 0.5) | 0; sd[i + 3] = (oa * 255 + 0.5) | 0;
    }
  }));
  let label = psAddLayer("Edition & details", null);
  let ld = label.data;
  steps.push(psTextRasterStep(ld, w, h, { text: "SOFTN PHOTO STUDIO    /    SANDBOX EDITION", x: 80, y: 62, size: 15, color: "#b7b8d4", font: "mono", bold: false, align: "left" }));
  steps.push(psTextRasterStep(ld, w, h, { text: "YOUR CANVAS. YOUR RULES.", x: 80, y: 698, size: 15, color: "#b7b8d4", font: "mono", bold: false, align: "left" }));
  steps.push(function () { for (let y = 112; y < 115; y++) for (let x = 80; x < 125; x++) { let i = (y * w + x) * 4; ld[i] = 168; ld[i + 1] = 224; ld[i + 2] = 207; ld[i + 3] = 255; } return true; });
  steps.push(psTextRasterStep(ld, w, h, { text: "A little colour. A lot of possibility.", x: 80, y: 600, size: 19, color: "#dddded", font: "sans", bold: false, align: "left" }));
  let title = psAddLayer("Make something yours", null);
  title.kind = "text"; title.text = { text: "Make\nsomething\nyours.", x: 73, y: 185, size: 105, color: "#f4f0eb", font: "sans", bold: true, align: "left" };
  steps.push(psTextRasterStep(title.data, w, h, title.text));
  psAddLayer("Your next idea", null);
  psEnqueue("Preparing the welcome canvas", psSequence(steps), function () { psInvalidateAll(); psResetHistory("Welcome canvas"); psEmit("document"); }, uiError);
}
