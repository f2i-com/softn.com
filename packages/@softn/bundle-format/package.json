{
  "name": "@softn/bundle-format",
  "version": "0.0.54",
  "private": true,
  "description": "The .softn bundle contract every SoftN surface shares: the archive reader, the inspector, permission declarations and the page-to-page hand-off. No engine, no React.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./zip": "./src/zip.ts",
    "./engine": "./src/engine.ts",
    "./source-modules": "./src/source-modules.ts",
    "./web-imports": "./src/web-imports.ts",
    "./offline-assets": "./src/offline-assets.ts",
    "./inspect": "./src/inspect.ts",
    "./validation": "./src/validation.ts",
    "./builder": "./src/builder.ts",
    "./handoff": "./src/handoff.ts",
    "./capabilities": "./src/capabilities.ts",
    "./url": "./src/url.ts",
    "./crypto": "./src/crypto.ts",
    "./sha256": "./src/sha256.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
