// Twenty48 — slide the tiles, merge the equals, reach 2048 and keep going.
// The board is 16 numbers; every move is a row-wise slide-and-merge on a
// rotated view of it. Tiles carry stable ids so the UI can animate them.

let SIZE = 4
let board = []          // { id, value, r, c, merged, fresh } per tile, synced to the UI
let score = 0
let best = 0
let won = false
let keepGoing = false
let over = false
let moves = 0
let nextId = 1
let rngSeed = 1
let history = []        // last few states for undo
let toast = ""
let toastTicks = 0

let muted = false

function play(name, volume) {
  if (muted) { return }
  softn.audio.play("assets/sfx/" + name + ".wav", { volume: volume })
}

function toggleMute() {
  muted = !muted
  try { localStorage.setItem("twenty48:muted", muted ? "1" : "0") } catch (err) {}
}

function myRand() {
  rngSeed = (rngSeed * 48271) % 2147483647
  return rngSeed / 2147483647
}

function isUiControl(e) {
  let tag = e.targetTag || ""
  return tag === "input" || tag === "textarea" || tag === "select"
}

function _init() {
  if (window.__t48Cleanup) { window.__t48Cleanup() }
  rngSeed = (Date.now() % 100000) + 11
  window.__t48Dir = ""
  window.__t48SwipeX = -1
  window.__t48SwipeY = 0
  try { best = parseInt(localStorage.getItem("twenty48:best") || "0") || 0 } catch (err) { best = 0 }
  try { muted = localStorage.getItem("twenty48:muted") === "1" } catch (err) { muted = false }

  function onKeyDown(e) {
    if (isUiControl(e)) { return }
    let key = e.key || ""
    if (key === "ArrowLeft" || key === "a" || key === "A") { window.__t48Dir = "left"; e.preventDefault() }
    else if (key === "ArrowRight" || key === "d" || key === "D") { window.__t48Dir = "right"; e.preventDefault() }
    else if (key === "ArrowUp" || key === "w" || key === "W") { window.__t48Dir = "up"; e.preventDefault() }
    else if (key === "ArrowDown" || key === "s" || key === "S") { window.__t48Dir = "down"; e.preventDefault() }
    else if (key === "z" || key === "Z" || key === "Backspace") { window.__t48Dir = "undo" }
    else if (key === "r" || key === "R") { window.__t48Dir = "new" }
    else if (key === "m" || key === "M") { window.__t48Dir = "mute" }
  }
  // Swipes, anywhere on the page that is not a control: a finger or a mouse
  // drag of more than a few pixels mostly one way is a move that way. A
  // template handler cannot see the pointer position (DOM events are nulled
  // before they reach a script), so these are window listeners.
  function onPointerDown(e) {
    if (isUiControl(e) || e.targetTag === "button") { window.__t48SwipeX = -1; return }
    // Only the primary button (or a finger) swipes; a right-button drag is not a move.
    if (typeof e.button === "number" && e.button !== 0) { window.__t48SwipeX = -1; return }
    window.__t48SwipeX = e.clientX || 0
    window.__t48SwipeY = e.clientY || 0
  }
  function onPointerUp(e) {
    if (window.__t48SwipeX < 0) { return }
    let dx = (e.clientX || 0) - window.__t48SwipeX
    let dy = (e.clientY || 0) - window.__t48SwipeY
    window.__t48SwipeX = -1
    let ax = Math.abs(dx)
    let ay = Math.abs(dy)
    if (ax < 24 && ay < 24) { return }
    if (ax > ay) { window.__t48Dir = dx > 0 ? "right" : "left" }
    else { window.__t48Dir = dy > 0 ? "down" : "up" }
  }
  window.addEventListener("keydown", onKeyDown, true)
  window.addEventListener("pointerdown", onPointerDown)
  window.addEventListener("pointerup", onPointerUp)
  window.__t48Cleanup = function () {
    window.removeEventListener("keydown", onKeyDown, true)
    window.removeEventListener("pointerdown", onPointerDown)
    window.removeEventListener("pointerup", onPointerUp)
  }
  let restored = false
  try {
    let raw = localStorage.getItem("twenty48:game")
    if (raw) {
      let g = JSON.parse(raw)
      if (g && validTiles(g.board)) {
        // Rebuild the tiles rather than trust the stored objects: a save
        // from an older build, or one edited by hand, must not put a tile
        // without an id or an animation flag on the board.
        board = []
        let maxId = 0
        let ti = 0
        while (ti < g.board.length) {
          let t = g.board[ti]
          let id = typeof t.id === "number" && t.id > 0 ? Math.floor(t.id) : 0
          if (id === 0) { maxId = maxId + 1; id = maxId }
          if (id > maxId) { maxId = id }
          board.push({ id: id, value: t.value, r: t.r, c: t.c, merged: false, fresh: false })
          ti = ti + 1
        }
        score = typeof g.score === "number" && g.score >= 0 ? Math.floor(g.score) : 0
        moves = typeof g.moves === "number" && g.moves >= 0 ? Math.floor(g.moves) : 0
        won = !!g.won
        keepGoing = !!g.keepGoing
        nextId = typeof g.nextId === "number" && g.nextId > maxId ? Math.floor(g.nextId) : maxId + 1
        restored = true
      }
    }
  } catch (err) { restored = false }
  if (!restored) { newGame() }
  else {
    over = !anyMoves()
    // A saved game can be ahead of the saved best (the best is written on
    // each move, but a cleared or older best key must still catch up).
    if (score > best) {
      best = score
      try { localStorage.setItem("twenty48:best", String(best)) } catch (err) {}
    }
  }
}

// A saved board is a list of 1..16 tiles, each a power of two at a distinct
// cell inside the grid. Anything else is treated as no save at all.
function validTiles(list) {
  if (!Array.isArray(list) || list.length === 0 || list.length > SIZE * SIZE) { return false }
  let seen = {}
  let i = 0
  while (i < list.length) {
    let t = list[i]
    if (!t || typeof t !== "object") { return false }
    if (typeof t.value !== "number" || typeof t.r !== "number" || typeof t.c !== "number") { return false }
    if (t.value < 2 || t.value !== Math.floor(t.value) || (t.value & (t.value - 1)) !== 0) { return false }
    if (t.r < 0 || t.r >= SIZE || t.c < 0 || t.c >= SIZE || t.r !== Math.floor(t.r) || t.c !== Math.floor(t.c)) { return false }
    let key = t.r + "," + t.c
    if (seen[key]) { return false }
    seen[key] = true
    i = i + 1
  }
  return true
}

function showToast(msg) {
  toast = msg
  toastTicks = 45
}

function newGame() {
  board = []
  score = 0
  moves = 0
  won = false
  keepGoing = false
  over = false
  history = []
  addTile()
  addTile()
  persist()
}

function persist() {
  try {
    localStorage.setItem("twenty48:game", JSON.stringify({ board: board, score: score, moves: moves, won: won, keepGoing: keepGoing, nextId: nextId }))
  } catch (err) {}
  if (score > best) {
    best = score
    try { localStorage.setItem("twenty48:best", String(best)) } catch (err) {}
  }
}

function tileAt(r, c) {
  let i = 0
  while (i < board.length) {
    if (board[i].r === r && board[i].c === c) { return board[i] }
    i = i + 1
  }
  return null
}

function addTile() {
  let empty = []
  let r = 0
  while (r < SIZE) {
    let c = 0
    while (c < SIZE) {
      if (!tileAt(r, c)) { empty.push({ r: r, c: c }) }
      c = c + 1
    }
    r = r + 1
  }
  if (empty.length === 0) { return }
  let spot = empty[Math.floor(myRand() * empty.length)]
  board.push({ id: nextId, value: myRand() < 0.9 ? 2 : 4, r: spot.r, c: spot.c, merged: false, fresh: true })
  nextId = nextId + 1
}

// One line of the board in slide order: the tiles at (line, k) for k 0..3,
// read through a direction so all four moves are the same routine.
function cellFor(dir, line, k) {
  if (dir === "left") { return { r: line, c: k } }
  if (dir === "right") { return { r: line, c: SIZE - 1 - k } }
  if (dir === "up") { return { r: k, c: line } }
  return { r: SIZE - 1 - k, c: line }
}

function move(dir) {
  if (over) { return }
  // The win state is part of the snapshot: undoing the move that made 2048
  // must take the "You made 2048" overlay away with it.
  let snapshot = JSON.stringify({ board: board, score: score, moves: moves, won: won, keepGoing: keepGoing })
  let changed = false
  let gained = 0
  let next = []
  let i = 0
  while (i < board.length) { board[i].merged = false; board[i].fresh = false; i = i + 1 }
  let line = 0
  while (line < SIZE) {
    // Collect this line's tiles in slide order.
    let tiles = []
    let k = 0
    while (k < SIZE) {
      let cell = cellFor(dir, line, k)
      let t = tileAt(cell.r, cell.c)
      if (t) { tiles.push(t) }
      k = k + 1
    }
    // Slide and merge pairs from the front.
    let out = []
    let j = 0
    while (j < tiles.length) {
      let t = tiles[j]
      if (j + 1 < tiles.length && tiles[j + 1].value === t.value) {
        let m = { id: t.id, value: t.value * 2, r: 0, c: 0, merged: true, fresh: false }
        gained = gained + m.value
        out.push(m)
        j = j + 2
      } else {
        out.push(t)
        j = j + 1
      }
    }
    k = 0
    while (k < out.length) {
      let cell = cellFor(dir, line, k)
      let t = out[k]
      if (t.r !== cell.r || t.c !== cell.c || t.merged) { changed = true }
      t.r = cell.r
      t.c = cell.c
      next.push(t)
      k = k + 1
    }
    line = line + 1
  }
  if (!changed) { return }
  board = next
  score = score + gained
  moves = moves + 1
  history.push(snapshot)
  if (history.length > 8) { history = history.slice(history.length - 8) }
  addTile()
  let justWon = false
  if (!won && !keepGoing) {
    i = 0
    while (i < board.length) { if (board[i].value >= 2048) { won = true; justWon = true }; i = i + 1 }
  }
  over = !anyMoves()
  if (justWon) { play("win", 0.5) }
  else if (over) { play("over", 0.45) }
  else if (gained > 0) { play("merge", gained >= 128 ? 0.5 : 0.35) }
  persist()
}

function anyMoves() {
  if (board.length < SIZE * SIZE) { return true }
  let r = 0
  while (r < SIZE) {
    let c = 0
    while (c < SIZE) {
      let t = tileAt(r, c)
      let right = tileAt(r, c + 1)
      let down = tileAt(r + 1, c)
      if (t && ((right && right.value === t.value) || (down && down.value === t.value))) { return true }
      c = c + 1
    }
    r = r + 1
  }
  return false
}

function undo() {
  if (history.length === 0) { showToast("Nothing to undo"); return }
  let snap = JSON.parse(history[history.length - 1])
  history = history.slice(0, history.length - 1)
  board = snap.board
  // The snapshot was taken before the move cleared the previous move's
  // animation flags; restored tiles should sit still, not pop again.
  let i = 0
  while (i < board.length) { board[i].merged = false; board[i].fresh = false; i = i + 1 }
  score = snap.score
  moves = snap.moves
  won = !!snap.won
  keepGoing = !!snap.keepGoing
  over = false
  persist()
}

function continueGame() {
  keepGoing = true
  won = false
}

function pump() {
  if (toastTicks > 0) { toastTicks = toastTicks - 1; if (toastTicks === 0) { toast = "" } }
  let d = window.__t48Dir
  if (d === "") { return }
  window.__t48Dir = ""
  if (d === "undo") { undo() }
  else if (d === "new") { newGame() }
  else if (d === "mute") { toggleMute() }
  // While the win overlay is up, moves wait for "Keep going"; undo and a new
  // game (which the overlay's own buttons offer) still work from the keys.
  else if (won && !keepGoing) { return }
  else { move(d) }
}

function tileColor(v) {
  if (v === 2) { return "#eee4da" }
  if (v === 4) { return "#ede0c8" }
  if (v === 8) { return "#f2b179" }
  if (v === 16) { return "#f59563" }
  if (v === 32) { return "#f67c5f" }
  if (v === 64) { return "#f65e3b" }
  if (v === 128) { return "#edcf72" }
  if (v === 256) { return "#edcc61" }
  if (v === 512) { return "#edc850" }
  if (v === 1024) { return "#edc53f" }
  if (v === 2048) { return "#edc22e" }
  return "#3c3a32"
}

function tileInk(v) {
  return v <= 4 ? "#776e65" : "#f9f6f2"
}

function tileSize(v) {
  if (v < 100) { return "34px" }
  if (v < 1000) { return "28px" }
  return "22px"
}

function tileStyle(t) {
  let cell = 100 / SIZE
  return {
    position: "absolute",
    left: (t.c * cell) + "%",
    top: (t.r * cell) + "%",
    width: cell + "%",
    height: cell + "%",
    padding: "5px",
    transition: "left 110ms ease, top 110ms ease",
    zIndex: t.merged ? 3 : 2
  }
}

function faceStyle(t) {
  return {
    width: "100%",
    height: "100%",
    borderRadius: "8px",
    background: tileColor(t.value),
    color: tileInk(t.value),
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    fontWeight: 800,
    fontSize: tileSize(t.value),
    boxShadow: t.value >= 128 ? "0 0 22px rgba(237,194,46,0.35), inset 0 0 0 1px rgba(255,255,255,0.15)" : "inset 0 0 0 1px rgba(255,255,255,0.12)"
  }
}

function padPress(dir) {
  window.__t48Dir = dir
}
function padRelease(dir) {}

