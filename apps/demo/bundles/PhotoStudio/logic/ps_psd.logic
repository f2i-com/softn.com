    if (width < 1 || height < 1 || width > 16384 || height > 16384 || width * height > 16 * 1024 * 1024) psFail("PSD dimensions are outside what this edition can open.");
    if (depth !== 8 || mode !== 3) psFail("This editor supports 8-bit RGB PSD files. Convert a copy to RGB / 8 Bits per Channel first.");
