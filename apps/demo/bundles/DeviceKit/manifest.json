      "ui/pages/FileBrowser.ui"
    ],
    "logic": [
      "logic/main.logic"
    ],
    "assets": [
      "assets/icon.svg"
    ]
  },
  "config": {
    "window": {
      "title": "Device Kit",
      "width": 1000,
      "height": 720
    },
    "theme": {
      "primary": "#3b82f6",
      "mode": "light"
    }
  }
