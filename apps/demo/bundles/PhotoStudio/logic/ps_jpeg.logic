// Reduced IDCT: N x N output from the low N x N coefficients (N = 1, 2, 4).
function psJpegIdctN(coef, offset, qt, out, outOffset, stride, N, tmp) {
  if (N === 1) {
    let v = Math.round(coef[offset] * qt[0] / 8 + 128);
    out[outOffset] = v < 0 ? 0 : v > 255 ? 255 : v;
