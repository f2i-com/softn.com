// main.ui — SoftDOS, an x86 PC and DOS machine emulated in .logic.
//
// A CRT monitor with a drive beside it: drop a program's files, or the zip a
// game came in, and run it from the prompt or from the list. The keyboard,
// the mouse over the screen and the touch pads all reach the program.
//
// The layout follows the window. Wide desktops put the drive and controls
// beside the monitor, which sizes itself so the whole picture stays on
// screen; narrower windows and tablets stack them below; a phone held
// sideways becomes a handheld, pads either side of the screen.

<logic src="../logic/main.logic" />

<style>
.dos-shell {
  --pc-beige: #d8d2c4;
  --pc-beige-dark: #b8b2a4;
  --pc-bezel: #242428;
  --pc-screen: #000000;
  --pc-green: #33ff33;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  min-height: 100%;
  padding: clamp(0.5rem, 1.5vw, 1.25rem) clamp(0.5rem, 2vw, 1.5rem) 2rem;
  background: radial-gradient(circle at 50% 0%, #2a2a32 0%, #101014 80%);
}

/* The header: title and badges left, the buttons right, wrapping as needed. */
.dos-header {
  width: 100%;
  max-width: 100rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
}

.dos-header-buttons {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.25rem;
}

/* One column by default; the side column joins on wide windows. */
.dos-layout {
  width: 100%;
  max-width: 100rem;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 1rem;
  align-items: start;
  justify-items: center;
  min-width: 0;
}

/* The monitor keeps its whole picture on screen: its width is bounded by
   what the window's height allows, screen plus bezel and chrome. */
.dos-monitor-col {
  width: 100%;
  min-width: 0;
  max-width: min(100%, calc((100vh - 18rem) * 1.6 + 6.5rem));
}

.dos-theater .dos-monitor-col {
  max-width: min(100%, calc((100vh - 18rem) * 1.6 + 6.5rem));
}

.dos-side-col {
  width: 100%;
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 1rem;
  align-self: stretch;
}

.dos-card {
  min-width: 0;
}

.dos-crt-monitor {
  width: 100%;
  background: #d8d2c4;
  border-radius: 16px 16px 24px 24px;
  padding: clamp(0.6rem, 1.5vw, 1.25rem) clamp(0.6rem, 1.8vw, 1.5rem) clamp(0.75rem, 1.8vw, 1.5rem);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  border: 2px solid #b8b2a4;
}

.dos-screen-bezel {
  background: #242428;
  border-radius: 12px;
  padding: clamp(0.5rem, 1.4vw, 1.25rem) clamp(0.6rem, 2vw, 1.75rem) clamp(0.6rem, 1.6vw, 1.5rem);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dos-crt-screen {
  background: #000;
  border-radius: 6px;
  overflow: hidden;
  width: 100%;
  aspect-ratio: 320 / 200;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #141416;
  touch-action: none;
}

.dos-crt-screen canvas {
  image-rendering: pixelated;
  image-rendering: crisp-edges;
  display: block;
}

.dos-monitor-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem;
  padding: 0 0.25rem;
}

.dos-inset {
  box-shadow: inset 0 3px 6px rgba(0, 0, 0, 0.7), inset 0 -1px 1px rgba(255, 255, 255, 0.1);
}

.dos-raised {
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.45);
}

.dos-btn {
  user-select: none;
  -webkit-user-select: none;
  touch-action: none;
  cursor: pointer;
  transition: transform 60ms, background 100ms;
}

.dos-btn:active {
  transform: translateY(2px);
}

.dos-key {
  display: inline-block;
  margin: 0 0.05rem 0.2rem 0;
  font-family: ui-monospace, Menlo, Consolas, monospace;
  font-size: 0.68rem;
  padding: 0.05rem 0.35rem;
  border-radius: 4px;
  background: #2a2a34;
  border: 1px solid #444450;
  color: #d8d8e0;
  white-space: nowrap;
}

.dos-program-chip {
  font-family: ui-monospace, Menlo, Consolas, monospace;
}

/* The touch pad: a D-pad and the keys games ask for most. */
.dos-touch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
}

.dos-keypad-grid {
  display: grid;
  grid-template-columns: repeat(3, clamp(38px, 10vw, 48px));
  gap: 5px;
}

.dos-keypad-grid .dos-btn {
  padding: 0.5rem 0;
  font-size: 0.85rem;
  background: #2e2e38;
  border: 1px solid #444450;
}

.dos-action-keys {
  flex: 1;
  min-width: 150px;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

/* The handheld pads: only a phone held sideways shows them. */
.dos-pad {
  display: none;
}

/* ---------------------------------------------------------------------------
   Wide windows: the drive and controls beside the monitor.
   --------------------------------------------------------------------------- */
@media (min-width: 64rem) {
  .dos-layout {
    grid-template-columns: minmax(0, 1fr) clamp(18rem, 26vw, 24rem);
  }
  .dos-layout.dos-theater {
    grid-template-columns: minmax(0, 1fr);
  }
  .dos-theater .dos-side-col {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    max-width: calc((100vh - 18rem) * 1.6 + 6.5rem);
  }
}

/* Tablets and small desktop windows: the two cards side by side below. */
@media (min-width: 44rem) and (max-width: 63.99rem) {
  .dos-side-col {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
}

/* ---------------------------------------------------------------------------
   Phones held upright.
   --------------------------------------------------------------------------- */
@media (max-width: 44rem) {
  .dos-shell {
    padding: 0.5rem 0.5rem 1.75rem;
    gap: 0.5rem;
  }
  .dos-header {
    gap: 0.35rem 0.5rem;
  }
  .dos-monitor-col {
    max-width: 100%;
  }
  .dos-crt-monitor {
    border-radius: 12px 12px 18px 18px;
  }
  .dos-help {
    display: none;
  }
  .dos-keypad-grid {
    grid-template-columns: repeat(3, clamp(44px, 14vw, 56px));
  }
}

/* ---------------------------------------------------------------------------
   Phones held sideways: a handheld, pads either side of the screen.
   --------------------------------------------------------------------------- */
@media (max-height: 32rem) and (orientation: landscape) {
  .dos-shell {
    padding: 0.25rem 0.5rem;
    gap: 0;
    min-height: 100vh;
    justify-content: center;
  }
  .dos-header {
    display: none;
  }
  .dos-layout {
    grid-template-columns: auto minmax(0, 1fr) auto !important;
    align-items: center;
    gap: 0.5rem;
  }
  .dos-side-col {
    display: none;
  }
  .dos-pad {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: center;
  }
  .dos-monitor-col {
    max-width: none;
    display: flex;
    justify-content: center;
    min-width: 0;
  }
  .dos-crt-monitor {
    width: auto;
    max-width: 100%;
    padding: 0.4rem 0.6rem;
    gap: 0.3rem;
    border-radius: 10px;
  }
  .dos-screen-bezel {
    padding: 0.4rem;
    justify-content: center;
  }
  /* The screen is sized from the height that is left under the host's own
     bar; the monitor wraps it, and the pads take the sides. */
  .dos-crt-screen {
    height: calc(100vh - 8.5rem);
    width: auto;
    max-width: 100%;
  }
  .dos-monitor-label,
  .dos-monitor-bar {
    display: none;
  }
  .dos-status-line {
    display: none;
  }
}

/* ---------------------------------------------------------------------------
   Touch Screens (Coarse Pointer)
   --------------------------------------------------------------------------- */
@media (pointer: coarse) {
  .dos-btn {
    min-height: 44px;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }
}
</style>

<App theme="dark">
  <Box className="dos-shell">

    // ---- Top Status Bar --------------------------------------------------
    <Box className="dos-header">
      <Stack direction="horizontal" gap="sm" align="center" style={{ flexWrap: "wrap" }}>
        <Heading level={3} style={{ color: "#e0dcd0", margin: 0, letterSpacing: "0.05em", fontSize: "clamp(1rem, 2.2vw, 1.25rem)" }}>
          SoftDOS
        </Heading>
        <Badge variant="success">{cpuModeText}</Badge>
        <Badge variant="outline" style={{ fontFamily: "monospace", fontSize: "0.72rem" }}>{fpsText}</Badge>
        #if (cyclesText !== "")
          <Badge variant="outline" style={{ fontFamily: "monospace", fontSize: "0.72rem" }}>{cyclesText}</Badge>
        #end
      </Stack>

      <Box className="dos-header-buttons">
        // CRT Color Themes
        <Button @click={setCrtColor} size="xs" variant={crtTheme === "color" ? "primary" : "ghost"} style={{ fontSize: "0.65rem" }}>RGB</Button>
        <Button @click={setCrtGreen} size="xs" variant={crtTheme === "green" ? "primary" : "ghost"} style={{ fontSize: "0.65rem", color: "#33ff33" }}>Green</Button>
        <Button @click={setCrtAmber} size="xs" variant={crtTheme === "amber" ? "primary" : "ghost"} style={{ fontSize: "0.65rem", color: "#ffaa22" }}>Amber</Button>

        <Button @click={toggleExpanded} size="xs" variant="ghost" style={{ fontSize: "0.65rem", marginLeft: "0.25rem" }}>
          {isExpanded ? "Standard View" : "Theater Mode"}
        </Button>
        <Button @click={togglePause} variant="ghost" size="xs" style={{ fontSize: "0.65rem" }}>
          {isRunning ? "Pause" : "Resume"}
        </Button>
        <Button @click={toggleMute} variant="ghost" size="xs" style={{ fontSize: "0.65rem" }}>
          {isMuted ? "Unmute" : "Mute"}
        </Button>
      </Box>
    </Box>

    <Box className={isExpanded ? "dos-layout dos-theater" : "dos-layout"}>

      // The left pad of the handheld layout: directions.
      <Box className="dos-pad dos-pad-left">
        <Box className="dos-keypad-grid">
          <Box />
          <Button className="dos-btn" @pointerdown={pressUp} @pointerup={releaseUp} @pointerleave={releaseUp} @pointercancel={releaseUp} ariaLabel="Up">▲</Button>
          <Box />
          <Button className="dos-btn" @pointerdown={pressLeft} @pointerup={releaseLeft} @pointerleave={releaseLeft} @pointercancel={releaseLeft} ariaLabel="Left">◀</Button>
          <Button className="dos-btn" @pointerdown={pressDown} @pointerup={releaseDown} @pointerleave={releaseDown} @pointercancel={releaseDown} ariaLabel="Down">▼</Button>
          <Button className="dos-btn" @pointerdown={pressRight} @pointerup={releaseRight} @pointerleave={releaseRight} @pointercancel={releaseRight} ariaLabel="Right">▶</Button>
        </Box>
        <Button className="dos-btn" @pointerdown={pressEsc} @pointerup={releaseEsc} @pointerleave={releaseEsc} @pointercancel={releaseEsc} size="xs" variant="ghost" style={{ fontSize: "0.65rem", background: "#25252e", width: "100%" }}>ESC</Button>
        #if (activeMode === "custom")
          <Button @click={quitToDos} size="xs" variant="outline" style={{ fontSize: "0.6rem", width: "100%" }}>Quit</Button>
        #end
      </Box>

      // ---- The CRT Monitor -----------------------------------------------
      <Box className="dos-monitor-col">
        <Box className="dos-raised dos-crt-monitor">

          // Screen Bezel
          <Box className="dos-inset dos-screen-bezel">

            // Monitor Brand & Model
            <Stack direction="horizontal" className="dos-monitor-label" style={{ width: "100%", justifyContent: "space-between", marginBottom: "0.4rem" }}>
              <Text style={{ fontSize: "0.65rem", color: "#888890", letterSpacing: "0.15em", fontWeight: 700 }}>VGA MULTISYNC COLOR</Text>
              <Text style={{ fontSize: "0.65rem", color: "#888890", letterSpacing: "0.1em" }}>{loadedFileName ? loadedFileName : "DRIVE C"}</Text>
            </Stack>

            // CRT Glass Tube Container. The pointer over it is the program's mouse.
            <Box className="dos-crt-screen"
              @pointermove={mouseMove} @pointerdown={mouseDown} @pointerup={mouseUp}
              @pointerleave={mouseLeave} @pointercancel={mouseLeave}
              style={{
                cursor: mouseCursorStyle,
                boxShadow: crtTheme === "green" ? "0 0 24px rgba(51,255,51,0.18)" : crtTheme === "amber" ? "0 0 24px rgba(255,170,34,0.18)" : "0 0 24px rgba(51,255,51,0.08)"
              }}>
              <PixelCanvas
                width={320}
                height={200}
                fit="contain"
                getFrame={frameSource}
                running={isRunning}
                smooth={false}
                @fps={fpsReport}
                style={{ width: "100%", height: "100%" }}
              />
            </Box>

            // Monitor Bezel Bottom Badge & Status
            <Stack direction="horizontal" align="center" className="dos-status-line" style={{ width: "100%", justifyContent: "space-between", marginTop: "0.5rem", gap: "0.5rem" }}>
              <Text style={{ fontSize: "0.62rem", color: "#888894", letterSpacing: "0.08em", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{statusText}</Text>
              <Stack direction="horizontal" gap="xs" align="center">
                <Box style={{ width: "8px", height: "8px", borderRadius: "50%", background: isRunning ? "#33ff33" : "#ff3333", boxShadow: isRunning ? "0 0 6px #33ff33" : "none" }} />
                <Text style={{ fontSize: "0.55rem", color: "#888890", fontWeight: 700 }}>PWR</Text>
              </Stack>
            </Stack>
          </Box>

          // Monitor Bottom: the prompt, a way out of a program, and the demos.
          <Box className="dos-monitor-bar">
            <Text style={{ fontSize: "0.75rem", fontWeight: 700, color: "#686458", letterSpacing: "0.1em" }}>SoftDOS / 486</Text>
            <Stack direction="horizontal" gap="xs" style={{ flexWrap: "wrap" }}>
              <Button @click={launchShell} size="sm" variant="outline" style={{ fontSize: "0.7rem", background: "#eae6dc" }}>C:\ Prompt</Button>
              #if (activeMode === "custom")
                <Button @click={quitToDos} size="sm" variant="primary" style={{ fontSize: "0.7rem" }}>Quit to DOS</Button>
              #end
              <Button @click={launchPlasma} size="sm" variant="outline" style={{ fontSize: "0.7rem", background: "#eae6dc" }}>PLASMA</Button>
              <Button @click={launchMandel} size="sm" variant="outline" style={{ fontSize: "0.7rem", background: "#eae6dc" }}>MANDEL</Button>
              <Button @click={launchBoxes} size="sm" variant="outline" style={{ fontSize: "0.7rem", background: "#eae6dc" }}>BOXES</Button>
              <Button @click={launchRaycast} size="sm" variant="outline" style={{ fontSize: "0.7rem", background: "#eae6dc" }}>3D demo</Button>
            </Stack>
          </Box>
        </Box>
      </Box>

      // The right pad of the handheld layout: the keys games ask for most.
      <Box className="dos-pad dos-pad-right">
        <Button className="dos-btn" @pointerdown={pressFire} @pointerup={releaseFire} @pointerleave={releaseFire} @pointercancel={releaseFire} variant="primary" style={{ padding: "0.7rem 0.9rem", borderRadius: "50%", fontWeight: 700, fontSize: "0.7rem" }}>CTRL</Button>
        <Button className="dos-btn" @pointerdown={pressUse} @pointerup={releaseUse} @pointerleave={releaseUse} @pointercancel={releaseUse} variant="outline" style={{ padding: "0.7rem 0.6rem", borderRadius: "50%", fontWeight: 700, fontSize: "0.65rem", background: "#2e2e38" }}>SPACE</Button>
        <Button className="dos-btn" @pointerdown={pressAlt} @pointerup={releaseAlt} @pointerleave={releaseAlt} @pointercancel={releaseAlt} variant="outline" style={{ padding: "0.6rem 0.8rem", borderRadius: "50%", fontWeight: 700, fontSize: "0.65rem", background: "#2e2e38" }}>ALT</Button>
        <Button className="dos-btn" @pointerdown={pressEnter} @pointerup={releaseEnter} @pointerleave={releaseEnter} @pointercancel={releaseEnter} size="xs" variant="ghost" style={{ fontSize: "0.6rem", background: "#25252e" }}>ENTER</Button>
      </Box>

      // ---- Drive C and the controls --------------------------------------
      <Box className="dos-side-col">

        // Drive C: files in, programs out.
        <Card className="dos-card" style={{ background: "#1c1c22", borderColor: "#33333c", padding: "1rem" }}>
          <Stack direction="horizontal" align="center" style={{ justifyContent: "space-between", marginBottom: "0.5rem" }}>
            <Text style={{ fontSize: "0.75rem", fontWeight: 700, color: "#a8a8b4", letterSpacing: "0.08em" }}>DRIVE C</Text>
            <Text style={{ fontSize: "0.65rem", color: "#787884" }}>{driveFileCount} file(s)</Text>
          </Stack>
          <FileChooser
            accept=".exe,.com,.zip,.bat,.dat,.wad,*"
            label="Add a game's files, or its zip"
            multiple={true}
            @select={chooseFiles}
          />
          <Text className="dos-help" style={{ display: "block", fontSize: "0.65rem", color: "#787884", marginTop: "0.5rem", lineHeight: 1.45 }}>
            Everything lands on drive C, a zip unpacked. Then type the program's name at the
            prompt, or press it below. 16-bit .COM and .EXE programs run on the emulated CPU,
            and so do 32-bit DOS-extender images (DOS/4GW and the like). A program keeps its
            configuration and saved games on the drive for as long as the page is open.
          </Text>

          #if (programList.length > 0)
            <Text style={{ display: "block", fontSize: "0.65rem", fontWeight: 700, color: "#a8a8b4", marginTop: "0.75rem", marginBottom: "0.35rem", letterSpacing: "0.08em" }}>PROGRAMS</Text>
            <Stack direction="horizontal" gap="xs" style={{ flexWrap: "wrap" }}>
              #each (name in programList)
                <Button className="dos-program-chip" @click={runListed(name)} size="xs" variant="outline" style={{ fontSize: "0.68rem", background: "#25252e" }}>{name}</Button>
              #end
            </Stack>
          #end
        </Card>

        // What reaches the program, and a pad for screens without a keyboard.
        <Card className="dos-card" style={{ background: "#1c1c22", borderColor: "#33333c", padding: "1rem" }}>
          <Text style={{ fontSize: "0.75rem", fontWeight: 700, color: "#a8a8b4", marginBottom: "0.5rem", letterSpacing: "0.08em" }}>KEYBOARD, MOUSE & TOUCH</Text>

          <Text className="dos-help" style={{ display: "block", fontSize: "0.65rem", color: "#787884", lineHeight: 1.7, marginBottom: "0.6rem" }}>
            The keyboard goes to the program while the page has focus: letters, digits,
            <Text className="dos-key">Arrows</Text> <Text className="dos-key">Space</Text> <Text className="dos-key">Ctrl</Text> <Text className="dos-key">Alt</Text> <Text className="dos-key">Shift</Text> <Text className="dos-key">Enter</Text> <Text className="dos-key">Esc</Text> <Text className="dos-key">Tab</Text> <Text className="dos-key">F1</Text>–<Text className="dos-key">F10</Text>.
            The browser keeps F11, F12 and its Ctrl shortcuts. The mouse works over the screen for
            programs that use one. Esc reaches the program; Quit to DOS, under the monitor, leaves it.
          </Text>

          <Box className="dos-touch">
            // Direction D-Pad
            <Box className="dos-keypad-grid">
              <Box />
              <Button className="dos-btn" @pointerdown={pressUp} @pointerup={releaseUp} @pointerleave={releaseUp} @pointercancel={releaseUp} ariaLabel="Up">▲</Button>
              <Box />
              <Button className="dos-btn" @pointerdown={pressLeft} @pointerup={releaseLeft} @pointerleave={releaseLeft} @pointercancel={releaseLeft} ariaLabel="Left">◀</Button>
              <Button className="dos-btn" @pointerdown={pressDown} @pointerup={releaseDown} @pointerleave={releaseDown} @pointercancel={releaseDown} ariaLabel="Down">▼</Button>
              <Button className="dos-btn" @pointerdown={pressRight} @pointerup={releaseRight} @pointerleave={releaseRight} @pointercancel={releaseRight} ariaLabel="Right">▶</Button>
            </Box>

            // The keys games ask for most, held while pressed.
            <Box className="dos-action-keys">
              <Stack direction="horizontal" gap="xs">
                <Button className="dos-btn" @pointerdown={pressFire} @pointerup={releaseFire} @pointerleave={releaseFire} @pointercancel={releaseFire} variant="primary" style={{ flex: 1, padding: "0.6rem 0.5rem", borderRadius: "6px", fontWeight: 700, fontSize: "0.75rem" }}>CTRL</Button>
                <Button className="dos-btn" @pointerdown={pressAlt} @pointerup={releaseAlt} @pointerleave={releaseAlt} @pointercancel={releaseAlt} variant="outline" style={{ flex: 1, padding: "0.6rem 0.5rem", borderRadius: "6px", fontWeight: 700, fontSize: "0.75rem", background: "#2e2e38" }}>ALT</Button>
                <Button className="dos-btn" @pointerdown={pressUse} @pointerup={releaseUse} @pointerleave={releaseUse} @pointercancel={releaseUse} variant="outline" style={{ flex: 1, padding: "0.6rem 0.5rem", borderRadius: "6px", fontWeight: 700, fontSize: "0.75rem", background: "#2e2e38" }}>SPACE</Button>
              </Stack>

              <Stack direction="horizontal" gap="xs" style={{ flexWrap: "wrap" }}>
                <Button className="dos-btn" @pointerdown={pressEsc} @pointerup={releaseEsc} @pointerleave={releaseEsc} @pointercancel={releaseEsc} size="xs" variant="ghost" style={{ flex: 1, fontSize: "0.65rem", background: "#25252e" }}>ESC</Button>
                <Button className="dos-btn" @pointerdown={pressEnter} @pointerup={releaseEnter} @pointerleave={releaseEnter} @pointercancel={releaseEnter} size="xs" variant="ghost" style={{ flex: 1, fontSize: "0.65rem", background: "#25252e" }}>ENTER</Button>
                <Button className="dos-btn" @pointerdown={pressTab} @pointerup={releaseTab} @pointerleave={releaseTab} @pointercancel={releaseTab} size="xs" variant="ghost" style={{ flex: 0.8, fontSize: "0.65rem", background: "#25252e" }}>TAB</Button>
                <Button className="dos-btn" @pointerdown={pressF1} @pointerup={releaseF1} @pointerleave={releaseF1} @pointercancel={releaseF1} size="xs" variant="ghost" style={{ flex: 0.8, fontSize: "0.65rem", background: "#25252e" }}>F1</Button>
                <Button className="dos-btn" @pointerdown={pressKeyY} @pointerup={releaseKeyY} @pointerleave={releaseKeyY} @pointercancel={releaseKeyY} size="xs" variant="ghost" style={{ flex: 0.7, fontSize: "0.65rem", background: "#25252e" }}>Y</Button>
                <Button className="dos-btn" @pointerdown={pressKeyN} @pointerup={releaseKeyN} @pointerleave={releaseKeyN} @pointercancel={releaseKeyN} size="xs" variant="ghost" style={{ flex: 0.7, fontSize: "0.65rem", background: "#25252e" }}>N</Button>
              </Stack>
            </Box>
          </Box>
        </Card>
      </Box>
    </Box>

    // Audio Output Sink
    <AudioStream
      getSamples={sampleSource}
      sampleRate={48000}
      channels={2}
      format="i16"
      running={isRunning}
      muted={isMuted}
    />
  </Box>
</App>
