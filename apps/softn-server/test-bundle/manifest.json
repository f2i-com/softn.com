{
  "name": "test-app",
  "version": "1.0.0",
  "description": "Notes app for softn-server integration testing",
  "main": "ui/main.ui",
  "files": {
    "ui": ["ui/main.ui"],
    "logic": ["logic/main.logic"],
    "xdb": [],
    "assets": []
  },
  "server": {
    "entry": "server/main.logic",
    "routes": [
      { "method": "GET", "path": "/api/hello", "handler": "handleHello" },
      { "method": "POST", "path": "/api/echo", "handler": "handleEcho" },
      { "method": "POST", "path": "/api/create-note", "handler": "handleCreateNote" },
      { "method": "GET", "path": "/api/notes", "handler": "handleGetNotes" }
    ]
  },
  "config": {
    "server": {
      "url": "ws://localhost:9876/sync",
      "auth_token": "test-secret-token",
      "collections": ["notes"]
    },
    "window": {
      "title": "Notes App",
      "width": 800,
      "height": 600
    }
  }
}
