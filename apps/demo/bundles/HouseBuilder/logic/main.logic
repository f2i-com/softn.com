const WALL_STYLES = {
  plaster: { label: "Rendered", color: "#ece9e2", texture: "" },
  brick: { label: "Brick", color: "#b0603f", texture: "brick" },
  timber: { label: "Weatherboard", color: "#c9b48c", texture: "wood" },
  stone: { label: "Stone", color: "#a19d95", texture: "stone" }
};

const ROOF_STYLES = { gable_x: "Gable, ridge east-west", gable_z: "Gable, ridge north-south", flat: "Flat", none: "None" };
const ROOF_COLORS = ["#7f1d1d", "#374151", "#78350f", "#1e3a5f", "#4d7c0f", "#9ca3af"];
const ACCENTS = ["#3b82f6", "#22c55e", "#ef4444", "#f59e0b", "#a855f7", "#475569", "#b45309", "#f8fafc", "#8b5a2b", "#0f172a"];

// ---------------------------------------------------------------------------
// Plan helpers
// ---------------------------------------------------------------------------
function newPlan() {
  return { walls: [], openings: [], rooms: [], items: [], roof: { style: "gable_x", color: "#7f1d1d" }, wallStyle: "plaster", wallHeight: 2.7 };
}

function snap(v, g) { return Math.round(v / g) * g; }
function clampWorld(v) { return Math.max(-WORLD, Math.min(WORLD, v)); }

function wallLen(w) { return Math.hypot(w.x2 - w.x1, w.z2 - w.z1); }
function wallHeading(w) { return Math.atan2(w.x2 - w.x1, w.z2 - w.z1); }
function wallById(id) { for (let i = 0; i < plan.walls.length; i = i + 1) { if (plan.walls[i].id === id) return plan.walls[i]; } return null; }
function roomById(id) { for (let i = 0; i < plan.rooms.length; i = i + 1) { if (plan.rooms[i].id === id) return plan.rooms[i]; } return null; }
function itemById(id) { for (let i = 0; i < plan.items.length; i = i + 1) { if (plan.items[i].id === id) return plan.items[i]; } return null; }
function openingById(id) { for (let i = 0; i < plan.openings.length; i = i + 1) { if (plan.openings[i].id === id) return plan.openings[i]; } return null; }

// Distance from a point to a wall's centreline, and where along it the foot lands.
function wallProject(w, x, z) {
  let dx = w.x2 - w.x1, dz = w.z2 - w.z1;
  let L2 = dx * dx + dz * dz || 1;
  let t = ((x - w.x1) * dx + (z - w.z1) * dz) / L2;
  t = Math.max(0, Math.min(1, t));
  let px = w.x1 + dx * t, pz = w.z1 + dz * t;
  return { t: t, pos: t * Math.sqrt(L2), d: Math.hypot(x - px, z - pz), x: px, z: pz };
}

function nearestWall(x, z, maxD) {
  let best = null;
  for (let i = 0; i < plan.walls.length; i = i + 1) {
    let pr = wallProject(plan.walls[i], x, z);
    if (pr.d < maxD && (!best || pr.d < best.pr.d)) best = { wall: plan.walls[i], pr: pr };
  }
  return best;
}

function openingsOn(wallId) {
  let out = [];
  for (let i = 0; i < plan.openings.length; i = i + 1) { if (plan.openings[i].wallId === wallId) out.push(plan.openings[i]); }
  out.sort(function (a, b) { return a.pos - b.pos; });
  return out;
}

function snapshot() { return JSON.stringify(plan); }

function beginEdit() {
  history.push(snapshot());
  if (history.length > 60) history.shift();
  future = [];
}

function undo() {
  if (history.length === 0) return;
  future.push(snapshot());
  plan = JSON.parse(history.pop());
  selected = null;
  planChanged();
}

function redo() {
  if (future.length === 0) return;
  history.push(snapshot());
  plan = JSON.parse(future.pop());
  selected = null;
  planChanged();
}

function planChanged() {
  planDirty = true;
  if (!loadingSample) sampleKey = "";
  canUndo = history.length > 0;
  canRedo = future.length > 0;
  wallCount = plan.walls.length;
  roomCount = plan.rooms.length;
  itemCount = plan.items.length;
  let area = 0;
  for (let i = 0; i < plan.rooms.length; i = i + 1) area = area + plan.rooms[i].w * plan.rooms[i].d;
  floorArea = area.toFixed(1);
  wallStyle = plan.wallStyle;
  roofStyle = plan.roof.style;
  roofColor = plan.roof.color;
  wallHeightText = String(plan.wallHeight);
  buildLights();
  refreshSelection();
  rebuildStatic();
  rebuildDynamic();
  try { localStorage.setItem("housebuilder:autosave", snapshot()); } catch (err) {}
}

// ---------------------------------------------------------------------------
// Scene building: static geometry from the plan
// ---------------------------------------------------------------------------
function wallBox(id, w, a, b, y0, y1, color, style) {
  // A box covering the wall between `a` and `b` metres from its start,
  // from height y0 to y1.
  let head = wallHeading(w);
  let ux = Math.sin(head), uz = Math.cos(head);
  let m = (a + b) / 2;
  let o = {
    id: id,
    type: "box",
    position: { x: w.x1 + ux * m, y: (y0 + y1) / 2, z: w.z1 + uz * m },
    rotation: { x: 0, y: head, z: 0 },
    width: WALL_T,
    height: y1 - y0,
    depth: b - a,
    color: color,
    castShadow: true,
    receiveShadow: true,
    roughness: 0.9
  };
  if (style.texture) { o.texture = style.texture; o.textureRepeat = { x: Math.max(1, Math.round((b - a) * 1.5)), y: Math.max(1, Math.round((y1 - y0) * 1.5)) }; }
  return o;
}

function buildWall(list, w) {
  let style = WALL_STYLES[plan.wallStyle] || WALL_STYLES.plaster;
  let color = style.color;
  let H = plan.wallHeight;
  let L = wallLen(w);
  let ops = openingsOn(w.id);
  let cursor = -WALL_T / 2;
  let pfx = "wall-" + w.id + "-";
  let k = 0;
  for (let i = 0; i < ops.length; i = i + 1) {
    let o = ops[i];
    let a = Math.max(cursor, o.pos - o.w / 2);
    let b = Math.min(L + WALL_T / 2, o.pos + o.w / 2);
    if (a > cursor + 0.01) { list.push(wallBox(pfx + "s" + k, w, cursor, a, 0, H, color, style)); k = k + 1; }
    if (o.kind === "door") {
      list.push(wallBox(pfx + "l" + k, w, a, b, DOOR_H, H, color, style));
      buildDoor(list, w, o, a, b);
    } else {
      list.push(wallBox(pfx + "l" + k, w, a, b, WIN_SILL + WIN_H, H, color, style));
      list.push(wallBox(pfx + "b" + k, w, a, b, 0, WIN_SILL, color, style));
      buildWindow(list, w, o, a, b);
    }
    k = k + 1;
    cursor = b;
  }
  if (cursor < L + WALL_T / 2 - 0.01) list.push(wallBox(pfx + "s" + k, w, cursor, L + WALL_T / 2, 0, H, color, style));
  // A capping strip along the top so plan view reads the wall as one line.
  let head = wallHeading(w);
  list.push({
    id: pfx + "cap",
    type: "box",
    position: { x: (w.x1 + w.x2) / 2, y: H + 0.01, z: (w.z1 + w.z2) / 2 },
    rotation: { x: 0, y: head, z: 0 },
    width: WALL_T + 0.02, height: 0.02, depth: L + WALL_T + 0.02,
    color: "#3f3f46"
  });
}

function buildDoor(list, w, o, a, b) {
  let head = wallHeading(w);
  let ux = Math.sin(head), uz = Math.cos(head);
  let m = (a + b) / 2;
  let cx = w.x1 + ux * m, cz = w.z1 + uz * m;
  let pfx = "opening-" + o.id + "-";
  let sel = selected && selected.kind === "opening" && selected.id === o.id;
  // Frame: two jambs and a head.
  let jambW = 0.06;
  list.push({ id: pfx + "j1", type: "box", position: { x: w.x1 + ux * (a + jambW / 2), y: DOOR_H / 2, z: w.z1 + uz * (a + jambW / 2) }, rotation: { x: 0, y: head, z: 0 }, width: WALL_T + 0.04, height: DOOR_H, depth: jambW, color: "#f5f5f4" });
  list.push({ id: pfx + "j2", type: "box", position: { x: w.x1 + ux * (b - jambW / 2), y: DOOR_H / 2, z: w.z1 + uz * (b - jambW / 2) }, rotation: { x: 0, y: head, z: 0 }, width: WALL_T + 0.04, height: DOOR_H, depth: jambW, color: "#f5f5f4" });
  list.push({ id: pfx + "j3", type: "box", position: { x: cx, y: DOOR_H - 0.03, z: cz }, rotation: { x: 0, y: head, z: 0 }, width: WALL_T + 0.04, height: 0.06, depth: b - a, color: "#f5f5f4" });
  // The leaf, hung on the first jamb and standing a little open.
  let leafW = (b - a) - jambW * 2;
  let open = 0.55;
  let hingeX = w.x1 + ux * (a + jambW), hingeZ = w.z1 + uz * (a + jambW);
  let lh = head + open;
  let lx = Math.sin(lh), lz = Math.cos(lh);
  list.push({
    id: pfx + "leaf", type: "box",
    position: { x: hingeX + lx * leafW / 2, y: (DOOR_H - 0.06) / 2, z: hingeZ + lz * leafW / 2 },
    rotation: { x: 0, y: lh, z: 0 },
    width: 0.045, height: DOOR_H - 0.06, depth: leafW,
    color: sel ? "#fbbf24" : (o.color || "#7c4a24"), texture: "wood", castShadow: true
  });
  list.push({ id: pfx + "knob", type: "sphere", position: { x: hingeX + lx * (leafW - 0.1) + Math.sin(lh + Math.PI / 2) * 0.04, y: 1.0, z: hingeZ + lz * (leafW - 0.1) + Math.cos(lh + Math.PI / 2) * 0.04 }, radius: 0.03, color: "#d4a017", metalness: 0.9, roughness: 0.2 });
}

function buildWindow(list, w, o, a, b) {
  let head = wallHeading(w);
  let ux = Math.sin(head), uz = Math.cos(head);
  let m = (a + b) / 2;
  let cx = w.x1 + ux * m, cz = w.z1 + uz * m;
  let pfx = "opening-" + o.id + "-";
  let sel = selected && selected.kind === "opening" && selected.id === o.id;
  let fw = 0.06;
  let yc = WIN_SILL + WIN_H / 2;
  let fc = sel ? "#fbbf24" : "#f5f5f4";
  list.push({ id: pfx + "f1", type: "box", position: { x: w.x1 + ux * (a + fw / 2), y: yc, z: w.z1 + uz * (a + fw / 2) }, rotation: { x: 0, y: head, z: 0 }, width: WALL_T + 0.04, height: WIN_H, depth: fw, color: fc });
  list.push({ id: pfx + "f2", type: "box", position: { x: w.x1 + ux * (b - fw / 2), y: yc, z: w.z1 + uz * (b - fw / 2) }, rotation: { x: 0, y: head, z: 0 }, width: WALL_T + 0.04, height: WIN_H, depth: fw, color: fc });
  list.push({ id: pfx + "f3", type: "box", position: { x: cx, y: WIN_SILL + WIN_H - fw / 2, z: cz }, rotation: { x: 0, y: head, z: 0 }, width: WALL_T + 0.04, height: fw, depth: b - a, color: fc });
  list.push({ id: pfx + "f4", type: "box", position: { x: cx, y: WIN_SILL + fw / 2, z: cz }, rotation: { x: 0, y: head, z: 0 }, width: WALL_T + 0.06, height: fw, depth: b - a + 0.04, color: fc });
  list.push({ id: pfx + "mull", type: "box", position: { x: cx, y: yc, z: cz }, rotation: { x: 0, y: head, z: 0 }, width: WALL_T + 0.03, height: WIN_H, depth: 0.04, color: fc });
  list.push({ id: pfx + "glass", type: "box", position: { x: cx, y: yc, z: cz }, rotation: { x: 0, y: head, z: 0 }, width: 0.02, height: WIN_H - fw * 2, depth: (b - a) - fw * 2, color: "#bfdbfe", opacity: 0.4, metalness: 0.2, roughness: 0.05 });
}

function buildRoom(list, r) {
  let f = FLOORS[r.floor] || FLOORS.wood;
  let sel = selected && selected.kind === "room" && selected.id === r.id;
  list.push({
    id: "room-" + r.id,
    type: "box",
    position: { x: r.x + r.w / 2, y: 0.03, z: r.z + r.d / 2 },
    width: r.w, height: 0.06, depth: r.d,
    color: sel ? "#fde68a" : f.color,
    texture: f.texture,
    textureRepeat: { x: Math.max(1, Math.round(r.w * f.repeat / 2)), y: Math.max(1, Math.round(r.d * f.repeat / 2)) },
    receiveShadow: true,
    roughness: 0.85
  });
}

function buildItem(list, it, ghost) {
  let def = CATALOGUE[it.kind];
  if (!def) return;
  let sel = !ghost && selected && selected.kind === "item" && selected.id === it.id;
  let pfx = "item-" + it.id + "-";
  let children = def.build(pfx, it.color || def.accent);
  if (ghost) {
    for (let i = 0; i < children.length; i = i + 1) { children[i].opacity = 0.45; children[i].castShadow = false; }
  }
  let grp = {
    id: ghost ? "ghost" : "item-" + it.id,
    type: "group",
    position: { x: it.x, y: 0.06, z: it.z },
    rotation: { x: 0, y: it.rot, z: 0 },
    interactive: !ghost,
    children: children
  };
  if (!ghost) grp.cursor = "pointer";
  list.push(grp);
  if (sel) {
    list.push({
      id: "item-" + it.id + "-sel",
      type: "box",
      position: { x: it.x, y: 0.09, z: it.z },
      rotation: { x: 0, y: it.rot, z: 0 },
      width: def.w + 0.16, height: 0.02, depth: def.d + 0.16,
      color: "#fbbf24", emissive: "#f59e0b", emissiveIntensity: 1.2, opacity: 0.75
    });
  }
}

function planBounds() {
  if (plan.walls.length === 0) return null;
  let minX = 1e9, maxX = -1e9, minZ = 1e9, maxZ = -1e9;
  for (let i = 0; i < plan.walls.length; i = i + 1) {
    let w = plan.walls[i];
    minX = Math.min(minX, w.x1, w.x2); maxX = Math.max(maxX, w.x1, w.x2);
    minZ = Math.min(minZ, w.z1, w.z2); maxZ = Math.max(maxZ, w.z1, w.z2);
  }
  return { minX: minX, maxX: maxX, minZ: minZ, maxZ: maxZ };
}

function buildRoof(list) {
  let b = planBounds();
  if (!b || plan.roof.style === "none") return;
  let over = 0.45;
  let H = plan.wallHeight;
  let sx = (b.maxX - b.minX) + over * 2 + WALL_T;
  let sz = (b.maxZ - b.minZ) + over * 2 + WALL_T;
  let cx = (b.minX + b.maxX) / 2, cz = (b.minZ + b.maxZ) / 2;
  let color = plan.roof.color;
  // Ceiling slab under the roof: closes the top of the rooms in 3D.
  list.push({ id: "roof-ceiling", type: "box", position: { x: cx, y: H + 0.08, z: cz }, width: sx, height: 0.16, depth: sz, color: "#d6d3d1", castShadow: true, receiveShadow: true });
  if (plan.roof.style === "flat") {
    list.push({ id: "roof-flat", type: "box", position: { x: cx, y: H + 0.3, z: cz }, width: sx + 0.1, height: 0.28, depth: sz + 0.1, color: color, texture: "stone", textureRepeat: { x: 6, y: 6 }, castShadow: true });
    return;
  }
  // Gable: a prism whose triangle spans the short side and extrudes along the ridge.
  let ridgeX = plan.roof.style === "gable_x";
  let span = ridgeX ? sz : sx;
  let length = ridgeX ? sx : sz;
  let rh = span * 0.32;
  list.push({
    id: "roof-gable",
    type: "prism",
    position: { x: cx, y: H + 0.16 + rh / 2, z: cz },
    rotation: { x: 0, y: ridgeX ? Math.PI / 2 : 0, z: 0 },
    width: span, height: rh, depth: length,
    color: color,
    texture: "tile", textureRepeat: { x: 8, y: 4 },
    flatShading: true,
    castShadow: true
  });
  // Ridge cap
  list.push({
    id: "roof-ridge", type: "box",
    position: { x: cx, y: H + 0.16 + rh, z: cz },
    rotation: { x: 0, y: 0, z: 0 },
    width: ridgeX ? length + 0.1 : 0.16, height: 0.08, depth: ridgeX ? 0.16 : length + 0.1,
    color: "#3f3f46"
  });
  // Chimney on the ridge, if the house is big enough.
  if (length > 6) {
    list.push({ id: "roof-chimney", type: "box", position: { x: ridgeX ? cx + length * 0.28 : cx, y: H + 0.16 + rh + 0.4, z: ridgeX ? cz : cz + length * 0.28 }, width: 0.6, height: 1.2, depth: 0.6, color: "#7c2d12", texture: "brick", castShadow: true });
  }
}

function rebuildStatic() {
  let list = [];
  // Ground: lawn, with a darker apron beyond the working area.
  list.push({ id: "ground", type: "plane", position: { x: 0, y: 0, z: 0 }, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 140, height: 140, color: "#4f8a3a", texture: "grass", textureRepeat: { x: 40, y: 40 }, roughness: 0.95, receiveShadow: true, interactive: false });
  list.push({ id: "ground-edge", type: "box", position: { x: 0, y: -0.06, z: 0 }, width: WORLD * 2 + 0.4, height: 0.1, depth: WORLD * 2 + 0.4, color: "#2f5a26", receiveShadow: true });
  for (let i = 0; i < plan.rooms.length; i = i + 1) buildRoom(list, plan.rooms[i]);
  for (let i = 0; i < plan.walls.length; i = i + 1) buildWall(list, plan.walls[i]);
  for (let i = 0; i < plan.items.length; i = i + 1) buildItem(list, plan.items[i], false);
  if (showRoof && viewMode !== "plan") buildRoof(list);
  // Selected wall: a glowing strip along the top.
  if (selected && selected.kind === "wall") {
    let w = wallById(selected.id);
    if (w) {
      list.push({ id: "wall-sel", type: "box", position: { x: (w.x1 + w.x2) / 2, y: plan.wallHeight + 0.05, z: (w.z1 + w.z2) / 2 }, rotation: { x: 0, y: wallHeading(w), z: 0 }, width: WALL_T + 0.1, height: 0.04, depth: wallLen(w) + WALL_T + 0.1, color: "#fbbf24", emissive: "#f59e0b", emissiveIntensity: 1.5 });
    }
  }
  staticObjects = list;
}

// Dynamic objects: the tool preview and the hover cue.
function rebuildDynamic() {
  let list = [];
  if (viewMode === "plan" && hoverPt) {
    if (tool === "wall") {
      if (wallStart) {
        let w = { id: 0, x1: wallStart.x, z1: wallStart.z, x2: hoverPt.x, z2: hoverPt.z };
        let L = wallLen(w);
        if (L > 0.01) {
          list.push({ id: "ghost", type: "box", position: { x: (w.x1 + w.x2) / 2, y: plan.wallHeight / 2, z: (w.z1 + w.z2) / 2 }, rotation: { x: 0, y: wallHeading(w), z: 0 }, width: WALL_T, height: plan.wallHeight, depth: L + WALL_T, color: "#60a5fa", opacity: 0.5 });
        }
        list.push({ id: "ghost-a", type: "cylinder", position: { x: wallStart.x, y: 0.05, z: wallStart.z }, radius: 0.18, height: 0.1, color: "#2563eb", emissive: "#3b82f6", emissiveIntensity: 1 });
      }
      list.push({ id: "cursor", type: "cylinder", position: { x: hoverPt.x, y: 0.05, z: hoverPt.z }, radius: 0.16, height: 0.1, color: "#60a5fa", emissive: "#3b82f6", emissiveIntensity: 1 });
    } else if (tool === "room") {
      if (roomStart) {
        let x0 = Math.min(roomStart.x, hoverPt.x), x1 = Math.max(roomStart.x, hoverPt.x);
        let z0 = Math.min(roomStart.z, hoverPt.z), z1 = Math.max(roomStart.z, hoverPt.z);
        if (x1 - x0 > 0.01 && z1 - z0 > 0.01) {
          list.push({ id: "ghost", type: "box", position: { x: (x0 + x1) / 2, y: 0.08, z: (z0 + z1) / 2 }, width: x1 - x0, height: 0.04, depth: z1 - z0, color: "#4ade80", opacity: 0.5 });
        }
      }
      list.push({ id: "cursor", type: "cylinder", position: { x: hoverPt.x, y: 0.05, z: hoverPt.z }, radius: 0.16, height: 0.1, color: "#4ade80", emissive: "#22c55e", emissiveIntensity: 1 });
    } else if ((tool === "door" || tool === "window") && hoverWall) {
      let w = hoverWall.wall;
      let head = wallHeading(w);
      let ux = Math.sin(head), uz = Math.cos(head);
      let ow = tool === "door" ? 0.9 : 1.2;
      let y0 = tool === "door" ? 0 : WIN_SILL;
      let y1 = tool === "door" ? DOOR_H : WIN_SILL + WIN_H;
      list.push({ id: "ghost", type: "box", position: { x: w.x1 + ux * hoverWall.pos, y: (y0 + y1) / 2, z: w.z1 + uz * hoverWall.pos }, rotation: { x: 0, y: head, z: 0 }, width: WALL_T + 0.1, height: y1 - y0, depth: ow, color: tool === "door" ? "#f59e0b" : "#38bdf8", opacity: 0.6 });
    } else if (tool === "item" && CATALOGUE[itemKind]) {
      buildItem(list, { id: 0, kind: itemKind, x: hoverPt.x, z: hoverPt.z, rot: itemRot, color: null }, true);
    }
  }
  objects = list;
}

function buildLights() {
  lights = [
    { id: "sun", type: "directional", color: "#fff4d6", intensity: viewMode === "plan" ? 1.4 : 1.7, position: { x: 18, y: 32, z: 14 }, castShadow: true, shadowCameraSize: 34, shadowMapSize: 2048, shadowBias: -0.0003 },
    { id: "hemi", type: "hemisphere", color: "#dbeafe", groundColor: "#3f6b2a", intensity: viewMode === "plan" ? 0.9 : 0.7 },
    { id: "ambient", type: "ambient", color: "#e5e7eb", intensity: viewMode === "plan" ? 0.55 : 0.35 }
  ];
  // Indoors is under a ceiling slab in 3D and walk views, so each room gets
  // a warm ceiling light; without them the interiors read as dusk.
  if (viewMode !== "plan") {
    let n = Math.min(plan.rooms.length, 10);
    for (let i = 0; i < n; i = i + 1) {
      let r = plan.rooms[i];
      lights.push({ id: "room-light-" + r.id, type: "point", color: "#fff1d6", intensity: 4.5 + Math.min(6, r.w * r.d * 0.15), distance: Math.max(r.w, r.d) * 1.6 + 2, decay: 2, position: { x: r.x + r.w / 2, y: plan.wallHeight - 0.35, z: r.z + r.d / 2 } });
    }
  }
}

// ---------------------------------------------------------------------------
// Cameras
// ---------------------------------------------------------------------------
function applyCamera() {
  if (viewMode === "plan") {
    cameraPos = { x: panX, y: zoomH, z: panZ + 0.01 };
    cameraLookAt = { x: panX, y: 0, z: panZ };
    cameraFov = 45;
    sceneFog = null;
  } else if (viewMode === "3d") {
    let b = planBounds();
    let cx = b ? (b.minX + b.maxX) / 2 : 0, cz = b ? (b.minZ + b.maxZ) / 2 : 0;
    let span = b ? Math.max(b.maxX - b.minX, b.maxZ - b.minZ, 6) : 10;
    cameraPos = { x: cx + span * 1.1, y: span * 0.9 + 4, z: cz + span * 1.3 };
    cameraLookAt = { x: cx, y: 1.0, z: cz };
    cameraFov = 42;
    sceneFog = { color: "#cfe3f5", near: 60, far: 160 };
  } else {
    updateWalkCamera();
    cameraFov = 70;
    sceneFog = { color: "#cfe3f5", near: 40, far: 120 };
  }
}

function updateWalkCamera() {
  let eye = 1.6 + Math.sin(walker.bob) * 0.025;
  cameraPos = { x: walker.x, y: eye, z: walker.z };
  let cp = Math.cos(walker.pitch);
  cameraLookAt = { x: walker.x + Math.sin(walker.yaw) * cp * 5, y: eye + Math.sin(walker.pitch) * 5, z: walker.z + Math.cos(walker.yaw) * cp * 5 };
}

function setView(mode) {
  if (mode === viewMode) return;
  viewMode = mode;
  wallStart = null;
  roomStart = null;
  hoverPt = null;
  hoverWall = null;
  drag = null;
  if (mode === "walk") {
    // Start three metres outside the front door, facing it. The front door
    // is the door on an outer wall nearest the south edge; failing that,
    // the lawn south of the house.
    let b = planBounds();
    let spawn = null;
    if (b) {
      let cx = (b.minX + b.maxX) / 2, cz = (b.minZ + b.maxZ) / 2;
      let best = null;
      for (let i = 0; i < plan.openings.length; i = i + 1) {
        let o = plan.openings[i];
        if (o.kind !== "door") continue;
        let w = wallById(o.wallId);
        if (!w) continue;
        let head = wallHeading(w);
        let dx = w.x1 + Math.sin(head) * o.pos, dz = w.z1 + Math.cos(head) * o.pos;
        // Outward normal: the side of the wall away from the house centre.
        let nx = Math.cos(head), nz = -Math.sin(head);
        if ((dx - cx) * nx + (dz - cz) * nz < 0) { nx = -nx; nz = -nz; }
        let onEdge = Math.abs(dx - b.minX) < 0.3 || Math.abs(dx - b.maxX) < 0.3 || Math.abs(dz - b.minZ) < 0.3 || Math.abs(dz - b.maxZ) < 0.3;
        let score = (onEdge ? 0 : 100) + dz;
        if (!best || score < best.score) best = { score: score, x: dx + nx * 3, z: dz + nz * 3, yaw: Math.atan2(-nx, -nz) };
      }
      spawn = best || { x: cx, z: b.minZ - 4, yaw: 0 };
    } else { spawn = { x: 0, z: -6, yaw: 0 }; }
    walker.x = spawn.x;
    walker.z = spawn.z;
    walker.yaw = spawn.yaw;
    walker.pitch = 0;
    walker.vx = 0; walker.vz = 0;
    window.__scene3dYaw = walker.yaw;
    window.__scene3dPitch = walker.pitch;
    window.__scene3dWantLock = true;
    hint = "Walk with W A S D, look with the mouse. Esc returns to the 3D view.";
  } else if (mode === "3d") {
    hint = "Drag to orbit, scroll to zoom. Click a piece of furniture to inspect it.";
  } else {
    hint = toolHint();
  }
  applyCamera();
  buildLights();
  rebuildStatic();
  rebuildDynamic();
}

// Zoom about a ground point: the point under the cursor stays put, because a
// top-down camera's footprint scales with its height.
function zoomBy(factor, ax, az) {
  let nh = Math.max(ZOOM_MIN, Math.min(ZOOM_MAX, zoomH * factor));
  let k = nh / zoomH;
  panX = clampWorld(ax + (panX - ax) * k);
  panZ = clampWorld(az + (panZ - az) * k);
  zoomH = nh;
  applyCamera();
}
function zoomIn() { zoomBy(0.8, panX, panZ); }
function zoomOut() { zoomBy(1.25, panX, panZ); }
function onWheel(e) {
  if (viewMode !== "plan") return;
  if ((e.targetTag || "") !== "canvas") return;
  let f = (e.deltaY || 0) > 0 ? 1.12 : 1 / 1.12;
  let ax = hoverRaw ? hoverRaw.x : panX;
  let az = hoverRaw ? hoverRaw.z : panZ;
  zoomBy(f, ax, az);
}
function centreOnHouse() {
  let b = planBounds();
  panX = b ? (b.minX + b.maxX) / 2 : 0;
  panZ = b ? (b.minZ + b.maxZ) / 2 : 0;
  applyCamera();
}

// ---------------------------------------------------------------------------
// Tools
// ---------------------------------------------------------------------------
function toolHint() {
  if (tool === "select") return "Click anything to inspect it. Drag furniture, doors and windows to move them; drag empty ground to pan.";
  if (tool === "wall") return wallStart ? "Click to finish the wall. Keep clicking to chain walls; Esc or a double-click on the same point stops." : "Click where the wall starts.";
  if (tool === "room") return roomStart ? "Click the opposite corner of the room." : "Click one corner of a room to lay its floor.";
  if (tool === "door") return "Hover a wall and click to hang a door.";
  if (tool === "window") return "Hover a wall and click to fit a window.";
  if (tool === "item") return "Click to place " + (CATALOGUE[itemKind] ? CATALOGUE[itemKind].label.toLowerCase() : "the item") + ". R rotates it first.";
  if (tool === "erase") return "Click anything to remove it.";
  return "";
}

function setTool(t) {
  tool = t;
  wallStart = null;
  roomStart = null;
  hint = toolHint();
  if (viewMode !== "plan") setView("plan");
  rebuildDynamic();
}

function pickItem(kind) {
  itemKind = kind;
  dialog = "";
  setTool("item");
}

function setRoomFloor(f) {
  roomFloor = f;
  if (selected && selected.kind === "room") {
    let r = roomById(selected.id);
    if (r) { beginEdit(); r.floor = f; planChanged(); }
  }
}

function setWallStyle(s) { beginEdit(); plan.wallStyle = s; planChanged(); }
function setRoofStyle(s) { beginEdit(); plan.roof.style = s; planChanged(); }
function setRoofColor(c) { beginEdit(); plan.roof.color = c; planChanged(); }
function setWallHeight(v) { let h = parseFloat(v); if (!isNaN(h)) { beginEdit(); plan.wallHeight = Math.max(2.2, Math.min(4.0, h)); planChanged(); } }
function toggleRoof() { showRoof = !showRoof; rebuildStatic(); }
function toggleGrid() { showGrid = !showGrid; }
function rotatePreview() {
  itemRot = (itemRot + Math.PI / 2) % (Math.PI * 2);
  if (selected && selected.kind === "item") {
    let it = itemById(selected.id);
    if (it) { beginEdit(); it.rot = (it.rot + Math.PI / 2) % (Math.PI * 2); planChanged(); return; }
  }
  rebuildDynamic();
}

function cancelAction() {
  if (wallStart || roomStart) { wallStart = null; roomStart = null; hint = toolHint(); rebuildDynamic(); return; }
  if (dialog) { dialog = ""; return; }
  if (selected) { selected = null; refreshSelection(); rebuildStatic(); return; }
  if (tool !== "select") setTool("select");
}

// Project any hit back onto the ground plane through the plan camera, so a
// click on a wall top lands on the point beneath it.
function toGround(hit) {
  if (!hit || !hit.point) return null;
  let p = hit.point;
  if (viewMode !== "plan") return { x: p.x, z: p.z };
  let c = cameraPos;
  if (p.y < 0.02) return { x: p.x, z: p.z };
  let k = c.y / (c.y - p.y);
  return { x: c.x + (p.x - c.x) * k, z: c.z + (p.z - c.z) * k };
}

function idParts(hit) {
  let id = hit.rootObjectId || hit.objectId || "";
  let parts = id.split("-");
  if (parts.length < 2) return null;
  return { kind: parts[0], id: parseInt(parts[1]) };
}

// Holding Shift keeps a wall on one axis from its start point.
function lockAxis(x, z) {
  if (!keys.Shift || !wallStart) return { x: x, z: z };
  if (Math.abs(x - wallStart.x) >= Math.abs(z - wallStart.z)) return { x: x, z: wallStart.z };
  return { x: wallStart.x, z: z };
}

function onHover(hit) {
  if (viewMode !== "plan") return;
  let g = toGround(hit);
  if (!g) return;
  hoverRaw = { x: g.x, z: g.z };
  let grid = tool === "item" ? ITEM_GRID : GRID;
  let x = clampWorld(snap(g.x, grid)), z = clampWorld(snap(g.z, grid));
  if (tool === "wall") { let l = lockAxis(x, z); x = l.x; z = l.z; }
  let changed = !hoverPt || hoverPt.x !== x || hoverPt.z !== z;
  if (changed) {
    hoverPt = { x: x, z: z };
    coordText = x.toFixed(2) + ", " + z.toFixed(2) + " m";
    if (tool === "wall" && wallStart) statusText = "Wall length " + Math.hypot(x - wallStart.x, z - wallStart.z).toFixed(2) + " m";
    else if (tool === "room" && roomStart) statusText = "Room " + Math.abs(x - roomStart.x).toFixed(1) + " × " + Math.abs(z - roomStart.z).toFixed(1) + " m, " + (Math.abs(x - roomStart.x) * Math.abs(z - roomStart.z)).toFixed(1) + " m²";
  }
  if (tool === "door" || tool === "window") {
    let nw = nearestWall(g.x, g.z, 0.6);
    let ow = tool === "door" ? 0.9 : 1.2;
    if (nw) {
      let L = wallLen(nw.wall);
      let pos = snap(nw.pr.pos, 0.1);
      pos = Math.max(ow / 2 + 0.05, Math.min(L - ow / 2 - 0.05, pos));
      if (L >= ow + 0.1 && (!hoverWall || hoverWall.wall !== nw.wall || hoverWall.pos !== pos)) { hoverWall = { wall: nw.wall, pos: pos }; changed = true; }
      if (L < ow + 0.1) { hoverWall = null; }
    } else if (hoverWall) { hoverWall = null; changed = true; }
  }
  if (changed) rebuildDynamic();
}

function onPointerDown(hit) {
  if (viewMode !== "plan") return;
  let p = idParts(hit);
  let g = toGround(hit);
  if (!g) return;
  let onThing = p && (p.kind === "item" || p.kind === "wall" || p.kind === "room" || p.kind === "opening");
  // Middle or right button, or a left drag on nothing in particular with the
  // select tool, pans the plan.
  if (hit.button === 1 || hit.button === 2 || (hit.button === 0 && tool === "select" && (!onThing || p.kind === "room"))) {
    panDrag = { ax: g.x, az: g.z };
    return;
  }
  if (tool !== "select" || hit.button !== 0) return;
  if (p.kind === "item") {
    let it = itemById(p.id);
    if (it) {
      selected = { kind: "item", id: it.id };
      drag = { kind: "item", id: it.id, dx: it.x - g.x, dz: it.z - g.z, moved: false, before: snapshot() };
      refreshSelection();
      rebuildStatic();
    }
  } else if (p.kind === "opening") {
    let o = openingById(p.id);
    if (o) {
      selected = { kind: "opening", id: o.id };
      drag = { kind: "opening", id: o.id, moved: false, before: snapshot() };
      refreshSelection();
      rebuildStatic();
    }
  }
}

function onPointerMove(hit) {
  let g = toGround(hit);
  if (!g) return;
  if (panDrag) {
    // Shift the view so the point grabbed stays under the pointer. The
    // camera moves with the pan, so each move event corrects the residual.
    panX = clampWorld(panX + (panDrag.ax - g.x));
    panZ = clampWorld(panZ + (panDrag.az - g.z));
    applyCamera();
    return;
  }
  if (!drag) return;
  if (drag.kind === "item") {
    let it = itemById(drag.id);
    if (!it) return;
    let nx = clampWorld(snap(g.x + drag.dx, ITEM_GRID)), nz = clampWorld(snap(g.z + drag.dz, ITEM_GRID));
    if (nx !== it.x || nz !== it.z) {
      it.x = nx; it.z = nz;
      drag.moved = true;
      rebuildStatic();
      refreshSelection();
    }
  } else if (drag.kind === "opening") {
    let o = openingById(drag.id);
    let w = o ? wallById(o.wallId) : null;
    if (!o || !w) return;
    let L = wallLen(w);
    let pr = wallProject(w, g.x, g.z);
    let pos = Math.max(o.w / 2 + 0.05, Math.min(L - o.w / 2 - 0.05, snap(pr.pos, 0.1)));
    if (pos === o.pos) return;
    let ops = openingsOn(w.id);
    for (let i = 0; i < ops.length; i = i + 1) {
      if (ops[i].id !== o.id && Math.abs(ops[i].pos - pos) < (ops[i].w + o.w) / 2 + 0.05) return;
    }
    o.pos = pos;
    drag.moved = true;
    rebuildStatic();
  }
}

function onPointerUp(hit) {
  if (panDrag) { panDrag = null; return; }
  if (!drag) return;
  if (drag.moved) {
    history.push(drag.before);
    if (history.length > 60) history.shift();
    future = [];
    planChanged();
  }
  drag = null;
}

function onSceneClick(hit) {
  if (viewMode === "walk") return;
  if (drag && drag.moved) return;
  if (viewMode === "3d") {
    let p = idParts(hit);
    if (p && (p.kind === "item" || p.kind === "wall" || p.kind === "room" || p.kind === "opening")) {
      selected = { kind: p.kind, id: p.id };
    } else { selected = null; }
    refreshSelection();
    rebuildStatic();
    return;
  }
  let g = toGround(hit);
  if (!g) return;
  let grid = tool === "item" ? ITEM_GRID : GRID;
  let x = clampWorld(snap(g.x, grid)), z = clampWorld(snap(g.z, grid));

  if (tool === "wall") {
    if (!wallStart) { wallStart = { x: x, z: z }; hint = toolHint(); rebuildDynamic(); return; }
    let l = lockAxis(x, z); x = l.x; z = l.z;
    if (Math.hypot(x - wallStart.x, z - wallStart.z) < 0.25) { wallStart = null; hint = toolHint(); rebuildDynamic(); return; }
    beginEdit();
    plan.walls.push({ id: nextId, x1: wallStart.x, z1: wallStart.z, x2: x, z2: z });
    nextId = nextId + 1;
    wallStart = { x: x, z: z };
    planChanged();
    hint = toolHint();
    return;
  }
  if (tool === "room") {
    if (!roomStart) { roomStart = { x: x, z: z }; hint = toolHint(); rebuildDynamic(); return; }
    let x0 = Math.min(roomStart.x, x), x1 = Math.max(roomStart.x, x);
    let z0 = Math.min(roomStart.z, z), z1 = Math.max(roomStart.z, z);
    roomStart = null;
    if (x1 - x0 < 0.5 || z1 - z0 < 0.5) { hint = toolHint(); rebuildDynamic(); return; }
    beginEdit();
    plan.rooms.push({ id: nextId, x: x0, z: z0, w: x1 - x0, d: z1 - z0, floor: roomFloor, name: "Room " + (plan.rooms.length + 1) });
    selected = { kind: "room", id: nextId };
    nextId = nextId + 1;
    planChanged();
    hint = toolHint();
    return;
  }
  if (tool === "door" || tool === "window") {
    if (!hoverWall) return;
    let ow = tool === "door" ? 0.9 : 1.2;
    // Refuse to overlap an existing opening.
    let ops = openingsOn(hoverWall.wall.id);
    for (let i = 0; i < ops.length; i = i + 1) {
      if (Math.abs(ops[i].pos - hoverWall.pos) < (ops[i].w + ow) / 2 + 0.05) { statusText = "That spot already has an opening."; return; }
    }
    beginEdit();
    plan.openings.push({ id: nextId, wallId: hoverWall.wall.id, pos: hoverWall.pos, w: ow, kind: tool });
    selected = { kind: "opening", id: nextId };
    nextId = nextId + 1;
    planChanged();
    return;
  }
  if (tool === "item") {
    if (!CATALOGUE[itemKind]) return;
    beginEdit();
    plan.items.push({ id: nextId, kind: itemKind, x: x, z: z, rot: itemRot, color: null });
    selected = { kind: "item", id: nextId };
    nextId = nextId + 1;
    planChanged();
    return;
  }
  if (tool === "erase") {
    let p = idParts(hit);
    if (p && p.kind !== "ground") { removeElement(p.kind, p.id); }
    return;
  }
  // select
  let p = idParts(hit);
  if (p && (p.kind === "item" || p.kind === "wall" || p.kind === "room" || p.kind === "opening")) {
    selected = { kind: p.kind, id: p.id };
  } else {
    selected = null;
  }
  refreshSelection();
  rebuildStatic();
}

function removeElement(kind, id) {
  beginEdit();
  if (kind === "wall") {
    plan.walls = plan.walls.filter(function (w) { return w.id !== id; });
    plan.openings = plan.openings.filter(function (o) { return o.wallId !== id; });
  } else if (kind === "room") {
    plan.rooms = plan.rooms.filter(function (r) { return r.id !== id; });
  } else if (kind === "opening") {
    plan.openings = plan.openings.filter(function (o) { return o.id !== id; });
  } else if (kind === "item") {
    plan.items = plan.items.filter(function (it) { return it.id !== id; });
  }
  if (selected && selected.kind === kind && selected.id === id) selected = null;
  planChanged();
}

function deleteSelected() {
  if (!selected) return;
  removeElement(selected.kind, selected.id);
}

// ---------------------------------------------------------------------------
// Inspector
// ---------------------------------------------------------------------------
function refreshSelection() {
  selKind = "";
  selInfo = null;
  if (!selected) return;
  if (selected.kind === "wall") {
    let w = wallById(selected.id);
    if (!w) { selected = null; return; }
    selKind = "wall";
    selInfo = { title: "Wall", length: wallLen(w).toFixed(2), openings: openingsOn(w.id).length, from: w.x1 + ", " + w.z1, to: w.x2 + ", " + w.z2 };
  } else if (selected.kind === "room") {
    let r = roomById(selected.id);
    if (!r) { selected = null; return; }
    selKind = "room";
    selInfo = { title: r.name, name: r.name, size: r.w.toFixed(1) + " × " + r.d.toFixed(1) + " m", area: (r.w * r.d).toFixed(1), floor: r.floor };
  } else if (selected.kind === "opening") {
    let o = openingById(selected.id);
    if (!o) { selected = null; return; }
    selKind = "opening";
    selInfo = { title: o.kind === "door" ? "Door" : "Window", kind: o.kind, width: o.w, widthText: o.w.toFixed(1) };
  } else if (selected.kind === "item") {
    let it = itemById(selected.id);
    if (!it) { selected = null; return; }
    let def = CATALOGUE[it.kind];
    selKind = "item";
    selInfo = { title: def ? def.label : it.kind, icon: def ? def.icon : "", pos: it.x.toFixed(2) + ", " + it.z.toFixed(2), rot: Math.round((it.rot * 180) / Math.PI) % 360, color: it.color || (def ? def.accent : "#ffffff"), footprint: def ? def.w + " × " + def.d + " m" : "" };
  }
}

function setRoomName(v) {
  if (selected && selected.kind === "room") {
    let r = roomById(selected.id);
    if (r) { r.name = v; refreshSelection(); }
  }
}

function setOpeningWidth(v) {
  let w = parseFloat(v);
  if (isNaN(w) || !selected || selected.kind !== "opening") return;
  let o = openingById(selected.id);
  if (!o) return;
  beginEdit();
  o.w = Math.max(0.6, Math.min(2.4, w));
  planChanged();
}

function setItemColor(c) {
  if (!selected || selected.kind !== "item") return;
  let it = itemById(selected.id);
  if (!it) return;
  beginEdit();
  it.color = c;
  planChanged();
}

function nudgeSelected(dx, dz) {
  if (!selected || selected.kind !== "item") return;
  let it = itemById(selected.id);
  if (!it) return;
  beginEdit();
  it.x = clampWorld(it.x + dx);
  it.z = clampWorld(it.z + dz);
  planChanged();
}

function duplicateSelected() {
  if (!selected || selected.kind !== "item") return;
  let it = itemById(selected.id);
  if (!it) return;
  let def = CATALOGUE[it.kind];
  beginEdit();
  let nx = clampWorld(snap(it.x + (def ? def.w : 1) + 0.25, ITEM_GRID));
  plan.items.push({ id: nextId, kind: it.kind, x: nx, z: it.z, rot: it.rot, color: it.color });
  selected = { kind: "item", id: nextId };
  nextId = nextId + 1;
  planChanged();
}

// ---------------------------------------------------------------------------
// Files: save slots in the browser, JSON in and out
// ---------------------------------------------------------------------------
function refreshSlots() {
  let out = [];
  for (let i = 1; i <= 3; i = i + 1) {
    let raw = null;
    try { raw = localStorage.getItem("housebuilder:slot" + i); } catch (err) {}
    let label = "Empty";
    if (raw) {
      try { let p = JSON.parse(raw); label = p.walls.length + " walls · " + p.rooms.length + " rooms · " + p.items.length + " items"; } catch (err) { label = "Saved"; }
    }
    out.push({ n: i, label: label, used: !!raw });
  }
  saveSlots = out;
}

function saveSlot(n) {
  try { localStorage.setItem("housebuilder:slot" + n, snapshot()); statusText = "Saved to slot " + n + "."; } catch (err) { statusText = "Could not save."; }
  refreshSlots();
}

function loadSlot(n) {
  let raw = null;
  try { raw = localStorage.getItem("housebuilder:slot" + n); } catch (err) {}
  if (!raw) { statusText = "Slot " + n + " is empty."; return; }
  loadPlanText(raw);
  statusText = "Loaded slot " + n + ".";
}

function loadPlanText(text) {
  let p = null;
  try { p = JSON.parse(text); } catch (err) { statusText = "That is not valid plan JSON."; return false; }
  if (!p || !p.walls || !p.rooms || !p.items) { statusText = "That JSON is not a house plan."; return false; }
  beginEdit();
  plan = newPlan();
  plan.walls = p.walls; plan.rooms = p.rooms; plan.items = p.items; plan.openings = p.openings || [];
  if (p.roof) plan.roof = p.roof;
  if (p.wallStyle) plan.wallStyle = p.wallStyle;
  if (p.wallHeight) plan.wallHeight = p.wallHeight;
  let maxId = 0;
  let all = plan.walls.concat(plan.rooms, plan.items, plan.openings);
  for (let i = 0; i < all.length; i = i + 1) { if (all[i].id > maxId) maxId = all[i].id; }
  nextId = maxId + 1;
  selected = null;
  sampleKey = "";
  planChanged();
  centreOnHouse();
  return true;
}

function openExport() {
  exportJson = JSON.stringify(plan, null, 2);
  // Export the full house: in plan view the roof is hidden, so build the
  // scene once with it on and put the plan-view scene back afterwards.
  let savedMode = viewMode;
  viewMode = "3d";
  let savedRoof = showRoof;
  showRoof = true;
  rebuildStatic();
  let r = buildObjExport();
  viewMode = savedMode;
  showRoof = savedRoof;
  rebuildStatic();
  exportObj = r.obj;
  exportMtl = r.mtl;
  setExportTab(exportTab);
  dialog = "export";
}
function openImport() { importText = ""; dialog = "import"; }
function openCatalogue() { dialog = "catalogue"; }
function closeDialog() { dialog = ""; }
function setImportText(v) { importText = v; }
function doImport() { if (loadPlanText(importText)) { dialog = ""; statusText = "Plan imported."; } }
function importFromFile() {
  softn.files.pickFile({ accept: ".json,application/json" }, function (files) {
    if (!files || files.length === 0) return;
    softn.files.readText(files[0].ref, function (content) {
      if (loadPlanText(content)) { dialog = ""; statusText = "Plan imported from " + (files[0].name || "file") + "."; }
    });
  });
}

function newHouse() {
  beginEdit();
  sampleKey = "";
  plan = newPlan();
  selected = null;
  planChanged();
  statusText = "Blank block. Draw exterior walls first, then rooms.";
}

// ---------------------------------------------------------------------------
// Sample houses. Each builder gets W (wall), O (opening on a wall at a
// distance along it), R (room rectangle with floor and name) and I (item).
// Wall directions matter for openings: `pos` is measured from the wall's
// first point, and the front door of every sample is on the south side, z = 0.
