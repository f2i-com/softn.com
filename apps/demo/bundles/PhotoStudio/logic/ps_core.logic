// ps_core.logic - shared helpers for Photo Studio (Softn sandbox edition).
//
// Everything in this bundle runs inside ZIPP. Identifiers prefixed PS_ / ps
// never appear in the template, so the runtime leaves them VM-owned and never
// copies them to React. Only the small UI-facing state in main.logic syncs.
//
// Two engine facts shape the code below:
//   1. A single script call may spend ~50M bytecode steps before the engine is
//      disposed. Heavy pixel work is therefore sliced into jobs (psEnqueue)
//      that a <Loop> pumps one step at a time.
//   2. Reading a typed array through a global is ~15x slower than through a
//      local. Kernels alias their buffers into locals before looping.

let PS_MAX_SIDE = 4096;
let PS_MAX_PIXELS = 3000000;          // 3 megapixels, e.g. 2048 x 1464. A frame crosses to the host as one base64 string, capped at 16 MiB.
let PS_MAX_LAYERS = 32;
let PS_MAX_LIVE_BYTES = 160 * 1024 * 1024;
let PS_MAX_HISTORY_BYTES = 64 * 1024 * 1024;
let PS_MAX_FILE_BYTES = 48 * 1024 * 1024;
// Slice sizes, each measured on the shipping engine at roughly a third of the
// largest size that still fits one call (tests/budget-jobs.mjs).
let PS_STEP_PIXELS = 200000;          // light per-pixel loops (~20 ops per pixel)
let PS_STEP_HEAVY_PIXELS = 120000;    // heavy per-pixel loops (blend modes, resampling, blur passes)
let PS_STEP_BYTES = 250000;           // inflate output, LZW output, RLE rows
let PS_STEP_FILTER_BYTES = 160000;    // PNG row filtering tries four filters per byte
let PS_STEP_DEFLATE_BYTES = 131072;   // deflate input per step

function psMegapixelText() { return String(Math.round(PS_MAX_PIXELS / 100000) / 10); }
function psClamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }
function psByte(v) { v = Math.round(v); return v < 0 ? 0 : v > 255 ? 255 : v; }
function psFail(message) { throw new Error(message); }

function psCheckDims(w, h, allowEmpty) {
  if (!Number.isInteger(w) || !Number.isInteger(h) || w < (allowEmpty ? 0 : 1) || h < (allowEmpty ? 0 : 1) ||
      w > PS_MAX_SIDE || h > PS_MAX_SIDE || w * h > PS_MAX_PIXELS) {
    psFail("Image dimensions must be 1-" + PS_MAX_SIDE + " pixels per side and at most " + psMegapixelText() + " megapixels in this edition.");
  }
  return w * h;
}

function psHexToRgb(hex) {
  let s = String(hex || "").trim();
  if (s.charCodeAt(0) === 35) s = s.slice(1);
  if (s.length === 3) s = s[0] + s[0] + s[1] + s[1] + s[2] + s[2];
  if (s.length !== 6) return [0, 0, 0];
  let v = parseInt(s, 16);
  if (Number.isNaN(v)) return [0, 0, 0];
  return [(v >> 16) & 255, (v >> 8) & 255, v & 255];
}
function psRgbToHex(r, g, b) {
  return "#" + (((1 << 24) | (psByte(r) << 16) | (psByte(g) << 8) | psByte(b)).toString(16).slice(1));
}
function psIsHex(s) { return /^#[0-9a-fA-F]{6}$/.test(String(s || "")); }

// ---------------------------------------------------------------------------
// Job system. A job is { label, step, done, fail }. step() returns true when
// finished or a progress fraction 0..1. pumpJobs() runs one step per <Loop>
// tick; every tick is a fresh re-entry with a fresh instruction budget.
// ---------------------------------------------------------------------------
let PS_JOBS = [];
let jobActive = false;
let jobLabel = "";
let jobPercent = 0;

function psEnqueue(label, step, done, fail) {
  PS_JOBS.push({ label: label, step: step, done: done || null, fail: fail || null });
  jobActive = true;
  jobLabel = PS_JOBS[0].label;
}
function psJobsPending() { return PS_JOBS.length; }
function psCancelJobs() { PS_JOBS = []; jobActive = false; jobPercent = 0; jobLabel = ""; }

function pumpJobs() {
  let job = PS_JOBS[0];
  if (!job) { jobActive = false; jobPercent = 0; return; }
  let result = null;
  try {
    result = job.step();
  } catch (error) {
    PS_JOBS.shift();
    jobPercent = 0;
    if (job.fail) { try { job.fail(error); } catch (e2) { psReportError(e2); } }
    else psReportError(error);
    if (!PS_JOBS.length) { jobActive = false; jobLabel = ""; } else jobLabel = PS_JOBS[0].label;
    psAfterJobStep();
    return;
  }
  if (result === true) {
    PS_JOBS.shift();
    jobPercent = 0;
    if (job.done) { try { job.done(); } catch (error) { psReportError(error); } }
  } else if (typeof result === "number") {
    jobPercent = Math.round(psClamp(result, 0, 1) * 100);
  }
  if (!PS_JOBS.length) { jobActive = false; jobLabel = ""; jobPercent = 0; } else jobLabel = PS_JOBS[0].label;
  psAfterJobStep();
}

// Run every queued job to completion synchronously. Only for tests and for
// tiny documents where slicing is pointless; never call it from a UI handler
// with a large job queued.
function psRunJobsNow(maxSteps) {
  let n = 0;
  while (PS_JOBS.length && n < (maxSteps || 100000)) { pumpJobs(); n++; }
  return PS_JOBS.length === 0;
}

// Row-sliced step: fn(y0, y1) is called with bounded row ranges.
function psRowStepper(height, rowsPerStep, fn) {
  let y = 0;
  let rows = Math.max(1, Math.floor(rowsPerStep));
  return function () {
    if (y >= height) return true;
    let y1 = Math.min(height, y + rows);
    fn(y, y1);
    y = y1;
    return y >= height ? true : y / height;
  };
}
function psRowsFor(width, pixelsPerStep) { return Math.max(1, Math.floor((pixelsPerStep || PS_STEP_PIXELS) / Math.max(1, width))); }

// Run a sequence of step functions (each following the step contract) as one job.
function psSequence(steps) {
  let index = 0;
  return function () {
    while (index < steps.length) {
      let r = steps[index]();
      if (r === true) { index++; continue; }
      return (index + (typeof r === "number" ? r : 0)) / steps.length;
    }
    return true;
  };
}

// ---------------------------------------------------------------------------
// Bytes
// ---------------------------------------------------------------------------
function psFromBase64(s) {
  s = String(s || "");
  let comma = s.indexOf("base64,");
  if (comma >= 0) s = s.slice(comma + 7);
  return Uint8Array.fromBase64(s);
}
function psU16BE(b, p) { return (b[p] << 8) | b[p + 1]; }
function psI16BE(b, p) { let v = (b[p] << 8) | b[p + 1]; return v > 32767 ? v - 65536 : v; }
function psU32BE(b, p) { return ((b[p] << 24) | (b[p + 1] << 16) | (b[p + 2] << 8) | b[p + 3]) >>> 0; }
function psI32BE(b, p) { return (b[p] << 24) | (b[p + 1] << 16) | (b[p + 2] << 8) | b[p + 3]; }
function psU16LE(b, p) { return b[p] | (b[p + 1] << 8); }
function psU32LE(b, p) { return (b[p] | (b[p + 1] << 8) | (b[p + 2] << 16) | (b[p + 3] << 24)) >>> 0; }
function psI32LE(b, p) { return b[p] | (b[p + 1] << 8) | (b[p + 2] << 16) | (b[p + 3] << 24); }
function psLatin1(b, start, end) {
  let s = "";
  for (let i = start; i < end; i++) s += String.fromCharCode(b[i]);
  return s;
}

// Growable byte writer. Growth copies through set(), which is slow per byte in
// the engine but native (one instruction), so it never threatens the budget.
class PsWriter {
  constructor(capacity) { this.buf = new Uint8Array(capacity || 65536); this.len = 0; }
  ensure(n) {
    if (this.len + n <= this.buf.length) return;
    let cap = this.buf.length * 2;
    while (cap < this.len + n) cap *= 2;
    let nb = new Uint8Array(cap);
    nb.set(this.buf.subarray(0, this.len));
    this.buf = nb;
  }
  u8(v) { this.ensure(1); this.buf[this.len++] = v & 255; return this; }
  u16be(v) { this.ensure(2); this.buf[this.len++] = (v >>> 8) & 255; this.buf[this.len++] = v & 255; return this; }
  i16be(v) { return this.u16be(v < 0 ? v + 65536 : v); }
  u32be(v) { this.ensure(4); let b = this.buf, p = this.len; b[p] = (v >>> 24) & 255; b[p + 1] = (v >>> 16) & 255; b[p + 2] = (v >>> 8) & 255; b[p + 3] = v & 255; this.len += 4; return this; }
  i32be(v) { return this.u32be(v >>> 0); }
  u16le(v) { this.ensure(2); this.buf[this.len++] = v & 255; this.buf[this.len++] = (v >>> 8) & 255; return this; }
  u32le(v) { this.ensure(4); let b = this.buf, p = this.len; b[p] = v & 255; b[p + 1] = (v >>> 8) & 255; b[p + 2] = (v >>> 16) & 255; b[p + 3] = (v >>> 24) & 255; this.len += 4; return this; }
  bytes(arr) { this.ensure(arr.length); this.buf.set(arr, this.len); this.len += arr.length; return this; }
  str(s) { this.ensure(s.length); for (let i = 0; i < s.length; i++) this.buf[this.len++] = s.charCodeAt(i) & 255; return this; }
  zero(n) { this.ensure(n); for (let i = 0; i < n; i++) this.buf[this.len + i] = 0; this.len += n; return this; }
  finish() { return this.buf.slice(0, this.len); }
}

// ---------------------------------------------------------------------------
// Checksums
// ---------------------------------------------------------------------------
let PS_CRC_TABLE = null;
function psCrcTable() {
  if (PS_CRC_TABLE) return PS_CRC_TABLE;
  let t = new Int32Array(256);
  for (let n = 0; n < 256; n++) {
    let c = n;
    for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
    t[n] = c | 0;
  }
  PS_CRC_TABLE = t;
  return t;
}
// Running CRC: pass crc = 0xffffffff initially, finish with (crc ^ 0xffffffff) >>> 0.
function psCrcUpdate(crc, bytes, start, end) {
  let t = psCrcTable();
  let c = crc | 0;
  for (let i = start; i < end; i++) c = t[(c ^ bytes[i]) & 255] ^ (c >>> 8);
  return c;
}
function psCrc32(bytes, start, end) { return (psCrcUpdate(0xffffffff, bytes, start, end) ^ 0xffffffff) >>> 0; }

let PS_UID_COUNTER = 0;
function psUid() { PS_UID_COUNTER++; return "L" + PS_UID_COUNTER + "-" + (Date.now() % 100000); }

// Hooks main.logic overrides. Declared here so codec tests can run without the UI.
let PS_HOOK_ERROR = null;
let PS_HOOK_AFTER_STEP = null;
function psReportError(error) {
  if (PS_HOOK_ERROR) { PS_HOOK_ERROR(error); return; }
  console.log("PhotoStudio error: " + (error && error.message ? error.message : String(error)));
}
function psAfterJobStep() { if (PS_HOOK_AFTER_STEP) PS_HOOK_AFTER_STEP(); }
