// House Builder — draw a floor plan from above, furnish it, and see it as a
// house: walls with doors and windows, room floors, a roof, a garden, and a
// first-person walk through the result.
//
// Units are metres. Walls and rooms snap to a 0.5 m grid, furniture to 0.25 m.
// The plan is a flat set of lists (walls, openings on walls, rooms, items and
// a roof spec), which is what undo snapshots, saves and exports carry.

// ---------------------------------------------------------------------------
// State synced to the UI
// ---------------------------------------------------------------------------
let viewMode = "plan";          // "plan" | "3d" | "walk"
let tool = "select";            // select | wall | room | door | window | item | erase
let itemKind = "sofa";          // catalogue entry used by the item tool
let itemRot = 0;                // rotation for the next placed item (radians)
let roomFloor = "wood";         // floor finish for the next room
let hint = "";
let coordText = "";
let statusText = "";
let selKind = "";               // "" | wall | room | opening | item
let selInfo = null;             // details of the selection for the inspector
let canUndo = false;
let canRedo = false;
let showRoof = true;
let showGrid = true;
let zoomH = 20;                 // plan camera height; the wheel and +/- change it
let exportText = "";
let exportTab = "json";         // json | obj | mtl
let exportJson = "";
let exportObj = "";
let exportMtl = "";
let importText = "";
let sampleKey = "cottage";
let loadingSample = false;
let samples = [];
let dialog = "";                // "" | export | import | catalogue
let saveSlots = [];
let wallCount = 0;
let roomCount = 0;
let itemCount = 0;
let floorArea = "0";
let catalogue = [];
// Mirrors of plan settings for the side panel.
let wallStyle = "plaster";
let roofStyle = "gable_x";
let roofColor = "#7f1d1d";
let wallHeightText = "2.7";

let objects = [];
let staticObjects = [];
let lights = [];
let cameraPos = { x: 5, y: 26, z: 4.01 };
let cameraLookAt = { x: 5, y: 0, z: 4 };
let cameraFov = 45;
let sceneFog = null;

// ---------------------------------------------------------------------------
// VM-owned state
// ---------------------------------------------------------------------------
let plan = newPlan();
let history = [];
let future = [];
let nextId = 1;
let selected = null;            // { kind, id }
let hoverPt = null;             // snapped ground point under the pointer
let hoverRaw = null;            // the same point before snapping
let panDrag = null;             // { ax, az } while dragging the plan view
let hoverWall = null;           // { wall, pos } when the pointer is over a wall
let wallStart = null;           // first click of a wall
let roomStart = null;           // first corner of a room
let drag = null;                // { kind, id, dx, dz } while dragging a selection
let panX = 5.5;
let panZ = 4;
let keys = {};
let walker = { x: 3, z: -3, yaw: 0, pitch: 0, vx: 0, vz: 0, bob: 0 };
let lastLocked = false;
let planDirty = true;

const ZOOM_MIN = 7;
const ZOOM_MAX = 52;
const GRID = 0.5;
const ITEM_GRID = 0.25;
const WALL_T = 0.2;
const DOOR_H = 2.1;
const WIN_SILL = 0.9;
const WIN_H = 1.2;
const WORLD = 24;

// ---------------------------------------------------------------------------
// Catalogue of furniture. Each entry knows its footprint (w across, d along)
// and a builder that returns primitive children in the item's local frame,
// centred on the footprint with y up. `accent` is the colour the user can
// change in the inspector.
// ---------------------------------------------------------------------------
function bx(id, x, y, z, w, h, d, color, extra) {
  let o = { id: id, type: "box", position: { x: x, y: y, z: z }, width: w, height: h, depth: d, color: color, castShadow: true };
  if (extra) { for (let k in extra) { o[k] = extra[k]; } }
  return o;
}
function cy(id, x, y, z, r, h, color, extra) {
  let o = { id: id, type: "cylinder", position: { x: x, y: y, z: z }, radius: r, height: h, color: color, castShadow: true };
  if (extra) { for (let k in extra) { o[k] = extra[k]; } }
  return o;
}
function sp(id, x, y, z, r, color, extra) {
  let o = { id: id, type: "sphere", position: { x: x, y: y, z: z }, radius: r, color: color, castShadow: true };
  if (extra) { for (let k in extra) { o[k] = extra[k]; } }
  return o;
}
function legs(p, w, d, h, r, color) {
  let out = [];
  let hx = w / 2 - r * 1.5, hz = d / 2 - r * 1.5;
  out.push(cy(p + "l1", -hx, h / 2, -hz, r, h, color));
  out.push(cy(p + "l2", hx, h / 2, -hz, r, h, color));
  out.push(cy(p + "l3", -hx, h / 2, hz, r, h, color));
  out.push(cy(p + "l4", hx, h / 2, hz, r, h, color));
  return out;
}

