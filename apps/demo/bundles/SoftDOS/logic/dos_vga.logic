function dosVga_init() {
  // 1. Fill default 256-color VGA Palette
  // First 16 entries = standard CGA/EGA colors
  for (let i = 0; i < 16; i++) {
    DOS_VGA_PAL[i * 3]     = DOS_CGA_16[i * 3];
    DOS_VGA_PAL[i * 3 + 1] = DOS_CGA_16[i * 3 + 1];
    DOS_VGA_PAL[i * 3 + 2] = DOS_CGA_16[i * 3 + 2];
  }

  // Next 16 entries = 16 grayscale steps
  for (let g = 0; g < 16; g++) {
    let gray = Math.floor((g * 255) / 15);
    let idx = (16 + g) * 3;
    DOS_VGA_PAL[idx]     = gray;
    DOS_VGA_PAL[idx + 1] = gray;
    DOS_VGA_PAL[idx + 2] = gray;
  }

  // Next 216 entries = 6x6x6 color cube
  let pIdx = 32;
  for (let r = 0; r < 6; r++) {
    for (let g = 0; g < 6; g++) {
      for (let b = 0; b < 6; b++) {
        let base = pIdx * 3;
        DOS_VGA_PAL[base]     = Math.floor((r * 255) / 5);
        DOS_VGA_PAL[base + 1] = Math.floor((g * 255) / 5);
        DOS_VGA_PAL[base + 2] = Math.floor((b * 255) / 5);
        pIdx++;
      }
    }
  }

  // Remainder = extra blacks / grays
  while (pIdx < 256) {
    let base = pIdx * 3;
    DOS_VGA_PAL[base]     = 0;
    DOS_VGA_PAL[base + 1] = 0;
    DOS_VGA_PAL[base + 2] = 0;
    pIdx++;
  }

  DOS_VGA_PAL_REV++;
}

// Text mode is drawn at 640x400: 80 columns of 8-pixel glyphs across, 25 rows
// of 16 scanlines down, which is the shape a real VGA text screen has. The
// 8x8 glyphs are doubled vertically to fill the cell. Mode 13h keeps its own
// 320x200 buffer; PixelCanvas is told the size of whichever frame it gets.
function dosVga_renderTextMode() {
  let textBase = 0xB8000;
  let dst = DOS_FB_TEXT;
  let blinkOn = ((DOS_VGA_FRAME >> 4) & 1) === 0;

  for (let row = 0; row < 25; row++) {
    for (let col = 0; col < 80; col++) {
      let cellOffset = textBase + ((row * 80 + col) * 2);
      let ch = DOS_RAM[cellOffset];
      let attr = DOS_RAM[cellOffset + 1];

      let fg = attr & 0x0F;
      let bg = (attr >> 4) & 0x07;
      // The top attribute bit blinks the character in DOS text mode.
      if ((attr & 0x80) && !blinkOn) fg = bg;

      let glyphOffset = ch * 8;
      let startX = col * 8;
      let startY = row * 16;

      for (let y = 0; y < 8; y++) {
        let lineBits = DOS_FONT8[glyphOffset + y];
        let rowA = ((startY + y * 2) * 640) + startX;
        let rowB = rowA + 640;
        for (let x = 0; x < 8; x++) {
          let c = (lineBits & (0x80 >> x)) ? fg : bg;
          dst[rowA + x] = c;
          dst[rowB + x] = c;
        }
      }
    }
  }

  // The cursor: a two-scanline bar at the bottom of its cell.
  if (DOS_CURSOR_VISIBLE && blinkOn && DOS_CURSOR_ROW < 25 && DOS_CURSOR_COL < 80) {
    let cx = DOS_CURSOR_COL * 8;
    let cy = (DOS_CURSOR_ROW * 16) + 13;
    for (let y = 0; y < 2; y++) {
      let r = ((cy + y) * 640) + cx;
      for (let x = 0; x < 8; x++) dst[r + x] = 0x0F;
    }
  }
}

// ---------------------------------------------------------------------------
// Unchained ("Mode X") support
// ---------------------------------------------------------------------------
// Mode 13h as the BIOS sets it is "chained": the four VGA planes are wired so
// that consecutive addresses land on consecutive planes, and 320x200 looks
// like one flat 64000-byte buffer. A game that wants page flipping turns that
// chaining off (Sequencer register 4, bit 3) and addresses the planes itself:
// pixel x lives in plane x & 3 at offset x >> 2. DOOM does exactly this, and
// keeps three pages at plane offsets 0, 0x4000 and 0x8000, switching between
// them with the CRTC start address. Without this the emulator showed all three
// pages tiled across the screen at a quarter of the width.
//
// The chained case keeps using DOS_RAM at 0xA0000 directly, which is fast and
// is what every 16-bit demo here relies on; only the unchained case pays for
// the plane arithmetic.
let DOS_VGA_UNCHAINED = 0;
let DOS_VGA_VRAM = null;            // 4 planes of 64 KB
let DOS_VGA_MAP_MASK = 0x0F;        // Sequencer 2: which planes a write reaches
let DOS_VGA_READ_PLANE = 0;         // Graphics controller 4: which plane a read sees
let DOS_VGA_START = 0;              // CRTC 0Ch/0Dh: first displayed address
let DOS_VGA_ROW_BYTES = 80;         // CRTC 13h (in words) x 2: plane bytes per row
let DOS_VGA_SEQ_INDEX = 0;
let DOS_VGA_GC_INDEX = 0;
let DOS_VGA_CRTC_INDEX = 0;

function dosVga_planarInit() {
  if (DOS_VGA_VRAM === null) DOS_VGA_VRAM = new Uint8Array(4 * 65536);
}

function dosVga_planarReset() {
  dosVga_planarInit();
  DOS_VGA_VRAM.fill(0);
  DOS_VGA_UNCHAINED = 0;
  DOS_VGA_MAP_MASK = 0x0F;
  DOS_VGA_READ_PLANE = 0;
  DOS_VGA_START = 0;
  DOS_VGA_ROW_BYTES = 80;
  DOS_VGA_SEQ_INDEX = 0;
  DOS_VGA_GC_INDEX = 0;
  DOS_VGA_CRTC_INDEX = 0;
}

// A byte written into the 0xA0000 window while unchained reaches every plane
// the map mask selects, all at the same offset.
function dosVga_writePlanar(off, v) {
  let o = off & 0xFFFF;
  let b = v & 0xFF;
  if (DOS_VGA_MAP_MASK & 1) DOS_VGA_VRAM[o] = b;
  if (DOS_VGA_MAP_MASK & 2) DOS_VGA_VRAM[65536 + o] = b;
  if (DOS_VGA_MAP_MASK & 4) DOS_VGA_VRAM[131072 + o] = b;
  if (DOS_VGA_MAP_MASK & 8) DOS_VGA_VRAM[196608 + o] = b;
}

function dosVga_readPlanar(off) {
  return DOS_VGA_VRAM[((DOS_VGA_READ_PLANE & 3) << 16) + (off & 0xFFFF)];
}

// The indexed register ports. Only the handful that change what is displayed
// are modelled; the rest are accepted and ignored.
function dosVga_regWrite(port, v) {
  let b = v & 0xFF;
  if (port === 0x3C4) { DOS_VGA_SEQ_INDEX = b; return; }
  if (port === 0x3C5) {
    if (DOS_VGA_SEQ_INDEX === 0x02) DOS_VGA_MAP_MASK = b & 0x0F;
    else if (DOS_VGA_SEQ_INDEX === 0x04) {
      // Bit 3 is Chain-4. Clearing it is what puts the card into Mode X.
      let unchained = ((b & 0x08) === 0) ? 1 : 0;
      if (unchained !== DOS_VGA_UNCHAINED) {
        dosVga_planarInit();
        DOS_VGA_UNCHAINED = unchained;
      }
    }
    return;
  }
  if (port === 0x3CE) { DOS_VGA_GC_INDEX = b; return; }
  if (port === 0x3CF) {
    if (DOS_VGA_GC_INDEX === 0x04) DOS_VGA_READ_PLANE = b & 3;
    return;
  }
  if (port === 0x3D4) { DOS_VGA_CRTC_INDEX = b; return; }
  if (port === 0x3D5) {
    if (DOS_VGA_CRTC_INDEX === 0x0C) DOS_VGA_START = (DOS_VGA_START & 0x00FF) | (b << 8);
    else if (DOS_VGA_CRTC_INDEX === 0x0D) DOS_VGA_START = (DOS_VGA_START & 0xFF00) | b;
    else if (DOS_VGA_CRTC_INDEX === 0x13) {
      let rb = b * 2;
      if (rb > 0) DOS_VGA_ROW_BYTES = rb;
    }
    return;
  }
}

// Flatten the planes into the 320x200 byte-per-pixel buffer the UI draws.
function dosVga_composeUnchained() {
  let start = DOS_VGA_START & 0xFFFF;
  let row = DOS_VGA_ROW_BYTES;
  let d = 0;
  for (let y = 0; y < 200; y++) {
    let base = (start + y * row) & 0xFFFF;
    for (let x = 0; x < 320; x = x + 4) {
      let o = (base + (x >> 2)) & 0xFFFF;
      DOS_FB[d] = DOS_VGA_VRAM[o];
      DOS_FB[d + 1] = DOS_VGA_VRAM[65536 + o];
      DOS_FB[d + 2] = DOS_VGA_VRAM[131072 + o];
      DOS_FB[d + 3] = DOS_VGA_VRAM[196608 + o];
      d = d + 4;
    }
  }
}

function dosVga_getFrame() {
  DOS_VGA_FRAME++;
  if (DOS_VIDEO_MODE === 0x13) {
    // Mode 13h: 320x200. Chained is a straight copy of the 0xA0000 window;
    // unchained has to be reassembled from the four planes.
    if (DOS_VGA_UNCHAINED === 1) dosVga_composeUnchained();
    else DOS_FB.set(DOS_RAM.subarray(0xA0000, 0xA0000 + 64000));
    return {
      format: "p8",
      w: 320,
      h: 200,
      pixels: DOS_FB.toBase64(),
      palette: DOS_VGA_PAL.toBase64(),
      paletteRev: DOS_VGA_PAL_REV
    };
  }
  // Text mode: decode 80x25 characters into the 640x400 buffer.
  dosVga_renderTextMode();
  return {
    format: "p8",
    w: 640,
    h: 400,
    pixels: DOS_FB_TEXT.toBase64(),
    palette: DOS_VGA_PAL.toBase64(),
    paletteRev: DOS_VGA_PAL_REV
  };
}
