<logic src="../logic/main.logic" />

<style>
.pu-wrap { max-width: 1150px; margin: 0 auto; }
.pu-card { background: linear-gradient(165deg, #171d29 0%, #131722 100%); border: 1px solid #2a3242; border-radius: 14px; padding: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.35); }
.pu-cap { background: #10141d; border: 1px solid #2a3242; border-left: 3px solid #f59e0b; border-radius: 10px; padding: 12px 16px; min-height: 58px; cursor: pointer; }
.pu-chip { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; }
.pu-item { border: 2px solid #374151; border-radius: 10px; padding: 10px 12px; cursor: pointer; background: #101623; transition: border-color 140ms ease, translate 140ms ease; }
.pu-item:hover { border-color: #f59e0b; translate: 0 -2px; }
.pu-title { background: radial-gradient(120% 130% at 50% 0%, #1d2536 0%, #12151f 55%, #0e1118 100%); border: 1px solid #33405a; }
.pu-note { animation: pu-in 260ms cubic-bezier(0.16, 1, 0.3, 1) both; }
@keyframes pu-in { from { opacity: 0; translate: 0 6px; } to { opacity: 1; translate: 0 0; } }
.pu-hud { background: rgba(16,20,29,0.82); border: 1px solid #232b3b; border-radius: 999px; padding: 5px 8px; }
.pu-dot { width: 9px; height: 9px; border-radius: 999px; transition: background 220ms ease, transform 220ms ease; }
.pu-dot-now { transform: scale(1.45); box-shadow: 0 0 10px rgba(245,158,11,0.7); }
.pu-tc { animation: pu-tc 620ms cubic-bezier(0.16, 1, 0.3, 1) both; }
@keyframes pu-tc { from { opacity: 0; letter-spacing: 0.5em; } to { opacity: 1; letter-spacing: 0.2em; } }
.pu-barwrap { background: #0b1017; border-radius: 999px; height: 7px; overflow: hidden; }
.pu-bar { height: 7px; border-radius: 999px; transition: width 500ms cubic-bezier(0.16, 1, 0.3, 1); }
.pu-btn-ghost { background: transparent; border: 1px solid #2a3242; }
.pu-log { background: #090d13; border: 1px solid #1c2431; border-radius: 10px; padding: 12px 14px; }
.pu-scroll { overflow-y: auto; overflow-x: hidden; padding-right: 8px; }
.pu-scroll::-webkit-scrollbar { width: 9px; }
.pu-scroll::-webkit-scrollbar-track { background: #0c111a; border-radius: 999px; }
.pu-scroll::-webkit-scrollbar-thumb { background: #35405a; border-radius: 999px; }
.pu-scroll::-webkit-scrollbar-thumb:hover { background: #46536f; }
.pu-foot { border-top: 1px solid #232b3b; margin-top: 14px; padding-top: 13px; }
.pu-head { border-bottom: 1px solid #202838; padding-bottom: 11px; margin-bottom: 4px; }
.pu-panel { padding: 18px 20px; }
.pu-row { background: #101623; border-radius: 10px; padding: 11px 13px; }
.pu-cta { background: #f59e0b; color: #111; font-weight: 700; padding: 9px 18px; }
</style>

<App theme="dark">
<Stack direction="vertical" gap={12} className="pu-wrap pu-scroll" style={{ height: "100%", padding: "12px 14px 28px 14px" }}>

  <!-- ============================== TITLE ============================== -->
  <Box if={scene === "title"} className="pu-card pu-title" style={{ textAlign: "center", padding: "48px 24px" }}>
    <Text style={{ fontSize: "13px", letterSpacing: "0.35em", color: "#f59e0b" }}>A SOFTN NARRATIVE GAME · VERTICAL SLICE</Text>
    <Text style={{ fontSize: "44px", fontWeight: 800, color: "#f8fafc", marginTop: "10px" }}>PROMPTLY UNEMPLOYED</Text>
    <Text style={{ fontSize: "16px", color: "#94a3b8", marginTop: "6px", fontStyle: "italic" }}>The future arrived early. Rent is still due Friday.</Text>
    <Stack direction="horizontal" gap={12} style={{ justifyContent: "center", marginTop: "28px" }}>
      <Button @click={newGame} style={{ background: "#f59e0b", color: "#111", fontWeight: 700, padding: "10px 22px" }}>New game</Button>
      <Button if={hasSave} @click={continueGame} style={{ padding: "10px 22px" }}>Continue</Button>
    </Stack>
    <Text style={{ fontSize: "12px", color: "#64748b", marginTop: "26px" }}>Move: WASD / arrows / D-pad · Look: drag · Interact: E / Enter / tap · Skip line: Space</Text>
    <Text style={{ fontSize: "12px", color: "#64748b", marginTop: "6px" }}>Character voices are AI-generated with OpenAI text-to-speech. They are not human recordings.</Text>
    <Text style={{ display: "block", fontSize: "11px", color: "#4b5563", marginTop: "14px" }}>v0.1 · Scenes 1–9 · saves live in this browser — a save code survives updates</Text>
    <Button @click={openSettings} style={{ marginTop: "8px", fontSize: "12px" }}>{settingsOpen ? "Close save code" : "Save code"}</Button>
    <Box if={settingsOpen} style={{ marginTop: "12px", textAlign: "left", background: "#10141d", borderRadius: "10px", padding: "12px" }}>
      <Text style={{ display: "block", fontSize: "12px", color: "#94a3b8" }}>Your save, as text. Copy it out to keep it safe; paste one in to restore it.</Text>
      <Input :bind={saveCode} placeholder="Paste a save code here" style={{ width: "100%", marginTop: "8px", fontFamily: "monospace", fontSize: "11px" }} />
      <Stack direction="horizontal" gap={8} style={{ marginTop: "8px" }}>
        <Button @click={copySaveCode} style={{ fontSize: "12px" }}>Copy</Button>
        <Button @click={loadSaveCode} style={{ fontSize: "12px", background: "#f59e0b", color: "#111", fontWeight: 700 }}>Load</Button>
        <Text style={{ fontSize: "11px", color: "#4ade80", alignSelf: "center" }}>{saveCodeMsg}</Text>
      </Stack>
    </Box>
  </Box>

  <!-- ============================== 3D WORLD ============================== -->
  <Stack if={scene !== "title" && scene !== "done"} direction="horizontal" gap={10} style={{ alignItems: "center", flexWrap: "wrap" }}>
    <Text className="pu-chip" style={{ background: "#1f2937", color: "#f59e0b" }}>{scene === "meeting" ? slideTitle : objective}</Text>
    <Box style={{ flex: 1 }} />
    <Stack direction="horizontal" gap={9} className="pu-hud" style={{ alignItems: "center" }}>
      <Text style={{ fontSize: "11px", color: "#8b97ad", letterSpacing: "0.08em", paddingLeft: "4px" }}>{currentChapter()}</Text>
      <Stack direction="horizontal" gap={6} style={{ alignItems: "center" }}>
        #each (d, di in chapterDots())
          <Box className={d.state === "now" ? "pu-dot pu-dot-now" : "pu-dot"}
               style={{ width: "9px", height: "9px", borderRadius: "999px", background: dotColor(d.state) }} />
        #end
      </Stack>
    </Stack>
    <Text className="pu-chip" style={{ background: "#1f2937", color: "#4ade80" }}>Runway {stat("runway")}</Text>
    <Button if={inWorld()} @click={toggleTheatre} className="pu-btn-ghost" style={{ padding: "4px 12px", fontSize: "12px" }}>{theatre ? "Cosy" : "Theatre"}</Button>
    <Button @click={toggleMute} className="pu-btn-ghost" style={{ padding: "4px 12px", fontSize: "12px" }}>{muted ? "Unmute" : "Mute"}</Button>
    <Button @click={toggleTranscript} className="pu-btn-ghost" style={{ padding: "4px 12px", fontSize: "12px" }}>Transcript</Button>
  </Stack>

  <Box if={inWorld()}>
    <Box style={{ position: "relative", width: "fit-content", maxWidth: "100%" }}>
      <Scene3D
        width={sceneW()}
        height={sceneH()}
        objects={objects}
        lights={lights}
        camera={{ position: cameraPos, lookAt: cameraLookAt, fov: 75 }}
        antialias={true}
        shadows={false}
        mouseLook={true}
        fog={sceneFog}
        background={sceneBg}
        @click={onSceneClick}
        style={{ borderRadius: "12px", border: "1px solid #2a3242", maxWidth: "100%" }}
      />
      <Box if={cutActive || scene === "meeting"} style={{ position: "absolute", top: 0, left: 0, width: "100%", height: "38px", background: "#000", opacity: 0.92, borderRadius: "12px 12px 0 0", pointerEvents: "none" }} />
      <Box if={cutActive || scene === "meeting"} style={{ position: "absolute", bottom: 0, left: 0, width: "100%", height: "38px", background: "#000", opacity: 0.92, borderRadius: "0 0 12px 12px", pointerEvents: "none" }} />
      <Box if={cutActive && cutTitle !== ""} style={{ position: "absolute", top: "52px", left: "28px", pointerEvents: "none" }}>
        <Text className="pu-tc" style={{ display: "block", fontSize: "19px", fontWeight: 800, color: "#f8fafc", letterSpacing: "0.2em", textShadow: "0 2px 12px rgba(0,0,0,0.9)" }}>{cutTitle}</Text>
        <Text style={{ display: "block", fontSize: "12px", color: "#cbd5e1", marginTop: "6px", fontStyle: "italic", textShadow: "0 2px 10px rgba(0,0,0,0.9)" }}>{cutSub}</Text>
      </Box>
      <Button if={cutActive} @click={skipCutscene} style={{ position: "absolute", top: "46px", right: "10px", fontSize: "11px", opacity: 0.75, padding: "4px 10px" }}>Skip ▸</Button>
      <Box if={fadeOp > 0} style={{ position: "absolute", top: 0, left: 0, width: "100%", height: "100%", background: "#000", opacity: fadeOp, pointerEvents: "none", borderRadius: "12px" }} />
    </Box>
  </Box>

  <!-- Scene 1: debug-card puzzle -->
  <Box if={debugOpen} className="pu-card pu-note pu-panel">
    <Box className="pu-head">
      <Text style={{ display: "block", fontWeight: 700, fontSize: "16px", color: "#fbbf24" }}>Yesterday's incident — assemble the fix</Text>
      <Text style={{ display: "block", fontSize: "13px", color: "#94a3b8", marginTop: "5px" }}>{debugMsg}</Text>
    </Box>
    <Stack direction="horizontal" gap={12} style={{ marginTop: "14px", flexWrap: "wrap" }}>
      #each (card, ci in DEBUG_CARDS)
        <Box className="pu-item" @click={pickDebugCard(card.id)}
             style={{ borderColor: debugPicked.indexOf(card.id) >= 0 ? "#4ade80" : "#374151", minWidth: "200px" }}>
          <Text style={{ fontWeight: 700, fontSize: "12px", letterSpacing: "0.1em", color: "#38bdf8" }}>{card.label}</Text>
          <Text style={{ fontSize: "13px", color: "#cbd5e1", marginTop: "4px" }}>{card.desc}</Text>
        </Box>
      #end
    </Stack>
    <Stack direction="horizontal" gap={10} className="pu-foot" style={{ alignItems: "center" }}>
      <Text style={{ fontSize: "12px", color: "#64748b", flex: 1 }}>Placed: {debugPicked.length} / 3</Text>
      <Button @click={closeDebug} className="pu-btn-ghost" style={{ fontSize: "12px" }}>Step away</Button>
    </Stack>
  </Box>

  <!-- Scene 2: title card -->
  <Box if={titleCardUp} className="pu-card pu-note" style={{ textAlign: "center", padding: "44px 24px", borderColor: "#f59e0b" }}>
    <Text style={{ fontSize: "13px", color: "#94a3b8" }}>Your account has been revoked. The room display now calls you</Text>
    <Text style={{ fontSize: "22px", color: "#cbd5e1", marginTop: "4px" }}>Former Employee 8472</Text>
    <Text style={{ fontSize: "40px", fontWeight: 800, color: "#f59e0b", marginTop: "20px" }}>PROMPTLY UNEMPLOYED</Text>
    <Button @click={dismissTitleCard} style={{ marginTop: "24px", background: "#f59e0b", color: "#111", fontWeight: 700 }}>Collect your things</Button>
  </Box>

  <!-- Scene 3: desk-matter picker -->
  <Box if={scene === "boxes"} className="pu-card pu-panel">
    <Box className="pu-head">
      <Text style={{ display: "block", fontWeight: 700, fontSize: "16px", color: "#fbbf24" }}>Personally Attributable Desk Matter</Text>
      <Text style={{ display: "block", fontSize: "13px", color: "#94a3b8", marginTop: "5px" }}>One small archive box. Ten years. Keep exactly three.</Text>
    </Box>
    <Box if={pickerOpen}>
      <Stack direction="horizontal" gap={12} className="pu-scroll" style={{ marginTop: "14px", flexWrap: "wrap", maxHeight: "44vh" }}>
        #each (item, ii in ITEMS)
          <Box className="pu-item" @click={toggleItem(item.id)}
               style={{ borderColor: isPicked(item.id) ? "#f59e0b" : "#374151", width: "300px" }}>
            <Text style={{ fontWeight: 700, color: "#e2e8f0" }}>{item.name}</Text>
            <Text style={{ fontSize: "12px", color: "#94a3b8", marginTop: "2px", fontStyle: "italic" }}>{item.desc}</Text>
          </Box>
        #end
      </Stack>
      <Stack direction="horizontal" gap={10} className="pu-foot" style={{ alignItems: "center" }}>
        <Text style={{ fontSize: "13px", color: "#64748b", flex: 1 }}>In the box: {picked.length} / 3</Text>
        <Button if={picked.length === 3} @click={confirmItems} className="pu-cta">Tape it shut</Button>
      </Stack>
    </Box>
  </Box>

  <!-- Chapter card -->
  <Box if={chapterCard !== ""} className="pu-card pu-note" style={{ textAlign: "center", padding: "40px 24px" }}>
    <Text style={{ fontSize: "13px", color: "#64748b" }}>Outside, the recruiter email suggests your old job. Six-month contract.</Text>
    <Text style={{ fontSize: "26px", fontWeight: 700, color: "#f8fafc", marginTop: "14px" }}>{chapterCard}</Text>
    <Button @click={dismissChapterCard} style={{ marginTop: "22px" }}>Go home</Button>
  </Box>

  <!-- Scene 4: budget overlay -->
  <Box if={budgetOpen} className="pu-card pu-note pu-panel">
    <Box className="pu-head">
      <Text style={{ display: "block", fontWeight: 700, fontSize: "16px", color: "#fbbf24" }}>The numbers</Text>
      <Text style={{ display: "block", fontSize: "13px", color: "#94a3b8", marginTop: "5px" }}>Severance in. Rent out. Everything else is a decision.</Text>
    </Box>
    <Stack direction="vertical" gap={8} className="pu-scroll" style={{ marginTop: "14px", maxHeight: "42vh" }}>
      #each (s, si in SUBS)
        <Stack direction="horizontal" gap={10} style={{ alignItems: "center", background: "#101623", borderRadius: "8px", padding: "8px 12px", opacity: isCancelled(s.id) ? 0.45 : 1 }}>
          <Box style={{ flex: 1 }}>
            <Text style={{ color: "#e2e8f0", fontWeight: 600, textDecoration: isCancelled(s.id) ? "line-through" : "none" }}>{s.name} — ${s.cost}/mo</Text>
            <Text style={{ fontSize: "12px", color: "#64748b", fontStyle: "italic" }}>{s.joke}</Text>
          </Box>
          <Button if={!isCancelled(s.id)} @click={cancelSub(s.id)} style={{ fontSize: "12px" }}>{s.locked ? "Cancel?" : "Cancel"}</Button>
          <Text if={isCancelled(s.id)} style={{ fontSize: "12px", color: "#4ade80" }}>cancelled</Text>
        </Stack>
      #end
    </Stack>
    <Stack direction="horizontal" gap={10} className="pu-foot" style={{ alignItems: "center", flexWrap: "wrap" }}>
      <Text style={{ fontSize: "13px", color: "#94a3b8", flex: 1 }}>Burn ${burnMonthly()}/mo · runway ≈ {runwayWeeks()} weeks</Text>
      <Button @click={finishBudget} className="pu-cta">Enough numbers</Button>
    </Stack>
  </Box>

  <!-- Scene 5: LUMA terminal -->
  <Box if={scene === "luma"} className="pu-card pu-panel" style={{ borderColor: "#7c3aed" }}>
    <Stack direction="horizontal" gap={8} style={{ alignItems: "center" }}>
      <Text style={{ fontWeight: 800, color: "#a78bfa", letterSpacing: "0.1em" }}>LUMA</Text>
      <Text style={{ fontSize: "12px", color: "#64748b" }}>Logical Utility and Messaging Assistant · build 0.4 · last run: 412 days ago</Text>
    </Stack>
    <Box if={lumaPhase === "greet"} style={{ marginTop: "12px" }}>
      <Button @click={askLuma} style={{ background: "#7c3aed", color: "#fff", fontWeight: 600 }}>“Give me a billion-dollar business idea. No capital, no staff, no emotional resilience.”</Button>
    </Box>
    <Box if={wsOpen} className="pu-scroll" style={{ marginTop: "12px", maxHeight: "46vh" }}>
      <Text style={{ display: "block", fontSize: "13px", color: "#94a3b8" }}>LUMA refuses to brainstorm further without inputs. Pick one card per question.</Text>
      #each (cat, gi in WS_CATS)
        <Box style={{ marginTop: "10px" }}>
          <Text style={{ fontSize: "12px", fontWeight: 700, color: "#38bdf8", letterSpacing: "0.08em" }}>{cat.title}</Text>
          <Stack direction="horizontal" gap={8} style={{ marginTop: "6px", flexWrap: "wrap" }}>
            #each (card, ki in cat.cards)
              <Box className="pu-item" @click={pickWs(cat.id, card.id, card.kind)}
                   style={{ borderColor: wsPicked(cat.id) === card.id ? "#a78bfa" : "#374151" }}>
                <Text style={{ fontSize: "13px", color: "#e2e8f0" }}>{card.label}</Text>
              </Box>
            #end
          </Stack>
        </Box>
      #end
      <Button if={wsReady()} @click={submitWs} style={{ marginTop: "14px", background: "#7c3aed", color: "#fff", fontWeight: 600 }}>Send it</Button>
    </Box>
  </Box>

  <!-- Scene 6: missing-orders puzzle -->
  <Box if={ordersOpen} className="pu-card pu-note pu-panel">
    <Box className="pu-head">
      <Text style={{ display: "block", fontWeight: 700, fontSize: "16px", color: "#fbbf24" }}>The missing orders</Text>
      <Text style={{ display: "block", fontSize: "13px", color: "#94a3b8", marginTop: "5px" }}>Three orders, four channels, no shared queue. Match each order to the slip that actually fits the facts.</Text>
    </Box>
    <Box className="pu-scroll" style={{ maxHeight: "44vh", marginTop: "6px" }}>
    #each (o, oi in ORDERS)
      <Box style={{ marginTop: "12px", background: "#101623", borderRadius: "10px", padding: "10px 12px" }}>
        <Text style={{ fontSize: "13px", fontWeight: 700, color: "#e2e8f0" }}>Known: {o.fact}</Text>
        <Stack direction="horizontal" gap={8} style={{ marginTop: "8px", flexWrap: "wrap" }}>
          #each (slip, si in o.slips)
            <Box className="pu-item" @click={pickSlip(o.id, slip.id)}
                 style={{ borderColor: orderPickOf(o.id) === slip.id ? "#4ade80" : "#374151" }}>
              <Text style={{ fontSize: "12px", color: orderPickOf(o.id) === slip.id ? "#86efac" : "#cbd5e1" }}>{slip.label}</Text>
            </Box>
          #end
        </Stack>
      </Box>
    #end
    </Box>
    <Stack direction="horizontal" gap={10} className="pu-foot" style={{ alignItems: "center" }}>
      <Text style={{ fontSize: "12px", color: "#64748b", flex: 1 }}>Leo watches, professionally unimpressed.</Text>
      <Button @click={closeOrders} className="pu-btn-ghost" style={{ fontSize: "12px" }}>Step back</Button>
    </Stack>
  </Box>

  <!-- Scene 8: the Scope Board -->
  <Box if={scopeOpen} className="pu-card pu-note pu-panel" style={{ borderColor: "#38bdf8" }}>
    <Box className="pu-head">
      <Stack direction="horizontal" gap={10} style={{ alignItems: "center" }}>
        <Text style={{ fontWeight: 700, fontSize: "16px", color: "#7dd3fc" }}>The Scope Board</Text>
        <Box style={{ flex: 1 }} />
        <Text className="pu-chip" style={{ background: "#1f2937", color: "#fbbf24" }}>Points left: {SCOPE_BUDGET - scopeCost()}</Text>
      </Stack>
      <Text style={{ display: "block", fontSize: "13px", color: "#94a3b8", marginTop: "5px" }}>A viable build needs intake, a review queue, and at least one safety check. Everything shiny is a decision against those.</Text>
    </Box>
    <Stack direction="horizontal" gap={12} className="pu-scroll" style={{ marginTop: "14px", flexWrap: "wrap", maxHeight: "42vh" }}>
      #each (card, si in SCOPE_CARDS)
        <Box className="pu-item" @click={toggleScope(card.id)}
             style={{ borderColor: scopeHas(card.id) ? (card.kind === "flash" ? "#f472b6" : "#4ade80") : "#374151", width: "300px" }}>
          <Stack direction="horizontal" gap={8} style={{ alignItems: "center" }}>
            <Text style={{ fontWeight: 700, color: "#e2e8f0", flex: 1 }}>{card.name}</Text>
            <Text className="pu-chip" style={{ background: "#0b1017", color: card.kind === "flash" ? "#f472b6" : "#7dd3fc" }}>{card.cost} pt</Text>
          </Stack>
          <Text style={{ fontSize: "12px", color: "#94a3b8", marginTop: "2px", fontStyle: "italic" }}>{card.desc}</Text>
        </Box>
      #end
    </Stack>
    <Stack direction="horizontal" gap={10} className="pu-foot" style={{ alignItems: "center", flexWrap: "wrap" }}>
      <Text style={{ fontSize: "12px", color: "#64748b", flex: 1, minWidth: "180px" }}>{scopeValid() ? "Priya nods. This could actually ship." : "Not viable yet: intake + review + one safety check."}</Text>
      <Button @click={closeScope} className="pu-btn-ghost" style={{ fontSize: "12px" }}>Step back</Button>
      <Button if={scopeValid()} @click={confirmScope} style={{ background: "#38bdf8", color: "#111", fontWeight: 700, padding: "9px 18px" }}>Lock the scope</Button>
    </Stack>
  </Box>

  <!-- Scene 9: workflow policies -->
  <Box if={wfOpen} className="pu-card pu-note pu-panel" style={{ borderColor: "#4ade80" }}>
    <Box className="pu-head">
      <Text style={{ display: "block", fontWeight: 700, fontSize: "16px", color: "#86efac" }}>Workflow Archaeology</Text>
      <Text style={{ display: "block", fontSize: "13px", color: "#94a3b8", marginTop: "5px" }}>Six real cases from this morning. Give each a policy. LUMA's confidence is shown beside each one — confidence is not the same thing as safety.</Text>
    </Box>
    <Box className="pu-scroll" style={{ maxHeight: "40vh", marginTop: "6px" }}>
    #each (c, wi in WF_CASES)
      <Box style={{ marginTop: "10px", background: "#101623", borderRadius: "10px", padding: "10px 12px" }}>
        <Stack direction="horizontal" gap={8} style={{ alignItems: "center", flexWrap: "wrap" }}>
          <Text style={{ fontSize: "13px", fontWeight: 600, color: "#e2e8f0", flex: 1 }}>{c.text}</Text>
          <Text className="pu-chip" style={{ background: "#0b1017", color: "#7dd3fc" }}>{c.conf}</Text>
          <Text className="pu-chip" style={{ background: "#0b1017", color: "#fbbf24" }}>risk: {c.risk}</Text>
        </Stack>
        <Stack direction="horizontal" gap={8} style={{ marginTop: "8px", flexWrap: "wrap" }}>
          #each (p, pi in WF_POLICIES)
            <Box className="pu-item" @click={pickWf(c.id, p.id)}
                 style={{ borderColor: wfPicked(c.id) === p.id ? "#4ade80" : "#374151", padding: "6px 12px" }}>
              <Text style={{ fontSize: "12px", color: wfPicked(c.id) === p.id ? "#86efac" : "#cbd5e1" }}>{p.label}</Text>
            </Box>
          #end
        </Stack>
      </Box>
    #end
    </Box>
    <Stack direction="horizontal" gap={10} className="pu-foot" style={{ alignItems: "center", flexWrap: "wrap" }}>
      <Text style={{ fontSize: "12px", color: "#64748b", flex: 1, minWidth: "180px" }}>{wfReady() ? "Every case has an owner." : "Every case needs a policy before Tuesday."}</Text>
      <Button @click={closeWf} className="pu-btn-ghost" style={{ fontSize: "12px" }}>Step back</Button>
      <Button if={wfReady()} @click={submitWf} style={{ background: "#4ade80", color: "#111", fontWeight: 700, padding: "9px 18px" }}>Set the policies</Button>
    </Stack>
  </Box>

  <!-- Principle card -->
  <Box if={principleUp} className="pu-card pu-note" style={{ textAlign: "center", padding: "36px 24px", borderColor: "#a78bfa" }}>
    <Text style={{ fontSize: "12px", color: "#64748b", letterSpacing: "0.2em" }}>PRINCIPLE №{principleNum}</Text>
    <Text style={{ fontSize: "28px", fontWeight: 700, color: "#f8fafc", marginTop: "10px" }}>{principleText}</Text>
    <Text style={{ fontSize: "13px", color: "#94a3b8", marginTop: "8px", fontStyle: "italic" }}>{principleFlavor}</Text>
    <Button @click={pinPrinciple} style={{ marginTop: "22px", background: "#a78bfa", color: "#111", fontWeight: 700 }}>Pin it to the wall</Button>
  </Box>

  <!-- End of slice -->
  <Box if={scene === "done"} className="pu-card" style={{ padding: "30px 32px 34px 32px" }}>
    <Text style={{ display: "block", fontSize: "12px", color: "#f59e0b", letterSpacing: "0.3em" }}>END OF VERTICAL SLICE</Text>
    <Text style={{ display: "block", fontSize: "26px", fontWeight: 800, color: "#f8fafc", marginTop: "8px" }}>{productName + " exists now. It has one customer, zero features, and a deadline."}</Text>
    <Stack direction="horizontal" gap={16} style={{ marginTop: "18px", flexWrap: "wrap" }}>
      <Box style={{ minWidth: "190px", flex: 1 }}>
        <Text style={{ display: "block", fontSize: "11px", color: "#7dd3fc", letterSpacing: "0.14em" }}>INTEGRITY</Text>
        <Box className="pu-barwrap" style={{ marginTop: "5px" }}>
          <Box className="pu-bar" style={{ width: statPct(integrity), background: "#38bdf8" }} />
        </Box>
      </Box>
      <Box style={{ minWidth: "190px", flex: 1 }}>
        <Text style={{ display: "block", fontSize: "11px", color: "#86efac", letterSpacing: "0.14em" }}>COLLABORATION</Text>
        <Box className="pu-barwrap" style={{ marginTop: "5px" }}>
          <Box className="pu-bar" style={{ width: statPct(collaboration), background: "#4ade80" }} />
        </Box>
      </Box>
      <Box style={{ minWidth: "190px", flex: 1 }}>
        <Text style={{ display: "block", fontSize: "11px", color: "#f9a8d4", letterSpacing: "0.14em" }}>HYPE</Text>
        <Box className="pu-barwrap" style={{ marginTop: "5px" }}>
          <Box className="pu-bar" style={{ width: statPct(hype), background: "#f472b6" }} />
        </Box>
      </Box>
    </Stack>
    <Box style={{ marginTop: "16px" }}>
      #each (line, li in summaryLines)
        <Text style={{ display: "block", fontSize: "14px", color: "#cbd5e1", marginTop: "4px" }}>· {line}</Text>
      #end
    </Box>
    <Text style={{ fontSize: "12px", fontWeight: 700, color: "#4ade80", marginTop: "18px", letterSpacing: "0.1em" }}>PATCHWORK RELEASE NOTES (v0.0.1)</Text>
    <Box className="pu-log" style={{ marginTop: "6px", fontFamily: "monospace", maxHeight: "240px", overflowY: "auto" }}>
      #each (entry, ei in changelog)
        <Text style={{ display: "block", fontSize: "12px", color: "#86efac", fontFamily: "monospace", marginTop: "2px" }}>+ {entry}</Text>
      #end
    </Box>
    <Text style={{ display: "block", fontSize: "12px", color: "#64748b", marginTop: "18px" }}>Scenes 10–17 — Tuesday's pilot, the printer's 1,204 retries, LaunchPad, and four endings — continue in the full plan.</Text>
    <Text style={{ display: "block", fontSize: "12px", color: "#64748b", marginTop: "4px" }}>Voices: OpenAI gpt-4o-mini-tts (marin, coral, alloy, sage, onyx, cedar, echo, shimmer). AI-generated; not human recordings.</Text>
    <Stack direction="horizontal" gap={10} style={{ marginTop: "20px" }}>
      <Button @click={newGame} style={{ background: "#f59e0b", color: "#111", fontWeight: 700 }}>Play again</Button>
      <Button @click={backToTitle}>Title screen</Button>
    </Stack>
  </Box>

  <!-- Caption / note bar -->
  <Box if={showCaptionBar()} className="pu-cap" @click={dlgSkip} style={{ borderLeftColor: dlgActive ? speakerColor(dlgSpeaker) : "#f59e0b" }}>
    <Box if={dlgActive}>
      <Stack direction="horizontal" gap={8} style={{ alignItems: "center" }}>
        <Box style={{ width: "8px", height: "8px", borderRadius: "999px", background: speakerColor(dlgSpeaker) }} />
        <Text className="pu-chip" style={{ background: "#1a2331", color: speakerColor(dlgSpeaker), letterSpacing: "0.12em" }}>{dlgSpeaker}</Text>
        <Box style={{ flex: 1 }} />
        <Text style={{ fontSize: "10px", color: "#3f4a5c" }}>space · skip</Text>
      </Stack>
      <Text style={{ display: "block", fontSize: "15px", color: "#f1f5f9", marginTop: "7px", lineHeight: "1.45" }}>{dlgText}</Text>
    </Box>
    <Box if={!dlgActive && noteText !== ""} className="pu-note">
      <Text style={{ fontSize: "14px", color: "#94a3b8", fontStyle: "italic" }}>{noteText}</Text>
    </Box>
    <Box if={!dlgActive && noteText === "" && hudPrompt() !== ""}>
      <Text style={{ fontSize: "14px", color: "#fbbf24" }}>{hudPrompt()}</Text>
    </Box>
  </Box>

  <!-- Choice panel -->
  <Box if={choiceList.length > 0} className="pu-card pu-note" style={{ borderColor: "#38bdf8", padding: "16px 18px" }}>
    <Stack direction="vertical" gap={9}>
      #each (c, ci in choiceList)
        <Button @click={pickChoice(c.id)} style={{ textAlign: "left", justifyContent: "flex-start", padding: "12px 16px", fontSize: "14px", lineHeight: "1.4" }}>{(ci + 1) + " · " + c.label}</Button>
      #end
    </Stack>
  </Box>

  <!-- Controls -->
  <Stack if={canMove() && !cutActive} direction="horizontal" gap={14} style={{ alignItems: "center" }}>
    <DPad @press={padPress} @release={padRelease} />
    <Button @click={interactPressed} style={{ padding: "14px 20px", fontWeight: 700 }}>Use (E)</Button>
    <Text style={{ fontSize: "11px", color: "#4b5563" }}>WASD move · ◀▶ turn · drag to look</Text>
  </Stack>

  <!-- Transcript -->
  <Box if={transcriptOpen} className="pu-card" style={{ maxHeight: "220px", overflowY: "auto" }}>
    <Text style={{ fontWeight: 700, color: "#94a3b8", fontSize: "12px", letterSpacing: "0.1em" }}>TRANSCRIPT</Text>
    #each (t, ti in transcript)
      <Text style={{ display: "block", fontSize: "12px", color: "#94a3b8", marginTop: "5px" }}><Text style={{ color: speakerColor(t.speaker), fontWeight: 700 }}>{t.speaker}</Text>{"  " + t.text}</Text>
    #end
  </Box>

</Stack>
<Loop interval={33} running={scene !== "title"} @tick={tick} />
</App>
