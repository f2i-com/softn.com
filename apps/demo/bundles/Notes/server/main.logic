// Test server script for softn-server integration tests

let requestCount = 0;

function onStart() {
  console.log("Test app started!");
}

function handleHello(req) {
  requestCount = requestCount + 1;
  return {
    status: 200,
    body: {
      message: "Hello from SoftN!",
      method: req.method,
      path: req.path,
      requestCount: requestCount
    }
  };
}

function handleEcho(req) {
  return {
    status: 200,
    body: {
      echo: req.body,
      query: req.query,
      method: req.method
    }
  };
}

function handleCreateNote(req) {
  let data = req.body;
  if (!data || !data.title) {
    return { status: 400, body: { error: "title is required" } };
  }
  let record = db.create("notes", data);
  return {
    status: 201,
    body: { id: record.id, data: record.data }
  };
}

function handleGetNotes(req) {
  let notes = db.query("notes");
  let result = [];
  for (let i = 0; i < notes.length; i = i + 1) {
    result.push({ id: notes[i].id, data: notes[i].data });
  }
  return { status: 200, body: { notes: result, count: notes.length } };
}

function handleDeleteNote(req) {
  let data = req.body;
  if (!data || !data.id) {
    return { status: 400, body: { error: "id is required" } };
  }
  db.delete(data.id);
  return { status: 200, body: { deleted: data.id } };
}

function onBeforeSyncBatch(ops) {
  console.log("onBeforeSyncBatch: " + ops.length + " ops");
  // Accept all ops
  return null;
}

function onAfterSyncBatch(ops) {
  console.log("onAfterSyncBatch: " + ops.length + " ops applied");
}
