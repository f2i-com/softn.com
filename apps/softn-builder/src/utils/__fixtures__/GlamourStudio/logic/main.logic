  let iconOpen = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="100%" height="100%" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
  let iconCalendar = iconOpen + '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>'
  let iconUsers = iconOpen + '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>'
  let iconScissors = iconOpen + '<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>'
  let iconList = iconOpen + '<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>'
  let iconSun = iconOpen + '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>'
  let iconMoon = iconOpen + '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>'

  // App icon as inline SVG data URL (cached to avoid Image component resetting on re-render)
  let appIconUrl = "data:image/svg+xml," + encodeURIComponent("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><defs><linearGradient id='bg-grad' x1='0%' y1='0%' x2='100%' y2='100%'><stop offset='0%' stop-color='#b08d60'/><stop offset='100%' stop-color='#9a7a52'/></linearGradient><mask id='g-mask'><rect width='100' height='100' fill='black'/><circle cx='50' cy='50' r='34' fill='white'/><circle cx='50' cy='50' r='20' fill='black'/><path d='M 50 50 L 75 -10 L 110 -10 L 110 44 L 40 44 Z' fill='black'/><rect x='46' y='44' width='40' height='14' fill='white'/><circle cx='50' cy='50' r='68' stroke='black' stroke-width='68' fill='none'/></mask></defs><rect width='100' height='100' rx='22' fill='url(#bg-grad)'/><rect width='100' height='100' fill='white' mask='url(#g-mask)'/></svg>")

  // Theme colors — warm luxury palette
  function getBgColor() {
    return darkMode ? "#0c0a09" : "#faf9f7"
  }

  function getSidebarBg() {
    return darkMode ? "#211f1d" : "#ffffff"
  }

  function getCardBg() {
    return darkMode ? "#1c1917" : "#ffffff"
  }

  function getRaisedBg() {
    return darkMode ? "#292524" : "#f5f5f4"
  }

  function getBorderColor() {
    return darkMode ? "rgba(214, 191, 167, 0.10)" : "rgba(28, 25, 23, 0.08)"
  }

  function getSubtleBorder() {
    return darkMode ? "rgba(214, 191, 167, 0.06)" : "rgba(28, 25, 23, 0.05)"
  }

  function getTextColor() {
    return darkMode ? "#faf9f7" : "#1c1917"
  }

  function getMutedColor() {
    return darkMode ? "#a8a29e" : "#78716c"
  }

  function getHeadingColor() {
    return darkMode ? "#faf9f7" : "#1c1917"
  }

  function getAccentColor() {
    return darkMode ? "#d4a574" : "#b08d60"
  }

  function getAccentHover() {
    return darkMode ? "#c2956a" : "#9a7a52"
  }

  function getAccentMuted() {
    return darkMode ? "rgba(212, 165, 116, 0.15)" : "rgba(176, 141, 96, 0.12)"
  }

  // Get greeting based on time of day
  function getGreeting() {
    let hour = new Date().getHours()
    if (hour < 12) return "Good morning"
    if (hour < 17) return "Good afternoon"
    return "Good evening"
  }

  // Activity logging helper
  function logActivity(title, description, status, actor) {
    db.create("activity", {
      title: title,
      description: description,
      time: new Date().toISOString(),
      status: status || "info",
      actor: actor || "Front desk"
    })
  }

  // Appointment forms pick from the people and services that exist rather
  // than asking for names to be typed. A collection with nothing in it yet
  // falls back to a text box so the first booking can still be made.
  function pickField(name, label, records, key, placeholder) {
    let options = []
    for (let i = 0; i < records.length; i = i + 1) {
      let value = records[i].data ? records[i].data[key] : records[i][key]
      if (value) { options.push({ value: value, label: value }) }
    }
    if (options.length === 0) {
      return { name: name, type: "text", label: label, required: true, placeholder: placeholder }
    }
    return { name: name, type: "select", label: label, required: true, options: options }
  }

  function buildAppointmentFields() {
    let fields = [
      pickField("client", "Client", db.query("clients"), "name", "Client's full name"),
      pickField("stylist", "Stylist", db.query("staff"), "name", "Stylist's full name"),
      pickField("service", "Service", db.query("services"), "name", "Service name"),
      {
        name: "time",
        type: "text",
        label: "Time",
        required: true,
        placeholder: "HH:MM, e.g. 14:30",
        pattern: "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
        helpText: "24-hour clock"
      }
    ]
    // SmartForm seeds a new form from each field's defaultValue; the modal's
    // defaults prop is not something it reads.
    fields.push({
      name: "status",
      type: "select",
      label: "Status",
      defaultValue: "scheduled",
      options: [
        { value: "scheduled", label: "Scheduled" },
        { value: "in-progress", label: "In progress" },
        { value: "completed", label: "Completed" }
      ]
    })
    fields.push({ name: "price", type: "number", label: "Price ($)", min: 0, defaultValue: 0, placeholder: "0" })
    return fields
  }

  // Theme toggle
  function toggleTheme() {
    darkMode = !darkMode
    try { localStorage.setItem("softn-theme-preference", darkMode ? "dark" : "light") } catch(e) {}
  }

  // Navigation
  function navigate(page) {
    currentPage = page
    selectedItem = null
  }

  function toggleSidebar() {
    sidebarCollapsed = !sidebarCollapsed
  }

  function selectItem(item) {
    selectedItem = item
  }

  function clearSelection() {
    selectedItem = null
  }

  // Navigate to page AND select item (for dashboard clicks)
  function viewAppointment(item) {
    selectedItem = item
    currentPage = "appointments"
  }

  function viewStaff(item) {
    selectedItem = item
    currentPage = "staff"
  }

