// dos_shell.logic — the COMMAND.COM stand-in
//
// A real command line rather than a picture of one: it reads the BIOS key
// buffer, echoes what you type into text mode memory, and runs commands. The
// programs on the virtual drive are genuine 8086 machine code, executed by
// dos_cpu, not JavaScript pretending to be a DOS program.

let DOS_SHELL_LINE = "";
let DOS_SHELL_ACTIVE = 0;     // 1 while the prompt has the keyboard
let DOS_SHELL_HISTORY = [];
let DOS_SHELL_HIST_POS = -1;

function dosShell_prompt() {
  dosKernel_printStr("C:\\> ");
}

function dosShell_start() {
  DOS_SHELL_ACTIVE = 1;
  DOS_SHELL_LINE = "";
  DOS_CURSOR_VISIBLE = 1;
}

// Pull everything waiting in the key buffer and act on it. Called once a
// frame while the shell owns the screen.
function dosShell_tick() {
  if (!DOS_SHELL_ACTIVE) return;
  let guard = 0;
  while (DOS_KEY_HEAD !== DOS_KEY_TAIL && guard < 32) {
    guard++;
    let word = DOS_KEY_BUFFER[DOS_KEY_TAIL];
    DOS_KEY_TAIL = (DOS_KEY_TAIL + 1) & 31;
    let ascii = word & 0xFF;
    let scan = (word >> 8) & 0xFF;

    if (ascii === 13) {                    // Enter
      dosKernel_printStr("\r\n");
      let line = DOS_SHELL_LINE;
      DOS_SHELL_LINE = "";
      if (line.length > 0) {
        DOS_SHELL_HISTORY.push(line);
        if (DOS_SHELL_HISTORY.length > 32) DOS_SHELL_HISTORY.shift();
      }
      DOS_SHELL_HIST_POS = -1;
      dosShell_execute(line);
      if (DOS_SHELL_ACTIVE) dosShell_prompt();
      continue;
    }
    if (ascii === 8) {                     // Backspace
      if (DOS_SHELL_LINE.length > 0) {
        DOS_SHELL_LINE = DOS_SHELL_LINE.slice(0, DOS_SHELL_LINE.length - 1);
        dosKernel_putChar(8);
      }
      continue;
    }
    if (scan === 0x48 || scan === 0x50) {  // Up / Down through the history
      let n = DOS_SHELL_HISTORY.length;
      if (n === 0) continue;
      if (scan === 0x48) DOS_SHELL_HIST_POS = (DOS_SHELL_HIST_POS < 0) ? (n - 1) : Math.max(0, DOS_SHELL_HIST_POS - 1);
      else DOS_SHELL_HIST_POS = (DOS_SHELL_HIST_POS < 0) ? -1 : Math.min(n - 1, DOS_SHELL_HIST_POS + 1);
      // Rub out what is on the line, then write the recalled one.
      while (DOS_SHELL_LINE.length > 0) {
        DOS_SHELL_LINE = DOS_SHELL_LINE.slice(0, DOS_SHELL_LINE.length - 1);
        dosKernel_putChar(8);
      }
      if (DOS_SHELL_HIST_POS >= 0) {
        DOS_SHELL_LINE = DOS_SHELL_HISTORY[DOS_SHELL_HIST_POS];
        dosKernel_printStr(DOS_SHELL_LINE);
      }
      continue;
    }
    if (ascii >= 32 && ascii < 127 && DOS_SHELL_LINE.length < 72) {
      DOS_SHELL_LINE += String.fromCharCode(ascii);
      dosKernel_putChar(ascii);
    }
  }
}

function dosShell_execute(raw) {
  let line = raw.trim();
  if (line === "") return;

  // Split the verb from its argument.
  let sp = line.indexOf(" ");
  let verb = (sp < 0 ? line : line.slice(0, sp)).toUpperCase();
  let rest = (sp < 0) ? "" : line.slice(sp + 1).trim();

  if (verb === "DIR") { dosShell_dir(); return; }
  if (verb === "CLS") { dosShell_cls(); return; }
  if (verb === "VER") {
    dosKernel_printStr("SoftDOS 6.22  [x86 emulator on zipp]\r\n");
    return;
  }
  if (verb === "ECHO") { dosKernel_printStr(rest + "\r\n"); return; }
  if (verb === "MEM") { dosShell_mem(); return; }
  if (verb === "HELP" || verb === "?") { dosShell_help(); return; }
  if (verb === "TYPE") { dosShell_type(rest); return; }
  if (verb === "EXIT") { dosKernel_printStr("Nothing to exit to. This is the whole machine.\r\n"); return; }
  if (verb === "CD" || verb === "CHDIR") { dosKernel_printStr("C:\\\r\n"); return; }
  if (verb === "TIME") {
    let secs = Math.floor(DOS_TOTAL_CYCLES / 4770000);
    dosKernel_printStr("Machine has been up " + secs + " s of emulated 4.77 MHz time.\r\n");
    return;
  }

  // Anything else: look for a program of that name on the virtual drive.
  let name = verb;
  if (name.indexOf(".") < 0) {
    if (dosKernel_vfsFind(name + ".COM") >= 0) name = name + ".COM";
    else if (dosKernel_vfsFind(name + ".EXE") >= 0) name = name + ".EXE";
  }
  let idx = dosKernel_vfsFind(name);
  if (idx >= 0) {
    dosShell_run(name, idx);
    return;
  }

  dosKernel_printStr("Bad command or file name\r\n");
}

function dosShell_dir() {
  dosKernel_printStr(" Volume in drive C is SOFTDOS\r\n");
  dosKernel_printStr(" Directory of C:\\\r\n\r\n");
  let total = 0;
  let files = 0;
  for (let i = 0; i < DOS_VFS_COUNT; i++) {
    let full = DOS_VFS_NAMES[i];
    if (full === "") continue;
    let data = DOS_VFS_DATA[i];
    let size = data ? data.length : 0;
    total += size;
    files++;
    // 8.3 columns, the way DIR lays them out.
    let dot = full.lastIndexOf(".");
    let base = (dot < 0) ? full : full.slice(0, dot);
    let ext = (dot < 0) ? "" : full.slice(dot + 1);
    let line = dosShell_pad(base, 8) + " " + dosShell_pad(ext, 3) + " ";
    line += dosShell_padLeft(dosShell_commas(size), 12) + "  09-04-26   1:00p\r\n";
    dosKernel_printStr(line);
  }
  dosKernel_printStr(dosShell_padLeft(String(files), 9) + " file(s) " + dosShell_padLeft(dosShell_commas(total), 14) + " bytes\r\n");
  dosKernel_printStr(dosShell_padLeft(dosShell_commas(655360 - total), 24) + " bytes free\r\n");
}

function dosShell_pad(s, n) {
  let out = s;
  while (out.length < n) out += " ";
  return out.slice(0, n);
}
function dosShell_padLeft(s, n) {
  let out = s;
  while (out.length < n) out = " " + out;
  return out;
}
function dosShell_commas(n) {
  let s = String(n);
  let out = "";
  let c = 0;
  for (let i = s.length - 1; i >= 0; i--) {
    out = s.charAt(i) + out;
    c++;
    if (c % 3 === 0 && i > 0) out = "," + out;
  }
  return out;
}

function dosShell_cls() {
  let textBase = 0xB8000;
  for (let i = 0; i < 2000; i++) {
    DOS_RAM[textBase + (i * 2)] = 32;
    DOS_RAM[textBase + (i * 2) + 1] = 0x07;
  }
  DOS_CURSOR_COL = 0;
  DOS_CURSOR_ROW = 0;
}

function dosShell_mem() {
  dosKernel_printStr("\r\n  Memory Type          Total       Used       Free\r\n");
  dosKernel_printStr("  ----------------  --------   --------   --------\r\n");
  dosKernel_printStr("  Conventional          640K        42K       598K\r\n");
  dosKernel_printStr("  Extended (XMS)      15,744K         0K    15,744K\r\n");
  dosKernel_printStr("  ----------------  --------   --------   --------\r\n");
  dosKernel_printStr("  Total memory       16,384K        42K    16,342K\r\n\r\n");
  dosKernel_printStr("  Largest executable program size        598K\r\n");
  dosKernel_printStr("  SoftDOS is resident in the high memory area.\r\n");
}

function dosShell_help() {
  dosKernel_printStr("\r\nSoftDOS built-in commands:\r\n\r\n");
  dosKernel_printStr("  DIR              List the virtual drive\r\n");
  dosKernel_printStr("  CLS              Clear the screen\r\n");
  dosKernel_printStr("  VER              Show the version\r\n");
  dosKernel_printStr("  MEM              Show memory use\r\n");
  dosKernel_printStr("  TYPE <file>      Print a file\r\n");
  dosKernel_printStr("  ECHO <text>      Print text\r\n");
  dosKernel_printStr("  TIME             Emulated uptime\r\n\r\n");
  dosKernel_printStr("Type the name of a program to run it. The ones on drive C\r\n");
  dosKernel_printStr("are real 8086 machine code and run on the emulated CPU.\r\n");
  dosKernel_printStr("Drop a .COM or .EXE on the panel below to add your own.\r\n");
  dosKernel_printStr("Press Esc while a program runs to return here.\r\n");
}

function dosShell_type(name) {
  if (name === "") { dosKernel_printStr("Required parameter missing\r\n"); return; }
  let idx = dosKernel_vfsFind(name.toUpperCase());
  if (idx < 0) { dosKernel_printStr("File not found - " + name.toUpperCase() + "\r\n"); return; }
  let data = DOS_VFS_DATA[idx];
  let n = Math.min(data.length, 2048);
  let out = "";
  for (let i = 0; i < n; i++) {
    let c = data[i];
    if (c === 13 || c === 10 || (c >= 32 && c < 127)) out += String.fromCharCode(c);
    else out += ".";
  }
  dosKernel_printStr(out + "\r\n");
  if (data.length > n) dosKernel_printStr("[... " + (data.length - n) + " more bytes]\r\n");
}

// Hand a program on the virtual drive to the loader and let the CPU have it.
function dosShell_run(name, idx) {
  let bytes = DOS_VFS_DATA[idx];
  if (!bytes || bytes.length === 0) { dosKernel_printStr("Invalid executable\r\n"); return; }
  DOS_SHELL_ACTIVE = 0;
  DOS_CURSOR_VISIBLE = 0;
  // The loader resets the machine, so the drive contents are re-seeded after.
  let keepNames = DOS_VFS_NAMES;
  let keepData = DOS_VFS_DATA;
  let keepCount = DOS_VFS_COUNT;
  if (name.endsWith(".COM")) dosLoader_loadCom(bytes);
  else dosLoader_loadExe(bytes);
  DOS_VFS_NAMES = keepNames;
  DOS_VFS_DATA = keepData;
  DOS_VFS_COUNT = keepCount;
  activeMode = "custom";
  loadedFileName = name;
  runFrames = 0;
  DOS_INT_COUNT = 0;
  statusText = "Running " + name;
}

// A program has stopped (HLT, INT 20h, INT 21h/4Ch) or been interrupted:
// put the shell back up with the screen it had.
function dosShell_returnToPrompt(note) {
  activeMode = "prompt";
  runFrames = 0;
  DOS_VIDEO_MODE = 0x03;
  DOS_HALTED = 0;
  DOS_SHELL_ACTIVE = 1;
  DOS_CURSOR_VISIBLE = 1;
  DOS_SHELL_LINE = "";
  statusText = "MS-DOS 6.22 Ready";
  if (note && note !== "") dosKernel_printStr("\r\n" + note + "\r\n");
  dosShell_prompt();
}
