    colorTables();
    out = new Uint8Array(outW * outH * 4);
    let comps = frame.comps, count = comps.length;
    let samplers = [];
    for (let i = 0; i < count; i++) samplers.push(makeSampler(comps[i]));
    let rows = [];
    for (let i = 0; i < count; i++) rows.push(new Int32Array(outW));
    let transform = count === 3 ? (adobe === 0 ? false : true) : count === 4 ? (adobe === 2) : false;
    if (count === 3 && adobe === -1 && !jfif && comps[0].id === 82 && comps[1].id === 71 && comps[2].id === 66) transform = false; // 'R','G','B'
    colorState = psRowStepper(outH, psRowsFor(outW, PS_JPEG_COLOR_PIXELS), function (y0, y1) {
      let o = out, W = outW;
      let crR = PS_CR_R, cbB = PS_CB_B, crG = PS_CR_G, cbG = PS_CB_G;
      for (let y = y0; y < y1; y++) {
        let p = y * W * 4;
        for (let i = 0; i < count; i++) sampleRow(samplers[i], y, rows[i]);
        let r0 = rows[0];
        if (count === 1) {
          for (let x = 0; x < W; x++) { let v = r0[x]; o[p] = v; o[p + 1] = v; o[p + 2] = v; o[p + 3] = 255; p += 4; }
          continue;
        }
        let r1 = rows[1], r2 = rows[2];
        if (count === 3) {
          for (let x = 0; x < W; x++) {
            let Y = r0[x], Cb = r1[x], Cr = r2[x];
            if (transform) {
              let r = Y + crR[Cr], g = Y + ((crG[Cr] + cbG[Cb]) >> 16), bl = Y + cbB[Cb];
              o[p] = r < 0 ? 0 : r > 255 ? 255 : r; o[p + 1] = g < 0 ? 0 : g > 255 ? 255 : g; o[p + 2] = bl < 0 ? 0 : bl > 255 ? 255 : bl;
            } else { o[p] = Y; o[p + 1] = Cb; o[p + 2] = Cr; }
            o[p + 3] = 255; p += 4;
          }
        } else {
          let r3 = rows[3];
          for (let x = 0; x < W; x++) {
            let C = r0[x], M = r1[x], Yc = r2[x], K = r3[x];
            if (transform) {
              let r = C + crR[Yc], g = C + ((crG[Yc] + cbG[M]) >> 16), bl = C + cbB[M];
              C = r < 0 ? 0 : r > 255 ? 255 : r; M = g < 0 ? 0 : g > 255 ? 255 : g; Yc = bl < 0 ? 0 : bl > 255 ? 255 : bl;
            }
