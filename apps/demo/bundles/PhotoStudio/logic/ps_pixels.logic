// Blend `blurred` into `target` by the selection weights (target = original) over rows.
function psMixRows(target, blurred, w, y0, y1, selection, ch) {
  for (let p = y0 * w, end = y1 * w; p < end; p++) {
    let wgt = selection ? selection[p] : 255;
    if (wgt === 0) continue;
