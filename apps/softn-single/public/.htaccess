Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # The same cross-origin isolation softn.com sends for this shell: it gives
  # the page SharedArrayBuffer, which the CPU language-model provider uses
  # to run on every core instead of one. credentialless rather than
  # require-corp, so images and model files from other origins keep working
  # without CORP headers. An app must behave the same here as on the site.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "credentialless"
  # Only this site may frame the app: the page shows the permission bar and
  # its Allow button, and another site that framed it could cover the bar
  # with a look-alike and take the visitor's click as a grant. To embed the
  # app on another site, list that origin after 'self' (and remove
  # X-Frame-Options).
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(softn|json)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
AddType application/wasm .wasm
AddType application/javascript .mjs
