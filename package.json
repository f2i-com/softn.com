{
  "name": "softn",
  "version": "0.0.14",
  "private": true,
  "description": "SoftN UI Language and Engine",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/@softn/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build -w @softn/core && npm run build -w @softn/components && npm run build -w @softn/vite-plugin",
    "build:apps": "npm run build --workspace=apps --if-present",
    "build:core": "npm run build -w @softn/core",
    "build:components": "npm run build -w @softn/components",
    "build:site": "node scripts/build-site.mjs",
    "docs:validate": "node docs/scripts/validate.mjs",
    "docs:build": "node docs/scripts/build-docs.mjs",
    "docs:test": "node --test docs/tests/*.test.mjs",
    "docs:preview": "node docs/scripts/build-docs.mjs && node docs/scripts/serve.mjs",
    "apps:fetch": "node scripts/softn-apps/fetch.mjs",
    "apps:screenshot": "node scripts/softn-apps/screenshot.mjs",
    "apps:publish": "node scripts/softn-apps/publish.mjs",
    "apps:build": "node scripts/softn-apps/build.mjs",
    "apps:seed": "node scripts/softn-apps/seed.mjs",
    "package:site": "node scripts/package-site.mjs",
    "package:docs": "node scripts/package-docs.mjs",
    "build:single": "npm run build:packages && npm run build -w @softn/single",
    "package:single": "node scripts/package-single.mjs",
    "build:single-private": "npm run build:packages && npm run build -w @softn/single-private",
    "build:single-php-serve": "npm run build:single-private",
    "package:single-private": "node scripts/package-single-private.mjs",
    "package:single-php-serve": "npm run package:single-private",
    "package:private-single-php": "node scripts/package-private-single-php.mjs",
    "package:formlogic-runtime": "node scripts/package-formlogic-runtime.mjs",
    "release:explainers": "node scripts/release-explainers.mjs",
    "licenses:site": "node scripts/generate-third-party-notices.mjs",
    "prelicenses:check": "node packages/@softn/core/scripts/fetch-zipp-release.mjs --ensure",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "preview:site": "npm run build:site && node scripts/serve-site.mjs",
    "dev": "node scripts/fetch-demos.mjs && node scripts/dev-all.mjs",
    "dev:site": "npm run dev -w @softn/site",
    "dev:web": "node scripts/fetch-demos.mjs && npm run dev -w @softn/web",
    "dev:builder": "npm run dev -w @softn/builder",
    "dev:studio": "npm run dev -w @softn/studio",
    "dev:desktop": "npm run tauri dev -w @softn/loader",
    "generate:native-icons": "node scripts/generate-native-icons.mjs",
    "dev:desktop:builder": "npm run tauri dev -w @softn/builder",
    "build:desktop": "npm run tauri -w @softn/loader -- build --debug --no-bundle && npm run tauri -w @softn/builder -- build --debug --no-bundle",
    "fetch:demos": "node scripts/fetch-demos.mjs",
    "fetch:zipp": "node packages/@softn/core/scripts/fetch-zipp-release.mjs",
    "screenshot:demos": "node scripts/fetch-demos.mjs && node scripts/screenshot-demos.mjs",
    "bench": "node scripts/bench/measure.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts --project=chromium",
    "e2e:matrix": "playwright test -c e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "e2e:install:matrix": "playwright install chromium firefox webkit",
    "pretest": "node scripts/fetch-demos.mjs && node packages/@softn/core/scripts/fetch-zipp-release.mjs --ensure",
    "test": "node --test docs/tests/*.test.mjs scripts/fetch-demos.test.mjs scripts/package-site.test.mjs scripts/release-explainers.test.mjs scripts/lib/archive.test.mjs scripts/core-worker-assets.test.mjs scripts/precompress-assets.test.mjs scripts/brand-mark.test.mjs scripts/single-backend-inputs.test.mjs scripts/engine-pin.test.mjs scripts/lib/zipp-engine-copy.test.mjs scripts/lib/zipp-provenance.test.mjs scripts/pwa-engine-cap.test.mjs packages/@softn/core/scripts/fetch-zipp-release.test.mjs scripts/zipp-release-gate.test.mjs scripts/package-formlogic-runtime.test.mjs scripts/host-js-isolation.test.mjs apps/formlogic-host/test/*.test.mjs && npm run test --workspaces --if-present",
    "test:host-js": "npm run test:host-js -w @softn/core",
    "test:desktop": "npm run test:desktop -w @softn/builder",
    "test:dev-cache": "node --test scripts/dev-service-worker.test.mjs",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 100",
    "lint:errors": "eslint . --ext .ts,.tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "pretypecheck": "node packages/@softn/core/scripts/fetch-zipp-release.mjs --ensure",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "package:single:backend": "npm run package:single -- --with-backend"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.88",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "kokoro-js": "1.2.1",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.0-next.5"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "sharp": "^0.35.4",
    "esbuild": "^0.28.1",
    "@huggingface/transformers": {
      "sharp": "^0.35.4",
      "onnxruntime-node": {
        "adm-zip": "^0.6.1"
      }
    }
  }
}
