// dos_state.logic — SoftDOS State Declarations
//
// All mutable emulator state lives in TypedArrays or simple scalar numbers.
// In zipp, plain objects and arrays trigger deep-comparison checks across host calls,
// while TypedArrays marshal to opaque slots and are skipped by state sync.

// ---------------------------------------------------------------------------
// 1. Physical Memory (16 MB flat memory space)
// ---------------------------------------------------------------------------
// 0x00000 - 0x003FF : Interrupt Vector Table (IVT)
// 0x00400 - 0x004FF : BIOS Data Area (BDA)
// 0x00500 - 0x9FFFF : Conventional DOS Memory (~640 KB)
// 0xA0000 - 0xAFFFF : VGA Graphics Memory (64 KB, Mode 13h is 320x200 = 64,000 bytes)
// 0xB8000 - 0xBFFFF : CGA/EGA/VGA Text Mode Memory (80x25 characters + attributes)
// 0x100000+         : Extended Memory (XMS / DPMI 32-bit linear address space)
let DOS_RAM = null;         // Uint8Array(16777216) - 16 MB
let DOS_RAM16 = null;       // Uint16Array view
let DOS_RAM32 = null;       // Uint32Array view

// ---------------------------------------------------------------------------
// 2. CPU Registers
// ---------------------------------------------------------------------------
// 32-bit General Purpose: 0:EAX, 1:ECX, 2:EDX, 3:EBX, 4:ESP, 5:EBP, 6:ESI, 7:EDI
let DOS_REGS32 = null;      // Uint32Array(8)
let DOS_REGS16 = null;      // Uint16Array(16) view (low/high 16-bit)
let DOS_REGS8 = null;       // Uint8Array(32) view (AL, AH, CL, CH, etc.)

// Segment Registers: 0:ES, 1:CS, 2:SS, 3:DS, 4:FS, 5:GS
let DOS_SEGS = null;        // Uint16Array(6)

// Instruction Pointer & Status
let DOS_EIP = 0x0100;
let DOS_EFLAGS = 0x0202;    // IF (Interrupt Flag) enabled by default

// CPU Mode: 0 = 16-bit Real Mode (8086), 1 = 32-bit Flat Protected Mode (80386+)
let DOS_IS_32 = 0;
let DOS_HALTED = 0;
let DOS_TOTAL_CYCLES = 0;

// Lazy Flag Evaluation state
// LAZY_OP: 0=none, 1=ADD, 2=SUB, 3=AND, 4=OR, 5=XOR, 6=INC, 7=DEC, 8=SHL, 9=SHR
let DOS_LAZY_OP = 0;
let DOS_LAZY_RES = 0;
let DOS_LAZY_SRC = 0;
let DOS_LAZY_DST = 0;
let DOS_LAZY_SIZE = 4;      // 1 = byte, 2 = word, 4 = dword

// ---------------------------------------------------------------------------
// 3. VGA & Display
// ---------------------------------------------------------------------------
let DOS_VIDEO_MODE = 0x13;  // 0x13 = 320x200 256 colors, 0x03 = 80x25 text
let DOS_VGA_PAL = null;     // Uint8Array(768) - 256 colors * 3 (RGB)
let DOS_FB = null;          // Uint8Array(64000) - 320x200 Mode 13h output
let DOS_FB_TEXT = null;     // Uint8Array(256000) - 640x400 text mode output
let DOS_VGA_FRAME = 0;      // frame counter, drives the cursor and text blink
let DOS_VGA_PAL_REV = 1;
let DOS_VGA_DAC_INDEX = 0;
let DOS_VGA_DAC_STATE = 0;  // 0=R, 1=G, 2=B cycle
let DOS_VGA_DAC_READ_INDEX = 0;
let DOS_VGA_DAC_READ_STATE = 0;

// ---------------------------------------------------------------------------
// 4. Timer, PIC & Audio
// ---------------------------------------------------------------------------
let DOS_PIT_COUNTER = 0;
let DOS_PIT_RELOAD = 65535;
let DOS_SPEAKER_ON = 0;
let DOS_SPEAKER_FREQ = 440;
let DOS_AUDIO_PHASE = 0;

// ---------------------------------------------------------------------------
// 5. Keyboard Ring Buffer
// ---------------------------------------------------------------------------
let DOS_KEY_BUFFER = null;  // Uint16Array(32): (scancode << 8) | ascii
let DOS_KEY_LAST_SCAN = 0;  // last raw scancode, for port 0x60 polling
let DOS_KEY_HEAD = 0;
let DOS_KEY_TAIL = 0;

// ---------------------------------------------------------------------------
// 6. Virtual Filesystem (VFS) Allocation
// ---------------------------------------------------------------------------
// Stores up to 16 virtual files (names, offsets, sizes, buffers)
let DOS_VFS_NAMES = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""];
let DOS_VFS_DATA = [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null];
let DOS_VFS_COUNT = 0;

// File Handles: index -> { vfsIdx, pos }
let DOS_HANDLE_VFS = null;  // Int32Array(32)
let DOS_HANDLE_POS = null;  // Uint32Array(32)

// DPMI Extended Memory Allocator Top
let DOS_DPMI_MEM_TOP = 0x200000; // Starts at 2MB linear
// Conventional memory, handed out by INT 31h AX=0100h. Starts above the IVT,
// the BIOS data area and the shell's own workspace; stops below the EBDA.
let DOS_DOSMEM_TOP = 0x10000;
let DOS_DOSMEM_LIMIT = 0x9FC00;

function dosState_init() {
  if (!DOS_RAM) {
    DOS_RAM = new Uint8Array(16777216); // 16 MB
    DOS_RAM16 = new Uint16Array(DOS_RAM.buffer);
    DOS_RAM32 = new Uint32Array(DOS_RAM.buffer);

    DOS_REGS32 = new Uint32Array(8);
    DOS_REGS16 = new Uint16Array(DOS_REGS32.buffer);
    DOS_REGS8 = new Uint8Array(DOS_REGS32.buffer);

    DOS_SEGS = new Uint16Array(6);
    DOS_VGA_PAL = new Uint8Array(768);
    DOS_FB = new Uint8Array(64000);
    DOS_FB_TEXT = new Uint8Array(256000);

    DOS_KEY_BUFFER = new Uint16Array(32);
    DOS_HANDLE_VFS = new Int32Array(32);
    DOS_HANDLE_POS = new Uint32Array(32);

    for (let h = 0; h < 32; h++) {
      DOS_HANDLE_VFS[h] = -1;
      DOS_HANDLE_POS[h] = 0;
    }
  }
}

function dosState_reset() {
  dosState_init();

  // Zero RAM & registers
  DOS_RAM.fill(0);
  DOS_REGS32.fill(0);
  DOS_SEGS.fill(0);

  DOS_EIP = 0x0100;
  DOS_EFLAGS = 0x0202;
  DOS_IS_32 = 0;
  DOS_HALTED = 0;
  DOS_TOTAL_CYCLES = 0;

  DOS_LAZY_OP = 0;
  DOS_LAZY_RES = 0;
  DOS_LAZY_SRC = 0;
  DOS_LAZY_DST = 0;

  DOS_VIDEO_MODE = 0x13;
  DOS_VGA_PAL_REV = 1;
  DOS_VGA_DAC_INDEX = 0;
  DOS_VGA_DAC_STATE = 0;

  DOS_PIT_COUNTER = 0;
  DOS_PIT_RELOAD = 65535;
  DOS_SPEAKER_ON = 0;
  DOS_SPEAKER_FREQ = 440;
  DOS_AUDIO_PHASE = 0;

  DOS_KEY_HEAD = 0;
  DOS_KEY_TAIL = 0;
  DOS_DPMI_MEM_TOP = 0x200000;
  DOS_DOSMEM_TOP = 0x10000;
  DOS_CURSOR_COL = 0;
  DOS_CURSOR_ROW = 0;
  DOS_CURSOR_VISIBLE = 1;
  DOS_VGA_FRAME = 0;
  DOS_LAST_ILLEGAL = -1;
  DOS_ILLEGAL_COUNT = 0;
  // Loading a program writes new code at the addresses the last one used, so
  // the decoded blocks cached against those addresses must go.
  dosBc_flush();
  dosInt_reset();
  dosVga_planarReset();

  for (let h = 0; h < 32; h++) {
    DOS_HANDLE_VFS[h] = -1;
    DOS_HANDLE_POS[h] = 0;
  }
}
