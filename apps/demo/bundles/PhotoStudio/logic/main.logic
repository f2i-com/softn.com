  dodge: '<circle cx="14" cy="9" r="6"/><path d="m10 14-7 8"/>',
  burn: '<path d="M5 19c-3-9 0-9 2-4V5c0-3 3-3 3 0v7-8c0-3 3-3 3 0v8-6c0-3 3-3 3 0v7-4c0-2 3-2 3 0v7l-3 6H8Z"/>',
  sponge: '<path d="m4 6 13-3 5 12-15 6-5-8Z"/><path d="M7 10h1M15 8h1M10 16h1M17 14h1" stroke-width="3"/>',
