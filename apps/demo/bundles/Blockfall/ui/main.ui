<logic src="../logic/main.logic" />

<style>
.bf-root { min-height: 100%; background: radial-gradient(120% 80% at 50% 0%, #1b2140 0%, #0f1222 55%, #090b14 100%); font-family: "Segoe UI", system-ui, sans-serif; color: #e6e9f4; padding: 22px 16px 36px; user-select: none; }
.bf-wrap { max-width: 640px; margin: 0 auto; }
.bf-title { text-align: center; margin-bottom: 14px; }
.bf-play { display: flex; justify-content: center; align-items: flex-start; gap: 16px; }
.bf-side { display: flex; flex-direction: column; gap: 12px; width: 120px; }
.bf-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 10px 12px; }
.bf-well { border-radius: 10px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.08); }
.bf-kbd { display: inline-block; padding: 1px 6px; border-radius: 5px; background: rgba(255,255,255,0.1); font-family: ui-monospace, monospace; font-size: 11px; }
.bf-touch { display: flex; justify-content: center; align-items: center; gap: 18px; margin-top: 18px; flex-wrap: wrap; }
@media (max-width: 560px) { .bf-side { width: 84px; } .bf-root { padding: 12px 8px 24px; } }
</style>

<Box className="bf-root">
  <Loop interval={33} running={running && !paused} @tick={gameStep} />
  <Box className="bf-wrap">
    <Box className="bf-title">
      <Text style={{ display: "block", fontSize: "40px", fontWeight: 900, letterSpacing: "0.12em", lineHeight: 1, color: "#ffffff", textShadow: "0 0 30px rgba(34,211,238,0.35)" }}>BLOCKFALL</Text>
      <Text style={{ display: "block", fontSize: "13px", color: "#8b93b3", marginTop: "6px" }}>Seven shapes, one well, no mercy past level ten.</Text>
    </Box>

    <Box className="bf-play">
      <Box className="bf-side">
        <Box className="bf-card">
          <Text style={{ display: "block", fontSize: "10px", letterSpacing: "0.16em", color: "#8b93b3" }}>HOLD</Text>
          <Box style={{ marginTop: "6px" }}>
            <PixelGrid rows={2} cols={4} cellSize={18} items={holdItems} background="rgba(0,0,0,0.25)" />
          </Box>
        </Box>
        <Box className="bf-card">
          <Text style={{ display: "block", fontSize: "10px", letterSpacing: "0.16em", color: "#8b93b3" }}>SCORE</Text>
          <Text style={{ display: "block", fontSize: "22px", fontWeight: 800, color: "#ffffff" }}>{score}</Text>
          <Text style={{ display: "block", fontSize: "11px", color: "#8b93b3", marginTop: "6px" }}>{"best " + best}</Text>
        </Box>
        <Box className="bf-card">
          <Text style={{ display: "block", fontSize: "10px", letterSpacing: "0.16em", color: "#8b93b3" }}>LEVEL</Text>
          <Text style={{ display: "block", fontSize: "22px", fontWeight: 800, color: "#22d3ee" }}>{level}</Text>
          <Text style={{ display: "block", fontSize: "11px", color: "#8b93b3", marginTop: "6px" }}>{lines + " lines"}</Text>
        </Box>
      </Box>

      <Box className="bf-well">
        <PixelGrid rows={20} cols={10} cellSize={24} items={gridItems} overlay={overlayText} background="#0b0e1a" />
      </Box>

      <Box className="bf-side">
        <Box className="bf-card">
          <Text style={{ display: "block", fontSize: "10px", letterSpacing: "0.16em", color: "#8b93b3" }}>NEXT</Text>
          <Box style={{ marginTop: "6px" }}>
            <PixelGrid rows={9} cols={4} cellSize={18} items={nextItems} background="rgba(0,0,0,0.25)" />
          </Box>
        </Box>
        <Button variant="ghost" style={{ padding: "10px 12px", borderRadius: "10px", background: "#22d3ee", color: "#08111a", fontWeight: 800, fontSize: "13px", width: "100%" }} @click={startGame}>{over ? "Again" : (running ? "Restart" : "Start")}</Button>
        <Button if={running && !over} variant="ghost" style={{ padding: "8px 12px", borderRadius: "10px", background: "rgba(255,255,255,0.08)", color: "#fff", fontSize: "13px", width: "100%" }} @click={togglePause}>{paused ? "Resume" : "Pause"}</Button>
      </Box>
    </Box>

    <Text style={{ display: "block", textAlign: "center", marginTop: "14px", fontSize: "12px", color: "#8b93b3" }}>
      <Text className="bf-kbd" style={{ fontSize: "11px", color: "#fff" }}>← →</Text> move · <Text className="bf-kbd" style={{ fontSize: "11px", color: "#fff" }}>↑</Text> rotate · <Text className="bf-kbd" style={{ fontSize: "11px", color: "#fff" }}>Z</Text> rotate back · <Text className="bf-kbd" style={{ fontSize: "11px", color: "#fff" }}>↓</Text> soft drop · <Text className="bf-kbd" style={{ fontSize: "11px", color: "#fff" }}>Space</Text> hard drop · <Text className="bf-kbd" style={{ fontSize: "11px", color: "#fff" }}>C</Text> hold · <Text className="bf-kbd" style={{ fontSize: "11px", color: "#fff" }}>P</Text> pause
    </Text>

    <Box className="bf-touch">
      <DPad @press={padPress} @release={padRelease} />
      <Stack direction="vertical" gap={8}>
        <Button variant="ghost" style={{ width: "76px", height: "44px", borderRadius: "10px", background: "rgba(255,255,255,0.08)", color: "#fff", fontSize: "12px", fontWeight: 700 }} @click={touchRotate}>Rotate</Button>
        <Button variant="ghost" style={{ width: "76px", height: "44px", borderRadius: "10px", background: "rgba(255,255,255,0.08)", color: "#fff", fontSize: "12px", fontWeight: 700 }} @click={touchHard}>Drop</Button>
        <Button variant="ghost" style={{ width: "76px", height: "44px", borderRadius: "10px", background: "rgba(255,255,255,0.08)", color: "#fff", fontSize: "12px", fontWeight: 700 }} @click={touchHold}>Hold</Button>
      </Stack>
    </Box>
  </Box>
</Box>
