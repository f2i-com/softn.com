Options -Indexes -MultiViews
DirectoryIndex index.php
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
# The library is included by index.php; it is not an entry point.
<FilesMatch "^softn-serve\.php$">
    Require all denied
</FilesMatch>
# Nothing of the private directory belongs here, and if it is copied here by
# mistake it must still not be downloadable.
<FilesMatch "\.(softn|key|cache)$">
    Require all denied
</FilesMatch>
AddType application/wasm .wasm
AddType text/javascript .mjs
# The optional backend: /api/... is answered by api.php once backend/ is set
# up, and the Authorization header reaches PHP under CGI and FastCGI. Inside
# IfModule: without mod_rewrite the backend has no routes, but the
# application itself, which needs none, still loads instead of every request
# answering 500.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^api(?:/.*)?$ api.php [END]
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # The same cross-origin isolation softn.com sends for this shell.
    # credentialless rather than require-corp, so images and model files from
    # other origins keep working without CORP headers. An app must behave the
    # same here as on the site. index.php sends these itself, for a host that
    # reads no .htaccess, so its copies go first: a browser ignores a policy
    # that arrives twice, and "always" does not replace what PHP sent.
    Header unset Cross-Origin-Opener-Policy
    Header unset Cross-Origin-Embedder-Policy
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "credentialless"
    # The service worker may control the whole directory and must never be stale.
    <FilesMatch "^sw\.js$">
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
