<logic src="../logic/main.logic" />

<style>
.sn-root { min-height: 100%; background: radial-gradient(120% 80% at 50% 0%, #18183c 0%, #0f0f23 55%, #09091a 100%); color: #e4e4e7; font-family: ui-monospace, "Cascadia Mono", Menlo, Consolas, monospace; padding: 22px 16px 36px; user-select: none; }
.sn-wrap { max-width: 400px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 14px; }
.sn-stats { display: flex; gap: 10px; width: 100%; }
.sn-stat { flex: 1; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 8px 10px; text-align: center; }
.sn-board { border-radius: 10px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.08); transition: box-shadow 200ms ease; }
.sn-board-dead { box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 0 2px rgba(239,68,68,0.7); }
.sn-board-best { box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 0 2px rgba(250,204,21,0.8); }
.sn-actions { display: flex; gap: 8px; align-items: center; justify-content: center; flex-wrap: wrap; }
.sn-kbd { display: inline-block; padding: 1px 6px; border-radius: 5px; background: rgba(255,255,255,0.1); font-size: 11px; }
.sn-top { width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 12px 14px; }
.sn-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 4px 6px; border-radius: 6px; }
.sn-row-mine { background: rgba(74,222,128,0.14); }
.sn-row-head { border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 6px; margin-bottom: 4px; }
@media (max-width: 400px) { .sn-board { zoom: 0.8; } .sn-root { padding: 14px 10px 24px; } }
</style>

<Box className="sn-root">
  // The game loop runs only while a game is in progress; the slow idle loop
  // just picks up "start" and "pause" from the keyboard and the pad between games.
  <Loop interval={speed} running={running} @tick={snakeStep} />
  <Loop interval={100} running={!running} @tick={idleStep} />
  <Box className="sn-wrap">
    <Box style={{ textAlign: "center" }}>
      <Text style={{ display: "block", fontSize: "34px", fontWeight: 800, letterSpacing: "0.18em", lineHeight: 1, color: "#ffffff", textShadow: "0 0 30px rgba(74,222,128,0.35)" }}>SNAKE</Text>
      <Text style={{ display: "block", fontSize: "12px", color: "#8b8ba8", marginTop: "6px" }}>Eat, grow, and keep off the walls. It gets faster.</Text>
    </Box>

    <Box className="sn-stats">
      <Box className="sn-stat">
        <Text style={{ display: "block", fontSize: "10px", letterSpacing: "0.16em", color: "#8b8ba8" }}>SCORE</Text>
        <Text style={{ display: "block", fontSize: "24px", fontWeight: 800, color: "#ffffff" }}>{score}</Text>
      </Box>
      <Box className="sn-stat">
        <Text style={{ display: "block", fontSize: "10px", letterSpacing: "0.16em", color: "#8b8ba8" }}>BEST</Text>
        <Text style={{ display: "block", fontSize: "24px", fontWeight: 800, color: "#facc15" }}>{highScore}</Text>
      </Box>
      <Box className="sn-stat">
        <Text style={{ display: "block", fontSize: "10px", letterSpacing: "0.16em", color: "#8b8ba8" }}>LENGTH</Text>
        <Text style={{ display: "block", fontSize: "24px", fontWeight: 800, color: "#4ade80" }}>{snakeLength}</Text>
      </Box>
    </Box>

    <Box className={gameOver ? (newBest ? "sn-board sn-board-best" : "sn-board sn-board-dead") : "sn-board"}>
      <PixelGrid rows={20} cols={20} cellSize={18} items={gridItems} overlay={overlayText} background="#131a33" overlayStyle={{ fontFamily: "inherit", fontSize: "15px", letterSpacing: "0.06em", background: "rgba(9,9,26,0.55)" }} />
    </Box>

    <Box className="sn-actions">
      <Button variant="ghost" style={{ padding: "10px 26px", borderRadius: "10px", background: "#4ade80", color: "#052e16", fontWeight: 800, fontSize: "14px", letterSpacing: "0.04em" }} @click={startGame}>{gameOver ? "Play again" : (running || paused ? "Restart" : "Start")}</Button>
      <Button if={running || paused} variant="ghost" style={{ padding: "10px 18px", borderRadius: "10px", background: "rgba(255,255,255,0.08)", color: "#fff", fontSize: "14px" }} @click={togglePause}>{paused ? "Resume" : "Pause"}</Button>
      <Button variant="ghost" ariaLabel={muted ? "Turn sound on" : "Turn sound off"} title={muted ? "Sound is off" : "Sound is on"} style={{ padding: "10px 12px", borderRadius: "10px", background: "rgba(255,255,255,0.08)", color: muted ? "#8b8ba8" : "#fff", fontSize: "13px" }} @click={toggleMute}>{muted ? "Sound off" : "Sound on"}</Button>
    </Box>

    <Text style={{ display: "block", textAlign: "center", fontSize: "12px", color: "#8b8ba8" }}>
      <Text className="sn-kbd" style={{ fontSize: "11px", color: "#fff" }}>← ↑ → ↓</Text> or WASD · <Text className="sn-kbd" style={{ fontSize: "11px", color: "#fff" }}>Space</Text> start or pause · <Text className="sn-kbd" style={{ fontSize: "11px", color: "#fff" }}>P</Text> pause · <Text className="sn-kbd" style={{ fontSize: "11px", color: "#fff" }}>M</Text> sound
    </Text>

    <DPad @press={handleDPad} @release={handleDPadRelease} />

    // The top ten, shared by everyone who plays this app from softn.com. Scores
    // go to the app's own storage on the server the moment a game ends.
    <Box className="sn-top">
      <Stack direction=horizontal gap=sm align=center style={{ justifyContent: "space-between" }}>
        <Text style={{ fontSize: "12px", letterSpacing: "0.16em", color: "#ffffff", fontWeight: 700 }}>TOP TEN</Text>
        <Text style={{ fontSize: "11px", color: "#8b8ba8" }}>Shared by everyone on this site</Text>
      </Stack>
      <Stack direction=horizontal gap=sm align=center style={{ marginTop: "10px" }}>
        <Text style={{ fontSize: "11px", color: "#8b8ba8", whiteSpace: "nowrap" }}>Play as</Text>
        <Input value={playerName} @change={setPlayerName} placeholder="Anonymous" maxLength={24} style={{ fontFamily: "inherit", fontSize: "13px", flex: 1 }} />
      </Stack>
      <Text if={boardStatus !== ""} style={{ display: "block", color: "#8b8ba8", fontSize: "12px", marginTop: "10px" }}>{boardStatus}</Text>
      <Box if={leaderboard.length > 0} style={{ marginTop: "10px" }}>
        <Box className="sn-row sn-row-head">
          <Text style={{ fontSize: "10px", letterSpacing: "0.14em", color: "#8b8ba8" }}>#  PLAYER</Text>
          <Text style={{ fontSize: "10px", letterSpacing: "0.14em", color: "#8b8ba8" }}>SCORE</Text>
        </Box>
        #each (row in leaderboard)
          <Box className={row.mine ? "sn-row sn-row-mine" : "sn-row"}>
            <Text style={{ fontSize: "13px", color: row.mine ? "#ffffff" : "#c4c4d4" }}>{row.rank + ".  " + row.name}</Text>
            <Text style={{ fontSize: "13px", fontWeight: 700, color: row.rank === 1 ? "#facc15" : "#4ade80" }}>{row.score}</Text>
          </Box>
        #end
      </Box>
    </Box>
  </Box>
</Box>
