// ChartsPage.ui - Demonstrates all chart types

<Stack direction=vertical gap=lg if={currentPage === "charts"}>
  <Stack direction=vertical gap=xs>
    <Heading level={2} style={{ color: getTextColor(), fontSize: "1.5rem" }}>Charts</Heading>
    <Box style={{ display: "flex", flexWrap: "wrap", gap: "0 0.3rem" }}>
      <Text style={{ color: getMutedColor(), fontSize: "0.875rem" }}>Every chart, animation and interactive component the runtime ships.</Text>
      <Text className="softn-mobile-hide" style={{ color: getMutedColor(), fontSize: "0.875rem" }}>Pick a page on the left.</Text>
      <Text className="softn-mobile-only" style={{ color: getMutedColor(), fontSize: "0.875rem" }}>Pick a page from the tabs above.</Text>
    </Box>
  </Stack>

  // LineChart — full width, multi-series with 12 data points. Wide charts sit
  // in a scroll box with a floor on their width, so a phone scrolls them
  // sideways instead of shrinking the labels to nothing.
  <Card padding=lg style={{ background: getCardBg(), border: "1px solid " + getBorderColor(), borderRadius: "14px" }}>
    <Stack direction=vertical gap=md>
      <Stack direction=vertical gap=xs>
        <Text fontWeight=medium style={{ color: getTextColor() }}>Revenue against expenses</Text>
        <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "baseline", gap: "0.5rem" }}>
          <Text style={{ color: getMutedColor(), fontSize: "0.7rem", fontFamily: "ui-monospace, Menlo, Consolas, monospace" }}>LineChart</Text>
          <Text size=xs style={{ color: getMutedColor() }}>Smooth curves with crosshair tooltips — twelve months, three series</Text>
        </Box>
      </Stack>
      <Box style={{ overflowX: "auto", minWidth: 0 }}>
        <Box style={{ minWidth: "560px" }}>
          <LineChart
            width={800}
            height={340}
            interactive={true}
            series={[
              {
                name: "Revenue",
                color: "#6366f1",
                smooth: true,
                fill: true,
                fillOpacity: 0.06,
                data: [
                  { x: "Jan", y: 4200 },
                  { x: "Feb", y: 5100 },
                  { x: "Mar", y: 4800 },
                  { x: "Apr", y: 6300 },
                  { x: "May", y: 5900 },
                  { x: "Jun", y: 7200 },
                  { x: "Jul", y: 6800 },
                  { x: "Aug", y: 7500 },
                  { x: "Sep", y: 8100 },
                  { x: "Oct", y: 7900 },
                  { x: "Nov", y: 8600 },
                  { x: "Dec", y: 9200 }
                ]
              },
              {
                name: "Expenses",
                color: "#ef4444",
                smooth: true,
                data: [
                  { x: "Jan", y: 2800 },
                  { x: "Feb", y: 3200 },
                  { x: "Mar", y: 2900 },
                  { x: "Apr", y: 3500 },
                  { x: "May", y: 3100 },
                  { x: "Jun", y: 3800 },
                  { x: "Jul", y: 3600 },
                  { x: "Aug", y: 4000 },
                  { x: "Sep", y: 3700 },
                  { x: "Oct", y: 4200 },
                  { x: "Nov", y: 3900 },
                  { x: "Dec", y: 4500 }
                ]
              },
              {
                name: "Profit",
                color: "#10b981",
                smooth: true,
                strokeWidth: 1.5,
                dotSize: 2.5,
                data: [
                  { x: "Jan", y: 1400 },
                  { x: "Feb", y: 1900 },
                  { x: "Mar", y: 1900 },
                  { x: "Apr", y: 2800 },
                  { x: "May", y: 2800 },
                  { x: "Jun", y: 3400 },
                  { x: "Jul", y: 3200 },
                  { x: "Aug", y: 3500 },
                  { x: "Sep", y: 4400 },
                  { x: "Oct", y: 3700 },
                  { x: "Nov", y: 4700 },
                  { x: "Dec", y: 4700 }
                ]
              }
            ]}
          />
        </Box>
      </Box>
    </Stack>
  </Card>

  // AreaChart with gradient — full width
  <Card padding=lg style={{ background: getCardBg(), border: "1px solid " + getBorderColor(), borderRadius: "14px" }}>
    <Stack direction=vertical gap=md>
      <Stack direction=vertical gap=xs>
        <Text fontWeight=medium style={{ color: getTextColor() }}>Weekly traffic</Text>
        <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "baseline", gap: "0.5rem" }}>
          <Text style={{ color: getMutedColor(), fontSize: "0.7rem", fontFamily: "ui-monospace, Menlo, Consolas, monospace" }}>AreaChart · gradient</Text>
          <Text size=xs style={{ color: getMutedColor() }}>Smooth area with a gradient fill and crosshair tooltips</Text>
        </Box>
      </Stack>
      <Box style={{ overflowX: "auto", minWidth: 0 }}>
        <Box style={{ minWidth: "480px" }}>
          <AreaChart
            width={800}
            height={300}
            gradient={true}
            interactive={true}
            series={[
              {
                name: "Users",
                color: "#6366f1",
                data: [
                  { x: "Mon", y: 120 },
                  { x: "Tue", y: 180 },
                  { x: "Wed", y: 150 },
                  { x: "Thu", y: 220 },
                  { x: "Fri", y: 280 },
                  { x: "Sat", y: 190 },
                  { x: "Sun", y: 160 }
                ]
              },
              {
                name: "Sessions",
                color: "#10b981",
                data: [
                  { x: "Mon", y: 200 },
                  { x: "Tue", y: 280 },
                  { x: "Wed", y: 250 },
                  { x: "Thu", y: 340 },
                  { x: "Fri", y: 420 },
                  { x: "Sat", y: 310 },
                  { x: "Sun", y: 240 }
                ]
              }
            ]}
          />
        </Box>
      </Box>
    </Stack>
  </Card>

  // AreaChart stacked — full width
  <Card padding=lg style={{ background: getCardBg(), border: "1px solid " + getBorderColor(), borderRadius: "14px" }}>
    <Stack direction=vertical gap=md>
      <Stack direction=vertical gap=xs>
        <Text fontWeight=medium style={{ color: getTextColor() }}>Where the traffic comes from</Text>
        <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "baseline", gap: "0.5rem" }}>
          <Text style={{ color: getMutedColor(), fontSize: "0.7rem", fontFamily: "ui-monospace, Menlo, Consolas, monospace" }}>AreaChart · stacked</Text>
          <Text size=xs style={{ color: getMutedColor() }}>Stacked areas adding up to the total, six weeks</Text>
        </Box>
      </Stack>
      <Box style={{ overflowX: "auto", minWidth: 0 }}>
        <Box style={{ minWidth: "480px" }}>
          <AreaChart
            width={800}
            height={300}
            stacked={true}
            gradient={true}
            interactive={true}
            series={[
              {
                name: "Organic",
                color: "#6366f1",
                data: [
                  { x: "W1", y: 80 },
                  { x: "W2", y: 95 },
                  { x: "W3", y: 110 },
                  { x: "W4", y: 105 },
                  { x: "W5", y: 120 },
                  { x: "W6", y: 135 }
                ]
              },
              {
                name: "Paid",
                color: "#f59e0b",
                data: [
                  { x: "W1", y: 40 },
                  { x: "W2", y: 55 },
                  { x: "W3", y: 60 },
                  { x: "W4", y: 75 },
                  { x: "W5", y: 80 },
                  { x: "W6", y: 90 }
                ]
              },
              {
                name: "Referral",
                color: "#10b981",
                data: [
                  { x: "W1", y: 20 },
                  { x: "W2", y: 25 },
                  { x: "W3", y: 30 },
                  { x: "W4", y: 35 },
                  { x: "W5", y: 28 },
                  { x: "W6", y: 40 }
                ]
              }
            ]}
          />
        </Box>
      </Box>
    </Stack>
  </Card>

  // Row: BarChart and PieChart side by side
  <Grid columns={{ sm: 1, lg: 2 }} gap=lg>
    // BarChart - stacked
    <Card padding=lg style={{ background: getCardBg(), border: "1px solid " + getBorderColor(), borderRadius: "14px" }}>
      <Stack direction=vertical gap=md>
        <Stack direction=vertical gap=xs>
          <Text fontWeight=medium style={{ color: getTextColor() }}>Sales by device</Text>
          <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "baseline", gap: "0.5rem" }}>
            <Text style={{ color: getMutedColor(), fontSize: "0.7rem", fontFamily: "ui-monospace, Menlo, Consolas, monospace" }}>BarChart · stacked</Text>
            <Text size=xs style={{ color: getMutedColor() }}>One bar per quarter, hover to highlight a segment</Text>
          </Box>
        </Stack>
        <Box style={{ overflowX: "auto", minWidth: 0 }}>
          <Box style={{ minWidth: "360px" }}>
            <BarChart
              width={520}
              height={280}
              interactive={true}
              stacked={true}
              series={[
                {
                  name: "Desktop",
                  color: "#6366f1",
                  data: [
                    { label: "Q1", value: 420 },
                    { label: "Q2", value: 510 },
                    { label: "Q3", value: 480 },
                    { label: "Q4", value: 620 }
                  ]
                },
                {
                  name: "Mobile",
                  color: "#10b981",
                  data: [
                    { label: "Q1", value: 280 },
                    { label: "Q2", value: 350 },
                    { label: "Q3", value: 410 },
                    { label: "Q4", value: 380 }
                  ]
                },
                {
                  name: "Tablet",
                  color: "#f59e0b",
                  data: [
                    { label: "Q1", value: 90 },
                    { label: "Q2", value: 120 },
                    { label: "Q3", value: 110 },
                    { label: "Q4", value: 140 }
                  ]
                }
              ]}
            />
          </Box>
        </Box>
      </Stack>
    </Card>

    // PieChart - donut style
    <Card padding=lg style={{ background: getCardBg(), border: "1px solid " + getBorderColor(), borderRadius: "14px" }}>
      <Stack direction=vertical gap=md>
        <Stack direction=vertical gap=xs>
          <Text fontWeight=medium style={{ color: getTextColor() }}>Where the budget went</Text>
          <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "baseline", gap: "0.5rem" }}>
            <Text style={{ color: getMutedColor(), fontSize: "0.7rem", fontFamily: "ui-monospace, Menlo, Consolas, monospace" }}>PieChart · donut</Text>
            <Text size=xs style={{ color: getMutedColor() }}>Slices pull out on hover</Text>
          </Box>
        </Stack>
        <Box style={{ display: "flex", justifyContent: "center" }}>
          <PieChart
            width={280}
            height={280}
            innerRadius={55}
            interactive={true}
            centerLabel="Budget"
            data={[
              { label: "Engineering", value: 42, color: "#6366f1" },
              { label: "Marketing", value: 28, color: "#10b981" },
              { label: "Operations", value: 18, color: "#ef4444" },
              { label: "Support", value: 8, color: "#f59e0b" },
              { label: "Other", value: 4, color: "#8b5cf6" }
            ]}
          />
        </Box>
      </Stack>
    </Card>
  </Grid>

  // Row: RadarChart and GaugeChart
  <Grid columns={{ sm: 1, lg: 2 }} gap=lg>
    // RadarChart
    <Card padding=lg style={{ background: getCardBg(), border: "1px solid " + getBorderColor(), borderRadius: "14px" }}>
      <Stack direction=vertical gap=md>
        <Stack direction=vertical gap=xs>
          <Text fontWeight=medium style={{ color: getTextColor() }}>Skills profile</Text>
          <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "baseline", gap: "0.5rem" }}>
            <Text style={{ color: getMutedColor(), fontSize: "0.7rem", fontFamily: "ui-monospace, Menlo, Consolas, monospace" }}>RadarChart</Text>
            <Text size=xs style={{ color: getMutedColor() }}>Two people across six axes, hover a point for its value</Text>
          </Box>
        </Stack>
        <Box style={{ display: "flex", justifyContent: "center" }}>
          <RadarChart
            width={320}
            height={300}
            interactive={true}
            axes={["Design", "Frontend", "Backend", "Testing", "Writing", "Ops"]}
            series={[
              {
                name: "Maya",
                color: "#6366f1",
                data: [
                  { axis: "Design", value: 85 },
                  { axis: "Frontend", value: 90 },
                  { axis: "Backend", value: 70 },
                  { axis: "Testing", value: 95 },
                  { axis: "Writing", value: 80 },
                  { axis: "Ops", value: 75 }
                ]
              },
              {
                name: "Theo",
                color: "#ef4444",
                data: [
                  { axis: "Design", value: 92 },
                  { axis: "Frontend", value: 75 },
                  { axis: "Backend", value: 88 },
                  { axis: "Testing", value: 82 },
                  { axis: "Writing", value: 70 },
                  { axis: "Ops", value: 95 }
                ]
              }
            ]}
          />
        </Box>
      </Stack>
    </Card>

    // GaugeChart variants
    <Card padding=lg style={{ background: getCardBg(), border: "1px solid " + getBorderColor(), borderRadius: "14px" }}>
      <Stack direction=vertical gap=md>
        <Stack direction=vertical gap=xs>
          <Text fontWeight=medium style={{ color: getTextColor() }}>Server load</Text>
          <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "baseline", gap: "0.5rem" }}>
            <Text style={{ color: getMutedColor(), fontSize: "0.7rem", fontFamily: "ui-monospace, Menlo, Consolas, monospace" }}>GaugeChart</Text>
            <Text size=xs style={{ color: getMutedColor() }}>Semicircle, arc and full variants with colour thresholds</Text>
          </Box>
        </Stack>
        <Stack direction=horizontal gap=xl align=center justify=center style={{ flexWrap: "wrap", padding: "0.5rem 0" }}>
          <Box style={{ textAlign: "center" }}>
            <GaugeChart
              value={73}
              variant="semicircle"
              label="CPU"
              width={140}
              thresholds={[
                { value: 0, color: "#10b981" },
                { value: 60, color: "#f59e0b" },
                { value: 85, color: "#ef4444" }
              ]}
            />
          </Box>
          <Box style={{ textAlign: "center" }}>
            <GaugeChart
              value={42}
              variant="arc"
              label="Memory"
              width={140}
              thresholds={[
                { value: 0, color: "#6366f1" },
                { value: 50, color: "#f59e0b" },
                { value: 80, color: "#ef4444" }
              ]}
            />
          </Box>
          <Box style={{ textAlign: "center" }}>
            <GaugeChart
              value={88}
              variant="full"
              label="Disk"
              width={110}
              thresholds={[
                { value: 0, color: "#10b981" },
                { value: 70, color: "#f59e0b" },
                { value: 90, color: "#ef4444" }
              ]}
            />
          </Box>
        </Stack>
      </Stack>
    </Card>
  </Grid>
</Stack>
