# Dependencies
node_modules/

# Build outputs
dist/
dist-desktop/
release/
build/
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Tauri / Rust
target/

# Test coverage
coverage/

# The directory API keeps its state under data/ when run in place; only the
# rules that keep that directory unserved are part of the source.
apps/softn-api/data/*
!apps/softn-api/data/.htaccess
!apps/softn-api/data/README.txt

# Local DOS game data (DOOM.EXE / DOOM1.WAD and the like) — not project source.
games/

# The demo bundles are fetched from the softn-Examples release that
# apps/softn-web/public/demos/index.json pins (npm run fetch:demos); only the
# catalogue, icons and thumbnails are source.
apps/softn-web/public/demos/*.softn
apps/softn-web/public/demos/*.softn.download

# The apps folder scripts/softn-apps builds: bundles and screenshots, never committed
scripts/softn-apps/apps/
scripts/softn-apps/data/
apps/softn-single/public/app.softn

# Verified binary inputs for optional single-app backend packaging
.cache/

# The ZIPP engine is generated, never committed: fetch-zipp-release.mjs installs
# the release apps/softn-host-rust/Cargo.toml declares (the npm hooks run it),
# staging beside the folder under a lock file; its downloads are cached per
# tag, and a local engine build (build-zipp-wasm.mjs) goes to core's
# .cache/zipp-local. The same release's JavaScript-only web build is installed
# beside it as a verified variant (wasm-zipp-web/), and its torch package as
# wasm-zipp-torch/, both staged the same way. Only the curated notices in
# packages/@softn/core/zipp-notices/ are source.
/packages/@softn/core/wasm-zipp/
/packages/@softn/core/.wasm-zipp.*
/packages/@softn/core/wasm-zipp-web/
/packages/@softn/core/.wasm-zipp-web.*
/packages/@softn/core/wasm-zipp-torch/
/packages/@softn/core/.wasm-zipp-torch.*
/packages/@softn/core/.cache/
/.zipp-release/

# Python bytecode from the verification scripts
__pycache__/

# Standalone regression tests of the vendored compatibility backport.
vendor/glib/Cargo.lock

# The documentation generator (docs/scripts/build-docs.mjs) writes its own
# dist/ and derives a few files; only generated/landing.json is committed,
# because the site imports it and a fresh checkout must typecheck.
docs/dist/
docs/generated/*
!docs/generated/landing.json

# Built by examples/torch-trainer/build.mjs from the source beside it.
examples/torch-trainer/*.softn
