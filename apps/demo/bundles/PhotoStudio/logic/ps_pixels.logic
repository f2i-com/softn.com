// Inverse-mapped affine transform with bilinear sampling of premultiplied RGBA.
// inv = [a, b, c, d, e, f] maps destination (X, Y) to source (a*X + b*Y + e, c*X + d*Y + f).
function psTransformRows(src, w, h, dst, y0, y1, inv, ch) {
  let a = inv[0], b = inv[1], c = inv[2], d = inv[3], e = inv[4], f = inv[5];
  for (let y = y0; y < y1; y++) {
    for (let x = 0; x < w; x++) {
      let sx = a * x + b * y + e, sy = c * x + d * y + f;
      let di = (y * w + x) * ch;
      if (sx <= -1 || sy <= -1 || sx >= w || sy >= h) { for (let k = 0; k < ch; k++) dst[di + k] = 0; continue; }
      let ix = Math.floor(sx), iy = Math.floor(sy), wx = sx - ix, wy = sy - iy;
      let x0 = ix, x1 = ix + 1, yy0 = iy, yy1 = iy + 1;
      let w00 = (1 - wx) * (1 - wy), w01 = wx * (1 - wy), w10 = (1 - wx) * wy, w11 = wx * wy;
      let ok00 = x0 >= 0 && yy0 >= 0 && x0 < w && yy0 < h, ok01 = x1 >= 0 && yy0 >= 0 && x1 < w && yy0 < h;
      let ok10 = x0 >= 0 && yy1 >= 0 && x0 < w && yy1 < h, ok11 = x1 >= 0 && yy1 >= 0 && x1 < w && yy1 < h;
      let i00 = (yy0 * w + x0) * ch, i01 = (yy0 * w + x1) * ch, i10 = (yy1 * w + x0) * ch, i11 = (yy1 * w + x1) * ch;
      for (let k = 0; k < ch; k++) {
        let v = (ok00 ? src[i00 + k] * w00 : 0) + (ok01 ? src[i01 + k] * w01 : 0) + (ok10 ? src[i10 + k] * w10 : 0) + (ok11 ? src[i11 + k] * w11 : 0);
