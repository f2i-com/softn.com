Options -Indexes
# Nothing here is private, but a folder this is uploaded into may hold what is:
# .git/config, .env, a backup. Not by FilesMatch, which sees no folder of a path
# and needs a host to allow Require. /.well-known/ stays, for a certificate's
# challenge, and runtime.config.json is another name than config.json.
<IfModule mod_alias.c>
  RedirectMatch 404 "/\.(?!well-known(?:/|$))"
  RedirectMatch 404 "(?i)(?:/config\.json|\.(?:bak|old|orig|save|sql(?:\.gz)?|sqlite3?(?:-wal|-shm)?|db|tar|tar\.gz|tgz|zip))$"
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # The same cross-origin isolation softn.com sends for this shell.
  # credentialless rather than require-corp, so images and model files from
  # other origins keep working without CORP headers. An app must behave the
  # same here as on the site.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "credentialless"
  # Only this site may frame the app: the page shows the permission bar and
  # its Allow button, and another site that framed it could cover the bar
  # with a look-alike and take the visitor's click as a grant. To embed the
  # app on another site, list that origin after 'self' (and remove
  # X-Frame-Options).
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(softn|json)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  # Fingerprinted build assets are immutable for a year.
  <FilesMatch "-(?:[A-Za-z0-9_-]{8}|[0-9a-f]{12})\.(?:css|js|mjs|wasm|woff2?|ttf|png|jpe?g|gif|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Content-addressed container runtime JS/WASM assets are immutable for a year.
  <FilesMatch "\.(?:js|wasm)(?:\.(?:br|gz))?$">
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#/container-runtime/[0-9a-f]{12}/#"
  </FilesMatch>
  # A deploy replaces the hashed scripts, so the page that names them is always asked for.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/wasm image/svg+xml
</IfModule>
AddType application/wasm .wasm
AddType application/javascript .mjs
