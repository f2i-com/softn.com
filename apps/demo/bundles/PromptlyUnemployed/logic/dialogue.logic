// Dialogue controller. Lines play through softn.audio; advancement is tick-counted
// from the manifest's durationMs because no completion event reaches .logic yet (S3).
// Continuations are string tags dispatched in handleDialogueDone (main.logic) —
// functions must never sit in synced state, so the queue carries only data.

let dlgActive = false
let dlgSpeaker = ""
let dlgText = ""
let dlgQueue = []          // line ids still to play after the current one
let dlgDoneTag = ""        // dispatched when the queue empties
let dlgTicksLeft = 0
let dlgHandle = ""
let choiceList = []        // [{id, label}] — non-empty means a choice panel is up
let choiceTag = ""
let transcript = []        // [{speaker, text}]
let muted = false

let TICK_MS = 33
let DLG_TAIL_TICKS = 6     // grace after the counted duration so lines never clip
let dlgSeq = 0             // increments per line; guards stale whenEnded callbacks

function sfx(name) {
  if (muted) { return }
  softn.audio.play("assets/audio/sfx/" + name + ".wav")
}

function runDialogue(ids, doneTag) {
  dlgQueue = ids.slice()
  dlgDoneTag = doneTag || ""
  dlgAdvance()
}

function dlgAdvance() {
  if (dlgHandle) { softn.audio.stop(dlgHandle); dlgHandle = "" }
  if (dlgQueue.length === 0) {
    dlgActive = false
    dlgSpeaker = ""
    dlgText = ""
    let tag = dlgDoneTag
    dlgDoneTag = ""
    if (tag) { handleDialogueDone(tag) }
    return
  }
  let id = dlgQueue.shift()
  dlgQueue = dlgQueue.slice()          // reassign so the binding sees a new array
  let line = DLG[id]
  if (!line) {
    console.error("[PU] unknown dialogue id: " + id)
    dlgAdvance()
    return
  }
  dlgActive = true
  dlgSpeaker = line.speaker
  dlgText = line.text
  dlgSeq = dlgSeq + 1
  let mySeq = dlgSeq
  // Manifest duration + margin is only the backstop; the real completion signal
  // is softn.audio.whenEnded below when the runtime provides it.
  dlgTicksLeft = Math.ceil(line.durationMs / TICK_MS) + DLG_TAIL_TICKS
  transcript.push({ speaker: line.speaker, text: line.text })
  transcript = transcript.slice()
  if (!muted) {
    softn.audio.play("assets/audio/dialogue/" + id + ".wav", {}, function (r) {
      if (r && r.played && r.handle) {
        // A skipped line can finish opening after the next one has already
        // started. Never let that stale callback steal dlgHandle or leave two
        // voices talking over each other.
        if (mySeq !== dlgSeq || !dlgActive || muted) {
          softn.audio.stop(r.handle)
          return
        }
        dlgHandle = r.handle
        if (softn.audio.whenEnded) {
          softn.audio.whenEnded(r.handle, function (out) {
            // 'stopped' means we skipped it ourselves; the seq guard drops
            // stale callbacks after a skip or scene change.
            if (mySeq === dlgSeq && dlgActive && out && out.status !== "stopped") {
              dlgTicksLeft = Math.min(dlgTicksLeft, 2)
            }
          })
        }
      }
      // If autoplay is blocked, keep the caption up for its authored duration.
      // Racing through an eight-second line in 1.5 seconds made the silent
      // fallback much harder to read than the voiced version.
    })
  }
}

// Called every game tick while a line is up.
function dlgTick() {
  if (!dlgActive) { return }
  dlgTicksLeft = dlgTicksLeft - 1
  if (dlgTicksLeft <= 0) { dlgAdvance() }
}

// Space / caption tap. Skips the current line, never a pending choice.
function dlgSkip() {
  if (dlgActive) { dlgAdvance() }
}

// Interacting mid-line should act, not stall. The whole remaining queue drops
// into the transcript, the continuation tag still fires, and then the player's
// action goes through — the story fast-forwards instead of the UI freezing.
function fastForwardDialogue() {
  if (!dlgActive) { return }
  if (dlgHandle) { softn.audio.stop(dlgHandle); dlgHandle = "" }
  dlgSeq = dlgSeq + 1
  for (let i = 0; i < dlgQueue.length; i++) {
    let line = DLG[dlgQueue[i]]
    if (line) { transcript.push({ speaker: line.speaker, text: line.text }) }
  }
  transcript = transcript.slice()
  dlgQueue = []
  dlgActive = false
  dlgSpeaker = ""
  dlgText = ""
  let tag = dlgDoneTag
  dlgDoneTag = ""
  if (tag) { handleDialogueDone(tag) }
}

function showChoices(list, tag) {
  choiceList = list.slice()
  choiceTag = tag
}

function pickChoice(id) {
  sfx("click")
  let tag = choiceTag
  choiceList = []
  choiceTag = ""
  handleChoice(tag, id)
}

function toggleMute() {
  muted = !muted
  if (muted) { musSeq = musSeq + 1; softn.audio.stopAll(); dlgHandle = ""; musHandle = "" }
  softn.audio.setVolume(muted ? 0 : 1)
  if (!muted && musCurrent) { let m = musCurrent; musCurrent = ""; playMusic(m) }
}

// One looping cue per world. No buses yet, so the mix is "keep music quiet".
let musHandle = ""
let musCurrent = ""
let musSeq = 0

function playMusic(name) {
  if (name === musCurrent && musHandle) { return }
  musSeq = musSeq + 1
  let mySeq = musSeq
  if (musHandle) { softn.audio.stop(musHandle); musHandle = "" }
  musCurrent = name
  if (!name || muted) { return }
  softn.audio.play("assets/audio/music/mus_" + name + ".wav", { loop: true, volume: 0.22 }, function (r) {
    if (!r || !r.handle) { return }
    if (mySeq !== musSeq || muted || musCurrent !== name) {
      softn.audio.stop(r.handle)
      return
    }
    musHandle = r.handle
  })
}

function stopMusic() {
  musSeq = musSeq + 1
  if (musHandle) { softn.audio.stop(musHandle) }
  musHandle = ""
  musCurrent = ""
}
