  // Bed with mattress, pillow, blanket.
  objs.push({ id: "bed", type: "box", position: { x: 14.5, y: 0.22, z: 10.5 }, width: 2.2, height: 0.44, depth: 3.4, color: "#5c4033" })
  objs.push({ id: "mattress", type: "box", position: { x: 14.5, y: 0.5, z: 10.5 }, width: 2.05, height: 0.18, depth: 3.25, color: "#cbb9a2" })
  objs.push({ id: "pillow", type: "box", position: { x: 14.5, y: 0.63, z: 9.2 }, width: 1.1, height: 0.14, depth: 0.6, color: "#e8ddc9" })
  objs.push({ id: "blanket", type: "box", position: { x: 14.5, y: 0.61, z: 11.3 }, width: 2.06, height: 0.1, depth: 1.6, color: "#7a5c68" })
  // Bookshelf.
  objs.push({ id: "shelf", type: "box", position: { x: 12.5, y: 0.9, z: 12.9 }, width: 2.2, height: 1.8, depth: 0.4, color: "#3a2e24" })
  let bookCols = ["#f87171", "#38bdf8", "#4ade80", "#facc15", "#c084fc", "#fb923c"]
  for (let i = 0; i < 6; i++) {
    objs.push({ id: "book" + i, type: "box", position: { x: 11.7 + i * 0.28, y: 1.35, z: 12.85 },
      width: 0.18, height: 0.52, depth: 0.3, color: bookCols[i], roughness: 1 })
  }
  // Fairy lights along the west wall — they survive every budget cut.
  for (let i = 0; i < 8; i++) {
