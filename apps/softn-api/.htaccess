# Everything under /api/ is answered by index.php. The site's .htaccess
# routes /api/ here too, but Apache applies the rewrite rules of the deepest
# directory that turns the engine on, so for addresses under /api/ these are
# the rules in force; they are also what serves this directory on its own.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # `git push` signs in with HTTP Basic. Apache keeps that header from PHP run
  # as FastCGI or CGI (most shared hosts) unless it is handed on, and this does
  # it without CGIPassAuth, which is a 500 on a host that forbids AuthConfig.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  # The docs are a route of the API (GET /api/README.md), not the file.
  RewriteRule ^README\.md$ index.php [L]
  # The library is included by index.php and is never a page of its own.
  # FilesMatch sees only a file's name, never its directory, so lib/ is
  # kept out here.
  RewriteRule ^lib/ - [F,L]
  # Every other address is the script's, a file's included: nothing here is
  # served as itself. This file's rules replace the site's for /api/..., so
  # "unless it is a file" ran router.php, served a benchmark's results and
  # .user.ini, and would serve whatever is uploaded here next. nginx sends
  # every /api/ address to index.php the same way.
  RewriteRule !^index\.php$ index.php [QSA,L]
</IfModule>

# Every .md but the docs, which `GET /api/` names: a per-directory rewrite runs
# after this refusal, so a rule above is no way past it. Refused here, the route
# was a 403 on Apache and a 200 on PHP's own server.
<FilesMatch "^(?!README\.md$).*\.md$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
