// Pocket — the Sharp SM83 core: sequencing and interrupt dispatch.
//
// A transliteration of the reference emulator's core/cpu.ts and
// core/interrupt.ts, minus everything Pocket does differently on purpose.
// This file owns:
//
//   * the fetch helpers (and the HALT-bug PC suppression inside them),
//   * the stack helpers,
//   * one instruction of sequencing — gbCpu_step,
//   * interrupt priority, vectoring and dispatch — gbCpu_serviceIrq,
//   * the post-boot register set for each hardware revision.
//
// It owns NO opcode. Every instruction body lives in gb_ops.logic and is
// reached through GB_OPS[op](), which is the whole point: zipp compiles a
// `switch` to a linear scan (57.6ms on the first arm of a 256-arm switch,
// 1965ms on the last, over 1e6 dispatches) and real DMG code leans on the
// expensive end. The function table measured 6.4x faster over a realistic
// opcode mix. gbCpu_step therefore contains exactly one indexed call and no
// opcode knowledge beyond the two opcodes whose EFFECT is a CPU-state change
// the table cannot express on its own: 0x76 HALT (the halt bug needs the
// interrupt state at the instant after the instruction retired) and 0x10 STOP
// (the CGB speed switch needs GB_CPUF, which gb_mmu writes from KEY1).
//
// State is all in gb_state.logic's typed arrays. Nothing here declares a plain
// top-level array, object or string; the two `let`s that hold tables are typed
// arrays and marshal to opaque slots, so the state sync skips them entirely.
//
// Cycle counts are T-cycles throughout (1 M-cycle = 4 T-cycles), the Pan Docs
// convention, and match the numbers gb_ops returns.
//
// ---------------------------------------------------------------------------
// DELIBERATE DIVERGENCES FROM cpu.ts / interrupt.ts
// ---------------------------------------------------------------------------
//
// 1. No tickM. The reference threads a per-M-cycle peripheral callback through
//    every memory access so a read sees the peripheral state of its own
//    M-cycle. CONTRACT.md §3.3 puts that out of scope: Pocket ticks peripherals
//    in 4-cycle chunks BETWEEN instructions (gbMachine_tickParts). The visible
//    cost is the `ie_push` quirk and the tightest Mooneye timing tests.
//
// 2. Consequently interrupt dispatch takes the reference's "legacy" path: a
//    flat 20 T-cycles, priority resolved once, vector latched before the push
//    rather than after it. The reference's M-cycle path re-reads IE after the
//    high-byte push and can cancel the dispatch to PC=0x0000; that cancellation
//    cannot be observed without per-access ticking, so it is not modelled.
//
// 3. STOP wakes. The reference sets `stopped` and never reads it again, so STOP
//    is a two-byte NOP there. Pocket honours it (see gbCpu_step) but will not
//    let it wedge the machine — see the note on the wake condition below.

// ---------------------------------------------------------------------------
// Post-boot register sets
//
// Pocket starts at PC=0x0100 with the registers the boot ROM would have left
// behind (CONTRACT.md §9: no boot ROMs). Each hardware revision hands off a
// different set, because each boot ROM does a different amount of work on the
// way out. Pan Docs §"Power Up Sequence"; the DMG-0 and SGB rows are Gekkio's
// GBCTR / SameBoy values, as in cpu.ts BOOT_REGS.
//
// Six models x eight bytes, in A F B C D E H L order. A Uint8Array rather than
// six objects: it is opaque to the state sync, it is one indexed read per
// register at reset, and reset is cold code anyway.
//
// SP is 0xFFFE and PC is 0x0100 on every model, so neither is in the table.
// ---------------------------------------------------------------------------

let gbCpu_BOOT_DMG0 = 0
let gbCpu_BOOT_DMGABC = 1
let gbCpu_BOOT_MGB = 2
let gbCpu_BOOT_SGB = 3
let gbCpu_BOOT_SGB2 = 4
let gbCpu_BOOT_CGB = 5

let gbCpu_BOOT_REGS = Uint8Array.from([
  // A     F     B     C     D     E     H     L
  0x01, 0x00, 0xff, 0x13, 0x00, 0xc1, 0x84, 0x03, // dmg0   — earliest DMG
  0x01, 0xb0, 0x00, 0x13, 0x00, 0xd8, 0x01, 0x4d, // dmgABC — the common DMG
  0xff, 0xb0, 0x00, 0x13, 0x00, 0xd8, 0x01, 0x4d, // mgb    — the pocket revision
  0x01, 0x00, 0x00, 0x14, 0x00, 0x00, 0xc0, 0x60, // sgb    — the SNES adapter
  0xff, 0x00, 0x00, 0x14, 0x00, 0x00, 0xc0, 0x60, // sgb2   — the SNES adapter, rev 2
  0x11, 0x80, 0x00, 0x00, 0xff, 0x56, 0x00, 0x0d  // cgb    — the colour model
])

// The 16-bit DIV counter at hand-off. DIV is the top byte of a free-running
// counter that starts ticking at power-on, so where it has got to by PC=0x0100
// is simply how long that model's boot ROM ran. Games seed their RNG off it —
// this is not decoration.
let gbCpu_BOOT_DIV = Uint16Array.from([0xabcc, 0xabcc, 0xabcc, 0xd80a, 0xd80a, 0x2680])

// ---------------------------------------------------------------------------
// Reset
// ---------------------------------------------------------------------------

// Apply one model's post-boot state. `gbc` is kept separate from `model`
// because they are separate questions: a CGB-capable cart running on a CGB is
// (cgb, true), but the boot model can be forced for testing without changing
// what the rest of the machine thinks it is.
//
// gbState_reset() has already zeroed GB_CPUF, which includes GB_P_GBC, so the
// CGB flag is restored here rather than assumed to have survived.
function gbCpu_resetModel(model, gbc) {
  let m = model
  if (!(m >= 0 && m <= 5)) { m = gbc ? gbCpu_BOOT_CGB : gbCpu_BOOT_DMGABC }
  let base = m << 3

  GB_REG[GB_R_A] = gbCpu_BOOT_REGS[base]
  // The low nibble of F does not exist on hardware. Every write to F masks.
  GB_REG[GB_R_F] = gbCpu_BOOT_REGS[base + 1] & 0xf0
  GB_REG[GB_R_B] = gbCpu_BOOT_REGS[base + 2]
  GB_REG[GB_R_C] = gbCpu_BOOT_REGS[base + 3]
  GB_REG[GB_R_D] = gbCpu_BOOT_REGS[base + 4]
  GB_REG[GB_R_E] = gbCpu_BOOT_REGS[base + 5]
  GB_REG[GB_R_H] = gbCpu_BOOT_REGS[base + 6]
  GB_REG[GB_R_L] = gbCpu_BOOT_REGS[base + 7]

  GB_REG16[GB_R16_SP] = 0xfffe
  GB_REG16[GB_R16_PC] = 0x0100

  GB_CPUF[GB_P_IME] = 0
  GB_CPUF[GB_P_IME_PENDING] = 0
  GB_CPUF[GB_P_HALTED] = 0
  GB_CPUF[GB_P_STOPPED] = 0
  GB_CPUF[GB_P_HALTBUG] = 0
  GB_CPUF[GB_P_DOUBLE] = 0
  GB_CPUF[GB_P_SPEEDSW] = 0
  GB_CPUF[GB_P_GBC] = gbc ? 1 : 0

  GB_CTR[GB_C_DIV] = gbCpu_BOOT_DIV[m]
}

// The entry point gb_machine calls. Model selection is the reference's 'auto':
// CGB on a CGB, the common DMG-ABC otherwise. DMG-ABC is the right default
// because most carts only ever look at A's high nibble, which is the CGB
// detection, and A=0x01 is what they expect not to see.
function gbCpu_reset(gbc) {
  if (gbc) {
    gbCpu_resetModel(gbCpu_BOOT_CGB, true)
  } else {
    gbCpu_resetModel(gbCpu_BOOT_DMGABC, false)
  }
}

// ---------------------------------------------------------------------------
// Fetch and stack
//
// These do not account for their own memory-access cycles; those are baked
// into the numbers gb_ops returns, exactly as in the reference.
// ---------------------------------------------------------------------------

// Read the byte at PC and advance PC — unless the halt bug is armed, in which
// case PC stays put for this ONE fetch and the bug disarms. The next
// instruction's first byte is therefore read twice: once as the operand-less
// opcode that follows HALT, and once as itself. Pokemon Yellow inserts a NOP
// before HALT specifically to make that harmless.
function gbCpu_fetchU8() {
  let pc = GB_REG16[GB_R16_PC]

  // The same ROM-window fast path gbMmu_read opens with, inlined here as well.
  // This function runs one to three times per instruction and PC is in ROM for
  // essentially all of them, so the call it saves is worth writing twice; the
  // guard and the arithmetic are identical, and anything the guard declines
  // still goes through gbMmu_read and answers exactly as it did before.
  let v = 0
  if (pc < 0x8000 && gbMmu_busy === 0 && gbCart_present === 1) {
    if (pc < 0x4000) {
      v = GB_ROM[gbCart_baseLo + pc]
    } else {
      v = GB_ROM[gbCart_baseHi + pc]
    }
  } else {
    v = gbMmu_read(pc)
  }

  if (GB_CPUF[GB_P_HALTBUG] === 1) {
    GB_CPUF[GB_P_HALTBUG] = 0
  } else {
    GB_REG16[GB_R16_PC] = (pc + 1) & 0xffff
  }
  return v & 0xff
}

// Little-endian, low byte first. Two fetches rather than one wide read so the
// halt bug applies to each half the way hardware does.
function gbCpu_fetchU16() {
  let lo = gbCpu_fetchU8()
  let hi = gbCpu_fetchU8()
  return ((hi << 8) | lo) & 0xffff
}

// High byte first, at the decremented SP. SP is stored back before each write
// so that a push landing on a memory-mapped register sees the SP hardware
// would show it.
function gbCpu_push16(v) {
  let sp = (GB_REG16[GB_R16_SP] - 1) & 0xffff
  GB_REG16[GB_R16_SP] = sp
  gbMmu_write(sp, (v >>> 8) & 0xff)
  sp = (sp - 1) & 0xffff
  GB_REG16[GB_R16_SP] = sp
  gbMmu_write(sp, v & 0xff)
}

function gbCpu_pop16() {
  let sp = GB_REG16[GB_R16_SP]
  let lo = gbMmu_read(sp)
  sp = (sp + 1) & 0xffff
  GB_REG16[GB_R16_SP] = sp
  let hi = gbMmu_read(sp)
  GB_REG16[GB_R16_SP] = (sp + 1) & 0xffff
  return ((hi << 8) | lo) & 0xffff
}

// ---------------------------------------------------------------------------
// One instruction
//
// Order is fixed by CONTRACT.md §3.4: honour HALT, fetch, dispatch, promote a
// pending EI, detect the HALT bug. Everything in here that is not the indexed
// call is either a typed-array read or an integer compare, because this runs
// roughly nine thousand times per emulated frame.
// ---------------------------------------------------------------------------

function gbCpu_step() {
  // Halted: the CPU is asleep and burns 4 T-cycles doing nothing. It does not
  // fetch, so PC does not move and no bus access happens. gbCpu_serviceIrq
  // is what wakes it, and gb_machine calls that first, so by the time we get
  // here the sleep is real.
  if (GB_CPUF[GB_P_HALTED] === 1) { return 4 }

  // Stopped: as halted, but the wake condition is a button rather than an
  // interrupt. GB_PAD[0] is the live mask, active high, so any held button
  // ends the stop — that is the hardware condition and it does not depend on
  // IE, IF or IME.
  //
  // The second clause is Pocket's, not hardware's: any ENABLED pending
  // interrupt also ends the stop. Hardware would stay down until a button
  // arrives. Without it, a cart that stops for a reason we do not model — or
  // one that stops with the LCD still running, which the reference's two-byte-
  // NOP STOP let it get away with — wedges the emulator permanently, and a
  // frozen screen is a far worse failure than a stop that ends a frame early.
  if (GB_CPUF[GB_P_STOPPED] === 1) {
    if (GB_PAD[0] !== 0 || gbMmu_irqPending !== 0) {
      GB_CPUF[GB_P_STOPPED] = 0
    } else {
      return 4
    }
  }

  // EI does not take effect until after the instruction FOLLOWING it. Capture
  // the pending flag before the fetch: if it was already set going in and is
  // still set coming out, a whole instruction has passed since EI and IME can
  // be promoted. EI itself is the case where it was clear going in, so EI does
  // not enable itself. DI clears both, so a DI immediately after an EI wins.
  let eiBefore = GB_CPUF[GB_P_IME_PENDING]

  let op = gbCpu_fetchU8()
  // The table read and the call are two statements on purpose. zipp evaluates
  // `GB_OPS[op]()` as a member call — it re-resolves the callee with a receiver
  // and takes a slow path that measured 88ns against 39ns for the split form
  // (500k dispatches on the shipping WASM engine). Same table, same function,
  // half the dispatch cost, ~0.7ms a frame.
  let handler = GB_OPS[op]
  let cycles = handler()

  if (eiBefore === 1 && GB_CPUF[GB_P_IME_PENDING] === 1) {
    GB_CPUF[GB_P_IME] = 1
    GB_CPUF[GB_P_IME_PENDING] = 0
  }

  if (op === 0x76) {
    // The HALT bug. HALT executed with IME=0 while IE & IF already has a bit
    // set does not actually halt: the CPU stays awake and the NEXT fetch does
    // not advance PC. gb_ops' 0x76 unconditionally sets GB_P_HALTED, so this
    // is where the condition is undone — it has to be tested here rather than
    // inside the opcode because the answer depends on the interrupt state at
    // the instant the instruction retired.
    if (
      GB_CPUF[GB_P_HALTED] === 1 &&
      GB_CPUF[GB_P_IME] === 0 &&
      gbMmu_irqPending !== 0
    ) {
      GB_CPUF[GB_P_HALTED] = 0
      GB_CPUF[GB_P_HALTBUG] = 1
    }
  } else if (op === 0x10) {
    // STOP on a CGB with KEY1 bit 0 armed is not a stop at all — it is the
    // speed switch. gb_mmu sets GB_P_SPEEDSW from a write to FF4D; here the
    // switch actually happens: the clock doubles (or halves back), the request
    // clears, and the CPU carries straight on. gb_machine reads GB_P_DOUBLE to
    // decide how many CPU cycles a peripheral cycle is worth.
    //
    // Hardware stalls about 2050 M-cycles across the switch with the LCD
    // blanked. That is not modelled: the instruction keeps the 4 T-cycles
    // gb_ops returned, as in the reference.
    if (GB_CPUF[GB_P_SPEEDSW] === 1) {
      GB_CPUF[GB_P_SPEEDSW] = 0
      GB_CPUF[GB_P_STOPPED] = 0
      if (GB_CPUF[GB_P_DOUBLE] === 1) {
        GB_CPUF[GB_P_DOUBLE] = 0
      } else {
        GB_CPUF[GB_P_DOUBLE] = 1
      }
    }
  }

  // Every GB_OPS slot is filled and every instruction costs at least 4, so
  // this only ever fires if a table slot went missing. One integer compare to
  // turn "the machine silently accumulates NaN cycles and stops advancing"
  // into "the machine runs slightly wrong", which is a much easier bug to see.
  if (cycles > 0) { return cycles }
  return 4
}

// ---------------------------------------------------------------------------
// Interrupts
//
// IF is GB_IO[0x0F] and IE is GB_IO[GB_IO_IE], both meaningful in their low
// five bits. Bit 0 VBlank, 1 STAT, 2 Timer, 3 Serial, 4 Joypad; the vector is
// 0x40 + bit * 8 and the lowest bit number wins. Everything raises through
// gbMmu_requestIrq; this is the only place that clears on dispatch.
// ---------------------------------------------------------------------------

function gbCpu_serviceIrq() {
  let triggered = gbMmu_irqPending
  if (triggered === 0) { return 0 }

  // A pending enabled interrupt wakes the CPU whether or not IME is set — that
  // is how a HALT with interrupts disabled is meant to end (Pan Docs §Halt).
  // The wake happens even when the dispatch below does not.
  if (GB_CPUF[GB_P_HALTED] === 1) { GB_CPUF[GB_P_HALTED] = 0 }
  if (GB_CPUF[GB_P_STOPPED] === 1) { GB_CPUF[GB_P_STOPPED] = 0 }

  if (GB_CPUF[GB_P_IME] === 0) { return 0 }

  GB_CPUF[GB_P_IME] = 0
  GB_CPUF[GB_P_IME_PENDING] = 0

  // Priority: lowest bit number first. An if-chain rather than a loop — five
  // iterations of loop overhead on every dispatch, and VBlank is by far the
  // most common case, so it wants to be the first test.
  let bit = 0
  if ((triggered & 0x01) === 0) {
    if ((triggered & 0x02) !== 0) {
      bit = 1
    } else if ((triggered & 0x04) !== 0) {
      bit = 2
    } else if ((triggered & 0x08) !== 0) {
      bit = 3
    } else {
      bit = 4
    }
  }

  // Acknowledge, then push the return address, then vector. The order matters
  // for a handler that re-enables itself: the IF bit is already clear when the
  // first instruction of the handler runs.
  gbMmu_clearIrq(bit)
  gbCpu_push16(GB_REG16[GB_R16_PC])
  GB_REG16[GB_R16_PC] = 0x40 + (bit << 3)

  // Five M-cycles: two internal, two pushing, one loading the vector.
  return 20
}
