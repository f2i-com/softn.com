// The steps a meal runs through after the first click, the way a Sim
// carries ingredients from the fridge to the counter, the pan to the stove,
// the plate to the table and the dirty plate to the sink. A step whose
// furniture the house lacks is skipped; eating always happens somewhere.
const EATSTAND = { id: "eatstand", label: "Eat standing up", icon: "🍽", need: "hunger", gain: 40, mins: 12, pose: "stand", anim: "eat" };
