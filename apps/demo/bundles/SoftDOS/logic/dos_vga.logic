// dos_vga.logic — SoftDOS VGA Subsystem & Display Output
//
// Manages VGA Mode 13h (320x200 256 colors at 0xA0000) and Text Mode 03h (80x25 at 0xB8000),
// producing indexed "p8" base64 frames for SoftN's <PixelCanvas>.

// Standard 16 CGA/EGA baseline colors (RGB triples, 0-255)
let DOS_CGA_16 = [
  0, 0, 0,       // 0: Black
  0, 0, 170,     // 1: Blue
  0, 170, 0,     // 2: Green
  0, 170, 170,   // 3: Cyan
  170, 0, 0,     // 4: Red
  170, 0, 170,   // 5: Magenta
  170, 85, 0,    // 6: Brown
  170, 170, 170, // 7: Light Gray
  85, 85, 85,    // 8: Dark Gray
  85, 85, 255,   // 9: Light Blue
  85, 255, 85,   // 10: Light Green
  85, 255, 255,  // 11: Light Cyan
  255, 85, 85,   // 12: Light Red
  255, 85, 255,  // 13: Light Magenta
  255, 255, 85,  // 14: Yellow
  255, 255, 255  // 15: White
];

