{
  "name": "@softn/core",
  "version": "0.0.5",
  "description": "SoftN UI Language Core Engine",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f2i-com/softn.com.git",
    "directory": "packages/@softn/core"
  },
  "homepage": "https://softn.com",
  "bugs": "https://github.com/f2i-com/softn.com/issues",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser/index.d.ts",
      "default": "./dist/parser/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "default": "./dist/loader/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "build:zipp-wasm": "node scripts/build-zipp-wasm.mjs",
    "vendor:zipp-release": "node scripts/vendor-zipp-release.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "yjs": "^13.6.0",
    "y-webrtc": "^10.3.0",
    "y-indexeddb": "^9.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "onnxruntime-web": "^1.17.0",
    "@huggingface/transformers": ">=3.0.0 || >=4.0.0-next.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": { "optional": true },
    "@huggingface/transformers": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "tsup": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
