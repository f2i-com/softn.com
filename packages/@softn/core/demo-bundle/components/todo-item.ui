<!--
  One row of the list. main.ui writes the TodoItem tag inside its loop over
  filteredTodos, and this markup is put there as written: `todo` is the
  loop's variable, and every function called here is the page's (app.logic).
  Nothing is passed in and nothing is sent back.

  Which row is being edited is the page's state too (`editingId`, `editText`).
  This file could not keep it: it has no scope of its own, so a variable
  declared here would be one variable shared by every row.
-->
<div className="todo-item" class:completed={todo.data.completed}>
  #if (editingId === todo.id)
    <div className="edit-mode">
      <Input
        type="text"
        :bind={editText}
        @keydown.enter={() => saveEdit()}
        @keydown.escape={() => cancelEdit()}
        flex={1}
        autoFocus
      />
      <Button variant="ghost" size="sm" aria-label="Save" @click={() => saveEdit()}>
        <Icon name="check" />
      </Button>
      <Button variant="ghost" size="sm" aria-label="Cancel" @click={() => cancelEdit()}>
        <Icon name="close" />
      </Button>
    </div>
  #else
    <div className="view-mode">
      <Checkbox
        checked={todo.data.completed}
        @change={() => toggleTodo(todo.id)}
      />
      <span className="todo-text" @dblclick={() => startEdit(todo.id)}>
        {todo.data.text}
      </span>
      <span className="todo-meta">{formatRelativeTime(todo.data.createdAt)}</span>
      <div className="todo-actions">
        <Button variant="ghost" size="sm" aria-label="Edit" @click={() => startEdit(todo.id)}>
          <Icon name="edit" />
        </Button>
        <Button variant="ghost" size="sm" aria-label="Delete" @click={() => deleteTodo(todo.id)}>
          <Icon name="trash" />
        </Button>
      </div>
    </div>
  #end
</div>
