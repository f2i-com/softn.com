<logic src="../logic/main.logic" />

<data>
  <collection name="characters" as="characters" />
  <collection name="office_chat" as="messages" sort="timestamp:desc" limit={50} />
</data>

<style>
/* Animates the `translate` property rather than `transform`, so the bubble's
   own transform — which nudges it away from the office wall — survives. A
   keyframe on `transform` replaces that outright and every bubble snaps back
   over its speaker's head. */
@keyframes office-bob {
  0%, 100% { translate: 0 0; }
  50% { translate: 0 -3px; }
}
@keyframes office-dots {
  0%, 80%, 100% { opacity: 0.25; }
  40% { opacity: 1; }
}
@keyframes msg-slide {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes office-ping {
  0% { box-shadow: 0 0 0 0 rgba(63,185,80,0.45); }
  70% { box-shadow: 0 0 0 7px rgba(63,185,80,0); }
  100% { box-shadow: 0 0 0 0 rgba(63,185,80,0); }
}
.office-bubble { animation: office-bob 2.4s ease-in-out infinite; }
.office-dot-1 { animation: office-dots 1.2s ease-in-out infinite; }
.office-dot-2 { animation: office-dots 1.2s ease-in-out 0.2s infinite; }
.office-dot-3 { animation: office-dots 1.2s ease-in-out 0.4s infinite; }
.msg-enter { animation: msg-slide 0.28s ease-out; }
.office-live { animation: office-ping 2s ease-out infinite; }

.office-view:focus-visible { outline: 2px solid rgba(88,166,255,0.7); outline-offset: -2px; }
.office-view::-webkit-scrollbar { width: 10px; height: 10px; }
.office-view::-webkit-scrollbar-track { background: rgba(0,0,0,0.25); }
.office-view::-webkit-scrollbar-thumb { background: rgba(139,148,158,0.35); border-radius: 6px; border: 2px solid transparent; background-clip: content-box; }
.office-view::-webkit-scrollbar-thumb:hover { background: rgba(139,148,158,0.6); background-clip: content-box; }

.chat-scroll { scrollbar-width: thin; scrollbar-color: rgba(99,179,237,0.3) transparent; }
.chat-scroll::-webkit-scrollbar { width: 6px; }
.chat-scroll::-webkit-scrollbar-track { background: transparent; }
.chat-scroll::-webkit-scrollbar-thumb { background: rgba(99,179,237,0.3); border-radius: 3px; }

.office-tool { transition: background 140ms ease, transform 140ms ease; }
.office-tool:hover { transform: translateY(-1px); }
.office-tool:active { transform: translateY(0); }
</style>

<App theme="dark">
  <!-- 100% of the App shell, not 100vh: the shell already subtracts the tab
       bar, so a viewport-height child hangs the status bar off the bottom. -->
  <Box style={{ display: "flex", width: "100%", height: "100%", overflow: "hidden", background: "#0d1117", fontFamily: "'Inter', 'Segoe UI', sans-serif" }}>

    <!-- Left: the office floor -->
    <Box style={{ flex: "1 1 auto", position: "relative", overflow: "hidden", background: "#0b0d12", minWidth: "0" }}>

      <PanView
        className="office-view"
        label="Office floor — drag, scroll or use the arrow keys to look around"
        contentWidth={mapPixelWidth()}
        contentHeight={mapPixelHeight()}
        scale={zoom}
        recenterKey={recenterKey}
        background="#0b0d12"
        style={{ position: "absolute", top: 0, left: 0, right: 0, bottom: 0 }}
      >
        <TileMap
          src={asset("assets/office_32x32.png")}
          tileSize={32}
          tilesetColumns={16}
          layers={[bgLayer, objLayer]}
          mapWidth={28}
          mapHeight={20}
          scale={1}
          style={{ display: "block", position: "absolute", top: 0, left: 0 }}
        />

        <!-- Character overlays (renderTick forces a re-render each movement tick) -->
        <Box data-tick={renderTick} style={{ position: "absolute", top: 0, left: 0, width: "100%", height: "100%", pointerEvents: "none" }}>
          #each (char, charIdx in characters)
            <!-- The z-index does two jobs. Ordinarily it is the character's own
                 y, so whoever is further down the room is drawn in front, the
                 way a top-down scene should stack. Anyone with something over
                 their head jumps above the lot: each character sits in its own
                 stacking context (it has a transform), so a bubble's z-index
                 only counts against its owner's sprites — without this, the
                 next character in the list simply painted over the bubble. -->
            <Box style={{ position: "absolute", width: "62px", height: "62px", left: getCharX(charIdx) + "px", top: getCharY(charIdx) + "px", transform: "translate(-50%, " + seatShift(charIdx) + ")", pointerEvents: "none", transition: "left 50ms linear, top 50ms linear", zIndex: isSpeaking(char.id) ? 9999 : (thinkingCharId === char.id ? 9998 : charDepth(charIdx)) }}>

              <!-- Contact shadow, so people stand on the floor instead of hovering over it -->
              <Box style={{ position: "absolute", left: "50%", top: "50px", width: "22px", height: "8px", transform: "translateX(-50%)", background: "radial-gradient(ellipse at center, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0) 72%)", zIndex: 9 }} />

              <!-- Sprite layers: body, eyes, pants, lower legs, outfit, shoes, hair, glasses -->
              <Sprite src={asset("assets/character/" + char.data.base + "_walk.png")} frameWidth={32} frameHeight={32} columns={8} rows={4} row={getCharDir(charIdx)} colOffset={0} playing={isCharMoving(charIdx)} fps={10} scale={1.92} style={{ zIndex: 10 }} />
              <Sprite src={asset("assets/character/eyes/eyes_walk.png")} frameWidth={32} frameHeight={32} columns={8} rows={4} row={getCharDir(charIdx)} colOffset={0} playing={isCharMoving(charIdx)} fps={10} scale={1.92} style={{ zIndex: 11 }} />
              <Sprite src={asset("assets/character/clothes/basic_walk.png")} frameWidth={32} frameHeight={32} columns={8} rows={4} row={getCharDir(charIdx)} colOffset={char.data.pantsColor * 8} playing={isCharMoving(charIdx)} fps={10} scale={1.92} style={{ zIndex: 12 }} />
              <Sprite src={asset("assets/character/clothes/pants_suit_walk.png")} frameWidth={32} frameHeight={32} columns={8} rows={4} row={getCharDir(charIdx)} colOffset={char.data.pantsColor * 8} playing={isCharMoving(charIdx)} fps={10} scale={1.92} style={{ zIndex: 13 }} />
              <Sprite src={asset("assets/character/clothes/" + char.data.clothes + "_walk.png")} frameWidth={32} frameHeight={32} columns={8} rows={4} row={getCharDir(charIdx)} colOffset={char.data.clothesColor * 8} playing={isCharMoving(charIdx)} fps={10} scale={1.92} style={{ zIndex: 14 }} />
              <Sprite src={asset("assets/character/clothes/shoes_walk.png")} frameWidth={32} frameHeight={32} columns={8} rows={4} row={getCharDir(charIdx)} colOffset={char.data.pantsColor * 8} playing={isCharMoving(charIdx)} fps={10} scale={1.92} style={{ zIndex: 15 }} />
              <Sprite src={asset("assets/character/hair/" + char.data.hair + "_walk.png")} frameWidth={32} frameHeight={32} columns={8} rows={4} row={getCharDir(charIdx)} colOffset={char.data.hairColor * 8} playing={isCharMoving(charIdx)} fps={10} scale={1.92} style={{ zIndex: 16 }} />
              <Sprite if={char.data.hasGlasses} src={asset("assets/character/acc/glasses_walk.png")} frameWidth={32} frameHeight={32} columns={8} rows={4} row={getCharDir(charIdx)} colOffset={0} playing={isCharMoving(charIdx)} fps={10} scale={1.92} style={{ zIndex: 17 }} />

              <!-- Name plate, just above the head -->
              <Text style={{ position: "absolute", bottom: "50px", left: "50%", transform: "translateX(-50%)", color: "#e6edf3", fontSize: "9px", fontWeight: 700, letterSpacing: "0.3px", whiteSpace: "nowrap", zIndex: 20, background: "rgba(13,17,23,0.82)", padding: "1px 6px", borderRadius: "999px", border: "1px solid " + colorForIndex(charIdx) + "66", boxShadow: "0 1px 4px rgba(0,0,0,0.5)" }}>{char.data.name}</Text>

              <!-- What they are saying, over their head -->
              <Box if={isSpeaking(char.id)} className="office-bubble" style={{ position: "absolute", left: "50%", transform: "translateX(calc(-50% + " + bubbleShift(charIdx) + "px))", bottom: bubbleBelow(charIdx) ? "auto" : "64px", top: bubbleBelow(charIdx) ? "58px" : "auto", width: "max-content", maxWidth: "240px", background: "#ffffff", padding: "7px 10px", borderRadius: "10px", boxShadow: "0 4px 12px rgba(0,0,0,0.6)", borderTop: "2px solid " + colorForIndex(charIdx), zIndex: 30 }}>
                <!-- The colour goes on the Text, not the bubble: Text takes its
                     own colour from the dark theme, so an inherited one loses. -->
                <Text style={{ display: "block", whiteSpace: "normal", color: "#0d1117", fontSize: "11px", fontWeight: 500, lineHeight: "1.4" }}>{bubbleText()}</Text>
                <Box style={{ position: "absolute", left: "calc(50% - " + bubbleShift(charIdx) + "px)", width: "9px", height: "9px", background: "#ffffff", transform: "translateX(-50%) rotate(45deg)", bottom: bubbleBelow(charIdx) ? "auto" : "-4px", top: bubbleBelow(charIdx) ? "-4px" : "auto" }} />
              </Box>

              <!-- Working on a reply -->
              <Box if={thinkingCharId === char.id} className="office-bubble" style={{ position: "absolute", left: "50%", transform: "translateX(calc(-50% + " + bubbleShift(charIdx) + "px))", bottom: bubbleBelow(charIdx) ? "auto" : "64px", top: bubbleBelow(charIdx) ? "58px" : "auto", display: "flex", gap: "3px", alignItems: "center", background: "#ffffff", padding: "7px 9px", borderRadius: "10px", boxShadow: "0 4px 12px rgba(0,0,0,0.6)", zIndex: 30 }}>
                <Box className="office-dot-1" style={{ width: "4px", height: "4px", borderRadius: "50%", background: "#57606a" }} />
                <Box className="office-dot-2" style={{ width: "4px", height: "4px", borderRadius: "50%", background: "#57606a" }} />
                <Box className="office-dot-3" style={{ width: "4px", height: "4px", borderRadius: "50%", background: "#57606a" }} />
              </Box>
            </Box>
          #end
        </Box>
      </PanView>

      <!-- Daylight from the windows along the top wall, and a soft edge -->
      <Box style={{ position: "absolute", top: 0, left: 0, right: 0, bottom: 0, pointerEvents: "none", zIndex: 5, background: "radial-gradient(110% 70% at 50% -8%, rgba(255,222,166,0.15), rgba(255,222,166,0) 58%), radial-gradient(100% 100% at 50% 50%, rgba(0,0,0,0) 42%, rgba(0,0,0,0.5) 100%)" }} />

      <!-- Controls -->
      <Box style={{ position: "absolute", top: "12px", left: "12px", display: "flex", gap: "8px", zIndex: 30 }}>
        <Button @click={toggleSim} size="sm" className="office-tool" style={{ background: simRunning ? "rgba(218,54,51,0.92)" : "rgba(35,134,54,0.92)", backdropFilter: "blur(8px)", border: "1px solid rgba(255,255,255,0.12)", color: "#fff", padding: "7px 16px", borderRadius: "8px", fontSize: "11px", fontWeight: 700, letterSpacing: "0.2px", boxShadow: "0 2px 10px rgba(0,0,0,0.45)" }}>
          {simRunning ? "Pause" : "Play"}
        </Button>
        <Button if={!modelLoaded} @click={loadModel} size="sm" className="office-tool" style={{ background: modelLoading ? "rgba(48,54,61,0.92)" : "rgba(31,111,235,0.92)", backdropFilter: "blur(8px)", border: "1px solid rgba(255,255,255,0.12)", color: "#fff", padding: "7px 16px", borderRadius: "8px", fontSize: "11px", fontWeight: 700, cursor: modelLoading ? "wait" : "pointer", boxShadow: "0 2px 10px rgba(0,0,0,0.45)" }}>
          {modelLoading ? "Downloading model..." : "Load AI model"}
        </Button>
      </Box>

      <Box style={{ position: "absolute", top: "12px", right: "12px", display: "flex", alignItems: "center", gap: "4px", zIndex: 30, background: "rgba(13,17,23,0.82)", backdropFilter: "blur(8px)", padding: "4px", borderRadius: "10px", border: "1px solid rgba(255,255,255,0.08)", boxShadow: "0 2px 10px rgba(0,0,0,0.45)" }}>
        <Button @click={zoomOut} size="sm" className="office-tool" ariaLabel="Zoom out" title="Zoom out" style={{ background: "transparent", border: "none", color: "#c9d1d9", width: "26px", height: "24px", padding: "0", borderRadius: "6px", fontSize: "14px", lineHeight: "1", fontWeight: 700 }}>-</Button>
        <Text style={{ color: "#8b949e", fontSize: "10px", fontWeight: 600, minWidth: "34px", textAlign: "center", fontVariantNumeric: "tabular-nums" }}>{zoomPercent()}</Text>
        <Button @click={zoomIn} size="sm" className="office-tool" ariaLabel="Zoom in" title="Zoom in" style={{ background: "transparent", border: "none", color: "#c9d1d9", width: "26px", height: "24px", padding: "0", borderRadius: "6px", fontSize: "14px", lineHeight: "1", fontWeight: 700 }}>+</Button>
        <Box style={{ width: "1px", height: "16px", background: "rgba(255,255,255,0.1)", margin: "0 2px" }} />
        <Button @click={recenter} size="sm" className="office-tool" style={{ background: "transparent", border: "none", color: "#c9d1d9", padding: "0 8px", height: "24px", borderRadius: "6px", fontSize: "10px", fontWeight: 600 }}>Recentre</Button>
      </Box>

      <!-- Status -->
      <Box style={{ position: "absolute", bottom: "12px", left: "12px", right: "12px", display: "flex", alignItems: "center", gap: "10px", zIndex: 30, pointerEvents: "none" }}>
        <Box style={{ display: "flex", alignItems: "center", gap: "8px", background: "rgba(13,17,23,0.86)", backdropFilter: "blur(8px)", padding: "6px 12px", borderRadius: "999px", border: "1px solid rgba(255,255,255,0.08)", boxShadow: "0 2px 10px rgba(0,0,0,0.45)", minWidth: "0" }}>
          <Box className={simRunning ? "office-live" : ""} style={{ width: "7px", height: "7px", borderRadius: "50%", flexShrink: 0, background: simRunning ? "#3fb950" : "#6e7681" }} />
          <Text style={{ color: "#c9d1d9", fontSize: "11px", fontWeight: 500, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{statusText}</Text>
        </Box>
        <Text style={{ color: "#4d545c", fontSize: "10px", whiteSpace: "nowrap" }}>Drag, scroll or arrow-key to look around</Text>
      </Box>
    </Box>

    <!-- Right: the chat log -->
    <Box style={{ flex: "0 0 340px", minWidth: "0", display: "flex", flexDirection: "column", background: "#0f141b", borderLeft: "1px solid rgba(48,54,61,0.9)" }}>

      <Box style={{ padding: "14px 16px", borderBottom: "1px solid rgba(48,54,61,0.9)", display: "flex", alignItems: "center", justifyContent: "space-between", gap: "10px" }}>
        <Box style={{ minWidth: "0" }}>
          <Text style={{ color: "#e6edf3", fontSize: "13px", fontWeight: 700, letterSpacing: "-0.2px" }}>Office Chat</Text>
          <Text style={{ color: "#6e7681", fontSize: "10px", marginTop: "2px", display: "block", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{messageCount + " lines · " + chatSource()}</Text>
        </Box>
        <Box style={{ display: "flex", alignItems: "center", gap: "6px", flexShrink: 0 }}>
          <Box className={simRunning ? "office-live" : ""} style={{ width: "7px", height: "7px", borderRadius: "50%", background: simRunning ? "#3fb950" : "#484f58" }} />
          <Text style={{ color: "#6e7681", fontSize: "9px", fontWeight: 600, letterSpacing: "0.6px", textTransform: "uppercase" }}>{simRunning ? "Live" : "Paused"}</Text>
        </Box>
      </Box>

      <Box className="chat-scroll" style={{ flex: "1 1 auto", overflowY: "auto", padding: "10px 12px", display: "flex", flexDirection: "column-reverse", gap: "7px", minHeight: "0" }}>
        <Box if={thinkingCharId !== null} style={{ display: "flex", alignItems: "center", gap: "6px", padding: "8px 10px" }}>
          <Box className="office-dot-1" style={{ width: "5px", height: "5px", borderRadius: "50%", background: "#58a6ff" }} />
          <Box className="office-dot-2" style={{ width: "5px", height: "5px", borderRadius: "50%", background: "#58a6ff" }} />
          <Box className="office-dot-3" style={{ width: "5px", height: "5px", borderRadius: "50%", background: "#58a6ff" }} />
          <Text style={{ color: "#6e7681", fontSize: "10px", marginLeft: "3px" }}>thinking of something to say</Text>
        </Box>

        #each (msg in messages)
          <Box className="msg-enter" style={{ display: "flex", gap: "9px", background: "rgba(22,27,34,0.85)", borderRadius: "10px", padding: "9px 11px", border: "1px solid rgba(48,54,61,0.6)" }}>
            <Box style={{ flexShrink: 0, width: "24px", height: "24px", borderRadius: "50%", display: "flex", alignItems: "center", justifyContent: "center", background: colorForName(msg.data.speaker) + "26", border: "1px solid " + colorForName(msg.data.speaker) + "59" }}>
              <Text style={{ color: colorForName(msg.data.speaker), fontSize: "11px", fontWeight: 700 }}>{initialOf(msg.data.speaker)}</Text>
            </Box>
            <Box style={{ minWidth: "0", flex: "1 1 auto" }}>
              <Box style={{ display: "flex", alignItems: "baseline", gap: "5px", marginBottom: "3px" }}>
                <Text style={{ color: colorForName(msg.data.speaker), fontSize: "11px", fontWeight: 700 }}>{msg.data.speaker}</Text>
                <Text style={{ color: "#484f58", fontSize: "9px" }}>to</Text>
                <Text style={{ color: "#8b949e", fontSize: "10px", flex: "1 1 auto", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{msg.data.listener}</Text>
                <Text if={msg.data.ai} style={{ color: "#7d8590", fontSize: "8px", fontWeight: 700, letterSpacing: "0.5px", flexShrink: 0, padding: "1px 4px", borderRadius: "4px", background: "rgba(88,166,255,0.12)", border: "1px solid rgba(88,166,255,0.25)" }}>AI</Text>
                <Text style={{ color: "#3d444d", fontSize: "9px", flexShrink: 0, fontVariantNumeric: "tabular-nums" }}>{msgTime(msg)}</Text>
              </Box>
              <Text style={{ color: "#c9d1d9", fontSize: "12px", lineHeight: "1.5" }}>{msg.data.content}</Text>
            </Box>
          </Box>
        #empty
          <Box style={{ margin: "auto", textAlign: "center", padding: "28px 18px" }}>
            <Text style={{ color: "#30363d", fontSize: "26px", display: "block", marginBottom: "10px" }}>💬</Text>
            <Text style={{ color: "#8b949e", fontSize: "12px", fontWeight: 600, display: "block" }}>Nobody has said anything yet</Text>
            <Text style={{ color: "#57606a", fontSize: "11px", lineHeight: "1.6", display: "block", marginTop: "6px" }}>Press Play and the office opens for the day. Load the AI model and the small talk becomes a real conversation.</Text>
          </Box>
        #end
      </Box>

      <!-- Who is in today, and what they are up to -->
      <Box style={{ borderTop: "1px solid rgba(48,54,61,0.9)", padding: "10px 12px", display: "flex", flexWrap: "wrap", gap: "5px", background: "rgba(13,17,23,0.6)" }}>
        #each (char, charIdx in characters)
          <Box style={{ display: "flex", alignItems: "center", gap: "5px", padding: "3px 8px", borderRadius: "999px", background: "rgba(22,27,34,0.9)", border: "1px solid rgba(48,54,61,0.7)" }}>
            <Box style={{ width: "6px", height: "6px", borderRadius: "50%", background: colorForIndex(charIdx) }} />
            <Text style={{ color: "#c9d1d9", fontSize: "10px", fontWeight: 600 }}>{char.data.name}</Text>
            <Text style={{ color: "#57606a", fontSize: "9px" }}>{charStatus(charIdx)}</Text>
          </Box>
        #end
      </Box>
    </Box>
  </Box>

  <!-- Loops -->
  <Loop interval={50} running={simRunning} @tick={movementTick} />
  <Loop interval={7000} running={simRunning} @tick={simulationTick} />
</App>
