// main.logic — SoftDOS Shell Application
//
// Bridges the SoftN UI runtime (<PixelCanvas>, <AudioStream>, <FileChooser>)
// with the x86 16/32-bit DOS emulation machine.

import "./dos_state.logic"
import "./dos_mmu.logic"
import "./dos_vga.logic"
import "./dos_kernel.logic"
import "./dos_progs.logic"
import "./dos_cpu.logic"
import "./dos_ops.logic"
import "./dos_bc.logic"
import "./dos_int.logic"
import "./dos_jit.logic"
import "./dos_loader.logic"
import "./dos_shell.logic"
import "./dos_mouse.logic"
import "./dos_zip.logic"
import "./dos_opl.logic"
import "./dos_sb.logic"

// ---------------------------------------------------------------------------
// Reactive UI State (scalars synchronized with React UI)
// ---------------------------------------------------------------------------
let activeMode = "prompt";          // "prompt", "plasma", "raycast", "custom"
let cpuModeText = "16-Bit Real Mode";
let fpsText = "60 FPS";
let statusText = "MS-DOS 6.22 Ready";
let loadedFileName = "";
let isRunning = true;
let isMuted = false;
let isExpanded = false;
let crtTheme = "color";
let keyMask = 0; // bit 0: Left, 1: Right, 2: Up, 3: Down, 4: Fire/Space
let mouseCursorStyle = "default";   // "none" while a program draws its own pointer
let programList = [];               // the .EXE and .COM files on drive C
let driveFileCount = 0;
let loadNote = "";                  // what the last load did
let soundText = "";                 // what the program is playing through: AdLib, Sound Blaster, speaker

// The keys a DOS program expects to get whole; the browser would otherwise
// scroll on the arrows and Space, search on "/", and so on. F11 and F12 stay
// the browser's, and so does any Ctrl+letter chord.
let CAPTURED_KEYS = ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", " ", "Tab", "Escape",
  "Backspace", "Home", "End", "PageUp", "PageDown", "Insert", "Delete", "Alt", "/", "'",
  "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10"];

let pcmBuffer = null; // Preallocated audio buffer
let pcmMix = null;    // the mix before it is clamped to 16 bits

function _init() {
  dosState_init();
  dosOps_init();
  dosVga_init();
  dosLoader_bootShell();
  cyclesText = "";

  pcmBuffer = new Int16Array(4096 * 2);
  pcmMix = new Float32Array(4096 * 2);
  dosOpl_init();
  dosSb_reset();
  dosOpl_accelInit();

  // Install keyboard listeners on the window. A key headed for one of the
  // page's own text fields is left alone.
  if (typeof window !== "undefined" && window.addEventListener) {
    window.addEventListener("keydown", function(e) {
      if (e && e.targetEditable === true) return;
      handleKeyEvent(e.key, true);
    });
    window.addEventListener("keyup", function(e) {
      if (e && e.targetEditable === true) return;
      handleKeyEvent(e.key, false);
    });
  }
  if (typeof softn !== "undefined" && softn.input && softn.input.captureKeys) {
    softn.input.captureKeys(CAPTURED_KEYS);
  }
  refreshProgramList();
}

// ---------------------------------------------------------------------------
// The mouse: the pointer over the screen, as a fraction of it each way. The
// canvas is scaled to fit its box, so the event's target rectangle is what
// places the pointer within the picture.
// ---------------------------------------------------------------------------
function mousePoint(e) {
  if (!e || e.targetTag !== "canvas") return 0;
  if (typeof e.targetWidth !== "number" || e.targetWidth <= 0 || e.targetHeight <= 0) return 0;
  let nx = (e.clientX - e.targetLeft) / e.targetWidth;
  let ny = (e.clientY - e.targetTop) / e.targetHeight;
  if (nx < 0) nx = 0; else if (nx > 0.9999) nx = 0.9999;
  if (ny < 0) ny = 0; else if (ny > 0.9999) ny = 0.9999;
  dosMouse_move(nx, ny);
  return 1;
}
function mouseButtonOf(e) {
  if (!e) return 0;
  if (e.button === 2) return 1;
  if (e.button === 1) return 2;
  return 0;
}
function mouseMove(e) { mousePoint(e); }
function mouseDown(e) { if (mousePoint(e) === 1) dosMouse_button(mouseButtonOf(e), 1); }
function mouseUp(e) { mousePoint(e); dosMouse_button(mouseButtonOf(e), 0); }
function mouseLeave() { dosMouse_releaseAll(); }

// Set 1 scan codes for the keys a DOS program asks about by scan code
// rather than by character.
let SCAN_MAP = {
  "Escape": 0x01, "Backspace": 0x0E, "Tab": 0x0F, "Enter": 0x1C,
  "Control": 0x1D, "Shift": 0x2A, "Alt": 0x38, " ": 0x39,
  "F1": 0x3B, "F2": 0x3C, "F3": 0x3D, "F4": 0x3E, "F5": 0x3F,
  "F6": 0x40, "F7": 0x41, "F8": 0x42, "F9": 0x43, "F10": 0x44,
  "Home": 0x47, "ArrowUp": 0x48, "PageUp": 0x49,
  "ArrowLeft": 0x4B, "ArrowRight": 0x4D,
  "End": 0x4F, "ArrowDown": 0x50, "PageDown": 0x51,
  "Insert": 0x52, "Delete": 0x53,
  "`": 0x29, "\\": 0x2B, "CapsLock": 0x3A, "NumLock": 0x45, "ScrollLock": 0x46,
  "F11": 0x57, "F12": 0x58
};
// Scan codes for the letter and digit rows, so a game reading the raw
// keyboard port sees what a real keyboard would send.
let SCAN_ROWS = ["1234567890-=", "qwertyuiop[]", "asdfghjkl;'", "zxcvbnm,./"];
let SCAN_ROW_BASE = [0x02, 0x10, 0x1E, 0x2C];

function scanForKey(key) {
  if (SCAN_MAP[key] !== undefined) return SCAN_MAP[key];
  if (key.length !== 1) return 0;
  let lower = key.toLowerCase();
  for (let r = 0; r < SCAN_ROWS.length; r++) {
    let idx = SCAN_ROWS[r].indexOf(lower);
    if (idx >= 0) return SCAN_ROW_BASE[r] + idx;
  }
  return 0;
}

function handleKeyEvent(key, isDown) {
  // The arrow keys and fire buttons also drive the built-in 3D demo, which
  // reads a bitmask rather than the BIOS buffer.
  let mask = 0;
  if (key === "ArrowLeft" || key === "a" || key === "A") mask = 0x01;
  else if (key === "ArrowRight" || key === "d" || key === "D") mask = 0x02;
  else if (key === "ArrowUp" || key === "w" || key === "W") mask = 0x04;
  else if (key === "ArrowDown" || key === "s" || key === "S") mask = 0x08;
  else if (key === " " || key === "Control") mask = 0x10;

  if (!isDown) {
    keyMask = keyMask & ~mask;
    let up = scanForKey(key);
    if (up !== 0) dosInt_pushScan(up | 0x80, 0);   // the break code
    return;
  }
  keyMask = keyMask | mask;

  let scan = scanForKey(key);
  let ascii = 0;
  if (key.length === 1) {
    let c = key.charCodeAt(0);
    if (c >= 32 && c < 127) ascii = c;
  } else if (key === "Enter") ascii = 13;
  else if (key === "Backspace") ascii = 8;
  else if (key === "Tab") ascii = 9;
  else if (key === "Escape") ascii = 27;

  if (scan === 0 && ascii === 0) return;
  // The make code, with its ASCII. A program that took over INT 9 reads the
  // port itself; the BIOS handler turns it into a word for INT 16h.
  dosInt_pushScan(scan, ascii);
}

// Hand the machine back to the prompt, whatever is running.
function quitToDos() {
  if (activeMode === "custom") dosShell_returnToPrompt("^C");
  soundText = "";
}

// ---------------------------------------------------------------------------
// Video Frame Producer (called on requestAnimationFrame by <PixelCanvas>)
// ---------------------------------------------------------------------------
// Cycles handed to the CPU per frame. This is a TIME budget in disguise: the
// emulator only draws once frameSource returns, so a budget that takes 375 ms
// to spend means the screen updates under three times a second however fast
// the CPU is underneath. The budget is retuned each frame toward a slice that
// leaves room to draw at 60 Hz, which costs no emulated throughput at all —
// the same cycles are simply handed over in more, smaller pieces.
let CPU_SLICE_MS = 20;    // wall-clock time a single slice should take
let CPU_BUDGET = 40000;   // cycles per frame; adapts from the first measurement
let runFrames = 0;        // frames the current program has had
let cyclesRun = 0;
let cyclesText = "";
let flipsAtStamp = 0;     // page flips seen at the last readout
let cyclesStamp = 0;
let lastFrameAt = 0;      // when the previous frame ran the CPU, for the clock

function updateCycleReadout() {
  let now = Date.now();
  if (cyclesStamp === 0) { cyclesStamp = now; cyclesRun = 0; return; }
  if (now - cyclesStamp >= 1000) {
    let mhz = cyclesRun / (now - cyclesStamp) / 1000;
    cyclesText = (mhz >= 1) ? ((Math.round(mhz * 10) / 10) + " MHz") : (Math.round(mhz * 1000) + " kHz");
    // Say when the host declined to accelerate, since that is a 10x difference.
    if (DOS_IS_32 === 1 && DOS_JIT_ACCEL === 0 && DOS_JIT_ACCEL_ERROR !== "") cyclesText += " · accel off: " + DOS_JIT_ACCEL_ERROR.slice(0, 80);
    // Frames the guest itself finished, when it page-flips. This is the number
    // that matters for a game; the repaint rate next to it is not.
    let flips = DOS_VGA_FLIPS - flipsAtStamp;
    flipsAtStamp = DOS_VGA_FLIPS;
    if (flips > 0) {
      let gfps = flips * 1000 / (now - cyclesStamp);
      cyclesText = cyclesText + " \u00b7 " + (Math.round(gfps * 10) / 10) + " game fps";
    }
    cyclesRun = 0;
    cyclesStamp = now;
  }
}

function frameSource() {
  if (!isRunning) return null;

  if (activeMode === "prompt") {
    dosShell_tick();
    cpuModeText = "16-Bit Real Mode";
  } else if (activeMode === "raycast") {
    dosLoader_tickRaycaster(keyMask);
    cpuModeText = "Built-in 3D demo";
  } else if (activeMode === "custom") {
    let before = DOS_TOTAL_CYCLES;
    let started = Date.now();
    dosCpu_runCycles(CPU_BUDGET);
    let spentMs = Date.now() - started;
    cyclesRun += DOS_TOTAL_CYCLES - before;
    // The emulated clock is the achieved rate, smoothed, so the PIT's ticks
    // (expressed in cycles) come at their real rate whatever the throughput.
    if (lastFrameAt > 0 && started > lastFrameAt) {
      let achieved = (DOS_TOTAL_CYCLES - before) * 1000 / (started - lastFrameAt);
      let hz = Math.floor(DOS_CPU_HZ * 0.8 + achieved * 0.2);
      DOS_CPU_HZ = (hz < 1000000) ? 1000000 : hz;
    }
    lastFrameAt = started;
    // Retune toward CPU_SLICE_MS. Date.now has millisecond granularity, so a
    // slice that reads as 0 ms is simply too small to measure: grow it.
    if (spentMs <= 0) {
      CPU_BUDGET = Math.min(2000000, Math.floor(CPU_BUDGET * 1.5) + 1000);
    } else {
      let want = Math.floor(CPU_BUDGET * (CPU_SLICE_MS / spentMs));
      // Move part of the way so one slow frame cannot swing the budget wildly.
      CPU_BUDGET = Math.floor(CPU_BUDGET + (want - CPU_BUDGET) * 0.35);
      if (CPU_BUDGET < 4000) CPU_BUDGET = 4000;
      if (CPU_BUDGET > 2000000) CPU_BUDGET = 2000000;
    }
    cpuModeText = DOS_IS_32 ? "32-Bit Protected Mode (DPMI)" : "16-Bit Real Mode";

    // A 32-bit extender image that runs for seconds without asking the
    // machine for anything and without drawing is not going to start: say so
    // rather than spin behind a blank screen.
    runFrames++;
    if (DOS_IS_32 === 1 && runFrames > 240 && DOS_INT_COUNT === 0 && DOS_VIDEO_MODE === 0x03) {
      dosShell_returnToPrompt("");
      dosKernel_printStr("This 32-bit image never asked the machine for anything,\r\n");
      dosKernel_printStr("so it did not load: its objects are mapped, but something\r\n");
      dosKernel_printStr("in the image is wrong. 16-bit .COM and .EXE programs run.\r\n");
      dosShell_prompt();
      return dosVga_getFrame();
    }

    // A 32-bit image that started properly, asked for services and then went
    // quiet in text mode is waiting on something that is not implemented.
    // Name it rather than spin: the last refusal is almost always the reason.
    if (DOS_IS_32 === 1 && runFrames > 900 && DOS_VIDEO_MODE === 0x03 &&
        DOS_INT_COUNT > 0 && DOS_UNHANDLED_INT >= 0) {
      dosShell_returnToPrompt("");
      dosKernel_printStr("\r\nThe program started, but stopped waiting on a service\r\n");
      dosKernel_printStr("SoftDOS does not implement: INT " +
                         DOS_UNHANDLED_INT.toString(16).toUpperCase() + "h function " +
                         DOS_UNHANDLED_FN.toString(16).toUpperCase() + "h, " +
                         DOS_UNHANDLED_COUNT + " calls refused.\r\n");
      dosKernel_printStr("Hardware interrupts are the usual missing piece: a game\r\n");
      dosKernel_printStr("that installs its own timer or keyboard handler needs\r\n");
      dosKernel_printStr("interrupt delivery, which SoftDOS does not have yet.\r\n");
      dosShell_prompt();
      return dosVga_getFrame();
    }

    // What is sounding, for the badge: the FM chip (on the host when the
    // accelerator compiled it), the DAC, the speaker.
    let snd = "";
    if (dosOpl_active() === 1) snd = (DOS_OPL_ACCEL >= 0) ? "AdLib (host)" : "AdLib";
    if (DOS_SB_ACTIVE === 1 && DOS_SB_SPEAKER === 1) snd += (snd !== "" ? " + " : "") + "Sound Blaster";
    if (DOS_SPEAKER_ON === 1) snd += (snd !== "" ? " + " : "") + "speaker";
    if (snd !== soundText) soundText = snd;

    // The host's pointer stands in for the driver's: hidden while a program
    // that uses the mouse has asked for it hidden, since it draws its own.
    let cursor = (DOS_MOUSE_USED === 1 && DOS_MOUSE_CURSOR < 0) ? "none" : "default";
    if (cursor !== mouseCursorStyle) mouseCursorStyle = cursor;

    // A program that stopped, by INT 20h, INT 21h/4Ch, HLT or an instruction
    // the CPU does not know, gives the machine back to the shell.
    if (DOS_HALTED) {
      let note = "";
      if (DOS_LAST_ILLEGAL >= 0) {
        note = "Unsupported instruction at " + DOS_LAST_ILLEGAL.toString(16).toUpperCase() + "h. Program stopped.";
        DOS_LAST_ILLEGAL = -1;
      }
      dosShell_returnToPrompt(note);
    }
  }

  return dosVga_getFrame();
}

function fpsReport(fps) {
  if (fps && fps.fps) {
    fpsText = Math.round(fps.fps) + " FPS";
  }
  updateCycleReadout();
}

// ---------------------------------------------------------------------------
// Audio Sample Producer (called by <AudioStream>)
// ---------------------------------------------------------------------------
// The speaker, the AdLib and the Sound Blaster's DAC, mixed. The devices
// are advanced here, paced by the audio clock, muted or not: the Sound
// Blaster's interrupts come from its samples being consumed.
function sampleSource(wantFrames) {
  if (!isRunning || !pcmBuffer) return null;
  let frames = (typeof wantFrames === "number" && wantFrames > 0) ? Math.floor(wantFrames) : 512;
  if (frames < 128) frames = 128;
  if (frames > 4096) frames = 4096;
  let n2 = frames * 2;
  let mix = pcmMix;
  for (let i = 0; i < n2; i++) mix[i] = 0;

  let freq = DOS_SPEAKER_ON ? DOS_SPEAKER_FREQ : 0;
  if (freq > 0) {
    let step = freq / 48000;
    for (let i = 0; i < frames; i++) {
      DOS_AUDIO_PHASE += step;
      if (DOS_AUDIO_PHASE >= 1) DOS_AUDIO_PHASE -= 1;
      let val = (DOS_AUDIO_PHASE < 0.5) ? 3000 : -3000;
      mix[i * 2] += val;
      mix[i * 2 + 1] += val;
    }
  }
  dosOpl_mix(mix, frames);
  dosSb_mix(mix, frames);

  for (let i = 0; i < n2; i++) {
    let v = mix[i];
    if (v > 32767) v = 32767; else if (v < -32768) v = -32768;
    pcmBuffer[i] = v;
  }
  let u8View = new Uint8Array(pcmBuffer.buffer, 0, frames * 4);
  return {
    pcm: u8View.toBase64(),
    frames: frames,
    rate: 48000
  };
}

// ---------------------------------------------------------------------------
// Mode Selectors & Quick Launch
// ---------------------------------------------------------------------------
function launchShell() {
  activeMode = "prompt";
  dosLoader_bootShell();
  statusText = "MS-DOS 6.22 Ready";
  cpuModeText = "16-Bit Real Mode";
  loadedFileName = "";
}

// Run one of the programs on the virtual drive, as if it had been typed.
function launchProgram(name) {
  if (activeMode !== "prompt") launchShell();
  let idx = dosKernel_vfsFind(name);
  if (idx < 0) { statusText = name + " is not on the drive"; return; }
  dosKernel_printStr(name + "\r\n");
  dosShell_run(name, idx);
}
function launchPlasma() { launchProgram("PLASMA.COM"); }
function launchMandel() { launchProgram("MANDEL.COM"); }
function launchBoxes() { launchProgram("BOXES.COM"); }
function launchHello() { launchProgram("HELLO.COM"); }

function launchRaycast() {
  activeMode = "raycast";
  dosState_reset();
  dosProgs_install();
  dosVga_init();
  DOS_VIDEO_MODE = 0x13;
  statusText = "Built-in 3D demo (drawn by the host, not emulated x86)";
  cpuModeText = "Built-in 3D demo";
}

function togglePause() {
  isRunning = !isRunning;
  statusText = isRunning ? "Running" : "Paused";
}

function toggleMute() {
  isMuted = !isMuted;
}

// ---------------------------------------------------------------------------
// Files onto drive C: a game's files as they are, or the zip they came in.
// ---------------------------------------------------------------------------
let filesAdded = [];       // names from the load in progress

function chooseFiles(files) {
  if (!files || files.length === 0) return;

  statusText = "Reading files...";
  let pending = files.length;
  filesAdded = [];

  for (let i = 0; i < files.length; i++) {
    let f = files[i];
    (function(file) {
      softn.files.readBase64(file.ref, function(res) {
        let b64 = romPayload(res);
        if (b64) {
          let bytes = Uint8Array.fromBase64(b64);
          if (dosZip_isZip(bytes)) {
            try {
              dosZip_extract(bytes, function(name, data) {
                let idx = dosKernel_vfsAdd(name, data);
                if (idx >= 0) filesAdded.push(DOS_VFS_NAMES[idx]);
                return idx;
              });
            } catch (err) {
              loadNote = file.name + ": " + String(err && err.message ? err.message : err);
            }
          } else {
            let idx = dosKernel_vfsAdd(file.name, bytes);
            if (idx >= 0) filesAdded.push(DOS_VFS_NAMES[idx]);
          }
          loadedFileName = file.name;
        }

        pending--;
        if (pending === 0) {
          onFilesReady();
        }
      });
    })(f);
  }
}

// The program a load most likely wants run: the largest .EXE or .COM among
// the files just added that is not an installer or a viewer.
function likelyProgram(names) {
  let best = "";
  let bestSize = -1;
  for (let i = 0; i < names.length; i++) {
    let n = names[i];
    if (!(n.endsWith(".EXE") || n.endsWith(".COM"))) continue;
    if (n.startsWith("SETUP") || n.startsWith("INSTALL") || n.startsWith("UNINST") ||
        n.startsWith("README") || n.startsWith("HELPME") || n.startsWith("CATALOG") ||
        n.startsWith("ORDER")) continue;
    let idx = dosKernel_vfsFind(n);
    let size = (idx >= 0 && DOS_VFS_DATA[idx]) ? DOS_VFS_DATA[idx].length : 0;
    if (size > bestSize) { bestSize = size; best = n; }
  }
  return best;
}

function refreshProgramList() {
  let list = [];
  for (let i = 0; i < DOS_VFS_COUNT; i++) {
    let n = DOS_VFS_NAMES[i];
    if (n !== "" && (n.endsWith(".EXE") || n.endsWith(".COM"))) list.push(n);
  }
  programList = list;
  let count = 0;
  for (let i = 0; i < DOS_VFS_COUNT; i++) if (DOS_VFS_NAMES[i] !== "") count++;
  driveFileCount = count;
}

function onFilesReady() {
  // Back to the prompt so the new files can be seen and run.
  if (activeMode !== "prompt") {
    activeMode = "prompt";
    DOS_VIDEO_MODE = 0x03;
    DOS_HALTED = 0;
    DOS_SHELL_ACTIVE = 1;
    DOS_CURSOR_VISIBLE = 1;
  }
  refreshProgramList();
  let run = likelyProgram(filesAdded);
  dosKernel_printStr("\r\n" + filesAdded.length + " file(s) added; " + driveFileCount + " on drive C.\r\n");
  if (run !== "") dosKernel_printStr("Type " + run + " to run it, or press Run.\r\n");
  dosShell_prompt();
  if (loadNote !== "") { statusText = loadNote; loadNote = ""; }
  else statusText = (run !== "") ? ("Ready: " + run) : (filesAdded.length + " file(s) on drive C:");
  loadedFileName = (run !== "") ? run : loadedFileName;
}

// A program picked from the list.
function runListed(name) {
  if (typeof name !== "string" || name === "") return;
  launchProgram(name);
  refreshProgramList();
}

function romPayload(result) {
  let s = result;
  if (s && typeof s === "object") {
    if (typeof s.data === "string") s = s.data;
    else if (typeof s.dataUrl === "string") s = s.dataUrl;
    else return "";
  }
  if (typeof s !== "string" || s === "") return "";
  let comma = s.indexOf(",");
  if (comma >= 0 && s.slice(0, 5) === "data:") return s.slice(comma + 1);
  return s;
}

function toggleExpanded() {
  isExpanded = !isExpanded;
}

function setCrtColor() {
  crtTheme = "color";
  dosVga_init();
}

function setCrtGreen() {
  crtTheme = "green";
  for (let i = 0; i < 256; i++) {
    let r = DOS_VGA_PAL[i * 3];
    let g = DOS_VGA_PAL[i * 3 + 1];
    let b = DOS_VGA_PAL[i * 3 + 2];
    let lum = Math.floor((r * 0.299 + g * 0.587 + b * 0.114));
    DOS_VGA_PAL[i * 3]     = 0;
    DOS_VGA_PAL[i * 3 + 1] = Math.min(255, Math.floor(lum * 1.2));
    DOS_VGA_PAL[i * 3 + 2] = 0;
  }
  DOS_VGA_PAL_REV++;
}

function setCrtAmber() {
  crtTheme = "amber";
  for (let i = 0; i < 256; i++) {
    let r = DOS_VGA_PAL[i * 3];
    let g = DOS_VGA_PAL[i * 3 + 1];
    let b = DOS_VGA_PAL[i * 3 + 2];
    let lum = Math.floor((r * 0.299 + g * 0.587 + b * 0.114));
    DOS_VGA_PAL[i * 3]     = Math.min(255, Math.floor(lum * 1.1));
    DOS_VGA_PAL[i * 3 + 1] = Math.min(255, Math.floor(lum * 0.7));
    DOS_VGA_PAL[i * 3 + 2] = 0;
  }
  DOS_VGA_PAL_REV++;
}

// On-screen Virtual D-Pad buttons for touch / clicks
function pressUp() { handleKeyEvent("ArrowUp", true); }
function releaseUp() { handleKeyEvent("ArrowUp", false); }
function pressDown() { handleKeyEvent("ArrowDown", true); }
function releaseDown() { handleKeyEvent("ArrowDown", false); }
function pressLeft() { handleKeyEvent("ArrowLeft", true); }
function releaseLeft() { handleKeyEvent("ArrowLeft", false); }
function pressRight() { handleKeyEvent("ArrowRight", true); }
function releaseRight() { handleKeyEvent("ArrowRight", false); }

// Dedicated action buttons (essential for Doom and DOS games on touch)
function pressFire() { handleKeyEvent("Control", true); }
function releaseFire() { handleKeyEvent("Control", false); }
function pressUse() { handleKeyEvent(" ", true); }
function releaseUse() { handleKeyEvent(" ", false); }
function pressEsc() { handleKeyEvent("Escape", true); }
function releaseEsc() { handleKeyEvent("Escape", false); }
function pressEnter() { handleKeyEvent("Enter", true); }
function releaseEnter() { handleKeyEvent("Enter", false); }
function pressKeyY() { handleKeyEvent("y", true); }
function releaseKeyY() { handleKeyEvent("y", false); }
function pressKeyN() { handleKeyEvent("n", true); }
function releaseKeyN() { handleKeyEvent("n", false); }
function pressAlt() { handleKeyEvent("Alt", true); }
function releaseAlt() { handleKeyEvent("Alt", false); }
function pressTab() { handleKeyEvent("Tab", true); }
function releaseTab() { handleKeyEvent("Tab", false); }
function pressF1() { handleKeyEvent("F1", true); }
function releaseF1() { handleKeyEvent("F1", false); }

