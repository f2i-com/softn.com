// Foundation fixture. One screen that proves three engine pieces against each
// other: S1 — the bundled .glb resolves through asset() to a non-empty URL;
// S2 — Scene3D drives a named glTF clip from the animation field and reports
// 'finished' / 'missing' through @animation; S3 — softn.audio.whenEnded says
// how a sound reached silence, and being cut off never reads as 'ended'.
// Every status line states its own pass condition, so a regression reads off
// the screen rather than out of the console.

let animPlaying = true
let animClip = "Spin"          // what the spec asks for; "Nope" exists on no model
let animEvents = []            // newest first — every @animation payload, verbatim

let beepStatus = "not played yet"
let beepHandle = ""
let beepStartedAt = 0

let lights = []

function _init() {
  lights = [
    { id: "ambient", type: "ambient", color: "#404060", intensity: 0.7 },
    { id: "key", type: "directional", color: "#ffffff", intensity: 1.4, position: { x: 4, y: 6, z: 5 } },
    { id: "fill", type: "point", color: "#818cf8", intensity: 0.6, position: { x: -4, y: 3, z: -3 } }
  ]
}

// The template resolves the model URL — asset() lives in the render context,
// not in .logic — and passes it in. A failed resolution arrives here as "".
function sceneObjects(glbUrl) {
  return [
    {
      id: "spinner",
      type: "model",
      modelUrl: glbUrl,
      position: { x: 0, y: 0, z: 0 },
      animation: { clip: animClip, playing: animPlaying, loop: "repeat", speed: 1 }
    }
  ]
}

function togglePlaying() {
  animPlaying = !animPlaying
}

// "Nope" is deliberately absent from the model: the spec change must surface
// as one @animation missing event, while the already-playing clip carries on.
function requestMissingClip() {
  animClip = "Nope"
}

function requestSpin() {
  animClip = "Spin"
}

function handleAnimation(info) {
  if (!info) { return }
  animEvents.unshift({ objectId: info.objectId, clip: info.clip, type: info.type })
  if (animEvents.length > 6) { animEvents.pop() }
  animEvents = animEvents.slice()     // reassign so the binding sees a new array
}

function playBeep() {
  beepStatus = "requesting..."
  softn.audio.play("assets/audio/beep.wav", {}, function (r) {
    if (r && r.played && r.handle) {
      beepHandle = r.handle
      beepStartedAt = Date.now()
      beepStatus = "playing (" + r.handle + ")"
      softn.audio.whenEnded(r.handle, function (o) {
        if (!o) { return }
        if (o.status === "ended") {
          beepStatus = "ended after " + (Date.now() - beepStartedAt) + "ms"
        } else if (o.status === "stopped") {
          beepStatus = "stopped"
        } else {
          beepStatus = "error: " + (o.reason || "unknown")
        }
        beepHandle = ""
      })
    } else if (r && r.blocked) {
      beepStatus = "blocked — interact with the page first, then retry"
    } else {
      beepStatus = "could not play" + (r && r.reason ? ": " + r.reason : "")
    }
  })
}

function stopBeep() {
  if (!beepHandle) { return }
  softn.audio.stop(beepHandle)
}
