  function sampleRow(s, y, dst) {
    let W = outW, plane = s.plane, pw = s.planeW;
    if (s.full) { let base = Math.min(s.planeH - 1, y) * pw; for (let x = 0; x < W; x++) dst[x] = plane[base + x]; return; }
    let cy = (y + 0.5) * s.fy - 0.5;
    if (cy < 0) cy = 0;
    let r0 = Math.floor(cy), maxY = s.planeH - 1;
    if (r0 > maxY) r0 = maxY;
    let r1 = r0 + 1 > maxY ? maxY : r0 + 1;
    let wy = cy - r0;
    let a = hrow(s, r0, -1);
    if (r1 === r0 || wy === 0) { for (let x = 0; x < W; x++) dst[x] = (a[x] + 0.5) | 0; return; }
    let bRow = hrow(s, r1, r0);
    let w0 = 1 - wy, w1 = wy;
    for (let x = 0; x < W; x++) dst[x] = (a[x] * w0 + bRow[x] * w1 + 0.5) | 0;
  }
