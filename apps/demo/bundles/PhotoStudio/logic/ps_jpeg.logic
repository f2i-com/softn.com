  // ones are upsampled with a triangle filter (libjpeg's "fancy" upsampling):
  // the sample for output x lies at chroma coordinate (x + 0.5) * f - 0.5.
  function makeSampler(c) {
    let fx = c.h / hmax, fy = c.v / vmax;
    if (fx === 1 && fy === 1) return { full: true, plane: c.plane, planeW: c.planeW, planeH: c.planeH, x0: null, wx: null, fy: 1 };
    let W = outW;
    let x0 = new Int32Array(W), x1 = new Int32Array(W), wx = new Float32Array(W);
    let maxX = c.planeW - 1;
    for (let x = 0; x < W; x++) {
      let cx = (x + 0.5) * fx - 0.5;
      if (cx < 0) cx = 0;
      let i0 = Math.floor(cx);
      if (i0 > maxX) i0 = maxX;
      let i1 = i0 + 1 > maxX ? maxX : i0 + 1;
      x0[x] = i0; x1[x] = i1; wx[x] = cx - i0;
    }
