// ---------------------------------------------------------------------------
// Colour adjustments (in place on rows [y0, y1); selection weights the change)
// ---------------------------------------------------------------------------
function psAdjustRows(data, w, y0, y1, kind, amount, selection) {
  let a = Number(amount);
  if (!Number.isFinite(a)) psFail("Adjustment amount must be finite.");
  let contrast = (259 * (psClamp(a, -100, 100) * 2.55 + 255)) / (255 * (259 - psClamp(a, -100, 100) * 2.55));
  let levels = Math.max(2, Math.round(a || 6));
  let bright = a * 2.55, expo = Math.pow(2, a), satk = 1 + a / 100, gammaInv = 1 / psClamp(a, 0.1, 5);
  let hu = Math.cos(a * Math.PI / 180), hv = Math.sin(a * Math.PI / 180);
  let m00 = 0.213 + hu * 0.787 - hv * 0.213, m01 = 0.715 - hu * 0.715 - hv * 0.715, m02 = 0.072 - hu * 0.072 + hv * 0.928;
  let m10 = 0.213 - hu * 0.213 + hv * 0.143, m11 = 0.715 + hu * 0.285 + hv * 0.140, m12 = 0.072 - hu * 0.072 - hv * 0.283;
  let m20 = 0.213 - hu * 0.213 - hv * 0.787, m21 = 0.715 - hu * 0.715 + hv * 0.715, m22 = 0.072 + hu * 0.928 + hv * 0.072;
  let k = kind === "brightness" ? 1 : kind === "contrast" ? 2 : kind === "exposure" ? 3 : kind === "saturation" ? 4 : kind === "grayscale" ? 5 : kind === "invert" ? 6 :
    kind === "threshold" ? 7 : kind === "posterize" ? 8 : kind === "sepia" ? 9 : kind === "gamma" ? 10 : kind === "hue" ? 11 : 0;
  if (!k) psFail("Unknown adjustment: " + kind);
  let sel = selection || null;
  let lut = null;
  // Per-channel operations use a lookup table: identical results, far fewer operations per pixel.
  if (k === 1 || k === 2 || k === 3 || k === 6 || k === 8 || k === 10) {
    lut = new Uint8Array(256);
    for (let v = 0; v < 256; v++) {
      let o;
      if (k === 1) o = v + bright; else if (k === 2) o = contrast * (v - 128) + 128; else if (k === 3) o = v * expo; else if (k === 6) o = 255 - v;
      else if (k === 8) o = Math.round(v / 255 * (levels - 1)) / (levels - 1) * 255; else o = 255 * Math.pow(v / 255, gammaInv);
      lut[v] = psByte(o);
    }
  }
  let d = data;
  for (let p = y0 * w, end = y1 * w; p < end; p++) {
    let i = p * 4;
    let r = d[i], g = d[i + 1], b = d[i + 2];
    let R, G, B;
    if (lut) { R = lut[r]; G = lut[g]; B = lut[b]; }
    else {
      let l = 0.2126 * r + 0.7152 * g + 0.0722 * b;
      if (k === 4) { R = l + (r - l) * satk; G = l + (g - l) * satk; B = l + (b - l) * satk; }
      else if (k === 5) { R = l; G = l; B = l; }
      else if (k === 7) { R = l >= a ? 255 : 0; G = R; B = R; }
      else if (k === 9) { R = r * 0.393 + g * 0.769 + b * 0.189; G = r * 0.349 + g * 0.686 + b * 0.168; B = r * 0.272 + g * 0.534 + b * 0.131; }
      else { R = m00 * r + m01 * g + m02 * b; G = m10 * r + m11 * g + m12 * b; B = m20 * r + m21 * g + m22 * b; }
      if (R < 0) R = 0; else if (R > 255) R = 255;
      if (G < 0) G = 0; else if (G > 255) G = 255;
      if (B < 0) B = 0; else if (B > 255) B = 255;
    }
    if (sel) {
      let wgt = sel[p];
      if (wgt === 0) continue;
      if (wgt < 255) { let t = wgt / 255; R = r + (R - r) * t; G = g + (G - g) * t; B = b + (B - b) * t; }
    }
    d[i] = (R + 0.5) | 0; d[i + 1] = (G + 0.5) | 0; d[i + 2] = (B + 0.5) | 0;
  }
}

// 3x3 sharpen from src into dst (dst may not alias src), rows [y0, y1).
function psSharpenRows(src, dst, w, h, y0, y1, strength, selection) {
  let s = psClamp(strength, 0, 5), sel = selection || null;
  for (let y = y0; y < y1; y++) {
    let up = y > 0 ? y - 1 : 0, dn = y < h - 1 ? y + 1 : h - 1;
    for (let x = 0; x < w; x++) {
      let p = y * w + x, i = p * 4;
      let wgt = sel ? sel[p] / 255 : 1;
      if (wgt === 0) { dst[i] = src[i]; dst[i + 1] = src[i + 1]; dst[i + 2] = src[i + 2]; dst[i + 3] = src[i + 3]; continue; }
      let l = (y * w + (x > 0 ? x - 1 : 0)) * 4, r = (y * w + (x < w - 1 ? x + 1 : w - 1)) * 4, t = (up * w + x) * 4, b = (dn * w + x) * 4;
      let f = wgt * s;
      for (let c = 0; c < 3; c++) {
        let v = src[i + c] + f * (4 * src[i + c] - src[l + c] - src[r + c] - src[t + c] - src[b + c]);
        dst[i + c] = v < 0 ? 0 : v > 255 ? 255 : (v + 0.5) | 0;
      }
      dst[i + 3] = src[i + 3];
    }
  }
}

// ---------------------------------------------------------------------------
// Box blur passes (running sums, replicated edges). ch = 4 (RGBA) or 1 (mask).
// Horizontal over rows [y0, y1); vertical over columns [x0, x1).
// ---------------------------------------------------------------------------
function psBoxBlurRows(src, dst, w, h, y0, y1, r, ch) {
  if (r < 1) { for (let i = y0 * w * ch, end = y1 * w * ch; i < end; i++) dst[i] = src[i]; return; }
  let inv = 1 / (2 * r + 1);
  for (let y = y0; y < y1; y++) {
    let row = y * w * ch;
    for (let c = 0; c < ch; c++) {
      let base = row + c;
      let first = src[base], last = src[base + (w - 1) * ch];
      let sum = (r + 1) * first;
      for (let k = 0; k < r; k++) sum += src[base + (k < w ? k : w - 1) * ch];
      for (let x = 0; x < w; x++) {
        let addX = x + r, subX = x - r - 1;
        sum += (addX < w ? src[base + addX * ch] : last) - (subX >= 0 ? src[base + subX * ch] : first);
        dst[base + x * ch] = (sum * inv + 0.5) | 0;
      }
    }
  }
