    objs = objs.concat(fig("priya", 6, 12.6, Math.PI, "#7c3aed", "#8a5a3a", { hair: "#1f2937" }))
    objs.push({ id: "priya_box", type: "box", position: { x: 6.8, y: 0.25, z: 12.6 }, width: 0.6, height: 0.5, depth: 0.5, color: "#8a6f4d" })
  }
  objs.push({ id: "flpatch", type: "plane", position: { x: 12, y: 0.006, z: 4 }, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 6, height: 4, color: "#463930" })
  flatStatic = objs
  objects = flatStatic
  let ls = [
    { id: "amb", type: "ambient", color: "#d9b38c", intensity: flatAmbient() },
    { id: "hemi", type: "hemisphere", color: "#eed3ac", groundColor: "#4a3a2a", intensity: 1.0 },
    { id: "lamp", type: "point", color: "#fbbf6b", intensity: 2.6, position: { x: 1.4, y: 1.7, z: 1.6 } },
    { id: "dirw", type: "directional", color: "#e8c9a0", intensity: 0.5, position: { x: 14, y: 10, z: 16 } },
    { id: "win", type: "point", color: "#94a8ff", intensity: 0.7, position: { x: 9, y: 1.8, z: 2 } }
  ]
  if (!isCancelled("mindful")) { ls.push({ id: "gl_spk", type: "point", color: "#22d3ee", intensity: 0.8, position: { x: 6, y: 1.4, z: 1.8 } }) }
  if (!isCancelled("clouds"))  { ls.push({ id: "gl_mon", type: "point", color: "#38bdf8", intensity: 0.7, position: { x: 3.4, y: 1.5, z: 2.2 } }) }
  if (!isCancelled("copilot")) { ls.push({ id: "gl_kbd", type: "point", color: "#e879f9", intensity: 0.6, position: { x: 2, y: 1.3, z: 2.6 } }) }
  lights = ls
  hotspots = [
    { id: "hs_laptop", x: 2,  z: 2, r: 2.0, label: budgetDone ? "Laptop — Patchwork notes" : "Laptop — face the numbers" },
    { id: "hs_phone",  x: 16, z: 2, r: 1.9, label: phoneRinging ? "Phone — Mum calling" : "Phone" },
    { id: "hs_luma",   x: 14, z: 8, r: 2.0, label: budgetDone ? "The old LUMA project" : "Old side project (later)" }
  ]
  if (priyaHere) { hotspots.push({ id: "hs_priya", x: 6, z: 12.6, r: 2.2, label: scopeDone ? "Priya" : (priyaMode === "" ? "The door — Priya" : "Priya — the Scope Board") }) }
  flatStatic = flatStatic.concat(hotspotMarkers())
  objects = flatStatic
}

function flatAmbient() {
  let n = 0
  for (let i = 0; i < SUBS.length; i++) { if (!SUBS[i].locked && isCancelled(SUBS[i].id)) { n = n + 1 } }
  return Math.max(0.65, 1.35 - n * 0.11)
}

// ---- Bakery ---------------------------------------------------------------

let bakeryStatic = []

function buildBakery() {
  loadGrid(BAKERY_ROWS)
  sceneFog = { color: "#2b1f14", near: 12, far: 36 }
  sceneBg = "#170f08"
  let objs = [floorPlane(24, 16, "#4a3a29"), ceilingPlane(24, 16, 2.5, "#2b2015")]
  objs = objs.concat(wallsFrom(BAKERY_ROWS, "#54413a", 2.5))
  // Counter island with warm top and glass front.
  objs.push({ id: "counterTop", type: "box", position: { x: 11, y: 1.02, z: 8 }, width: 8.4, height: 0.1, depth: 4.4, color: "#8a6f4d", roughness: 0.6 })
  objs.push({ id: "glass", type: "box", position: { x: 11, y: 0.6, z: 10.2 }, width: 8.2, height: 0.8, depth: 0.08, color: "#cbd5e1", opacity: 0.22 })
  // Goods on the counter: donuts and buns.
  let donutCols = ["#f4a4c0", "#b8763e", "#f7dba7"]
  for (let i = 0; i < 3; i++) {
    objs.push({ id: "donut" + i, type: "torus", position: { x: 8.6 + i * 1.1, y: 1.16, z: 9.3 },
      rotation: { x: -Math.PI / 2, y: 0, z: 0 }, radius: 0.16, color: donutCols[i], roughness: 0.9 })
  }
  for (let i = 0; i < 3; i++) {
    objs.push({ id: "bun" + i, type: "sphere", position: { x: 12.4 + i * 0.8, y: 1.18, z: 9.0 }, radius: 0.16, color: "#d9a05f", roughness: 1 })
  }
  objs.push({ id: "cakebox", type: "box", position: { x: 13.6, y: 1.2, z: 7.2 }, width: 0.6, height: 0.3, depth: 0.6, color: "#f8e8ff" })
  // Actual goods: croissants in a row, a proper cake, cupcakes.
  for (let i = 0; i < 3; i++) {
    objs = objs.concat(croissantAt("cro" + i, 9.2 + i * 0.65, 1.14, 7.4, 0.4 + i * 0.7))
  }
  objs = objs.concat(cakeAt("cake1", 11.8, 1.07, 7.2))
  let frost = ["#f4a4c0", "#a78bfa", "#86efac"]
  for (let i = 0; i < 3; i++) {
    objs = objs.concat(cupcakeAt("cup" + i, 10.6 + i * 0.45, 1.07, 8.6, frost[i]))
  }
  // Shelves along the west wall with loaves.
  objs.push({ id: "shelf1", type: "box", position: { x: 1.4, y: 1.0, z: 8 }, width: 0.6, height: 0.08, depth: 6, color: "#7a5f43" })
  objs.push({ id: "shelf2", type: "box", position: { x: 1.4, y: 1.7, z: 8 }, width: 0.6, height: 0.08, depth: 6, color: "#7a5f43" })
  for (let i = 0; i < 5; i++) {
    objs.push({ id: "loaf" + i, type: "cylinder", position: { x: 1.4, y: 1.16, z: 5.6 + i * 1.2 },
      rotation: { x: Math.PI / 2, y: 0, z: 0 }, radius: 0.16, height: 0.55, color: "#c68b4e", roughness: 1 })
  }
  for (let i = 0; i < 4; i++) {
    objs.push({ id: "loaf2_" + i, type: "sphere", position: { x: 1.4, y: 1.9, z: 6 + i * 1.3 }, radius: 0.17, color: "#e0b078", roughness: 1 })
  }
  // The oven, glowing patiently.
  objs.push({ id: "oven", type: "box", position: { x: 6.5, y: 0.8, z: 13.2 }, width: 1.8, height: 1.6, depth: 1.0, color: "#3a3a40" })
  objs.push({ id: "ovenDoor", type: "box", position: { x: 6.5, y: 0.7, z: 12.68 }, width: 1.2, height: 0.5, depth: 0.06,
    color: "#1a1a1e", emissive: "#f97316", emissiveIntensity: 0.9 })
  // Flour sacks and a menu board.
  objs.push({ id: "sack1", type: "box", position: { x: 21.5, y: 0.4, z: 12.5 }, width: 0.8, height: 0.8, depth: 0.7, color: "#d8cbb4" })
  objs.push({ id: "sack2", type: "box", position: { x: 21.0, y: 0.35, z: 13.4 }, width: 0.7, height: 0.7, depth: 0.6, color: "#c9bca3" })
  objs.push({ id: "menu", type: "box", position: { x: 11, y: 1.9, z: 14.9 }, width: 3.2, height: 1.1, depth: 0.08, color: "#26201a" })
  for (let i = 0; i < 3; i++) {
    objs.push({ id: "menuline" + i, type: "box", position: { x: 10.4 + (i % 2) * 0.4, y: 2.15 - i * 0.25, z: 14.84 },
      width: 1.8 - (i % 2) * 0.5, height: 0.06, depth: 0.02, color: "#e8dcc4", emissive: "#e8dcc4", emissiveIntensity: 0.3 })
  }
  // Pendant lamps.
  let pendants = [[6, 8], [16, 5]]
  for (let i = 0; i < pendants.length; i++) {
    objs.push({ id: "pend" + i + "_c", type: "cylinder", position: { x: pendants[i][0], y: 2.3, z: pendants[i][1] }, radius: 0.02, height: 0.4, color: "#26201a" })
    objs.push({ id: "pend" + i + "_b", type: "sphere", position: { x: pendants[i][0], y: 2.0, z: pendants[i][1] }, radius: 0.16,
      color: "#ffca85", emissive: "#ffca85", emissiveIntensity: 1.7 })
  }
  // The duelling tablets, the paper board, and the door.
  objs.push({ id: "tabApost", type: "box", position: { x: 4, y: 0.7, z: 4.05 }, width: 0.1, height: 0.7, depth: 0.1, color: "#26201a" })
  objs.push({ id: "hs_tabA", type: "box", position: { x: 4, y: 1.12, z: 4 }, rotation: { x: -0.28, y: 0, z: 0 },
    width: 0.55, height: 0.4, depth: 0.05, color: "#0b1220", emissive: ordersDone ? "#4ade80" : "#38bdf8", emissiveIntensity: 1.1 })
  objs.push({ id: "tabBpost", type: "box", position: { x: 18, y: 0.7, z: 4.05 }, width: 0.1, height: 0.7, depth: 0.1, color: "#26201a" })
  objs.push({ id: "hs_tabB", type: "box", position: { x: 18, y: 1.12, z: 4 }, rotation: { x: -0.28, y: 0, z: 0 },
    width: 0.55, height: 0.4, depth: 0.05, color: "#0b1220", emissive: ordersDone ? "#4ade80" : "#f87171", emissiveIntensity: 1.1 })
  objs.push({ id: "hs_paper", type: "box", position: { x: 20, y: 1.4, z: 8 }, width: 1.6, height: 1.1, depth: 0.08,
    color: "#efe6cf", emissive: "#efe6cf", emissiveIntensity: ordersDone ? 0.12 : 0.4 })
  for (let i = 0; i < 4; i++) {
    objs.push({ id: "slip" + i, type: "box", position: { x: 19.6 + (i % 2) * 0.7, y: 1.55 - Math.floor(i / 2) * 0.4, z: 7.94 },
      width: 0.4, height: 0.28, depth: 0.02, color: "#fdf6e3", rotation: { x: 0, y: 0, z: (i % 2 === 0 ? 0.06 : -0.08) } })
  }
  objs.push({ id: "hs_exit", type: "box", position: { x: 22, y: 1.1, z: 2 }, width: 0.3, height: 2.2, depth: 1.6,
    color: "#2a2018", emissive: "#f59e0b", emissiveIntensity: pilotPromised ? 1.1 : 0.18 })
  // Mabel and Leo, properly assembled.
  objs = objs.concat(fig("mabel", 4, 10, 0, "#b45309", "#8a5a3a", { apron: "#fef3c7", hair: "#3f2d23" }))
  objs = objs.concat(fig("leo", 16.5, 5, -0.7, "#3f6212", "#a16207", { cap: "#365314", hair: "#1f2937" }))
  // Steam over the oven, and a warm floor patch behind the counter.
  for (let i = 0; i < 3; i++) {
    objs.push({ id: "steam" + i, type: "sphere", position: { x: 6.1 + i * 0.4, y: 1.8 + i * 0.25, z: 13 }, radius: 0.12 + i * 0.04,
      color: "#f8fafc", opacity: 0.16, animate: { floatAmplitude: 0.1, floatSpeed: 0.8 + i * 0.3 } })
  }
  objs.push({ id: "bpatch", type: "plane", position: { x: 11, y: 0.006, z: 11.5 }, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 9, height: 4, color: "#54432f" })
  if (bakeryDay) {
    objs = objs.concat(fig("cust1", 8, 3, 2.6, "#7a8ba8", "#d4b394", { hair: "#4a3628" }))
    objs = objs.concat(fig("cust2", 10.5, 2.6, 3.0, "#a8707a", "#8a5a3a", { hair: "#22262e" }))
    if (priyaMode !== "alone" && priyaMode !== "") {
      objs = objs.concat(fig("priya2", 14, 4.5, -0.6, "#7c3aed", "#8a5a3a", { hair: "#1f2937" }))
    }
  }
  bakeryStatic = objs
  objects = bakeryStatic
  if (bakeryDay) {
    sceneFog = { color: "#443322", near: 16, far: 44 }
    sceneBg = "#241812"
    lights = [
      { id: "amb", type: "ambient", color: "#f5dfc0", intensity: 2.2 },
      { id: "hemi", type: "hemisphere", color: "#fdf0da", groundColor: "#7a6248", intensity: 1.5 },
      { id: "day", type: "directional", color: "#fff2d8", intensity: 0.9, position: { x: 20, y: 12, z: 2 } },
      { id: "warm1", type: "point", color: "#ffd9a0", intensity: 2.2, position: { x: 6, y: 2.0, z: 8 } },
      { id: "warm2", type: "point", color: "#ffd9a0", intensity: 2.0, position: { x: 16, y: 2.0, z: 5 } },
      { id: "ovenGlow", type: "point", color: "#f97316", intensity: 1.2, position: { x: 6.5, y: 0.9, z: 12.2 } }
    ]
  } else {
  lights = [
    { id: "amb", type: "ambient", color: "#eccda6", intensity: 1.9 },
    { id: "hemi", type: "hemisphere", color: "#f7dfc0", groundColor: "#6a543f", intensity: 1.2 },
    { id: "dirb", type: "directional", color: "#f2d3a4", intensity: 0.5, position: { x: 18, y: 10, z: 14 } },
    { id: "warm1", type: "point", color: "#ffca85", intensity: 2.6, position: { x: 6, y: 2.0, z: 8 } },
    { id: "warm2", type: "point", color: "#ffca85", intensity: 2.4, position: { x: 16, y: 2.0, z: 5 } },
    { id: "ovenGlow", type: "point", color: "#f97316", intensity: 1.0, position: { x: 6.5, y: 0.9, z: 12.2 } }
  ]
  }
  hotspots = [
    { id: "hs_tabA",  x: 4,  z: 4,  r: 1.9, label: ordersDone ? "Delivery tablet A (at peace)" : "Delivery tablet A" },
    { id: "hs_tabB",  x: 18, z: 4,  r: 1.9, label: ordersDone ? "Delivery tablet B (at peace)" : "Delivery tablet B" },
    { id: "hs_paper", x: 20, z: 8,  r: 1.9, label: bakeryDay ? (wfDone ? "The policy board" : "The workflow board") : "The paper orders" },
    { id: "hs_mabel", x: 4,  z: 10, r: 2.2, label: "Mabel" },
    { id: "hs_exit",  x: 22, z: 2,  r: 2.0, label: bakeryDay ? (wfDone ? "Home. Tuesday is tomorrow" : "The door (not yet)") : (pilotPromised ? "Head home and build" : "The door") }
  ]
  bakeryStatic = bakeryStatic.concat(hotspotMarkers())
  objects = bakeryStatic
}

// ---- The Infinite Stand-up ------------------------------------------------

let dreamStaticBase = []
let dreamChairAngle = 0
let dreamTickets = []

function buildDream() {
  loadGrid(DREAM_ROWS)
  if (dreamCalm) {
    sceneFog = { color: "#0c1018", near: 8, far: 34 }
    sceneBg = "#080b10"
  } else {
    sceneFog = { color: "#05060a", near: 2.5, far: 12 + dreamLoop * 1.5 }
    sceneBg = "#040508"
  }
  let objs = [floorPlane(22, 14, "#0e1119"), ceilingPlane(22, 14, 2.8, "#090b12")]
  objs = objs.concat(wallsFrom(DREAM_ROWS, "#141926", 2.8))
  // The whiteboard everything orbits.
  objs.push({ id: "wboard", type: "box", position: { x: 10, y: 1.4, z: 6 }, width: 2.4, height: 1.4, depth: 0.1,
    color: "#e5e7eb", emissive: "#e5e7eb", emissiveIntensity: dreamCalm ? 0.5 : 0.22 })
  objs.push({ id: "wboard_leg", type: "cylinder", position: { x: 10, y: 0.35, z: 6 }, radius: 0.05, height: 0.7, color: "#1f2430" })
  // Desks drained of colour.
  let dDesks = [[4, 10], [16, 10], [4, 3], [16, 3]]
  for (let i = 0; i < dDesks.length; i++) {
    objs = objs.concat(deskAt("ddesk" + i, dDesks[i][0], dDesks[i][1], ""))
  }
  // Ticket cards, glowing like accusations.
  if (dreamTickets.length === 0) {
    for (let i = 0; i < 9; i++) {
      dreamTickets.push({ x: 3 + myRand() * 14, y: 1.1 + myRand() * 0.9, z: 2.5 + myRand() * 8, ph: myRand() * 6 })
    }
  }
  if (!dreamCalm) {
    for (let i = 0; i < dreamTickets.length; i++) {
      let t = dreamTickets[i]
      objs.push({ id: "ticket" + i, type: "box", position: { x: t.x, y: t.y, z: t.z },
        rotation: { x: 0, y: t.ph, z: 0 }, width: 0.4, height: 0.28, depth: 0.02,
        color: "#241a05", emissive: "#f59e0b", emissiveIntensity: 0.9,
        animate: { floatAmplitude: 0.08, floatSpeed: 0.9 + (i % 3) * 0.3 } })
    }
    // PAX presides.
    objs.push({ id: "dpax", type: "torus", position: { x: 10, y: 2.2, z: 6 }, radius: 0.4,
      color: "#f8fafc", emissive: "#fb7185", emissiveIntensity: 1.3,
      animate: { rotateY: 0.03, floatAmplitude: 0.1, floatSpeed: 1.1 } })
    // Clive silhouettes multiply with every loop.
    let n = Math.min(2 + dreamLoop * 2, 10)
    for (let i = 0; i < n; i++) {
      let a = (i / n) * Math.PI * 2
      let sx = 10 + Math.sin(a) * (6 + (i % 2))
      let sz = 6 + Math.cos(a) * (3.6 + (i % 2) * 0.6)
      objs = objs.concat(fig("sil" + i, sx, sz, a + Math.PI, "#0a0d14", "#0a0d14"))
    }
  }
  // The door: an exit, or the UNKNOWN door once the room goes quiet.
  objs.push({ id: "hs_dreamdoor", type: "box", position: { x: 20, y: 1.1, z: 10 }, width: 0.3, height: 2.2, depth: 1.6,
    color: dreamCalm ? "#f8fafc" : "#1a1f2c",
    emissive: dreamCalm ? "#f8fafc" : "#64748b", emissiveIntensity: dreamCalm ? 1.6 : 0.4 })
  dreamStaticBase = objs
  objects = dreamStaticBase.concat(dreamCalm ? dreamChairObjs(true) : dreamChairObjs(false))
  lights = dreamCalm ? [
    { id: "amb", type: "ambient", color: "#c7d2e8", intensity: 1.1 },
    { id: "door", type: "point", color: "#f8fafc", intensity: 2.6, position: { x: 19, y: 1.6, z: 10 } }
  ] : [
    { id: "amb", type: "ambient", color: "#4a5570", intensity: 0.8 },
    { id: "board", type: "point", color: "#e5e7eb", intensity: 1.4, position: { x: 10, y: 2, z: 6 } },
    { id: "red", type: "point", color: "#fb7185", intensity: 0.9, position: { x: 10, y: 2.4, z: 6 } }
  ]
  hotspots = [
    { id: "hs_dreamdoor", x: 20, z: 10, r: 2.2, label: dreamCalm ? "The UNKNOWN door" : "The exit" }
  ]
  dreamStaticBase = dreamStaticBase.concat(hotspotMarkers(dreamCalm ? "#f8fafc" : "#64748b"))
  objects = dreamStaticBase.concat(dreamChairObjs(dreamCalm))
}

function dreamChairObjs(frozen) {
  let out = []
  for (let i = 0; i < 5; i++) {
    let a = dreamChairAngle + (i / 5) * Math.PI * 2
    let cx = 10 + Math.sin(a) * 2.6
    let cz = 6 + Math.cos(a) * 2.6
    out = out.concat(chairAt("dchair" + i, cx, cz, a + Math.PI, frozen ? "#3a4356" : "#232b3b"))
  }
  return out
}

function dreamTick() {
  if (dreamCalm) { return }
  dreamChairAngle = dreamChairAngle + 0.01 + dreamLoop * 0.008
  objects = dreamStaticBase.concat(dreamChairObjs(false))
}
