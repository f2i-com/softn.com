function psBoxBlurCols(src, dst, w, h, x0, x1, r, ch) {
  if (r < 1) { for (let y = 0; y < h; y++) for (let x = x0; x < x1; x++) for (let c = 0; c < ch; c++) { let i = (y * w + x) * ch + c; dst[i] = src[i]; } return; }
  let inv = 1 / (2 * r + 1), stride = w * ch;
  for (let x = x0; x < x1; x++) {
    for (let c = 0; c < ch; c++) {
      let base = x * ch + c;
      let first = src[base], last = src[base + (h - 1) * stride];
      let sum = (r + 1) * first;
      for (let k = 0; k < r; k++) sum += src[base + (k < h ? k : h - 1) * stride];
      for (let y = 0; y < h; y++) {
        let addY = y + r, subY = y - r - 1;
        sum += (addY < h ? src[base + addY * stride] : last) - (subY >= 0 ? src[base + subY * stride] : first);
        dst[base + y * stride] = (sum * inv + 0.5) | 0;
