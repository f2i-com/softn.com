// Snake on a 20×20 PixelGrid. One loop moves the snake while a game is on;
// a slow idle loop picks up "start" and "pause" from the keyboard and the pad
// in between, so every control works whether or not the board is moving.

let gridItems = []
let score = 0
let highScore = 0
let running = false
let paused = false
let speed = 150
let overlayText = "Press Start"
let snake = []
let snakeLength = 3
let food = null
let direction = "right"
let gameOver = false
let newBest = false
let muted = false
// When the last game ended. A key still being mashed at the moment of death
// must not start the next game before the score has even been read.
let gameOverAt = 0

// The leaderboard lives on softn.com, in this app's own storage — the one
// capability permission.json asks for. Anyone playing can post a score and
// everyone sees the same top ten. Opened from a file rather than from the
// directory, the app has no server storage; the board says so and the game
// is unchanged.
let playerName = ""
let leaderboard = []
let boardStatus = "Loading the top ten…"
let lastPostedScore = -1
let lastPostedId = ""

function _init() {
  snake = [{x: 10, y: 10}, {x: 9, y: 10}, {x: 8, y: 10}]
  snakeLength = 3
  food = {x: 15, y: 10}
  direction = "right"
  window.__snakeNextDir = null
  window.__snakeNextDir2 = null
  window.__snakeCmd = ""

  let stored = localStorage.getItem("softn-snake-highscore")
  if (stored) { highScore = parseInt(stored) || 0 }
  let storedName = localStorage.getItem("softn-snake-name")
  if (storedName) { playerName = storedName }
  muted = localStorage.getItem("softn-snake-muted") === "1"
  loadLeaderboard()

  buildGridItems()

  if (!window.__snakeKeyListenerAdded) {
    window.__snakeKeyListenerAdded = true
    window.addEventListener("keydown", function(e) {
      let tag = e.targetTag || ""
      if (tag === "input" || tag === "textarea") { return }
      // A held key auto-repeats; the snake only needs the first press, and a
      // repeat must never count as "start" or "pause" again.
      if (e.repeat) { return }
      let key = e.key || ""
      if (key === "ArrowUp" || key === "w" || key === "W") { e.preventDefault(); queueDir("up") }
      else if (key === "ArrowDown" || key === "s" || key === "S") { e.preventDefault(); queueDir("down") }
      else if (key === "ArrowLeft" || key === "a" || key === "A") { e.preventDefault(); queueDir("left") }
      else if (key === "ArrowRight" || key === "d" || key === "D") { e.preventDefault(); queueDir("right") }
      else if (key === " " || key === "Enter") { e.preventDefault(); window.__snakeCmd = "start" }
      else if (key === "p" || key === "P" || key === "Escape") { window.__snakeCmd = "pause" }
      else if (key === "m" || key === "M") { window.__snakeCmd = "mute" }
    })
    // Losing the window mid-game is a pause, not a death.
    window.addEventListener("blur", function() {
      if (running && !paused && !gameOver) { togglePause() }
    })
  }
}

// Two turns can be queued: "up then left" pressed within one tick turns the
// snake up on this tick and left on the next, instead of losing the first
// press. Each queued turn is still checked against the direction the snake is
// actually moving when it is applied, so a reversal into the body is impossible.
function queueDir(d) {
  if (!window.__snakeNextDir) { window.__snakeNextDir = d }
  else if (window.__snakeNextDir !== d) { window.__snakeNextDir2 = d }
}

function clearDirQueue() {
  window.__snakeNextDir = null
  window.__snakeNextDir2 = null
}

function applyDir(nextDir) {
  if (nextDir === "up" && direction !== "down") { direction = nextDir }
  if (nextDir === "down" && direction !== "up") { direction = nextDir }
  if (nextDir === "left" && direction !== "right") { direction = nextDir }
  if (nextDir === "right" && direction !== "left") { direction = nextDir }
}

function play(name, volume) {
  if (muted) { return }
  softn.audio.play("assets/sfx/" + name + ".wav", { volume: volume })
}

function buildGridItems() {
  let items = []
  let i = 0
  while (i < snake.length) {
    let seg = snake[i]
    let c = i === 0 ? "#86efac" : "#4ade80"
    if (gameOver) { c = i === 0 ? "#fca5a5" : "#b45309" }
    items.push({x: seg.x, y: seg.y, color: c, borderRadius: i === 0 ? "5px" : "3px"})
    i = i + 1
  }
  if (food) {
    items.push({x: food.x, y: food.y, color: "#ef4444", borderRadius: "50%"})
  }
  gridItems = items
  snakeLength = snake.length
}

// Called after the snake has grown, so the new head is never a candidate.
// Picks uniformly among the free cells, so it still lands somewhere when only
// a handful are left (a random-retry loop can miss the last free cell).
function spawnFood() {
  let taken = []
  let t = 0
  while (t < 400) { taken.push(false); t = t + 1 }
  let j = 0
  while (j < snake.length) {
    taken[snake[j].y * 20 + snake[j].x] = true
    j = j + 1
  }
  let free = []
  let c = 0
  while (c < 400) {
    if (!taken[c]) { free.push(c) }
    c = c + 1
  }
  if (free.length === 0) {
    food = null
    return
  }
  let pick = free[Math.floor(Math.random() * free.length)]
  food = {x: pick % 20, y: Math.floor(pick / 20)}
}

// Keys and the pad between games: Space starts, P pauses, a direction on the
// pad or the arrows starts a fresh game when none is running.
function idleStep() {
  let cmd = window.__snakeCmd || ""
  if (cmd !== "") {
    window.__snakeCmd = ""
    if (cmd === "start") { if (paused) { togglePause() } else { startGame() } ; return }
    if (cmd === "pause") { if (paused) { togglePause() } ; return }
    if (cmd === "mute") { toggleMute(); return }
  }
  if (window.__snakeNextDir && !paused) {
    // Just after a death the player is usually still pressing the key that
    // killed them; those presses are dropped for a moment rather than
    // starting a fresh game before the score has been seen.
    if (gameOver && Date.now() - gameOverAt < 900) { clearDirQueue(); return }
    let first = window.__snakeNextDir
    startGame()
    // The snake starts heading right; the press that started the game is its
    // first turn, unless it would reverse straight into the body.
    if (first !== "left") { window.__snakeNextDir = first }
  }
}

function endGame(text, sound) {
  gameOver = true
  running = false
  paused = false
  gameOverAt = Date.now()
  newBest = score > highScore && score > 0
  if (newBest) {
    highScore = score
    localStorage.setItem("softn-snake-highscore", String(highScore))
  }
  clearDirQueue()
  overlayText = newBest ? ("New best · " + score) : (text + " · " + score)
  play(newBest ? "best" : sound, 0.5)
  buildGridItems()
  postScore()
}

function die() {
  endGame("Game over", "die")
}

function snakeStep() {
  if (gameOver || !running) return

  let cmd = window.__snakeCmd || ""
  if (cmd !== "") {
    window.__snakeCmd = ""
    if (cmd === "pause") { togglePause(); return }
    // Space mid-game pauses rather than wiping the game; the Restart button
    // is the deliberate way to start over.
    if (cmd === "start") { togglePause(); return }
    if (cmd === "mute") { toggleMute() }
  }

  let nextDir = window.__snakeNextDir
  if (nextDir) {
    applyDir(nextDir)
    window.__snakeNextDir = window.__snakeNextDir2 || null
    window.__snakeNextDir2 = null
  }

  let head = snake[0]
  let nx = head.x
  let ny = head.y
  if (direction === "up") { ny = ny - 1 }
  if (direction === "down") { ny = ny + 1 }
  if (direction === "left") { nx = nx - 1 }
  if (direction === "right") { nx = nx + 1 }

  if (nx < 0 || nx >= 20 || ny < 0 || ny >= 20) {
    die()
    return
  }

  let si = 0
  while (si < snake.length) {
    if (snake[si].x === nx && snake[si].y === ny) {
      die()
      return
    }
    si = si + 1
  }

  let newHead = {x: nx, y: ny}
  let newSnake = [newHead]
  let ci = 0
  while (ci < snake.length) {
    newSnake.push(snake[ci])
    ci = ci + 1
  }

  let ate = food !== null && nx === food.x && ny === food.y
  if (!ate) {
    newSnake = newSnake.slice(0, newSnake.length - 1)
  }
  // The snake grows before the next food is placed, so it can never land
  // under the head that just ate.
  snake = newSnake
  if (ate) {
    score = score + 1
    play("eat", 0.35)
    spawnFood()
    if (speed > 60) {
      speed = speed - 5
    }
    if (food === null) {
      // Every cell is snake: there is nothing left to eat.
      buildGridItems()
      endGame("Board full", "best")
      return
    }
  }

  buildGridItems()
}

function setPlayerName(val) {
  playerName = String(val).slice(0, 24)
  localStorage.setItem("softn-snake-name", playerName)
}

function loadLeaderboard() {
  softn.storage.query("scores", { orderBy: ["score", "desc"], limit: 10 }, function (r) {
    if (!r || r.error) {
      leaderboard = []
      boardStatus = r && r.error ? r.error : "The leaderboard is not available."
      return
    }
    let rows = []
    let i = 0
    while (i < r.records.length) {
      let rec = r.records[i]
      rows.push({ rank: i + 1, name: rec.data.name, score: rec.data.score, mine: rec.id === lastPostedId })
      i = i + 1
    }
    leaderboard = rows
    boardStatus = rows.length === 0 ? "No scores yet. Be the first." : ""
  })
}

function postScore() {
  if (score <= 0 || score === lastPostedScore) { return }
  lastPostedScore = score
  let name = playerName.trim() === "" ? "Anonymous" : playerName.trim()
  boardStatus = "Posting your score…"
  softn.storage.insert("scores", { name: name, score: score }, function (r) {
    if (r && r.error) {
      boardStatus = r.error
      return
    }
    if (r && r.id) { lastPostedId = r.id }
    loadLeaderboard()
  })
}

function handleDPad(dir) {
  queueDir(dir)
}

function handleDPadRelease(dir) {
  // Snake only needs direction on press, no release handling needed
}

function togglePause() {
  if (gameOver || (!running && !paused)) { return }
  paused = !paused
  running = !paused
  overlayText = paused ? "Paused" : ""
}

function toggleMute() {
  muted = !muted
  localStorage.setItem("softn-snake-muted", muted ? "1" : "0")
}

function startGame() {
  snake = [{x: 10, y: 10}, {x: 9, y: 10}, {x: 8, y: 10}]
  direction = "right"
  clearDirQueue()
  window.__snakeCmd = ""
  score = 0
  speed = 150
  gameOver = false
  newBest = false
  paused = false
  lastPostedScore = -1
  overlayText = ""
  spawnFood()
  running = true
  buildGridItems()
}
