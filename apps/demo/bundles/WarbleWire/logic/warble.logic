// WarbleWire — the QXW acoustic modem, in one file.
//
// A transliteration of qxw.org/lib/warble/*.ts. The wire format is unchanged:
// same CRC-8/ATM header check, same CRC-32C frame check, same K=7 rate-1/2
// convolutional code with the NASA 171/133 generators, same 28x37 block
// interleaver, same eight-byte mini-header, same Pip-16 frequency contours and
// envelopes, same pilot schedule. A receiver built from the TypeScript will
// decode what this produces, and this will decode what it produces.
//
// Three things here have no TypeScript original, because the browser gave them
// to the original for free: UTF-8 in both directions, WAV in both directions,
// and — the interesting one — acquisition. The TypeScript decoder infers the
// tempo from the exact length of the buffer and assumes the frame begins at
// sample zero, which is only ever true of a buffer it generated itself. Audio
// off a microphone starts whenever the sender felt like starting. findFrameOffset
// goes and looks for it.

// ---------------------------------------------------------------------------
// Wire constants. Provisional lab-v0; not a frozen standard.
// ---------------------------------------------------------------------------

let MAX_PAYLOAD_BYTES = 52
let MINI_HEADER_BYTES = 8
let FRAME_BYTES = 64
let FRAME_CRC_BYTES = 4
let FRAME_CRC_OFFSET = 60

let SAMPLE_RATE = 48000
let SAMPLES_PER_SYMBOL = 1536

let TAIL_BIT_COUNT = 6
let FRAME_BIT_COUNT = 512
let CONVOLUTIONAL_INPUT_BITS = 518
let ENCODED_BIT_COUNT = 1036
let DATA_SYMBOL_COUNT = 259
let PILOT_SYMBOL_COUNT = 8
let TOTAL_SYMBOL_COUNT = 267
let TOTAL_PCM_SAMPLES = 410112

let INTERLEAVER_ROWS = 28
let INTERLEAVER_COLUMNS = 37

let PILOT_INTERVAL_DATA_SYMBOLS = 31

let PIP_EXCURSION_HZ = 125
let PIP_OUTPUT_AMPLITUDE = 0.55

let FRAME_TYPE_MANIFEST = 3
let FRAME_TYPE_DATA = 4

let WARBLE_FEC_PROFILE_MASK = 0x0c
let WARBLE_FEC_PROFILE_SHIFT = 2
let WARBLE_SPEED_PROFILE_MASK = 0x03
let WARBLE_CONVOLUTIONAL_RATE_HALF_FEC_ID = 0
let WARBLE_VOICE_FLAG_MASK = 0x03

let WARBLE_FUNDAMENTAL_MIN_HZ = 650
let WARBLE_FUNDAMENTAL_MAX_HZ = 2600

let TAU = 6.283185307179586

// Typed arrays marshal to opaque slots and are skipped by the state sync, so
// these cost nothing per call. The four Pip registers, the pilot values, and
// the transmitted positions those pilots land on.
let _PIP_REGISTER_HZ = Float64Array.from([875, 1312.5, 1750, 2187.5])
let _PILOT_VALUES = Uint8Array.from([0, 15, 5, 10, 3, 12, 6, 9])
let _PILOT_TX_INDEX = Uint16Array.from([31, 63, 95, 127, 159, 191, 223, 255])

// ---------------------------------------------------------------------------
// Profiles, as plain objects for the UI to loop over. Small and unchanging.
// ---------------------------------------------------------------------------

