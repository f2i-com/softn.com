// Predator-Prey Ecosystem 3D Simulation Logic

// Simulation State
let isRunning = true;
let simSpeed = 1;
let simTick = 0;
let dayCount = 1;
let season = "Spring"; // Spring, Summer, Autumn, Winter
let ecosystemStatus = "Balanced Equilibrium";
let statusColor = "#22c55e";

// Selected Entity for Inspector
let selectedId = "";
let selectedEntity = null;

// Camera State
let cameraMode = "overview"; // "overview", "topdown", "follow", "cinematic"
let cameraPos = { x: 0, y: 16.5, z: 18.0 };
let cameraLookAt = { x: 0, y: 0.5, z: 0 };
let cameraFov = 45;
let cinematicAngle = 0.0;

// Collections
let rabbits = [];
let foxes = [];
let grassList = [];
let particlePuffs = [];
let popHistory = []; // Array of { tick, grass, rabbits, foxes }

// Statistics
let rabbitCount = 0;
let foxCount = 0;
let grassCount = 0;
let totalPreyBorn = 0;
let totalPredBorn = 0;
let totalHunts = 0;

// Dynamic Scene collections
let objects = [];
let lights = [];

// World Bounds: Floating Island Meadow (-9.5 to +9.5)
const BOUNDS = 9.2;
const POND_X = -4.0;
const POND_Z = -4.0;
const POND_RADIUS = 2.8;

function isInPond(x, z) {
  return Math.hypot(x - POND_X, z - POND_Z) < POND_RADIUS;
}

// Random ID helper
let nextEntityId = 1;
function genId(prefix) {
  let id = prefix + "-" + nextEntityId;
  nextEntityId = nextEntityId + 1;
  return id;
}

// Initialize Meadow Scenery
function buildStaticMeadow() {
  let list = [];

  // Floating Island Meadow Base (Topsoil, Earth, Bedrock)
  list.push({
    id: "meadow-turf",
    type: "box",
    width: 21.0,
    height: 0.5,
    depth: 21.0,
    position: { x: 0, y: 0.25, z: 0 },
    color: "#15803d",
    receiveShadow: true,
    roughness: 0.9
  });
  list.push({
    id: "meadow-earth",
    type: "box",
    width: 20.6,
    height: 0.9,
    depth: 20.6,
    position: { x: 0, y: -0.45, z: 0 },
    color: "#78350f",
    roughness: 0.95
  });
  list.push({
    id: "meadow-rock",
    type: "box",
    width: 20.0,
    height: 1.8,
    depth: 20.0,
    position: { x: 0, y: -1.8, z: 0 },
    color: "#334155",
    roughness: 0.8
  });

  // Sparkling Blue Pond Basin
  list.push({
    id: "pond-water",
    type: "cylinder",
    radius: POND_RADIUS,
    height: 0.08,
    position: { x: POND_X, y: 0.49, z: POND_Z },
    color: "#0284c7",
    opacity: 0.88,
    metalness: 0.35,
    roughness: 0.1
  });
  // Lily pads on the pond
  let lilypads = [
    { x: -3.2, z: -3.8 },
    { x: -4.8, z: -4.4 },
    { x: -4.2, z: -2.8 }
  ];
  for (let l = 0; l < lilypads.length; l = l + 1) {
    list.push({
      id: "lilypad-" + l,
      type: "cylinder",
      radius: 0.28,
      height: 0.04,
      position: { x: lilypads[l].x, y: 0.54, z: lilypads[l].z },
      color: "#22c55e"
    });
    list.push({
      id: "lilypad-flower-" + l,
      type: "sphere",
      radius: 0.08,
      position: { x: lilypads[l].x, y: 0.58, z: lilypads[l].z },
      color: "#ffffff"
    });
  }

  // Pine Trees & Oak Trees on Meadow Perimeters
  let treeLocs = [
    { x: -8.5, z: -8.5, type: "pine" },
    { x: 8.5, z: -8.5, type: "pine" },
    { x: 8.5, z: 8.5, type: "pine" },
    { x: -8.5, z: 8.5, type: "pine" },
    { x: 0, z: -9.0, type: "oak" },
    { x: 9.0, z: 0, type: "oak" },
    { x: -9.0, z: 0, type: "oak" },
    { x: 0, z: 9.0, type: "pine" }
  ];
  for (let t = 0; t < treeLocs.length; t = t + 1) {
    let loc = treeLocs[t];
    // Trunk
    list.push({
      id: "tree-trunk-" + t,
      type: "cylinder",
      radius: 0.22,
      height: 1.6,
      position: { x: loc.x, y: 1.25, z: loc.z },
      color: "#5c3a21"
    });
    if (loc.type === "pine") {
      list.push({
        id: "tree-cone-1-" + t,
        type: "cone",
        radius: 1.2,
        height: 1.6,
        position: { x: loc.x, y: 2.3, z: loc.z },
        color: "#14532d",
        castShadow: true
      });
      list.push({
        id: "tree-cone-2-" + t,
        type: "cone",
        radius: 0.85,
        height: 1.5,
        position: { x: loc.x, y: 3.2, z: loc.z },
        color: "#166534",
        castShadow: true
      });
    } else {
      list.push({
        id: "tree-foliage-" + t,
        type: "sphere",
        radius: 1.25,
        position: { x: loc.x, y: 2.6, z: loc.z },
        color: "#15803d",
        castShadow: true
      });
    }
  }

  // Granite Mossy Boulders
  let rocks = [
    { x: 4.5, z: 4.5, r: 0.75 },
    { x: 5.2, z: 3.8, r: 0.5 },
    { x: -6.8, z: 2.5, r: 0.85 },
    { x: 2.5, z: -6.5, r: 0.7 }
  ];
  for (let k = 0; k < rocks.length; k = k + 1) {
    list.push({
      id: "boulder-" + k,
      type: "sphere",
      radius: rocks[k].r,
      position: { x: rocks[k].x, y: 0.5 + rocks[k].r * 0.4, z: rocks[k].z },
      color: "#64748b",
      roughness: 0.9,
      castShadow: true
    });
  }

  return list;
}

const staticObjects = buildStaticMeadow();

// Spawn Rabbit
function addRabbit(x, z, initialEnergy) {
  let posX = x !== undefined ? x : (Math.random() - 0.5) * BOUNDS * 1.6;
  let posZ = z !== undefined ? z : (Math.random() - 0.5) * BOUNDS * 1.6;
  if (isInPond(posX, posZ)) {
    posX = posX + 3.0;
    posZ = posZ + 3.0;
  }
  let id = genId("prey");
  rabbits.push({
    id: id,
    name: "Hare #" + id.split("-")[1],
    x: posX,
    z: posZ,
    y: 0.52,
    vx: (Math.random() - 0.5) * 0.05,
    vz: (Math.random() - 0.5) * 0.05,
    rot: Math.random() * Math.PI * 2,
    energy: initialEnergy || 25,
    maxEnergy: 50,
    age: 0,
    maxAge: 1200 + Math.floor(Math.random() * 400),
    state: "wandering", // "wandering", "grazing", "fleeing", "mating"
    hopPhase: Math.random() * Math.PI * 2,
    offspringCount: 0
  });
  rabbitCount = rabbits.length;
}

// Spawn Fox
function addFox(x, z, initialEnergy) {
  let posX = x !== undefined ? x : (Math.random() - 0.5) * BOUNDS * 1.6;
  let posZ = z !== undefined ? z : (Math.random() - 0.5) * BOUNDS * 1.6;
  if (isInPond(posX, posZ)) {
    posX = posX - 3.0;
    posZ = posZ - 3.0;
  }
  let id = genId("pred");
  foxes.push({
    id: id,
    name: "Fox #" + id.split("-")[1],
    x: posX,
    z: posZ,
    y: 0.55,
    vx: (Math.random() - 0.5) * 0.06,
    vz: (Math.random() - 0.5) * 0.06,
    rot: Math.random() * Math.PI * 2,
    energy: initialEnergy || 35,
    maxEnergy: 75,
    age: 0,
    maxAge: 1500 + Math.floor(Math.random() * 500),
    state: "stalking", // "stalking", "hunting", "satisfied", "mating"
    runPhase: Math.random() * Math.PI * 2,
    targetId: null,
    catchCount: 0,
    offspringCount: 0
  });
  foxCount = foxes.length;
}

// Initialize Grass Patches
function initGrassGrid() {
  grassList = [];
  let numPatches = 52;
  for (let i = 0; i < numPatches; i = i + 1) {
    let gx = (Math.random() - 0.5) * BOUNDS * 1.8;
    let gz = (Math.random() - 0.5) * BOUNDS * 1.8;
    if (isInPond(gx, gz)) {
      gx = gx + 3.2;
    }
    grassList.push({
      id: "grass-" + i,
      x: gx,
      z: gz,
      nutrition: Math.floor(Math.random() * 3) + 1, // 1 to 3
      maxNutrition: 3,
      regrowTimer: 0
    });
  }
  grassCount = grassList.length;
}

// Particles Management
function spawnPuff(x, y, z, color, count) {
  let c = count || 6;
  for (let i = 0; i < c; i = i + 1) {
    particlePuffs.push({
      x: x,
      y: y + 0.2,
      z: z,
      vx: (Math.random() - 0.5) * 0.08,
      vy: 0.04 + Math.random() * 0.06,
      vz: (Math.random() - 0.5) * 0.08,
      color: color || "#ffffff",
      life: 0,
      maxLife: 20 + Math.floor(Math.random() * 15)
    });
  }
}

function updateParticles() {
  let kept = [];
  for (let i = 0; i < particlePuffs.length; i = i + 1) {
    let p = particlePuffs[i];
    p.life = p.life + 1;
    if (p.life < p.maxLife) {
      p.x = p.x + p.vx;
      p.y = p.y + p.vy;
      p.z = p.z + p.vz;
      p.vy = p.vy * 0.95;
      kept.push(p);
    }
  }
  particlePuffs = kept;
}

// Reset Scenarios
function resetScenario(type) {
  rabbits = [];
  foxes = [];
  particlePuffs = [];
  popHistory = [];
  simTick = 0;
  dayCount = 1;
  selectedId = "";
  selectedEntity = null;
  initGrassGrid();

  if (type === "rabbit_boom") {
    for (let i = 0; i < 48; i = i + 1) addRabbit();
    for (let i = 0; i < 3; i = i + 1) addFox();
  } else if (type === "predator_pack") {
    for (let i = 0; i < 18; i = i + 1) addRabbit();
    for (let i = 0; i < 16; i = i + 1) addFox();
  } else if (type === "sparse") {
    for (let i = 0; i < 14; i = i + 1) addRabbit();
    for (let i = 0; i < 4; i = i + 1) addFox();
  } else {
    // Balanced
    for (let i = 0; i < 30; i = i + 1) addRabbit();
    for (let i = 0; i < 8; i = i + 1) addFox();
  }

  updateStats();
}

// Helper: Distance
function dist(x1, z1, x2, z2) {
  return Math.hypot(x1 - x2, z1 - z2);
}

// Ecological Step Physics
function updateEcosystem(delta) {
  simTick = simTick + 1;
  if (simTick % 180 === 0) {
    dayCount = dayCount + 1;
    let seasons = ["Spring", "Summer", "Autumn", "Winter"];
    season = seasons[Math.floor(dayCount / 5) % 4];
  }

  // 1. Grass Growth & Regeneration
  let matureGrassCount = 0;
  for (let g = 0; g < grassList.length; g = g + 1) {
    let grass = grassList[g];
    if (grass.nutrition < grass.maxNutrition) {
      grass.regrowTimer = grass.regrowTimer + delta * (season === "Winter" ? 0.3 : 1.0);
      if (grass.regrowTimer > 6.0) {
        grass.nutrition = grass.nutrition + 1;
        grass.regrowTimer = 0;
      }
    }
    if (grass.nutrition > 0) matureGrassCount = matureGrassCount + 1;
  }
  grassCount = matureGrassCount;

  // 2. Rabbits (Prey) AI & Movement
  let survivingRabbits = [];
  let newRabbits = [];

  for (let r = 0; r < rabbits.length; r = r + 1) {
    let rab = rabbits[r];
    rab.age = rab.age + 1;
    rab.hopPhase = rab.hopPhase + delta * (rab.state === "fleeing" ? 14.0 : 8.0);
    rab.y = 0.52 + Math.abs(Math.sin(rab.hopPhase)) * (rab.state === "fleeing" ? 0.28 : 0.16);

    // Find nearest predator (Threat Detection)
    let nearestFox = null;
    let minFoxDist = 5.2; // Vision radius for threat
    for (let f = 0; f < foxes.length; f = f + 1) {
      let d = dist(rab.x, rab.z, foxes[f].x, foxes[f].z);
      if (d < minFoxDist) {
        minFoxDist = d;
        nearestFox = foxes[f];
      }
    }

    if (nearestFox) {
      // FLEE! Compute vector directly away from predator
      rab.state = "fleeing";
      let dx = rab.x - nearestFox.x;
      let dz = rab.z - nearestFox.z;
      let len = Math.hypot(dx, dz) || 1;
      let speed = 0.16; // Sprint speed
      rab.vx = (dx / len) * speed;
      rab.vz = (dz / len) * speed;
      rab.rot = Math.atan2(rab.vx, rab.vz);
      rab.energy = rab.energy - 0.08 * delta * 30;
    } else {
      // SAFE: Look for Grass or Wander
      let nearestGrass = null;
      let minGrassDist = 7.0;
      for (let g = 0; g < grassList.length; g = g + 1) {
        if (grassList[g].nutrition > 0) {
          let d = dist(rab.x, rab.z, grassList[g].x, grassList[g].z);
          if (d < minGrassDist) {
            minGrassDist = d;
            nearestGrass = grassList[g];
          }
        }
      }

      if (nearestGrass && rab.energy < 38) {
        rab.state = "grazing";
        let dx = nearestGrass.x - rab.x;
        let dz = nearestGrass.z - rab.z;
        let len = Math.hypot(dx, dz) || 1;
        if (len < 0.5) {
          // Eat grass
          rab.energy = Math.min(rab.maxEnergy, rab.energy + 10.0);
          nearestGrass.nutrition = nearestGrass.nutrition - 1;
          spawnPuff(rab.x, rab.y, rab.z, "#22c55e", 4);
          rab.vx = 0;
          rab.vz = 0;
        } else {
          let speed = 0.075;
          rab.vx = (dx / len) * speed;
          rab.vz = (dz / len) * speed;
          rab.rot = Math.atan2(rab.vx, rab.vz);
        }
      } else {
        rab.state = "wandering";
        // Gentle random wandering
        if (Math.random() < 0.05) {
          rab.rot = rab.rot + (Math.random() - 0.5) * 1.5;
          let speed = 0.045;
          rab.vx = Math.sin(rab.rot) * speed;
          rab.vz = Math.cos(rab.rot) * speed;
        }
      }
      rab.energy = rab.energy - 0.035 * delta * 30;
    }

    // Apply Velocity
    rab.x = rab.x + rab.vx;
    rab.z = rab.z + rab.vz;

    // Meadow & Pond Boundaries
    if (rab.x > BOUNDS) { rab.x = BOUNDS; rab.vx = -Math.abs(rab.vx); }
    if (rab.x < -BOUNDS) { rab.x = -BOUNDS; rab.vx = Math.abs(rab.vx); }
    if (rab.z > BOUNDS) { rab.z = BOUNDS; rab.vz = -Math.abs(rab.vz); }
    if (rab.z < -BOUNDS) { rab.z = -BOUNDS; rab.vz = Math.abs(rab.vz); }
    if (isInPond(rab.x, rab.z)) {
      let dx = rab.x - POND_X;
      let dz = rab.z - POND_Z;
      let len = Math.hypot(dx, dz) || 1;
      rab.x = POND_X + (dx / len) * (POND_RADIUS + 0.2);
      rab.z = POND_Z + (dz / len) * (POND_RADIUS + 0.2);
    }

    // Reproduction
    if (rab.energy > 38 && rab.age > 80 && rabbits.length < 90) {
      rab.energy = rab.energy - 18;
      rab.offspringCount = rab.offspringCount + 1;
      totalPreyBorn = totalPreyBorn + 1;
      spawnPuff(rab.x, rab.y + 0.4, rab.z, "#f43f5e", 8); // Heart/pink puff
      newRabbits.push({
        id: genId("prey"),
        name: "Bunny #" + totalPreyBorn,
        x: rab.x + (Math.random() - 0.5) * 0.8,
        z: rab.z + (Math.random() - 0.5) * 0.8,
        y: 0.52,
        vx: (Math.random() - 0.5) * 0.05,
        vz: (Math.random() - 0.5) * 0.05,
        rot: Math.random() * Math.PI * 2,
        energy: 20,
        maxEnergy: 50,
        age: 0,
        maxAge: 1200 + Math.floor(Math.random() * 400),
        state: "wandering",
        hopPhase: 0,
        offspringCount: 0
      });
    }

    // Death by starvation or old age
    if (rab.energy <= 0 || rab.age > rab.maxAge) {
      spawnPuff(rab.x, rab.y, rab.z, "#cbd5e1", 6); // Dust puff
    } else {
      survivingRabbits.push(rab);
    }
  }

  for (let n = 0; n < newRabbits.length; n = n + 1) {
    survivingRabbits.push(newRabbits[n]);
  }
  rabbits = survivingRabbits;

  // 3. Foxes (Predator) AI & Hunting
  let survivingFoxes = [];
  let newFoxes = [];
  let eatenRabbitIds = {};

  for (let f = 0; f < foxes.length; f = f + 1) {
    let fox = foxes[f];
    fox.age = fox.age + 1;
    fox.runPhase = fox.runPhase + delta * (fox.state === "hunting" ? 12.0 : 6.0);

    // Find nearest rabbit within vision
    let nearestRab = null;
    let minRabDist = 8.5; // Hunting vision range
    for (let r = 0; r < rabbits.length; r = r + 1) {
      let rab = rabbits[r];
      if (!eatenRabbitIds[rab.id]) {
        let d = dist(fox.x, fox.z, rab.x, rab.z);
        if (d < minRabDist) {
          minRabDist = d;
          nearestRab = rab;
        }
      }
    }

    if (nearestRab) {
      // HUNT! Chase closest rabbit
      fox.state = "hunting";
      fox.targetId = nearestRab.id;
      let dx = nearestRab.x - fox.x;
      let dz = nearestRab.z - fox.z;
      let len = Math.hypot(dx, dz) || 1;

      if (len < 0.65) {
        // CATCH PREY! Pounce and consume
        eatenRabbitIds[nearestRab.id] = true;
        fox.energy = Math.min(fox.maxEnergy, fox.energy + 28.0);
        fox.catchCount = fox.catchCount + 1;
        totalHunts = totalHunts + 1;
        fox.state = "satisfied";
        spawnPuff(nearestRab.x, nearestRab.y + 0.3, nearestRab.z, "#fb923c", 8);
        fox.vx = 0;
        fox.vz = 0;
      } else {
        let speed = 0.135; // Sprint chase speed
        fox.vx = (dx / len) * speed;
        fox.vz = (dz / len) * speed;
        fox.rot = Math.atan2(fox.vx, fox.vz);
      }
      fox.energy = fox.energy - 0.08 * delta * 30;
    } else {
      // Wander or stalk
      fox.state = "stalking";
      if (Math.random() < 0.04) {
        fox.rot = fox.rot + (Math.random() - 0.5) * 1.2;
        let speed = 0.055;
        fox.vx = Math.sin(fox.rot) * speed;
        fox.vz = Math.cos(fox.rot) * speed;
      }
      fox.energy = fox.energy - 0.045 * delta * 30;
    }

    // Apply velocity
    fox.x = fox.x + fox.vx;
    fox.z = fox.z + fox.vz;

    // Boundaries
    if (fox.x > BOUNDS) { fox.x = BOUNDS; fox.vx = -Math.abs(fox.vx); }
    if (fox.x < -BOUNDS) { fox.x = -BOUNDS; fox.vx = Math.abs(fox.vx); }
    if (fox.z > BOUNDS) { fox.z = BOUNDS; fox.vz = -Math.abs(fox.vz); }
    if (fox.z < -BOUNDS) { fox.z = -BOUNDS; fox.vz = Math.abs(fox.vz); }
    if (isInPond(fox.x, fox.z)) {
      let dx = fox.x - POND_X;
      let dz = fox.z - POND_Z;
      let len = Math.hypot(dx, dz) || 1;
      fox.x = POND_X + (dx / len) * (POND_RADIUS + 0.2);
      fox.z = POND_Z + (dz / len) * (POND_RADIUS + 0.2);
    }

    // Fox Reproduction
    if (fox.energy > 56 && fox.age > 120 && foxes.length < 35) {
      fox.energy = fox.energy - 26;
      fox.offspringCount = fox.offspringCount + 1;
      totalPredBorn = totalPredBorn + 1;
      spawnPuff(fox.x, fox.y + 0.4, fox.z, "#f97316", 8);
      newFoxes.push({
        id: genId("pred"),
        name: "Kit #" + totalPredBorn,
        x: fox.x + (Math.random() - 0.5) * 0.9,
        z: fox.z + (Math.random() - 0.5) * 0.9,
        y: 0.55,
        vx: (Math.random() - 0.5) * 0.06,
        vz: (Math.random() - 0.5) * 0.06,
        rot: Math.random() * Math.PI * 2,
        energy: 30,
        maxEnergy: 75,
        age: 0,
        maxAge: 1500 + Math.floor(Math.random() * 500),
        state: "stalking",
        runPhase: 0,
        targetId: null,
        catchCount: 0,
        offspringCount: 0
      });
    }

    // Starvation or age death
    if (fox.energy <= 0 || fox.age > fox.maxAge) {
      spawnPuff(fox.x, fox.y, fox.z, "#94a3b8", 8);
    } else {
      survivingFoxes.push(fox);
    }
  }

  // Remove caught rabbits
  rabbits = rabbits.filter(function(rab) {
    return !eatenRabbitIds[rab.id];
  });

  for (let n = 0; n < newFoxes.length; n = n + 1) {
    survivingFoxes.push(newFoxes[n]);
  }
  foxes = survivingFoxes;

  // Update Statistics
  updateStats();
}

function updateStats() {
  rabbitCount = rabbits.length;
  foxCount = foxes.length;

  // Ecosystem Balance Status
  if (rabbitCount === 0 && foxCount === 0) {
    ecosystemStatus = "Ecological Collapse";
    statusColor = "#ef4444";
  } else if (foxCount === 0) {
    ecosystemStatus = "Prey Boom (No Predators)";
    statusColor = "#f59e0b";
  } else if (rabbitCount === 0) {
    ecosystemStatus = "Predator Starvation (No Prey)";
    statusColor = "#dc2626";
  } else if (foxCount > rabbitCount * 0.6) {
    ecosystemStatus = "Apex Overpredation";
    statusColor = "#f97316";
  } else {
    ecosystemStatus = "Balanced Equilibrium";
    statusColor = "#22c55e";
  }

  // Population history tracking for graph
  if (simTick % 12 === 0) {
    popHistory.push({
      tick: simTick,
      grass: grassCount,
      rabbits: rabbitCount,
      foxes: foxCount
    });
    if (popHistory.length > 40) {
      popHistory.shift();
    }
  }

  // Update selected entity reference
  if (selectedId) {
    let found = null;
    for (let r = 0; r < rabbits.length; r = r + 1) {
      if (rabbits[r].id === selectedId) found = rabbits[r];
    }
    if (!found) {
      for (let f = 0; f < foxes.length; f = f + 1) {
        if (foxes[f].id === selectedId) found = foxes[f];
      }
    }
    selectedEntity = found;
  }
}

// Build 3D Dynamic Objects (Rabbits, Foxes, Grass, Particles)
function buildDynamicObjects() {
  let list = [];

  // 1. Dynamic Grass Tufts
  for (let g = 0; g < grassList.length; g = g + 1) {
    let gr = grassList[g];
    if (gr.nutrition > 0) {
      let bladeH = 0.25 + gr.nutrition * 0.15;
      list.push({
        id: gr.id + "-tuft",
        type: "cylinder",
        radius: 0.15 + gr.nutrition * 0.08,
        height: bladeH,
        position: { x: gr.x, y: 0.5 + bladeH / 2, z: gr.z },
        color: gr.nutrition === 3 ? "#16a34a" : "#22c55e",
        castShadow: true
      });
      // Flower on high nutrition patch
      if (gr.nutrition === 3) {
        list.push({
          id: gr.id + "-flower",
          type: "sphere",
          radius: 0.10,
          position: { x: gr.x, y: 0.5 + bladeH + 0.08, z: gr.z },
          color: (g % 2 === 0) ? "#fbbf24" : "#f43f5e"
        });
      }
    }
  }

  // 2. 3D Animated Rabbits (Cute white bunnies with twitching ears & fluffy tail)
  for (let r = 0; r < rabbits.length; r = r + 1) {
    let rab = rabbits[r];
    let isSel = rab.id === selectedId;

    let rabChildren = [
      // Body
      {
        id: rab.id + "-body",
        type: "capsule",
        radius: 0.18,
        height: 0.26,
        position: { x: 0, y: 0.18, z: 0 },
        color: isSel ? "#fef08a" : "#f8fafc",
        castShadow: true
      },
      // Head
      {
        id: rab.id + "-head",
        type: "sphere",
        radius: 0.14,
        position: { x: 0, y: 0.32, z: 0.18 },
        color: isSel ? "#fef08a" : "#f8fafc"
      },
      // Left Ear (With pink inner ear)
      {
        id: rab.id + "-ear-l",
        type: "capsule",
        radius: 0.035,
        height: 0.22,
        position: { x: -0.06, y: 0.48, z: 0.14 },
        rotation: { x: -0.18, y: 0, z: -0.15 },
        color: "#f8fafc"
      },
      {
        id: rab.id + "-ear-in-l",
        type: "capsule",
        radius: 0.02,
        height: 0.16,
        position: { x: -0.06, y: 0.47, z: 0.16 },
        rotation: { x: -0.18, y: 0, z: -0.15 },
        color: "#fda4af"
      },
      // Right Ear
      {
        id: rab.id + "-ear-r",
        type: "capsule",
        radius: 0.035,
        height: 0.22,
        position: { x: 0.06, y: 0.48, z: 0.14 },
        rotation: { x: -0.18, y: 0, z: 0.15 },
        color: "#f8fafc"
      },
      {
        id: rab.id + "-ear-in-r",
        type: "capsule",
        radius: 0.02,
        height: 0.16,
        position: { x: 0.06, y: 0.47, z: 0.16 },
        rotation: { x: -0.18, y: 0, z: 0.15 },
        color: "#fda4af"
      },
      // Dark Eyes
      {
        id: rab.id + "-eye-l",
        type: "sphere",
        radius: 0.025,
        position: { x: -0.09, y: 0.33, z: 0.26 },
        color: "#09090b"
      },
      {
        id: rab.id + "-eye-r",
        type: "sphere",
        radius: 0.025,
        position: { x: 0.09, y: 0.33, z: 0.26 },
        color: "#09090b"
      },
      // Cute Pink Nose
      {
        id: rab.id + "-nose",
        type: "sphere",
        radius: 0.02,
        position: { x: 0, y: 0.29, z: 0.30 },
        color: "#fb7185"
      },
      // Fluffy Tail
      {
        id: rab.id + "-tail",
        type: "sphere",
        radius: 0.07,
        position: { x: 0, y: 0.18, z: -0.22 },
        color: "#ffffff"
      }
    ];

    list.push({
      id: rab.id,
      type: "group",
      position: { x: rab.x, y: rab.y, z: rab.z },
      rotation: { x: 0, y: rab.rot, z: 0 },
      cursor: "pointer",
      interactive: true,
      children: rabChildren
    });

    // Selection Halo Ring
    if (isSel) {
      list.push({
        id: rab.id + "-halo",
        type: "torus",
        radius: 0.45,
        tube: 0.04,
        position: { x: rab.x, y: 0.54, z: rab.z },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: "#fbbf24",
        emissive: "#fbbf24",
        emissiveIntensity: 2.0
      });
    }
  }

  // 3. 3D Animated Foxes (Vibrant russet predators with bushy white-tipped tails)
  for (let f = 0; f < foxes.length; f = f + 1) {
    let fox = foxes[f];
    let isSel = fox.id === selectedId;

    let foxChildren = [
      // Body (Sleek predatory capsule)
      {
        id: fox.id + "-body",
        type: "capsule",
        radius: 0.20,
        height: 0.50,
        position: { x: 0, y: 0.26, z: 0 },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: isSel ? "#fef08a" : "#ea580c",
        castShadow: true
      },
      // White Chest & Underbelly
      {
        id: fox.id + "-chest",
        type: "sphere",
        radius: 0.16,
        position: { x: 0, y: 0.22, z: 0.18 },
        color: "#f8fafc"
      },
      // Head / Muzzle (Pointed wedge)
      {
        id: fox.id + "-head",
        type: "cone",
        radius: 0.16,
        height: 0.32,
        position: { x: 0, y: 0.32, z: 0.35 },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: "#ea580c"
      },
      // Black Nose
      {
        id: fox.id + "-nose",
        type: "sphere",
        radius: 0.03,
        position: { x: 0, y: 0.32, z: 0.52 },
        color: "#09090b"
      },
      // Dark Eyes
      {
        id: fox.id + "-eye-l",
        type: "sphere",
        radius: 0.03,
        position: { x: -0.09, y: 0.36, z: 0.35 },
        color: "#09090b"
      },
      {
        id: fox.id + "-eye-r",
        type: "sphere",
        radius: 0.03,
        position: { x: 0.09, y: 0.36, z: 0.35 },
        color: "#09090b"
      },
      // Pointed Fox Ears
      {
        id: fox.id + "-ear-l",
        type: "cone",
        radius: 0.06,
        height: 0.16,
        position: { x: -0.10, y: 0.48, z: 0.26 },
        color: "#9a3412"
      },
      {
        id: fox.id + "-ear-r",
        type: "cone",
        radius: 0.06,
        height: 0.16,
        position: { x: 0.10, y: 0.48, z: 0.26 },
        color: "#9a3412"
      },
      // Bushy Tail
      {
        id: fox.id + "-tail",
        type: "capsule",
        radius: 0.11,
        height: 0.40,
        position: { x: 0, y: 0.30, z: -0.40 },
        rotation: { x: -0.55, y: 0, z: 0 },
        color: "#ea580c"
      },
      // White Tail Tip
      {
        id: fox.id + "-tail-tip",
        type: "sphere",
        radius: 0.09,
        position: { x: 0, y: 0.42, z: -0.55 },
        color: "#ffffff"
      }
    ];

    list.push({
      id: fox.id,
      type: "group",
      position: { x: fox.x, y: fox.y, z: fox.z },
      rotation: { x: 0, y: fox.rot, z: 0 },
      cursor: "pointer",
      interactive: true,
      children: foxChildren
    });

    // Selection Halo Ring
    if (isSel) {
      list.push({
        id: fox.id + "-halo",
        type: "torus",
        radius: 0.55,
        tube: 0.04,
        position: { x: fox.x, y: 0.54, z: fox.z },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: "#f97316",
        emissive: "#f97316",
        emissiveIntensity: 2.0
      });
    }
  }

  // 4. Particle Puffs
  let particlePos = [];
  for (let p = 0; p < particlePuffs.length; p = p + 1) {
    let pt = particlePuffs[p];
    particlePos.push(pt.x, pt.y, pt.z);
  }
  if (particlePos.length > 0) {
    list.push({
      id: "sim-particles",
      type: "particles",
      particlePositions: particlePos,
      particleSize: 0.22,
      color: "#fef08a",
      opacity: 0.8
    });
  }

  return list;
}

// Build Dynamic Lighting
function buildLights() {
  let list = [];

  // Primary High Sunlight
  list.push({
    id: "sun-light",
    type: "directional",
    color: "#fffbeb",
    intensity: 1.5,
    position: { x: 12, y: 22, z: 14 },
    castShadow: true,
    shadowCameraSize: 24,
    shadowBias: -0.0003
  });

  // Sky Fill
  list.push({
    id: "sky-light",
    type: "directional",
    color: "#bae6fd",
    intensity: 0.6,
    position: { x: -14, y: 16, z: -12 }
  });

  // Ambient Nature Light
  list.push({
    id: "ambient-light",
    type: "ambient",
    color: "#dcfce7",
    intensity: 0.65
  });

  return list;
}

// Game Step Hook
function gameStep(dt) {
  let delta = dt ? Math.min(dt, 0.1) : 0.033;

  if (isRunning) {
    for (let s = 0; s < simSpeed; s = s + 1) {
      updateEcosystem(delta);
    }
  }

  updateParticles();

  // Camera Management
  if (cameraMode === "follow" && selectedEntity) {
    cameraPos = {
      x: selectedEntity.x - Math.sin(selectedEntity.rot) * 3.8,
      y: selectedEntity.y + 2.4,
      z: selectedEntity.z - Math.cos(selectedEntity.rot) * 3.8
    };
    cameraLookAt = {
      x: selectedEntity.x + Math.sin(selectedEntity.rot) * 2.0,
      y: selectedEntity.y + 0.5,
      z: selectedEntity.z + Math.cos(selectedEntity.rot) * 2.0
    };
  } else if (cameraMode === "cinematic") {
    cinematicAngle = cinematicAngle + delta * 0.15;
    cameraPos = {
      x: Math.sin(cinematicAngle) * 19.0,
      y: 13.0,
      z: Math.cos(cinematicAngle) * 19.0
    };
    cameraLookAt = { x: 0, y: 0.5, z: 0 };
  }

  objects = buildDynamicObjects();
  lights = buildLights();
}

// User Interactions
function togglePlay() {
  isRunning = !isRunning;
}

function stepOnce() {
  updateEcosystem(0.033);
  objects = buildDynamicObjects();
}

function setSimSpeed(sp) {
  simSpeed = sp;
}

function setCameraView(mode) {
  cameraMode = mode;
  if (mode === "overview") {
    cameraPos = { x: 0, y: 16.5, z: 18.0 };
    cameraLookAt = { x: 0, y: 0.5, z: 0 };
    cameraFov = 45;
  } else if (mode === "topdown") {
    cameraPos = { x: 0, y: 24.0, z: 0.1 };
    cameraLookAt = { x: 0, y: 0, z: 0 };
    cameraFov = 48;
  } else if (mode === "cinematic") {
    cameraFov = 42;
  }
}

function triggerSpringBloom() {
  for (let g = 0; g < grassList.length; g = g + 1) {
    grassList[g].nutrition = 3;
    grassList[g].regrowTimer = 0;
  }
  spawnPuff(0, 2.0, 0, "#22c55e", 24);
  updateStats();
}

function triggerColdSnap() {
  for (let g = 0; g < grassList.length; g = g + 1) {
    if (Math.random() < 0.6) {
      grassList[g].nutrition = 0;
    }
  }
  spawnPuff(0, 2.0, 0, "#93c5fd", 24);
  updateStats();
}

function spawnPreyAction() {
  addRabbit();
  spawnPuff(0, 1.0, 0, "#f8fafc", 8);
  updateStats();
}

function spawnPredatorAction() {
  addFox();
  spawnPuff(0, 1.0, 0, "#ea580c", 8);
  updateStats();
}

function plantGrassAction() {
  let gx = (Math.random() - 0.5) * BOUNDS * 1.6;
  let gz = (Math.random() - 0.5) * BOUNDS * 1.6;
  grassList.push({
    id: genId("grass"),
    x: gx,
    z: gz,
    nutrition: 3,
    maxNutrition: 3,
    regrowTimer: 0
  });
  spawnPuff(gx, 0.8, gz, "#22c55e", 10);
  updateStats();
}

// In-World 3D Click Handling
function handleSceneClick(hit) {
  if (!hit || !hit.objectId) {
    selectedId = "";
    selectedEntity = null;
    return;
  }
  let id = hit.objectId;
  // Match prefix for compound groups
  let targetId = id.split("-tuft")[0].split("-body")[0].split("-head")[0].split("-ear")[0].split("-tail")[0];

  for (let r = 0; r < rabbits.length; r = r + 1) {
    if (rabbits[r].id === targetId || id.indexOf(rabbits[r].id) !== -1) {
      selectedId = rabbits[r].id;
      selectedEntity = rabbits[r];
      return;
    }
  }

  for (let f = 0; f < foxes.length; f = f + 1) {
    if (foxes[f].id === targetId || id.indexOf(foxes[f].id) !== -1) {
      selectedId = foxes[f].id;
      selectedEntity = foxes[f];
      return;
    }
  }

  // Click on terrain: deselect
  selectedId = "";
  selectedEntity = null;
}

// Initial setup
resetScenario("balanced");
gameStep(0.033);
