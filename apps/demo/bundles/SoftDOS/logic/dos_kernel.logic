// dos_kernel.logic — SoftDOS HLE (High-Level Emulation) DOS & DPMI Kernel
//
// Intercepts and implements BIOS (INT 10h, 16h), DOS (INT 21h), and DPMI (INT 31h)
// system calls directly in JavaScript without needing MS-DOS 6.22 floppy disks.

// Cursor position in text mode: column (0-79), row (0-24)
let DOS_CURSOR_COL = 0;
let DOS_CURSOR_ROW = 0;
let DOS_CURSOR_VISIBLE = 1;
let DOS_KEY_WAITING = 0;   // set while INT 16h is parked waiting for a key

// Virtual Filesystem Helper
// A name as the drive stores it: upper case, without drive or path.
function dosKernel_vfsClean(filename) {
  let clean = filename.toUpperCase().trim();
  let slashIdx = clean.lastIndexOf("\\");
  if (slashIdx >= 0) clean = clean.slice(slashIdx + 1);
  slashIdx = clean.lastIndexOf("/");
  if (slashIdx >= 0) clean = clean.slice(slashIdx + 1);
  let colon = clean.lastIndexOf(":");
  if (colon >= 0) clean = clean.slice(colon + 1);
  return clean;
}

function dosKernel_vfsFind(filename) {
  let clean = dosKernel_vfsClean(filename);
  if (clean === "") return -1;
  for (let i = 0; i < DOS_VFS_COUNT; i++) {
    if (DOS_VFS_NAMES[i] === clean) return i;
  }
  return -1;
}

// A name in 8.3 form padded to eleven characters, for wildcard matching.
function dosKernel_vfs83(name) {
  let dot = name.lastIndexOf(".");
  let base = (dot < 0) ? name : name.slice(0, dot);
  let ext = (dot < 0) ? "" : name.slice(dot + 1);
  let out = "";
  for (let i = 0; i < 8; i++) out += (i < base.length) ? base[i] : " ";
  for (let i = 0; i < 3; i++) out += (i < ext.length) ? ext[i] : " ";
  return out;
}

// A wildcard pattern in the same form: "*" fills the rest of its part
// with "?", which matches anything, a space included.
function dosKernel_vfsPattern(pat) {
  let dot = pat.lastIndexOf(".");
  let base = (dot < 0) ? pat : pat.slice(0, dot);
  let ext = (dot < 0) ? "" : pat.slice(dot + 1);
  let part = (s, n) => {
    let out = "";
    let star = 0;
    for (let i = 0; i < n; i++) {
      if (star === 1) { out += "?"; continue; }
      if (i < s.length) {
        if (s[i] === "*") { star = 1; out += "?"; } else out += s[i];
      } else out += " ";
    }
    return out;
  };
  return part(base, 8) + part(ext, 3);
}

function dosKernel_vfsMatch(pattern11, name11) {
  for (let i = 0; i < 11; i++) {
    let p = pattern11[i];
    if (p !== "?" && p !== name11[i]) return 0;
  }
  return 1;
}

// The ASCIZ name at DS:DX (flat EDX for 32-bit code).
function dosKernel_nameAt(seg, off) {
  let addr = 0;
  if (DOS_IS_32 === 1) addr = off >>> 0;
  else addr = ((seg << 4) + (off & 0xFFFF)) & 0xFFFFFF;
  let name = "";
  for (let i = 0; i < 128; i++) {
    let ch = DOS_RAM[(addr + i) & 0xFFFFFF];
    if (ch === 0) break;
    name = name + String.fromCharCode(ch);
  }
  return name;
}

// The buffer address a call names in DS:DX (flat EDX for 32-bit code).
function dosKernel_bufAt(seg, off) {
  if (DOS_IS_32 === 1) return off >>> 0;
  return ((seg << 4) + (off & 0xFFFF)) & 0xFFFFFF;
}

// A free handle for a file on the drive, or -1 when the table is full.
function dosKernel_openHandle(vfsIdx) {
  for (let h = 5; h < 32; h++) {
    if (DOS_HANDLE_VFS[h] === -1) {
      DOS_HANDLE_VFS[h] = vfsIdx;
      DOS_HANDLE_POS[h] = 0;
      return h;
    }
  }
  return -1;
}

// The disk transfer area, where find-first/next report their matches.
// The loader points it at the PSP's command tail, as DOS does.
let DOS_DTA = 0x00580;

// A civil date from days since 1970, for the date service.
function dosKernel_civil(days) {
  let z = days + 719468;
  let era = Math.floor(z / 146097);
  let doe = z - era * 146097;
  let yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365);
  let y = yoe + era * 400;
  let doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100));
  let mp = Math.floor((5 * doy + 2) / 153);
  let d = doy - Math.floor((153 * mp + 2) / 5) + 1;
  let m = (mp < 10) ? mp + 3 : mp - 9;
  if (m <= 2) y++;
  return [y, m, d];
}

// Walk the drive from the entry the DTA names, writing the next match into
// it. 1 when one was found.
function dosKernel_findNext() {
  let dta = DOS_DTA & 0xFFFFFF;
  let pattern = "";
  for (let i = 0; i < 11; i++) pattern += String.fromCharCode(DOS_RAM[dta + i]);
  let attr = DOS_RAM[dta + 0x0C];
  let idx = DOS_RAM[dta + 0x0D] | (DOS_RAM[dta + 0x0E] << 8);
  if ((attr & 0x08) === 0x08 && (attr & 0x37) === 0) return 0;     // a volume label only
  while (idx < DOS_VFS_COUNT) {
    let name = DOS_VFS_NAMES[idx];
    idx++;
    if (name === "") continue;
    if (dosKernel_vfsMatch(pattern, dosKernel_vfs83(name)) === 0) continue;
    let size = DOS_VFS_DATA[idx - 1] ? DOS_VFS_DATA[idx - 1].length : 0;
    DOS_RAM[dta + 0x0D] = idx & 0xFF;
    DOS_RAM[dta + 0x0E] = (idx >> 8) & 0xFF;
    DOS_RAM[dta + 0x15] = 0x20;                                    // archive
    DOS_RAM[dta + 0x16] = 0x00; DOS_RAM[dta + 0x17] = 0x60;        // 12:00
    DOS_RAM[dta + 0x18] = 0x21; DOS_RAM[dta + 0x19] = 0x1C;        // 1994-01-01
    DOS_RAM[dta + 0x1A] = size & 0xFF;
    DOS_RAM[dta + 0x1B] = (size >> 8) & 0xFF;
    DOS_RAM[dta + 0x1C] = (size >> 16) & 0xFF;
    DOS_RAM[dta + 0x1D] = (size >>> 24) & 0xFF;
    for (let i = 0; i < 13; i++) DOS_RAM[dta + 0x1E + i] = (i < name.length) ? name.charCodeAt(i) & 0xFF : 0;
    return 1;
  }
  DOS_RAM[dta + 0x0D] = idx & 0xFF;
  DOS_RAM[dta + 0x0E] = (idx >> 8) & 0xFF;
  return 0;
}

function dosKernel_vfsAdd(name, bytes) {
  let clean = dosKernel_vfsClean(name);
  if (clean === "") return -1;
  let idx = dosKernel_vfsFind(clean);
  if (idx < 0) {
    // A deleted file's slot first, then a new one.
    for (let i = 0; i < DOS_VFS_COUNT; i++) if (DOS_VFS_NAMES[i] === "") { idx = i; break; }
    if (idx < 0) {
      if (DOS_VFS_COUNT >= DOS_VFS_MAX) return -1;
      idx = DOS_VFS_COUNT++;
    }
  }
  DOS_VFS_NAMES[idx] = clean;
  DOS_VFS_DATA[idx] = bytes;
  return idx;
}

// ---------------------------------------------------------------------------
// Text Mode Teletype Output
// ---------------------------------------------------------------------------
function dosKernel_putChar(ch) {
  if (ch === 13) { // CR
    DOS_CURSOR_COL = 0;
    return;
  }
  if (ch === 10) { // LF
    DOS_CURSOR_ROW++;
    if (DOS_CURSOR_ROW >= 25) {
      // Scroll up one row
      let textBase = 0xB8000;
      DOS_RAM.copyWithin(textBase, textBase + 160, textBase + (25 * 160));
      // Clear bottom line
      let lastLine = textBase + (24 * 160);
      for (let c = 0; c < 80; c++) {
        DOS_RAM[lastLine + (c * 2)] = 32;
        DOS_RAM[lastLine + (c * 2) + 1] = 0x07; // Light gray on black
      }
      DOS_CURSOR_ROW = 24;
    }
    return;
  }
  if (ch === 8) { // Backspace
    if (DOS_CURSOR_COL > 0) {
      DOS_CURSOR_COL--;
      let cell = 0xB8000 + ((DOS_CURSOR_ROW * 80 + DOS_CURSOR_COL) * 2);
      DOS_RAM[cell] = 32;
    }
    return;
  }

  let cell = 0xB8000 + ((DOS_CURSOR_ROW * 80 + DOS_CURSOR_COL) * 2);
  DOS_RAM[cell] = ch & 0xFF;
  DOS_RAM[cell + 1] = 0x07; // Default attribute

  DOS_CURSOR_COL++;
  if (DOS_CURSOR_COL >= 80) {
    DOS_CURSOR_COL = 0;
    dosKernel_putChar(10);
  }
}

function dosKernel_printStr(str) {
  for (let i = 0; i < str.length; i++) {
    dosKernel_putChar(str.charCodeAt(i));
  }
}

// ---------------------------------------------------------------------------
// Software Interrupt Dispatch
// ---------------------------------------------------------------------------
let DOS_INT_COUNT = 0;   // services requested since the last program started

// Unimplemented services are recorded rather than ignored, so the gaps show up
// the way an unknown opcode does instead of hiding behind a cleared carry flag.
let DOS_UNHANDLED_INT = -1;
let DOS_UNHANDLED_FN = -1;
let DOS_UNHANDLED_COUNT = 0;
function dosKernel_unhandled(intNum, fn) {
  DOS_UNHANDLED_INT = intNum;
  DOS_UNHANDLED_FN = fn;
  DOS_UNHANDLED_COUNT++;
  dosCpu_flushFlags();
  DOS_EFLAGS |= 0x01;                                    // CF = 1, the call failed
  DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x0001; // AX = 1, invalid function
}

function dosKernel_handleInt(intNum) {
  DOS_INT_COUNT++;
  // Handlers report success and failure by writing CF directly. Carry is
  // computed lazily from the last ALU result, so without folding that in
  // first every one of those writes would be read straight back over.
  dosCpu_flushFlags();

  // A vector the program installed itself wins over anything below, except
  // the DOS and BIOS entry points the kernel actually implements. This is what
  // lets a game's own timer or keyboard handler be reached by a software INT.
  if (DOS_VEC_SET !== null && DOS_VEC_SET[intNum & 0xFF] === 1 &&
      intNum !== 0x21 && intNum !== 0x31 && intNum !== 0x10 && intNum !== 0x16) {
    dosInt_enter(intNum);
    return;
  }

  // INT 33h: the mouse driver.
  if (intNum === 0x33) {
    dosMouse_int();
    return;
  }

  // INT F1h: the BIOS keyboard handler, reached through the stub vector 9
  // points at, by the IRQ or by a program chaining to the old vector.
  if (intNum === 0xF1) {
    dosInt_biosKey();
    return;
  }

  // INT 11h: equipment list. One floppy, 80x25 colour, no mouse port.
  if (intNum === 0x11) {
    DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x0021;
    return;
  }

  // INT 15h: system services. AH=86h waits in microseconds; the wait is the
  // caller's, so it is answered at once. AH=C0h (configuration) and AH=88h
  // (extended memory) are declined as an XT would.
  if (intNum === 0x15) {
    let ah = (DOS_REGS32[0] >> 8) & 0xFF;
    if (ah === 0x86 || ah === 0x4F) { DOS_EFLAGS &= ~0x01; return; }
    if (ah === 0x88) { DOS_REGS32[0] = DOS_REGS32[0] & 0xFFFF0000; DOS_EFLAGS &= ~0x01; return; }
    DOS_EFLAGS |= 0x01;
    DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF00FF) | 0x8600;
    return;
  }

  // INT 1Ah: the clock. AH=0 reads the tick count at 0040:006C into CX:DX
  // with the midnight flag in AL; AH=1 sets it; AH=2/4 answer the real-time
  // clock in BCD from the same count, since there is no battery here.
  if (intNum === 0x1A) {
    let ah = (DOS_REGS32[0] >> 8) & 0xFF;
    if (ah === 0x00) {
      let t = dosMmu_read32(0x0046C) >>> 0;
      DOS_REGS32[1] = (DOS_REGS32[1] & 0xFFFF0000) | ((t >>> 16) & 0xFFFF);
      DOS_REGS32[2] = (DOS_REGS32[2] & 0xFFFF0000) | (t & 0xFFFF);
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFFFF00) | (DOS_RAM[0x00470] & 1);
      DOS_RAM[0x00470] = 0;
      return;
    }
    if (ah === 0x01) {
      dosMmu_write32(0x0046C, (((DOS_REGS32[1] & 0xFFFF) << 16) | (DOS_REGS32[2] & 0xFFFF)) >>> 0);
      return;
    }
    if (ah === 0x02) {
      let secs = Math.floor((dosMmu_read32(0x0046C) >>> 0) / 18.2065);
      let hh = Math.floor(secs / 3600) % 24, mm = Math.floor(secs / 60) % 60, ss = secs % 60;
      let bcd = (n) => ((Math.floor(n / 10) << 4) | (n % 10)) & 0xFF;
      DOS_REGS32[1] = (DOS_REGS32[1] & 0xFFFF0000) | (bcd(hh) << 8) | bcd(mm);
      DOS_REGS32[2] = (DOS_REGS32[2] & 0xFFFF0000) | (bcd(ss) << 8);
      DOS_EFLAGS &= ~0x01;
      return;
    }
    if (ah === 0x04) {
      DOS_REGS32[1] = (DOS_REGS32[1] & 0xFFFF0000) | 0x1994;      // century, year
      DOS_REGS32[2] = (DOS_REGS32[2] & 0xFFFF0000) | 0x0101;      // month, day
      DOS_EFLAGS &= ~0x01;
      return;
    }
    DOS_EFLAGS |= 0x01;
    return;
  }

  // INT 12h: conventional memory size in KB.
  if (intNum === 0x12) {
    DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | ((DOS_DOSMEM_LIMIT >> 10) & 0xFFFF);
    return;
  }

  // INT 20h: terminate. Every .COM built before DOS 2.0 ends this way, and
  // without it the CPU runs off the end of the program into cleared RAM.
  if (intNum === 0x20) {
    dosKernel_printStr("\r\n");
    DOS_HALTED = 1;
    return;
  }
  // -------------------------------------------------------------------------
  // INT 10h: Video BIOS
  // -------------------------------------------------------------------------
  if (intNum === 0x10) {
    let ah = (DOS_REGS32[0] >> 8) & 0xFF;
    let al = DOS_REGS32[0] & 0xFF;

    if (ah === 0x00) {
      // Set Video Mode
      DOS_VIDEO_MODE = al;
      dosVga_modeRegs(al);
      if (al === 0x13) {
        // Clear VGA graphics buffer
        DOS_RAM.fill(0, 0xA0000, 0xA0000 + 64000);
      } else if (al === 0x03) {
        // Clear text mode buffer
        let textBase = 0xB8000;
        for (let i = 0; i < 2000; i++) {
          DOS_RAM[textBase + (i * 2)] = 32;
          DOS_RAM[textBase + (i * 2) + 1] = 0x07;
        }
        DOS_CURSOR_COL = 0;
        DOS_CURSOR_ROW = 0;
      }
      return;
    }

    // AH=02h: set cursor position (DH = row, DL = column)
    if (ah === 0x02) {
      DOS_CURSOR_ROW = (DOS_REGS32[2] >>> 8) & 0xFF;
      DOS_CURSOR_COL = DOS_REGS32[2] & 0xFF;
      if (DOS_CURSOR_ROW > 24) DOS_CURSOR_ROW = 24;
      if (DOS_CURSOR_COL > 79) DOS_CURSOR_COL = 79;
      return;
    }

    // AH=03h: read cursor position
    if (ah === 0x03) {
      DOS_REGS32[2] = (DOS_REGS32[2] & 0xFFFF0000) |
                      ((DOS_CURSOR_ROW & 0xFF) << 8) | (DOS_CURSOR_COL & 0xFF);
      DOS_REGS32[1] = (DOS_REGS32[1] & 0xFFFF0000) | 0x0607; // cursor scan lines
      return;
    }

    // AH=09h: write AL, attribute BL, CX times, without moving the cursor.
    if (ah === 0x09) {
      let ch = DOS_REGS32[0] & 0xFF;
      let attr = DOS_REGS32[3] & 0xFF;
      let count = DOS_REGS32[1] & 0xFFFF;
      if (count < 1) count = 1;
      let cell = 0xB8000 + ((DOS_CURSOR_ROW * 80 + DOS_CURSOR_COL) * 2);
      for (let i = 0; i < count; i++) {
        if (cell + 1 > 0xB8000 + 4000) break;
        DOS_RAM[cell] = ch;
        DOS_RAM[cell + 1] = attr;
        cell = cell + 2;
      }
      return;
    }

    if (ah === 0x0E) {
      // Teletype character output
      dosKernel_putChar(al);
      return;
    }

    if (ah === 0x0F) {
      // Get Current Video Mode
      // AH = columns (80), AL = mode, BH = active page (0)
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | (80 << 8) | DOS_VIDEO_MODE;
      return;
    }

    if (ah === 0x12) {
      // EGA/VGA Alternate Function Select
      DOS_REGS32[3] = (DOS_REGS32[3] & 0xFFFF0000) | 0x03; // 256KB video RAM
      return;
    }
  }

  // -------------------------------------------------------------------------
  // INT 16h: Keyboard BIOS
  // -------------------------------------------------------------------------
  if (intNum === 0x16) {
    let ah = (DOS_REGS32[0] >> 8) & 0xFF;
    // The BIOS enables interrupts on entry, which is what lets a program
    // that called with them off still receive the key it is waiting for.
    DOS_EFLAGS |= DOS_FL_IF;

    if (ah === 0x00 || ah === 0x10) {
      // Read Keystroke: AH = scan code, AL = ASCII. Waits for one by leaving
      // EIP on the INT so the next frame retries, rather than spinning here.
      if (DOS_KEY_HEAD !== DOS_KEY_TAIL) {
        let code = DOS_KEY_BUFFER[DOS_KEY_TAIL];
        DOS_KEY_TAIL = (DOS_KEY_TAIL + 1) & 31;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | (code & 0xFFFF);
      } else {
        DOS_EIP = (DOS_EIP - 2) >>> 0; // re-run this INT next time round
        DOS_KEY_WAITING = 1;
      }
      return;
    }

    if (ah === 0x01 || ah === 0x11) {
      // Check Keystroke Status (ZF=1 if no keystroke, ZF=0 if key available)
      dosCpu_flushFlags();
      if (DOS_KEY_HEAD !== DOS_KEY_TAIL) {
        DOS_EFLAGS &= ~0x40; // Clear ZF
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | (DOS_KEY_BUFFER[DOS_KEY_TAIL] & 0xFFFF);
      } else {
        DOS_EFLAGS |= 0x40;  // Set ZF (buffer empty)
      }
      return;
    }

    if (ah === 0x02 || ah === 0x12) {
      // Shift status, as the BIOS handler keeps it; AH=12h adds the
      // extended byte, which is empty here.
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | (DOS_KEY_SHIFT & 0xFF);
      return;
    }
  }

  // -------------------------------------------------------------------------
  // INT 21h: DOS System Calls (DOS Kernel HLE)
  // -------------------------------------------------------------------------
  if (intNum === 0x21) {
    let ah = (DOS_REGS32[0] >> 8) & 0xFF;
    let al = DOS_REGS32[0] & 0xFF;

    // AH=4Ch: Terminate with return code
    if (ah === 0x4C) {
      dosKernel_printStr("\r\nProgram terminated with exit code " + al + ".\r\n");
      DOS_HALTED = 1;
      return;
    }

    // AH=09h: Print '$'-terminated string at DS:EDX
    if (ah === 0x09) {
      let addr = dosMmu_linear(DOS_SEGS[3], DOS_REGS32[2]);
      let str = "";
      while (DOS_RAM[addr] !== 0x24) { // '$'
        str += String.fromCharCode(DOS_RAM[addr++]);
        if (str.length > 4000) break;
      }
      dosKernel_printStr(str);
      return;
    }

    // AH=02h: Write character in DL to stdout
    if (ah === 0x02) {
      let dl = DOS_REGS32[2] & 0xFF;
      dosKernel_putChar(dl);
      return;
    }

    // AH=30h: Get DOS Version (Return 6.22)
    if (ah === 0x30) {
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | (22 << 8) | 6; // AL=6, AH=22
      return;
    }

    // AH=3Dh: Open File (DS:EDX points to ASCIIZ filename)
    if (ah === 0x3D) {
      let namePtr = dosMmu_linear(DOS_SEGS[3], DOS_REGS32[2]);
      let filename = "";
      while (DOS_RAM[namePtr] !== 0) {
        filename += String.fromCharCode(DOS_RAM[namePtr++]);
        if (filename.length > 256) break;
      }

      let vfsIdx = dosKernel_vfsFind(filename);
      if (vfsIdx < 0) {
        // File not found -> CF=1, AX=2
        DOS_EFLAGS |= 0x01; // Carry Flag set
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x02;
        return;
      }

      let freeHandle = dosKernel_openHandle(vfsIdx);
      if (freeHandle < 0) {
        DOS_EFLAGS |= 0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x04; // Too many open files
        return;
      }
      DOS_EFLAGS &= ~0x01; // Success: CF=0
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | freeHandle;
      return;
    }

    // AH=3Ch: create or truncate a file; AH=5Bh: create one that must not
    // exist yet. Both answer a handle open for writing.
    if (ah === 0x3C || ah === 0x5B) {
      let name = dosKernel_nameAt(DOS_SEGS[3], DOS_REGS32[2]);
      if (ah === 0x5B && dosKernel_vfsFind(name) >= 0) {
        DOS_EFLAGS |= 0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x50;   // file exists
        return;
      }
      let vfsIdx = dosKernel_vfsAdd(name, new Uint8Array(0));
      let handle = (vfsIdx < 0) ? -1 : dosKernel_openHandle(vfsIdx);
      if (handle < 0) {
        DOS_EFLAGS |= 0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | ((vfsIdx < 0) ? 0x03 : 0x04);
        return;
      }
      DOS_EFLAGS &= ~0x01;
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | handle;
      return;
    }

    // AH=41h: delete a file.
    if (ah === 0x41) {
      let vfsIdx = dosKernel_vfsFind(dosKernel_nameAt(DOS_SEGS[3], DOS_REGS32[2]));
      if (vfsIdx < 0) {
        DOS_EFLAGS |= 0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x02;
        return;
      }
      DOS_VFS_NAMES[vfsIdx] = "";
      DOS_VFS_DATA[vfsIdx] = null;
      for (let h = 5; h < 32; h++) if (DOS_HANDLE_VFS[h] === vfsIdx) DOS_HANDLE_VFS[h] = -1;
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AH=56h: rename, DS:DX to ES:DI.
    if (ah === 0x56) {
      let vfsIdx = dosKernel_vfsFind(dosKernel_nameAt(DOS_SEGS[3], DOS_REGS32[2]));
      let to = dosKernel_vfsClean(dosKernel_nameAt(DOS_SEGS[0], DOS_REGS32[7]));
      if (vfsIdx < 0 || to === "") {
        DOS_EFLAGS |= 0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x02;
        return;
      }
      if (dosKernel_vfsFind(to) >= 0) {
        DOS_EFLAGS |= 0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x05;   // access denied
        return;
      }
      DOS_VFS_NAMES[vfsIdx] = to;
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AH=45h: duplicate a handle; AH=46h: force one onto another.
    if (ah === 0x45 || ah === 0x46) {
      let from = DOS_REGS32[3] & 0xFFFF;
      if (from >= 32 || (from >= 5 && DOS_HANDLE_VFS[from] === -1)) {
        DOS_EFLAGS |= 0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x06;
        return;
      }
      let to = (ah === 0x46) ? (DOS_REGS32[1] & 0xFFFF) : -1;
      if (ah === 0x45) {
        to = dosKernel_openHandle(DOS_HANDLE_VFS[from]);
        if (to < 0) {
          DOS_EFLAGS |= 0x01;
          DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x04;
          return;
        }
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | to;
      } else if (to >= 5 && to < 32) {
        DOS_HANDLE_VFS[to] = DOS_HANDLE_VFS[from];
      }
      if (from >= 5 && to >= 5 && to < 32) DOS_HANDLE_POS[to] = DOS_HANDLE_POS[from];
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AH=1Ah: set the DTA; AH=2Fh: read it back into ES:BX.
    if (ah === 0x1A) {
      DOS_DTA = dosKernel_bufAt(DOS_SEGS[3], DOS_REGS32[2]);
      return;
    }
    if (ah === 0x2F) {
      if (DOS_IS_32 === 1) {
        DOS_REGS32[3] = DOS_DTA >>> 0;
        DOS_SEGS[0] = 0;
      } else {
        DOS_SEGS[0] = (DOS_DTA >> 4) & 0xFFFF;
        DOS_REGS32[3] = (DOS_REGS32[3] & 0xFFFF0000) | (DOS_DTA & 0x0F);
      }
      return;
    }

    // AH=4Eh: find the first file matching DS:DX; AH=4Fh: the next. The
    // search state lives in the DTA, where DOS keeps it too.
    if (ah === 0x4E || ah === 0x4F) {
      if (ah === 0x4E) {
        let pat = dosKernel_vfsPattern(dosKernel_vfsClean(dosKernel_nameAt(DOS_SEGS[3], DOS_REGS32[2])));
        let dta = DOS_DTA & 0xFFFFFF;
        for (let i = 0; i < 11; i++) DOS_RAM[dta + i] = pat.charCodeAt(i);
        DOS_RAM[dta + 0x0C] = DOS_REGS32[1] & 0xFF;
        DOS_RAM[dta + 0x0D] = 0;
        DOS_RAM[dta + 0x0E] = 0;
      }
      if (dosKernel_findNext() === 1) {
        DOS_EFLAGS &= ~0x01;
        DOS_REGS32[0] = DOS_REGS32[0] & 0xFFFF0000;
        return;
      }
      DOS_EFLAGS |= 0x01;
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | ((ah === 0x4E) ? 0x02 : 0x12);
      return;
    }

    // AH=19h: current drive, C. AH=0Eh: select one; AL answers how many.
    if (ah === 0x19) { DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFFFF00) | 0x02; return; }
    if (ah === 0x0E) { DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFFFF00) | 0x1A; return; }

    // AH=47h: the current directory, which is the root: an empty string at
    // DS:SI. AH=39h/3Ah/3Bh: make, remove and change directory, all granted
    // since the drive is flat.
    if (ah === 0x47) {
      DOS_RAM[dosKernel_bufAt(DOS_SEGS[3], DOS_REGS32[6])] = 0;
      DOS_EFLAGS &= ~0x01;
      return;
    }
    if (ah === 0x39 || ah === 0x3A || ah === 0x3B) { DOS_EFLAGS &= ~0x01; return; }

    // AH=36h: free space. 512-byte sectors, 8 to a cluster, plenty free.
    if (ah === 0x36) {
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x0008;
      DOS_REGS32[3] = (DOS_REGS32[3] & 0xFFFF0000) | 0x4000;
      DOS_REGS32[1] = (DOS_REGS32[1] & 0xFFFF0000) | 0x0200;
      DOS_REGS32[2] = (DOS_REGS32[2] & 0xFFFF0000) | 0x7FF0;
      return;
    }

    // AH=2Ah: the date, CX=year DH=month DL=day AL=weekday; AH=2Ch: the
    // time, CH:CL hours:minutes DH:DL seconds:hundredths. Both from the
    // host clock, in UTC. AH=2Bh/2Dh set them: accepted.
    if (ah === 0x2A) {
      let days = Math.floor(Date.now() / 86400000);
      let ymd = dosKernel_civil(days);
      DOS_REGS32[1] = (DOS_REGS32[1] & 0xFFFF0000) | (ymd[0] & 0xFFFF);
      DOS_REGS32[2] = (DOS_REGS32[2] & 0xFFFF0000) | ((ymd[1] & 0xFF) << 8) | (ymd[2] & 0xFF);
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFFFF00) | ((days + 4) % 7);
      return;
    }
    if (ah === 0x2C) {
      let ms = Date.now() % 86400000;
      let s = Math.floor(ms / 1000);
      DOS_REGS32[1] = (DOS_REGS32[1] & 0xFFFF0000) | ((Math.floor(s / 3600) & 0xFF) << 8) | (Math.floor(s / 60) % 60);
      DOS_REGS32[2] = (DOS_REGS32[2] & 0xFFFF0000) | ((s % 60) << 8) | (Math.floor((ms % 1000) / 10) & 0xFF);
      return;
    }
    if (ah === 0x2B || ah === 0x2D) { DOS_REGS32[0] = DOS_REGS32[0] & 0xFFFFFF00; return; }

    // AH=57h: a file's date and time. Read answers the date every file
    // carries; set is accepted.
    if (ah === 0x57) {
      if ((DOS_REGS32[0] & 0xFF) === 0) {
        DOS_REGS32[1] = (DOS_REGS32[1] & 0xFFFF0000) | 0x6000;
        DOS_REGS32[2] = (DOS_REGS32[2] & 0xFFFF0000) | 0x1C21;
      }
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AH=33h: the break flag, off. AL=06h is the true version query.
    if (ah === 0x33) {
      if (al === 0x00) DOS_REGS32[2] = DOS_REGS32[2] & 0xFFFFFF00;
      else if (al === 0x06) { DOS_REGS32[3] = (DOS_REGS32[3] & 0xFFFF0000) | 0x1606; DOS_REGS32[2] = DOS_REGS32[2] & 0xFFFF0000; }
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AH=38h: country information, the US defaults, at DS:DX.
    if (ah === 0x38) {
      let addr = dosKernel_bufAt(DOS_SEGS[3], DOS_REGS32[2]);
      for (let i = 0; i < 34; i++) DOS_RAM[(addr + i) & 0xFFFFFF] = 0;
      DOS_RAM[(addr + 2) & 0xFFFFFF] = 0x24;    // "$"
      DOS_RAM[(addr + 7) & 0xFFFFFF] = 0x2C;    // ","
      DOS_RAM[(addr + 9) & 0xFFFFFF] = 0x2E;    // "."
      DOS_RAM[(addr + 11) & 0xFFFFFF] = 0x2D;   // "-"
      DOS_RAM[(addr + 13) & 0xFFFFFF] = 0x3A;   // ":"
      DOS_RAM[(addr + 16) & 0xFFFFFF] = 2;      // currency digits
      DOS_REGS32[3] = (DOS_REGS32[3] & 0xFFFF0000) | 0x0001;
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AH=4Dh: the last child's return code, none. AH=2Eh/54h: verify off.
    // AH=0Dh: disk reset. AH=37h: the switch character, "/".
    if (ah === 0x4D) { DOS_REGS32[0] = DOS_REGS32[0] & 0xFFFF0000; return; }
    if (ah === 0x2E || ah === 0x0D) return;
    if (ah === 0x54) { DOS_REGS32[0] = DOS_REGS32[0] & 0xFFFFFF00; return; }
    if (ah === 0x37) { DOS_REGS32[0] = DOS_REGS32[0] & 0xFFFFFF00; DOS_REGS32[2] = (DOS_REGS32[2] & 0xFFFFFF00) | 0x2F; return; }

    // Console input through DOS: AH=01h reads and echoes, 07h/08h read
    // without echo, 0Bh asks whether a key waits, 06h with DL=FFh reads
    // without waiting, 0Ch flushes then does one of those. Each of these
    // takes the BIOS buffer's ASCII; a wait parks on the INT as INT 16h does.
    if (ah === 0x0C) {
      DOS_KEY_HEAD = DOS_KEY_TAIL;
      let fn = al;
      if (fn !== 0x01 && fn !== 0x06 && fn !== 0x07 && fn !== 0x08 && fn !== 0x0A) { DOS_REGS32[0] = DOS_REGS32[0] & 0xFFFFFF00; return; }
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF00FF) | (fn << 8);
      ah = fn;
      if (ah === 0x0A) { dosKernel_unhandled(0x21, 0x0A); return; }
    }
    if (ah === 0x01 || ah === 0x07 || ah === 0x08) {
      dosInt_pumpKeys();
      if (DOS_KEY_HEAD === DOS_KEY_TAIL) {
        DOS_EIP = (DOS_EIP - 2) >>> 0;
        DOS_EFLAGS |= DOS_FL_IF;
        return;
      }
      let ch = DOS_KEY_BUFFER[DOS_KEY_TAIL] & 0xFF;
      DOS_KEY_TAIL = (DOS_KEY_TAIL + 1) & 31;
      if (ah === 0x01) dosKernel_putChar(ch);
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFFFF00) | ch;
      return;
    }
    if (ah === 0x0B) {
      dosInt_pumpKeys();
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFFFF00) | ((DOS_KEY_HEAD !== DOS_KEY_TAIL) ? 0xFF : 0x00);
      return;
    }
    if (ah === 0x06) {
      let dl = DOS_REGS32[2] & 0xFF;
      if (dl !== 0xFF) { dosKernel_putChar(dl); return; }
      dosInt_pumpKeys();
      dosCpu_flushFlags();
      if (DOS_KEY_HEAD === DOS_KEY_TAIL) {
        DOS_EFLAGS |= 0x40;
        DOS_REGS32[0] = DOS_REGS32[0] & 0xFFFFFF00;
        return;
      }
      DOS_EFLAGS &= ~0x40;
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFFFF00) | (DOS_KEY_BUFFER[DOS_KEY_TAIL] & 0xFF);
      DOS_KEY_TAIL = (DOS_KEY_TAIL + 1) & 31;
      return;
    }

    // AH=3Eh: Close File (BX = handle)
    if (ah === 0x3E) {
      let handle = DOS_REGS32[3] & 0xFFFF;
      if (handle >= 0 && handle < 32) {
        DOS_HANDLE_VFS[handle] = -1;
        DOS_HANDLE_POS[handle] = 0;
        DOS_EFLAGS &= ~0x01;
      } else {
        DOS_EFLAGS |= 0x01;
      }
      return;
    }

    // AH=3Fh: Read File (BX=handle, CX=bytes to read, DS:EDX=buffer)
    if (ah === 0x3F) {
      let handle = DOS_REGS32[3] & 0xFFFF;
      let count  = DOS_IS_32 ? DOS_REGS32[1] : (DOS_REGS32[1] & 0xFFFF);
      let dstPtr = dosMmu_linear(DOS_SEGS[3], DOS_REGS32[2]);

      if (handle < 0 || handle >= 32 || DOS_HANDLE_VFS[handle] === -1) {
        DOS_EFLAGS |= 0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x06; // Invalid handle
        return;
      }

      let vfsIdx = DOS_HANDLE_VFS[handle];
      let fileBytes = DOS_VFS_DATA[vfsIdx];
      let curPos = DOS_HANDLE_POS[handle];

      let available = Math.max(0, fileBytes.length - curPos);
      let toRead = Math.min(count, available);

      // Reading a file into memory is how a program loads an overlay, and an
      // overlay is code: any block decoded from this range is now stale.
      for (let t = 0; t < toRead; t = t + 4096) dosBc_touch((dstPtr + t) & 0xFFFFFF);
      if (toRead > 0) dosBc_touch((dstPtr + toRead - 1) & 0xFFFFFF);
      for (let i = 0; i < toRead; i++) {
        DOS_RAM[(dstPtr + i) & 0xFFFFFF] = fileBytes[curPos + i];
      }

      DOS_HANDLE_POS[handle] = curPos + toRead;
      DOS_EFLAGS &= ~0x01;
      if (DOS_IS_32) {
        DOS_REGS32[0] = toRead; // EAX = bytes read
      } else {
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | toRead; // AX = bytes read
      }
      return;
    }

    // AH=42h: Lseek (BX=handle, CX:DX=offset, AL=origin: 0=SEEK_SET, 1=SEEK_CUR, 2=SEEK_END)
    if (ah === 0x42) {
      let handle = DOS_REGS32[3] & 0xFFFF;
      let origin = al;
      let offset = 0;
      if (DOS_IS_32) {
        offset = DOS_REGS32[2]; // In 32-bit Watcom: EDX = 32-bit signed offset
      } else {
        offset = ((DOS_REGS32[1] & 0xFFFF) << 16) | (DOS_REGS32[2] & 0xFFFF);
      }

      if (handle < 0 || handle >= 32 || DOS_HANDLE_VFS[handle] === -1) {
        DOS_EFLAGS |= 0x01;
        return;
      }

      let vfsIdx = DOS_HANDLE_VFS[handle];
      let fileLen = DOS_VFS_DATA[vfsIdx].length;
      let newPos = 0;

      if (origin === 0) newPos = offset;
      else if (origin === 1) newPos = DOS_HANDLE_POS[handle] + offset;
      else if (origin === 2) newPos = fileLen + offset;

      newPos = Math.max(0, Math.min(fileLen, newPos));
      DOS_HANDLE_POS[handle] = newPos;

      DOS_EFLAGS &= ~0x01;
      if (DOS_IS_32) {
        DOS_REGS32[0] = newPos; // EAX = new position
      } else {
        DOS_REGS32[2] = newPos & 0xFFFF;        // DX = low 16
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | ((newPos >> 16) & 0xFFFF); // AX = high 16
      }
      return;
    }

    // AH=48h: Allocate Memory (BX = paragraphs in 16-bit, EBX = bytes in 32-bit)
    // AH=25h: set an interrupt vector. From 32-bit code the handler is the
    // flat address in EDX; from real mode it is DS:DX.
    if (ah === 0x25) {
      let vec = DOS_REGS32[0] & 0xFF;
      if (DOS_IS_32 === 1) {
        dosInt_setVector(vec, DOS_REGS32[2] >>> 0, 1);
      } else {
        dosInt_setVector(vec, ((DOS_SEGS[3] & 0xFFFF) << 16) | (DOS_REGS32[2] & 0xFFFF), 0);
      }
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AH=35h: read an interrupt vector back, into ES:BX (or EBX when flat).
    if (ah === 0x35) {
      let vec = DOS_REGS32[0] & 0xFF;
      let addr = dosInt_getVector(vec);
      if (DOS_IS_32 === 1) {
        DOS_REGS32[3] = addr >>> 0;
        DOS_SEGS[0] = 0;
      } else {
        DOS_SEGS[0] = (addr >>> 16) & 0xFFFF;
        DOS_REGS32[3] = (DOS_REGS32[3] & 0xFFFF0000) | (addr & 0xFFFF);
      }
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AH=40h: write CX bytes from DS:DX to a handle. Handles 1 (stdout) and
    // 2 (stderr) go to the screen; this is how DOOM prints its startup log.
    if (ah === 0x40) {
      let handle = DOS_REGS32[3] & 0xFFFF;
      let count = DOS_REGS32[1] & 0xFFFF;
      let addr = 0;
      if (DOS_IS_32 === 1) addr = DOS_REGS32[2] >>> 0;
      else addr = ((DOS_SEGS[3] << 4) + (DOS_REGS32[2] & 0xFFFF)) & 0xFFFFFF;
      if (handle === 1 || handle === 2) {
        let out = "";
        for (let i = 0; i < count; i++) out = out + String.fromCharCode(DOS_RAM[(addr + i) & 0xFFFFFF]);
        dosKernel_printStr(out);
        DOS_EFLAGS &= ~0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | (count & 0xFFFF);
        return;
      }
      if (handle < 5 || handle >= 32 || DOS_HANDLE_VFS[handle] === -1) {
        DOS_EFLAGS |= 0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x06;    // invalid handle
        return;
      }
      // A write to a file on the drive, growing it as needed. A count of
      // zero truncates at the current position, as DOS does.
      let vfsIdx = DOS_HANDLE_VFS[handle];
      let data = DOS_VFS_DATA[vfsIdx];
      if (data === null) data = new Uint8Array(0);
      let pos = DOS_HANDLE_POS[handle];
      if (DOS_IS_32 === 1) count = DOS_REGS32[1] >>> 0;
      let end = (count === 0) ? pos : pos + count;
      if (end !== data.length) {
        let grown = new Uint8Array(end);
        grown.set(data.subarray(0, Math.min(end, data.length)));
        data = grown;
        DOS_VFS_DATA[vfsIdx] = data;
      }
      for (let i = 0; i < count; i++) data[pos + i] = DOS_RAM[(addr + i) & 0xFFFFFF];
      DOS_HANDLE_POS[handle] = pos + count;
      DOS_EFLAGS &= ~0x01;
      if (DOS_IS_32 === 1) DOS_REGS32[0] = count >>> 0;
      else DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | (count & 0xFFFF);
      return;
    }

    // AH=43h: get/set file attributes. Only "does it exist" is meaningful here.
    if (ah === 0x43) {
      let al = DOS_REGS32[0] & 0xFF;
      let addr = 0;
      if (DOS_IS_32 === 1) addr = DOS_REGS32[2] >>> 0;
      else addr = ((DOS_SEGS[3] << 4) + (DOS_REGS32[2] & 0xFFFF)) & 0xFFFFFF;
      let name = "";
      for (let i = 0; i < 128; i++) {
        let ch = DOS_RAM[(addr + i) & 0xFFFFFF];
        if (ch === 0) break;
        name = name + String.fromCharCode(ch);
      }
      if (dosKernel_vfsFind(name) >= 0) {
        DOS_EFLAGS &= ~0x01;
        if (al === 0) DOS_REGS32[1] = (DOS_REGS32[1] & 0xFFFF0000) | 0x0020; // archive
        return;
      }
      DOS_EFLAGS |= 0x01;
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x0002; // file not found
      return;
    }

    // AH=44h AL=00h: get device information. The three standard handles are
    // character devices; anything else is a file on our virtual disk.
    if (ah === 0x44) {
      let al = DOS_REGS32[0] & 0xFF;
      let handle = DOS_REGS32[3] & 0xFFFF;
      if (al === 0) {
        let info = (handle <= 2) ? 0x0080 : 0x0000;
        if (handle === 0) info = info | 0x0001;   // stdin
        if (handle === 1 || handle === 2) info = info | 0x0002; // stdout/stderr
        DOS_REGS32[2] = (DOS_REGS32[2] & 0xFFFF0000) | info;
        DOS_EFLAGS &= ~0x01;
        return;
      }
      if (al === 1) { DOS_EFLAGS &= ~0x01; return; } // set device info: accept
      dosKernel_unhandled(0x21, 0x44);
      return;
    }

    // AH=4Ah: resize a memory block. A real-mode program's block is the PSP's
    // and runs to the top of conventional memory until this call shrinks it;
    // what follows is what AH=48h hands out. In 32-bit mode memory is a bump
    // allocator over a flat 16 MB, so a resize is granted as it is.
    if (ah === 0x4A) {
      if (DOS_IS_32) { DOS_EFLAGS &= ~0x01; return; }
      let base = (DOS_SEGS[0] & 0xFFFF) << 4;
      let want = (DOS_REGS32[3] & 0xFFFF) << 4;
      if (base + want > DOS_DOSMEM_LIMIT) {
        DOS_EFLAGS |= 0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x0008;                     // insufficient memory
        DOS_REGS32[3] = (DOS_REGS32[3] & 0xFFFF0000) | (((DOS_DOSMEM_LIMIT - base) >> 4) & 0xFFFF);
        return;
      }
      if (base === (DOS_PSP_SEG << 4) || base + want > DOS_DOSMEM_TOP) DOS_DOSMEM_TOP = base + want;
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AH=49h: free a block. The allocator only moves forward.
    if (ah === 0x49) {
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AH=51h / AH=62h: the current PSP's segment.
    if (ah === 0x51 || ah === 0x62) {
      DOS_REGS32[3] = (DOS_REGS32[3] & 0xFFFF0000) | (DOS_PSP_SEG & 0xFFFF);
      DOS_EFLAGS &= ~0x01;
      return;
    }

    if (ah === 0x48) {
      if (DOS_IS_32 === 0) {
        // Real mode: the paragraphs that follow the program's block, below
        // 640 KB, or error 8 with the largest block that would fit in BX.
        let want = (DOS_REGS32[3] & 0xFFFF) << 4;
        let bases = (DOS_DOSMEM_TOP + 15) & ~15;
        if (bases + want > DOS_DOSMEM_LIMIT) {
          DOS_EFLAGS |= 0x01;
          DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x0008;
          DOS_REGS32[3] = (DOS_REGS32[3] & 0xFFFF0000) | (((DOS_DOSMEM_LIMIT - bases) >> 4) & 0xFFFF);
          return;
        }
        DOS_DOSMEM_TOP = bases + want;
        DOS_EFLAGS &= ~0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | ((bases >> 4) & 0xFFFF);
        return;
      }
      let bytesReq = DOS_IS_32 ? DOS_REGS32[3] : ((DOS_REGS32[3] & 0xFFFF) * 16);
      let allocBase = DOS_DPMI_MEM_TOP;
      DOS_DPMI_MEM_TOP = (DOS_DPMI_MEM_TOP + bytesReq + 0xFFF) & ~0xFFF; // 4KB aligned

      DOS_EFLAGS &= ~0x01;
      if (DOS_IS_32) {
        DOS_REGS32[0] = allocBase; // EAX = linear address
      } else {
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | (allocBase >> 4); // AX = segment
      }
      return;
    }

    // Anything else: report failure rather than a phantom success.
    dosKernel_unhandled(0x21, ah);
    return;
  }

  // -------------------------------------------------------------------------
  // INT 31h: DPMI 0.9 (DOS Protected Mode Interface)
  // -------------------------------------------------------------------------
  if (intNum === 0x31) {
    let ax = DOS_REGS32[0] & 0xFFFF;

    // AX=0000h: Allocate LDT Descriptors (CX = count)
    if (ax === 0x0000) {
      let count = DOS_REGS32[1] & 0xFFFF;
      DOS_EFLAGS &= ~0x01;
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x0017; // Return dummy selector
      return;
    }

    // AX=0007h: Set Segment Base Address (BX = selector, CX:DX = base address)
    if (ax === 0x0007) {
      DOS_EFLAGS &= ~0x01; // Success
      return;
    }

    // AX=0008h: Set Segment Limit (BX = selector, CX:DX = limit)
    if (ax === 0x0008) {
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AX=0501h: Allocate Linear Memory Block (BX:CX = size in bytes)
    // AX=0500h: get free memory information. DOOM asks this before it sizes
    // its zone heap, and refuses to start on anything under 3.7 MB. The reply
    // is a 0x30-byte block at ES:EDI; leaving it unwritten made DOOM read
    // whatever was already there ("DPMI memory: 0x0, 0xfffe0000") and abort.
    if (ax === 0x0500) {
      let dst = 0;
      if (DOS_IS_32 === 1) dst = DOS_REGS32[7] >>> 0;
      else dst = ((DOS_SEGS[0] << 4) + (DOS_REGS32[7] & 0xFFFF)) & 0xFFFFFF;
      let freeBytes = 16777216 - DOS_DPMI_MEM_TOP;
      if (freeBytes < 0) freeBytes = 0;
      let freePages = Math.floor(freeBytes / 4096);
      // Unwritten fields must read as "unknown", which DPMI spells 0xFFFFFFFF.
      for (let i = 0; i < 0x30; i++) DOS_RAM[(dst + i) & 0xFFFFFF] = 0xFF;
      dosMmu_write32(dst + 0x00, freeBytes);   // largest free block, bytes
      dosMmu_write32(dst + 0x04, freePages);   // max unlocked page allocation
      dosMmu_write32(dst + 0x08, freePages);   // max locked page allocation
      dosMmu_write32(dst + 0x0C, 4096);        // linear address space, pages
      dosMmu_write32(dst + 0x10, freePages);   // total unlocked pages
      dosMmu_write32(dst + 0x14, freePages);   // free pages
      dosMmu_write32(dst + 0x18, 4096);        // total physical pages
      dosMmu_write32(dst + 0x1C, freePages);   // free linear address space
      dosMmu_write32(dst + 0x20, 0);           // no paging file
      DOS_EFLAGS &= ~0x01;
      return;
    }

    if (ax === 0x0501) {
      let size = ((DOS_REGS32[3] & 0xFFFF) << 16) | (DOS_REGS32[1] & 0xFFFF);
      let linearAddr = DOS_DPMI_MEM_TOP;
      if ((linearAddr + size) > 16777216) {
        dosCpu_flushFlags();
        DOS_EFLAGS |= 0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x8013; // out of memory
        return;
      }
      DOS_DPMI_MEM_TOP = (DOS_DPMI_MEM_TOP + size + 0xFFF) & ~0xFFF;

      DOS_EFLAGS &= ~0x01;
      DOS_REGS32[3] = (DOS_REGS32[3] & 0xFFFF0000) | ((linearAddr >> 16) & 0xFFFF); // BX = high 16
      DOS_REGS32[1] = (DOS_REGS32[1] & 0xFFFF0000) | (linearAddr & 0xFFFF);         // CX = low 16
      DOS_REGS32[6] = (DOS_REGS32[6] & 0xFFFF0000) | 0x0001;                       // SI:DI = handle
      DOS_REGS32[7] = (DOS_REGS32[7] & 0xFFFF0000) | 0x0001;
      return;
    }

    // AX=0800h: Physical Address Mapping (BX:CX = physical address, SI:DI = size)
    // Used by Doom to map VGA linear framebuffer at 0xA0000!
    if (ax === 0x0800) {
      let phys = ((DOS_REGS32[3] & 0xFFFF) << 16) | (DOS_REGS32[1] & 0xFFFF);
      DOS_EFLAGS &= ~0x01;
      // In our flat 16MB RAM model, physical address 0xA0000 is 1:1 linear 0xA0000!
      DOS_REGS32[3] = (DOS_REGS32[3] & 0xFFFF0000) | ((phys >> 16) & 0xFFFF);
      DOS_REGS32[1] = (DOS_REGS32[1] & 0xFFFF0000) | (phys & 0xFFFF);
      return;
    }

    // AX=0100h: allocate a DOS memory block. BX = paragraphs wanted; returns
    // the real-mode segment in AX and a selector for it in DX. Addresses here
    // are flat, so the "selector" is just the segment again.
    if (ax === 0x0100) {
      let paras = DOS_REGS32[3] & 0xFFFF;
      let want = paras * 16;
      let bases = (DOS_DOSMEM_TOP + 15) & ~15;
      if ((bases + want) > DOS_DOSMEM_LIMIT) {
        dosCpu_flushFlags();
        DOS_EFLAGS |= 0x01;
        DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x0008; // insufficient memory
        DOS_REGS32[3] = (DOS_REGS32[3] & 0xFFFF0000) |
                        (((DOS_DOSMEM_LIMIT - bases) >> 4) & 0xFFFF); // largest block
        return;
      }
      DOS_DOSMEM_TOP = bases + want;
      DOS_EFLAGS &= ~0x01;
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | ((bases >> 4) & 0xFFFF); // segment
      DOS_REGS32[2] = (DOS_REGS32[2] & 0xFFFF0000) | ((bases >> 4) & 0xFFFF); // selector
      return;
    }

    // AX=0101h free, AX=0102h resize. The allocator only ever moves forward, so
    // a free is a no-op and a resize keeps the block where it is.
    if (ax === 0x0101 || ax === 0x0102) {
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AX=0204h / 0205h: get and set a protected-mode interrupt vector.
    // BL = vector, CX:EDX = handler (the selector is ignored; memory is flat).
    if (ax === 0x0204) {
      let vec = DOS_REGS32[3] & 0xFF;
      DOS_REGS32[2] = dosInt_getVector(vec) >>> 0;
      DOS_REGS32[1] = (DOS_REGS32[1] & 0xFFFF0000) | 0x0000;
      DOS_EFLAGS &= ~0x01;
      return;
    }
    if (ax === 0x0205) {
      let vec = DOS_REGS32[3] & 0xFF;
      dosInt_setVector(vec, DOS_REGS32[2] >>> 0, 1);
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AX=0600h/0601h: lock and unlock a linear region. Nothing is ever paged
    // out here, so locking is a promise that costs nothing to keep.
    if (ax === 0x0600 || ax === 0x0601) {
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AX=0900h/0901h: get and set the virtual interrupt state. Returning the
    // real IF keeps a caller that saves and restores it consistent.
    if (ax === 0x0900 || ax === 0x0901) {
      dosCpu_flushFlags();
      let prev = ((DOS_EFLAGS & DOS_FL_IF) !== 0) ? 1 : 0;
      if (ax === 0x0900) DOS_EFLAGS &= ~DOS_FL_IF; else DOS_EFLAGS |= DOS_FL_IF;
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x0200 | prev;
      DOS_EFLAGS &= ~0x01;
      return;
    }
    if (ax === 0x0902) {
      dosCpu_flushFlags();
      let cur = ((DOS_EFLAGS & DOS_FL_IF) !== 0) ? 1 : 0;
      DOS_REGS32[0] = (DOS_REGS32[0] & 0xFFFF0000) | 0x0200 | cur;
      DOS_EFLAGS &= ~0x01;
      return;
    }

    // AX=0300h: Simulate Real Mode Interrupt
    if (ax === 0x0300) {
      let bl = DOS_REGS32[3] & 0xFF; // Interrupt number
      dosKernel_handleInt(bl);
      DOS_EFLAGS &= ~0x01;
      return;
    }

    dosKernel_unhandled(0x31, ax >>> 8);
    return;
  }
}
