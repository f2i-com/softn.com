// PackBits: decode one row of `expected` bytes from src[i..] into dst at o. Returns the new src index.
function psPackBitsRow(src, i, end, dst, o, expected) {
  let written = 0;
  while (written < expected) {
    if (i >= end) psFail("Truncated PSD RLE row.");
    let raw = src[i++];
    if (raw === 128) continue;
    if (raw < 128) {
      let count = raw + 1;
      if (written + count > expected || i + count > end) psFail("PSD RLE row expands past its declared width.");
      for (let k = 0; k < count; k++) dst[o + written + k] = src[i + k];
      i += count; written += count;
    } else {
      let count = 257 - raw;
      if (written + count > expected || i >= end) psFail("PSD RLE row expands past its declared width.");
      let v = src[i++];
      for (let k = 0; k < count; k++) dst[o + written + k] = v;
      written += count;
    }
  }
  return i;
}
// PackBits encode of `count` samples read as src[start + k * stride]; appended to writer. Returns bytes written.
function psPackBitsEncode(src, start, count, stride, w) {
  let before = w.len;
  let i = 0;
  while (i < count) {
    let v = src[start + i * stride];
    let run = 1;
    while (i + run < count && run < 128 && src[start + (i + run) * stride] === v) run++;
    if (run >= 3) { w.u8(257 - run); w.u8(v); i += run; continue; }
    let lit = i;
    i += run;
    while (i < count && i - lit < 128) {
      let v2 = src[start + i * stride];
      run = 1;
      while (i + run < count && run < 3 && src[start + (i + run) * stride] === v2) run++;
      if (run >= 3) break;
      i += Math.min(run, 128 - (i - lit));
    }
    w.u8(i - lit - 1);
    for (let p = lit; p < i; p++) w.u8(src[start + p * stride]);
  }
