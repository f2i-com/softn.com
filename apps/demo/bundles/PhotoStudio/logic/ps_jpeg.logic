  function startIdct() {
    let N = 8 / scale;
    for (let i = 0; i < frame.comps.length; i++) {
      let c = frame.comps[i];
      c.planeW = c.blocksPerLineMcu * N; c.planeH = c.blocksPerColumnMcu * N;
      c.plane = new Uint8Array(c.planeW * c.planeH);
    }
    idctState = { comp: 0, row: 0, tmp: new Int32Array(64), ftmp: new Float64Array(16), N: N, rowsPerStep: 0 };
  }
  function idctStep() {
    let s = idctState;
    if (s.comp >= frame.comps.length) return true;
    let c = frame.comps[s.comp];
    let qt = qts[c.tq];
    let N = s.N, bpl = c.blocksPerLineMcu, bpc = c.blocksPerColumnMcu;
    let rowsPerStep = Math.max(1, Math.floor(PS_JPEG_IDCT_BLOCKS / Math.max(1, bpl)));
    let end = Math.min(bpc, s.row + rowsPerStep);
    let coef = c.coef, plane = c.plane, stride = c.planeW, tmp = s.tmp, ftmp = s.ftmp;
    for (let row = s.row; row < end; row++) {
      for (let col = 0; col < bpl; col++) {
        let offset = (row * bpl + col) * 64;
        let outOffset = row * N * stride + col * N;
        if (N === 8) psJpegIdct8(coef, offset, qt, plane, outOffset, stride, tmp);
        else psJpegIdctN(coef, offset, qt, plane, outOffset, stride, N, ftmp);
      }
    }
    s.row = end;
    if (s.row >= bpc) { c.coef = null; s.comp++; s.row = 0; }
    return s.comp >= frame.comps.length ? true : (s.comp + s.row / bpc) / frame.comps.length;
  }

  let PS_CR_R = null, PS_CB_B = null, PS_CR_G = null, PS_CB_G = null;
  function colorTables() {
    if (PS_CR_R) return;
    PS_CR_R = new Int32Array(256); PS_CB_B = new Int32Array(256); PS_CR_G = new Int32Array(256); PS_CB_G = new Int32Array(256);
    for (let i = 0; i < 256; i++) {
      let d = i - 128;
      PS_CR_R[i] = Math.round(1.402 * d);
      PS_CB_B[i] = Math.round(1.772 * d);
      PS_CR_G[i] = Math.round(-0.714136 * d * 65536);
      PS_CB_G[i] = Math.round(-0.344136 * d * 65536);
