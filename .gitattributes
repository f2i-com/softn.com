.github/scripts/*.sh text eol=lf

# Bundle sources are packed into .softn archives byte for byte, so an archive
# and the file it was built from have to agree exactly. On Windows core.autocrlf
# rewrites text files on checkout, and a packed copy then no longer matches.
# Pinning LF keeps core's demo bundle reproducible on every platform. (The
# example applications themselves live in f2i-com/softn-Examples now.)
*.ui       text eol=lf
*.logic    text eol=lf
*.xdb      text eol=lf
*.wgsl     text eol=lf
packages/@softn/core/demo-bundle/**/*.json text eol=lf
packages/@softn/core/demo-bundle/**/*.svg  text eol=lf

# Packed binaries: never touched, and never diffed as text.
*.wav      binary
*.mp3      binary
*.png      binary
*.glb      binary
*.softn    binary
