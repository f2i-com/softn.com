  objs.push({ id: "hs_phone", type: "box", position: { x: 16, y: 0.74, z: 2 }, rotation: { x: -0.18, y: 0.3, z: 0 },
    width: 0.22, height: 0.42, depth: 0.04, color: "#18181b",
    emissive: "#22d3ee", emissiveIntensity: phoneRinging ? 1.6 : 0.15,
    animate: phoneRinging ? { floatAmplitude: 0.05, floatSpeed: 6 } : { rotateY: 0 } })
  // LUMA: a monitor on an arm, with an eye that notices you.
  objs.push({ id: "luma_base", type: "cylinder", position: { x: 14, y: 0.06, z: 8 }, radius: 0.3, height: 0.1, color: "#1f2430" })
