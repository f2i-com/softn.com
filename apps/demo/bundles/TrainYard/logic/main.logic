  list.push({
    id: "station-depot",
    type: "box",
    width: 3.4,
    height: 1.5,
    depth: 0.75,
    position: { x: -0.2, y: 1.35, z: 7.15 },
    color: "#991b1b",
    castShadow: true
  });
  list.push({
    id: "station-roof",
    type: "prism",
    width: 3.8,
    height: 0.85,
    depth: 0.95,
    position: { x: -0.2, y: 2.5, z: 7.15 },
    color: "#1e293b",
    flatShading: true,
    castShadow: true
  });

  // Town Commercial Shops (Hotel, General Store, Bakery at z = 7.15)
  let shops = [
    { x: 3.5, name: "hotel", color: "#fef3c7", roofColor: "#15803d", width: 2.2, height: 2.0, depth: 0.75 },
    { x: -3.5, name: "store", color: "#dc2626", roofColor: "#475569", width: 1.9, height: 1.6, depth: 0.75 },
    { x: -5.6, name: "bakery", color: "#f59e0b", roofColor: "#78350f", width: 1.8, height: 1.5, depth: 0.75 }
  ];
  for (let s = 0; s < shops.length; s = s + 1) {
    let sh = shops[s];
    list.push({
      id: "shop-" + sh.name,
      type: "box",
      width: sh.width,
      height: sh.height,
      depth: sh.depth,
      position: { x: sh.x, y: 0.55 + sh.height / 2, z: 7.15 },
      color: sh.color,
      castShadow: true
    });
    list.push({
      id: "roof-" + sh.name,
      type: "prism",
      width: sh.width + 0.25,
      height: 0.75,
      depth: sh.depth + 0.25,
      position: { x: sh.x, y: 0.55 + sh.height + 0.37, z: 7.15 },
      color: sh.roofColor,
      flatShading: true,
      castShadow: true
    });
  }

  // Paved Town Street (Straight two-lane roadway with turnarounds strictly on the table deck at z = 8.05)
  list.push({
    id: "street-asphalt",
    type: "box",
    width: 10.2,
    height: 0.02,
    depth: 0.96,
    position: { x: 0, y: 0.54, z: 8.05 },
    color: "#334155",
    receiveShadow: true
  });
  // East turnaround loop pavement
  list.push({
    id: "street-turn-e",
    type: "cylinder",
    radius: 0.48,
    height: 0.02,
    position: { x: 4.5, y: 0.54, z: 8.05 },
    color: "#334155"
  });
  // West turnaround loop pavement
  list.push({
    id: "street-turn-w",
    type: "cylinder",
    radius: 0.48,
    height: 0.02,
    position: { x: -4.5, y: 0.54, z: 8.05 },
    color: "#334155"
  });
  // Yellow Center Lane Divider Stripe
  list.push({
    id: "street-line",
    type: "box",
    width: 9.0,
    height: 0.022,
    depth: 0.035,
    position: { x: 0, y: 0.542, z: 8.05 },
    color: "#fbbf24"
  });
  // Rear Sidewalk in front of shops
  list.push({
    id: "sidewalk-rear",
    type: "box",
    width: 13.8,
    height: 0.035,
    depth: 0.25,
    position: { x: 0, y: 0.545, z: 7.55 },
    color: "#94a3b8"
  });
  // Front Sidewalk curb along front table edge
  list.push({
    id: "sidewalk-front",
    type: "box",
    width: 13.8,
    height: 0.035,
    depth: 0.30,
    position: { x: 0, y: 0.545, z: 8.58 },
    color: "#94a3b8"
  });

  // Front Fascia Control Board Backing & Brass Bezel Mounts
  list.push({
    id: "ctrl-plate",
    type: "box",
    width: 14.6,
    height: 0.95,
    depth: 0.06,
    position: { x: 0, y: 0.35, z: 9.32 },
    color: "#0f172a"
  });

  // 1. Throttle Bezel & Slot
  list.push({
    id: "ctrl-bezel-throttle",
    type: "box",
    width: 3.4,
    height: 0.46,
    depth: 0.04,
    position: { x: -4.5, y: 0.35, z: 9.34 },
    color: "#b45309",
    metalness: 0.8
  });
  list.push({
    id: "ctrl-slot",
    type: "box",
    width: 2.8,
    height: 0.14,
    depth: 0.06,
    position: { x: -4.5, y: 0.35, z: 9.36 },
    color: "#020617"
  });
  let ticks = [
    { x: -5.8, label: "0" },
    { x: -4.9, label: "35" },
    { x: -4.0, label: "70" },
    { x: -3.2, label: "100" }
  ];
  for (let k = 0; k < ticks.length; k = k + 1) {
    list.push({
      id: "ctrl-tick-" + k,
      type: "box",
      width: 0.03,
      height: 0.08,
      depth: 0.02,
      position: { x: ticks[k].x, y: 0.50, z: 9.36 },
      color: "#fbbf24"
    });
  }

  // 2. Direction Bezel
  list.push({
    id: "ctrl-bezel-dir",
    type: "box",
    width: 1.4,
    height: 0.65,
    depth: 0.04,
    position: { x: -1.8, y: 0.35, z: 9.34 },
    color: "#b45309",
    metalness: 0.8
  });

  // 3. Whistle Bezel
  list.push({
    id: "ctrl-bezel-whistle",
    type: "cylinder",
    radius: 0.32,
    height: 0.04,
    position: { x: 0.0, y: 0.35, z: 9.34 },
    rotation: { x: Math.PI / 2, y: 0, z: 0 },
    color: "#b45309",
    metalness: 0.8
  });

  // 4. Turntable Dial Bezel
  list.push({
    id: "ctrl-bezel-turntable",
    type: "cylinder",
    radius: 0.34,
    height: 0.04,
    position: { x: 1.8, y: 0.35, z: 9.34 },
    rotation: { x: Math.PI / 2, y: 0, z: 0 },
    color: "#b45309",
    metalness: 0.8
  });

  // 5. Lights Switch Bezel
  list.push({
    id: "ctrl-bezel-lights",
    type: "box",
    width: 1.4,
    height: 0.65,
    depth: 0.04,
    position: { x: 3.8, y: 0.35, z: 9.34 },
    color: "#b45309",
    metalness: 0.8
  });

  return list;
}

const staticObjects = buildStaticScenery();

// Build Dynamic Objects on each tick with Fully Connected Consist & Non-Colliding Traffic
function buildDynamicObjects() {
  let list = [];

  // Wheel rotation calculation for mechanical drive rods
  let wheelRot = trainProgress * 208.6;
  let rodOffsetY = Math.sin(wheelRot) * 0.12;
  let rodOffsetZ = Math.cos(wheelRot) * 0.12;

  // 1. STEAM LOCOMOTIVE
  let locoPt = getTrackPoint(trainProgress);
  let locoHead = getTrackHeading(trainProgress);

  let locoChildren = [
    // Boiler (Graphite steel)
    {
      id: "loco-boiler",
      type: "cylinder",
      radius: 0.38,
      height: 1.8,
      position: { x: 0, y: 0.65, z: 0.2 },
      rotation: { x: Math.PI / 2, y: 0, z: 0 },
      color: "#334155",
      metalness: 0.75,
      roughness: 0.3,
      castShadow: true
    },
    // Brass Boiler Bands
    {
      id: "loco-band-1",
      type: "cylinder",
      radius: 0.39,
      height: 0.05,
      position: { x: 0, y: 0.65, z: 0.6 },
      rotation: { x: Math.PI / 2, y: 0, z: 0 },
      color: "#fbbf24",
      metalness: 0.9,
      roughness: 0.15
    },
    {
      id: "loco-band-2",
      type: "cylinder",
      radius: 0.39,
      height: 0.05,
      position: { x: 0, y: 0.65, z: 0.0 },
      rotation: { x: Math.PI / 2, y: 0, z: 0 },
      color: "#fbbf24",
      metalness: 0.9,
      roughness: 0.15
    },
    // Locomotive Cab
    {
      id: "loco-cab",
      type: "box",
      width: 0.86,
      height: 0.95,
      depth: 0.9,
      position: { x: 0, y: 0.72, z: -0.7 },
      color: "#1e3a5f",
      castShadow: true
    },
    // Cab Windows (Glow warmly at night)
    {
      id: "loco-window",
      type: "box",
      width: 0.88,
      height: 0.28,
      depth: 0.45,
      position: { x: 0, y: 0.85, z: -0.65 },
      color: isNight && lightsEnabled ? "#fef08a" : "#bae6fd",
      emissive: isNight && lightsEnabled ? "#fef08a" : "#000000",
      emissiveIntensity: isNight && lightsEnabled ? 2.0 : 0.0
    },
    // Smokestack Chimney
    {
      id: "loco-stack",
      type: "cylinder",
      radius: 0.12,
      height: 0.45,
      position: { x: 0, y: 1.15, z: 0.95 },
      color: "#0f172a"
    },
    // Brass Steam Dome & Bell
    {
      id: "loco-dome",
      type: "sphere",
      radius: 0.18,
      position: { x: 0, y: 1.05, z: 0.4 },
      color: "#fbbf24",
      metalness: 0.9,
      roughness: 0.15
    },
    // Cowcatcher (Pilot wedge)
    {
      id: "loco-cowcatcher",
      type: "box",
      width: 0.78,
      height: 0.28,
      depth: 0.35,
      position: { x: 0, y: 0.22, z: 1.25 },
      color: "#1e293b"
    },
    // Front Headlight with Forward Glowing Lens
    {
      id: "loco-headlight-housing",
      type: "cylinder",
      radius: 0.14,
      height: 0.24,
      position: { x: 0, y: 0.96, z: 1.15 },
      rotation: { x: Math.PI / 2, y: 0, z: 0 },
      color: "#fbbf24",
      metalness: 0.9
    },
    {
      id: "loco-headlight-lens",
      type: "sphere",
      radius: 0.12,
      position: { x: 0, y: 0.96, z: 1.27 },
      color: "#ffffff",
      emissive: lightsEnabled ? "#fef08a" : "#333333",
      emissiveIntensity: lightsEnabled ? 3.0 : 0.0
    },
    // 6 Large Drive Wheels with Brass Counterweights
    {
      id: "loco-wheel-1",
      type: "cylinder",
      radius: 0.28,
      height: 0.86,
      position: { x: 0, y: 0.28, z: 0.6 },
      rotation: { x: wheelRot, y: 0, z: Math.PI / 2 },
      color: "#1e293b",
      metalness: 0.8
    },
    {
      id: "loco-wheel-2",
      type: "cylinder",
      radius: 0.28,
      height: 0.86,
      position: { x: 0, y: 0.28, z: 0.0 },
      rotation: { x: wheelRot, y: 0, z: Math.PI / 2 },
      color: "#1e293b",
      metalness: 0.8
    },
    {
      id: "loco-wheel-3",
      type: "cylinder",
      radius: 0.28,
      height: 0.86,
      position: { x: 0, y: 0.28, z: -0.6 },
      rotation: { x: wheelRot, y: 0, z: Math.PI / 2 },
      color: "#1e293b",
      metalness: 0.8
    },
    // Mechanical Connecting Side-Rods
    {
      id: "loco-rod-l",
      type: "box",
      width: 0.04,
      height: 0.06,
      depth: 1.25,
      position: { x: -0.45, y: 0.28 + rodOffsetY, z: 0.0 + rodOffsetZ },
      color: "#cbd5e1",
      metalness: 0.9,
      roughness: 0.15
    },
    {
      id: "loco-rod-r",
      type: "box",
      width: 0.04,
      height: 0.06,
      depth: 1.25,
      position: { x: 0.45, y: 0.28 + rodOffsetY, z: 0.0 + rodOffsetZ },
      color: "#cbd5e1",
      metalness: 0.9,
      roughness: 0.15
    },
    // Rear Drawbar & Knuckle Coupler
    {
      id: "loco-drawbar-rear",
      type: "box",
      width: 0.12,
      height: 0.10,
      depth: 0.45,
      position: { x: 0, y: 0.32, z: -1.25 },
      color: "#0f172a",
      metalness: 0.85
    },
    {
      id: "loco-knuckle-rear",
      type: "box",
      width: 0.18,
      height: 0.14,
      depth: 0.18,
      position: { x: 0, y: 0.32, z: -1.45 },
      color: "#1e293b",
      metalness: 0.9
    }
  ];

  list.push({
    id: "train-loco",
    type: "group",
    position: { x: locoPt.x, y: locoPt.y, z: locoPt.z },
    rotation: { x: 0, y: locoHead, z: 0 },
    children: locoChildren
  });

  // Update Chimney Smoke Particles
  let chimneyX = locoPt.x + Math.sin(locoHead) * 0.95;
  let chimneyZ = locoPt.z + Math.cos(locoHead) * 0.95;
  let chimneyY = locoPt.y + 1.25;
  updateSmoke(chimneyX, chimneyY, chimneyZ, trainSpeed);

  // 2. COAL TENDER (Articulated group firmly coupled to locomotive)
  let tenderProg = trainProgress - 0.038;
  let tenderPt = getTrackPoint(tenderProg);
  let tenderHead = getTrackHeading(tenderProg);

  list.push({
    id: "train-tender",
    type: "group",
    position: { x: tenderPt.x, y: tenderPt.y, z: tenderPt.z },
    rotation: { x: 0, y: tenderHead, z: 0 },
    children: [
      {
        id: "tender-body",
        type: "box",
        width: 0.82,
        height: 0.65,
        depth: 1.4,
        position: { x: 0, y: 0.52, z: 0 },
        color: "#1e293b",
        castShadow: true
      },
      {
        id: "tender-coal",
        type: "box",
        width: 0.72,
        height: 0.28,
        depth: 1.0,
        position: { x: 0, y: 0.75, z: 0.05 },
        color: "#09090b",
        roughness: 0.95
      },
      // Cab-to-Tender Gangway Footplate
      {
        id: "tender-footplate",
        type: "box",
        width: 0.62,
        height: 0.04,
        depth: 0.45,
        position: { x: 0, y: 0.46, z: 0.82 },
        color: "#09090b"
      },
      // Front Drawbar (Interlocks with locomotive rear knuckle)
      {
        id: "tender-drawbar-front",
        type: "box",
        width: 0.12,
        height: 0.10,
        depth: 0.45,
        position: { x: 0, y: 0.32, z: 0.85 },
        color: "#0f172a",
        metalness: 0.85
      },
      {
        id: "tender-knuckle-front",
        type: "box",
        width: 0.18,
        height: 0.14,
        depth: 0.18,
        position: { x: 0, y: 0.32, z: 1.05 },
        color: "#1e293b",
        metalness: 0.9
      },
      // Rear Coupler (Connects with boxcar)
      {
        id: "tender-coupler-rear",
        type: "box",
        width: 0.10,
        height: 0.09,
        depth: 0.38,
        position: { x: 0, y: 0.32, z: -0.85 },
        color: "#0f172a"
      },
      {
        id: "tender-knuckle-rear",
        type: "box",
        width: 0.16,
        height: 0.13,
        depth: 0.15,
        position: { x: 0, y: 0.32, z: -1.02 },
        color: "#1e293b",
        metalness: 0.85
      },
      {
        id: "tender-wheel-1",
        type: "cylinder",
        radius: 0.18,
        height: 0.82,
        position: { x: 0, y: 0.18, z: 0.4 },
        rotation: { x: wheelRot * 1.5, y: 0, z: Math.PI / 2 },
        color: "#0f172a"
      },
      {
        id: "tender-wheel-2",
        type: "cylinder",
        radius: 0.18,
        height: 0.82,
        position: { x: 0, y: 0.18, z: -0.4 },
        rotation: { x: wheelRot * 1.5, y: 0, z: Math.PI / 2 },
        color: "#0f172a"
      }
    ]
  });

  // 3. VINTAGE BURGUNDY BOXCAR (Articulated group with front and rear interlocking couplers)
  let boxcarProg = trainProgress - 0.076;
  let boxcarPt = getTrackPoint(boxcarProg);
  let boxcarHead = getTrackHeading(boxcarProg);

  list.push({
    id: "train-boxcar",
    type: "group",
    position: { x: boxcarPt.x, y: boxcarPt.y, z: boxcarPt.z },
    rotation: { x: 0, y: boxcarHead, z: 0 },
    children: [
      {
        id: "boxcar-body",
        type: "box",
        width: 0.82,
        height: 0.82,
        depth: 1.7,
        position: { x: 0, y: 0.65, z: 0 },
        color: "#991b1b",
        castShadow: true
      },
      {
        id: "boxcar-roof",
        type: "box",
        width: 0.86,
        height: 0.08,
        depth: 1.76,
        position: { x: 0, y: 1.1, z: 0 },
        color: "#334155"
      },
      // Front Coupler (Interlocks with tender rear coupler)
      {
        id: "boxcar-coupler-front",
        type: "box",
        width: 0.10,
        height: 0.09,
        depth: 0.38,
        position: { x: 0, y: 0.32, z: 0.98 },
        color: "#0f172a"
      },
      {
        id: "boxcar-knuckle-front",
        type: "box",
        width: 0.16,
        height: 0.13,
        depth: 0.15,
        position: { x: 0, y: 0.32, z: 1.15 },
        color: "#1e293b",
        metalness: 0.85
      },
      // Rear Coupler (Extends back to connect with tanker)
      {
        id: "boxcar-coupler-rear",
        type: "box",
        width: 0.10,
        height: 0.09,
        depth: 0.38,
        position: { x: 0, y: 0.32, z: -0.98 },
        color: "#0f172a"
      },
      {
        id: "boxcar-knuckle-rear",
        type: "box",
        width: 0.16,
        height: 0.13,
        depth: 0.15,
        position: { x: 0, y: 0.32, z: -1.15 },
        color: "#1e293b",
        metalness: 0.85
      },
      {
        id: "boxcar-wheel-1",
        type: "cylinder",
        radius: 0.18,
        height: 0.82,
        position: { x: 0, y: 0.18, z: 0.55 },
        rotation: { x: wheelRot * 1.5, y: 0, z: Math.PI / 2 },
        color: "#0f172a"
      },
      {
        id: "boxcar-wheel-2",
        type: "cylinder",
        radius: 0.18,
        height: 0.82,
        position: { x: 0, y: 0.18, z: -0.55 },
        rotation: { x: wheelRot * 1.5, y: 0, z: Math.PI / 2 },
        color: "#0f172a"
      }
    ]
  });

  // 4. CHEMICAL TANK CAR (Articulated group with front and rear interlocking couplers)
  let tankerProg = trainProgress - 0.114;
  let tankerPt = getTrackPoint(tankerProg);
  let tankerHead = getTrackHeading(tankerProg);

  list.push({
    id: "train-tanker",
    type: "group",
    position: { x: tankerPt.x, y: tankerPt.y, z: tankerPt.z },
    rotation: { x: 0, y: tankerHead, z: 0 },
    children: [
      {
        id: "tanker-cylinder",
        type: "capsule",
        radius: 0.36,
        height: 1.3,
        position: { x: 0, y: 0.64, z: 0 },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: "#cbd5e1",
        metalness: 0.85,
        roughness: 0.18,
        castShadow: true
      },
      {
        id: "tanker-dome",
        type: "cylinder",
        radius: 0.15,
        height: 0.16,
        position: { x: 0, y: 1.05, z: 0 },
        color: "#94a3b8",
        metalness: 0.8
      },
      {
        id: "tanker-frame",
        type: "box",
        width: 0.78,
        height: 0.12,
        depth: 1.7,
        position: { x: 0, y: 0.28, z: 0 },
        color: "#1e293b"
      },
      // Front Coupler (Interlocks with boxcar rear coupler)
      {
        id: "tanker-coupler-front",
        type: "box",
        width: 0.10,
        height: 0.09,
        depth: 0.38,
        position: { x: 0, y: 0.32, z: 0.98 },
        color: "#0f172a"
      },
      {
        id: "tanker-knuckle-front",
        type: "box",
        width: 0.16,
        height: 0.13,
        depth: 0.15,
        position: { x: 0, y: 0.32, z: 1.15 },
        color: "#1e293b",
        metalness: 0.85
      },
      // Rear Coupler (Extends back to connect with caboose)
      {
        id: "tanker-coupler-rear",
        type: "box",
        width: 0.10,
        height: 0.09,
        depth: 0.38,
        position: { x: 0, y: 0.32, z: -0.98 },
        color: "#0f172a"
      },
      {
        id: "tanker-knuckle-rear",
        type: "box",
        width: 0.16,
        height: 0.13,
        depth: 0.15,
        position: { x: 0, y: 0.32, z: -1.15 },
        color: "#1e293b",
        metalness: 0.85
      },
      {
        id: "tanker-wheel-1",
        type: "cylinder",
        radius: 0.18,
        height: 0.82,
        position: { x: 0, y: 0.18, z: 0.55 },
        rotation: { x: wheelRot * 1.5, y: 0, z: Math.PI / 2 },
        color: "#0f172a"
      },
      {
        id: "tanker-wheel-2",
        type: "cylinder",
        radius: 0.18,
        height: 0.82,
        position: { x: 0, y: 0.18, z: -0.55 },
        rotation: { x: wheelRot * 1.5, y: 0, z: Math.PI / 2 },
        color: "#0f172a"
      }
    ]
  });

  // 5. BRIGHT RED CABOOSE WITH CUPOLA (Articulated group with front coupler and rear marker lamps)
  let cabooseProg = trainProgress - 0.152;
  let caboosePt = getTrackPoint(cabooseProg);
  let cabooseHead = getTrackHeading(cabooseProg);

  list.push({
    id: "train-caboose",
    type: "group",
    position: { x: caboosePt.x, y: caboosePt.y, z: caboosePt.z },
    rotation: { x: 0, y: cabooseHead, z: 0 },
    children: [
      {
        id: "caboose-body",
        type: "box",
        width: 0.82,
        height: 0.72,
        depth: 1.5,
        position: { x: 0, y: 0.6, z: 0 },
        color: "#dc2626",
        castShadow: true
      },
      {
        id: "caboose-cupola",
        type: "box",
        width: 0.68,
        height: 0.38,
        depth: 0.55,
