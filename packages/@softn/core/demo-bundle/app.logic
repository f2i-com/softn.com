/**
 * App Logic - Todo Application Business Logic
 *
 * This file contains all the state and functions for the todo app.
 * It's separate from the UI for better organization and reusability.
 */

import "./utils.logic"

// ============================================================================
// State
// ============================================================================

// Current todos (loaded from XDB)
let todos = []

// Input for new todo
let newTodoText = ""

// Current filter
let filter = "all"  // "all" | "active" | "completed"

// ============================================================================
// Computed Values
// ============================================================================

// A computed value is a `$:` declaration. The runtime finds these by name,
// compiles each expression into a function, and re-evaluates it when the state
// it reads moves. `$computed(() => ...)` was an earlier spelling that nothing
// defines any more, so it reached the browser as
// "ReferenceError: $computed is not defined".

// Active todos (not completed)
$: activeTodos = todos.filter(t => !t.data.completed)

// Completed todos
$: completedTodos = todos.filter(t => t.data.completed)

// Filtered todos based on the current filter
// One line: the extractor reads `$:` declarations a line at a time, so a
// wrapped expression is truncated at the newline and fails to compile.
$: filteredTodos = filter === "active" ? activeTodos : filter === "completed" ? completedTodos : todos

// ============================================================================
// Actions
// ============================================================================

/**
 * Handle form submission to add new todo
 */
async function handleAddTodo(event) {
  event.preventDefault()

  const text = newTodoText.trim()
  if (!text) return

  // Create todo in XDB
  await xdb.create("todos", {
    text: text,
    completed: false,
    createdAt: new Date().toISOString()
  })

  // Clear input
  newTodoText = ""

  // Refresh list
  await refreshTodos()
}

/**
 * Toggle todo completion status
 */
async function toggleTodo(id) {
  const todo = todos.find(t => t.id === id)
  if (!todo) return

  await xdb.update(id, {
    completed: !todo.data.completed,
    completedAt: !todo.data.completed ? new Date().toISOString() : null
  })

  await refreshTodos()
}

/**
 * Delete a todo
 */
async function deleteTodo(id) {
  await xdb.delete(id)
  await refreshTodos()
}

/**
 * Edit a todo's text
 */
async function editTodo(id, newText) {
  const text = newText.trim()
  if (!text) return

  await xdb.update(id, {
    text: text,
    updatedAt: new Date().toISOString()
  })

  await refreshTodos()
}

/**
 * Clear all completed todos
 */
async function clearCompleted() {
  for (const todo of completedTodos) {
    await xdb.delete(todo.id)
  }
  await refreshTodos()
}

/**
 * Set the current filter
 */
function setFilter(newFilter) {
  filter = newFilter
}

/**
 * Refresh todos from XDB
 */
async function refreshTodos() {
  todos = xdb.getAll("todos")
}

// ============================================================================
// Initialize
// ============================================================================

// Load todos on startup
refreshTodos()
