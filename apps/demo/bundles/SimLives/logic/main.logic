  cook: { kind: "stove", carry: true, opt: { id: "cookstep", label: "Cook it on the stove", icon: "🍳", need: "hunger", gain: 6, mins: 9, pose: "stand", anim: "cook", also: { fun: 3 } } },
  eat: { kind: "dining_table", carry: true, opt: INTERACTIONS.dining_table[0], fallback: EATSTAND },
  eatstand: { kind: null, opt: EATSTAND },
  washup: { kind: "sink_unit", carry: true, opt: { id: "dishes", label: "Wash the dishes", icon: "🍽", need: "hygiene", gain: 4, mins: 4, pose: "stand", anim: "wash" } },
