// ps_editor.logic - the document: layers, selection, history, compositing,
// overlays, brushes and every whole-image operation, all inside ZIPP.
//
// State lives in PS_* globals that the template never names, so the runtime
// keeps them VM-owned. Whole-image work is sliced through the job queue; the
// compositor recomposites only invalidated rectangles and does so incrementally
// from frameSource(), so a stroke updates the rectangle it touched and nothing
// else.

let PS_W = 0, PS_H = 0, PS_NAME = "Untitled";
let PS_LAYERS = [];
let PS_ACTIVE = null;
let PS_SEL = null;
let PS_MASKMODE = false;
let PS_COMP = null;
let PS_COMP32 = null;
let PS_HISTORY = [], PS_HIST_INDEX = -1, PS_SEQ = 0, PS_SAVED = 0;
let PS_TX = null;
let PS_STROKE = null;
let PS_CLONE = null;
let PS_WARNINGS = [];
let PS_FRAME = 1, PS_PRESENTED = 0;
let PS_DIRTY = null;
let PS_COMPOSITE_BUDGET = 350000;      // layer-pixels per compositing slice (about 70 ms per frame on the shipping engine)
let PS_OVL_IDX = null, PS_OVL_COLOR = null, PS_OVL_SAVED = null, PS_OVL_COUNT = 0, PS_OVL_APPLIED = false, PS_OVL_CAP = 400000;
let PS_OVL_SEL = null, PS_OVL_GESTURE = null, PS_OVL_CLONE = null;   // { idx: Int32Array, color: Uint8Array, count }
let PS_LISTENER = null;               // main.logic hook: psOnDocument(kind)
let PS_BLEND_INDEX = { normal: 0, multiply: 1, screen: 2, overlay: 3, darken: 4, lighten: 5, "color-dodge": 6, "color-burn": 7, "hard-light": 8, "soft-light": 9, difference: 10, exclusion: 11, hue: 12, saturation: 13, color: 14, luminosity: 15 };

function psEmit(kind) { if (PS_LISTENER) PS_LISTENER(kind); }
function psActive() {
  for (let i = 0; i < PS_LAYERS.length; i++) if (PS_LAYERS[i].id === PS_ACTIVE) return PS_LAYERS[i];
  return PS_LAYERS[PS_LAYERS.length - 1] || null;
}
function psActiveIndex() { let a = psActive(); return a ? PS_LAYERS.indexOf(a) : -1; }
function psDirty() { return PS_HISTORY.length ? PS_HISTORY[PS_HIST_INDEX].token !== PS_SAVED : false; }
function psCanUndo() { return PS_HIST_INDEX > 0; }
function psCanRedo() { return PS_HIST_INDEX < PS_HISTORY.length - 1; }
function psLayerFactory(name, data, extra) {
  let l = { id: psUid(), name: String(name || "Layer").slice(0, 255), data: data, mask: null, maskEnabled: true, visible: true, locked: false, opacity: 1, blend: "normal", kind: "raster", text: null };
  if (extra) { let keys = Object.keys(extra); for (let i = 0; i < keys.length; i++) l[keys[i]] = extra[keys[i]]; }
  return l;
}
function psCloneMeta(l) {
  return { id: l.id, name: l.name, data: l.data, mask: l.mask, maskEnabled: l.maskEnabled, visible: l.visible, locked: l.locked, opacity: l.opacity, blend: l.blend, kind: l.kind, text: l.text ? Object.assign({}, l.text) : null };
}
function psBudget(w, h, layerCount, maskCount) {
  let n = psCheckDims(w, h);
  if (layerCount > PS_MAX_LAYERS) psFail("Maximum " + PS_MAX_LAYERS + " layers in this edition.");
  if (n * 4 * layerCount + n * (maskCount || 0) + n * 4 > PS_MAX_LIVE_BYTES) psFail("Layer surfaces would exceed the " + (PS_MAX_LIVE_BYTES / 1048576) + " MiB document limit. Reduce the image size or merge layers.");
}

// ---------------------------------------------------------------------------
// History
// ---------------------------------------------------------------------------
function psSnapshot() {
  let layers = [];
  for (let i = 0; i < PS_LAYERS.length; i++) layers.push(psCloneMeta(PS_LAYERS[i]));
  return { w: PS_W, h: PS_H, name: PS_NAME, layers: layers, active: PS_ACTIVE, sel: PS_SEL, maskMode: PS_MASKMODE };
}
function psRestore(s) {
  let sizeChanged = s.w !== PS_W || s.h !== PS_H;
  PS_W = s.w; PS_H = s.h; PS_NAME = s.name;
  PS_LAYERS = [];
  for (let i = 0; i < s.layers.length; i++) PS_LAYERS.push(psCloneMeta(s.layers[i]));
  PS_ACTIVE = s.active; PS_SEL = s.sel; PS_MASKMODE = s.maskMode;
  PS_STROKE = null;
  if (sizeChanged || !PS_COMP) psAllocComposite();
  psInvalidateAll();
  psSelectionChanged();
  psEmit(sizeChanged ? "document" : "change");
}
function psResetHistory(label) {
  PS_SEQ++;
  PS_HISTORY = [{ label: label, snap: psSnapshot(), token: PS_SEQ }];
  PS_HIST_INDEX = 0; PS_SAVED = PS_SEQ; PS_TX = null;
}
function psBegin(label) {
  if (PS_TX) psFail("Another edit is already in progress.");
  if (PS_HISTORY.length) PS_HISTORY[PS_HIST_INDEX].snap = psSnapshot();
  PS_TX = { label: label, before: psSnapshot(), cloned: {} };
}
// The buffer a pixel edit may write: cloned once per transaction (copy-on-write).
function psEditable(mask) {
  let l = psActive();
  if (!l) psFail("There is no layer to edit.");
  if (l.locked) psFail("Unlock the active layer before editing.");
  if (!PS_TX) psFail("Pixel edits require a transaction.");
  let key = mask && l.mask ? "mask" : "data";
  let id = l.id + ":" + key;
  if (!PS_TX.cloned[id]) { l[key] = l[key].slice(); PS_TX.cloned[id] = true; }
  if (key === "data") { l.kind = "raster"; l.text = null; }
  return l[key];
}
function psCommit() {
  if (!PS_TX) return;
  let label = PS_TX.label; PS_TX = null;
  PS_HISTORY.splice(PS_HIST_INDEX + 1);
  PS_SEQ++;
  PS_HISTORY.push({ label: label, snap: psSnapshot(), token: PS_SEQ });
  PS_HIST_INDEX++;
  psPruneHistory();
  psEmit("change");
}
function psRollback() {
  if (!PS_TX) return;
  let before = PS_TX.before; PS_TX = null;
  psRestore(before);
}
function psMutate(label, fn) {
  psBegin(label);
  try { fn(); psCommit(); } catch (error) { psRollback(); throw error; }
}
function psSurfacesOf(snap, into) {
  for (let i = 0; i < snap.layers.length; i++) { let l = snap.layers[i]; into.add(l.data); if (l.mask) into.add(l.mask); }
  if (snap.sel) into.add(snap.sel);
}
function psPruneHistory() {
  while (PS_HISTORY.length > 1) {
    if (PS_HISTORY.length <= 100) {
      let live = new Set(); psSurfacesOf(psSnapshot(), live);
      let all = new Set();
      for (let i = 0; i < PS_HISTORY.length; i++) psSurfacesOf(PS_HISTORY[i].snap, all);
      let bytes = 0;
      all.forEach(function (buf) { if (!live.has(buf)) bytes += buf.length; });
      if (bytes <= PS_MAX_HISTORY_BYTES) break;
    }
    PS_HISTORY.shift(); PS_HIST_INDEX--;
  }
  if (PS_HIST_INDEX < 0) PS_HIST_INDEX = 0;
}
function psUndo() {
  if (PS_TX) psRollback();
  if (!psCanUndo()) return;
  PS_HIST_INDEX--;
  psRestore(PS_HISTORY[PS_HIST_INDEX].snap);
}
function psRedo() {
  if (PS_TX || !psCanRedo()) return;
  PS_HIST_INDEX++;
  psRestore(PS_HISTORY[PS_HIST_INDEX].snap);
}
function psMarkSaved() { PS_SAVED = PS_HISTORY[PS_HIST_INDEX].token; psEmit("status"); }

// ---------------------------------------------------------------------------
// Compositing
// ---------------------------------------------------------------------------
function psAllocComposite() {
  PS_COMP = new Uint8Array(PS_W * PS_H * 4);
  PS_COMP32 = new Uint32Array(PS_COMP.buffer);
  PS_OVL_APPLIED = false; PS_OVL_COUNT = 0;
  PS_OVL_IDX = new Int32Array(PS_OVL_CAP); PS_OVL_COLOR = new Uint8Array(PS_OVL_CAP); PS_OVL_SAVED = new Uint32Array(PS_OVL_CAP);
}
function psInvalidate(x0, y0, x1, y1) {
  if (x0 < 0) x0 = 0; if (y0 < 0) y0 = 0; if (x1 > PS_W) x1 = PS_W; if (y1 > PS_H) y1 = PS_H;
  if (x1 <= x0 || y1 <= y0) return;
  if (!PS_DIRTY) PS_DIRTY = { x0: x0, y0: y0, x1: x1, y1: y1 };
  else { if (x0 < PS_DIRTY.x0) PS_DIRTY.x0 = x0; if (y0 < PS_DIRTY.y0) PS_DIRTY.y0 = y0; if (x1 > PS_DIRTY.x1) PS_DIRTY.x1 = x1; if (y1 > PS_DIRTY.y1) PS_DIRTY.y1 = y1; }
  PS_FRAME++;
}
function psInvalidateAll() { psInvalidate(0, 0, PS_W, PS_H); }
function psVisibleLayerCount() { let n = 0; for (let i = 0; i < PS_LAYERS.length; i++) if (PS_LAYERS[i].visible) n++; return n; }

// Blend-mode colour functions (W3C compositing), per channel or non-separable, on 0..1 values.
function psBlendChannel(mode, cb, cs) {
  switch (mode) {
    case 1: return cb * cs;
    case 2: return cb + cs - cb * cs;
    case 3: return cb <= 0.5 ? cs * 2 * cb : 1 - (1 - cs) * (1 - (2 * cb - 1));
    case 4: return cb < cs ? cb : cs;
    case 5: return cb > cs ? cb : cs;
    case 6: return cb === 0 ? 0 : cs >= 1 ? 1 : Math.min(1, cb / (1 - cs));
    case 7: return cb >= 1 ? 1 : cs <= 0 ? 0 : 1 - Math.min(1, (1 - cb) / cs);
    case 8: return cs <= 0.5 ? cb * 2 * cs : 1 - (1 - cb) * (1 - (2 * cs - 1));
    case 9: { if (cs <= 0.5) return cb - (1 - 2 * cs) * cb * (1 - cb); let d = cb <= 0.25 ? ((16 * cb - 12) * cb + 4) * cb : Math.sqrt(cb); return cb + (2 * cs - 1) * (d - cb); }
    case 10: return cb > cs ? cb - cs : cs - cb;
    case 11: return cb + cs - 2 * cb * cs;
  }
  return cs;
}
function psLum(r, g, b) { return 0.3 * r + 0.59 * g + 0.11 * b; }
function psClipColor(c) {
  let l = psLum(c[0], c[1], c[2]);
  let n = Math.min(c[0], c[1], c[2]), x = Math.max(c[0], c[1], c[2]);
  if (n < 0) { for (let i = 0; i < 3; i++) c[i] = l + (c[i] - l) * l / (l - n); }
  if (x > 1) { for (let i = 0; i < 3; i++) c[i] = l + (c[i] - l) * (1 - l) / (x - l); }
  return c;
}
function psSetLum(c, l) { let d = l - psLum(c[0], c[1], c[2]); c[0] += d; c[1] += d; c[2] += d; return psClipColor(c); }
function psSat(c) { return Math.max(c[0], c[1], c[2]) - Math.min(c[0], c[1], c[2]); }
function psSetSat(c, s) {
  let max = Math.max(c[0], c[1], c[2]), min = Math.min(c[0], c[1], c[2]);
  let out = [0, 0, 0];
  if (max > min) { for (let i = 0; i < 3; i++) out[i] = (c[i] - min) * s / (max - min); }
  return out;
}
// Non-separable modes: returns [r, g, b] 0..1.
function psBlendNonSeparable(mode, cb, cs) {
  if (mode === 12) return psSetLum(psSetSat(cs, psSat(cb)), psLum(cb[0], cb[1], cb[2]));
  if (mode === 13) return psSetLum(psSetSat(cb, psSat(cs)), psLum(cb[0], cb[1], cb[2]));
  if (mode === 14) return psSetLum([cs[0], cs[1], cs[2]], psLum(cb[0], cb[1], cb[2]));
  return psSetLum([cb[0], cb[1], cb[2]], psLum(cs[0], cs[1], cs[2]));
}

// Composite rows [y0, y1) of columns [x0, x1) from the layer stack into PS_COMP.
function psCompositeRect(x0, y0, x1, y1) {
  let w = PS_W, comp = PS_COMP, comp32 = PS_COMP32;
  // Clear.
  for (let y = y0; y < y1; y++) { let row = y * w; for (let x = x0; x < x1; x++) comp32[row + x] = 0; }
  let cbv = [0, 0, 0], csv = [0, 0, 0];
  for (let li = 0; li < PS_LAYERS.length; li++) {
    let l = PS_LAYERS[li];
    if (!l.visible || l.opacity <= 0) continue;
    let src = l.data, mask = l.mask && l.maskEnabled ? l.mask : null;
    let opacity = l.opacity, mode = PS_BLEND_INDEX[l.blend] || 0;
    for (let y = y0; y < y1; y++) {
      let row = y * w;
      for (let x = x0; x < x1; x++) {
        let p = row + x, i = p * 4;
        let sa = src[i + 3];
        if (sa === 0) continue;
        let a = sa * opacity;
        if (mask) a = a * mask[p] / 255;
        if (a <= 0) continue;
        let da = comp[i + 3];
        let sr = src[i], sg = src[i + 1], sb = src[i + 2];
        if (mode !== 0 && da > 0) {
          let ab = da / 255;
          if (mode < 12) {
            let br = psBlendChannel(mode, comp[i] / 255, sr / 255), bg = psBlendChannel(mode, comp[i + 1] / 255, sg / 255), bb = psBlendChannel(mode, comp[i + 2] / 255, sb / 255);
            sr = (1 - ab) * sr + ab * br * 255; sg = (1 - ab) * sg + ab * bg * 255; sb = (1 - ab) * sb + ab * bb * 255;
          } else {
            cbv[0] = comp[i] / 255; cbv[1] = comp[i + 1] / 255; cbv[2] = comp[i + 2] / 255;
            csv[0] = sr / 255; csv[1] = sg / 255; csv[2] = sb / 255;
            let res = psBlendNonSeparable(mode, cbv, csv);
            sr = (1 - ab) * sr + ab * res[0] * 255; sg = (1 - ab) * sg + ab * res[1] * 255; sb = (1 - ab) * sb + ab * res[2] * 255;
          }
        }
        if (da === 0) { comp[i] = sr; comp[i + 1] = sg; comp[i + 2] = sb; comp[i + 3] = (a + 0.5) | 0; continue; }
        let aS = a / 255, aD = da / 255;
        let oa = aS + aD * (1 - aS);
        let wS = aS / oa, wD = 1 - wS;
        comp[i] = (sr * wS + comp[i] * wD + 0.5) | 0; comp[i + 1] = (sg * wS + comp[i + 1] * wD + 0.5) | 0; comp[i + 2] = (sb * wS + comp[i + 2] * wD + 0.5) | 0;
        comp[i + 3] = (oa * 255 + 0.5) | 0;
      }
    }
  }
}

// Incremental flush: composites part of the dirty rectangle within the budget. Returns true when clean.
function psFlushDirty() {
  if (!PS_DIRTY || !PS_COMP) return true;
  let d = PS_DIRTY;
  let layers = Math.max(1, psVisibleLayerCount());
  let width = d.x1 - d.x0;
  let rows = Math.max(1, Math.floor(PS_COMPOSITE_BUDGET / Math.max(1, width * layers)));
  let y1 = Math.min(d.y1, d.y0 + rows);
  psOverlayUnapply();
  psCompositeRect(d.x0, d.y0, d.x1, y1);
  if (y1 >= d.y1) PS_DIRTY = null; else d.y0 = y1;
  psOverlayApply();
  PS_FRAME++;
  return PS_DIRTY === null;
}

// Frame producer for <PixelCanvas getFrame>.
function frameSource() {
  if (!PS_COMP) return null;
  psFlushDirty();
  if (PS_FRAME === PS_PRESENTED) return null;
  PS_PRESENTED = PS_FRAME;
  return { w: PS_W, h: PS_H, format: "rgba", pixels: PS_COMP.toBase64(), frame: PS_FRAME };
}
// A clean composite without overlays (exports). Composites synchronously in slices via a job.
function psCleanCompositeJob(done, fail) {
  let out = null;
  let stepper = null;
  psEnqueue("Rendering", function () {
    if (!stepper) {
      let layers = Math.max(1, psVisibleLayerCount());
      stepper = psRowStepper(PS_H, Math.max(1, Math.floor(PS_COMPOSITE_BUDGET / Math.max(1, PS_W * layers))), function (y0, y1) {
        psOverlayUnapply();
        psCompositeRect(0, y0, PS_W, y1);
      });
    }
    let r = stepper();
    if (r === true) { PS_DIRTY = null; out = PS_COMP.slice(); psOverlayApply(); PS_FRAME++; return true; }
    return r;
  }, function () { done(out); }, fail);
}

// ---------------------------------------------------------------------------
// Overlays: pixel lists painted over the composite and restored before recompositing.
// ---------------------------------------------------------------------------
function psOverlayUnapply() {
  if (!PS_OVL_APPLIED) return;
  let idx = PS_OVL_IDX, saved = PS_OVL_SAVED, comp32 = PS_COMP32, n = PS_OVL_COUNT;
  for (let k = n - 1; k >= 0; k--) comp32[idx[k]] = saved[k];
  PS_OVL_APPLIED = false; PS_OVL_COUNT = 0;
}
function psOverlayAppend(item, comp32, idx, saved, color, count, w, h) {
  if (!item) return count;
  let n = item.count, ii = item.idx, ic = item.color, cap = PS_OVL_CAP, total = w * h;
  for (let k = 0; k < n && count < cap; k++) {
    let p = ii[k];
    if (p < 0 || p >= total) continue;
    idx[count] = p; saved[count] = comp32[p]; color[count] = ic[k]; count++;
  }
  return count;
}
function psOverlayApply() {
  if (PS_OVL_APPLIED || !PS_COMP) return;
  let comp32 = PS_COMP32, comp = PS_COMP;
  let count = 0;
  count = psOverlayAppend(PS_OVL_SEL, comp32, PS_OVL_IDX, PS_OVL_SAVED, PS_OVL_COLOR, count, PS_W, PS_H);
  count = psOverlayAppend(PS_OVL_GESTURE, comp32, PS_OVL_IDX, PS_OVL_SAVED, PS_OVL_COLOR, count, PS_W, PS_H);
  count = psOverlayAppend(PS_OVL_CLONE, comp32, PS_OVL_IDX, PS_OVL_SAVED, PS_OVL_COLOR, count, PS_W, PS_H);
  let idx = PS_OVL_IDX, color = PS_OVL_COLOR;
  for (let k = 0; k < count; k++) {
    let i = idx[k] * 4, c = color[k];
    // 0 black, 1 white, 2 accent (crop / clone)
    if (c === 0) { comp[i] = 0; comp[i + 1] = 0; comp[i + 2] = 0; }
    else if (c === 1) { comp[i] = 255; comp[i + 1] = 255; comp[i + 2] = 255; }
    else { comp[i] = 255; comp[i + 1] = 120; comp[i + 2] = 60; }
    comp[i + 3] = 255;
  }
  PS_OVL_COUNT = count; PS_OVL_APPLIED = count > 0;
}
function psOverlaySet(which, item) {
  psOverlayUnapply();
  if (which === "gesture") PS_OVL_GESTURE = item; else if (which === "clone") PS_OVL_CLONE = item; else PS_OVL_SEL = item;
  psOverlayApply();
  PS_FRAME++;
}
// Pixel-list builder with dashed ant pattern.
function psPathBuilder(cap) { return { idx: new Int32Array(cap), color: new Uint8Array(cap), count: 0, cap: cap, step: 0 }; }
function psPathPlot(b, x, y, accent) {
  if (b.count >= b.cap) return;
  x = Math.round(x); y = Math.round(y);
  if (x < 0 || y < 0 || x >= PS_W || y >= PS_H) { b.step++; return; }
  b.idx[b.count] = y * PS_W + x;
  b.color[b.count] = accent ? 2 : ((b.step >> 2) & 1);
  b.count++; b.step++;
}
function psPathLine(b, x0, y0, x1, y1, accent) {
  let dx = x1 - x0, dy = y1 - y0;
  let steps = Math.max(1, Math.ceil(Math.max(Math.abs(dx), Math.abs(dy))));
  if (steps > 20000) steps = 20000;
  for (let i = 0; i <= steps; i++) psPathPlot(b, x0 + dx * i / steps, y0 + dy * i / steps, accent);
}
function psPathRect(b, x0, y0, x1, y1, accent) {
  psPathLine(b, x0, y0, x1, y0, accent); psPathLine(b, x1, y0, x1, y1, accent); psPathLine(b, x1, y1, x0, y1, accent); psPathLine(b, x0, y1, x0, y0, accent);
}
function psPathEllipse(b, x0, y0, x1, y1) {
  let cx = (x0 + x1) / 2, cy = (y0 + y1) / 2, rx = Math.abs(x1 - x0) / 2, ry = Math.abs(y1 - y0) / 2;
  let steps = Math.min(8000, Math.max(16, Math.ceil(2 * Math.PI * Math.max(rx, ry))));
  let px = cx + rx, py = cy;
  for (let i = 1; i <= steps; i++) { let t = i / steps * Math.PI * 2; let nx = cx + rx * Math.cos(t), ny = cy + ry * Math.sin(t); psPathLine(b, px, py, nx, ny, false); px = nx; py = ny; }
}
function psPathResult(b) { return b.count ? { idx: b.idx.subarray(0, b.count), color: b.color.subarray(0, b.count), count: b.count } : null; }

// Selection outline (marching ants, static) as a job for large documents.
function psSelectionChanged() {
  if (!PS_SEL) { psOverlaySet("selection", null); psEmit("selection"); return; }
  let w = PS_W, h = PS_H, sel = PS_SEL;
  let b = psPathBuilder(PS_OVL_CAP);
  let stepper = psRowStepper(h, psRowsFor(w, PS_STEP_PIXELS), function (y0, y1) {
    for (let y = y0; y < y1; y++) {
      let row = y * w;
      for (let x = 0; x < w; x++) {
        let p = row + x;
        if (sel[p] <= 127) continue;
        if (x === 0 || y === 0 || x === w - 1 || y === h - 1 || sel[p - 1] <= 127 || sel[p + 1] <= 127 || sel[p - w] <= 127 || sel[p + w] <= 127) {
          if (b.count < b.cap) { b.idx[b.count] = p; b.color[b.count] = ((x + y) >> 2) & 1; b.count++; }
        }
      }
    }
  });
  if (w * h <= PS_STEP_PIXELS) { while (stepper() !== true) {} psOverlaySet("selection", psPathResult(b)); psEmit("selection"); return; }
  psEnqueue("Selection outline", stepper, function () { psOverlaySet("selection", psPathResult(b)); psEmit("selection"); }, function (e) { psReportError(e); });
}

// ---------------------------------------------------------------------------
// Documents and layers
// ---------------------------------------------------------------------------
function psNewDocument(width, height, name, background) {
  psBudget(width, height, 1, 0);
  psCancelJobs();
  PS_W = width; PS_H = height; PS_NAME = String(name || "Untitled").slice(0, 120);
  let data = new Uint8Array(width * height * 4);
  if (background && background !== "transparent") {
    let rgb = psHexToRgb(background);
    let word = (255 << 24 | rgb[2] << 16 | rgb[1] << 8 | rgb[0]) >>> 0;
    new Uint32Array(data.buffer).fill(word);
  }
  PS_LAYERS = [psLayerFactory("Background", data)];
  PS_ACTIVE = PS_LAYERS[0].id; PS_SEL = null; PS_MASKMODE = false; PS_WARNINGS = []; PS_CLONE = null; PS_STROKE = null;
  PS_OVL_GESTURE = null; PS_OVL_CLONE = null; PS_OVL_SEL = null;
  psAllocComposite();
  psInvalidateAll();
  psResetHistory("New document");
  psEmit("document");
}
function psAddLayer(name, data) {
  psBudget(PS_W, PS_H, PS_LAYERS.length + 1, psMaskCount());
  let l = psLayerFactory(name, data || new Uint8Array(PS_W * PS_H * 4));
  let index = psActiveIndex() + 1;
  PS_LAYERS.splice(index, 0, l);
  PS_ACTIVE = l.id; PS_MASKMODE = false;
  return l;
}
function psMaskCount() { let n = 0; for (let i = 0; i < PS_LAYERS.length; i++) if (PS_LAYERS[i].mask) n++; return n; }
