// 3D world: authored grids, first-person movement, scene builders, hotspots,
// confetti, and the dream. Patterns follow MazeEscape3D: axis-separated AABB
// collision over an ASCII grid, camera derived from our own yaw every frame,
// static geometry built once and only dynamic pieces rebuilt per tick.
//
// Look: no engine shadows (the directional shadow frustum is untunable today),
// so depth comes from fog, ceilings, emissive light panels, two-tone walls,
// and a strict colour script per scene.

let CELL = 2
let PLAYER_R = 0.35
let MOVE_SPEED = 0.11
let TURN_SPEED = 0.05

let playerX = 4
let playerZ = 4
let playerAngle = 0
let cameraPos = { x: 4, y: 1.6, z: 4 }
let cameraLookAt = { x: 4, y: 1.6, z: 9 }

let objects = []
let lights = []
let sceneFog = { color: "#10141d", near: 18, far: 60 }
let sceneBg = "#0b0f17"

// The office floor. One string per row; width must be uniform.
let OFFICE_ROWS = [
  "################",
  "#....##....#...#",
  "#.S..........B.#",
  "#....##....#...#",
  "#..............#",
  "###..####..##.##",
  "#..............#",
  "#.C........N...#",
  "#....##....#..D#",
  "#....##....#...#",
  "################"
]

let FLAT_ROWS = [
  "##########",
  "#L......P#",
  "#........#",
  "#..##....#",
  "#..##..T.#",
  "#........#",
  "#S.......#",
  "##########"
]

let BAKERY_ROWS = [
  "#############",
  "#..........D#",
  "#.A......B..#",
  "#...####....#",
  "#...#..#..P.#",
  "#.M.####....#",
  "#...........#",
  "#S..........#",
  "#############"
]

let DREAM_ROWS = [
  "############",
  "#..........#",
  "#.S........#",
  "#....W.....#",
  "#..........#",
  "#.........D#",
  "#..........#",
  "############"
]

let grid = []
let gridCols = 0
let gridRows = 0

function loadGrid(rows) {
  gridCols = rows[0].length
  gridRows = rows.length
  grid = []
  for (let r = 0; r < gridRows; r++) {
    if (rows[r].length !== gridCols) { console.error("[PU] grid row " + r + " width mismatch") }
    for (let c = 0; c < gridCols; c++) {
      grid.push(rows[r].charAt(c) === "#" ? 1 : 0)
    }
  }
}

function gridFind(rows, ch) {
  for (let r = 0; r < rows.length; r++) {
    let c = rows[r].indexOf(ch)
    if (c >= 0) { return { x: c * CELL, z: r * CELL } }
  }
  return { x: CELL, z: CELL }
}

function collides(px, pz) {
  let cc = Math.round(px / CELL)
  let cr = Math.round(pz / CELL)
  for (let r = cr - 1; r <= cr + 1; r++) {
    for (let c = cc - 1; c <= cc + 1; c++) {
      if (r < 0 || c < 0 || r >= gridRows || c >= gridCols) { continue }
      if (grid[r * gridCols + c] !== 1) { continue }
      let minX = c * CELL - CELL / 2, maxX = c * CELL + CELL / 2
      let minZ = r * CELL - CELL / 2, maxZ = r * CELL + CELL / 2
      if (px + PLAYER_R > minX && px - PLAYER_R < maxX && pz + PLAYER_R > minZ && pz - PLAYER_R < maxZ) { return true }
    }
  }
  return false
}

function moveTick() {
  let keys = window.__puKeys || {}
  if (window.__scene3dYaw !== undefined) { playerAngle = window.__scene3dYaw }
  // Facing +z, screen-right is -x (three.js right-handed), so turning right
  // DECREASES yaw and strafing right subtracts the right-hand vector.
  if (keys.left)  { playerAngle = playerAngle + TURN_SPEED; window.__scene3dYaw = playerAngle }
  if (keys.right) { playerAngle = playerAngle - TURN_SPEED; window.__scene3dYaw = playerAngle }
  let fwd = 0
  if (keys.w) { fwd = fwd + 1 }
  if (keys.s) { fwd = fwd - 1 }
  let strafe = 0
  if (keys.d) { strafe = strafe + 1 }
  if (keys.a) { strafe = strafe - 1 }
  if (fwd !== 0 || strafe !== 0) {
    let dx = (Math.sin(playerAngle) * fwd - Math.cos(playerAngle) * strafe) * MOVE_SPEED
    let dz = (Math.cos(playerAngle) * fwd + Math.sin(playerAngle) * strafe) * MOVE_SPEED
    let nx = playerX + dx
    if (!collides(nx, playerZ)) { playerX = nx }
    let nz = playerZ + dz
    if (!collides(playerX, nz)) { playerZ = nz }
  }
  updateCamera()
}

function updateCamera() {
  cameraPos = { x: playerX, y: 1.6, z: playerZ }
  cameraLookAt = {
    x: playerX + Math.sin(playerAngle) * 5,
    y: 1.55,
    z: playerZ + Math.cos(playerAngle) * 5
  }
}

// ---- Hotspots -------------------------------------------------------------

let hotspots = []
let hsNearId = ""
let hsNearLabel = ""

function hotspotTick() {
  let best = ""
  let bestLabel = ""
  let bestD = 999
  for (let i = 0; i < hotspots.length; i++) {
    let h = hotspots[i]
    let dx = playerX - h.x, dz = playerZ - h.z
    let d2 = dx * dx + dz * dz
    if (d2 < h.r * h.r && d2 < bestD) { best = h.id; bestLabel = h.label; bestD = d2 }
  }
  hsNearId = best
  hsNearLabel = bestLabel
}

function onSceneClick(info) {
  if (!info || !info.objectId) { return }
  for (let i = 0; i < hotspots.length; i++) {
    let h = hotspots[i]
    if (h.id !== info.objectId) { continue }
    let dx = playerX - h.x, dz = playerZ - h.z
    if (dx * dx + dz * dz < h.r * h.r * 2.6) { handleHotspot(h.id) }
    return
  }
}

// Traversal-harness teleport: place the player beside a named hotspot.
function warpTo(id) {
  for (let i = 0; i < hotspots.length; i++) {
    if (hotspots[i].id !== id) { continue }
    let h = hotspots[i]
    let offs = [[0, -1.2], [0, 1.2], [-1.2, 0], [1.2, 0]]
    for (let j = 0; j < offs.length; j++) {
      let nx = h.x + offs[j][0], nz = h.z + offs[j][1]
      if (!collides(nx, nz)) { playerX = nx; playerZ = nz; updateCamera(); return }
    }
  }
}

// A slow-turning beacon above every interactive hotspot.
function hotspotMarkers(color) {
  let out = []
  for (let i = 0; i < hotspots.length; i++) {
    let h = hotspots[i]
    out.push({ id: "mk_" + h.id, type: "icosahedron", position: { x: h.x, y: 2.05, z: h.z }, radius: 0.08,
      color: color || "#fbbf24", emissive: color || "#fbbf24", emissiveIntensity: 1.3,
      animate: { rotateY: 0.04, floatAmplitude: 0.06, floatSpeed: 2 } })
  }
  return out
}

// ---- Shared builders ------------------------------------------------------

function hexShade(hex, f) {
  let r = Math.round(parseInt(hex.slice(1, 3), 16) * f)
  let g = Math.round(parseInt(hex.slice(3, 5), 16) * f)
  let b = Math.round(parseInt(hex.slice(5, 7), 16) * f)
  let h = (n) => { let s = n.toString(16); return s.length < 2 ? "0" + s : s }
  return "#" + h(r) + h(g) + h(b)
}

function wallsFrom(rows, color, height) {
  let out = []
  let dark = hexShade(color, 0.86)
  for (let r = 0; r < rows.length; r++) {
    for (let c = 0; c < rows[r].length; c++) {
      if (rows[r].charAt(c) !== "#") { continue }
      out.push({
        id: "w" + r + "_" + c, type: "box",
        position: { x: c * CELL, y: height / 2, z: r * CELL },
        width: CELL, height: height, depth: CELL,
        color: (r + c) % 2 === 0 ? color : dark,
        metalness: 0.05, roughness: 0.9
      })
    }
  }
  return out
}

function floorPlane(w, d, color) {
  return {
    id: "floor", type: "plane",
    position: { x: w / 2, y: 0, z: d / 2 },
    rotation: { x: -Math.PI / 2, y: 0, z: 0 },
    width: w + 4, height: d + 4, color: color, roughness: 1
  }
}

function ceilingPlane(w, d, y, color) {
  return {
    id: "ceiling", type: "plane",
    position: { x: w / 2, y: y, z: d / 2 },
    rotation: { x: Math.PI / 2, y: 0, z: 0 },
    width: w + 4, height: d + 4, color: color, roughness: 1
  }
}

function lightPanel(id, x, z, y, tint) {
  return { id: id, type: "box", position: { x: x, y: y, z: z },
    width: 2.6, height: 0.06, depth: 1.1, color: "#f8fafc",
    emissive: tint, emissiveIntensity: 1.4 }
}

// A little person — low-poly but person-shaped: legs, hips, chest, arms, head,
// hair; optional apron and cap. dir turns the whole figure; the same palette in
// near-black makes a dream silhouette.
function fig(id, x, z, dir, bodyColor, headColor, opts) {
  let o = opts || {}
  let fx = Math.sin(dir), fz = Math.cos(dir)      // facing vector
  let rx = Math.cos(dir), rz = -Math.sin(dir)     // right-hand vector
  let pants = o.pants || hexShade(bodyColor, 0.55)
  let hair = o.hair || hexShade(headColor, 0.45)
  let out = [
    { id: id + "_lgL", type: "box", position: { x: x - rx * 0.12, y: 0.33, z: z - rz * 0.12 }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.16, height: 0.62, depth: 0.2, color: pants },
    { id: id + "_lgR", type: "box", position: { x: x + rx * 0.12, y: 0.33, z: z + rz * 0.12 }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.16, height: 0.62, depth: 0.2, color: pants },
    { id: id + "_hip", type: "box", position: { x: x, y: 0.7, z: z }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.44, height: 0.18, depth: 0.26, color: pants },
    { id: id + "_chest", type: "box", position: { x: x, y: 1.0, z: z }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.48, height: 0.46, depth: 0.28, color: bodyColor },
    { id: id + "_armL", type: "box", position: { x: x - rx * 0.32, y: 0.93, z: z - rz * 0.32 }, rotation: { x: 0, y: dir, z: 0.09 },
      width: 0.12, height: 0.5, depth: 0.16, color: bodyColor },
    { id: id + "_armR", type: "box", position: { x: x + rx * 0.32, y: 0.93, z: z + rz * 0.32 }, rotation: { x: 0, y: dir, z: -0.09 },
      width: 0.12, height: 0.5, depth: 0.16, color: bodyColor },
    { id: id + "_head", type: "sphere", position: { x: x, y: 1.4, z: z }, radius: 0.165, color: headColor },
    { id: id + "_hair", type: "sphere", position: { x: x - fx * 0.05, y: 1.47, z: z - fz * 0.05 }, radius: 0.155, color: hair }
  ]
  if (o.apron) {
    out.push({ id: id + "_apron", type: "box", position: { x: x + fx * 0.16, y: 0.82, z: z + fz * 0.16 }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.4, height: 0.6, depth: 0.04, color: o.apron })
  }
  if (o.cap) {
    out.push({ id: id + "_cap", type: "cylinder", position: { x: x, y: 1.56, z: z }, radius: 0.17, height: 0.07, color: o.cap })
    out.push({ id: id + "_brim", type: "box", position: { x: x + fx * 0.18, y: 1.53, z: z + fz * 0.18 }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.2, height: 0.03, depth: 0.14, color: o.cap })
  }
  return out
}

function chairAt(id, x, z, dir, color) {
  let bx = Math.sin(dir) * -0.22, bz = Math.cos(dir) * -0.22
  return [
    { id: id + "_s", type: "box", position: { x: x, y: 0.48, z: z }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.5, height: 0.09, depth: 0.5, color: color },
    { id: id + "_b", type: "box", position: { x: x + bx, y: 0.82, z: z + bz }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.5, height: 0.62, depth: 0.09, color: color },
    { id: id + "_col", type: "cylinder", position: { x: x, y: 0.26, z: z }, radius: 0.045, height: 0.4, color: "#565f73", metalness: 0.5, roughness: 0.4 },
    { id: id + "_base", type: "cylinder", position: { x: x, y: 0.04, z: z }, radius: 0.27, height: 0.05, color: "#2a303d" }
  ]
}

// An open laptop: base slab plus a hinged screen tilted back.
function laptopAt(id, x, y, z, dir, screenColor) {
  let fx = Math.sin(dir), fz = Math.cos(dir)
  return [
    { id: id + "_b", type: "box", position: { x: x, y: y + 0.015, z: z }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.5, height: 0.03, depth: 0.36, color: "#334155", metalness: 0.4, roughness: 0.5 },
    { id: id + "_s", type: "box", position: { x: x - fx * 0.17, y: y + 0.17, z: z - fz * 0.17 }, rotation: { x: -0.42, y: dir, z: 0 },
      width: 0.5, height: 0.34, depth: 0.02, color: "#0b1220", emissive: screenColor, emissiveIntensity: screenColor === "#0b1220" ? 0 : 0.9 }
  ]
}

// Pastry prefabs: a croissant is three spheres in an arc; cakes and cupcakes stack.
function croissantAt(id, x, y, z, dir) {
  let rx = Math.cos(dir), rz = -Math.sin(dir)
  let fx = Math.sin(dir), fz = Math.cos(dir)
  return [
    { id: id + "_c", type: "sphere", position: { x: x, y: y, z: z }, radius: 0.1, color: "#dd9a55", roughness: 1 },
    { id: id + "_l", type: "sphere", position: { x: x - rx * 0.13 + fx * 0.05, y: y - 0.01, z: z - rz * 0.13 + fz * 0.05 }, radius: 0.075, color: "#d18f4b", roughness: 1 },
    { id: id + "_r", type: "sphere", position: { x: x + rx * 0.13 + fx * 0.05, y: y - 0.01, z: z + rz * 0.13 + fz * 0.05 }, radius: 0.075, color: "#d18f4b", roughness: 1 }
  ]
}

function cakeAt(id, x, y, z) {
  return [
    { id: id + "_b", type: "cylinder", position: { x: x, y: y + 0.08, z: z }, radius: 0.2, height: 0.16, color: "#f6e7d7", roughness: 1 },
    { id: id + "_t", type: "cylinder", position: { x: x, y: y + 0.21, z: z }, radius: 0.14, height: 0.1, color: "#f4a4c0", roughness: 1 },
    { id: id + "_ch", type: "sphere", position: { x: x, y: y + 0.3, z: z }, radius: 0.045, color: "#dc2626" }
  ]
}

function cupcakeAt(id, x, y, z, frost) {
  return [
    { id: id + "_b", type: "cylinder", position: { x: x, y: y + 0.045, z: z }, radius: 0.075, height: 0.09, color: "#8a5a3a", roughness: 1 },
    { id: id + "_f", type: "icosahedron", position: { x: x, y: y + 0.13, z: z }, radius: 0.085, color: frost, roughness: 1 }
  ]
}

function plantAt(id, x, z) {
  return [
    { id: id + "_pot", type: "cylinder", position: { x: x, y: 0.22, z: z }, radius: 0.22, height: 0.44, color: "#8a5a3a" },
    { id: id + "_soil", type: "cylinder", position: { x: x, y: 0.45, z: z }, radius: 0.19, height: 0.03, color: "#3a2c1c" },
    { id: id + "_trunk", type: "cylinder", position: { x: x, y: 0.62, z: z }, radius: 0.04, height: 0.36, color: "#6b4a2e" },
    { id: id + "_top", type: "icosahedron", position: { x: x, y: 0.95, z: z }, radius: 0.34, color: "#3f8f4f", roughness: 1 },
    { id: id + "_top2", type: "icosahedron", position: { x: x + 0.14, y: 1.16, z: z - 0.06 }, radius: 0.22, color: "#4aa35c", roughness: 1 }
  ]
}

// A water cooler: the most recognisable object in any office.
function waterCoolerAt(id, x, z) {
  return [
    { id: id + "_b", type: "box", position: { x: x, y: 0.5, z: z }, width: 0.42, height: 1.0, depth: 0.42, color: "#e5e7eb", roughness: 0.6 },
    { id: id + "_tapC", type: "box", position: { x: x, y: 0.78, z: z + 0.22 }, width: 0.06, height: 0.06, depth: 0.05, color: "#3b82f6", emissive: "#3b82f6", emissiveIntensity: 0.4 },
    { id: id + "_tapH", type: "box", position: { x: x + 0.1, y: 0.78, z: z + 0.22 }, width: 0.06, height: 0.06, depth: 0.05, color: "#ef4444", emissive: "#ef4444", emissiveIntensity: 0.4 },
    { id: id + "_neck", type: "cylinder", position: { x: x, y: 1.04, z: z }, radius: 0.07, height: 0.08, color: "#cbd5e1" },
    { id: id + "_jug", type: "cylinder", position: { x: x, y: 1.3, z: z }, radius: 0.17, height: 0.44, color: "#a5d8ff", opacity: 0.55 }
  ]
}

function deskAt(id, x, z, screen) {
  let out = [
    { id: id, type: "box", position: { x: x, y: 0.72, z: z },
      width: 1.7, height: 0.06, depth: 0.85, color: "#5b6b84", metalness: 0.1, roughness: 0.7 },
    { id: id + "_l1", type: "box", position: { x: x - 0.75, y: 0.36, z: z }, width: 0.08, height: 0.72, depth: 0.7, color: "#3a4356" },
    { id: id + "_l2", type: "box", position: { x: x + 0.75, y: 0.36, z: z }, width: 0.08, height: 0.72, depth: 0.7, color: "#3a4356" }
  ]
  if (screen) {
    out.push({ id: id + "_std", type: "cylinder", position: { x: x, y: 0.82, z: z - 0.22 },
      radius: 0.035, height: 0.16, color: "#3a4356" })
    out.push({ id: id + "_bez", type: "box", position: { x: x, y: 1.08, z: z - 0.235 },
      width: 0.68, height: 0.46, depth: 0.03, color: "#0a0e18" })
    out.push({ id: id + "_scr", type: "box", position: { x: x, y: 1.08, z: z - 0.22 },
      width: 0.6, height: 0.38, depth: 0.03, color: "#0b1220",
      emissive: screen, emissiveIntensity: 1.0 })
    out.push({ id: id + "_kb", type: "box", position: { x: x, y: 0.77, z: z + 0.15 },
      width: 0.5, height: 0.03, depth: 0.2, color: "#232b3b" })
    out.push({ id: id + "_mouse", type: "box", position: { x: x + 0.38, y: 0.77, z: z + 0.15 },
      width: 0.09, height: 0.04, depth: 0.14, color: "#2c3547" })
  } else {
    out.push({ id: id + "_pap", type: "box", position: { x: x + 0.3, y: 0.76, z: z },
      width: 0.3, height: 0.015, depth: 0.4, color: "#d7dce6" })
  }
  return out
}

function posterAt(id, x, z, y, w, h, color, faceZ) {
  return { id: id, type: "box", position: { x: x, y: y, z: z },
    width: w, height: h, depth: 0.04, color: hexShade(color, 0.25),
    emissive: color, emissiveIntensity: 0.55, rotation: { x: 0, y: faceZ ? 0 : Math.PI / 2, z: 0 } }
}

// ---- Office ---------------------------------------------------------------

let officeStatic = []

function buildOffice() {
  loadGrid(OFFICE_ROWS)
  sceneFog = { color: "#1a2233", near: 22, far: 64 }
  sceneBg = "#0d1119"
  let objs = [floorPlane(30, 20, "#2d374d"), ceilingPlane(30, 20, 2.6, "#232b3d")]
  objs = objs.concat(wallsFrom(OFFICE_ROWS, "#48597a", 2.6))
  // Ceiling light panels.
  objs.push(lightPanel("lp1", 8, 6, 2.56, "#dbe6ff"))
  objs.push(lightPanel("lp2", 22, 12, 2.56, "#dbe6ff"))
  objs.push(lightPanel("lp3", 13, 14, 2.56, "#dbe6ff"))
  objs.push(lightPanel("lp4", 24, 4, 2.56, "#dbe6ff"))
  // Desks — half of them conspicuously cleared — with chairs.
  let desks = [
    [8, 4, "#38bdf8", 0.5], [8, 8, "", -0.4], [18, 4, "#38bdf8", 0.2], [18, 8, "", 0.9],
    [4, 8, "", 0], [24, 6, "#38bdf8", -0.6], [24, 12, "", 0.3], [8, 13, "#38bdf8", 1.2]
  ]
  for (let i = 0; i < desks.length; i++) {
    objs = objs.concat(deskAt("desk" + i, desks[i][0], desks[i][1], desks[i][2]))
    objs = objs.concat(chairAt("chair" + i, desks[i][0], desks[i][1] + 1.0, desks[i][3], "#2c3547"))
  }
  // The two colleagues who are still here.
  objs = objs.concat(fig("col1", 18, 3.0, Math.PI, "#4f6180", "#d4b394", { hair: "#6b4b2a" }))
  objs = objs.concat(fig("col2", 9.2, 13.6, -1.1, "#5b5470", "#8a5a3a", { hair: "#22262e" }))
  // Plants, posters, and the taped-off Dynamic Collaboration Space.
  objs = objs.concat(plantAt("plant1", 13, 2))
  objs = objs.concat(plantAt("plant2", 2, 17.8))
  objs.push(posterAt("post1", 6, 1.06, 1.6, 1.6, 1.0, "#38bdf8", true))
  objs.push(posterAt("post2", 17, 1.06, 1.6, 1.6, 1.0, "#f472b6", true))
  objs.push(posterAt("post3", 10, 1.06, 1.55, 1.2, 0.8, "#4ade80", true))
  objs.push(posterAt("post4", 6.5, 11.08, 1.5, 1.5, 0.95, "#fb923c", true))
  objs.push(posterAt("post5", 21, 11.08, 1.5, 1.5, 0.95, "#22d3ee", true))
  objs.push({ id: "clock_f", type: "cylinder", position: { x: 22.5, y: 2.05, z: 1.06 }, rotation: { x: Math.PI / 2, y: 0, z: 0 },
    radius: 0.3, height: 0.05, color: "#e5e7eb" })
  objs.push({ id: "clock_h1", type: "box", position: { x: 22.5, y: 2.13, z: 1.1 }, width: 0.035, height: 0.18, depth: 0.02, color: "#1f2430" })
