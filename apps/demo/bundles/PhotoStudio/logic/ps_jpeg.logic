// Encoder Huffman table: code and length per symbol.
function psJpegEncTable(bits, vals) {
  let code = new Int32Array(256), len = new Uint8Array(256);
  let c = 0, k = 0;
  for (let l = 1; l <= 16; l++) {
    for (let i = 0; i < bits[l - 1]; i++) { code[vals[k]] = c; len[vals[k]] = l; c++; k++; }
    c <<= 1;
  }
  return { code: code, len: len };
}
function psJpegQuant(base, quality) {
  let q = psClamp(Math.round(quality), 1, 100);
  let s = q < 50 ? 5000 / q : 200 - 2 * q;
  let t = new Int32Array(64);
  for (let i = 0; i < 64; i++) { let v = Math.floor((base[i] * s + 50) / 100); t[i] = v < 1 ? 1 : v > 255 ? 255 : v; }
  return t;
}

// Forward DCT (AAN float) on 64 samples in-place (Float64Array), then quantise into out (Int32Array) using divisors.
function psJpegFdctQuant(d, div, out) {
  for (let i = 0; i < 64; i += 8) {
