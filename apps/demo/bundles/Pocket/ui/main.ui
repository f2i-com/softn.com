// main.ui — Pocket
// A grey plastic brick with a green screen in it.

<logic src="../logic/main.logic" />

<style>
/* The DMG palette: warm grey plastic, a bezel that is almost black, and the
   four greens of an unlit reflective LCD. */
.pk-shell {
  --plastic: #c8c4bc;
  --plastic-dark: #a8a49c;
  --plastic-light: #dcd8d0;
  --bezel: #58585a;
  --bezel-dark: #3d3d3f;
  --screen: #8ba82a;
  --ink: #2c2c2e;
  --magenta: #a03a6a;
  --blue: #2f5f9e;
}

/* How big the picture is. The bezel is width:100% of the console at a fixed
   160/144, so this one rule sets the LCD size and nothing else does.

   A real DMG is 90mm across and the first cut honoured that at 420px, which
   looked like the photograph and played like a postage stamp. Bounded on both
   axes instead: 94vw keeps it clear of the edges on a phone, and the vh term is
   what stops a tall console pushing its own D-pad below the fold on a laptop,
   where vertical space runs out long before horizontal. */
.pk-console {
  /* Sized so the LCD lands on a whole multiple of 160x144 rather than just
     short of one. PixelCanvas only ever scales by an integer — 2.53x would put
     some source pixels on two screen pixels and some on three — so the console
     being 10% wider is often a whole step bigger picture, and being 10%
     narrower is the same picture with more bezel.

     The vh term is doing the real work. The console is roughly the LCD's height
     again in bezel, branding and controls, so sizing on width alone pushes the
     D-pad below the fold on a laptop — and a handheld whose buttons you have to
     scroll to is worse than a smaller one.

     72vh is where those two meet on a 1080p laptop: the LCD comes out just over
     640px, which is the fourth whole multiple of 160, and the console still
     ends above the fold. Dropping to 58vh fits more comfortably but lands the
     LCD at 490px — under 3x160, so the picture falls all the way back to 2x and
     two thirds of the bezel is empty. The steps are what matter here, not the
     percentage. */
  max-width: min(94vw, 72vh, 54rem);
}

/* Nearest-neighbour all the way up. The canvas is 160x144 being drawn at ~4x,
   and a browser that smooths it turns a sprite edge into a grey smear. */
.pk-console canvas {
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

/* Every raised surface on the real thing is a highlight on top and a shadow
   underneath, never a blur. */
.pk-raised {
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55),
              inset 0 -2px 3px rgba(0, 0, 0, 0.18),
              0 2px 4px rgba(0, 0, 0, 0.28);
}
.pk-inset {
  box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.45),
              inset 0 -1px 0 rgba(255, 255, 255, 0.28);
}

.pk-face {
  border: none;
  cursor: pointer;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
  transition: transform 60ms linear, box-shadow 60ms linear;
}
.pk-face:active {
  transform: translateY(2px);
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.4);
}

/* Start and Select sit at the DMG's angle. */
.pk-pill {
  transform: rotate(-25deg);
}

.pk-grille {
  background: repeating-linear-gradient(
    115deg,
    #a8a49c 0 3px,
    transparent 3px 9px
  );
}

/* The screen itself never smooths — the canvas is nearest-neighbour and the
   element must not undo that when the browser scales it. */
.pk-lcd canvas {
  image-rendering: pixelated;
  display: block;
}

.pk-led {
  animation: pk-pulse 2.4s ease-in-out infinite;
}
@keyframes pk-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.72; }
}
@media (prefers-reduced-motion: reduce) {
  .pk-led { animation: none; }
}

/* ---------------------------------------------------------------------------
   Narrow screens

   The console and its panel sit side by side, which needs about 54rem + 260px
   + gaps. Below that the panel drops underneath rather than squeezing the
   console — the picture is the thing worth the width. */
@media (max-width: 62rem) {
  .pk-shell {
    flex-direction: column;
    align-items: center;
    padding: 1rem 0.75rem 2rem;
  }
  .pk-side {
    margin-left: 0 !important;
    max-width: min(94vw, 32rem) !important;
  }
  /* No side panel to leave room for, so the console may use the full width. */
  .pk-console {
    max-width: min(94vw, 62vh, 34rem);
  }
}

/* ---------------------------------------------------------------------------
   Landscape on a phone

   Short and wide: vh is scarce and vw is plentiful, which is the opposite of
   every other case. Trimming the shell padding and letting the console take
   most of the height is what keeps the screen a usable size — 62vh of a 360px
   viewport is a 223px console, which is smaller than the real hardware. */
@media (max-height: 30rem) and (orientation: landscape) {
  .pk-shell {
    padding: 0.4rem 0.5rem 0.5rem;
    align-items: center;
  }

  /* Stop being a handheld and become a controller.
     Stacked vertically the screen has to share 390px of height with a D-pad, a
     wordmark and a battery grille, which leaves a picture smaller than the real
     hardware — while two thirds of the width sits empty. Laid out as
     [D-pad | screen | buttons] the screen gets the whole height and the thumbs
     get the space they were going to occupy anyway. */
  /* !important throughout: the console carries display/gap/padding as inline
     style props, and an inline declaration beats a stylesheet rule no matter
     how specific the selector. Without it `display: grid` silently loses to
     `display: flex` and the layout below never happens. */
  .pk-console {
    max-width: none;
    width: 100% !important;
    display: grid !important;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: minmax(0, 1fr) auto;
    grid-template-areas:
      "dpad screen face"
      "dpad startsel face";
    align-items: center;
    justify-items: center;
    gap: 0.25rem 0.75rem !important;
    padding: 0.5rem 0.75rem !important;
    border-radius: 14px !important;
    /* A definite height, or the screen row is sized by its own content and
       `height: 100%` further down has nothing to resolve against — which lands
       the canvas at 1:1. dvh rather than vh so the address bar sliding away
       does not leave the console overflowing behind it.
       The 4.5rem is the runtime's tab strip. dvh measures the whole window but
       the bundle renders below that strip, so subtracting only the shell's own
       padding overflows by exactly the strip's height and pushes Start and
       Select off the bottom. Resolving it properly would need the app's own box
       — but `height: 100%` has no definite parent to resolve against here and
       collapses the shell entirely, which is worse than a constant. */
    height: calc(100dvh - 4.5rem);
  }
  @supports not (height: 100dvh) {
    .pk-console { height: calc(100vh - 4.5rem); }
  }

  /* display:contents so the D-pad and the face cluster become grid items in
     their own right rather than staying trapped in the row that held them.
     !important again — this one is an inline `display: flex` too, and without
     it both controls land in the same cell and shove the screen off-screen. */
  .pk-controls { display: contents !important; }
  .pk-dpad { grid-area: dpad; }
  .pk-face-cluster { grid-area: face; }
  .pk-startsel { grid-area: startsel; padding-top: 0 !important; }

  /* The bezel drives off height now, not width, and the LCD keeps its ratio. */
  .pk-bezel {
    grid-area: screen;
    padding: 0.4rem 0.5rem !important;
    height: 100% !important;
    width: 100%;
    display: flex !important;
    align-items: center;
    justify-content: center;
    border-radius: 8px !important;
    position: relative;
  }
  .pk-lcd {
    width: auto !important;
    height: 100% !important;
    max-width: 100%;
    flex: 0 1 auto;
  }

  /* No room for decoration when the whole console is 390px tall. */
  .pk-wordmark,
  .pk-grille { display: none !important; }
  .pk-bezel > p,
  .pk-bezel > span { display: none; }

  /* The panel is for between-sessions; scrolling to it is fine. */
  .pk-side { margin-top: 0.75rem; }
}

/* ---------------------------------------------------------------------------
   Touch

   Keyed on the pointer, not the width: a small window on a desktop still has a
   mouse, and a large tablet still has thumbs. */
@media (pointer: coarse) {
  /* Kill the double-tap-to-zoom delay, and stop a press on the pad from
     selecting the label or dragging the page with it. A held direction has to
     stay held while the thumb moves a little. */
  .pk-console button,
  .pk-dpad button {
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  /* 38px is comfortable under a cursor and marginal under a thumb; 46px is
     about the smallest that stays reliable while looking at the screen rather
     than the button. */
  .pk-dpad button {
    width: 46px !important;
    height: 46px !important;
  }
  .pk-face {
    width: 56px !important;
    height: 56px !important;
  }
  .pk-pill {
    width: 62px !important;
    height: 20px !important;
  }

  /* The face buttons keep their own :active feedback; the D-pad has none of its
     own, and without it a touch gives no sign it landed. */
  .pk-dpad button:active {
    filter: brightness(1.6);
  }
}

/* ---------------------------------------------------------------------------
   The drawer

   Off everywhere by default: on a desktop the panel sits beside the console and
   a button that opens something already visible is worse than no button. */
/* !important because <Button> and <Box> both carry a display of their own, and
   without it the toggle shows up in portrait next to the panel it would open —
   a button whose only effect is to hide something already on screen. */
.pk-menubtn { display: none !important; }
.pk-scrim { display: none !important; }

/* Short-and-wide is where it is actually needed, because the console takes the
   whole viewport height there. Portrait keeps the panel inline underneath —
   there is room, and a drawer would hide it for no reason. */
@media (max-height: 30rem) and (orientation: landscape) {
  .pk-menubtn {
    display: flex !important;
    position: fixed;
    top: 0.4rem;
    right: 0.4rem;
    z-index: 50;
    width: 40px;
    height: 40px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid #4a4a54;
    border-radius: 10px;
    background: rgba(28, 28, 34, 0.92);
    color: #d8d8dc;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }

  .pk-scrim {
    display: block !important;
    position: fixed;
    inset: 0;
    z-index: 39;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }
  .pk-menu-open .pk-scrim {
    opacity: 1;
    pointer-events: auto;
  }

  .pk-side {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    /* !important, or the panel's own inline width:100% makes this a full-screen
       overlay rather than a drawer — and covering the game to change a setting
       is the thing a drawer exists to avoid. */
    width: min(22rem, 86vw) !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0.75rem 0.75rem 1.5rem;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    background: #17171c;
    border-left: 1px solid #3a3a42;
    /* 101% rather than 100%: a fractional device pixel ratio can otherwise
       leave a hairline of the panel showing down the edge. */
    transform: translateX(101%);
    transition: transform 180ms ease;
  }
  .pk-menu-open .pk-side { transform: none; }
}

@media (prefers-reduced-motion: reduce) {
  .pk-side,
  .pk-scrim { transition: none; }
}

/* Notches and home indicators. */
@supports (padding: env(safe-area-inset-left)) {
  .pk-shell {
    padding-left: max(0.75rem, env(safe-area-inset-left));
    padding-right: max(0.75rem, env(safe-area-inset-right));
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
  }
}
</style>

<App theme="dark">
  <Box className={menuOpen ? "pk-shell pk-menu-open" : "pk-shell"} style={{
    display: "flex",
    justifyContent: "center",
    alignItems: "flex-start",
    minHeight: "100%",
    padding: "1.5rem 1rem 2.5rem",
    background: "radial-gradient(circle at 50% 0%, #3a3a42 0%, #1c1c22 70%)"
  }}>

    // The way into the panel when it is a drawer. Hidden by the stylesheet at
    // any size where the panel is already on screen, so there is never a button
    // that opens something you can see.
    <Button className="pk-menubtn" @click={toggleMenu}>
      {menuOpen ? "✕" : "☰"}
    </Button>

    // Tapping away from an open drawer closes it, which is what every drawer
    // does and what a thumb reaches for first.
    <Box className="pk-scrim" @click={closeMenu} />

    // ---- The console -----------------------------------------------------
    // Sized by .pk-console in the stylesheet above, not inline: the .ui parser
    // reads an inline value like min(a, b, c) as another attribute and drops
    // the rest of the tag.
    <Box className="pk-raised pk-console" style={{
      width: "100%",
      background: "#c8c4bc",
      borderRadius: "12px 12px 48px 12px",
      padding: "1rem 1rem 1.5rem",
      display: "flex",
      flexDirection: "column",
      gap: "0.75rem"
    }}>

      // Bezel and screen
      <Box className="pk-inset pk-bezel" style={{
        background: "#58585a",
        borderRadius: "10px 10px 32px 10px",
        padding: "1.75rem 2.5rem 2.25rem",
        position: "relative"
      }}>
        // Power LED
        <Box style={{
          position: "absolute",
          left: "0.85rem",
          top: "50%",
          transform: "translateY(-50%)",
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          gap: "0.3rem"
        }}>
          <Box className={gbRunning ? "pk-led" : ""} style={{
            width: "9px",
            height: "9px",
            borderRadius: "50%",
            background: gbRomLoaded ? "#e04a4a" : "#5a3a3a",
            boxShadow: gbRomLoaded ? "0 0 7px rgba(224,74,74,0.9)" : "none"
          }} />
          <Text style={{ fontSize: "0.32rem", color: "#9a9a9c", letterSpacing: "0.1em", writingMode: "vertical-rl" }}>POWER</Text>
        </Box>

        // The screen
        <Box className="pk-lcd" style={{
          background: "#8ba82a",
          borderRadius: "2px",
          overflow: "hidden",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          aspectRatio: "160 / 144",
          width: "100%"
        }}>
          // fit="contain" so the picture fills the bezel. The default takes the
          // largest whole multiple that fits, which on a 405px LCD is 2x — a
          // 320px picture with 85px of green around it. The bezel is already
          // 160/144, so containing it lands exactly on the glass.
          <PixelCanvas
            width={160}
            height={144}
            fit="contain"
            getFrame={frameSource}
            running={gbRunning}
            smooth={false}
            @fps={fpsReport}
            style={{ width: "100%", height: "100%" }}
          />
        </Box>

        // The screen legend, as printed on the bezel
        <Text style={{
          position: "absolute",
          bottom: "0.55rem",
          left: 0,
          right: 0,
          textAlign: "center",
          fontSize: "0.5rem",
          color: "#9a9a9c",
          letterSpacing: "0.14em"
        }}>160 × 144 · STEREO SOUND</Text>
      </Box>

      // Wordmark
      <Stack className="pk-wordmark" direction=horizontal gap=xs align=center style={{ justifyContent: "center", paddingTop: "0.15rem" }}>
        <Text style={{
          fontFamily: "Georgia, 'Times New Roman', serif",
          fontStyle: "italic",
          fontWeight: 700,
          fontSize: "1.35rem",
          color: "#2f3a8c",
          letterSpacing: "-0.02em"
        }}>Pocket</Text>
        <Text style={{ fontSize: "0.55rem", color: "#6a6a6c", letterSpacing: "0.1em", paddingTop: "0.45rem" }}>SOFTN</Text>
      </Stack>

      // ---- Controls ------------------------------------------------------
      <Box className="pk-controls" style={{
        display: "flex",
        justifyContent: "space-between",
        alignItems: "center",
        padding: "0.5rem 0.25rem 0"
      }}>
        // D-pad. The only control with a real press/release pair.
        // Wrapped so the stylesheet can grow its buttons for a thumb — the size
        // is an inline prop and a media query has nothing else to hold on to.
        <Box className="pk-dpad">
          <DPad
            @press={dpadPress}
            @release={dpadRelease}
            buttonSize={38}
            color="#3d3d3f"
          />
        </Box>

        // A and B, raised on the diagonal like the original. Pressed for as
        // long as the pointer is down, like the D-pad; a tap still lands as a
        // four-frame press.
        <Box className="pk-face-cluster" style={{ display: "flex", gap: "0.6rem", alignItems: "center", transform: "rotate(-20deg)" }}>
          // data-held is what the keyboard shows through: pressing Z lights the
          // on-screen B, so the player can see the binding is live without
          // waiting for the game to react to it.
          <Stack direction=vertical gap=xs align=center>
            <Button className="pk-face" data-held={btnB} ariaLabel="B" @click={tapB} @pointerdown={holdB} @pointerup={releaseB} @pointercancel={releaseB} @pointerleave={releaseB} style={{
              width: "44px", height: "44px", borderRadius: "50%",
              background: btnB ? "#7d2450" : "#a03a6a",
              transform: btnB ? "translateY(2px)" : "none",
              color: "#f0e8ec", fontWeight: 700, fontSize: "0.9rem"
            }}>B</Button>
            <Text style={{ fontSize: "0.5rem", color: "#2f3a8c", fontWeight: 700 }}>B</Text>
          </Stack>
          <Stack direction=vertical gap=xs align=center style={{ marginTop: "-1.1rem" }}>
            <Button className="pk-face" data-held={btnA} ariaLabel="A" @click={tapA} @pointerdown={holdA} @pointerup={releaseA} @pointercancel={releaseA} @pointerleave={releaseA} style={{
              width: "44px", height: "44px", borderRadius: "50%",
              background: btnA ? "#7d2450" : "#a03a6a",
              transform: btnA ? "translateY(2px)" : "none",
              color: "#f0e8ec", fontWeight: 700, fontSize: "0.9rem"
            }}>A</Button>
            <Text style={{ fontSize: "0.5rem", color: "#2f3a8c", fontWeight: 700 }}>A</Text>
          </Stack>
        </Box>
      </Box>

      // Start and Select
      <Stack className="pk-startsel" direction=horizontal gap=md align=center style={{ justifyContent: "center", paddingTop: "0.6rem" }}>
        <Stack direction=vertical gap=xs align=center>
          <Button className="pk-face pk-pill" ariaLabel="Select" title="Select" @click={tapSelect} @pointerdown={holdSelect} @pointerup={releaseSelect} @pointercancel={releaseSelect} @pointerleave={releaseSelect} style={{
            width: "52px", height: "15px", borderRadius: "999px",
            background: "#7a767e", padding: 0
          }} />
          <Text style={{ fontSize: "0.5rem", color: "#2f3a8c", fontWeight: 700, letterSpacing: "0.08em" }}>SELECT</Text>
        </Stack>
        <Stack direction=vertical gap=xs align=center>
          <Button className="pk-face pk-pill" ariaLabel="Start" title="Start" @click={tapStart} @pointerdown={holdStart} @pointerup={releaseStart} @pointercancel={releaseStart} @pointerleave={releaseStart} style={{
            width: "52px", height: "15px", borderRadius: "999px",
            background: "#7a767e", padding: 0
          }} />
          <Text style={{ fontSize: "0.5rem", color: "#2f3a8c", fontWeight: 700, letterSpacing: "0.08em" }}>START</Text>
        </Stack>
      </Stack>

      // Speaker grille
      <Box className="pk-grille" style={{
        height: "34px",
        marginTop: "0.4rem",
        marginLeft: "auto",
        width: "40%",
        borderRadius: "4px",
        opacity: 0.65
      }} />
    </Box>

    // ---- Side panel ------------------------------------------------------
    <Box className="pk-side" style={{
      width: "100%",
      maxWidth: "260px",
      marginLeft: "1.25rem",
      display: "flex",
      flexDirection: "column",
      gap: "0.75rem",
      color: "#d8d8dc"
    }}>

      // Cartridge slot
      <Box style={{
        background: "#26262c",
        border: "1px solid #3a3a42",
        borderRadius: "8px",
        padding: "0.85rem"
      }}>
        <Text style={{ fontSize: "0.6rem", letterSpacing: "0.14em", color: "#8a8a94" }}>CARTRIDGE</Text>
        <Box style={{ paddingTop: "0.5rem" }}>
          <FileChooser
            accept=".gb,.gbc"
            label={gbRomLoaded ? "Swap cartridge" : "Insert cartridge"}
            @select={chooseRom}
          />
        </Box>

        <Box if={loading} style={{ paddingTop: "0.5rem" }}>
          <Text style={{ fontSize: "0.7rem", color: "#9bbc0f" }}>Reading…</Text>
        </Box>

        // A Stack, not a Box: <Text> renders inline, so stacked directly in a
        // Box the title and the mapper run together as "POKEMON REDMBC3". The
        // separator is built in one expression for the same reason — the
        // whitespace around a bare `·` between two interpolations is not kept.
        <Stack if={gbRomLoaded} direction=vertical gap=xs style={{ paddingTop: "0.6rem" }}>
          <Text style={{ fontSize: "0.85rem", fontWeight: 600, color: "#f0f0f4" }}>{gbTitle}</Text>
          <Text style={{ fontSize: "0.65rem", color: "#8a8a94" }}>{gbMapperName + " · " + romSize}</Text>
          <Text if={gbGbcMode} style={{ fontSize: "0.6rem", color: "#c58fd8", letterSpacing: "0.08em" }}>COLOR</Text>
        </Stack>

        <Text if={hintText} style={{ fontSize: "0.7rem", color: "#7a7a84", paddingTop: "0.5rem", lineHeight: 1.4 }}>{hintText}</Text>
        <Text if={gbError} style={{ fontSize: "0.7rem", color: "#e06a6a", paddingTop: "0.5rem" }}>{gbError}</Text>
      </Box>

      // Transport
      <Stack direction=horizontal gap=sm>
        <Button @click={togglePause} disabled={!gbRomLoaded} variant=ghost style={{ flex: 1, background: gbRomLoaded ? "#9bbc0f" : "#3a3a42", color: gbRomLoaded ? "#0f380f" : "#7a7a84", fontWeight: 700, borderRadius: "8px", padding: "0.5rem 0.75rem" }}>
          {gbRunning || !gbRomLoaded ? "Pause" : "Resume"}
        </Button>
        <Button @click={resetMachine} disabled={!gbRomLoaded} variant=ghost style={{ flex: 1, background: "#2e2e36", color: gbRomLoaded ? "#e8e8ec" : "#7a7a84", border: "1px solid #3a3a42", borderRadius: "8px", padding: "0.5rem 0.75rem" }}>Reset</Button>
      </Stack>

      // Sound. AudioStream pulls on its own schedule rather than on a frame
      // timer, and reports the rate the browser actually gave it — which is
      // what the machine derives its samples-per-frame from, so it has to
      // arrive before the first drain.
      <Box style={{
        background: "#26262c",
        border: "1px solid #3a3a42",
        borderRadius: "8px",
        padding: "0.85rem"
      }}>
        <Stack direction=horizontal gap=sm align=center style={{ justifyContent: "space-between" }}>
          <Text style={{ fontSize: "0.6rem", letterSpacing: "0.14em", color: "#8a8a94" }}>SOUND</Text>
          <Button @click={toggleMute} variant=ghost style={{ fontSize: "0.7rem", padding: "0.2rem 0.5rem" }}>
            {muted ? "Unmute" : "Mute"}
          </Button>
        </Stack>
        <AudioStream
          getSamples={sampleSource}
          sampleRate={48000}
          channels={2}
          format="i16"
          bufferMs={90}
          running={gbRunning}
          muted={muted}
          @ready={audioStarted}
          @error={audioFailed}
        />
        <Text if={audioRate} style={{ fontSize: "0.65rem", color: "#8a8a94", paddingTop: "0.35rem" }}>{audioRate}</Text>
      </Box>

      // ---- Saves ---------------------------------------------------------
      //
      // Three snapshot slots, plus the cartridge's own battery RAM. The battery
      // has no button because it needs none: the game writes it from its own
      // SAVE menu and it is persisted a moment later, which is what happens on
      // hardware. Erase is here because nothing else can undo it.
      <Box if={gbRomLoaded} style={{
        background: "#26262c",
        border: "1px solid #3a3a42",
        borderRadius: "8px",
        padding: "0.85rem"
      }}>
        <Text style={{ fontSize: "0.6rem", letterSpacing: "0.14em", color: "#8a8a94" }}>SAVES</Text>

        <Stack direction=vertical gap=xs style={{ paddingTop: "0.55rem" }}>
          <Stack direction=horizontal gap=sm align=center style={{ justifyContent: "space-between" }}>
            <Text style={{ fontSize: "0.7rem", color: "#c8c8d0" }}>Slot 1</Text>
            <Stack direction=horizontal gap=xs align=center>
              <Text style={{ fontSize: "0.6rem", color: "#7a7a84", minWidth: "5.5rem", textAlign: "right" }}>{slot1}</Text>
              <Button @click={saveSlot1} variant=ghost style={{ fontSize: "0.65rem", padding: "0.15rem 0.45rem" }}>Save</Button>
              <Button @click={loadSlot1} variant=ghost style={{ fontSize: "0.65rem", padding: "0.15rem 0.45rem" }}>Load</Button>
            </Stack>
          </Stack>

          <Stack direction=horizontal gap=sm align=center style={{ justifyContent: "space-between" }}>
            <Text style={{ fontSize: "0.7rem", color: "#c8c8d0" }}>Slot 2</Text>
            <Stack direction=horizontal gap=xs align=center>
              <Text style={{ fontSize: "0.6rem", color: "#7a7a84", minWidth: "5.5rem", textAlign: "right" }}>{slot2}</Text>
              <Button @click={saveSlot2} variant=ghost style={{ fontSize: "0.65rem", padding: "0.15rem 0.45rem" }}>Save</Button>
              <Button @click={loadSlot2} variant=ghost style={{ fontSize: "0.65rem", padding: "0.15rem 0.45rem" }}>Load</Button>
            </Stack>
          </Stack>

          <Stack direction=horizontal gap=sm align=center style={{ justifyContent: "space-between" }}>
            <Text style={{ fontSize: "0.7rem", color: "#c8c8d0" }}>Slot 3</Text>
            <Stack direction=horizontal gap=xs align=center>
              <Text style={{ fontSize: "0.6rem", color: "#7a7a84", minWidth: "5.5rem", textAlign: "right" }}>{slot3}</Text>
              <Button @click={saveSlot3} variant=ghost style={{ fontSize: "0.65rem", padding: "0.15rem 0.45rem" }}>Save</Button>
              <Button @click={loadSlot3} variant=ghost style={{ fontSize: "0.65rem", padding: "0.15rem 0.45rem" }}>Load</Button>
            </Stack>
          </Stack>
        </Stack>

        <Stack direction=horizontal gap=sm align=center style={{ justifyContent: "space-between", paddingTop: "0.6rem" }}>
          <Text style={{ fontSize: "0.6rem", color: eraseArmed ? "#e0a0a0" : "#7a7a84" }}>{eraseArmed ? "Erase the cartridge save for good?" : "Cartridge save is automatic"}</Text>
          <Stack direction=horizontal gap=xs align=center>
            <Button if={eraseArmed} @click={cancelErase} variant=ghost style={{ fontSize: "0.6rem", padding: "0.15rem 0.45rem", color: "#c8c8d0" }}>Keep</Button>
            <Button @click={eraseBattery} variant=ghost style={{ fontSize: "0.6rem", padding: "0.15rem 0.45rem", color: eraseArmed ? "#ffffff" : "#d08a8a", background: eraseArmed ? "#a03a3a" : "transparent", borderRadius: "6px" }}>{eraseArmed ? "Erase" : "Erase…"}</Button>
          </Stack>
        </Stack>

        <Text if={saveStatus} style={{ fontSize: "0.65rem", color: "#9bbc0f", paddingTop: "0.4rem" }}>{saveStatus}</Text>
      </Box>

      // Readouts. Two frame rates, deliberately: gbFps is what the emulator
      // completed and fpsText is what actually reached the screen. A gap
      // between them is the interesting case.
      <Box style={{
        background: "#26262c",
        border: "1px solid #3a3a42",
        borderRadius: "8px",
        padding: "0.85rem",
        display: "flex",
        flexDirection: "column",
        gap: "0.35rem"
      }}>
        <Stack direction=horizontal gap=sm style={{ justifyContent: "space-between" }}>
          <Text style={{ fontSize: "0.7rem", color: "#8a8a94" }}>Painted</Text>
          <Text style={{ fontSize: "0.8rem", fontWeight: 600, color: "#9bbc0f" }}>{fpsText + " fps"}</Text>
        </Stack>
        <Stack direction=horizontal gap=sm style={{ justifyContent: "space-between" }}>
          <Text style={{ fontSize: "0.7rem", color: "#8a8a94" }}>Emulated</Text>
          <Text style={{ fontSize: "0.8rem", fontWeight: 600, color: "#9bbc0f" }}>{gbFps + " fps"}</Text>
        </Stack>
        <Stack direction=horizontal gap=sm style={{ justifyContent: "space-between" }}>
          <Text style={{ fontSize: "0.7rem", color: "#8a8a94" }}>Frames</Text>
          <Text style={{ fontSize: "0.8rem", color: "#d8d8dc" }}>{gbFrameCounter}</Text>
        </Stack>
      </Box>

      <Text style={{ fontSize: "0.62rem", color: "#6a6a74", lineHeight: 1.5 }}>
        Arrow keys or WASD to move · Z and X are A and B · Enter is Start · Shift is Select · on a touch screen, hold the buttons like the real thing
      </Text>
    </Box>
  </Box>
</App>
