          ar += src[si] * wx; ag += src[si + 1] * wx; ab += src[si + 2] * wx; aa += src[si + 3] * wx; wsum += wx;
        }
        if (wsum > 0) { let f = wy / wsum; let o = x * 4; acc[o] += ar * f; acc[o + 1] += ag * f; acc[o + 2] += ab * f; acc[o + 3] += aa * f; }
      }
    }
    let inv = total > 0 ? 1 / total : 0, drow = y * dw;
    for (let x = 0; x < dw; x++) { let o = x * 4, di = (drow + x) * 4; dst[di] = (acc[o] * inv + 0.5) | 0; dst[di + 1] = (acc[o + 1] * inv + 0.5) | 0; dst[di + 2] = (acc[o + 2] * inv + 0.5) | 0; dst[di + 3] = (acc[o + 3] * inv + 0.5) | 0; }
