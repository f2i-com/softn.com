    PS_W = w; PS_H = h; PS_NAME = String(name || "Untitled").replace(/\.psd$/i, "").slice(0, 120);
    PS_LAYERS = layers; PS_ACTIVE = layers[layers.length - 1].id; PS_SEL = null; PS_MASKMODE = false; PS_CLONE = null; PS_STROKE = null;
    PS_WARNINGS = psd.warnings.slice();
    if (clipped) PS_WARNINGS.push("Layer pixels outside the document canvas were clipped on import.");
    PS_OVL_GESTURE = null; PS_OVL_CLONE = null; PS_OVL_SEL = null;
    psAllocComposite(); psInvalidateAll(); psResetHistory("Open PSD"); psEmit("document");
    if (done) done();
  }, fail);
}
function psPsdDocument(composite) {
  return { width: PS_W, height: PS_H, composite: composite, layers: PS_LAYERS.map(function (l) {
    return { name: l.name, data: l.data, visible: l.visible, locked: l.locked, opacity: l.opacity, blend: l.blend, mask: l.mask ? { data: l.mask, disabled: !l.maskEnabled } : null };
  }) };
}
// .sphoto project: JSON with PNG data URLs; layers encoded one after another.
function psProjectJob(done, fail) {
  let layers = PS_LAYERS.slice(), index = 0, out = [];
  let w = PS_W, h = PS_H;
  function next() {
    if (index >= layers.length) {
      let doc = { format: "softn-photo", version: 1, width: w, height: h, name: PS_NAME, layers: out };
      done(JSON.stringify(doc));
      return;
    }
    let l = layers[index++];
    psPngEncodeJob(l.data, w, h, function (png) {
      let entry = { name: l.name, visible: l.visible, locked: l.locked, opacity: l.opacity, blend: l.blend, image: "data:image/png;base64," + png.toBase64(), mask: null, maskEnabled: l.maskEnabled, text: l.text, kind: l.kind };
      if (l.mask) {
        // Masks are stored as white RGBA with the mask in alpha, as the native edition wrote them.
        let mrgba = new Uint8Array(w * h * 4);
        let m = l.mask;
        for (let p = 0; p < w * h; p++) { let i = p * 4; mrgba[i] = 255; mrgba[i + 1] = 255; mrgba[i + 2] = 255; mrgba[i + 3] = m[p]; }
        psPngEncodeJob(mrgba, w, h, function (mpng) { entry.mask = "data:image/png;base64," + mpng.toBase64(); out.push(entry); next(); }, fail);
      } else { out.push(entry); next(); }
    }, fail);
  }
  next();
}
function psOpenProjectJob(name, text, done, fail) {
  let data;
  try { data = JSON.parse(text); } catch (e) { fail(new Error("Not a Photo Studio project file.")); return; }
  if (!data || data.format !== "softn-photo" || data.version !== 1 || !Array.isArray(data.layers) || !data.layers.length) { fail(new Error("Unsupported Photo Studio project format.")); return; }
  let w = data.width, h = data.height;
  try { psBudget(w, h, data.layers.length, 0); } catch (e) { fail(e); return; }
  let layers = [], index = 0;
  function next() {
    if (index >= data.layers.length) {
      PS_W = w; PS_H = h; PS_NAME = String(data.name || "Untitled").slice(0, 120);
      PS_LAYERS = layers; PS_ACTIVE = layers[layers.length - 1].id; PS_SEL = null; PS_MASKMODE = false; PS_WARNINGS = []; PS_CLONE = null; PS_STROKE = null;
      PS_OVL_GESTURE = null; PS_OVL_CLONE = null; PS_OVL_SEL = null;
      psAllocComposite(); psInvalidateAll(); psResetHistory("Open project"); psEmit("document");
      done();
      return;
    }
    let l = data.layers[index++];
    if (!Number.isFinite(l.opacity) || PS_BLEND_INDEX[l.blend] === undefined) { fail(new Error("Invalid layer properties in project.")); return; }
    let imgBytes;
    try { imgBytes = psFromBase64(l.image); } catch (e) { fail(new Error("Invalid project bitmap.")); return; }
    psPngDecodeJob(imgBytes, function (img) {
      if (img.w !== w || img.h !== h) { fail(new Error("Project PNG dimensions do not match the document.")); return; }
      let text = null;
      if (l.text && typeof l.text.text === "string" && l.text.text.length <= 10000 && Number.isFinite(l.text.x) && Number.isFinite(l.text.y) && Number.isFinite(l.text.size) && l.text.size > 0 && l.text.size <= 1000 && psIsHex(l.text.color)) text = Object.assign({}, l.text);
      let layer = psLayerFactory(String(l.name || "Layer").slice(0, 255), img.data, { visible: l.visible !== false, locked: !!l.locked, opacity: psClamp(l.opacity, 0, 1), blend: l.blend, maskEnabled: l.maskEnabled !== false, kind: text ? "text" : "raster", text: text });
      if (l.mask) {
        let mb;
        try { mb = psFromBase64(l.mask); } catch (e) { fail(new Error("Invalid project mask.")); return; }
        psPngDecodeJob(mb, function (mimg) {
          if (mimg.w !== w || mimg.h !== h) { fail(new Error("Project mask dimensions do not match the document.")); return; }
          let mask = new Uint8Array(w * h);
          for (let p = 0; p < w * h; p++) mask[p] = mimg.data[p * 4 + 3];
          layer.mask = mask;
          layers.push(layer); next();
        }, fail);
      } else { layers.push(layer); next(); }
    }, fail);
  }
  next();
}

// Summary for the UI.
function psSummary() {
  let a = psActive();
  return { name: PS_NAME, width: PS_W, height: PS_H, layerCount: PS_LAYERS.length, activeLayer: a ? a.name : "", dirty: psDirty(), canUndo: psCanUndo(), canRedo: psCanRedo() };
}
