// main.ui - Photo Studio (Softn sandbox edition)
// Every raster operation runs inside ZIPP; the template only lays out the
// workspace and hands pointer, keyboard and file events to main.logic.

<logic src="../logic/main.logic" />

<style>
.sp-root { display: flex; flex-direction: column; width: 100%; height: 100%; min-height: 480px; overflow: hidden; background: #181a20; color: #e4e5ee; font-family: "Segoe UI", system-ui, sans-serif; font-size: 12px; user-select: none; }
.sp-topbar { display: flex; align-items: center; gap: 12px; padding: 6px 12px; border-bottom: 1px solid #2c2f3a; background: #1d1f27; flex: none; }
.sp-mark { width: 26px; height: 26px; border-radius: 7px; background: #b2a0ff; color: #241d34; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; }
.sp-brand { font-weight: 600; font-size: 13px; letter-spacing: 0.2px; }
.sp-brand small { display: block; font-weight: 400; font-size: 10px; color: #8a8fa3; }
.sp-title { flex: 1; text-align: center; color: #aeb3c3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sp-runtime { font-size: 9px; letter-spacing: 1.5px; color: #70788d; }
.sp-menubar { display: flex; align-items: center; gap: 2px; padding: 0 8px; border-bottom: 1px solid #2c2f3a; background: #1a1c24; position: relative; z-index: 30; flex: none; height: 28px; }
.sp-menubtn { background: transparent; border: 0; color: #d8dae6; padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: 12px; }
.sp-menubtn:hover, .sp-menubtn.open { background: #2d3040; }
.sp-dropdown { position: absolute; top: 28px; min-width: 260px; background: #23252e; border: 1px solid #3a3d4a; border-radius: 8px; box-shadow: 0 12px 30px rgba(0,0,0,0.45); padding: 6px; z-index: 40; }
.sp-item { display: flex; justify-content: space-between; gap: 18px; width: 100%; background: transparent; border: 0; color: #e4e5ee; padding: 6px 10px; border-radius: 5px; cursor: pointer; text-align: left; font-size: 12px; }
.sp-item:hover { background: #3a3d4f; }
.sp-item kbd { color: #8a8fa3; font-family: inherit; font-size: 11px; }
.sp-sep { height: 1px; background: #3a3d4a; margin: 5px 4px; }
.sp-options { display: flex; align-items: center; gap: 10px; padding: 5px 12px; border-bottom: 1px solid #2c2f3a; background: #1d1f27; flex: none; min-height: 34px; flex-wrap: wrap; }
.sp-optlabel { color: #9aa0b4; font-size: 11px; }
.sp-opt { display: flex; align-items: center; gap: 6px; }
.sp-swatch { width: 22px; height: 22px; border-radius: 5px; border: 1px solid #454858; cursor: pointer; }
.sp-body { display: flex; flex: 1; min-height: 0; }
.sp-tools { width: 78px; display: flex; flex-wrap: wrap; align-content: flex-start; justify-content: center; gap: 4px; padding: 10px 5px; border-right: 1px solid #2c2f3a; background: #1a1c24; overflow-y: auto; flex: none; }
.sp-toolcap { width: 100%; text-align: center; font-size: 8px; letter-spacing: 1px; color: #70788d; margin: 6px 0 2px; }
.sp-tool { width: 31px; height: 31px; border-radius: 7px; border: 1px solid transparent; background: transparent; color: #c9ccdc; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; }
.sp-tool:hover { background: #2d3040; }
.sp-tool.active { background: #3b355e; border-color: #b2a0ff; color: #ffffff; }
.sp-center { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; background: #101116; }
.sp-doctab { display: flex; align-items: center; gap: 8px; padding: 4px 12px; font-size: 11px; color: #aeb3c3; background: #15161c; border-bottom: 1px solid #2c2f3a; flex: none; }
.sp-doctab .dot { width: 7px; height: 7px; border-radius: 50%; background: #b2a0ff; }
.sp-viewwrap { flex: 1; position: relative; min-height: 0; display: flex; }
.sp-rulerx { position: absolute; left: 20px; right: 0; top: 0; height: 20px; background: #1a1c24; border-bottom: 1px solid #2c2f3a; z-index: 5; overflow: hidden; pointer-events: none; }
.sp-rulery { position: absolute; left: 0; top: 20px; bottom: 0; width: 20px; background: #1a1c24; border-right: 1px solid #2c2f3a; z-index: 5; overflow: hidden; pointer-events: none; }
.sp-corner { position: absolute; left: 0; top: 0; width: 20px; height: 20px; background: #1a1c24; z-index: 6; }
.sp-tick { position: absolute; color: #9aa0b2; font-size: 9px; font-family: monospace; }
.sp-tickx { top: 3px; border-left: 1px solid #575e70; padding-left: 3px; height: 17px; }
.sp-ticky { left: 2px; border-top: 1px solid #575e70; padding-top: 1px; width: 18px; }
.sp-viewport { position: absolute; inset: 0; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.sp-viewport.ruled { top: 20px; left: 20px; }
.sp-artboard { flex: none; background-color: #3a3d4a; background-image: linear-gradient(45deg, #2b2e3a 25%, transparent 25%), linear-gradient(-45deg, #2b2e3a 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #2b2e3a 75%), linear-gradient(-45deg, transparent 75%, #2b2e3a 75%); background-size: 16px 16px; background-position: 0 0, 0 8px, 8px -8px, -8px 0; box-shadow: 0 0 0 1px #000, 0 20px 50px rgba(0,0,0,0.6); }
.sp-artboard canvas { display: block; }
.sp-hit { position: absolute; inset: 0; touch-action: none; cursor: crosshair; }
.sp-hit.grab { cursor: grab; }
.sp-hit.text { cursor: text; }
.sp-hit.zoomin { cursor: zoom-in; }
.sp-cursor { position: absolute; border: 1px solid rgba(255,255,255,0.9); box-shadow: 0 0 0 1px rgba(0,0,0,0.6); border-radius: 50%; pointer-events: none; }
.sp-sidebar { width: 268px; border-left: 1px solid #2c2f3a; background: #1a1c24; display: flex; flex-direction: column; min-height: 0; flex: none; overflow-y: auto; }
.sp-panel { padding: 10px 12px; border-bottom: 1px solid #2c2f3a; }
.sp-panel h3 { margin: 0 0 8px; font-size: 10px; letter-spacing: 1.2px; text-transform: uppercase; color: #8a8fa3; display: flex; justify-content: space-between; font-weight: 600; }
.sp-nav { width: 100%; height: 110px; background: #101116; border-radius: 6px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.sp-navctl { display: flex; gap: 6px; align-items: center; margin-top: 8px; }
.sp-btn { background: #2a2d3a; border: 1px solid #3a3d4a; color: #e4e5ee; padding: 4px 9px; border-radius: 6px; cursor: pointer; font-size: 11px; }
.sp-btn:hover { background: #363a4a; }
.sp-btn.primary { background: #b2a0ff; color: #241d34; border-color: #b2a0ff; font-weight: 600; }
.sp-btn.selected { background: #3b355e; border-color: #b2a0ff; }
.sp-btn:disabled { opacity: 0.45; cursor: default; }
.sp-tabs { display: flex; gap: 6px; padding: 8px 12px 0; }
.sp-layerset { display: flex; gap: 8px; align-items: center; padding: 8px 12px; }
.sp-layerlist { display: flex; flex-direction: column; gap: 3px; padding: 6px 8px; }
.sp-layer { display: flex; align-items: center; gap: 8px; padding: 5px 6px; border-radius: 7px; border: 1px solid transparent; cursor: pointer; }
.sp-layer:hover { background: #22242e; }
.sp-layer.active { background: #2a2740; border-color: #5c50a0; }
.sp-thumb { width: 60px; height: 44px; background: #101116; border-radius: 4px; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 2px solid transparent; flex: none; }
.sp-thumb.editing { border-color: #b2a0ff; }
.sp-maskthumb { width: 30px; height: 30px; }
.sp-lname { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }
.sp-lname small { display: block; color: #8a8fa3; font-size: 10px; }
.sp-icnbtn { background: transparent; border: 0; color: #c9ccdc; cursor: pointer; padding: 2px 4px; border-radius: 4px; font-size: 13px; }
.sp-icnbtn:hover { background: #363a4a; }
.sp-layerfoot { display: flex; gap: 4px; padding: 6px 12px 10px; flex-wrap: wrap; }
.sp-hist { padding: 6px 12px; display: flex; flex-direction: column; gap: 2px; }
.sp-histrow { display: flex; gap: 10px; padding: 4px 8px; border-radius: 5px; font-size: 11px; color: #c9ccdc; }
.sp-histrow.current { background: #2a2740; color: #fff; }
.sp-histrow.future { opacity: 0.45; }
.sp-histrow span:first-child { color: #8a8fa3; font-family: monospace; }
.sp-statusbar { display: flex; gap: 18px; align-items: center; padding: 4px 12px; border-top: 1px solid #2c2f3a; background: #1d1f27; font-size: 11px; color: #aeb3c3; flex: none; }
.sp-statusbar .light { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #67e8a6; margin-right: 6px; }
.sp-status { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sp-busy { position: absolute; left: 50%; bottom: 46px; transform: translateX(-50%); background: #23252e; border: 1px solid #3a3d4a; border-radius: 10px; padding: 10px 16px; min-width: 260px; box-shadow: 0 12px 30px rgba(0,0,0,0.5); z-index: 50; }
.sp-bar { height: 5px; background: #2d3040; border-radius: 3px; overflow: hidden; margin-top: 8px; }
.sp-barfill { height: 100%; background: #b2a0ff; transition: width 120ms linear; }
.sp-toast { position: absolute; left: 50%; top: 110px; transform: translateX(-50%); background: #23252e; border: 1px solid #3a3d4a; color: #e4e5ee; border-radius: 10px; padding: 10px 14px; max-width: 520px; box-shadow: 0 12px 30px rgba(0,0,0,0.5); z-index: 60; display: flex; gap: 12px; align-items: center; font-size: 12px; }
.sp-toast.error { border-color: #d66; }
.sp-field { display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px; font-size: 12px; color: #c9ccdc; }
.sp-fields2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 12px; }
.sp-dlgactions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
.sp-help { font-size: 12px; line-height: 1.5; color: #d8dae6; white-space: pre-wrap; }
.sp-helpgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 14px; margin: 8px 0 12px; }
.sp-helpgrid span { font-size: 11px; }
.sp-helpgrid kbd { display: inline-block; min-width: 48px; color: #b2a0ff; font-family: monospace; }
.sp-warn { background: #2f2a1c; border: 1px solid #6b5a1c; color: #f2d98a; border-radius: 8px; padding: 8px 10px; font-size: 11px; white-space: pre-wrap; margin-bottom: 10px; max-height: 180px; overflow: auto; }
.sp-input { background: #101116; border: 1px solid #3a3d4a; color: #e4e5ee; border-radius: 6px; padding: 5px 8px; font-size: 12px; width: 100%; box-sizing: border-box; }
.sp-input.small { width: 64px; }
.sp-select { background: #101116; border: 1px solid #3a3d4a; color: #e4e5ee; border-radius: 6px; padding: 5px 8px; font-size: 12px; }
.sp-check { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #c9ccdc; }
textarea.sp-input { min-height: 80px; resize: vertical; font-family: inherit; }
@media (max-width: 900px) { .sp-sidebar { width: 220px; } }
@media (max-width: 700px) { .sp-tools { width: 44px; } .sp-toolcap { display: none; } .sp-topbar .sp-runtime { display: none; } }
</style>

<App theme="dark">
  <Box className="sp-root">

    <Box className="sp-topbar">
      <div className="sp-mark">P</div>
      <div className="sp-brand">Photo Studio<small>Made for Softn</small></div>
      <div className="sp-title">{docTitle}</div>
      <span className="sp-runtime">LOCAL / NO UPLOADS</span>
      <FileChooser accept=".png,.jpg,.jpeg,.gif,.bmp,.psd,.sphoto,image/png,image/jpeg,image/gif,image/bmp" label="Open" @select={filesChosen} />
      <button className="sp-btn" @click={runAction("psd")}>Save PSD</button>
      <button className="sp-btn primary" @click={runAction("export")}>Export image</button>
    </Box>

    <Box className="sp-menubar">
      #each (name in menuNames)
        <button className={openMenu === name ? "sp-menubtn open" : "sp-menubtn"} @click={toggleMenu(name)} @pointerenter={hoverMenu(name)}>{name}</button>
      #end
      #if (openMenu !== "")
        <div className="sp-dropdown" style={{ left: (menuNames.indexOf(openMenu) * 56 + 8) + "px" }}>
          #each (item in menuItems)
            #if (item.sep)
              <div className="sp-sep"></div>
            #else
              <button className="sp-item" @click={runMenu(item.id)}><span>{item.label}</span><kbd>{item.key}</kbd></button>
            #end
          #end
        </div>
      #end
    </Box>

    <Box className="sp-options">
      <span style={{ fontWeight: "600" }}>{toolName}</span>
      <span className="sp-opt"><span className="sp-optlabel">Foreground</span><ColorPicker :bind={fgColor} size="sm" /></span>
      <span className="sp-opt"><span className="sp-optlabel">Background</span><ColorPicker :bind={bgColor} size="sm" /></span>
      <button className="sp-btn" title="Swap colours (X)" @click={swapColors}>Swap</button>
      #if (showBrushOpts)
        <span className="sp-opt" style={{ minWidth: "200px" }}><span className="sp-optlabel">{"Size " + sizeLabel}</span><Slider value={brushSize} min={1} max={512} step={1} @change={setBrushSize} style={{ width: "130px" }} /></span>
        <span className="sp-opt" style={{ minWidth: "170px" }}><span className="sp-optlabel">Hardness</span><Slider value={brushHardness} min={0} max={100} step={1} @change={setBrushHardness} style={{ width: "100px" }} /></span>
      #end
      <span className="sp-opt"><span className="sp-optlabel">Opacity %</span><input className="sp-input small" type="number" min="1" max="100" :bind={toolOpacity} /></span>
      #if (showFloodOpts)
        <span className="sp-opt"><span className="sp-optlabel">Tolerance</span><input className="sp-input small" type="number" min="0" max="255" :bind={wandTolerance} /></span>
        <label className="sp-check"><input type="checkbox" :bind={wandContiguous} />Contiguous</label>
      #end
      #if (showShapeOpts)
        <label className="sp-check"><input type="checkbox" :bind={shapeFilled} />Fill</label>
        <span className="sp-opt"><span className="sp-optlabel">Stroke</span><input className="sp-input small" type="number" min="1" max="200" :bind={shapeLineWidth} /></span>
      #end
      #if (showGradientOpts)
        <label className="sp-check"><input type="checkbox" :bind={gradientRadial} />Radial</label>
      #end
      #if (cropPending)
        <button className="sp-btn primary" @click={applyCrop}>Apply crop</button>
        <button className="sp-btn" @click={cancelCrop}>Cancel</button>
      #end
      #if (polygonPending)
        <button className="sp-btn primary" @click={closePolygon}>Close selection</button>
      #end
    </Box>

    <Box className="sp-body">
      <Box className="sp-tools">
        #each (t in toolRows)
          #if (t.caption !== "")
            <div className="sp-toolcap">{t.caption}</div>
          #end
          <button className={t.active ? "sp-tool active" : "sp-tool"} title={t.title} @click={setTool(t.id)}><Icon svg={t.svg} size={18} /></button>
        #end
      </Box>

      <Box className="sp-center">
        <div className="sp-doctab"><span className="dot"></span><span>{docDirty ? docName + " *" : docName}</span><span style={{ marginLeft: "auto" }}>RGB / 8</span></div>
        <div className="sp-viewwrap" @pointerdown={closeMenus}>
          #if (rulersOn)
            <div className="sp-corner"></div>
            <div className="sp-rulerx">
              #each (tk in rulerX)
                <span className="sp-tick sp-tickx" style={{ left: tk.left }}>{tk.label}</span>
              #end
            </div>
            <div className="sp-rulery">
              #each (tk in rulerY)
                <span className="sp-tick sp-ticky" style={{ top: tk.top }}>{tk.label}</span>
              #end
            </div>
          #end
          <div className={rulersOn ? "sp-viewport ruled" : "sp-viewport"}>
            <div className="sp-artboard" style={{ width: artWidth, height: artHeight, transform: artTransform }}>
              <PixelCanvas width={docW} height={docH} fit="contain" getFrame={frameSource} smooth={smoothZoom} style={{ width: "100%", height: "100%" }} />
            </div>
            <article className={tool === "hand" || tool === "move" ? "sp-hit grab" : tool === "text" ? "sp-hit text" : tool === "zoom" ? "sp-hit zoomin" : "sp-hit"}
              @pointerdown={onPointerDown} @pointermove={onPointerMove} @pointerup={onPointerUp} @pointerleave={onPointerLeave} @pointercancel={onPointerCancel} @dblclick={onDoubleClick}></article>
            #if (cursorVisible)
              <div className="sp-cursor" style={{ left: cursorLeft, top: cursorTop, width: cursorDiameter, height: cursorDiameter }}></div>
            #end
          </div>
        </div>
      </Box>

      #if (sidebarOpen)
      <Box className="sp-sidebar">
        <div className="sp-panel">
          <h3>Navigator<span>Overview</span></h3>
          <div className="sp-nav">
            #if (navFrame)
              <PixelCanvas width={navFrame.w} height={navFrame.h} frame={navFrame} fit="contain" smooth={true} style={{ width: "100%", height: "100%" }} />
            #end
          </div>
          <div className="sp-navctl">
            <button className="sp-btn" @click={zoomOut}>-</button>
            <span style={{ minWidth: "44px", textAlign: "center" }}>{zoomText}</span>
            <button className="sp-btn" @click={zoomIn}>+</button>
            <button className="sp-btn" @click={zoomFit}>Fit</button>
            <button className="sp-btn" @click={zoomActual}>1:1</button>
          </div>
        </div>
        <div className="sp-tabs">
          <button className={sidebarTab === "layers" ? "sp-btn selected" : "sp-btn"} @click={showTab("layers")}>Layers</button>
          <button className={sidebarTab === "history" ? "sp-btn selected" : "sp-btn"} @click={showTab("history")}>History</button>
        </div>
        #if (sidebarTab === "layers")
          <div className="sp-layerset">
            <Select options={blendOptions} value={activeBlend} size="sm" @change={setLayerBlend} style={{ flex: "1" }} />
            <span className="sp-optlabel">Opacity</span>
            <input className="sp-input small" type="number" min="0" max="100" value={activeOpacity} @change={setLayerOpacity} />
          </div>
          <div className="sp-layerlist">
            #each (row in layerRows)
              <div className={row.active ? "sp-layer active" : "sp-layer"} @click={selectLayer(row.id)} @dblclick={renameLayer(row.id)}>
                <button className="sp-icnbtn" title={row.eye} @click={toggleLayerVisible(row.id)}>{row.visible ? "◉" : "○"}</button>
                <div className={row.imageActive ? "sp-thumb editing" : "sp-thumb"}>
                  <PixelCanvas width={row.thumb.w} height={row.thumb.h} frame={row.thumb} fit="contain" smooth={true} style={{ width: "56px", height: "40px" }} />
                </div>
                #if (row.hasMask)
                  <div className={row.maskActive ? "sp-thumb sp-maskthumb editing" : "sp-thumb sp-maskthumb"} title="Edit mask" @click={editLayerMask(row.id)}>
                    <PixelCanvas width={row.maskThumb.w} height={row.maskThumb.h} frame={row.maskThumb} fit="contain" smooth={true} style={{ width: "26px", height: "26px" }} />
                  </div>
                #end
                <div className="sp-lname">{row.name}<small>{row.typeLabel}{row.maskLabel !== "" ? " / " + row.maskLabel : ""}</small></div>
                <button className="sp-icnbtn" title="Lock" @click={toggleLayerLock(row.id)}>{row.lockGlyph}</button>
              </div>
            #end
          </div>
          <div className="sp-layerfoot">
            <button className="sp-btn" title="New layer" @click={layerButton("New layer")}>+</button>
            <button className="sp-btn" title="Add mask from selection" @click={layerButton("Add mask")}>Mask</button>
            <button className="sp-btn" title="Raise layer" @click={layerButton("Raise layer")}>Up</button>
            <button className="sp-btn" title="Lower layer" @click={layerButton("Lower layer")}>Down</button>
            <button className="sp-btn" title="Duplicate layer" @click={layerButton("Duplicate layer")}>Dup</button>
            <button className="sp-btn" title="Delete layer" @click={layerButton("Delete layer")}>Del</button>
          </div>
        #else
          <div className="sp-hist">
            #each (hrow in historyRows)
              <div className={hrow.current ? "sp-histrow current" : hrow.future ? "sp-histrow future" : "sp-histrow"}><span>{hrow.number}</span><span>{hrow.label}</span></div>
            #end
            <div style={{ padding: "8px", color: "#8a8fa3", fontSize: "11px" }}>Ctrl+Z undoes, Ctrl+Y redoes.</div>
          </div>
        #end
      </Box>
      #end
    </Box>

    <Box className="sp-statusbar">
      <span className="sp-status"><span className="light"></span>{statusText}</span>
      <span>{coordText}</span>
      <span>{zoomText}</span>
      <span>{layersText}</span>
    </Box>

    #if (jobActive)
      <div className="sp-busy">
        <div>{jobLabel + "... " + jobPercent + "%"}</div>
        <div className="sp-bar"><div className="sp-barfill" style={{ width: jobPercent + "%" }}></div></div>
      </div>
    #end

    #if (noticeText !== "")
      <div className={noticeError ? "sp-toast error" : "sp-toast"}><span>{noticeText}</span><button className="sp-icnbtn" @click={dismissNotice}>x</button></div>
    #end

    <Loop interval={0} running={jobActive} @tick={pumpJobs} />

    <Modal open={dialog === "new"} onClose={closeDialog} title="New canvas" size="sm">
      <div className="sp-field"><span>Document name</span><input className="sp-input" type="text" :bind={dlgName} /></div>
      <div className="sp-fields2">
        <div className="sp-field"><span>Width (px)</span><input className="sp-input" type="number" min="1" max="4096" :bind={dlgWidth} /></div>
        <div className="sp-field"><span>Height (px)</span><input className="sp-input" type="number" min="1" max="4096" :bind={dlgHeight} /></div>
      </div>
      <div className="sp-field"><span>Background</span><Select options={backgroundOptions} :bind={dlgBackground} size="sm" /></div>
      <div style={{ color: "#8a8fa3", fontSize: "11px" }}>Up to 4096 px per side and 3 megapixels in this edition.</div>
      <div className="sp-dlgactions"><button className="sp-btn" @click={closeDialog}>Cancel</button><button className="sp-btn primary" @click={applyDialog}>Create</button></div>
    </Modal>

    <Modal open={dialog === "resize"} onClose={closeDialog} title="Image size" size="sm">
      <div style={{ color: "#aeb3c3", marginBottom: "10px" }}>Resamples every layer and mask. Text becomes raster pixels. Undo restores the original.</div>
      <div className="sp-fields2">
        <div className="sp-field"><span>Width (px)</span><input className="sp-input" type="number" min="1" max="4096" :bind={dlgWidth} /></div>
        <div className="sp-field"><span>Height (px)</span><input className="sp-input" type="number" min="1" max="4096" :bind={dlgHeight} /></div>
      </div>
      <label className="sp-check"><input type="checkbox" :bind={dlgLock} />Preserve aspect ratio (width controls height)</label>
      <label className="sp-check" style={{ marginTop: "6px" }}><input type="checkbox" :bind={dlgNearest} />Nearest neighbour (pixel art)</label>
      <div className="sp-dlgactions"><button className="sp-btn" @click={closeDialog}>Cancel</button><button className="sp-btn primary" @click={applyDialog}>Resize</button></div>
    </Modal>

    <Modal open={dialog === "canvas"} onClose={closeDialog} title="Canvas size" size="sm">
      <div style={{ color: "#aeb3c3", marginBottom: "10px" }}>Changes the canvas boundary without resampling. Cropped pixels can be restored with Undo.</div>
      <div className="sp-fields2">
        <div className="sp-field"><span>Width (px)</span><input className="sp-input" type="number" min="1" max="4096" :bind={dlgWidth} /></div>
        <div className="sp-field"><span>Height (px)</span><input className="sp-input" type="number" min="1" max="4096" :bind={dlgHeight} /></div>
      </div>
      <div className="sp-field"><span>Anchor</span><Select options={anchorOptions} :bind={dlgAnchor} size="sm" /></div>
      <div className="sp-dlgactions"><button className="sp-btn" @click={closeDialog}>Cancel</button><button className="sp-btn primary" @click={applyDialog}>Apply</button></div>
    </Modal>

    <Modal open={dialog === "transform"} onClose={closeDialog} title="Transform layer" size="sm">
      <div style={{ color: "#aeb3c3", marginBottom: "10px" }}>Transforms the whole active layer around its visible bounds. Pixels outside the canvas are clipped. Text is rasterised; Undo restores it.</div>
      <div className="sp-fields2">
        <div className="sp-field"><span>Horizontal offset (px)</span><input className="sp-input" type="number" :bind={dlgDx} /></div>
        <div className="sp-field"><span>Vertical offset (px)</span><input className="sp-input" type="number" :bind={dlgDy} /></div>
        <div className="sp-field"><span>Rotation (degrees)</span><input className="sp-input" type="number" step="0.1" :bind={dlgAngle} /></div>
        <div className="sp-field"><span>Width scale (%)</span><input className="sp-input" type="number" :bind={dlgScaleX} /></div>
        <div className="sp-field"><span>Height scale (%)</span><input className="sp-input" type="number" :bind={dlgScaleY} /></div>
      </div>
      <div className="sp-dlgactions"><button className="sp-btn" @click={closeDialog}>Cancel</button><button className="sp-btn primary" @click={applyDialog}>Apply</button></div>
    </Modal>

    <Modal open={dialog === "filter"} onClose={closeDialog} title={dialogTitle} size="sm">
      <div style={{ color: "#aeb3c3", marginBottom: "10px" }}>{dialogMessage}</div>
      <div className="sp-field"><span>{"Amount: " + dlgAmount}</span><Slider value={dlgAmount} min={dlgMin} max={dlgMax} step={dlgStep} @change={setDialogAmount} /></div>
      <div className="sp-dlgactions"><button className="sp-btn" @click={closeDialog}>Cancel</button><button className="sp-btn primary" @click={applyDialog}>Apply</button></div>
    </Modal>

    <Modal open={dialog === "feather"} onClose={closeDialog} title="Feather selection" size="sm">
      <div style={{ color: "#aeb3c3", marginBottom: "10px" }}>Softens selection edges without changing the image.</div>
      <div className="sp-field"><span>Radius (px)</span><input className="sp-input" type="number" min="0" max="50" :bind={dlgRadius} /></div>
      <div className="sp-dlgactions"><button className="sp-btn" @click={closeDialog}>Cancel</button><button className="sp-btn primary" @click={applyDialog}>Apply</button></div>
    </Modal>

    <Modal open={dialog === "rename"} onClose={closeDialog} title="Rename layer" size="sm">
      <div className="sp-field"><span>Layer name</span><input className="sp-input" type="text" :bind={dlgLayerName} /></div>
      <div className="sp-dlgactions"><button className="sp-btn" @click={closeDialog}>Cancel</button><button className="sp-btn primary" @click={applyDialog}>Rename</button></div>
    </Modal>

    <Modal open={dialog === "text"} onClose={closeDialog} title={dialogTitle} size="md">
      <div style={{ color: "#aeb3c3", marginBottom: "10px" }}>Text stays editable in .sphoto projects. PSD export uses its rendered pixels. Type is drawn from bundled DejaVu faces.</div>
      <div className="sp-field"><span>Text</span><textarea className="sp-input" :bind={dlgText}></textarea></div>
      <div className="sp-fields2">
        <div className="sp-field"><span>Font</span><Select options={fontOptions} :bind={dlgFont} size="sm" /></div>
        <div className="sp-field"><span>Size (px)</span><input className="sp-input" type="number" min="1" max="1000" :bind={dlgSize} /></div>
      </div>
      <label className="sp-check"><input type="checkbox" :bind={dlgBold} />Bold</label>
      <div className="sp-field" style={{ marginTop: "8px" }}><span>Colour</span><ColorPicker :bind={dlgColor} size="sm" /></div>
      <div className="sp-dlgactions"><button className="sp-btn" @click={closeDialog}>Cancel</button><button className="sp-btn primary" @click={applyDialog}>Apply</button></div>
    </Modal>

    <Modal open={dialog === "export"} onClose={closeDialog} title="Export image" size="sm">
      <div style={{ color: "#aeb3c3", marginBottom: "10px" }}>Flattens visible layers into a new image. Your document and layers remain editable here.</div>
      <div className="sp-field"><span>Format</span><Select options={formatOptions} :bind={dlgFormat} size="sm" /></div>
      <div className="sp-field"><span>{"JPEG quality: " + dlgQuality}</span><Slider value={dlgQuality} min={10} max={100} step={1} :bind={dlgQuality} /></div>
      <div className="sp-field"><span>JPEG background (fills transparency)</span><ColorPicker :bind={dlgJpegBg} size="sm" /></div>
      <div className="sp-dlgactions"><button className="sp-btn" @click={closeDialog}>Cancel</button><button className="sp-btn primary" @click={applyDialog}>Download</button></div>
    </Modal>

    <Modal open={dialog === "psd"} onClose={closeDialog} title="Save layered PSD" size="sm">
      <div style={{ color: "#aeb3c3", marginBottom: "10px" }}>Exports raster layers, names, visibility, opacity, supported blend modes and masks. Native text is rasterised. Unsupported Photoshop metadata is not preserved. A new file is downloaded; the original is unchanged.</div>
      #if (warningsText !== "")
        <div className="sp-warn">{warningsText}</div>
      #end
      <div className="sp-dlgactions"><button className="sp-btn" @click={closeDialog}>Cancel</button><button className="sp-btn primary" @click={applyDialog}>Download PSD</button></div>
    </Modal>

    <Modal open={dialog === "discard"} onClose={closeDialog} title="Discard unsaved changes?" size="sm">
      <div style={{ color: "#aeb3c3", marginBottom: "10px" }}>Exporting a PNG does not save your layers. Save a PSD or .sphoto project before replacing this document.</div>
      <div className="sp-dlgactions"><button className="sp-btn" @click={closeDialog}>Keep editing</button><button className="sp-btn primary" @click={confirmDiscard}>Discard changes</button></div>
    </Modal>

    <Modal open={dialog === "psdChoice"} onClose={closeDialog} title="PSD compatibility notice" size="md">
      <div style={{ color: "#aeb3c3", marginBottom: "10px" }}>This is not a lossless Photoshop round-trip. Opening raster layers may change the appearance; the merged preview retains the saved composite but has no editable source layers. The original file is never overwritten.</div>
      <div className="sp-warn">{dialogWarnings.join("\n\n")}</div>
      <div className="sp-dlgactions">
        <button className="sp-btn" @click={psdChoice("cancel")}>Cancel</button>
        #if (psdHasComposite)
          <button className="sp-btn" @click={psdChoice("flatten")}>Merged preview only</button>
        #end
        <button className="sp-btn primary" @click={psdChoice("layers")}>Open raster layers</button>
      </div>
    </Modal>

    <Modal open={dialog === "help"} onClose={closeDialog} title="Tools and shortcuts" size="md">
      <div className="sp-help">Keyboard shortcuts. On macOS, use Command instead of Ctrl.</div>
      <div className="sp-helpgrid">
        #each (hr in helpRows)
          <span><kbd>{hr.key}</kbd>{hr.label}</span>
        #end
      </div>
      <div className="sp-help">Editing: Ctrl+Z undo, Ctrl+Y or Ctrl+Shift+Z redo, Ctrl+A select all, Esc deselect, Ctrl+Shift+I invert, Delete clear.
Gestures: Space + drag or the Hand tool pans. Alt + wheel zooms at the cursor. Shift constrains shapes and lines. Shift adds to selections, Alt subtracts. Alt-click sets the clone source. Brush + Alt picks a colour.
Crop: drag, then Enter or Apply crop. Polygon lasso: click points, double-click or Enter to close.
[ and ] change brush size, X swaps colours, D resets to black and white.
Layers and masks: double-click a layer name to rename. Click a mask thumbnail to paint the mask: white reveals, black hides. Image adjustments are destructive and undoable. Save .sphoto to keep editable type.</div>
      <div className="sp-dlgactions"><button className="sp-btn primary" @click={closeDialog}>Close</button></div>
    </Modal>

    <Modal open={dialog === "compat"} onClose={closeDialog} title="Compatibility and limits" size="md">
      <div className="sp-help">This sandbox edition runs every pixel inside Softn's scripting engine. Opens PNG, JPEG (baseline and progressive), GIF (first frame), BMP, 8-bit RGB PSD and .sphoto projects. Saves PNG, JPEG, layered PSD and .sphoto. WebP and AVIF need the native edition.

Limits: 4096 px per side; 3 megapixels per document (larger photos are downscaled on import); 32 layers; 160 MiB of live layer surfaces; 64 MiB of undo surfaces; 48 MiB input files. Long operations run in slices with a progress bar.

PSD: reads Raw, RLE and ZIP data, writes RLE. No CMYK, Lab, 16 or 32-bit, PSB, ICC colour management, smart object editing, adjustment layers, editable Photoshop type, vector paths, effects, groups or clipping. PSD export writes a new raster document, not a lossless copy. Keep your original PSD.</div>
      <div className="sp-help" style={{ marginTop: "10px", fontWeight: "600" }}>This document</div>
      <div className="sp-help">{compatText}</div>
      <div className="sp-dlgactions"><button className="sp-btn primary" @click={closeDialog}>Close</button></div>
    </Modal>

    <Modal open={dialog === "about"} onClose={closeDialog} title="Softn Photo Studio 0.2" size="sm">
      <div className="sp-help">A local-first, layered image editor written entirely in .logic: decoders, encoders, compositing, brushes and type all run inside the Softn sandbox, so this bundle works on any unchanged Softn runtime. No network calls, uploads or telemetry.

Independent software, not affiliated with Adobe. Type is drawn from the DejaVu fonts (Bitstream Vera licence).</div>
      <div className="sp-dlgactions"><button className="sp-btn primary" @click={closeDialog}>Keep creating</button></div>
    </Modal>

  </Box>
</App>
