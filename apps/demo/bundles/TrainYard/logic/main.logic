// Track Spline Geometry with Arc-Length Parameterization
function rawTrackPoint(t) {
  let normT = ((t % 1) + 1) % 1;
  let rad = normT * Math.PI * 2;
  let cosT = Math.cos(rad);
  let sinT = Math.sin(rad);
  let signX = cosT >= 0 ? 1 : -1;
  let signZ = sinT >= 0 ? 1 : -1;
  // Superellipse creates a realistic layout loop with gentle curved corners
  let powX = Math.pow(Math.abs(cosT), 0.65) * signX;
  let powZ = Math.pow(Math.abs(sinT), 0.65) * signZ;
  let x = powX * 11.2;
  let z = powZ * 5.8;
  let y = 0.68;
  // Scenic elevation: gentle climb over scenic viaduct in rear right
  if (x > 1.5 && z < -1.5) {
    let grade = Math.sin(((x - 1.5) / 9.5) * Math.PI);
    y = 0.68 + Math.max(0, grade) * 0.52;
  }
  return { x: x, y: y, z: z };
}

// Precompute cumulative arc length for perfectly uniform motion and car spacing
let TRACK_SAMPLES = 360;
let trackCumDist = [0];
let trackRawPts = [rawTrackPoint(0)];
for (let i = 1; i <= TRACK_SAMPLES; i = i + 1) {
  let p = rawTrackPoint(i / TRACK_SAMPLES);
  trackRawPts.push(p);
  let prev = trackRawPts[i - 1];
  let d = Math.hypot(p.x - prev.x, p.z - prev.z);
  trackCumDist.push(trackCumDist[i - 1] + d);
}
let totalTrackLength = trackCumDist[TRACK_SAMPLES];

function getTrackPoint(u) {
  let normU = ((u % 1) + 1) % 1;
  let targetDist = normU * totalTrackLength;
  let low = 0;
  let high = TRACK_SAMPLES;
  while (low <= high) {
    let mid = Math.floor((low + high) / 2);
    if (trackCumDist[mid] < targetDist) {
      low = mid + 1;
    } else {
      high = mid - 1;
    }
  }
  let idx = Math.max(1, Math.min(TRACK_SAMPLES, low));
  let d0 = trackCumDist[idx - 1];
  let d1 = trackCumDist[idx];
  let alpha = (targetDist - d0) / (d1 - d0 || 1);
  let p0 = trackRawPts[idx - 1];
  let p1 = trackRawPts[idx];
  return {
    x: p0.x + (p1.x - p0.x) * alpha,
    y: p0.y + (p1.y - p0.y) * alpha,
    z: p0.z + (p1.z - p0.z) * alpha
  };
}

function getTrackHeading(u) {
  let delta = 0.003;
  let p1 = getTrackPoint(u - delta);
  let p2 = getTrackPoint(u + delta);
  let dx = p2.x - p1.x;
  let dz = p2.z - p1.z;
  return Math.atan2(dx, dz);
}

// Town Road Circuit (Two distinct lanes with smooth turnaround loops, zero head-on collisions)
function getRoadPoint(t) {
  let normT = ((t % 1) + 1) % 1;
  let r = 0.27;
  let zMid = 8.05;
  let xSpan = 4.5;
  let x = 0;
  let z = zMid;
  let rot = 0;

  if (normT < 0.40) {
    // South lane: traveling East (+x)
    let u = normT / 0.40;
    x = -xSpan + u * (2 * xSpan);
    z = zMid + r;
    rot = Math.PI / 2;
  } else if (normT < 0.50) {
    // East turnaround loop (smooth 180° curve)
    let u = (normT - 0.40) / 0.10;
    let angle = -Math.PI / 2 + u * Math.PI;
    x = xSpan + Math.cos(angle) * r;
    z = zMid - Math.sin(angle) * r;
    rot = Math.PI / 2 - u * Math.PI;
  } else if (normT < 0.90) {
    // North lane: traveling West (-x)
    let u = (normT - 0.50) / 0.40;
    x = xSpan - u * (2 * xSpan);
    z = zMid - r;
    rot = -Math.PI / 2;
  } else {
    // West turnaround loop (smooth 180° curve)
    let u = (normT - 0.90) / 0.10;
    let angle = Math.PI / 2 + u * Math.PI;
    x = -xSpan + Math.cos(angle) * r;
    z = zMid - Math.sin(angle) * r;
    rot = -Math.PI / 2 - u * Math.PI;
  }

  return { x: x, y: 0.58, z: z, rot: rot };
}

// Particle smoke storage
let smokePositions = [];
let smokePuffs = [];
for (let i = 0; i < 32; i = i + 1) {
  smokePuffs.push({
    x: 0,
    y: -100,
    z: 0,
    life: 0,
    maxLife: 26 + Math.random() * 22,
    vx: (Math.random() - 0.5) * 0.012,
    vy: 0.045 + Math.random() * 0.03,
    vz: (Math.random() - 0.5) * 0.012
  });
}

function updateSmoke(chimneyX, chimneyY, chimneyZ, speed) {
  smokePositions = [];
  for (let i = 0; i < smokePuffs.length; i = i + 1) {
    let p = smokePuffs[i];
    p.life = p.life + 1;
    if (p.life >= p.maxLife) {
      if (Math.abs(speed) > 0.04 || whistleActive) {
        p.life = 0;
        p.x = chimneyX;
        p.y = chimneyY;
        p.z = chimneyZ;
        let spread = whistleActive ? 0.045 : 0.018;
        p.vx = (Math.random() - 0.5) * spread;
        p.vy = (whistleActive ? 0.10 : 0.05) + Math.random() * 0.035;
        p.vz = (Math.random() - 0.5) * spread;
      } else {
        p.y = -100;
      }
    } else {
      p.x = p.x + p.vx;
      p.y = p.y + p.vy;
      p.z = p.z + p.vz;
      p.vy = p.vy * 0.975;
    }
    smokePositions.push(p.x, p.y, p.z);
  }
}

