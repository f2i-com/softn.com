Options -Indexes -MultiViews
DirectoryIndex index.html
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
# FilesMatch sees a file's own name and no folder of its path: it refuses .env
# and not .git/config. /.well-known/ stays, for a certificate's challenge. The
# second line is what a copied backend or a backup leaves here; runtime.config.json
# is another name, and stays. Neither looks at /api/: these run ahead of the
# rewrite below, and an address there is the app's own route, whatever it ends in.
<IfModule mod_alias.c>
    RedirectMatch 404 "^(?!.*/api/).*/\.(?!well-known(?:/|$))"
    RedirectMatch 404 "^(?!.*/api/).*(?:/config\.json|\.(?:bak|old|orig|save|sql|sqlite3?(?:-wal|-shm)?|db|tar|tar\.gz|tgz|zip))$"
</IfModule>
AddType application/wasm .wasm
AddType text/javascript .mjs
# The optional backend: /api/... is answered by api.php once backend/ is set
# up, and the Authorization header reaches PHP under CGI and FastCGI. Inside
# IfModule: without mod_rewrite the backend has no routes (/api/meta is
# Apache's own 404), but the application itself, which needs none, still
# loads instead of every request answering 500.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^api(?:/.*)?$ api.php [END]
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # The cross-origin isolation the static package and softn.com send
    # (apps/softn-single/public/.htaccess): this file takes that one's place
    # in an archive with a backend, and an app must behave the same there.
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "credentialless"
    # Only this site may frame the app, so another page cannot overlay it and
    # steer a signed-in visitor's clicks. To embed the app on another site,
    # list that origin after 'self' (and remove X-Frame-Options).
    Header always set Content-Security-Policy "frame-ancestors 'self'"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "^(index\.html|runtime\.config\.json|app\.softn)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
