// Sim Lives — the life half. builder.logic (composed before this file)
// owns the house: plan, catalogue, static scene, cameras, tools. This file
// owns the people: avatars, needs, a day clock, pathfinding over the plan,
// interactions with the furniture, chatting, and the free will that keeps a
// household busy while you watch.
//
// Time: at 1x, one real second is one game minute, so a day is 24 minutes.
// Needs are 0..100 and drift down per game minute; interactions push them up.

// ---------------------------------------------------------------------------
// State synced to the UI
// ---------------------------------------------------------------------------
let liveCam = "orbit";          // orbit | follow | top | creator
let liveRoof = false;
let gameSpeed = 1;
let livePaused = false;
let clockText = "Day 1 · 08:00";
let skyName = "day";
let simCards = [];
let activeCard = null;
let menu = null;                // { title, options: [{ id, label }] } while a click menu is open
let creatorOpen = false;
let draft = null;               // the avatar being designed
let liveHint = "";
let householdSize = 0;
let liveStatus = "";
let events = [];                // the last few things that happened, newest first
let dayIcon = "☀️";

// ---------------------------------------------------------------------------
// VM-owned state
// ---------------------------------------------------------------------------
let sims = [];
let activeSimId = 0;
let nextSimId = 1;
let clockMinutes = 8 * 60;
let dayNumber = 1;
let navCells = null;            // 1 = blocked
let navDirty = true;
let menuTarget = null;          // { kind: "item"|"sim"|"ground", id, x, z }
let liveTick = 0;
let previewSpin = 0;
let doorAngles = {};            // opening id -> current swing angle
let doorHold = {};              // opening id -> tick until which someone is holding it open
let liveHiddenItems = {};       // item id -> 1 while drawn by the live layer instead of the static scene
let orbitSet = false;

const NAV_CELL = 0.25;
const NAV_N = Math.round((WORLD * 2) / NAV_CELL) + 1;
const NEED_KEYS = ["hunger", "energy", "bladder", "hygiene", "fun", "social"];
const NEED_LABELS = { hunger: "Hunger", energy: "Energy", bladder: "Bladder", hygiene: "Hygiene", fun: "Fun", social: "Social" };
const NEED_ICONS = { hunger: "🍽", energy: "😴", bladder: "🚽", hygiene: "🚿", fun: "🎉", social: "💬" };
// Drift per game minute while awake and idle.
const DECAY = { hunger: 0.13, energy: 0.075, bladder: 0.16, hygiene: 0.06, fun: 0.1, social: 0.07 };
const WALK_SPEED = 1.5;          // metres per real second at 1x
const QUEUE_MAX = 6;             // actions a sim will hold in their queue
const NEED_COLORS = { hunger: "#f97316", energy: "#60a5fa", bladder: "#facc15", hygiene: "#38bdf8", fun: "#f472b6", social: "#a78bfa" };
// What a sim does with itself between actions: mostly nothing, sometimes a
// look around, a stretch, hands on hips or a glance at the watch.
