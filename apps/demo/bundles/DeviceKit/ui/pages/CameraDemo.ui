// CameraDemo.ui - Camera access with photo capture
// Camera component in photo mode, captured photo display

<Stack direction=vertical gap=lg if={currentPage === "camera"}>
  // Header
  <Stack direction=vertical gap=sm>
    <Heading level={2} style={{ fontSize: "1.375rem", fontWeight: 600, color: "#0f172a" }}>Camera Demo</Heading>
    <Text style={{ color: "#64748b", fontSize: "0.875rem" }}>Take a photo with the device camera. The browser asks before the camera turns on.</Text>
  </Stack>

  <Grid columns={{ sm: 1, lg: 2 }} gap=lg>
    // Camera Viewfinder Card
    <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0" }}>
      <Stack direction=vertical gap=md>
        <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Viewfinder</Text>

        // Camera Component
        <Camera
          mode="photo"
          onCapture={handleCapture}
          style={{ width: "100%", borderRadius: "12px" }}
        />
      </Stack>
    </Card>

    // Captured Photo Card
    <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0" }}>
      <Stack direction=vertical gap=md>
        <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Captured Photo</Text>

        // Photo Display
        <Box if={capturedPhoto} style={{
          borderRadius: "12px",
          overflow: "hidden",
          border: "1px solid #e2e8f0",
          minHeight: "280px",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          background: "#f8fafc"
        }}>
          <Image src={capturedPhoto} alt="Captured photo" style={{
            maxWidth: "100%",
            maxHeight: "400px",
            borderRadius: "8px",
            objectFit: "contain"
          }} />
        </Box>

        // No photo placeholder
        <Box if={!capturedPhoto} style={{
          borderRadius: "12px",
          border: "2px dashed #e2e8f0",
          minHeight: "280px",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          background: "#f8fafc"
        }}>
          <Stack direction=vertical gap=sm align=center>
            <Box style={{
              width: "48px",
              height: "48px",
              borderRadius: "12px",
              background: "#e2e8f0",
              display: "flex",
              alignItems: "center",
              justifyContent: "center"
            }}>
              <Icon svg={iconSvg("camera", "#94a3b8")} size={22} />
            </Box>
            <Text size=sm style={{ color: "#94a3b8" }}>No photo captured yet</Text>
            <Text size=xs style={{ color: "#cbd5e1" }}>Use the camera to capture a photo</Text>
          </Stack>
        </Box>

        // Photo actions
        <Box if={capturedPhoto} style={{
          background: "#f0fdf4",
          borderRadius: "8px",
          padding: "0.625rem 0.75rem",
          border: "1px solid #bbf7d0",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          gap: "0.75rem",
          flexWrap: "wrap"
        }}>
          <Text size=xs style={{ color: "#15803d", fontWeight: 500 }}>Captured. Save it or take another.</Text>
          <Box style={{ display: "flex", alignItems: "center", gap: "0.5rem" }}>
            <a
              href={capturedPhoto}
              download="devicekit-photo.jpg"
              style={{ display: "inline-flex", alignItems: "center", gap: "0.375rem", fontSize: "0.75rem", fontWeight: 600, color: "#15803d", textDecoration: "none", padding: "0.25rem 0.625rem", borderRadius: "6px", border: "1px solid #bbf7d0", background: "#ffffff" }}
            ><Icon name="download" size={13} color="#15803d" />Save</a>
            <Button variant=ghost size=sm @click={clearPhoto} style={{
              fontSize: "0.75rem",
              padding: "0.25rem 0.625rem",
              borderRadius: "6px",
              color: "#64748b"
            }}>Clear</Button>
          </Box>
        </Box>
      </Stack>
    </Card>
  </Grid>

  // Permission note
  <Box style={{ display: "flex", alignItems: "center", gap: "0.5rem", padding: "0 0.25rem" }}>
    <Icon svg={iconSvg("shield", "#94a3b8")} size={14} />
    <Text style={{ fontSize: "0.75rem", color: "#94a3b8" }}>This page uses the camera permission, in photo mode only. Nothing is recorded or uploaded; a photo stays on this page until you save or clear it.</Text>
  </Box>
</Stack>
