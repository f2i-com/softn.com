// Maze Escape 3D — a fresh maze every game, carved by a depth-first walk over
// a 15×15 grid, walked in first person with the pointer locked, with a
// minimap that fills in as you go and a best time kept in the browser.
//
// The loop is `gameStep` (never tick/update/animate/render, which the runtime
// may drop when its queue is busy).

let TICK_MS = 33
let DT = 0.033
let ROWS = 15
let COLS = 15
let CELL = 2
let MOVE = 3.6
let RUN = 5.4
let P_R = 0.32
let EYE = 1.5

// Synced to the UI.
let objects = []
let sceneStatic = []
let lights = []
let cameraPos = { x: 3, y: 1.5, z: 3 }
let cameraLookAt = { x: 8, y: 1.5, z: 3 }
let sceneFog = { color: "#0b0e14", near: 6, far: 40 }
let started = false
let paused = false
let won = false
let touchMode = false
let timeText = "0:00"
let bestText = "—"
let mapItems = []
let toast = ""
let toastTicks = 0

// VM-owned.
let maze = []
let visited = []
let px = 3
let pz = 3
let yaw = Math.PI / 2
let pitch = 0
let vx = 0
let vz = 0
let startTime = 0
let elapsedMs = 0
let bestMs = 0
let exitX = 13
let exitZ = 13
let rngSeed = 1
let lastLocked = false
let bobPhase = 0
let steps = 0
let lastCell = -1

let muted = false

function play(name, volume) {
  if (muted) { return }
  softn.audio.play("assets/sfx/" + name + ".wav", { volume: volume })
}

function toggleMute() {
  muted = !muted
  try { localStorage.setItem("maze3d:muted", muted ? "1" : "0") } catch (err) {}
}

function myRand() {
  rngSeed = (rngSeed * 48271) % 2147483647
  return rngSeed / 2147483647
}

function isUiControl(e) {
  let tag = e.targetTag || ""
  return tag === "input" || tag === "textarea" || tag === "select" || tag === "button" || !!e.targetEditable
}

function _init() {
  if (window.__mzCleanup) { window.__mzCleanup() }
  rngSeed = (Date.now() % 100000) + 29
  window.__mzKeys = { w: false, a: false, s: false, d: false, run: false }
  window.__mzTouch = false
  window.__scene3dLocked = false
  window.__scene3dWantLock = false
  window.__scene3dReleaseLock = false

  function onKeyDown(e) {
    if (isUiControl(e)) { return }
    let k = window.__mzKeys
    let key = e.key || ""
    if (key === "w" || key === "W" || key === "ArrowUp") { k.w = true; e.preventDefault() }
    else if (key === "s" || key === "S" || key === "ArrowDown") { k.s = true; e.preventDefault() }
    else if (key === "a" || key === "A" || key === "ArrowLeft") { k.a = true; e.preventDefault() }
    else if (key === "d" || key === "D" || key === "ArrowRight") { k.d = true; e.preventDefault() }
    else if (key === "Shift") { k.run = true }
    else if ((key === "m" || key === "M") && !e.repeat) { toggleMute() }
  }
  function onKeyUp(e) {
    let k = window.__mzKeys
    let key = e.key || ""
    if (key === "w" || key === "W" || key === "ArrowUp") { k.w = false }
    else if (key === "s" || key === "S" || key === "ArrowDown") { k.s = false }
    else if (key === "a" || key === "A" || key === "ArrowLeft") { k.a = false }
    else if (key === "d" || key === "D" || key === "ArrowRight") { k.d = false }
    else if (key === "Shift") { k.run = false }
  }
  function onBlur() { window.__mzKeys = { w: false, a: false, s: false, d: false, run: false } }
  function onTouch(e) { window.__mzTouch = true }
  window.addEventListener("keydown", onKeyDown, true)
  window.addEventListener("keyup", onKeyUp, true)
  window.addEventListener("blur", onBlur)
  window.addEventListener("touchstart", onTouch)
  window.__mzCleanup = function () {
    window.removeEventListener("keydown", onKeyDown, true)
    window.removeEventListener("keyup", onKeyUp, true)
    window.removeEventListener("blur", onBlur)
    window.removeEventListener("touchstart", onTouch)
  }

  try { bestMs = parseInt(localStorage.getItem("maze3d:best") || "0") || 0 } catch (err) { bestMs = 0 }
  try { muted = localStorage.getItem("maze3d:muted") === "1" } catch (err) { muted = false }
  bestText = bestMs > 0 ? clock(bestMs) : "—"
  carveMaze()
  buildScene()
  spawn()
  titleAngle = 0
  buildLights()
  composeObjects()
  buildMap()
}

// ---- The maze ------------------------------------------------------------

// Depth-first carving on the odd cells of an all-wall grid: every cell is
// reachable, there is exactly one route between any two, and the dead ends
// are where the minimap earns its place.
function carveMaze() {
  maze = []
  let i = 0
  while (i < ROWS * COLS) { maze.push(1); i = i + 1 }
  let stack = [[1, 1]]
  maze[1 * COLS + 1] = 0
  while (stack.length > 0) {
    let top = stack[stack.length - 1]
    let r = top[0]
    let c = top[1]
    let options = []
    if (r - 2 >= 1 && maze[(r - 2) * COLS + c] === 1) { options.push([r - 2, c, r - 1, c]) }
    if (r + 2 < ROWS - 1 && maze[(r + 2) * COLS + c] === 1) { options.push([r + 2, c, r + 1, c]) }
    if (c - 2 >= 1 && maze[r * COLS + c - 2] === 1) { options.push([r, c - 2, r, c - 1]) }
    if (c + 2 < COLS - 1 && maze[r * COLS + c + 2] === 1) { options.push([r, c + 2, r, c + 1]) }
    if (options.length === 0) {
      stack = stack.slice(0, stack.length - 1)
    } else {
      let pick = options[Math.floor(myRand() * options.length)]
      maze[pick[2] * COLS + pick[3]] = 0
      maze[pick[0] * COLS + pick[1]] = 0
      stack.push([pick[0], pick[1]])
    }
  }
  // A few extra openings so there is more than one way round.
  let n = 0
  while (n < 6) {
    let r = 1 + Math.floor(myRand() * (ROWS - 2))
    let c = 1 + Math.floor(myRand() * (COLS - 2))
    if (maze[r * COLS + c] === 1 && ((r % 2 === 1) !== (c % 2 === 1))) { maze[r * COLS + c] = 0; n = n + 1 }
  }
  exitX = COLS - 2
  exitZ = ROWS - 2
  visited = []
  i = 0
  while (i < ROWS * COLS) { visited.push(0); i = i + 1 }
}

function wallAt(col, row) {
  if (row < 0 || row >= ROWS || col < 0 || col >= COLS) { return true }
  return maze[row * COLS + col] === 1
}

function blocked(x, z) {
  let c0 = Math.floor((x - P_R) / CELL + 0.5)
  let c1 = Math.floor((x + P_R) / CELL + 0.5)
  let r0 = Math.floor((z - P_R) / CELL + 0.5)
  let r1 = Math.floor((z + P_R) / CELL + 0.5)
  let r = r0
  while (r <= r1) {
    let c = c0
    while (c <= c1) {
      if (wallAt(c, r)) {
        let wx0 = c * CELL - CELL / 2
        let wx1 = c * CELL + CELL / 2
        let wz0 = r * CELL - CELL / 2
        let wz1 = r * CELL + CELL / 2
        if (x + P_R > wx0 && x - P_R < wx1 && z + P_R > wz0 && z - P_R < wz1) { return true }
      }
      c = c + 1
    }
    r = r + 1
  }
  return false
}

// ---- Scene ---------------------------------------------------------------

function buildScene() {
  let out = []
  let shades = ["#525b6b", "#5d6778", "#485163"]
  let r = 0
  while (r < ROWS) {
    let c = 0
    while (c < COLS) {
      if (maze[r * COLS + c] === 1) {
        // Interior walls that no corridor touches are never seen: skip them.
        let exposed = !wallAt(c - 1, r) || !wallAt(c + 1, r) || !wallAt(c, r - 1) || !wallAt(c, r + 1)
        if (exposed) {
          out.push({ id: "w" + r + "_" + c, type: "box", position: { x: c * CELL, y: 1.3, z: r * CELL }, width: CELL, height: 2.6, depth: CELL, color: shades[(r * 3 + c * 5) % 3], roughness: 0.9, metalness: 0.05 })
        }
      }
      c = c + 1
    }
    r = r + 1
  }
  let mid = (COLS - 1) * CELL / 2
  out.push({ id: "floor", type: "plane", position: { x: mid, y: 0, z: mid }, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: COLS * CELL + 4, height: ROWS * CELL + 4, color: "#2a3140", roughness: 1 })
  if (started) {
    out.push({ id: "ceiling", type: "plane", position: { x: mid, y: 2.6, z: mid }, rotation: { x: Math.PI / 2, y: 0, z: 0 }, width: COLS * CELL + 4, height: ROWS * CELL + 4, color: "#1b2029", roughness: 1 })
  }
  // Skirting along the corridors gives the eye a line to follow in the fog.
  out.push({ id: "exit", type: "torus", position: { x: exitX * CELL, y: 1.2, z: exitZ * CELL }, radius: 0.7, tube: 0.12, color: "#fbbf24", emissive: "#f59e0b", emissiveIntensity: 1.6, animate: { rotateY: 0.03, rotateX: 0.015 } })
  out.push({ id: "exitpad", type: "cylinder", position: { x: exitX * CELL, y: 0.03, z: exitZ * CELL }, radius: 0.8, height: 0.06, color: "#fbbf24", emissive: "#f59e0b", emissiveIntensity: 0.5 })
  out.push({ id: "startpad", type: "cylinder", position: { x: CELL, y: 0.03, z: CELL }, radius: 0.8, height: 0.06, color: "#4ade80", emissive: "#22c55e", emissiveIntensity: 0.35 })
  sceneStatic = out
}

function buildLights() {
  lights = [
    { id: "ambient", type: "ambient", color: "#9fb0d0", intensity: started ? 0.3 : 1.6 },
    { id: "hemi", type: "hemisphere", color: "#b8c6e6", groundColor: "#3b4252", intensity: started ? 0.7 : 1.4 },
    // A hand torch: bright enough to read the corridor, dim enough that a
    // wall at arm's length is a wall and not a white sheet.
    { id: "torch", type: "point", color: "#ffd9a0", intensity: 9, distance: 14, decay: 2, position: { x: px, y: 2.1, z: pz } },
    { id: "exitglow", type: "point", color: "#fbbf24", intensity: 18, distance: 16, decay: 2, position: { x: exitX * CELL, y: 2, z: exitZ * CELL } }
  ]
}

function composeObjects() {
  objects = []
}

// ---- Flow ----------------------------------------------------------------

// Before a game the camera hangs above the maze and circles it slowly: the
// whole puzzle as the backdrop to the card that starts it.
let titleAngle = 0
let camY = EYE
function titleDrift() {
  titleAngle = titleAngle + 0.003
  let mid = (COLS - 1) * CELL / 2
  px = mid + Math.cos(titleAngle) * 9
  pz = mid + Math.sin(titleAngle) * 9
  camY = 17
  yaw = Math.atan2(mid - px, mid - pz)
  pitch = -1.05
  window.__scene3dYaw = yaw
  window.__scene3dPitch = pitch
  updateCamera()
}

function spawn() {
  px = CELL
  pz = CELL
  camY = EYE
  vx = 0
  vz = 0
  yaw = wallAt(2, 1) ? 0 : Math.PI / 2
  pitch = 0
  window.__scene3dYaw = yaw
  window.__scene3dPitch = pitch
  updateCamera()
}

function startGame() {
  carveMaze()
  started = true
  buildScene()
  spawn()
  startTime = Date.now()
  elapsedMs = 0
  steps = 0
  lastCell = -1
  bobPhase = 0
  won = false
  paused = false
  started = true
  timeText = "0:00"
  window.__scene3dWantLock = true
  showToast("Find the golden ring.")
  play("start", 0.4)
  buildMap()
}

function pauseGame() {
  if (!started || won) { return }
  paused = true
}

function resumeGame() {
  paused = false
  startTime = Date.now() - elapsedMs
  window.__scene3dWantLock = true
}

function backToTitle() {
  started = false
  won = false
  paused = false
  buildScene()
}

function showToast(text) {
  toast = text
  toastTicks = Math.ceil(2400 / TICK_MS)
}

function clock(ms) {
  let s = Math.floor(ms / 1000)
  let m = Math.floor(s / 60)
  let r = s - m * 60
  let t = Math.floor((ms % 1000) / 100)
  return m + ":" + (r < 10 ? "0" + r : "" + r) + "." + t
}

function updateCamera() {
  let bob = 0
  if ((vx * vx + vz * vz) > 1) { bob = Math.sin(bobPhase) * 0.03 }
  cameraPos = { x: px, y: camY + bob, z: pz }
  let cp = Math.cos(pitch)
  cameraLookAt = { x: px + Math.sin(yaw) * cp * 5, y: camY + Math.sin(pitch) * 5, z: pz + Math.cos(yaw) * cp * 5 }
}

function gameStep() {
  if (toastTicks > 0) { toastTicks = toastTicks - 1; if (toastTicks === 0) { toast = "" } }
  if (!started) {
    titleDrift()
    buildLights()
    return
  }
  let locked = !!window.__scene3dLocked
  if (lastLocked && !locked && !touchMode && !won) { paused = true }
  lastLocked = locked
  if (window.__mzTouch) { touchMode = true }
  if (paused || won) { return }

  if (window.__scene3dYaw !== undefined) { yaw = window.__scene3dYaw }
  if (window.__scene3dPitch !== undefined) { pitch = window.__scene3dPitch }
  let k = window.__mzKeys
  let fwd = (k.w ? 1 : 0) - (k.s ? 1 : 0)
  let str = (k.d ? 1 : 0) - (k.a ? 1 : 0)
  let len = Math.sqrt(fwd * fwd + str * str)
  if (len > 0) { fwd = fwd / len; str = str / len }
  let speed = k.run ? RUN : MOVE
  let wx = Math.sin(yaw) * fwd - Math.cos(yaw) * str
  let wz = Math.cos(yaw) * fwd + Math.sin(yaw) * str
  vx = vx + (wx * speed - vx) * 0.35
  vz = vz + (wz * speed - vz) * 0.35
  let nx = px + vx * DT
  if (blocked(nx, pz)) { vx = 0 } else { px = nx }
  let nz = pz + vz * DT
  if (blocked(px, nz)) { vz = 0 } else { pz = nz }
  if ((vx * vx + vz * vz) > 1) { bobPhase = bobPhase + 0.28 }

  let cc = Math.floor(px / CELL + 0.5)
  let cr = Math.floor(pz / CELL + 0.5)
  if (cr >= 0 && cr < ROWS && cc >= 0 && cc < COLS) {
    let cell = cr * COLS + cc
    if (cell !== lastCell) {
      lastCell = cell
      if (visited[cell] === 0) {
        visited[cell] = 1
        steps = steps + 1
        play("found", 0.18)
      }
      buildMap()
    }
  }

  elapsedMs = Date.now() - startTime
  timeText = clock(elapsedMs)
  let dx = px - exitX * CELL
  let dz = pz - exitZ * CELL
  if (dx * dx + dz * dz < 1.1) { finish() }

  updateCamera()
  buildLights()
}

function finish() {
  won = true
  // The card that follows has buttons to click: hand the cursor back.
  window.__scene3dReleaseLock = true
  play("win", 0.5)
  if (bestMs === 0 || elapsedMs < bestMs) {
    bestMs = elapsedMs
    bestText = clock(bestMs)
    try { localStorage.setItem("maze3d:best", String(bestMs)) } catch (err) {}
    showToast("A new best time.")
  }
}

// The minimap: walls, the cells you have stood in, the exit and you.
function buildMap() {
  let items = []
  let r = 0
  while (r < ROWS) {
    let c = 0
    while (c < COLS) {
      if (maze[r * COLS + c] === 1) { items.push({ x: c, y: r, color: "#3b4252" }) }
      else if (visited[r * COLS + c] === 1) { items.push({ x: c, y: r, color: "#1f5a3a" }) }
      c = c + 1
    }
    r = r + 1
  }
  items.push({ x: exitX, y: exitZ, color: "#fbbf24", borderRadius: "50%" })
  items.push({ x: Math.floor(px / CELL + 0.5), y: Math.floor(pz / CELL + 0.5), color: "#4ade80", borderRadius: "50%" })
  mapItems = items
}

function padPress(dir) {
  let k = window.__mzKeys
  if (dir === "up") { k.w = true } else if (dir === "down") { k.s = true } else if (dir === "left") { k.a = true } else if (dir === "right") { k.d = true }
}
function padRelease(dir) {
  let k = window.__mzKeys
  if (dir === "up") { k.w = false } else if (dir === "down") { k.s = false } else if (dir === "left") { k.a = false } else if (dir === "right") { k.d = false }
}
function onSceneClick(hit) {}
