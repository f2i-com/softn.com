  // --- The table authority ---
  //
  // Runs on softn-server, as this bundle's own server logic (see `server` in
  // manifest.json): a room per table, the whole game state held here and
  // nowhere a player can read it. Clients see projections — the public table
  // for everyone, one seat's own cards for the ticket that holds that seat —
  // and send actions the rules in rules.logic judge. Hiding a card on a
  // client's screen is not the same as the client never having had it;
  // this is the second thing.
  //
  // What a client holds is a ticket: a random string issued when it took a
  // seat, sent with every request. It grants that seat in that room and
  // nothing else, and dies with the room. It is not an account and it is not
  // a room code — the code lets someone join; the ticket is what they got.
  //
  // Every action carries an id, the revision of the view it was decided on
  // and the action itself. The same id again returns the same answer (a
  // retry is safe); the same id with a different action is refused; an
  // action decided on a stale view is refused with the current revision, so
  // an old raise is never replayed against a table that has moved on.
  //
  // Requests for one room can run at once on different workers, and each
  // reads the room, changes it and writes it back. The write is conditional:
  // `db.updateIf` commits only if the room's write stamp is still the one
  // that was read, so of two requests racing on one room exactly one lands
  // and the other is answered RETRY — the client looks again. Where the host
  // has no `db.updateIf` (an older softn-server), writes are unconditional
  // and the server must run with `--workers 1`.
  //
  // Randomness for the shuffle and for tickets is the engine's Math.random.
  // The server operator can see rooms and tickets in the database; nobody at
  // the table can. A dishonest operator is out of scope, as the RFC says.

  let AUTHORITY_TURN_MS = 45000
  let AUTHORITY_JOURNAL_MAX = 64
  let AUTHORITY_ROOM_IDLE_MS = 6 * 60 * 60 * 1000
  let AUTHORITY_PRESENCE_MS = 15000

  function Authority_reply(status, body) {
    return { status: status, body: body }
  }

  function Authority_refuse(status, code, message, extra) {
    let body = { ok: false, error: { code: code, message: message } }
    if (extra) {
      let keys = Object.keys(extra)
      let i = 0
      while (i < keys.length) {
        body[keys[i]] = extra[keys[i]]
        i = i + 1
      }
    }
    return Authority_reply(status, body)
  }

  function Authority_token(length) {
    let alphabet = "abcdefghijkmnpqrstuvwxyz23456789"
    let out = ""
    let i = 0
    while (i < length) {
      out = out + alphabet.charAt(Math.floor(Math.random() * alphabet.length))
      i = i + 1
    }
    return out
  }

  function Authority_body(req) {
    let b = req && req.body
    if (!b || typeof b !== "object") return null
    return b
  }

  /** The room record for a code, or null. Codes are short and few rooms live at once. */
  function Authority_find(code) {
    if (typeof code !== "string" || code.length < 4 || code.length > 12) return null
    let rooms = db.query("rooms")
    let i = 0
    while (i < rooms.length) {
      if (rooms[i].data && rooms[i].data.code === code) return rooms[i]
      i = i + 1
    }
    return null
  }

  function Authority_member(room, ticket) {
    if (typeof ticket !== "string" || ticket.length < 8) return null
    let i = 0
    while (i < room.members.length) {
      if (room.members[i].ticket === ticket) return room.members[i]
      i = i + 1
    }
    return null
  }

  /**
   * Write the room back, only if nobody else has since it was read. Returns
   * false when someone has; the caller answers RETRY and changes nothing.
   */
  function Authority_save(rec, room) {
    room.updatedAt = Date.now()
    let before = room.stamp || 0
    room.stamp = before + 1
    if (typeof db.updateIf === "function") {
      let outcome = db.updateIf(rec.id, room, "stamp", before)
      return !!(outcome && outcome.updated)
    }
    db.update(rec.id, room)
    return true
  }

  function Authority_retry() {
    return Authority_refuse(409, "RETRY", "Another request reached the table first; look again.")
  }

  /** Overdue turns are taken before any request is answered, so a table with an absent player still moves. */
  function Authority_settleTime(room, nowMs) {
    let changed = false
    let guard = 0
    while (guard < 6) {
      let t = Rules_timeout(room.state, nowMs)
      if (!t.changed) break
      room.state = t.state
      room.revision = room.revision + 1
      changed = true
      guard = guard + 1
    }
    return changed
  }

  function Authority_countPlayers(room) {
    let n = 0
    let i = 0
    while (i < room.members.length) {
      if (room.members[i].role === "player") n = n + 1
      i = i + 1
    }
    return n
  }

  function Authority_view(room, member, nowMs) {
    let pub = Rules_publicView(room.state)
    let presence = []
    let i = 0
    while (i < room.members.length) {
      let m = room.members[i]
      presence.push({ seat: m.seat, name: m.name, role: m.role, connected: nowMs - m.lastSeenMs < AUTHORITY_PRESENCE_MS })
      i = i + 1
    }
    let you = null
    if (member) {
      you = { seat: member.seat, name: member.name, role: member.role, holeCards: [], chips: 0, bet: 0, status: "", canAct: false }
      if (member.role === "player") {
        let mine = Rules_privateView(room.state, member.seat)
        if (mine) you = { seat: mine.seat, name: mine.name, role: "player", holeCards: mine.holeCards, chips: mine.chips, bet: mine.bet, status: mine.status, canAct: mine.canAct }
      }
    }
    return {
      ok: true,
      code: room.code,
      epoch: room.epoch,
      revision: room.revision,
      closed: room.closed,
      maxPlayers: room.maxPlayers,
      members: presence,
      "public": pub,
      you: you
    }
  }

  function Authority_name(value) {
    if (typeof value !== "string") return ""
    let name = value.replace(/^\s+|\s+$/g, "")
    if (name.length > 24) name = name.substring(0, 24)
    return name
  }

  // --- Handlers (manifest.server.routes) ---

  function roomHealth(req) {
    return Authority_reply(200, { ok: true, service: "texas-holdem-authority", rooms: db.query("rooms").length })
  }

  /** POST /api/rooms  {name, maxPlayers?} — a new table; the caller takes seat 0. */
  function roomCreate(req) {
    let body = Authority_body(req)
    let name = body ? Authority_name(body.name) : ""
    if (!name) return Authority_refuse(400, "INVALID_MESSAGE", "A name is required.")
    let maxPlayers = body && typeof body.maxPlayers === "number" ? Math.floor(body.maxPlayers) : 6
    if (maxPlayers < 2) maxPlayers = 2
    if (maxPlayers > 6) maxPlayers = 6
    let nowMs = Date.now()
    Authority_sweep(nowMs)
    let code = ""
    let attempts = 0
    while (attempts < 20) {
      code = "t-" + Authority_token(6)
      if (!Authority_find(code)) break
      attempts = attempts + 1
    }
    let seated = Rules_seat(Rules_newState(10, 20), 0, name, 1000)
    let ticket = Authority_token(28)
    let room = {
      code: code,
      epoch: 1,
      revision: 0,
      createdAt: nowMs,
      updatedAt: nowMs,
      closed: false,
      maxPlayers: maxPlayers,
      state: seated.state,
      members: [{ seat: 0, name: name, ticket: ticket, role: "player", joinedAt: nowMs, lastSeenMs: nowMs }],
      journal: [],
      stamp: 0
    }
    let rec = db.create("rooms", room)
    let view = Authority_view(room, room.members[0], nowMs)
    view.ticket = ticket
    return Authority_reply(201, view)
  }

  /** POST /api/rooms/join  {code, name, role?} — a seat, or a spectator's place. */
  function roomJoin(req) {
    let body = Authority_body(req)
    if (!body) return Authority_refuse(400, "INVALID_MESSAGE", "A JSON body is required.")
    let rec = Authority_find(body.code)
    if (!rec) return Authority_refuse(404, "NO_ROOM", "No table has that code.")
    let room = rec.data
    if (room.closed) return Authority_refuse(410, "ROOM_CLOSED", "That table has closed.")
    let name = Authority_name(body.name)
    if (!name) return Authority_refuse(400, "INVALID_MESSAGE", "A name is required.")
    let role = body.role === "spectator" ? "spectator" : "player"
    let nowMs = Date.now()
    Authority_settleTime(room, nowMs)
    let ticket = Authority_token(28)
    let seat = -1
    if (role === "player") {
      if (Authority_countPlayers(room) >= room.maxPlayers) return Authority_refuse(409, "ROOM_FULL", "Every seat at that table is taken.")
      seat = Rules_freeSeat(room.state)
      if (seat < 0) return Authority_refuse(409, "ROOM_FULL", "Every seat at that table is taken.")
      let seated = Rules_seat(room.state, seat, name, 1000)
      if (!seated.ok) return Authority_refuse(409, "ROOM_FULL", "Every seat at that table is taken.")
      room.state = seated.state
      room.revision = room.revision + 1
    }
    room.members.push({ seat: seat, name: name, ticket: ticket, role: role, joinedAt: nowMs, lastSeenMs: nowMs })
    if (!Authority_save(rec, room)) return Authority_retry()
    let view = Authority_view(room, room.members[room.members.length - 1], nowMs)
    view.ticket = ticket
    return Authority_reply(200, view)
  }

  /** POST /api/rooms/view  {code, ticket?} — the current projection. Without a valid ticket, the public one. */
  function roomView(req) {
    let body = Authority_body(req)
    if (!body) return Authority_refuse(400, "INVALID_MESSAGE", "A JSON body is required.")
    let rec = Authority_find(body.code)
    if (!rec) return Authority_refuse(404, "NO_ROOM", "No table has that code.")
    let room = rec.data
    let nowMs = Date.now()
    let member = Authority_member(room, body.ticket)
    let changed = Authority_settleTime(room, nowMs)
    if (member) {
      member.lastSeenMs = nowMs
      changed = true
    }
    // A lost presence write is nothing; a lost timeout is taken again by the next request.
    if (changed) Authority_save(rec, room)
    return Authority_reply(200, Authority_view(room, member, nowMs))
  }

  /**
   * POST /api/rooms/act  {code, ticket, id, expectedRevision, action}
   *
   * The one way the table changes. `action.type` is start, fold, check,
   * call, raise (with amount), allin or rebuy. The answer is the ack and
   * the new view, or a refusal that says why with the revision to retry on.
   */
  function roomAct(req) {
    let body = Authority_body(req)
    if (!body) return Authority_refuse(400, "INVALID_MESSAGE", "A JSON body is required.")
    let rec = Authority_find(body.code)
    if (!rec) return Authority_refuse(404, "NO_ROOM", "No table has that code.")
    let room = rec.data
    if (room.closed) return Authority_refuse(503, "AUTHORITY_UNAVAILABLE", "That table has closed.")
    let member = Authority_member(room, body.ticket)
    if (!member) return Authority_refuse(403, "NOT_MEMBER", "That ticket is not at this table.")
    if (member.role !== "player") return Authority_refuse(403, "NOT_A_PLAYER", "Spectators watch.")

    let id = body.id
    let expected = body.expectedRevision
    let action = body.action
    let shapeOk = typeof id === "string" && id.length >= 1 && id.length <= 64
      && typeof expected === "number" && Math.floor(expected) === expected && expected >= 0
      && action && typeof action === "object" && typeof action.type === "string"
      && (action.amount === undefined || (typeof action.amount === "number" && Math.floor(action.amount) === action.amount && action.amount >= 0))
    if (shapeOk) {
      let keys = Object.keys(action)
      let ki = 0
      while (ki < keys.length) {
        if (keys[ki] !== "type" && keys[ki] !== "amount") shapeOk = false
        ki = ki + 1
      }
    }
    if (!shapeOk) return Authority_refuse(400, "INVALID_MESSAGE", "An action is {id, expectedRevision, action: {type, amount?}}.")

    let nowMs = Date.now()
    member.lastSeenMs = nowMs
    let timedOut = Authority_settleTime(room, nowMs)

    // The journal answers a retry the same way it answered the first time,
    // and refuses an id that comes back meaning something else.
    let digest = JSON.stringify([expected, action.type, action.amount === undefined ? null : action.amount])
    let ji = 0
    while (ji < room.journal.length) {
      let entry = room.journal[ji]
      if (entry.seat === member.seat && entry.id === id) {
        if (entry.digest !== digest) return Authority_refuse(409, "ID_REUSED", "That action id was already used for a different action.")
        return Authority_reply(200, { ok: true, ack: entry.ack, replayed: true, view: Authority_view(room, member, nowMs) })
      }
      ji = ji + 1
    }

    if (expected !== room.revision) {
      if (timedOut) Authority_save(rec, room)
      return Authority_refuse(409, "STALE_VIEW", "The table has moved on since that view.", { revision: room.revision, view: Authority_view(room, member, nowMs) })
    }

    let applied = null
    if (action.type === "start") {
      applied = Rules_startHand(room.state, Math.random, nowMs)
    } else if (action.type === "rebuy") {
      applied = Rules_rebuy(room.state, member.seat, 1000)
    } else if (action.type === "fold" || action.type === "check" || action.type === "call" || action.type === "raise" || action.type === "allin") {
      applied = Rules_apply(room.state, member.seat, { type: action.type, amount: action.amount }, nowMs)
    } else {
      return Authority_refuse(400, "INVALID_MESSAGE", "Unknown action type: " + action.type)
    }
    if (!applied.ok) {
      if (timedOut) Authority_save(rec, room)
      let status = applied.code === "NOT_YOUR_TURN" ? 403 : 400
      return Authority_refuse(status, applied.code, "The rules refuse that action.", { revision: room.revision })
    }

    room.state = applied.state
    room.revision = room.revision + 1
    let ack = { id: id, revision: room.revision }
    room.journal.push({ seat: member.seat, id: id, digest: digest, ack: ack, atMs: nowMs })
    while (room.journal.length > AUTHORITY_JOURNAL_MAX) room.journal.shift()
    if (!Authority_save(rec, room)) return Authority_retry()
    return Authority_reply(200, { ok: true, ack: ack, view: Authority_view(room, member, nowMs) })
  }

  /** POST /api/rooms/leave  {code, ticket} — the seat is given up and the ticket stops working. */
  function roomLeave(req) {
    let body = Authority_body(req)
    if (!body) return Authority_refuse(400, "INVALID_MESSAGE", "A JSON body is required.")
    let rec = Authority_find(body.code)
    if (!rec) return Authority_refuse(404, "NO_ROOM", "No table has that code.")
    let room = rec.data
    let member = Authority_member(room, body.ticket)
    if (!member) return Authority_refuse(403, "NOT_MEMBER", "That ticket is not at this table.")
    let nowMs = Date.now()
    Authority_settleTime(room, nowMs)
    if (member.role === "player") {
      let left = Rules_unseat(room.state, member.seat, nowMs)
      if (left.ok) room.state = left.state
    }
    let kept = []
    let i = 0
    while (i < room.members.length) {
      if (room.members[i].ticket !== member.ticket) kept.push(room.members[i])
      i = i + 1
    }
    room.members = kept
    room.revision = room.revision + 1
    if (Authority_countPlayers(room) === 0) room.closed = true
    if (!Authority_save(rec, room)) return Authority_retry()
    return Authority_reply(200, { ok: true, revision: room.revision, closed: room.closed })
  }

  /** Rooms nobody has touched for hours are closed; their records go. Called on create so the table stays small. */
  function Authority_sweep(nowMs) {
    let rooms = db.query("rooms")
    let i = 0
    while (i < rooms.length) {
      let r = rooms[i]
      if (r.data && nowMs - (r.data.updatedAt || 0) > AUTHORITY_ROOM_IDLE_MS) db.hardDelete("rooms", r.id)
      i = i + 1
    }
  }
