// dos_int.logic — interrupt vectors and hardware interrupt delivery.
//
// Up to this point the emulator only ever *serviced* interrupts: a program
// executed INT n and the kernel emulated the effect in place. That is enough
// for a program that asks DOS to do things, and not enough for a game, which
// installs its own handlers and expects the machine to call them. DOOM stops
// at I_StartupTimer() for exactly this reason: it sets vectors 08h and 09h and
// then waits for a tick that never arrives.
//
// What this adds:
//   * a vector table a program can read and write (INT 21h AH=25h/35h, and the
//     DPMI equivalents),
//   * real delivery: push FLAGS/CS/EIP, clear IF, jump to the handler, and let
//     the handler's own IRET return,
//   * a PIT-driven timer on IRQ0 and a keyboard on IRQ1.

// A vector is stored as a flat linear address when it was installed from
// 32-bit code, and as a packed (segment << 16) | offset when installed from
// real mode. DOS_VEC_SET marks the ones a program has actually claimed.
let DOS_VEC_ADDR = null;
let DOS_VEC_IS32 = null;
let DOS_VEC_SET = null;

// Every vector starts pointing at a one-byte IRET stub, so a handler that
// chains to "the previous handler" returns cleanly instead of running whatever
// happened to be in memory.
let DOS_IRET_STUB = 0x00500;

// The 8253 runs at 1.193182 MHz and divides down to the tick rate. 0 means
// 65536, which is the 18.2 Hz the BIOS programs at boot; DOOM reprograms it.
let DOS_PIT_DIVISOR = 65536;
let DOS_PIT_LATCH = 0;
let DOS_PIT_WRITE_STATE = 0;

// Emulated time is measured in cycles, so the tick has to be expressed in
// cycles too. main.logic keeps DOS_CPU_HZ near the rate actually being
// achieved, which is what makes game time track real time.
let DOS_CPU_HZ = 4000000;
let DOS_SPK_STATE = 0;            // PIT channel 2: which byte of the divisor is next
let DOS_SPK_LATCH = 0;
let DOS_SPK_ACCESS = 3;           // how the divisor arrives: 1 low byte, 2 high byte, 3 both
let DOS_TIMER_NEXT = 0;
let DOS_TICKS = 0;

// The keyboard: scan codes waiting in the keyboard itself, and the 8042's
// one-byte output buffer in front of them. A press is the code, a release
// the code with bit 7 set. A byte moves into the buffer when the buffer is
// empty and raises IRQ1; port 0x60 reads it and empties the buffer, and
// reading again gives the same byte, as the controller does. The ASCII the
// key carries rides alongside so the BIOS handler need not translate.
let DOS_SCAN_QUEUE = new Uint8Array(64);
let DOS_SCAN_ASCII = new Uint8Array(64);
let DOS_SCAN_HEAD = 0;
let DOS_SCAN_TAIL = 0;
let DOS_KEY_OBF = 0;          // the output buffer holds a byte
let DOS_KEY_ASCII = 0;        // the ASCII for the byte in the buffer
let DOS_KEY_SHIFT = 0;        // BIOS shift flags, mirrored at 0040:0017

// The BIOS INT 9 handler: INT F1h, which the kernel answers, then IRET. A
// program that hooks INT 9 and chains to the old vector lands here.
let DOS_BIOS_KEY_STUB = 0x00504;

// A scan code from the keyboard, with the ASCII a make code stands for.
function dosInt_pushScan(code, ascii) {
  let next = (DOS_SCAN_HEAD + 1) & 63;
  if (next === DOS_SCAN_TAIL) return;              // full: the key is lost
  DOS_SCAN_QUEUE[DOS_SCAN_HEAD] = code & 0xFF;
  DOS_SCAN_ASCII[DOS_SCAN_HEAD] = ascii & 0xFF;
  DOS_SCAN_HEAD = next;
}

// Move the next scan code into the output buffer. 1 when a byte moved.
function dosInt_loadScan() {
  if (DOS_KEY_OBF === 1 || DOS_SCAN_HEAD === DOS_SCAN_TAIL) return 0;
  DOS_KEY_LAST_SCAN = DOS_SCAN_QUEUE[DOS_SCAN_TAIL];
  DOS_KEY_ASCII = DOS_SCAN_ASCII[DOS_SCAN_TAIL];
  DOS_SCAN_TAIL = (DOS_SCAN_TAIL + 1) & 63;
  DOS_KEY_OBF = 1;
  return 1;
}

// Port 0x60: the byte in the output buffer, which the read empties.
function dosInt_readScan() {
  DOS_KEY_OBF = 0;
  return DOS_KEY_LAST_SCAN;
}

// The BIOS keyboard handler. Shift keys keep the flags; a make code becomes
// a word in the BIOS buffer for INT 16h; a break code is noted and dropped.
function dosInt_biosKey() {
  let scan = DOS_KEY_LAST_SCAN;
  DOS_KEY_OBF = 0;
  let make = (scan & 0x80) === 0;
  let s = scan & 0x7F;
  let bit = 0;
  if (s === 0x36) bit = 0x01;            // right shift
  else if (s === 0x2A) bit = 0x02;       // left shift
  else if (s === 0x1D) bit = 0x04;       // ctrl
  else if (s === 0x38) bit = 0x08;       // alt
  if (bit !== 0) {
    if (make) DOS_KEY_SHIFT |= bit; else DOS_KEY_SHIFT &= ~bit;
    if (DOS_RAM !== null) DOS_RAM[0x00417] = DOS_KEY_SHIFT & 0xFF;
    return;
  }
  if (!make || DOS_KEY_BUFFER === null) return;
  let next = (DOS_KEY_HEAD + 1) & 31;
  if (next === DOS_KEY_TAIL) return;               // full: the key is lost
  DOS_KEY_BUFFER[DOS_KEY_HEAD] = ((s & 0xFF) << 8) | (DOS_KEY_ASCII & 0xFF);
  DOS_KEY_HEAD = next;
}

// Hand every waiting scan code to the BIOS handler: for the shell, which
// runs without the CPU and so without the interrupt poll.
function dosInt_pumpKeys() {
  DOS_KEY_OBF = 0;
  while (dosInt_loadScan() === 1) dosInt_biosKey();
}

// The PIC's interrupt mask (port 0x21). Bit n masks IRQ n.
let DOS_PIC_MASK = 0x00;
// The rest of the two 8259s that a handler looks at: which lines are in
// service (set when an interrupt is entered, cleared by the handler's EOI)
// and which are requesting, and which of the two a read of the command
// port answers. Delivery is not gated on the in-service bits; a BIOS-level
// handler here never sends an EOI, so gating would stall the machine.
let DOS_PIC_ISR = 0;
let DOS_PIC_ISR2 = 0;
let DOS_PIC_SEL = 0;              // 3: the command port reads the ISR; otherwise the IRR
let DOS_PIC_SEL2 = 0;
let DOS_PIC_MASK2 = 0x00;

function dosPic_inService(irq) {
  if (irq < 8) DOS_PIC_ISR |= (1 << irq);
  else { DOS_PIC_ISR2 |= (1 << (irq - 8)); DOS_PIC_ISR |= 0x04; }
}

// A write to a command port: ICW1 restarts the controller, OCW3 selects
// what a read answers, OCW2 is an end-of-interrupt.
function dosPic_command(slave, v) {
  if (v & 0x10) { if (slave) { DOS_PIC_ISR2 = 0; DOS_PIC_SEL2 = 0; } else { DOS_PIC_ISR = 0; DOS_PIC_SEL = 0; } return; }
  if (v & 0x08) { if (slave) DOS_PIC_SEL2 = v & 3; else DOS_PIC_SEL = v & 3; return; }
  if ((v & 0x20) === 0) return;
  let isr = slave ? DOS_PIC_ISR2 : DOS_PIC_ISR;
  if (v & 0x40) isr &= ~(1 << (v & 7));                       // specific
  else { for (let b = 0; b < 8; b++) if (isr & (1 << b)) { isr &= ~(1 << b); break; } }   // the highest priority in service
  if (slave) DOS_PIC_ISR2 = isr; else DOS_PIC_ISR = isr;
}

// The request register: lines with something waiting.
function dosPic_requests() {
  let r = 0;
  if (DOS_TIMER_NEXT !== 0 && DOS_TOTAL_CYCLES >= DOS_TIMER_NEXT) r |= 0x01;
  if (DOS_KEY_OBF === 0 && DOS_SCAN_HEAD !== DOS_SCAN_TAIL) r |= 0x02;
  if (DOS_SB_IRQ_PENDING === 1 && DOS_SB_IRQ < 8) r |= (1 << DOS_SB_IRQ);
  return r;
}

function dosPic_read(port) {
  if (port === 0x20) return (DOS_PIC_SEL === 3) ? DOS_PIC_ISR : dosPic_requests();
  if (port === 0xA0) return (DOS_PIC_SEL2 === 3) ? DOS_PIC_ISR2 : 0;
  if (port === 0x21) return DOS_PIC_MASK & 0xFF;
  return DOS_PIC_MASK2 & 0xFF;
}

let DOS_INT_DELIVERED = 0;

// Instructions left before the next interrupt check. 64 is far finer than any
// tick rate a program can ask for and keeps the check off the hot path.
let DOS_INT_CHECK = 64;
let DOS_INT_CHECK_EVERY = 64;

function dosInt_init() {
  DOS_VEC_ADDR = new Uint32Array(256);
  DOS_VEC_IS32 = new Uint8Array(256);
  DOS_VEC_SET = new Uint8Array(256);
  dosInt_reset();
}

function dosInt_reset() {
  if (DOS_VEC_ADDR === null) { dosInt_init(); return; }
  for (let i = 0; i < 256; i++) {
    DOS_VEC_ADDR[i] = DOS_IRET_STUB;
    DOS_VEC_IS32[i] = 0;
    DOS_VEC_SET[i] = 0;
  }
  // The stub itself, and a real-mode IVT that points every entry at it.
  if (DOS_RAM !== null) {
    DOS_RAM[DOS_IRET_STUB] = 0xCF;               // IRET
    for (let i = 0; i < 256; i++) {
      DOS_RAM[i * 4] = DOS_IRET_STUB & 0xFF;
      DOS_RAM[i * 4 + 1] = (DOS_IRET_STUB >> 8) & 0xFF;
      DOS_RAM[i * 4 + 2] = 0;
      DOS_RAM[i * 4 + 3] = 0;
    }
    // The BIOS keyboard handler, and vector 9 pointing at it.
    DOS_RAM[DOS_BIOS_KEY_STUB] = 0xCD;           // INT F1h
    DOS_RAM[DOS_BIOS_KEY_STUB + 1] = 0xF1;
    DOS_RAM[DOS_BIOS_KEY_STUB + 2] = 0xCF;       // IRET
    DOS_VEC_ADDR[0x09] = DOS_BIOS_KEY_STUB;
    DOS_RAM[0x09 * 4] = DOS_BIOS_KEY_STUB & 0xFF;
    DOS_RAM[0x09 * 4 + 1] = (DOS_BIOS_KEY_STUB >> 8) & 0xFF;
    DOS_RAM[0x00417] = 0;
  }
  DOS_PIT_DIVISOR = 65536;
  DOS_PIT_LATCH = 0;
  DOS_PIT_WRITE_STATE = 0;
  DOS_SCAN_HEAD = 0;
  DOS_SCAN_TAIL = 0;
  DOS_KEY_OBF = 0;
  DOS_KEY_SHIFT = 0;
  dosMouse_reset();
  DOS_MOUSE_USED = 0;
  dosSb_reset();
  dosOpl_init();
  DOS_SPK_STATE = 0;
  DOS_TIMER_NEXT = 0;
  DOS_TICKS = 0;
  DOS_PIC_MASK = 0x00;
  DOS_PIC_MASK2 = 0x00;
  DOS_PIC_ISR = 0; DOS_PIC_ISR2 = 0; DOS_PIC_SEL = 0; DOS_PIC_SEL2 = 0;
  DOS_INT_DELIVERED = 0;
}

// ---------------------------------------------------------------------------
// Vector table
// ---------------------------------------------------------------------------

function dosInt_setVector(vec, addr, is32) {
  let v = vec & 0xFF;
  DOS_VEC_ADDR[v] = addr >>> 0;
  DOS_VEC_IS32[v] = is32 ? 1 : 0;
  DOS_VEC_SET[v] = 1;
  if (!is32) {
    // Keep the real-mode IVT in step, since a program may read it directly.
    DOS_RAM[v * 4] = addr & 0xFF;
    DOS_RAM[v * 4 + 1] = (addr >> 8) & 0xFF;
    DOS_RAM[v * 4 + 2] = (addr >> 16) & 0xFF;
    DOS_RAM[v * 4 + 3] = (addr >> 24) & 0xFF;
  }
}

function dosInt_getVector(vec) {
  return DOS_VEC_ADDR[vec & 0xFF] >>> 0;
}

// ---------------------------------------------------------------------------
// Delivery
// ---------------------------------------------------------------------------

// Enter a handler the way the CPU does: the return address and flags go on the
// stack, IF is cleared so the handler is not re-entered, and execution
// continues at the handler. Its IRET pops all three back.
function dosInt_enter(vec) {
  let v = vec & 0xFF;
  dosCpu_flushFlags();
  let is32 = (DOS_IS_32 === 1);
  dosCpu_pushSize(DOS_EFLAGS >>> 0, is32);
  dosCpu_pushSize(DOS_SEGS[1] & 0xFFFF, is32);
  dosCpu_pushSize(DOS_EIP >>> 0, is32);
  DOS_EFLAGS = DOS_EFLAGS & ~DOS_FL_IF;
  DOS_EFLAGS = DOS_EFLAGS & ~0x0100;              // TF
  let addr = DOS_VEC_ADDR[v] >>> 0;
  if (DOS_VEC_IS32[v] === 1 || DOS_IS_32 === 1) {
    DOS_EIP = addr >>> 0;
  } else {
    DOS_SEGS[1] = (addr >>> 16) & 0xFFFF;
    DOS_EIP = addr & 0xFFFF;
  }
  DOS_INT_DELIVERED++;
}

// True when the CPU is willing to take a hardware interrupt right now.
function dosInt_ready(irq) {
  if (DOS_HALTED === 1) return 0;
  if (DOS_VEC_ADDR === null) return 0;
  dosCpu_flushFlags();
  if ((DOS_EFLAGS & DOS_FL_IF) === 0) return 0;
  if ((DOS_PIC_MASK >> irq) & 1) return 0;
  return 1;
}

// Called between instructions (and between decoded blocks) to see whether the
// timer or the keyboard is due. One interrupt per check: the second one waits,
// exactly as it would behind a real PIC.
function dosInt_poll() {
  if (DOS_VEC_ADDR === null) return 0;

  // IRQ0, the timer. Cycles per tick comes from the divisor the program wrote.
  // The clock runs whether or not anyone hooked it: the BIOS tick count at
  // 0040:006C is what a program's delay loops read.
  if (DOS_TIMER_NEXT === 0) {
    DOS_TIMER_NEXT = DOS_TOTAL_CYCLES + dosInt_cyclesPerTick();
  } else if (DOS_TOTAL_CYCLES >= DOS_TIMER_NEXT) {
    DOS_TICKS++;
    let t = (dosMmu_read32(0x0046C) + 1) >>> 0;
    if (t >= 0x1800B0) { t = 0; DOS_RAM[0x00470] = 1; }     // midnight
    dosMmu_write32(0x0046C, t);
    DOS_TIMER_NEXT = DOS_TOTAL_CYCLES + dosInt_cyclesPerTick();
    if (DOS_VEC_SET[0x08] === 1 && dosInt_ready(0) === 1) { dosPic_inService(0); dosInt_enter(0x08); return 1; }
  }

  // IRQ1, the keyboard: the next scan code moves into the output buffer
  // once the last was read. A program's own handler is entered for it; the
  // BIOS handler runs here directly; with IRQ1 masked the byte waits in the
  // buffer for whoever polls port 0x64.
  if (DOS_KEY_OBF === 0 && DOS_SCAN_HEAD !== DOS_SCAN_TAIL) {
    if ((DOS_PIC_MASK >> 1) & 1) {
      dosInt_loadScan();
    } else if (DOS_VEC_SET[0x09] === 1) {
      if (dosInt_ready(1) === 1) { dosInt_loadScan(); dosPic_inService(1); dosInt_enter(0x09); return 1; }
    } else {
      dosInt_loadScan();
      dosInt_biosKey();
    }
  }

  // The mouse: a program that asked the driver to call it gets called,
  // from an interrupt, once something has happened.
  if (dosMouse_pending() === 1 && dosInt_ready(12) === 1) {
    dosMouse_enterHandler();
    return 1;
  }

  // The Sound Blaster's DAC runs on this clock; its interrupt, once a block
  // has played, is delivered here. With no handler installed it is dropped,
  // as a masked line would be.
  dosSb_tick();
  if (DOS_SB_IRQ_PENDING === 1) {
    let vec = (DOS_SB_IRQ < 8) ? (0x08 + DOS_SB_IRQ) : (0x70 + DOS_SB_IRQ - 8);
    if (DOS_VEC_SET[vec] !== 1) DOS_SB_IRQ_PENDING = 0;
    else if (dosInt_ready(DOS_SB_IRQ) === 1) {
      DOS_SB_IRQ_PENDING = 0;
      dosPic_inService(DOS_SB_IRQ);
      dosInt_enter(vec);
      return 1;
    }
  }
  return 0;
}

// Would dosInt_poll do anything right now? Cheap enough to ask after every
// compiled trace, which is what lets the run loop skip the state copy the
// poll itself would need.
function dosInt_due() {
  if (DOS_VEC_ADDR === null) return 0;
  if (DOS_TIMER_NEXT === 0 || DOS_TOTAL_CYCLES >= DOS_TIMER_NEXT) return 1;
  if (DOS_KEY_OBF === 0 && DOS_SCAN_HEAD !== DOS_SCAN_TAIL) return 1;
  if (dosMouse_pending() === 1) return 1;
  if (DOS_SB_IRQ_PENDING === 1) return 1;
  if (dosSb_due() === 1) return 1;
  return 0;
}

function dosInt_cyclesPerTick() {
  let div = DOS_PIT_DIVISOR;
  if (div <= 0) div = 65536;
  // ticks per second = 1193182 / div, so cycles per tick = CPU_HZ * div / 1193182.
  let c = Math.floor((DOS_CPU_HZ * div) / 1193182);
  if (c < 200) c = 200;              // never let the handler starve the program
  return c;
}

// The PIT command and data ports, so a program can choose its own tick rate.
function dosInt_pitWrite(port, v) {
  if (port === 0x43) {
    // Channel 0 in lobyte/hibyte mode, and channel 2 for the speaker.
    if (((v >> 6) & 3) === 0) DOS_PIT_WRITE_STATE = 0;
    if (((v >> 6) & 3) === 2) { DOS_SPK_STATE = 0; let acc = (v >> 4) & 3; if (acc !== 0) DOS_SPK_ACCESS = acc; }
    return;
  }
  if (port === 0x40) {
    if (DOS_PIT_WRITE_STATE === 0) {
      DOS_PIT_LATCH = v & 0xFF;
      DOS_PIT_WRITE_STATE = 1;
    } else {
      DOS_PIT_DIVISOR = ((v & 0xFF) << 8) | DOS_PIT_LATCH;
      if (DOS_PIT_DIVISOR === 0) DOS_PIT_DIVISOR = 65536;
      DOS_PIT_WRITE_STATE = 0;
      // Re-base the schedule so a rate change takes effect immediately.
      DOS_TIMER_NEXT = DOS_TOTAL_CYCLES + dosInt_cyclesPerTick();
    }
  }
}


