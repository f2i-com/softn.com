/**
 * The to-do app's logic: its state and its functions.
 *
 * Every top-level `let` here is state a page can read, and every function is
 * one a page can call. main.ui links this file, and the pages it imports
 * (components/*.ui) are placed inside it, so they read the same state and
 * call the same functions. Nothing is passed from page to page.
 */

import "./utils.logic"

// ============================================================================
// State
// ============================================================================

// The header's words
let title = "My Todos"

// The records of the "todos" collection, as the database gives them:
// { id, data: { text, completed, createdAt } }
let todos = []

// What is typed in the "add" field
let newTodoText = ""

// Which todos the list shows: "all" | "active" | "completed"
let filter = "all"

// The todo being edited, and what is typed in its field. One pair for the
// whole page: a row is markup placed once for each todo, with no state of its
// own, so which row is open is kept here, by id.
let editingId = ""
let editText = ""

// ============================================================================
// Computed values
// ============================================================================

// A computed value is a `$:` declaration: a name, and the expression it is
// always worth. The runtime works each one out again whenever the state it
// reads has changed, before a page is drawn and before a function is called,
// so a page, a function and another `$:` all read the value as it is now.
// (`$computed(() => ...)` was an earlier spelling that nothing defines any
// more, so it reached the browser as "ReferenceError: $computed is not
// defined".)

// Todos still to do
$: activeTodos = todos.filter(t => !t.data.completed)

// Todos that are done
$: completedTodos = todos.filter(t => t.data.completed)

// The todos the current filter shows: one `$:` built on two others.
// One line: the extractor reads `$:` declarations a line at a time, so a
// wrapped expression is truncated at the newline and fails to compile.
$: filteredTodos = filter === "active" ? activeTodos : filter === "completed" ? completedTodos : todos

// ============================================================================
// Actions
// ============================================================================

// `db` is the app's local database. Its calls return at once, and each
// function reads the collection again afterwards so the page shows the change.

/**
 * Add what was typed as a new todo
 */
function addTodo() {
  const text = newTodoText.trim()
  if (!text) return

  db.create("todos", {
    text: text,
    completed: false,
    createdAt: new Date().toISOString()
  })

  newTodoText = ""
  refreshTodos()
}

/**
 * Mark a todo done, or not done
 */
function toggleTodo(id) {
  const todo = todos.find(t => t.id === id)
  if (!todo) return

  db.update(id, { completed: !todo.data.completed })
  refreshTodos()
}

/**
 * Delete a todo
 */
function deleteTodo(id) {
  db.delete(id)
  if (editingId === id) cancelEdit()
  refreshTodos()
}

/**
 * Open a todo's edit field, holding its text
 */
function startEdit(id) {
  const todo = todos.find(t => t.id === id)
  if (!todo) return

  editingId = id
  editText = todo.data.text
}

/**
 * Keep what was typed in the open edit field, and close it
 */
function saveEdit() {
  if (editingId) editTodo(editingId, editText)
  cancelEdit()
}

/**
 * Close the edit field without keeping what was typed
 */
function cancelEdit() {
  editingId = ""
  editText = ""
}

/**
 * Change a todo's text. An empty text changes nothing.
 */
function editTodo(id, newText) {
  const text = newText.trim()
  if (!text) return

  db.update(id, { text: text })
  refreshTodos()
}

/**
 * Delete every todo that is done
 */
function clearCompleted() {
  for (const todo of completedTodos) {
    db.delete(todo.id)
  }
  refreshTodos()
}

/**
 * Choose which todos the list shows
 */
function setFilter(newFilter) {
  filter = newFilter
}

/**
 * Read the collection again, oldest first
 */
function refreshTodos() {
  todos = db.query("todos").sort((a, b) => a.data.createdAt < b.data.createdAt ? -1 : 1)
}

// ============================================================================
// Start
// ============================================================================

// The runtime calls _init() once, when the app has loaded.
function _init() {
  refreshTodos()
}
