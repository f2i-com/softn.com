// === src/cinematics.js ===
/* Timeline data. Times are seconds. Shots are camera moves, never player moves.
   Cue windows are authored minimums: lsRetimeScene stretches a window to fit
   its recorded voice and warps every later shot, plate, fade and the duration
   through the same piecewise-linear clock, so the pacing survives re-recording.
   Add a new scene here and dispatch its stable ID from the director. */
function lsCinematics(manifest) {
  function shot(at,end,from,to,look,fov){return {at:at,end:end,from:from,to:to,look:look,fov:fov||64};}
  function cue(at,end,speaker,text,sound){return {at:at,end:end,speaker:speaker,text:text,sound:sound||""};}
  function fade(at,end,from,to){return {at:at,end:end,from:from,to:to};}
  // Shot templates are factories: retiming mutates them, so each scene owns its copy.
  function printer(end){return shot(0,end||6,[.05,1.62,-2.95],[.4,1.5,-3.3],[1.5,1.05,-3.65],52);}
  function radio(end){return shot(0,end||8,[.1,1.64,-3.05],[-.25,1.56,-3.4],[-1.6,1.32,-4.0],52);}
  function reels(at,end){return shot(at,end,[-.2,1.62,-.45],[.2,1.56,-.1],[1.85,1.42,.3],54);}
  let data={
    descent:{title:"PROLOGUE / SEALED FROM THE OUTSIDE",duration:63,fades:[fade(0,3.4,1,0)],shots:[
      shot(0,10,[.95,2.32,-5.5],[.4,2.26,-6.05],[0,1.95,-8.45],56),
      shot(10,21,[.35,1.78,3.35],[.05,1.55,4.3],[-1.95,1.15,4.45],60),
      shot(21,35,[0,1.60,1.95],[.12,1.56,-1.4],[0,1.5,-6.9],66),
      shot(35,49,[.42,1.72,-5.6],[.25,1.66,-5.95],[0,1.6,-7.2],55),
      shot(49,63,[0,1.62,-3.0],[0,1.6,-4.3],[0,1.4,-6.45],60)
    ],cues:[
      cue(0,8,"LOCAL RECORDER","MOURNER-6. Survey capsule. Lowered on a single cable into the Lacuna blood ocean.","winch"),
      cue(8.5,16,"VALE","Seventeen, this is Vale. Your hatch was welded from the outside twelve minutes ago. Do not treat that as a threat. Treat it as a pressure rating.","radio"),
      cue(16.5,23,"VALE","Everything that keeps you breathing is in the aft compartment. Scrubber. Bus. Bilge. Learn where they are before you need them."),
      cue(23.5,26,"OPERATOR 17","I have read the manual."),
      cue(26.5,29.5,"VALE","So had the last operator."),
      cue(30.5,38,"LOCAL RECORDER","Depth four hundred metres. Six hundred. Eight hundred. The cable is no longer audible in the hull.","tick"),
      cue(38.5,46,"VALE","Six photographs. Working life support. A record we can recover. That is the whole contract. I will stay on this channel until it is done."),
      cue(46.5,49.5,"OPERATOR 17","And if something answers on my channel?"),
      cue(50,53.5,"VALE","Then let me hear it before you do."),
      cue(54,60,"VALE","Walk forward to the helm and plot survey one. We begin with the only object down there I can promise is ours."),
      cue(60,63,"","[A single knock travels the length of the hull.]","knock")
    ]},
    calibration:{title:"01 / THE DESCENT WEIGHT",duration:32,plate:"calibration",plateFrom:4,plateUntil:21,shots:[printer(6),shot(6,32,[-.6,1.74,-5.1],[-.38,1.68,-5.4],[.2,1.62,-7.25],56)],cues:[
      cue(0,5,"PRINTER","Frame exposed. Four seconds of ocean, reduced to one sheet.","print"),
      cue(5.5,11,"VALE","Our descent weight. One cable still rises. The other has been cut, and cut cleanly."),
      cue(11.5,13.5,"OPERATOR 17","Cut by what?"),
      cue(14,20,"VALE","I am not going to guess on an open channel. Remember the defect. It may be the only fact we get to keep."),
      cue(20.5,25,"OPERATOR 17","The one thing you promised was ours is already damaged."),
      cue(25.5,32,"VALE","Yes. Proceed northeast. There is a rock shoulder between you and the lattice, and the chart is older than the shoulder.")
    ]},
    arch:{title:"02 / THE WHITE LATTICE",duration:37,plate:"arch",plateFrom:3,plateUntil:19,shots:[printer(6),shot(6,24,[0,1.56,-1.8],[-.22,1.62,-2.4],[-1.6,1.45,-4],67),shot(24,37,[-.3,1.6,-2.6],[-.6,1.55,-3.2],[-1.75,1.42,-4.0],52)],cues:[
      cue(0,6,"VALE","Orbital called it mineral accretion. The picture is under no obligation to agree.","print"),
      cue(6.5,13.5,"LOCAL RECORDER","Pale ribs, bridging the trench. Each carries the same shallow recess. No scale in the frame makes them comfortable."),
      cue(14,16.5,"OPERATOR 17","Somebody built that."),
      cue(17,24,"VALE","Or something grew it. Or the silt fell in a pattern, and we are two frightened people looking at a wall."),
      cue(24.5,30,"VALE","Come to the radio. The form wants two words, and I want them to be yours."),
      cue(30.5,37,"VALE","There is a second metal return west of the relay. It is not on the official route. Neither, now, are you.")
    ]},
    wreck:{title:"OPTIONAL / A VOICE IN A CAGE",duration:28,plate:"wreck",plateFrom:3,plateUntil:20,shots:[printer(9),shot(9,28,[.3,1.62,-1.1],[.5,1.55,-.5],[1.85,1.42,.3],54)],cues:[
      cue(0,4,"VALE","That hull is not on your task sheet.","print"),
      cue(4.5,9,"VALE","The task sheet is not a list of everything we have lost."),
      cue(9.5,17,"LOCAL RECORDER","A pressure capsule, split at the stern. Its recorder cage is intact. Beside it, a maintenance canister. Not a rescue beacon."),
      cue(17.5,19.5,"OPERATOR 17","Who was in it?"),
      cue(20,28,"VALE","Someone who labelled their equipment. The arm can reach the cage without opening either hull. Your decision, at the radio.")
    ]},
    relay:{title:"03 / THE DEAD RELAY",duration:36,plate:"relay",plateFrom:3,plateUntil:13,alarmAt:14.5,shots:[printer(14),
      shot(14,22,[.35,1.70,3.53],[.16,1.50,4.26],[-1.90,1.32,4.4],65),
      shot(22,36,[0,1.52,4.05],[.1,1.58,4.15],[1.83,1.5,4.45],59)],cues:[
      cue(0,6.5,"VALE","Relay Kestrel. Dead before you were lowered. Its maintenance buffer may still answer on seventy-four point six.","print"),
      cue(7,14,"LOCAL RECORDER","A human stencil beneath the deposits. Someone was here long enough to label the equipment, and long enough to stop."),
      cue(14.5,18,"SYSTEM","AUX bypass failure. Scrubber flow falling.","alarm"),
      cue(18.5,27,"VALE","Stop the boat. Aft compartment. Isolate the bus at the starboard box, vent the port valve, reset, then restore. Four steps. I will count them with you."),
      cue(27.5,30,"OPERATOR 17","And if I get the order wrong?"),
      cue(30.5,36,"VALE","The interlock will refuse you. It is the only thing down there designed to be kind.")
    ]},
    archive:{title:"RECOVERED BUFFER / IONA SEN",duration:42,shots:[radio(9),reels(9,24),shot(24,42,[0,1.58,1.55],[0,1.58,.85],[0,1.5,-6.5],68)],cues:[
      cue(0,8,"IONA SEN / ARCHIVE","Maintenance buffer, Relay Kestrel. This is not a distress message. A distress message asks something to come to you.","radio"),
      cue(8.5,16,"IONA SEN / ARCHIVE","Our recovery tone reached the surface twice. The second return arrived first. We replaced the clock. It happened again."),
      cue(16.5,24,"IONA SEN / ARCHIVE","The recorder has a local oscillator. Keep its raw timing. A clean export strips the discrepancy and makes the impossible look like equipment drift."),
      cue(24.5,33,"IONA SEN / ARCHIVE","If another capsule is listening: three independent records, then transmit on the open carrier. Do not send only the pictures. Send what the pictures disagree with."),
      cue(33.5,36,"OPERATOR 17","How long ago was that?"),
      cue(36.5,42,"VALE","Long enough that the relay is dead. Not long enough for the problem to be. We keep it. Whatever happens, we are not cleaning her out of the record.")
    ]},
    restored:{title:"ENGINEERING / AUX RESTORED",duration:22,shots:[shot(0,10,[.2,1.62,3.6],[.5,1.55,4.0],[1.84,1.5,4.45],56),shot(10,17,[-.1,1.5,3.7],[-.4,1.45,4.0],[-1.67,1.3,4.4],56),shot(17,22,[0,1.58,4.6],[0,1.58,3.9],[0,1.5,-2],66)],cues:[
      cue(0,3.5,"SYSTEM","AUX restored. Scrubber flow nominal.","evidence"),
      cue(4,10,"OPERATOR 17","Four steps. Vale, remind me why the valve is on the other side of the room from the switch."),
      cue(10.5,17,"VALE","Because the person who designed it never had to breathe in there."),
      cue(17.5,22,"VALE","Take a moment. Then plot the cut.")
    ]},
    choir:{title:"04 / THE CHOIR CUT",duration:31,plate:"choir",plateFrom:4,plateUntil:14,shots:[printer(14),shot(14,24,[0,1.53,-1.40],[.18,1.59,-.45],[0,1.48,2.72],64),shot(24,31,[.5,1.5,-2.2],[.3,1.45,-2.6],[-1.6,1.4,-4],50)],cues:[
      cue(0,6,"LOCAL RECORDER","Six apertures in the photograph. Seven acoustic returns.","knock"),
      cue(6.5,14,"VALE","The seventh begins before the sixth ends. Listen on eighty-three point five while you are stopped. Save the disagreement."),
      cue(14.5,17,"OPERATOR 17","It sounded like knocking."),
      cue(17.5,24,"VALE","Do not knock back. You do not know which side of the hull it is measuring.","knock"),
      cue(24.5,27.5,"OPERATOR 17","You said the hydrophone heard nothing."),
      cue(28,31,"VALE","I did. Write that down too.")
    ]},
    mirror:{title:"05 / SOMEONE HAS YOUR NUMBER",duration:36,plate:"mirror",plateFrom:3,plateUntil:13,alarmAt:29.5,shots:[printer(13),
      shot(13,23,[-.05,1.62,-3.0],[-.3,1.55,-3.3],[-1.6,1.4,-4],50),
      shot(23,30,[.62,1.92,-5.25],[.36,1.86,-5.75],[0,1.75,-8.35],57),
      shot(30,36,[.3,1.55,5.2],[.6,1.5,5.9],[2.03,1.33,6.7],58)],cues:[
      cue(0,6,"SYSTEM","Source identifier MOURNER-6. This identifier is already in use.","print"),
      cue(6.5,12,"UNVERIFIED","Controller. Survey complete. Request recovery. Seventeen aboard.","radio"),
      cue(12.5,19,"LOCAL RECORDER","Its identification tone is yours. Its packet is eight seconds ahead of your clock.","impact"),
      cue(19.5,22.5,"OPERATOR 17","Vale. That is my voice."),
      cue(23,29,"VALE","It is a voice shaped like yours. Do not give it another word to borrow."),
      cue(29.5,36,"VALE","There is a seam opening aft. We can deal with one impossible thing at a time.","knock")
    ]},
    heart:{title:"06 / THE LISTENING WELL",duration:30,plate:"heart",plateFrom:3,plateUntil:17,shots:[printer(17),shot(17,30,[0,1.64,.3],[0,1.58,-.3],[-1.70,1.44,-4.0],63)],cues:[
      cue(0,7,"LOCAL RECORDER","The shaft has no visible bottom. Above it, something that resembles the underside of a station.","print"),
      cue(7.5,15,"VALE","I have three return bearings for one hull. Do not choose the strongest one merely because it is loud."),
      cue(15.5,17.5,"OPERATOR 17","Which one is you?"),
      cue(18,21,"VALE","The one asking."),
      cue(21.5,30,"VALE","The survey is complete. Come to the radio, or cut the beacon yourself. This last procedure belongs to you.")
    ]},
    official:{title:"ENDING I / THE APPROVED RECORD",duration:33,fades:[fade(30,33,0,1)],shots:[radio(14),shot(14,27,[.55,1.94,-5.15],[.3,1.9,-5.9],[0,1.72,-8.4],59),printer(33)],cues:[
      cue(0,7,"RECOVERY LOG","Required frames accepted. Timing discrepancies normalised. Survey asset recovered.","end"),
      cue(7.5,14,"LOCAL RECORDER","The winch takes your weight. A hatch above opens before your depth gauge reaches zero.","winch"),
      cue(14.5,18,"VALE","MOURNER-6, confirm your designation."),
      cue(19.5,22,"UNVERIFIED","Seventeen aboard."),
      cue(23,26.5,"LOCAL RECORDER","Your hand has not reached the switch.","knock"),
      cue(27,33,"LOCAL RECORDER","The next capsule is authorised on the strength of your photographs.")
    ]},
    warning:{title:"ENDING II / A RECORD, NOT A PROMISE",duration:31,fades:[fade(28,31,0,1)],shots:[radio(9),reels(9,17),shot(17,31,[0,1.57,1.9],[0,1.57,.9],[0,1.58,-7.0],68)],cues:[
      cue(0,6,"IONA SEN / ARCHIVE","Someone has to leave a record that is not a promise.","end"),
      cue(6.5,15,"VALE","First receiver acknowledges. A second. They are cancelling the next descent. Seventeen, they are listening to you."),
      cue(15.5,23,"LOCAL RECORDER","Bad clocks. Uncertain shapes. The names of the people who measured them. Nothing removed for a cleaner ending."),
      cue(23.5,31,"VALE","For once the final line is not mission success. It is: do not send anyone else until we understand.")
    ]},
    silent:{title:"ENDING III / NO RETURN REQUESTED",duration:33,fades:[fade(29,33,0,1)],shots:[shot(0,8,[.2,1.7,6.55],[.3,1.57,6.85],[.35,1.37,8.1],57),shot(8,20,[0,1.59,1.5],[0,1.59,.9],[0,1.59,-7.7],69),shot(20,33,[0,1.62,-5.9],[0,1.65,-6.15],[0,1.62,-8.4],61)],cues:[
      cue(0,6,"SYSTEM","Calling beacon severed. Emergency ballast released. No carrier.","impact"),
      cue(6.5,11,"VALE","There will be no voice to follow. I will leave the receiver on."),
      cue(11.5,20,"LOCAL RECORDER","For twenty seconds the capsule rises through a pressure gradient that could be open ocean. Nothing confirms it. Nothing contradicts it."),
      cue(20.5,24,"LOCAL RECORDER","A knock comes from the hatch.","knock"),
      cue(25.5,28,"LOCAL RECORDER","You do not answer."),
      cue(29,33,"LOCAL RECORDER","Operator present. Destination unknown.")
    ]}
  };
  let voices=manifest||{};
  for(let id in data)lsRetimeScene(data[id],voices);
  return data;
}
function lsCueVoice(cue,manifest) {
  // A cue with no speaker is a stage direction: captioned in italics, never voiced.
  cue.direction=!cue.speaker;
  cue.role=cue.direction?"":lsRoleFor(cue.speaker);
  cue.key=cue.direction?"":lsVoiceKey(cue.role,cue.text);
  let ms=cue.key&&manifest[cue.key];
  cue.voiceSeconds=typeof ms==="number"&&ms>0?ms/1000:0;
  cue.voiced=cue.voiceSeconds>0;
}
function lsRetimeScene(scene,manifest) {
  let TAIL=.55,anchorsA=[0],anchorsB=[0],shift=0,prevEnd=0;
  for(let i=0;i<scene.cues.length;i++){
    let c=scene.cues[i];lsCueVoice(c,manifest);
    let start=Math.max(c.at+shift,prevEnd);
    let need=c.voiced?c.voiceSeconds+TAIL:(c.end-c.at);
    let end=Math.max(c.end+shift,start+need);
    shift=end-c.end;
    anchorsA.push(c.at,c.end);anchorsB.push(start,end);
    c.at=start;c.end=end;prevEnd=end;
  }
  function warp(t){
    if(!(t>0))return 0;
    for(let i=1;i<anchorsA.length;i++){
      if(t<=anchorsA[i]){let a0=anchorsA[i-1],a1=anchorsA[i],b0=anchorsB[i-1],b1=anchorsB[i];if(a1<=a0)return b1;return b0+(t-a0)/(a1-a0)*(b1-b0);}
    }
    return anchorsB[anchorsB.length-1]+(t-anchorsA[anchorsA.length-1]);
  }
  for(let i=0;i<scene.shots.length;i++){let s=scene.shots[i];s.at=warp(s.at);s.end=warp(s.end);}
  if(scene.fades)for(let i=0;i<scene.fades.length;i++){let f=scene.fades[i];f.at=warp(f.at);f.end=warp(f.end);}
  if(scene.plate){scene.plateFrom=warp(scene.plateFrom);scene.plateUntil=warp(scene.plateUntil);}
  if(typeof scene.alarmAt==="number")scene.alarmAt=warp(scene.alarmAt);
  scene.duration=warp(scene.duration);
  // A shot that ends before the next begins would leave a hold; stretch it to the cut.
  for(let i=0;i<scene.shots.length;i++){let next=i+1<scene.shots.length?scene.shots[i+1].at:scene.duration;if(scene.shots[i].end<next)scene.shots[i].end=next;}
  return scene;
}
function lsTimelinePose(scene,t,reduced) {
  let shot=scene.shots[0];for(let i=0;i<scene.shots.length;i++)if(t>=scene.shots[i].at)shot=scene.shots[i];
  let span=Math.max(.001,shot.end-shot.at);
  let u=reduced?0:Math.max(0,Math.min(1,(t-shot.at)/span));u=u*u*(3-2*u);
  let p={x:shot.from[0]+(shot.to[0]-shot.from[0])*u,y:shot.from[1]+(shot.to[1]-shot.from[1])*u,z:shot.from[2]+(shot.to[2]-shot.from[2])*u};
  return {position:p,lookAt:{x:shot.look[0],y:shot.look[1],z:shot.look[2]},fov:shot.fov};
}
function lsTimelineFade(scene,t) {
  if(!scene.fades)return 0;
  for(let i=0;i<scene.fades.length;i++){
    let f=scene.fades[i];
    if(t>=f.at&&t<=f.end){let u=(t-f.at)/Math.max(.001,f.end-f.at);return f.from+(f.to-f.from)*u;}
    if(t>f.end&&f.to===1)return 1;
  }
  return 0;
}


// === src/game3d.js ===
/* Pure first-person game/director. The native preview and Softn use this exact
   implementation. It owns no browser state. Rendering and audio are separate
   adapters: the director only emits events ("sound", "voice", "voiceStop"). */
function createLastSound3D() {
  let manifest=typeof lsVoiceManifest==="function"?lsVoiceManifest():{};
  let core=createLastSound(),deck=lsDeck(),content=lsContent(),scenes=lsCinematics(manifest);
  let p={x:0,z:1.45,yaw:Math.PI,pitch:-.02},phase="title",panel="",paused=false;
  let sceneId="",sceneTime=0,sceneQueue=[],seen=[],cueIndex=-1,door=0,doorTarget=0,resumeQuiet=false;
  let route=[],routeId="",routeIndex=0,cruise=1,navStatus="NOT PLOTTED",alignTarget=null,legTime=0,chatterDone=[];
  let seconds=0,bob=0,footTimer=0,events=[],captions=[],caption=null,captionLeft=0,captionTotal=0,voiceUntil=0;
  let lastPhoto=0,lastArchive=false,lastEnding="",lastScrubber=0;
  let reduced=false,torch=true,silentArmed=false,notice="",noticeTime=0,saveRequest=false;
  let input={forward:0,strafe:0,turn:0,tilt:0,run:false};
  function clamp(n,a,b){return Math.max(a,Math.min(b,n));}
  function delta(a,b){return ((a-b+540)%360)-180;}
  function emit(type,value){if(events.length<100)events.push({type:type,value:value});}
  function voiceFor(role,text){let key=lsVoiceKey(role,text),ms=manifest[key];return {key:key,seconds:typeof ms==="number"&&ms>0?ms/1000:0};}
  function say(raw,speaker){
    // Every spoken line is split into its speakers and stage directions here,
    // so the journal keeps the original string and the captions get one voice each.
    let parts=lsParseLine(raw,speaker||"VALE");
    for(let i=0;i<parts.length;i++){
      let s=parts[i];
      if(s.direction)captions.push({speaker:"",text:s.text,role:"",key:"",seconds:0,direction:true,sound:s.sound});
      else{let v=voiceFor(s.role,s.text);captions.push({speaker:s.speaker,text:s.text,role:s.role,key:v.key,seconds:v.seconds,direction:false,sound:""});}
    }
    if(captions.length>40)captions=captions.slice(captions.length-40);
  }
  function speak(item){
    // In-play captions carry `seconds`; retimed cinematic cues carry `voiceSeconds`.
    let length=item.seconds>0?item.seconds:(item.voiceSeconds>0?item.voiceSeconds:0);
    if(length>0&&item.key){emit("voice",{key:item.key,role:item.role,seconds:length});voiceUntil=seconds+length;}
    else voiceUntil=0;
  }
  function hush(){emit("voiceStop",true);voiceUntil=0;}
  function notify(text){notice=text;noticeTime=6;}
  function telemetry(){return core.telemetry();}
  function sceneKnown(id){return !!scenes[id];}
  function beginScene(id){
    if(!sceneKnown(id)||seen.indexOf(id)>=0)return;
    if(sceneId){if(sceneQueue.indexOf(id)<0)sceneQueue.push(id);return;}
    sceneId=id;sceneTime=0;cueIndex=-1;panel="";phase="cinema";caption=null;captionLeft=0;captionTotal=0;resumeQuiet=false;
    captions=[];input={forward:0,strafe:0,turn:0,tilt:0,run:false};hush();emit("unlock",true);
  }
  function finishScene(){
    if(sceneId&&seen.indexOf(sceneId)<0)seen.push(sceneId);
    sceneId="";sceneTime=0;cueIndex=-1;caption=null;captionLeft=0;captionTotal=0;hush();
    phase=telemetry().mode==="ending"?"ending":"play";saveRequest=true;
    if(sceneQueue.length){let next=sceneQueue.shift();beginScene(next);}
    else emit("cameraReset",{yaw:p.yaw,pitch:p.pitch});
  }
  function blocked(x,z){
    let b=deck.bounds,r=deck.radius;
    if(!Number.isFinite(x)||!Number.isFinite(z)||x<b.minX||x>b.maxX||z<b.minZ||z>b.maxZ)return true;
    for(let i=0;i<deck.colliders.length;i++){let o=deck.colliders[i];if(x+r>o.x0&&x-r<o.x1&&z+r>o.z0&&z-r<o.z1)return true;}
    if(door<.9&&z+r>2.59&&z-r<2.87&&Math.abs(x)<.93+r)return true;
    return false;
  }
  function visibleStation(s){
    // Bulkhead occlusion is deliberately independent of the renderer's picking.
    if(door<.9&&s.id!=="door"&&((p.z<2.55&&s.z>2.92)||(p.z>2.92&&s.z<2.55)))return false;
    return true;
  }
  function station(id){for(let i=0;i<deck.stations.length;i++)if(deck.stations[i].id===id)return deck.stations[i];return null;}
  function near(id){let s=station(id);if(!s||!visibleStation(s))return false;let dx=s.x-p.x,dz=s.z-p.z;return dx*dx+dz*dz<6.0;}
  function target(){
    if(phase!=="play"||panel||paused)return null;
    let result=null,best=1e9;
    for(let i=0;i<deck.stations.length;i++){
      let s=deck.stations[i];if(!visibleStation(s))continue;
      let dx=s.x-p.x,dz=s.z-p.z,dist=Math.sqrt(dx*dx+dz*dz);
      if(dist>2.44)continue;
      let angle=Math.atan2(dx,dz),d=Math.atan2(Math.sin(angle-p.yaw),Math.cos(angle-p.yaw));
      let elevation=Math.atan2(s.y-deck.eye,Math.max(.12,dist));
      if(Math.abs(d)>.79||Math.abs(elevation-p.pitch)>.67)continue;
      let score=dist+Math.abs(d)*1.6;if(score<best){best=score;result=s;}
    }
    return result;
  }
  function setInputs(next){
    input={forward:clamp(Number(next.forward)||0,-1,1),strafe:clamp(Number(next.strafe)||0,-1,1),turn:clamp(Number(next.turn)||0,-1,1),tilt:clamp(Number(next.tilt)||0,-1,1),run:!!next.run};
  }
  function setLook(yaw,pitch){if(phase==="play"&&!paused&&!panel&&Number.isFinite(yaw)&&Number.isFinite(pitch)){p.yaw=yaw;p.pitch=clamp(pitch,-1.22,1.22);}}
  function move(dt){
    if(panel)return;
    p.yaw+=input.turn*1.6*dt;p.pitch=clamp(p.pitch+input.tilt*1.2*dt,-1.22,1.22);
    let f=input.forward,s=input.strafe,len=Math.sqrt(f*f+s*s);if(len>1){f/=len;s/=len;}
    let speed=input.run?2.65:1.65;
    let dx=(Math.sin(p.yaw)*f-Math.cos(p.yaw)*s)*speed*dt;
    let dz=(Math.cos(p.yaw)*f+Math.sin(p.yaw)*s)*speed*dt;
    if(!blocked(p.x+dx,p.z))p.x+=dx;
    if(!blocked(p.x,p.z+dz))p.z+=dz;
    if(len>.01){bob+=dt*(input.run?13:9);footTimer-=dt;if(footTimer<=0){emit("sound","footstep");footTimer=input.run?.29:.47;}}
    else footTimer=0;
  }
  function stopRoute(message){route=[];routeId="";routeIndex=0;alignTarget=null;legTime=0;core.command("stop");if(message)navStatus=message;}
  function nextSite(id){if(id){for(let i=0;i<content.sites.length;i++)if(content.sites[i].id===id)return content.sites[i];return null;}return content.sites[telemetry().completed]||null;}
  function plot(id){
    let s=telemetry();if(s.choice||s.job||s.finale){notify("Resolve the current operation before plotting another route.");return;}
    if(s.scrubber||s.leak){notify("Repair the active engineering fault before departing.");return;}
    let site=nextSite(id);if(!site||(!id&&site.optional)){notify("Required survey complete. Return to the radio.");return;}
    if(site.optional&&s.completed<2){notify("No secondary return has been logged yet.");return;}
    route=lsRoute(content,s,site);routeIndex=0;routeId=site.id;alignTarget=null;legTime=0;
    if(!route.length){notify("Route not found. Use manual controls to clear the obstruction.");routeId="";return;}
    navStatus="COURSE PLOTTED / "+site.name;say(content.pilot.plotted);
    emit("sound","switch");
  }
  function pilot(dt){
    let s=telemetry();if(s.choice||s.job||s.mode!=="playing"||s.finale)return;
    if(alignTarget!==null){let difference=delta(alignTarget,s.heading);core.command("turn",clamp(difference,-42*dt,42*dt));if(Math.abs(difference)<1){core.command("turn",difference);alignTarget=null;navStatus="EXPOSURE BEARING LOCKED";}return;}
    if(!routeId)return;
    if(s.threat>83){stopRoute("CONTACT CLOSING / HOLDING SILENCE");say(content.pilot.threat);return;}
    legTime+=dt;
    // Radio traffic once the boat has settled onto the leg: one exchange per destination, ever.
    if(legTime>3.5&&chatterDone.indexOf(routeId)<0&&content.chatter[routeId]&&captions.length===0){
      chatterDone.push(routeId);let lines=content.chatter[routeId];for(let i=0;i<lines.length;i++)say(lines[i]);saveRequest=true;
    }
    while(routeIndex<route.length){let waypoint=route[routeIndex],dx=waypoint.x-s.x,dy=waypoint.y-s.y;if(dx*dx+dy*dy>64)break;routeIndex++;}
    if(routeIndex>=route.length){let site=nextSite(routeId);stopRoute("ON STATION / ALIGN CAMERA BEARING");alignTarget=site.heading;say(content.pilot.arrived);return;}
    let q=route[routeIndex],bearing=Math.atan2(q.x-s.x,s.y-q.y)*180/Math.PI;if(bearing<0)bearing+=360;
    let d=delta(bearing,s.heading);core.command("turn",clamp(d,-42*dt,42*dt));
    let wanted=Math.abs(d)>35?0:cruise;if(s.throttle!==wanted)core.command("throttle",wanted);
  }
  function narrateEnding(id){
    let ending=content.endings[id];if(!ending)return;
    let paragraphs=ending.text.split("\n\n");
    // The three narrative endings are voiced by their cinematics; a systems failure gets its first paragraph read.
    say(paragraphs[0],"LOCAL RECORDER");
  }
  function collectEvents(){
    let sounds=core.drainSounds();for(let i=0;i<sounds.length;i++)emit("sound",sounds[i]);
    let lines=core.drainLines();
    for(let i=0;i<lines.length;i++)if(!sceneId)say(lines[i],"LOCAL RECORDER");
    let s=telemetry();
    if(s.photoCount>lastPhoto){lastPhoto=s.photoCount;if(sceneKnown(s.photo)&&seen.indexOf(s.photo)<0)beginScene(s.photo);}
    if(s.archive&&!lastArchive){lastArchive=true;beginScene("archive");}
    if(lastScrubber&&!s.scrubber&&s.mode==="playing")beginScene("restored");
    lastScrubber=s.scrubber;
    if(s.ending&&s.ending!==lastEnding){lastEnding=s.ending;stopRoute("");panel="";if(sceneKnown(s.ending))beginScene(s.ending);else{phase="ending";captions=[];caption=null;captionLeft=0;narrateEnding(s.ending);}emit("unlock",true);}
    if(core.takeSaveRequest())saveRequest=true;
  }
  function start(difficulty){
    core=createLastSound();core.command("start",difficulty==="story"?"story":"standard");core.command("choose","ready");
    p={x:deck.spawn.x,z:deck.spawn.z,yaw:deck.spawn.yaw,pitch:deck.spawn.pitch};
    phase="play";paused=false;panel="";seen=[];sceneQueue=[];sceneId="";seconds=0;bob=0;
    door=0;doorTarget=0;route=[];routeId="";routeIndex=0;navStatus="NOT PLOTTED";alignTarget=null;legTime=0;chatterDone=[];
    lastPhoto=0;lastArchive=false;lastEnding="";lastScrubber=0;captions=[];caption=null;captionLeft=0;captionTotal=0;voiceUntil=0;events=[];silentArmed=false;
    core.drainLines();core.drainSounds();beginScene("descent");saveRequest=true;emit("sound","start");
  }
  function interact(){
    if(paused||phase!=="play")return false;if(panel){panel="";emit("cameraReset",{yaw:p.yaw,pitch:p.pitch});return true;}
    let s=target();if(!s){notify("Face a labelled station and move within arm's reach.");return false;}
    if(s.id==="door"){
      if(doorTarget>0&&Math.abs(p.z-2.73)<.55){notify("Step away from the bulkhead before closing it.");return false;}
      doorTarget=doorTarget?0:1;emit("sound","door");saveRequest=true;return true;
    }
    panel=s.panel;emit("unlock",true);emit("sound","switch");return true;
  }
  function currentCue(){
    if(!sceneId)return -1;let scene=scenes[sceneId];
    for(let i=scene.cues.length-1;i>=0;i--)if(sceneTime>=scene.cues[i].at&&sceneTime<scene.cues[i].end)return i;
    return -1;
  }
  function command(name,value){
    if(name==="start"){start(value);return true;}
    if(name==="motion"){reduced=!reduced;return true;}
    if(name==="torch"){torch=!torch;emit("sound","switch");return true;}
    if(name==="pause"){
      if(phase==="title"||phase==="ending")return false;
      paused=!paused;input={forward:0,strafe:0,turn:0,tilt:0,run:false};
      if(paused){if(telemetry().mode==="playing")core.command("pause");hush();emit("unlock",true);saveRequest=true;}
      else {
        if(telemetry().mode==="paused")core.command("pause");
        // Resume from the start of the interrupted line rather than mid-word.
        if(sceneId){let i=currentCue();if(i>=0){sceneTime=scenes[sceneId].cues[i].at;cueIndex=i-1;resumeQuiet=true;}}
        else if(caption){captionLeft=captionTotal;if(!caption.direction)speak(caption);}
        emit("cameraReset",{yaw:p.yaw,pitch:p.pitch});
      }
      return true;
    }
    if(name==="skip"){if(sceneId&&!paused)finishScene();return true;}
    if(name==="close"){panel="";return true;}
    if(name==="interact")return interact();
    if(phase!=="play"||paused)return false;
    let s=telemetry();
    let needs={plot:"helm",wreck:"helm",returnRelay:"helm",cruise:"helm",stop:"helm",turn:"helm",throttle:"helm",align:"helm",ping:"helm",decoy:"helm",photo:"camera",album:"camera",frequency:"radio",listen:"radio",final:"radio",isolate:"fuse",reset:"fuse",restoreAux:"fuse",vent:"valve",patch:"seam",pump:"pump",cell:"reserves",oxygen:"reserves",cutBeacon:"ballast"};
    let need=needs[name];if(need&&(panel!==need||!near(need==="fuse"?"fuse":need==="valve"?"valve":need))){notify("Use that control at its physical station.");return false;}
    if(name==="plot")plot();
    else if(name==="wreck")plot("wreck");
    else if(name==="returnRelay")plot("relay");
    else if(name==="cruise"){cruise=cruise===1?2:1;notify(cruise===1?"Quiet cruise selected.":"Full cruise selected. More noise, faster travel.");}
    else if(name==="stop")stopRoute("MANUAL HOLD / PILOT OFF");
    else if(name==="turn"||name==="throttle"){route=[];routeId="";alignTarget=null;legTime=0;navStatus="MANUAL CONTROL";core.command(name,value);}
    else if(name==="align"){stopRoute("ALIGNING EXPOSURE BEARING");let site=nextSite();if(site)alignTarget=site.heading;}
    else if(name==="isolate")core.command("repair",0);
    else if(name==="vent")core.command("repair",1);
    else if(name==="reset")core.command("repair",2);
    else if(name==="restoreAux")core.command("repair",3);
    else if(name==="choose"){
      if(!core.snapshot().choice||panel!=="radio"||!near("radio"))return false;
      if(s.choice==="final"&&value==="silent"){silentArmed=true;core.command("closeChoice");panel="";say(content.pilot.silentArmed);}
      else core.command("choose",value);
    }
    else if(name==="closeChoice"){if(panel!=="radio")return false;core.command("closeChoice");}
    else if(name==="cutBeacon"){
      if(s.completed<6){notify("Ballast interlocked until the required survey is recorded.");return false;}
      core.command("final");core.command("choose","silent");silentArmed=false;
    }
    else if(need)core.command(name,value);
    else return false;
    collectEvents();return true;
  }
  function advanceCaptions(dt){
    captionLeft-=dt;
    if(captionLeft>0)return;
    caption=captions.length?captions.shift():null;
    if(!caption){captionLeft=0;captionTotal=0;voiceUntil=0;return;}
    if(caption.direction){captionTotal=2.9;if(caption.sound)emit("sound",caption.sound);voiceUntil=0;}
    else{captionTotal=caption.seconds>0?caption.seconds+.45:lsSpeechSeconds(caption.text);speak(caption);}
    captionLeft=captionTotal;
  }
  function advance(dt){
    if(!Number.isFinite(dt)||dt<=0||paused)return;dt=Math.min(dt,.1);seconds+=dt;noticeTime=Math.max(0,noticeTime-dt);
    if(phase==="title")return;
    if(doorTarget===0&&door>0&&Math.abs(p.z-2.73)<.55&&Math.abs(p.x)<1.2)doorTarget=1;
    door+=clamp(doorTarget-door,-dt*.72,dt*.72);
    if(sceneId){
      let scene=scenes[sceneId];sceneTime+=dt;
      for(let i=cueIndex+1;i<scene.cues.length;i++)if(sceneTime>=scene.cues[i].at){
        cueIndex=i;let c=scene.cues[i];
        if(c.sound&&!resumeQuiet)emit("sound",c.sound);
        if(c.voiced)speak(c);else voiceUntil=0;
        resumeQuiet=false;
      }
      if(sceneTime>=scene.duration)finishScene();return;
    }
    if(phase==="play"){move(dt);pilot(dt);core.step(dt);collectEvents();}
    if(!sceneId&&(phase==="play"||phase==="ending"))advanceCaptions(dt);
    if(telemetry().mode==="ending"&&!sceneId)phase="ending";
  }
  function camera(){
    if(sceneId)return lsTimelinePose(scenes[sceneId],sceneTime,reduced);
    if(phase==="title"){
      let t=reduced?0:seconds;
      return {position:{x:.62+Math.sin(t*.13)*.08,y:1.65+Math.sin(t*.21)*.025,z:1.75},lookAt:{x:Math.sin(t*.09)*.25,y:1.48,z:-6.8},fov:67};
    }
    let cp=Math.cos(p.pitch),y=deck.eye+(reduced||panel?0:Math.sin(bob)*.014*(Math.abs(input.forward)+Math.abs(input.strafe)>0?1:0));
    return {position:{x:p.x,y:y,z:p.z},lookAt:{x:p.x+Math.sin(p.yaw)*cp*4,y:y+Math.sin(p.pitch)*4,z:p.z+Math.cos(p.yaw)*cp*4},fov:72};
  }
  function view(){
    let s=core.snapshot(),focus=target(),scene=sceneId?scenes[sceneId]:null,sub=caption,progress=0;
    if(scene){
      sub=null;let i=currentCue();
      if(i>=0){let c=scene.cues[i];sub=c;let span=c.voiced?c.voiceSeconds:(c.end-c.at);progress=clamp((sceneTime-c.at)/Math.max(.2,span),0,1);}
    }
    else if(caption&&captionTotal>0)progress=clamp(1-captionLeft/captionTotal,0,1);
    let objective=s.objective;
    if(s.scrubber)objective=s.repairStep===1?"Engineering: turn the bypass valve, now that AUX is isolated.":"Engineering: "+s.repairInstruction.toLowerCase()+" at the fuse box.";
    else if(s.leak)objective="Engineering: seal the starboard seam, then pump out the bilge.";
    else if(silentArmed)objective="Engineering: pull the beacon cutter and release the ballast.";
    else if(s.choice)objective="Control: return to the radio. Vale is waiting for your answer.";
    else if(s.finalReady)objective="Control: choose the final transmission at the radio, or cut the beacon aft.";
    else if(routeId)objective="Pilot active: "+nextSite(routeId).name.toLowerCase()+". You may move around the cabin.";
    else if(s.aligned)objective="Control: walk to the camera and expose the next survey frame.";
    let alarm=!!(s.scrubber||s.leak)||!!(scene&&typeof scene.alarmAt==="number"&&sceneTime>=scene.alarmAt);
    return {core:s,phase:phase,paused:paused,panel:panel,focus:focus?focus.name:"",focusId:focus?focus.id:"",room:p.z>2.9?"ENGINEERING":p.z> -2?"RECORDER BAY":"CONTROL ROOM",objective:objective,
      cinematic:!!scene,sceneId:sceneId,sceneTitle:scene?scene.title:"",sceneTime:sceneTime,sceneDuration:scene?scene.duration:0,
      plate:scene&&scene.plate&&sceneTime>=scene.plateFrom&&sceneTime<scene.plateUntil?scene.plate:"",
      fade:scene?lsTimelineFade(scene,sceneTime):0,alarm:alarm,
      subtitle:sub?sub.text:"",speaker:sub?sub.speaker:"",captionRole:sub?sub.role:"",captionDirection:!!(sub&&sub.direction),captionProgress:progress,
      captionReveal:Math.max(0,100-Math.round(progress*400)),
      speaking:voiceUntil>seconds,notice:noticeTime>0?notice:s.toast,
      navStatus:navStatus,routeActive:!!routeId,cruise:cruise,door:door,torch:torch,reduced:reduced,silentArmed:silentArmed,
      camera:camera(),position:{x:p.x,z:p.z,yaw:p.yaw,pitch:p.pitch},clock:seconds};
  }
  function serialize(){
    return JSON.stringify({schema:2,game:"last-sound-3d",core:core.serialize(),player:p,door:door,doorTarget:doorTarget,
      seen:seen,sceneId:sceneId,sceneTime:sceneTime,sceneQueue:sceneQueue,seconds:seconds,silentArmed:silentArmed,reduced:reduced,torch:torch,chatter:chatterDone});
  }
  function restore(raw){
    try{
      if(typeof raw!=="string"||raw.length>240000)return false;let v=JSON.parse(raw);
      if(v.schema!==2||v.game!=="last-sound-3d"||!v.player||typeof v.core!=="string")return false;
      let np=v.player;for(let k of ["x","z","yaw","pitch"])if(!Number.isFinite(np[k]))return false;
      if(Math.abs(np.yaw)>1e7||Math.abs(np.pitch)>1.23)return false;
      if(!Number.isFinite(v.door)||v.door<0||v.door>1||(v.doorTarget!==0&&v.doorTarget!==1))return false;
      if(!Number.isFinite(v.seconds)||v.seconds<0||v.seconds>86400)return false;
      if(typeof v.sceneId!=="string"||(v.sceneId&&!sceneKnown(v.sceneId))||!Number.isFinite(v.sceneTime)||v.sceneTime<0||(v.sceneId&&v.sceneTime>scenes[v.sceneId].duration))return false;
      if(!Array.isArray(v.seen)||v.seen.length>16||!Array.isArray(v.sceneQueue)||v.sceneQueue.length>16)return false;
      for(let i=0;i<v.seen.length;i++)if(!sceneKnown(v.seen[i]))return false;
      for(let i=0;i<v.sceneQueue.length;i++)if(!sceneKnown(v.sceneQueue[i]))return false;
      if(typeof v.reduced!=="boolean"||typeof v.torch!=="boolean"||typeof v.silentArmed!=="boolean")return false;
      let chatter=v.chatter===undefined?[]:v.chatter;
      if(!Array.isArray(chatter)||chatter.length>8)return false;
      for(let i=0;i<chatter.length;i++)if(!content.chatter[chatter[i]])return false;
      let oldDoor=door;door=v.door;let invalid=blocked(np.x,np.z);door=oldDoor;if(invalid)return false;
      let next=createLastSound();if(!next.restore(v.core))return false;
      core=next;p={x:np.x,z:np.z,yaw:np.yaw,pitch:np.pitch};door=v.door;doorTarget=v.doorTarget;
      seen=v.seen.slice();sceneId=v.sceneId;sceneTime=v.sceneTime;sceneQueue=v.sceneQueue.slice();seconds=v.seconds;chatterDone=chatter.slice();
      silentArmed=v.silentArmed;reduced=v.reduced;torch=v.torch;panel="";paused=true;
      phase=sceneId?"cinema":telemetry().mode==="ending"?"ending":"play";if(phase==="ending")paused=false;
      route=[];routeId="";routeIndex=0;alignTarget=null;legTime=0;navStatus="CHECKPOINT / PILOT DISENGAGED";
      input={forward:0,strafe:0,turn:0,tilt:0,run:false};captions=[];caption=null;captionLeft=0;captionTotal=0;voiceUntil=0;events=[];
      let s=telemetry();lastPhoto=s.photoCount;lastArchive=s.archive;lastEnding=s.ending;lastScrubber=s.scrubber;cueIndex=-1;resumeQuiet=false;
      if(sceneId)for(let i=0;i<scenes[sceneId].cues.length;i++)if(scenes[sceneId].cues[i].at<=sceneTime)cueIndex=i;
      emit("unlock",true);emit("cameraReset",{yaw:p.yaw,pitch:p.pitch});saveRequest=false;return true;
    }catch(e){return false;}
  }
  return {command:command,step:advance,view:view,camera:camera,setLook:setLook,setInputs:setInputs,
    serialize:serialize,restore:restore,telemetry:telemetry,deck:function(){return deck;},scenes:function(){return scenes;},
    blocked:blocked,target:target,drainEvents:function(){let out=events;events=[];return out;},
    takeSaveRequest:function(){let out=saveRequest;saveRequest=false;return out;}};
}

function lsTexture(path){return {"decals/ballast.png":"data:image/png;base64,","decals/camera.png":"data:image/png;base64,","decals/chart.png":"data:image/png;base64,","decals/control.png":"data:image/png;base64,","decals/depth.png":"data:image/png;base64,","decals/engineering.png":"data:image/png;base64,","decals/fuse.png":"data:image/png;base64,","decals/hatch.png":"data:image/png;base64,","decals/heading.png":"data:image/png;base64,","decals/helm.png":"data:image/png;base64,","decals/print.png":"data:image/png;base64,","decals/procedure.png":"data:image/png;base64,","decals/pump.png":"data:image/png;base64,","decals/radio.png":"data:image/png;base64,","decals/recorder.png":"data:image/png;base64,","decals/reserves.png":"data:image/png;base64,","decals/scrubber.png":"data:image/png;base64,","decals/seam.png":"data:image/png;base64,","decals/seventeen.png":"data:image/png;base64,"}[path]||"";}

/* Softn-specific host bridge. The game, route planner, deck and director above
   remain pure JavaScript. Three.js stays in Scene3D on the host; sound goes
   through softn.audio. Voice lines are MP3s baked by tools/bake-voice.mjs. */
let _game=createLastSound3D();
let view=_game.view();
let sceneStatic=[];
let objects=[];
let lights=[];
let sceneFog=lsFog(false);
let sceneCamera=_game.camera();
let muted=false;
let touchMode=false;
let lowQuality=false;
let hasSave=false;
let saveText="";
let saveNotice="";
let sceneReady=false;
let _keys={};
let _cleanup=null;
let _uiTime=0;
let _saveTime=0;
let _lightKey="";
let _ambience=false;
let _lastLocked=false;
let _wasWalk=false;
let _voiceHandle="";
let _voiceSeq=0;
const SAVE_KEY="last-sound-3d:checkpoint:v2";
function resetKeys(){_keys={};}
function refreshView(){
  let next=_game.view();
  if(next.panel!=="recorder")next.core.logs=next.core.logs.slice(-4);
  view=next;
}
function stopVoice(){
  _voiceSeq++;
  if(_voiceHandle){try{softn.audio.stop(_voiceHandle);}catch(e){}_voiceHandle="";}
}
function playVoice(line){
  stopVoice();
  if(muted||!line||!line.key)return;
  let mySeq=_voiceSeq;
  try{
    softn.audio.play("assets/voice/"+line.key+".mp3",{volume:line.role==="operator"?.9:.96},function(r){
      if(!r||!r.played||!r.handle)return;
      // A skipped line can finish opening after the next has started; never let two voices overlap.
      if(mySeq!==_voiceSeq||muted){try{softn.audio.stop(r.handle);}catch(e){}return;}
      _voiceHandle=r.handle;
    });
  }catch(e){}
}
function flushEvents(){
  let events=_game.drainEvents();
  for(let i=0;i<events.length;i++){
    let event=events[i];
    if(event.type==="unlock"){window.__scene3dReleaseLock=true;_lastLocked=false;resetKeys();}
    else if(event.type==="cameraReset"){window.__scene3dYaw=event.value.yaw;window.__scene3dPitch=event.value.pitch;}
    else if(event.type==="voice")playVoice(event.value);
    else if(event.type==="voiceStop")stopVoice();
    else if(event.type==="sound"&&!muted){
      let v=event.value==="footstep"?.16:event.value==="impact"?.36:event.value==="winch"||event.value==="creak"?.5:event.value==="tick"?.3:.42;
      try{softn.audio.play("assets/sfx/"+event.value+".wav",{volume:v});}catch(e){}
    }
  }
}
function ambience(){
  if(muted||_ambience)return;
  try{softn.audio.play("assets/sfx/ambience.wav",{volume:.26,loop:true});_ambience=true;}catch(e){}
}
function saveCheckpoint(){
  if(view.phase==="title"||view.phase==="ending")return;
  let raw=_game.serialize();
  try{localStorage.setItem(SAVE_KEY,raw);if(localStorage.getItem(SAVE_KEY)!==raw)throw new Error("Not retained");hasSave=true;saveNotice="Checkpoint saved in this browser. Export the text before moving to another bundle version.";}
  catch(e){saveNotice="Local storage is unavailable. Export the save text below instead.";}
}
function gameAction(name,value){
  _game.command(name,value);refreshView();flushEvents();
  if(_game.takeSaveRequest())saveCheckpoint();
  if(name==="close"||name==="interact"){if(!view.panel&&!view.cinematic&&!view.paused)window.__scene3dWantLock=true;}
}
function gameStep(dt){
  try{
    let seconds=typeof dt==="number"&&Number.isFinite(dt)?Math.min(.2,Math.max(.001,dt)):.033;
    let walk=view.phase==="play"&&!view.paused&&!view.panel;
    let locked=!!window.__scene3dLocked;
    if(_lastLocked&&!locked&&_wasWalk&&walk&&!touchMode){_game.command("pause");resetKeys();}
    _lastLocked=locked;_wasWalk=walk;
    if(walk&&typeof window.__scene3dYaw==="number")_game.setLook(window.__scene3dYaw,window.__scene3dPitch||0);
    _game.setInputs({forward:(_keys.w?1:0)-(_keys.s?1:0),strafe:(_keys.d?1:0)-(_keys.a?1:0),turn:(_keys.left?1:0)-(_keys.right?1:0),tilt:(_keys.up?1:0)-(_keys.down?1:0),run:!!_keys.shift});
    // Bounded substeps keep door collision and walking stable after a slow frame.
    let left=seconds;while(left>.00001){let step=Math.min(.033,left);_game.step(step);left-=step;}
    sceneCamera=_game.camera();
    if(!walk||_keys.left||_keys.right||_keys.up||_keys.down){
      let dx=sceneCamera.lookAt.x-sceneCamera.position.x,dy=sceneCamera.lookAt.y-sceneCamera.position.y,dz=sceneCamera.lookAt.z-sceneCamera.position.z;
      window.__scene3dYaw=Math.atan2(dx,dz);window.__scene3dPitch=Math.atan2(dy,Math.sqrt(dx*dx+dz*dz));
    }
    _uiTime+=seconds;_saveTime+=seconds;
    if(_uiTime>=.125){
      _uiTime=0;refreshView();let t=_game.telemetry();
      let focus=null;if(view.focusId){let stations=_game.deck().stations;for(let i=0;i<stations.length;i++)if(stations[i].id===view.focusId)focus=stations[i];}
      let showTorch=view.torch&&!view.cinematic&&view.phase!=="title";
      objects=lsDeckDynamic(t,view.door,view.clock,showTorch,focus,{aligned:view.core.aligned,origin:view.phase==="title"||lowQuality?null:sceneCamera.position});
      let alarm=view.alarm;
      let key=String(alarm)+":"+String(showTorch)+(alarm?":"+Math.floor(view.clock*6):"");
      if(key!==_lightKey){_lightKey=key;lights=lsLights(t,showTorch,view.clock,alarm);sceneFog=lsFog(alarm);}
    }
    flushEvents();
    if(_game.takeSaveRequest()||_saveTime>=30){saveCheckpoint();_saveTime=0;}
  }catch(e){saveNotice="Game-loop error: "+String(e);}
}
function startStandard(){gameAction("start","standard");ambience();}
function startStory(){gameAction("start","story");ambience();}
function interact(){gameAction("interact");}
function closePanel(){gameAction("close");resetKeys();window.__scene3dWantLock=true;}
function pauseGame(){if(!view.paused)gameAction("pause");}
function resumeGame(){if(view.paused)gameAction("pause");resetKeys();if(!view.cinematic&&!view.panel)window.__scene3dWantLock=true;ambience();}
function skipScene(){gameAction("skip");}
function toggleTorch(){gameAction("torch");}
function toggleMotion(){gameAction("motion");}
function toggleTouch(){touchMode=!touchMode;resetKeys();}
function toggleQuality(){lowQuality=!lowQuality;_lightKey="";}
function toggleMute(){muted=!muted;try{stopVoice();softn.audio.stopAll();_ambience=false;if(!muted&&view.phase!=="title")ambience();localStorage.setItem("last-sound-3d:muted",muted?"1":"0");}catch(e){}}
function loadCheckpoint(){try{let raw=localStorage.getItem(SAVE_KEY);if(raw&&_game.restore(raw)){refreshView();flushEvents();saveNotice="Checkpoint restored. Resume when ready.";ambience();}else saveNotice="No compatible 3D checkpoint found.";}catch(e){saveNotice="Could not read storage. Use a portable save.";}}
function exportSave(){saveText=_game.serialize();saveNotice="Copy this text somewhere safe. 2D and 3D saves use different schemas.";}
function importSave(){if(_game.restore(saveText)){refreshView();flushEvents();saveCheckpoint();saveNotice="Portable save restored, paused. "+saveNotice;}else saveNotice="Save rejected. Your current game was not changed.";}
function plotNext(){gameAction("plot");}
function plotWreck(){gameAction("wreck");}
function returnRelay(){gameAction("returnRelay");}
function toggleCruise(){gameAction("cruise");}
function stopBoat(){gameAction("stop");}
function port(){gameAction("turn",-15);}
function starboard(){gameAction("turn",15);}
function ahead(){gameAction("throttle",1);}
function align(){gameAction("align");}
function ping(){gameAction("ping");}
function decoy(){gameAction("decoy");}
function expose(){gameAction("photo");}
function olderFrame(){gameAction("album",-1);}
function newerFrame(){gameAction("album",1);}
function opsFrequency(){gameAction("frequency",61.2);}
function archiveFrequency(){gameAction("frequency",74.6);}
function openFrequency(){gameAction("frequency",83.5);}
function listen(){gameAction("listen");}
function finalTransmission(){gameAction("final");}
function isolate(){gameAction("isolate");}
function vent(){gameAction("vent");}
function resetContactor(){gameAction("reset");}
function restoreAux(){gameAction("restoreAux");}
function patch(){gameAction("patch");}
function pump(){gameAction("pump");}
function useCell(){gameAction("cell");}
function useOxygen(){gameAction("oxygen");}
function cutBeacon(){gameAction("cutBeacon");}
function chooseFirst(){if(view.core.choice)gameAction("choose",view.core.choice.options[0].id);}
function chooseSecond(){if(view.core.choice&&view.core.choice.options[1])gameAction("choose",view.core.choice.options[1].id);}
function chooseThird(){if(view.core.choice&&view.core.choice.options[2])gameAction("choose",view.core.choice.options[2].id);}
function closeChoice(){gameAction("closeChoice");}
function padPress(dir){if(dir==="up")_keys.w=true;else if(dir==="down")_keys.s=true;else if(dir==="left")_keys.a=true;else if(dir==="right")_keys.d=true;}
function padRelease(dir){if(dir==="up")_keys.w=false;else if(dir==="down")_keys.s=false;else if(dir==="left")_keys.a=false;else if(dir==="right")_keys.d=false;}
function lookPress(dir){_keys[dir]=true;}
function lookRelease(dir){_keys[dir]=false;}
function turnLeft(){_game.setLook(view.position.yaw+.28,view.position.pitch);window.__scene3dYaw=view.position.yaw+.28;refreshView();}
function turnRight(){_game.setLook(view.position.yaw-.28,view.position.pitch);window.__scene3dYaw=view.position.yaw-.28;refreshView();}
function lookUp(){_game.setLook(view.position.yaw,view.position.pitch+.19);window.__scene3dPitch=Math.min(1.22,view.position.pitch+.19);refreshView();}
function lookDown(){_game.setLook(view.position.yaw,view.position.pitch-.19);window.__scene3dPitch=Math.max(-1.22,view.position.pitch-.19);refreshView();}
function onSceneClick(hit){if(view.phase==="play"&&!view.panel&&!view.paused&&hit&&hit.locked)interact();}
function onSceneReady(){sceneReady=true;}
function _init(){
  if(_cleanup)_cleanup();
  sceneStatic=lsStaticDeck(lsTexture);
  objects=lsDeckDynamic(_game.telemetry(),0,0,false,null,{});lights=lsLights(_game.telemetry(),false,0,false);sceneFog=lsFog(false);
  window.__scene3dYaw=Math.PI;window.__scene3dPitch=-.02;window.__scene3dRawInput=false;
  try{hasSave=!!localStorage.getItem(SAVE_KEY);muted=localStorage.getItem("last-sound-3d:muted")==="1";}catch(e){}
  function control(e){let t=String(e.targetTag||(e.target&&e.target.tagName)||"").toLowerCase();return t==="input"||t==="textarea"||t==="select"||e.targetEditable;}
  function key(e){return String(e.key||"").toLowerCase();}
  function keyDown(e){
    if(control(e))return;let k=key(e);
    if(k==="w"||k==="a"||k==="s"||k==="d"||k==="shift")_keys[k]=true;
    if(k==="arrowleft")_keys.left=true;if(k==="arrowright")_keys.right=true;if(k==="arrowup")_keys.up=true;if(k==="arrowdown")_keys.down=true;
    if(k.indexOf("arrow")===0||k===" "){if(e.preventDefault)e.preventDefault();}
    if(e.repeat)return;
    if(k==="e")interact();else if(k==="f")toggleTorch();else if(k==="m")toggleMute();
    else if(k==="escape"){if(view.panel)closePanel();else if(view.paused)resumeGame();else pauseGame();}
    else if(k===" "&&view.cinematic)skipScene();
    else if(k==="1"&&view.panel==="radio")chooseFirst();else if(k==="2"&&view.panel==="radio")chooseSecond();else if(k==="3"&&view.panel==="radio")chooseThird();
  }
  function keyUp(e){let k=key(e);_keys[k]=false;if(k==="arrowleft")_keys.left=false;if(k==="arrowright")_keys.right=false;if(k==="arrowup")_keys.up=false;if(k==="arrowdown")_keys.down=false;}
  function blur(){resetKeys();pauseGame();}
  function touch(){touchMode=true;}
  window.addEventListener("keydown",keyDown,true);window.addEventListener("keyup",keyUp,true);window.addEventListener("blur",blur);window.addEventListener("touchstart",touch);
  _cleanup=function(){window.removeEventListener("keydown",keyDown,true);window.removeEventListener("keyup",keyUp,true);window.removeEventListener("blur",blur);window.removeEventListener("touchstart",touch);resetKeys();stopVoice();try{softn.audio.stopAll();}catch(e){}};
}
