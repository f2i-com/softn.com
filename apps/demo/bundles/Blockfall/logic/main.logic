// Blockfall — falling tetrominoes on a 10×20 well, drawn by PixelGrid.
// Seven pieces with proper wall kicks, a ghost piece, hold, next-three
// preview, soft and hard drops, and levels that speed up as lines clear.

let COLS = 10
let ROWS = 20
let TICK_MS = 33

// Synced to the UI.
let gridItems = []
let nextItems = []
let holdItems = []
let score = 0
let lines = 0
let level = 1
let best = 0
let running = false
let over = false
let paused = false
let overlayText = "Press Start"
let cellPx = 24

// VM-owned.
let well = []            // ROWS*COLS, 0 = empty, else piece index + 1
let cur = null           // { kind, rot, x, y }
let queue = []
let held = -1
let holdUsed = false
let dropTimer = 0
let lockTimer = 0
let rngSeed = 1
let bag = []
let clearing = []        // rows mid-flash
let clearTicks = 0
let softDrop = false
let lastMove = 0

let COLORS = ["#22d3ee", "#facc15", "#a855f7", "#4ade80", "#f87171", "#60a5fa", "#fb923c"]
// Each piece: four rotations, as [x, y] cells.
let SHAPES = [
  [[[0, 1], [1, 1], [2, 1], [3, 1]], [[2, 0], [2, 1], [2, 2], [2, 3]], [[0, 2], [1, 2], [2, 2], [3, 2]], [[1, 0], [1, 1], [1, 2], [1, 3]]],
  [[[1, 0], [2, 0], [1, 1], [2, 1]], [[1, 0], [2, 0], [1, 1], [2, 1]], [[1, 0], [2, 0], [1, 1], [2, 1]], [[1, 0], [2, 0], [1, 1], [2, 1]]],
  [[[1, 0], [0, 1], [1, 1], [2, 1]], [[1, 0], [1, 1], [2, 1], [1, 2]], [[0, 1], [1, 1], [2, 1], [1, 2]], [[1, 0], [0, 1], [1, 1], [1, 2]]],
  [[[1, 0], [2, 0], [0, 1], [1, 1]], [[1, 0], [1, 1], [2, 1], [2, 2]], [[1, 1], [2, 1], [0, 2], [1, 2]], [[0, 0], [0, 1], [1, 1], [1, 2]]],
  [[[0, 0], [1, 0], [1, 1], [2, 1]], [[2, 0], [1, 1], [2, 1], [1, 2]], [[0, 1], [1, 1], [1, 2], [2, 2]], [[1, 0], [0, 1], [1, 1], [0, 2]]],
  [[[0, 0], [0, 1], [1, 1], [2, 1]], [[1, 0], [2, 0], [1, 1], [1, 2]], [[0, 1], [1, 1], [2, 1], [2, 2]], [[1, 0], [1, 1], [0, 2], [1, 2]]],
  [[[2, 0], [0, 1], [1, 1], [2, 1]], [[1, 0], [1, 1], [1, 2], [2, 2]], [[0, 1], [1, 1], [2, 1], [0, 2]], [[0, 0], [1, 0], [1, 1], [1, 2]]]
]
// Wall kicks tried in order when a rotation collides.
let KICKS = [[0, 0], [-1, 0], [1, 0], [0, -1], [-2, 0], [2, 0], [0, -2]]

let muted = false
let hardDropped = false
let newBest = false
// When the last game ended: Space or Enter still being hammered at that
// moment must not start the next game before the score has been seen.
let overAt = 0

function play(name, volume) {
  if (muted) { return }
  softn.audio.play("assets/sfx/" + name + ".wav", { volume: volume })
}

function toggleMute() {
  muted = !muted
  try { localStorage.setItem("blockfall:muted", muted ? "1" : "0") } catch (err) {}
}

// Runs between games and while paused, when the game loop is stopped.
function idleStep() {
  let act = window.__bfAct
  if (act === "") { return }
  window.__bfAct = ""
  if (act === "mute") { toggleMute() }
  else if (act === "start" || (act === "hard" && !running)) {
    if (over && Date.now() - overAt < 900) { return }
    startGame()
  }
  else if (act === "pause" && running && paused) { togglePause() }
}

function myRand() {
  rngSeed = (rngSeed * 48271) % 2147483647
  return rngSeed / 2147483647
}

function isUiControl(e) {
  let tag = e.targetTag || ""
  return tag === "input" || tag === "textarea" || tag === "select"
}

function _init() {
  if (window.__bfCleanup) { window.__bfCleanup() }
  rngSeed = (Date.now() % 100000) + 5
  window.__bfKeys = { left: false, right: false, down: false }
  window.__bfAct = ""
  try { best = parseInt(localStorage.getItem("blockfall:best") || "0") || 0 } catch (err) { best = 0 }
  try { muted = localStorage.getItem("blockfall:muted") === "1" } catch (err) { muted = false }
  function onKeyDown(e) {
    if (isUiControl(e)) { return }
    let key = e.key || ""
    let k = window.__bfKeys
    if (key === "ArrowLeft" || key === "a" || key === "A") { if (!e.repeat) { window.__bfAct = "left" }; k.left = true; e.preventDefault() }
    else if (key === "ArrowRight" || key === "d" || key === "D") { if (!e.repeat) { window.__bfAct = "right" }; k.right = true; e.preventDefault() }
    else if (key === "ArrowDown" || key === "s" || key === "S") { k.down = true; e.preventDefault() }
    else if (key === "ArrowUp" || key === "x" || key === "X" || key === "w" || key === "W") { if (!e.repeat) { window.__bfAct = "cw" }; e.preventDefault() }
    else if (key === "z" || key === "Z" || key === "Control") { if (!e.repeat) { window.__bfAct = "ccw" } }
    else if (key === " ") { if (!e.repeat) { window.__bfAct = "hard" }; e.preventDefault() }
    else if (key === "c" || key === "C" || key === "Shift") { if (!e.repeat) { window.__bfAct = "hold" } }
    else if (key === "p" || key === "P" || key === "Escape") { if (!e.repeat) { window.__bfAct = "pause" } }
    else if (key === "Enter") { window.__bfAct = "start" }
    else if (key === "m" || key === "M") { if (!e.repeat) { window.__bfAct = "mute" } }
  }
  function onKeyUp(e) {
    let key = e.key || ""
    let k = window.__bfKeys
    if (key === "ArrowLeft" || key === "a" || key === "A") { k.left = false }
    else if (key === "ArrowRight" || key === "d" || key === "D") { k.right = false }
    else if (key === "ArrowDown" || key === "s" || key === "S") { k.down = false }
  }
  function onBlur() {
    window.__bfKeys = { left: false, right: false, down: false }
    // Losing the window mid-game is a pause, not a lost piece.
    if (running && !paused && !over) { togglePause() }
  }
  window.addEventListener("keydown", onKeyDown, true)
  window.addEventListener("keyup", onKeyUp, true)
  window.addEventListener("blur", onBlur)
  window.__bfCleanup = function () {
    window.removeEventListener("keydown", onKeyDown, true)
    window.removeEventListener("keyup", onKeyUp, true)
    window.removeEventListener("blur", onBlur)
  }
  resetWell()
  render()
}

function resetWell() {
  well = []
  let i = 0
  while (i < ROWS * COLS) { well.push(0); i = i + 1 }
  queue = []
  bag = []
  held = -1
  holdUsed = false
  cur = null
  clearing = []
  clearTicks = 0
}

function startGame() {
  // A restart mid-game still counts the score it abandons.
  commitBest()
  resetWell()
  score = 0
  lines = 0
  level = 1
  over = false
  paused = false
  newBest = false
  overlayText = ""
  running = true
  spawn()
  render()
}

function commitBest() {
  if (score > best) {
    best = score
    try { localStorage.setItem("blockfall:best", String(best)) } catch (err) {}
  }
}

function endGame() {
  over = true
  running = false
  paused = false
  overAt = Date.now()
  newBest = score > best && score > 0
  commitBest()
  overlayText = newBest ? ("New best · " + score) : ("Game over · " + score)
  play("over", 0.5)
}

function togglePause() {
  if (!running || over) { return }
  paused = !paused
  overlayText = paused ? "Paused" : ""
}

function nextKind() {
  if (bag.length === 0) {
    let pool = [0, 1, 2, 3, 4, 5, 6]
    while (pool.length > 0) {
      let i = Math.floor(myRand() * pool.length)
      bag.push(pool[i])
      pool = pool.slice(0, i).concat(pool.slice(i + 1))
    }
  }
  let k = bag[0]
  bag = bag.slice(1)
  return k
}

function spawn() {
  while (queue.length < 4) { queue.push(nextKind()) }
  let kind = queue[0]
  queue = queue.slice(1)
  while (queue.length < 3) { queue.push(nextKind()) }
  holdUsed = false
  placePiece(kind)
}

// Puts a piece at the top of the well — from the queue or out of the hold
// box. A piece that overlaps the stack the moment it appears is the end.
function placePiece(kind) {
  cur = { kind: kind, rot: 0, x: 3, y: kind === 0 ? -1 : 0 }
  dropTimer = 0
  lockTimer = 0
  if (collides(cur.kind, cur.rot, cur.x, cur.y)) {
    endGame()
  }
}

function collides(kind, rot, x, y) {
  let cells = SHAPES[kind][rot]
  let i = 0
  while (i < 4) {
    let cx = x + cells[i][0]
    let cy = y + cells[i][1]
    if (cx < 0 || cx >= COLS || cy >= ROWS) { return true }
    if (cy >= 0 && well[cy * COLS + cx] !== 0) { return true }
    i = i + 1
  }
  return false
}

function tryMove(dx, dy) {
  if (!cur) { return false }
  if (collides(cur.kind, cur.rot, cur.x + dx, cur.y + dy)) { return false }
  cur.x = cur.x + dx
  cur.y = cur.y + dy
  return true
}

function rotate(dir) {
  if (!cur || cur.kind === 1) { return }
  let rot = (cur.rot + dir + 4) % 4
  let i = 0
  while (i < KICKS.length) {
    let kx = KICKS[i][0]
    let ky = KICKS[i][1]
    if (!collides(cur.kind, rot, cur.x + kx, cur.y + ky)) {
      cur.rot = rot
      cur.x = cur.x + kx
      cur.y = cur.y + ky
      lockTimer = 0
      return
    }
    i = i + 1
  }
}

function ghostY() {
  let y = cur.y
  while (!collides(cur.kind, cur.rot, cur.x, y + 1)) { y = y + 1 }
  return y
}

function hardDrop() {
  if (!cur) { return }
  let gy = ghostY()
  score = score + (gy - cur.y) * 2
  cur.y = gy
  hardDropped = true
  play("drop", 0.4)
  lockPiece()
}

function hold() {
  if (!cur || holdUsed || over) { return }
  let k = cur.kind
  if (held < 0) {
    held = k
    spawn()
  } else {
    let h = held
    held = k
    // The swapped-in piece gets the same overlap check as a fresh spawn;
    // it used to be placed blind, straight through a stack at the top.
    placePiece(h)
  }
  holdUsed = true
}

function lockPiece() {
  let cells = SHAPES[cur.kind][cur.rot]
  let above = false
  let i = 0
  while (i < 4) {
    let cx = cur.x + cells[i][0]
    let cy = cur.y + cells[i][1]
    if (cy >= 0) { well[cy * COLS + cx] = cur.kind + 1 } else { above = true }
    i = i + 1
  }
  cur = null
  if (above) {
    // Part of the piece settled above the well: the stack has reached the
    // top. Those cells used to vanish silently, leaving a three-cell piece.
    hardDropped = false
    endGame()
    return
  }
  // Full rows flash before they fall.
  let full = []
  let r = 0
  while (r < ROWS) {
    let c = 0
    let all = true
    while (c < COLS) { if (well[r * COLS + c] === 0) { all = false }; c = c + 1 }
    if (all) { full.push(r) }
    r = r + 1
  }
  if (full.length > 0) {
    clearing = full
    clearTicks = 8
    play("clear", full.length === 4 ? 0.6 : 0.45)
  } else {
    if (!hardDropped) { play("lock", 0.4) }
    spawn()
  }
  hardDropped = false
}

function finishClear() {
  let n = clearing.length
  let kept = []
  let r = 0
  while (r < ROWS) {
    if (clearing.indexOf(r) < 0) {
      let c = 0
      while (c < COLS) { kept.push(well[r * COLS + c]); c = c + 1 }
    }
    r = r + 1
  }
  let fresh = []
  let i = 0
  while (i < n * COLS) { fresh.push(0); i = i + 1 }
  well = fresh.concat(kept)
  clearing = []
  let table = [0, 100, 300, 500, 800]
  score = score + table[n] * level
  lines = lines + n
  let before = level
  level = 1 + Math.floor(lines / 10)
  if (level > before) { play("level", 0.5) }
  spawn()
}

function dropInterval() {
  let ms = 800 - (level - 1) * 70
  return ms < 90 ? 90 : ms
}

function gameStep() {
  if (!running || paused || over) { return }
  if (clearTicks > 0) {
    // Rows are flashing. Pause and mute act at once; a hard drop pressed now
    // is thrown away rather than slamming down a piece nobody has seen yet.
    // Anything else stays buffered for the next piece.
    let flashAct = window.__bfAct
    if (flashAct === "pause") { window.__bfAct = ""; togglePause(); render(); return }
    if (flashAct === "mute") { window.__bfAct = ""; toggleMute() }
    if (flashAct === "hard") { window.__bfAct = "" }
    clearTicks = clearTicks - 1
    if (clearTicks === 0) { finishClear() }
    render()
    return
  }
  if (!cur) { return }
  let act = window.__bfAct
  window.__bfAct = ""
  let k = window.__bfKeys
  if (act === "left") { tryMove(-1, 0); lastMove = 0 }
  else if (act === "right") { tryMove(1, 0); lastMove = 0 }
  else if (act === "cw") { rotate(1) }
  else if (act === "ccw") { rotate(-1) }
  else if (act === "hard") { hardDrop(); render(); return }
  else if (act === "hold") { hold() }
  else if (act === "pause") { togglePause(); render(); return }
  else if (act === "mute") { toggleMute() }
  // Held keys auto-repeat after a short delay.
  if (k.left || k.right) {
    lastMove = lastMove + 1
    if (lastMove > 6 && lastMove % 2 === 0) { tryMove(k.left ? -1 : 1, 0) }
  } else { lastMove = 0 }

  dropTimer = dropTimer + TICK_MS * (k.down ? 8 : 1)
  if (dropTimer >= dropInterval()) {
    dropTimer = 0
    if (tryMove(0, 1)) {
      if (k.down) { score = score + 1 }
    }
  }
  if (cur && collides(cur.kind, cur.rot, cur.x, cur.y + 1)) {
    lockTimer = lockTimer + TICK_MS
    if (lockTimer >= 420) { lockPiece() }
  } else {
    lockTimer = 0
  }
  render()
}

function shade(hex, f) {
  let r = Math.round(parseInt(hex.slice(1, 3), 16) * f)
  let g = Math.round(parseInt(hex.slice(3, 5), 16) * f)
  let b = Math.round(parseInt(hex.slice(5, 7), 16) * f)
  return "rgb(" + Math.min(255, r) + "," + Math.min(255, g) + "," + Math.min(255, b) + ")"
}

function render() {
  let items = []
  let r = 0
  while (r < ROWS) {
    let flash = clearing.indexOf(r) >= 0
    let c = 0
    while (c < COLS) {
      let v = well[r * COLS + c]
      if (v !== 0) {
        items.push({ x: c, y: r, color: flash ? (clearTicks % 2 === 0 ? "#ffffff" : COLORS[v - 1]) : COLORS[v - 1], borderRadius: "3px" })
      }
      c = c + 1
    }
    r = r + 1
  }
  if (cur) {
    let cells = SHAPES[cur.kind][cur.rot]
    let gy = ghostY()
    let i = 0
    while (i < 4) {
      let gx = cur.x + cells[i][0]
      let gyy = gy + cells[i][1]
      if (gyy >= 0 && gy !== cur.y) { items.push({ x: gx, y: gyy, color: shade(COLORS[cur.kind], 0.28), borderRadius: "3px" }) }
      i = i + 1
    }
    i = 0
    while (i < 4) {
      let cx = cur.x + cells[i][0]
      let cy = cur.y + cells[i][1]
      if (cy >= 0) { items.push({ x: cx, y: cy, color: COLORS[cur.kind], borderRadius: "3px" }) }
      i = i + 1
    }
  }
  gridItems = items
  // Previews: three next pieces stacked in a 4-wide strip, and the held one.
  let nx = []
  let q = 0
  while (q < queue.length && q < 3) {
    let cells = SHAPES[queue[q]][0]
    let i = 0
    while (i < 4) { nx.push({ x: cells[i][0], y: cells[i][1] + q * 3, color: COLORS[queue[q]], borderRadius: "2px" }); i = i + 1 }
    q = q + 1
  }
  nextItems = nx
  let hx = []
  if (held >= 0) {
    let cells = SHAPES[held][0]
    let i = 0
    while (i < 4) { hx.push({ x: cells[i][0], y: cells[i][1], color: holdUsed ? shade(COLORS[held], 0.45) : COLORS[held], borderRadius: "2px" }); i = i + 1 }
  }
  holdItems = hx
}

function padPress(dir) {
  let k = window.__bfKeys
  if (dir === "left") { window.__bfAct = "left"; k.left = true }
  else if (dir === "right") { window.__bfAct = "right"; k.right = true }
  else if (dir === "down") { k.down = true }
  else if (dir === "up") { window.__bfAct = "cw" }
}
function padRelease(dir) {
  let k = window.__bfKeys
  if (dir === "left") { k.left = false }
  else if (dir === "right") { k.right = false }
  else if (dir === "down") { k.down = false }
}
function touchRotate() { window.__bfAct = "cw" }
function touchHard() { window.__bfAct = "hard" }
function touchHold() { window.__bfAct = "hold" }
