let simSpeed = 1;
let simTick = 0;
let dayCount = 1;
let season = "Spring";
let ecosystemStatus = "Dynamic Equilibrium";
let statusColor = "#22c55e";

// Selected Entity for Inspector
let selectedId = "";
let selectedEntity = null;
let inspectorOpen = false;

// Camera State
let cameraMode = "overview"; // "overview", "lake", "forest", "meadow", "topdown", "follow", "cinematic"
let cameraPos = { x: 0, y: 38.0, z: 42.0 };
let cameraLookAt = { x: 0, y: 0.5, z: 0 };
let cameraFov = 48;
let cinematicAngle = 0.0;

// Collections
let rabbits = [];
let foxes = [];
let grassList = [];
let particlePuffs = [];

// Statistics & Trends
let rabbitCount = 0;
let foxCount = 0;
let grassCount = 0;
let totalPreyBorn = 0;
let totalPredBorn = 0;
let totalHunts = 0;
let maxGeneration = 1;

// Pre-computed visual sparkline bars (18 columns)
let sparkPreyBars = [32, 35, 40, 38, 42, 45, 41, 37, 34, 38, 42, 44, 40, 38, 36, 39, 41, 43];
let sparkFoxBars = [20, 22, 25, 28, 30, 27, 24, 21, 18, 22, 26, 28, 25, 24, 22, 25, 27, 26];
let sparkGrassBars = [65, 62, 58, 55, 52, 56, 60, 64, 67, 63, 59, 56, 58, 62, 65, 68, 70, 72];

// Dynamic Scene collections
let objects = [];
let lights = [];

// Grand Open-World Bounds: 70.0 x 70.0 Floating Biome Island (-32.5 to +32.5)
const BOUNDS = 32.5;

// Central Serene Oasis Lake / Watering Hole (Open circular pond - easy 360° shoreline access)
const LAKE_X = 2.0;
const LAKE_Z = -1.5;
const LAKE_RADIUS = 6.8;

function isInsideLake(x, z) {
  return Math.hypot(x - LAKE_X, z - LAKE_Z) < LAKE_RADIUS;
}

function isNearLakeShore(x, z) {
  let d = Math.hypot(x - LAKE_X, z - LAKE_Z);
  return d >= LAKE_RADIUS && d < LAKE_RADIUS + 2.8;
}

// Forest cover detection (Refuges where rabbits have high concealment)
function hasForestCover(x, z) {
  // Alpine Pine Ridge in North-West
  let nwPineRidge = x < -10.0 && z < -8.0;
  // Deciduous Woodland in South-East
  let seWoodland = x > 10.0 && z > 8.0;
  // Rocky Crags in South-West
  let swCrags = x < -12.0 && z > 10.0;
  return nwPineRidge || seWoodland || swCrags;
}

let nextEntityId = 1;
function genId(prefix) {
  let id = prefix + "-" + nextEntityId;
  nextEntityId = nextEntityId + 1;
  return id;
}

// Angle interpolation helper for smooth turning
function lerpAngle(cur, target, t) {
  let diff = target - cur;
  while (diff < -Math.PI) diff = diff + Math.PI * 2;
  while (diff > Math.PI) diff = diff - Math.PI * 2;
  return cur + diff * t;
}

// Distance helper
function dist(x1, z1, x2, z2) {
  return Math.hypot(x1 - x2, z1 - z2);
}

// Build 3D Static Scenery (Expanded 70x70 Floating Island with Micro-Biomes)
function buildStaticMeadow() {
  let list = [];

  // 1. Floating Island Terrain Base (70 x 70 Units)
  // Lush Meadow Turf Deck
  list.push({
    id: "meadow-turf",
    type: "box",
    width: 70.0,
    height: 0.8,
    depth: 70.0,
    position: { x: 0, y: 0.4, z: 0 },
    color: "#15803d",
    receiveShadow: true,
    roughness: 0.9
  });
  // Rich Soil Strata
  list.push({
    id: "meadow-earth",
    type: "box",
    width: 69.2,
    height: 2.0,
    depth: 69.2,
    position: { x: 0, y: -1.0, z: 0 },
    color: "#78350f",
    roughness: 0.95
  });
  // Slate Bedrock Cliffs
  list.push({
    id: "meadow-bedrock",
    type: "box",
    width: 68.0,
    height: 4.5,
    depth: 68.0,
    position: { x: 0, y: -4.2, z: 0 },
    color: "#334155",
    roughness: 0.8
  });

  // 2. Central Oasis Lake / Watering Hole
  // Shoreline Sand & Pebble Ring
  list.push({
    id: "lake-shore",
    type: "cylinder",
    radius: LAKE_RADIUS + 1.4,
    height: 0.05,
    position: { x: LAKE_X, y: 0.805, z: LAKE_Z },
    color: "#d97706",
    roughness: 0.95
  });
  // Azure Lake Water
  list.push({
    id: "lake-water",
    type: "cylinder",
    radius: LAKE_RADIUS,
    height: 0.08,
    position: { x: LAKE_X, y: 0.81, z: LAKE_Z },
    color: "#0284c7",
    opacity: 0.88,
    metalness: 0.35,
    roughness: 0.1
  });

  // Floating Water Lilies & Lotus Blossoms
  let lilypads = [
    { x: LAKE_X - 2.8, z: LAKE_Z - 2.0 },
    { x: LAKE_X + 3.2, z: LAKE_Z + 1.8 },
    { x: LAKE_X - 1.5, z: LAKE_Z + 3.2 },
    { x: LAKE_X + 2.5, z: LAKE_Z - 3.0 },
    { x: LAKE_X - 3.5, z: LAKE_Z + 1.2 },
    { x: LAKE_X + 1.2, z: LAKE_Z + 3.8 }
  ];
  for (let l = 0; l < lilypads.length; l = l + 1) {
    list.push({
      id: "lilypad-" + l,
      type: "cylinder",
      radius: 0.45,
      height: 0.04,
      position: { x: lilypads[l].x, y: 0.86, z: lilypads[l].z },
      color: "#22c55e"
    });
    list.push({
      id: "lilypad-flower-" + l,
      type: "sphere",
      radius: 0.12,
      position: { x: lilypads[l].x, y: 0.90, z: lilypads[l].z },
      color: (l % 2 === 0) ? "#ffffff" : "#f472b6"
    });
  }

  // 3. Sandy Winding Nature Trails across the 70x70 Reserve
  let pathStrips = [
    { x: -10.0, z: 2.0, w: 1.6, d: 24.0, rot: 0.35 },
    { x: 12.0, z: 6.0, w: 1.6, d: 26.0, rot: -0.42 },
    { x: -4.0, z: -14.0, w: 1.6, d: 20.0, rot: 0.75 },
    { x: 14.0, z: -12.0, w: 1.6, d: 22.0, rot: -0.3 }
  ];
  for (let p = 0; p < pathStrips.length; p = p + 1) {
    list.push({
      id: "trail-" + p,
      type: "box",
      width: pathStrips[p].w,
      height: 0.03,
      depth: pathStrips[p].d,
      position: { x: pathStrips[p].x, y: 0.805, z: pathStrips[p].z },
      rotation: { x: 0, y: pathStrips[p].rot, z: 0 },
      color: "#b45309",
      roughness: 0.95
    });
  }

  // 4. Diverse Natural Forests & Tree Groves (28 Natural Trees across the 70x70 biome)
  let treeList = [
    // North-West Alpine Pine Ridge
    { x: -24.0, z: -22.0, type: "pine", scale: 1.4 },
    { x: -18.5, z: -25.0, type: "pine", scale: 1.5 },
    { x: -26.0, z: -16.0, type: "pine", scale: 1.3 },
    { x: -17.0, z: -15.5, type: "pine", scale: 1.4 },
    { x: -12.0, z: -22.0, type: "pine", scale: 1.2 },
    { x: -21.0, z: -10.5, type: "pine", scale: 1.3 },
    { x: -13.5, z: -11.0, type: "pine", scale: 1.1 },

    // South-East Deciduous Woodland (Oak & Golden Birch)
    { x: 20.0, z: 21.0, type: "oak", scale: 1.4 },
    { x: 25.5, z: 17.5, type: "oak", scale: 1.3 },
    { x: 18.0, z: 26.5, type: "birch", scale: 1.5 },
    { x: 13.5, z: 21.0, type: "oak", scale: 1.2 },
    { x: 23.0, z: 12.0, type: "birch", scale: 1.2 },
    { x: 16.0, z: 15.0, type: "oak", scale: 1.3 },

    // Lakeside Weeping Willows
    { x: LAKE_X - 8.0, z: LAKE_Z - 1.5, type: "willow", scale: 1.35 },
    { x: LAKE_X + 7.8, z: LAKE_Z + 2.0, type: "willow", scale: 1.3 },
    { x: LAKE_X - 2.0, z: LAKE_Z - 8.2, type: "willow", scale: 1.25 },

    // North-East Flower Meadow Trees
    { x: 18.0, z: -20.0, type: "oak", scale: 1.2 },
    { x: 24.0, z: -15.0, type: "birch", scale: 1.3 },
    { x: 12.0, z: -24.0, type: "oak", scale: 1.1 },

    // South-West Rocky Crag Pines
    { x: -20.0, z: 18.0, type: "pine", scale: 1.2 },
    { x: -25.0, z: 22.0, type: "pine", scale: 1.4 },
    { x: -15.0, z: 24.0, type: "pine", scale: 1.1 },

    // Perimeter Horizon Trees
    { x: -29.0, z: 0, type: "pine", scale: 1.4 },
    { x: 29.0, z: -8.0, type: "pine", scale: 1.4 },
    { x: 0, z: 29.0, type: "oak", scale: 1.3 },
    { x: 0, z: -29.0, type: "pine", scale: 1.4 },
    { x: -27.0, z: 26.0, type: "pine", scale: 1.3 },
    { x: 27.0, z: -26.0, type: "pine", scale: 1.3 }
  ];

  for (let t = 0; t < treeList.length; t = t + 1) {
    let tr = treeList[t];
    // Trunk
    list.push({
      id: "tree-trunk-" + t,
      type: "cylinder",
      radius: 0.28 * tr.scale,
      height: 2.2 * tr.scale,
      position: { x: tr.x, y: 0.8 + (2.2 * tr.scale) / 2, z: tr.z },
      color: tr.type === "birch" ? "#f1f5f9" : "#5c3a21"
    });
    if (tr.type === "pine") {
      list.push({
        id: "tree-cone-1-" + t,
        type: "cone",
        radius: 1.5 * tr.scale,
        height: 2.2 * tr.scale,
        position: { x: tr.x, y: 0.8 + 2.0 * tr.scale, z: tr.z },
        color: "#14532d",
        castShadow: true
      });
      list.push({
        id: "tree-cone-2-" + t,
        type: "cone",
        radius: 1.1 * tr.scale,
        height: 2.0 * tr.scale,
        position: { x: tr.x, y: 0.8 + 3.4 * tr.scale, z: tr.z },
        color: "#166534",
        castShadow: true
      });
    } else if (tr.type === "willow") {
      list.push({
        id: "tree-willow-" + t,
        type: "sphere",
        radius: 1.8 * tr.scale,
        position: { x: tr.x, y: 0.8 + 2.8 * tr.scale, z: tr.z },
        color: "#16a34a",
        castShadow: true
      });
    } else if (tr.type === "birch") {
      list.push({
        id: "tree-birch-" + t,
        type: "sphere",
        radius: 1.6 * tr.scale,
        position: { x: tr.x, y: 0.8 + 3.0 * tr.scale, z: tr.z },
        color: "#eab308",
        castShadow: true
      });
    } else {
      list.push({
        id: "tree-foliage-" + t,
        type: "sphere",
        radius: 1.7 * tr.scale,
        position: { x: tr.x, y: 0.8 + 3.0 * tr.scale, z: tr.z },
        color: "#15803d",
        castShadow: true
      });
    }
  }

  // 5. Granite Mossy Boulders & Rocky Formations
  let boulders = [
    { x: -22.5, z: 19.5, r: 1.6 },
    { x: -19.0, z: 23.0, r: 1.1 },
    { x: -25.0, z: 16.5, r: 1.3 },
    { x: LAKE_X + 6.5, z: LAKE_Z - 4.5, r: 1.1 },
    { x: LAKE_X - 6.0, z: LAKE_Z + 4.2, r: 0.95 },
    { x: 12.0, z: -16.5, r: 1.4 },
    { x: -6.0, z: 12.0, r: 1.0 },
    { x: 22.0, z: -4.0, r: 1.2 }
  ];
  for (let b = 0; b < boulders.length; b = b + 1) {
    list.push({
      id: "boulder-" + b,
      type: "sphere",
      radius: boulders[b].r,
      position: { x: boulders[b].x, y: 0.8 + boulders[b].r * 0.45, z: boulders[b].z },
      color: "#64748b",
      roughness: 0.85,
      castShadow: true
    });
  }

  // 6. Perimeter Wooden Fence Posts around Island Rim (70x70)
  let fenceSpacing = 4.5;
  let fCount = 0;
  for (let x = -BOUNDS; x <= BOUNDS; x = x + fenceSpacing) {
    list.push({
      id: "fence-n-" + fCount,
      type: "cylinder",
      radius: 0.09,
      height: 0.9,
      position: { x: x, y: 1.25, z: -BOUNDS },
      color: "#78350f"
    });
    list.push({
      id: "fence-s-" + fCount,
      type: "cylinder",
      radius: 0.09,
      height: 0.9,
      position: { x: x, y: 1.25, z: BOUNDS },
      color: "#78350f"
    });
    fCount = fCount + 1;
  }

  return list;
}

const staticObjects = buildStaticMeadow();

// Spawn Rabbit (Prey with Evolutionary Genetics & Dual Needs)
function addRabbit(x, z, initialEnergy, generation, traits) {
  let posX = x !== undefined ? x : (Math.random() - 0.5) * BOUNDS * 1.85;
  let posZ = z !== undefined ? z : (Math.random() - 0.5) * BOUNDS * 1.85;
  if (isInsideLake(posX, posZ)) {
    posX = posX + (posX > LAKE_X ? LAKE_RADIUS + 1.5 : -(LAKE_RADIUS + 1.5));
  }
  let id = genId("prey");
  let gen = generation || 1;
  if (gen > maxGeneration) maxGeneration = gen;

  let speedTrait = (traits && traits.speed) ? traits.speed : (0.92 + Math.random() * 0.16);
  let sightTrait = (traits && traits.sight) ? traits.sight : (0.92 + Math.random() * 0.16);

  rabbits.push({
    id: id,
    name: "Hare #" + id.split("-")[1],
    generation: gen,
    traits: {
      speed: speedTrait,
      sight: sightTrait
    },
    x: posX,
    z: posZ,
    y: 0.82,
    vx: (Math.random() - 0.5) * 0.05,
    vz: (Math.random() - 0.5) * 0.05,
    rot: Math.random() * Math.PI * 2,
    energy: initialEnergy || 32,
    maxEnergy: 60,
    hydration: 45,
    maxHydration: 60,
    age: 0,
    maxAge: 2000 + Math.floor(Math.random() * 500),
    state: "Wandering", // Wandering, Grazing, Drinking, Fleeing, Resting
    hopPhase: Math.random() * Math.PI * 2,
    offspringCount: 0
  });
  rabbitCount = rabbits.length;
}

// Spawn Fox (Predator with Evolutionary Genetics & Dual Needs)
function addFox(x, z, initialEnergy, generation, traits) {
  let posX = x !== undefined ? x : (Math.random() - 0.5) * BOUNDS * 1.85;
  let posZ = z !== undefined ? z : (Math.random() - 0.5) * BOUNDS * 1.85;
  if (isInsideLake(posX, posZ)) {
    posX = posX - (posX > LAKE_X ? LAKE_RADIUS + 1.5 : -(LAKE_RADIUS + 1.5));
  }
  let id = genId("pred");
  let gen = generation || 1;
  if (gen > maxGeneration) maxGeneration = gen;

  let speedTrait = (traits && traits.speed) ? traits.speed : (0.94 + Math.random() * 0.14);
  let sightTrait = (traits && traits.sight) ? traits.sight : (0.94 + Math.random() * 0.14);

  foxes.push({
    id: id,
    name: "Fox #" + id.split("-")[1],
    generation: gen,
    traits: {
      speed: speedTrait,
      sight: sightTrait
    },
    x: posX,
    z: posZ,
    y: 0.85,
    vx: (Math.random() - 0.5) * 0.06,
    vz: (Math.random() - 0.5) * 0.06,
    rot: Math.random() * Math.PI * 2,
    energy: initialEnergy || 45,
    maxEnergy: 85,
    hydration: 50,
    maxHydration: 85,
    age: 0,
    maxAge: 2800 + Math.floor(Math.random() * 600),
    state: "Patrolling", // Patrolling, Stalking, Chasing, Satiated, Drinking
    runPhase: Math.random() * Math.PI * 2,
    targetId: null,
    catchCount: 0,
    satiatedTicks: 0,
    offspringCount: 0
  });
  foxCount = foxes.length;
}

// Initialize 180 Dynamic Grass Patches across the entire 70x70 Meadow
function initGrassGrid() {
  grassList = [];
  let numPatches = 180;
  for (let i = 0; i < numPatches; i = i + 1) {
    let gx = (Math.random() - 0.5) * BOUNDS * 1.92;
    let gz = (Math.random() - 0.5) * BOUNDS * 1.92;
    if (isInsideLake(gx, gz)) {
      gx = gx + (gx > LAKE_X ? LAKE_RADIUS + 1.8 : -(LAKE_RADIUS + 1.8));
    }
    grassList.push({
      id: "grass-" + i,
      x: gx,
      z: gz,
      nutrition: Math.floor(Math.random() * 3) + 1, // 1 to 3
      maxNutrition: 3,
      regrowTimer: Math.random() * 4.5
    });
  }
  grassCount = grassList.length;
}

// Particle System
function spawnPuff(x, y, z, color, count) {
  let c = count || 6;
  for (let i = 0; i < c; i = i + 1) {
    particlePuffs.push({
      x: x,
      y: y + 0.2,
      z: z,
      vx: (Math.random() - 0.5) * 0.08,
      vy: 0.04 + Math.random() * 0.06,
      vz: (Math.random() - 0.5) * 0.08,
      color: color || "#ffffff",
      life: 0,
      maxLife: 20 + Math.floor(Math.random() * 15)
    });
  }
}

function updateParticles() {
  let kept = [];
  for (let i = 0; i < particlePuffs.length; i = i + 1) {
    let p = particlePuffs[i];
    p.life = p.life + 1;
    if (p.life < p.maxLife) {
      p.x = p.x + p.vx;
      p.y = p.y + p.vy;
      p.z = p.z + p.vz;
      p.vy = p.vy * 0.95;
      kept.push(p);
    }
  }
  particlePuffs = kept;
}

// Reset Ecosystem Scenarios
function resetScenario(type) {
  rabbits = [];
  foxes = [];
  particlePuffs = [];
  simTick = 0;
  dayCount = 1;
  maxGeneration = 1;
  selectedId = "";
  selectedEntity = null;
  inspectorOpen = false;
  initGrassGrid();

  if (type === "rabbit_boom") {
    for (let i = 0; i < 65; i = i + 1) addRabbit();
    for (let i = 0; i < 4; i = i + 1) addFox();
  } else if (type === "predator_pack") {
    for (let i = 0; i < 35; i = i + 1) addRabbit();
    for (let i = 0; i < 22; i = i + 1) addFox();
  } else if (type === "sparse") {
    for (let i = 0; i < 24; i = i + 1) addRabbit();
    for (let i = 0; i < 6; i = i + 1) addFox();
  } else {
    // Perfectly Balanced Dynamic Equilibrium for 70x70 World
    for (let i = 0; i < 48; i = i + 1) addRabbit();
    for (let i = 0; i < 11; i = i + 1) addFox();
  }

  updateStats();
}

// Sustainable Ecosystem Physics & Agent AI Step
function updateEcosystem(delta) {
  simTick = simTick + 1;
  if (simTick % 220 === 0) {
    dayCount = dayCount + 1;
    let seasons = ["Spring", "Summer", "Autumn", "Winter"];
    season = seasons[Math.floor(dayCount / 6) % 4];
  }

  // 1. Dynamic Grass Growth, Carrying Capacity & Seed Dispersal
  let matureGrassCount = 0;
  for (let g = 0; g < grassList.length; g = g + 1) {
    let grass = grassList[g];
    if (grass.nutrition < grass.maxNutrition) {
      let regrowSpeed = season === "Spring" ? 1.45 : (season === "Winter" ? 0.35 : 1.0);
      grass.regrowTimer = grass.regrowTimer + delta * regrowSpeed;
      if (grass.regrowTimer > 5.0) {
        grass.nutrition = grass.nutrition + 1;
        grass.regrowTimer = 0;
      }
    }
    if (grass.nutrition > 0) matureGrassCount = matureGrassCount + 1;
  }
  grassCount = matureGrassCount;

  // 2. Rabbits (Prey) AI, Foraging, Hydration & Natural Selection
  let survivingRabbits = [];
  let newRabbits = [];

  for (let r = 0; r < rabbits.length; r = r + 1) {
    let rab = rabbits[r];
    rab.age = rab.age + 1;
    let isFleeing = rab.state === "Fleeing";
    rab.hopPhase = rab.hopPhase + delta * (isFleeing ? 13.5 : 7.0);
    rab.y = 0.82 + Math.abs(Math.sin(rab.hopPhase)) * (isFleeing ? 0.28 : 0.16);

    let inCover = hasForestCover(rab.x, rab.z);

    // Natural Thirst Metabolism
    rab.hydration = Math.max(0, rab.hydration - 0.022 * delta * 30);

    // Threat Detection with Genetic Sight Trait
    let nearestFox = null;
    let baseDetection = inCover ? 4.2 : 8.5;
    let detectionRadius = baseDetection * rab.traits.sight;
    let minFoxDist = detectionRadius;

    for (let f = 0; f < foxes.length; f = f + 1) {
      let fox = foxes[f];
      if (fox.satiatedTicks <= 0) {
        let d = dist(rab.x, rab.z, fox.x, fox.z);
        if (d < minFoxDist) {
          minFoxDist = d;
          nearestFox = fox;
        }
      }
    }

    if (nearestFox) {
      // FLEE: Sprint away with Genetic Speed Trait
      rab.state = "Fleeing";
      let dx = rab.x - nearestFox.x;
      let dz = rab.z - nearestFox.z;
      let len = Math.hypot(dx, dz) || 1;
      let sprintSpeed = 0.155 * rab.traits.speed;
      rab.vx = (dx / len) * sprintSpeed;
      rab.vz = (dz / len) * sprintSpeed;
      let targetRot = Math.atan2(rab.vx, rab.vz);
      rab.rot = lerpAngle(rab.rot, targetRot, 0.24);
      rab.energy = rab.energy - 0.065 * delta * 30;
    } else if (rab.hydration < 25) {
      // THIRSTY: Seek Oasis Lake to Drink
      let dx = LAKE_X - rab.x;
      let dz = LAKE_Z - rab.z;
      let len = Math.hypot(dx, dz) || 1;
      if (isNearLakeShore(rab.x, rab.z)) {
        rab.state = "Drinking";
        rab.hydration = Math.min(rab.maxHydration, rab.hydration + 18.0);
        spawnPuff(rab.x, rab.y, rab.z, "#38bdf8", 3);
        rab.vx = 0;
        rab.vz = 0;
      } else {
        let seekSpeed = 0.08 * rab.traits.speed;
        rab.vx = (dx / len) * seekSpeed;
        rab.vz = (dz / len) * seekSpeed;
        let targetRot = Math.atan2(rab.vx, rab.vz);
        rab.rot = lerpAngle(rab.rot, targetRot, 0.16);
      }
      rab.energy = rab.energy - 0.025 * delta * 30;
    } else {
      // SAFE: Seek Grass or Wander
      let nearestGrass = null;
      let minGrassDist = 11.0;
      for (let g = 0; g < grassList.length; g = g + 1) {
        if (grassList[g].nutrition > 0) {
          let d = dist(rab.x, rab.z, grassList[g].x, grassList[g].z);
          if (d < minGrassDist) {
            minGrassDist = d;
            nearestGrass = grassList[g];
          }
        }
      }

      if (nearestGrass && rab.energy < 48) {
        rab.state = "Grazing";
        let dx = nearestGrass.x - rab.x;
        let dz = nearestGrass.z - rab.z;
        let len = Math.hypot(dx, dz) || 1;
        if (len < 0.65) {
          // Nibble Grass
          rab.energy = Math.min(rab.maxEnergy, rab.energy + 12.0);
          nearestGrass.nutrition = nearestGrass.nutrition - 1;
          spawnPuff(rab.x, rab.y, rab.z, "#22c55e", 4);
          rab.vx = 0;
          rab.vz = 0;
        } else {
          let wanderSpeed = 0.075 * rab.traits.speed;
          rab.vx = (dx / len) * wanderSpeed;
          rab.vz = (dz / len) * wanderSpeed;
          let targetRot = Math.atan2(rab.vx, rab.vz);
          rab.rot = lerpAngle(rab.rot, targetRot, 0.16);
        }
      } else {
        rab.state = "Wandering";
        if (Math.random() < 0.038) {
          let targetRot = rab.rot + (Math.random() - 0.5) * 1.4;
          let speed = 0.042 * rab.traits.speed;
          rab.vx = Math.sin(targetRot) * speed;
          rab.vz = Math.cos(targetRot) * speed;
          rab.rot = lerpAngle(rab.rot, targetRot, 0.15);
        }
      }
      rab.energy = rab.energy - 0.026 * delta * 30;
    }

    // Soft Herd Separation (Avoid overlapping same species)
    for (let o = 0; o < rabbits.length; o = o + 1) {
      if (o !== r) {
        let od = dist(rab.x, rab.z, rabbits[o].x, rabbits[o].z);
        if (od < 0.7 && od > 0.01) {
          let push = 0.016 * (0.7 - od);
          rab.vx = rab.vx + ((rab.x - rabbits[o].x) / od) * push;
          rab.vz = rab.vz + ((rab.z - rabbits[o].z) / od) * push;
        }
      }
    }

    // Apply Velocity
    rab.x = rab.x + rab.vx;
    rab.z = rab.z + rab.vz;

    // Boundaries
    if (rab.x > BOUNDS) { rab.x = BOUNDS; rab.vx = -Math.abs(rab.vx); }
    if (rab.x < -BOUNDS) { rab.x = -BOUNDS; rab.vx = Math.abs(rab.vx); }
    if (rab.z > BOUNDS) { rab.z = BOUNDS; rab.vz = -Math.abs(rab.vz); }
    if (rab.z < -BOUNDS) { rab.z = -BOUNDS; rab.vz = Math.abs(rab.vz); }

    // Lake Shore Boundary: Smooth circular avoidance
    let distLake = Math.hypot(rab.x - LAKE_X, rab.z - LAKE_Z);
    if (distLake < LAKE_RADIUS) {
      let angleFromCenter = Math.atan2(rab.z - LAKE_Z, rab.x - LAKE_X);
      rab.x = LAKE_X + Math.cos(angleFromCenter) * (LAKE_RADIUS + 0.2);
      rab.z = LAKE_Z + Math.sin(angleFromCenter) * (LAKE_RADIUS + 0.2);
      rab.vx = Math.cos(angleFromCenter) * 0.04;
      rab.vz = Math.sin(angleFromCenter) * 0.04;
      rab.rot = lerpAngle(rab.rot, angleFromCenter, 0.3);
    }

    // Reproduction with Genetic Mutation
    if (rab.energy > 46 && rab.hydration > 25 && rab.age > 90 && rabbits.length < 95) {
      rab.energy = rab.energy - 20;
      rab.offspringCount = rab.offspringCount + 1;
      totalPreyBorn = totalPreyBorn + 1;
      spawnPuff(rab.x, rab.y + 0.4, rab.z, "#f43f5e", 8);

      // Genetic inheritance with small random mutation
      let childSpeed = Math.min(1.35, Math.max(0.75, rab.traits.speed + (Math.random() - 0.5) * 0.08));
      let childSight = Math.min(1.35, Math.max(0.75, rab.traits.sight + (Math.random() - 0.5) * 0.08));
      let childGen = rab.generation + 1;
      if (childGen > maxGeneration) maxGeneration = childGen;

      newRabbits.push({
        id: genId("prey"),
        name: "Hare #" + totalPreyBorn,
        generation: childGen,
        traits: {
          speed: childSpeed,
          sight: childSight
        },
        x: rab.x + (Math.random() - 0.5) * 1.0,
        z: rab.z + (Math.random() - 0.5) * 1.0,
        y: 0.82,
        vx: (Math.random() - 0.5) * 0.05,
        vz: (Math.random() - 0.5) * 0.05,
        rot: Math.random() * Math.PI * 2,
        energy: 24,
        maxEnergy: 60,
        hydration: 50,
        maxHydration: 60,
        age: 0,
        maxAge: 2000 + Math.floor(Math.random() * 500),
        state: "Wandering",
        hopPhase: 0,
        offspringCount: 0
      });
    }

    // Natural Mortality / Starvation
    if (rab.energy <= 0 || rab.hydration <= 0 || rab.age > rab.maxAge) {
      spawnPuff(rab.x, rab.y, rab.z, "#cbd5e1", 6);
    } else {
      survivingRabbits.push(rab);
    }
  }

  for (let n = 0; n < newRabbits.length; n = n + 1) {
    survivingRabbits.push(newRabbits[n]);
  }
  rabbits = survivingRabbits;

  // 3. Foxes (Predators) AI, Stalking, Chasing & Hydration
  let survivingFoxes = [];
  let newFoxes = [];
  let eatenRabbitIds = {};

  for (let f = 0; f < foxes.length; f = f + 1) {
    let fox = foxes[f];
    fox.age = fox.age + 1;
    fox.hydration = Math.max(0, fox.hydration - 0.020 * delta * 30);

    // Satiation timer (Resting and digesting)
    if (fox.satiatedTicks > 0) {
      fox.satiatedTicks = fox.satiatedTicks - 1;
      fox.state = "Satiated";
      fox.runPhase = fox.runPhase + delta * 2.8;
      if (Math.random() < 0.03) {
        let targetRot = fox.rot + (Math.random() - 0.5) * 0.8;
        let speed = 0.035 * fox.traits.speed;
        fox.vx = Math.sin(targetRot) * speed;
        fox.vz = Math.cos(targetRot) * speed;
        fox.rot = lerpAngle(fox.rot, targetRot, 0.12);
      }
      fox.energy = fox.energy - 0.024 * delta * 30;
    } else if (fox.hydration < 25) {
      // THIRSTY FOX: Seek Oasis Lake
      let dx = LAKE_X - fox.x;
      let dz = LAKE_Z - fox.z;
      let len = Math.hypot(dx, dz) || 1;
      if (isNearLakeShore(fox.x, fox.z)) {
        fox.state = "Drinking";
        fox.hydration = Math.min(fox.maxHydration, fox.hydration + 24.0);
        spawnPuff(fox.x, fox.y, fox.z, "#38bdf8", 4);
        fox.vx = 0;
        fox.vz = 0;
      } else {
        let seekSpeed = 0.085 * fox.traits.speed;
        fox.vx = (dx / len) * seekSpeed;
        fox.vz = (dz / len) * seekSpeed;
        let targetRot = Math.atan2(fox.vx, fox.vz);
        fox.rot = lerpAngle(fox.rot, targetRot, 0.16);
      }
      fox.energy = fox.energy - 0.030 * delta * 30;
    } else {
      fox.runPhase = fox.runPhase + delta * (fox.state === "Chasing" ? 11.5 : 5.5);

      // Search for prey with Genetic Sight Trait
      let nearestRab = null;
      let minRabDist = 12.0 * fox.traits.sight;
      for (let r = 0; r < rabbits.length; r = r + 1) {
        let rab = rabbits[r];
        if (!eatenRabbitIds[rab.id]) {
          let inCover = hasForestCover(rab.x, rab.z);
          let effectiveVision = inCover ? 5.5 * fox.traits.sight : minRabDist;
          let d = dist(fox.x, fox.z, rab.x, rab.z);
          if (d < effectiveVision) {
            minRabDist = d;
            nearestRab = rab;
          }
        }
      }

      if (nearestRab) {
        let dx = nearestRab.x - fox.x;
        let dz = nearestRab.z - fox.z;
        let len = Math.hypot(dx, dz) || 1;

        if (len < 0.78) {
          // CATCH PREY: Pounce!
          eatenRabbitIds[nearestRab.id] = true;
          fox.energy = Math.min(fox.maxEnergy, fox.energy + 34.0);
          fox.catchCount = fox.catchCount + 1;
          totalHunts = totalHunts + 1;
          fox.satiatedTicks = 85; // ~2.8 seconds resting cooldown
          fox.state = "Satiated";
          spawnPuff(nearestRab.x, nearestRab.y + 0.3, nearestRab.z, "#fb923c", 10);
          fox.vx = 0;
          fox.vz = 0;
        } else if (len < 5.2) {
          // CHASING: Full sprint
          fox.state = "Chasing";
          fox.targetId = nearestRab.id;
          let sprintSpeed = 0.145 * fox.traits.speed;
          fox.vx = (dx / len) * sprintSpeed;
          fox.vz = (dz / len) * sprintSpeed;
          let targetRot = Math.atan2(fox.vx, fox.vz);
          fox.rot = lerpAngle(fox.rot, targetRot, 0.22);
          fox.energy = fox.energy - 0.075 * delta * 30;
        } else {
          // STALKING: Stealth crawl
          fox.state = "Stalking";
          fox.targetId = nearestRab.id;
          let stalkSpeed = 0.068 * fox.traits.speed;
          fox.vx = (dx / len) * stalkSpeed;
          fox.vz = (dz / len) * stalkSpeed;
          let targetRot = Math.atan2(fox.vx, fox.vz);
          fox.rot = lerpAngle(fox.rot, targetRot, 0.15);
          fox.energy = fox.energy - 0.040 * delta * 30;
        }
      } else {
        // Patrolling
        fox.state = "Patrolling";
        if (Math.random() < 0.035) {
          let targetRot = fox.rot + (Math.random() - 0.5) * 1.1;
          let speed = 0.054 * fox.traits.speed;
          fox.vx = Math.sin(targetRot) * speed;
          fox.vz = Math.cos(targetRot) * speed;
          fox.rot = lerpAngle(fox.rot, targetRot, 0.14);
        }
        fox.energy = fox.energy - 0.038 * delta * 30;
      }
    }

    // Soft Pack Separation
    for (let o = 0; o < foxes.length; o = o + 1) {
      if (o !== f) {
        let od = dist(fox.x, fox.z, foxes[o].x, foxes[o].z);
        if (od < 0.95 && od > 0.01) {
          let push = 0.02 * (0.95 - od);
          fox.vx = fox.vx + ((fox.x - foxes[o].x) / od) * push;
          fox.vz = fox.vz + ((fox.z - foxes[o].z) / od) * push;
        }
      }
    }

    // Apply Velocity
    fox.x = fox.x + fox.vx;
    fox.z = fox.z + fox.vz;

    // Boundaries
    if (fox.x > BOUNDS) { fox.x = BOUNDS; fox.vx = -Math.abs(fox.vx); }
    if (fox.x < -BOUNDS) { fox.x = -BOUNDS; fox.vx = Math.abs(fox.vx); }
    if (fox.z > BOUNDS) { fox.z = BOUNDS; fox.vz = -Math.abs(fox.vz); }
    if (fox.z < -BOUNDS) { fox.z = -BOUNDS; fox.vz = Math.abs(fox.vz); }

    // Lake Shore Avoidance
    let distLake = Math.hypot(fox.x - LAKE_X, fox.z - LAKE_Z);
    if (distLake < LAKE_RADIUS) {
      let angleFromCenter = Math.atan2(fox.z - LAKE_Z, fox.x - LAKE_X);
      fox.x = LAKE_X + Math.cos(angleFromCenter) * (LAKE_RADIUS + 0.25);
      fox.z = LAKE_Z + Math.sin(angleFromCenter) * (LAKE_RADIUS + 0.25);
      fox.vx = Math.cos(angleFromCenter) * 0.05;
      fox.vz = Math.sin(angleFromCenter) * 0.05;
      fox.rot = lerpAngle(fox.rot, angleFromCenter, 0.3);
    }

    // Fox Reproduction with Genetic Mutation
    if (fox.energy > 65 && fox.hydration > 25 && fox.age > 160 && foxes.length < 32) {
      fox.energy = fox.energy - 32;
      fox.offspringCount = fox.offspringCount + 1;
      totalPredBorn = totalPredBorn + 1;
      spawnPuff(fox.x, fox.y + 0.4, fox.z, "#f97316", 8);

      let childSpeed = Math.min(1.35, Math.max(0.75, fox.traits.speed + (Math.random() - 0.5) * 0.08));
      let childSight = Math.min(1.35, Math.max(0.75, fox.traits.sight + (Math.random() - 0.5) * 0.08));
      let childGen = fox.generation + 1;
      if (childGen > maxGeneration) maxGeneration = childGen;

      newFoxes.push({
        id: genId("pred"),
        name: "Fox #" + totalPredBorn,
        generation: childGen,
        traits: {
          speed: childSpeed,
          sight: childSight
        },
        x: fox.x + (Math.random() - 0.5) * 1.2,
        z: fox.z + (Math.random() - 0.5) * 1.2,
        y: 0.85,
        vx: (Math.random() - 0.5) * 0.06,
        vz: (Math.random() - 0.5) * 0.06,
        rot: Math.random() * Math.PI * 2,
        energy: 38,
        maxEnergy: 85,
        hydration: 55,
        maxHydration: 85,
        age: 0,
        maxAge: 2800 + Math.floor(Math.random() * 600),
        state: "Patrolling",
        runPhase: 0,
        targetId: null,
        catchCount: 0,
        satiatedTicks: 0,
        offspringCount: 0
      });
    }

    // Fox Mortality
    if (fox.energy <= 0 || fox.hydration <= 0 || fox.age > fox.maxAge) {
      spawnPuff(fox.x, fox.y, fox.z, "#94a3b8", 8);
    } else {
      survivingFoxes.push(fox);
    }
  }

  // Filter caught rabbits
  rabbits = rabbits.filter(function(rab) {
    return !eatenRabbitIds[rab.id];
  });

  for (let n = 0; n < newFoxes.length; n = n + 1) {
    survivingFoxes.push(newFoxes[n]);
  }
  foxes = survivingFoxes;

  // Update Stats
  updateStats();
}

function updateStats() {
  rabbitCount = rabbits.length;
  foxCount = foxes.length;

  // Ecological Balance Status
  if (rabbitCount === 0 && foxCount === 0) {
    ecosystemStatus = "Ecological Collapse";
    statusColor = "#ef4444";
  } else if (foxCount === 0) {
    ecosystemStatus = "Prey Boom (No Apex Predators)";
    statusColor = "#f59e0b";
  } else if (rabbitCount === 0) {
    ecosystemStatus = "Predator Starvation (No Prey)";
    statusColor = "#dc2626";
  } else if (foxCount >= 18) {
    ecosystemStatus = "Predator Surplus Phase";
    statusColor = "#fb923c";
  } else if (rabbitCount >= 65) {
    ecosystemStatus = "Abundant Prey Phase";
    statusColor = "#38bdf8";
  } else {
    ecosystemStatus = "Dynamic Equilibrium";
    statusColor = "#22c55e";
  }

  // Pre-computed visual sparkline bars
  if (simTick % 16 === 0) {
    sparkPreyBars.shift();
    sparkPreyBars.push(Math.min(100, Math.round((rabbitCount / 80) * 100)));

    sparkFoxBars.shift();
    sparkFoxBars.push(Math.min(100, Math.round((foxCount / 26) * 100)));

    sparkGrassBars.shift();
    sparkGrassBars.push(Math.min(100, Math.round((grassCount / 180) * 100)));
  }

  // Sync selected entity
  if (selectedId) {
    let found = null;
    for (let r = 0; r < rabbits.length; r = r + 1) {
      if (rabbits[r].id === selectedId) found = rabbits[r];
    }
    if (!found) {
      for (let f = 0; f < foxes.length; f = f + 1) {
        if (foxes[f].id === selectedId) found = foxes[f];
      }
    }
    selectedEntity = found;
    inspectorOpen = found !== null;
  } else {
    selectedEntity = null;
    inspectorOpen = false;
  }
}

// Build 3D Dynamic Entities
function buildDynamicObjects() {
  let list = [];

  // 1. Dynamic 3D Grass Tufts with Wildflowers
  for (let g = 0; g < grassList.length; g = g + 1) {
    let gr = grassList[g];
    if (gr.nutrition > 0) {
      let bladeH = 0.32 + gr.nutrition * 0.18;
      list.push({
        id: gr.id + "-tuft",
        type: "cylinder",
        radius: 0.20 + gr.nutrition * 0.08,
        height: bladeH,
        position: { x: gr.x, y: 0.8 + bladeH / 2, z: gr.z },
        color: gr.nutrition === 3 ? "#16a34a" : "#22c55e",
        castShadow: true
      });
      // Blooming Flowers on Mature Patches
      if (gr.nutrition === 3) {
        let flowerColor = (g % 4 === 0) ? "#fbbf24" : ((g % 4 === 1) ? "#f43f5e" : ((g % 4 === 2) ? "#a855f7" : "#38bdf8"));
        list.push({
          id: gr.id + "-flower",
          type: "sphere",
          radius: 0.12,
          position: { x: gr.x, y: 0.8 + bladeH + 0.09, z: gr.z },
          color: flowerColor
        });
      }
    }
  }

  // 2. 3D Animated White Rabbits (Prey)
  for (let r = 0; r < rabbits.length; r = r + 1) {
    let rab = rabbits[r];
    let isSel = rab.id === selectedId;

    let rabChildren = [
      // Body
      {
        id: rab.id + "-body",
        type: "capsule",
        radius: 0.20,
        height: 0.28,
        position: { x: 0, y: 0.20, z: 0 },
        color: isSel ? "#fef08a" : "#f8fafc",
        castShadow: true
      },
      // Head
      {
        id: rab.id + "-head",
        type: "sphere",
        radius: 0.15,
        position: { x: 0, y: 0.35, z: 0.20 },
        color: isSel ? "#fef08a" : "#f8fafc"
      },
      // Left Ear
      {
        id: rab.id + "-ear-l",
        type: "capsule",
        radius: 0.038,
        height: 0.24,
        position: { x: -0.07, y: 0.52, z: 0.15 },
        rotation: { x: -0.18, y: 0, z: -0.15 },
        color: "#f8fafc"
      },
      {
        id: rab.id + "-ear-in-l",
        type: "capsule",
        radius: 0.022,
        height: 0.18,
        position: { x: -0.07, y: 0.51, z: 0.17 },
        rotation: { x: -0.18, y: 0, z: -0.15 },
        color: "#fda4af"
      },
      // Right Ear
      {
        id: rab.id + "-ear-r",
        type: "capsule",
        radius: 0.038,
        height: 0.24,
        position: { x: 0.07, y: 0.52, z: 0.15 },
        rotation: { x: -0.18, y: 0, z: 0.15 },
        color: "#f8fafc"
      },
      {
        id: rab.id + "-ear-in-r",
        type: "capsule",
        radius: 0.022,
        height: 0.18,
        position: { x: 0.07, y: 0.51, z: 0.17 },
        rotation: { x: -0.18, y: 0, z: 0.15 },
        color: "#fda4af"
      },
      // Eyes
      {
        id: rab.id + "-eye-l",
        type: "sphere",
        radius: 0.028,
        position: { x: -0.10, y: 0.36, z: 0.29 },
        color: "#09090b"
      },
      {
        id: rab.id + "-eye-r",
        type: "sphere",
        radius: 0.028,
        position: { x: 0.10, y: 0.36, z: 0.29 },
        color: "#09090b"
      },
      // Nose
      {
        id: rab.id + "-nose",
        type: "sphere",
        radius: 0.022,
        position: { x: 0, y: 0.32, z: 0.33 },
        color: "#fb7185"
      },
      // Cotton Tail
      {
        id: rab.id + "-tail",
        type: "sphere",
        radius: 0.08,
        position: { x: 0, y: 0.20, z: -0.24 },
        color: "#ffffff"
      }
    ];

    list.push({
      id: rab.id,
      type: "group",
      position: { x: rab.x, y: rab.y, z: rab.z },
      rotation: { x: 0, y: rab.rot, z: 0 },
      cursor: "pointer",
      interactive: true,
      children: rabChildren
    });

    // Glowing Selection Halo
    if (isSel) {
      list.push({
        id: rab.id + "-halo",
        type: "torus",
        radius: 0.50,
        tube: 0.045,
        position: { x: rab.x, y: 0.85, z: rab.z },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: "#fbbf24",
        emissive: "#fbbf24",
        emissiveIntensity: 2.2
      });
    }
  }

  // 3. 3D Animated Russet Foxes (Predators)
  for (let f = 0; f < foxes.length; f = f + 1) {
    let fox = foxes[f];
    let isSel = fox.id === selectedId;

    let foxChildren = [
      // Body
      {
        id: fox.id + "-body",
        type: "capsule",
        radius: 0.22,
        height: 0.54,
        position: { x: 0, y: 0.28, z: 0 },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: isSel ? "#fef08a" : "#ea580c",
        castShadow: true
      },
      // White Chest/Bib
      {
        id: fox.id + "-chest",
        type: "sphere",
        radius: 0.17,
        position: { x: 0, y: 0.24, z: 0.20 },
        color: "#f8fafc"
      },
      // Pointed Muzzle
      {
        id: fox.id + "-head",
        type: "cone",
        radius: 0.17,
        height: 0.35,
        position: { x: 0, y: 0.35, z: 0.38 },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: "#ea580c"
      },
      // Nose
      {
        id: fox.id + "-nose",
        type: "sphere",
        radius: 0.035,
        position: { x: 0, y: 0.35, z: 0.56 },
        color: "#09090b"
      },
      // Eyes
      {
        id: fox.id + "-eye-l",
        type: "sphere",
        radius: 0.032,
        position: { x: -0.10, y: 0.39, z: 0.38 },
        color: "#09090b"
      },
      {
        id: fox.id + "-eye-r",
        type: "sphere",
        radius: 0.032,
        position: { x: 0.10, y: 0.39, z: 0.38 },
        color: "#09090b"
      },
      // Pointed Ears
      {
        id: fox.id + "-ear-l",
        type: "cone",
        radius: 0.065,
        height: 0.18,
        position: { x: -0.11, y: 0.52, z: 0.28 },
        color: "#9a3412"
      },
      {
        id: fox.id + "-ear-r",
        type: "cone",
        radius: 0.065,
        height: 0.18,
        position: { x: 0.11, y: 0.52, z: 0.28 },
        color: "#9a3412"
      },
      // Bushy Tail
      {
        id: fox.id + "-tail",
        type: "capsule",
        radius: 0.12,
        height: 0.44,
        position: { x: Math.sin(fox.runPhase) * 0.04, y: 0.32, z: -0.44 },
        rotation: { x: -0.55, y: Math.sin(fox.runPhase) * 0.15, z: 0 },
        color: "#ea580c"
      },
      // White Tail Tip
      {
        id: fox.id + "-tail-tip",
        type: "sphere",
        radius: 0.10,
        position: { x: Math.sin(fox.runPhase) * 0.06, y: 0.45, z: -0.60 },
        color: "#ffffff"
      }
    ];

    list.push({
      id: fox.id,
      type: "group",
      position: { x: fox.x, y: fox.y, z: fox.z },
      rotation: { x: 0, y: fox.rot, z: 0 },
      cursor: "pointer",
      interactive: true,
      children: foxChildren
    });

    // Selection Halo
    if (isSel) {
      list.push({
        id: fox.id + "-halo",
        type: "torus",
        radius: 0.60,
        tube: 0.045,
        position: { x: fox.x, y: 0.85, z: fox.z },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: "#f97316",
        emissive: "#f97316",
        emissiveIntensity: 2.2
      });
    }
  }

  // 4. Particle Effects
  let particlePos = [];
  for (let p = 0; p < particlePuffs.length; p = p + 1) {
    let pt = particlePuffs[p];
    particlePos.push(pt.x, pt.y, pt.z);
  }
  if (particlePos.length > 0) {
    list.push({
      id: "sim-particles",
      type: "particles",
      particlePositions: particlePos,
      particleSize: 0.25,
      color: "#fef08a",
      opacity: 0.85
    });
  }

  return list;
}

// Nature Lighting
function buildLights() {
  let list = [];

  // High Warm Sun
  list.push({
    id: "sun-light",
    type: "directional",
    color: "#fffbeb",
    intensity: 1.55,
    position: { x: 25, y: 45, z: 28 },
    castShadow: true,
    shadowCameraSize: 48,
    shadowBias: -0.0003
  });

  // Cool Sky Fill
  list.push({
    id: "sky-light",
    type: "directional",
    color: "#bae6fd",
    intensity: 0.65,
    position: { x: -30, y: 32, z: -25 }
  });

  // Ambient Tone
  list.push({
    id: "ambient-light",
    type: "ambient",
    color: "#dcfce7",
    intensity: 0.65
  });

  return list;
}

// Game Step Hook
function gameStep(dt) {
  let delta = dt ? Math.min(dt, 0.1) : 0.033;

  if (isRunning) {
    for (let s = 0; s < simSpeed; s = s + 1) {
      updateEcosystem(delta);
    }
  }

  updateParticles();

  // Dynamic Camera Modes
  if (cameraMode === "follow" && selectedEntity) {
    cameraPos = {
      x: selectedEntity.x - Math.sin(selectedEntity.rot) * 4.8,
      y: selectedEntity.y + 3.0,
      z: selectedEntity.z - Math.cos(selectedEntity.rot) * 4.8
    };
    cameraLookAt = {
      x: selectedEntity.x + Math.sin(selectedEntity.rot) * 2.5,
      y: selectedEntity.y + 0.6,
      z: selectedEntity.z + Math.cos(selectedEntity.rot) * 2.5
    };
  } else if (cameraMode === "cinematic") {
    cinematicAngle = cinematicAngle + delta * 0.08;
    cameraPos = {
      x: Math.sin(cinematicAngle) * 44.0,
      y: 28.0,
      z: Math.cos(cinematicAngle) * 44.0
    };
    cameraLookAt = { x: 0, y: 0.5, z: 0 };
  }

  objects = buildDynamicObjects();
  lights = buildLights();
}

// User Actions
function togglePlay() {
  isRunning = !isRunning;
}

function stepOnce() {
  updateEcosystem(0.033);
  objects = buildDynamicObjects();
}

function setSimSpeed(sp) {
  simSpeed = sp;
}

function setCameraView(mode) {
  cameraMode = mode;
  if (mode === "overview") {
    cameraPos = { x: 0, y: 38.0, z: 42.0 };
    cameraLookAt = { x: 0, y: 0.5, z: 0 };
    cameraFov = 48;
  } else if (mode === "lake") {
    cameraPos = { x: LAKE_X - 2.0, y: 12.0, z: LAKE_Z + 18.0 };
    cameraLookAt = { x: LAKE_X, y: 0.8, z: LAKE_Z };
    cameraFov = 42;
  } else if (mode === "forest") {
    cameraPos = { x: -22.0, y: 15.0, z: -5.0 };
    cameraLookAt = { x: -18.0, y: 0.8, z: -18.0 };
    cameraFov = 42;
  } else if (mode === "meadow") {
    cameraPos = { x: 18.0, y: 14.0, z: -10.0 };
    cameraLookAt = { x: 16.0, y: 0.8, z: -18.0 };
    cameraFov = 42;
  } else if (mode === "topdown") {
    cameraPos = { x: 0, y: 56.0, z: 0.1 };
    cameraLookAt = { x: 0, y: 0, z: 0 };
    cameraFov = 54;
  } else if (mode === "cinematic") {
    cameraFov = 42;
  }
}

function triggerSpringBloom() {
  for (let g = 0; g < grassList.length; g = g + 1) {
    grassList[g].nutrition = 3;
    grassList[g].regrowTimer = 0;
  }
  spawnPuff(0, 4.0, 0, "#22c55e", 40);
  updateStats();
}

function triggerColdSnap() {
  for (let g = 0; g < grassList.length; g = g + 1) {
    if (Math.random() < 0.65) {
      grassList[g].nutrition = 0;
    }
  }
  spawnPuff(0, 4.0, 0, "#93c5fd", 40);
  updateStats();
}

function spawnPreyAction() {
  addRabbit();
  spawnPuff(0, 1.5, 0, "#f8fafc", 10);
  updateStats();
}

function spawnPredatorAction() {
  addFox();
  spawnPuff(0, 1.5, 0, "#ea580c", 10);
  updateStats();
}

function plantGrassAction() {
  let gx = (Math.random() - 0.5) * BOUNDS * 1.85;
  let gz = (Math.random() - 0.5) * BOUNDS * 1.85;
  if (isInsideLake(gx, gz)) {
    gx = gx + (gx > LAKE_X ? LAKE_RADIUS + 1.8 : -(LAKE_RADIUS + 1.8));
  }
  grassList.push({
    id: genId("grass"),
    x: gx,
    z: gz,
    nutrition: 3,
    maxNutrition: 3,
    regrowTimer: 0
  });
  spawnPuff(gx, 1.2, gz, "#22c55e", 12);
  updateStats();
}

function closeInspector() {
  selectedId = "";
  selectedEntity = null;
  inspectorOpen = false;
}

// In-World 3D Raycast Click
function handleSceneClick(hit) {
  if (!hit || !hit.objectId) {
    closeInspector();
    return;
  }
  let id = hit.objectId;
  let targetId = id.split("-tuft")[0].split("-body")[0].split("-head")[0].split("-ear")[0].split("-tail")[0];

  for (let r = 0; r < rabbits.length; r = r + 1) {
    if (rabbits[r].id === targetId || id.indexOf(rabbits[r].id) !== -1) {
      selectedId = rabbits[r].id;
      selectedEntity = rabbits[r];
      inspectorOpen = true;
      return;
    }
  }

  for (let f = 0; f < foxes.length; f = f + 1) {
    if (foxes[f].id === targetId || id.indexOf(foxes[f].id) !== -1) {
      selectedId = foxes[f].id;
      selectedEntity = foxes[f];
      inspectorOpen = true;
      return;
    }
  }

  closeInspector();
}

// Initialize on load
resetScenario("balanced");
gameStep(0.033);
