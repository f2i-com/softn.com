// Integer shift: dst (zeroed by caller) receives src moved by (dx, dy). Rows [y0, y1) of dst.
function psShiftRows(src, w, h, dst, dx, dy, y0, y1, ch) {
  for (let y = y0; y < y1; y++) {
    let sy = y - dy;
    if (sy < 0 || sy >= h) continue;
    let xStart = dx > 0 ? dx : 0, xEnd = dx < 0 ? w + dx : w;
    if (xEnd <= xStart) continue;
    let sOff = (sy * w + (xStart - dx)) * ch, dOff = (y * w + xStart) * ch, count = (xEnd - xStart) * ch;
    for (let k = 0; k < count; k++) dst[dOff + k] = src[sOff + k];
  }
}

// Bounds of nonzero alpha (RGBA) or nonzero mask values; acc = { l, t, r, b } running across row slices.
function psBoundsRows(data, w, y0, y1, acc, ch) {
  for (let y = y0; y < y1; y++) {
    let row = y * w;
    let x0 = -1, x1 = -1;
    for (let x = 0; x < w; x++) { if (data[(row + x) * ch + (ch - 1)]) { x0 = x; break; } }
    if (x0 < 0) continue;
    for (let x = w - 1; x >= x0; x--) { if (data[(row + x) * ch + (ch - 1)]) { x1 = x; break; } }
    if (x0 < acc.l) acc.l = x0;
    if (x1 > acc.r) acc.r = x1;
    if (y < acc.t) acc.t = y;
    if (y > acc.b) acc.b = y;
  }
}
function psBoundsNew(w, h) { return { l: w, t: h, r: -1, b: -1 }; }
function psBoundsResult(acc) { return acc.r < 0 ? null : { x: acc.l, y: acc.t, width: acc.r - acc.l + 1, height: acc.b - acc.t + 1 }; }

// ---------------------------------------------------------------------------
// Selection shapes into a mask (Uint8Array w*h), rows [y0, y1). Anti-aliased.
// ---------------------------------------------------------------------------
function psRectCoverage(px, py, x0, y0, x1, y1) {
  let ox = Math.min(px + 1, x1) - Math.max(px, x0); if (ox <= 0) return 0;
  let oy = Math.min(py + 1, y1) - Math.max(py, y0); if (oy <= 0) return 0;
  return ox * oy;
}
function psEllipseCoverage(px, py, cx, cy, rx, ry) {
  if (rx <= 0 || ry <= 0) return 0;
  let dx = (px + 0.5 - cx) / rx, dy = (py + 0.5 - cy) / ry;
  let f = dx * dx + dy * dy;
  let gx = 2 * (px + 0.5 - cx) / (rx * rx), gy = 2 * (py + 0.5 - cy) / (ry * ry);
  let g = Math.sqrt(gx * gx + gy * gy);
  if (g < 1e-9) return f <= 1 ? 1 : 0;
  let dist = (f - 1) / g;
  let cov = 0.5 - dist;
  return cov < 0 ? 0 : cov > 1 ? 1 : cov;
}
function psRectMaskRows(mask, w, y0, y1, rx0, ry0, rx1, ry1, value) {
  let xs = Math.max(0, Math.floor(Math.min(rx0, rx1))), xe = Math.min(w - 1, Math.ceil(Math.max(rx0, rx1)));
  let ax = Math.min(rx0, rx1), bx = Math.max(rx0, rx1), ay = Math.min(ry0, ry1), by = Math.max(ry0, ry1);
  for (let y = y0; y < y1; y++) {
    if (y + 1 <= ay || y >= by) continue;
    for (let x = xs; x <= xe; x++) { let c = psRectCoverage(x, y, ax, ay, bx, by); if (c > 0) mask[y * w + x] = (c * value + 0.5) | 0; }
  }
}
function psEllipseMaskRows(mask, w, y0, y1, rx0, ry0, rx1, ry1, value) {
  let cx = (rx0 + rx1) / 2, cy = (ry0 + ry1) / 2, rx = Math.abs(rx1 - rx0) / 2, ry = Math.abs(ry1 - ry0) / 2;
  let xs = Math.max(0, Math.floor(cx - rx - 1)), xe = Math.min(w - 1, Math.ceil(cx + rx + 1));
  for (let y = y0; y < y1; y++) {
    if (y + 1 < cy - ry - 1 || y > cy + ry + 1) continue;
    for (let x = xs; x <= xe; x++) { let c = psEllipseCoverage(x, y, cx, cy, rx, ry); if (c > 0) mask[y * w + x] = (c * value + 0.5) | 0; }
  }
}
// Polygon fill (even-odd) with 4 vertical subsamples per pixel row; points = [x0, y0, x1, y1, ...].
function psPolygonMaskRows(mask, w, y0, y1, points, value) {
  let n = points.length >> 1;
  if (n < 3) return;
  let xs = new Float64Array(n + 1);
  let cover = new Float32Array(w);
  for (let y = y0; y < y1; y++) {
    for (let x = 0; x < w; x++) cover[x] = 0;
    let any = false;
    for (let s = 0; s < 4; s++) {
      let sy = y + (s + 0.5) / 4;
      let count = 0;
      for (let i = 0; i < n; i++) {
        let ax = points[i * 2], ay = points[i * 2 + 1], j = (i + 1) % n, bx = points[j * 2], by = points[j * 2 + 1];
        if ((ay <= sy && by > sy) || (by <= sy && ay > sy)) xs[count++] = ax + (sy - ay) * (bx - ax) / (by - ay);
      }
      if (count < 2) continue;
      // insertion sort of crossings
      for (let i = 1; i < count; i++) { let v = xs[i], k = i - 1; while (k >= 0 && xs[k] > v) { xs[k + 1] = xs[k]; k--; } xs[k + 1] = v; }
      for (let i = 0; i + 1 < count; i += 2) {
        let xa = xs[i], xb = xs[i + 1];
        if (xb <= 0 || xa >= w) continue;
        if (xa < 0) xa = 0; if (xb > w) xb = w;
        let ia = Math.floor(xa), ib = Math.floor(xb);
        if (ia === ib) { cover[ia] += (xb - xa) * 0.25; any = true; continue; }
        cover[ia] += (ia + 1 - xa) * 0.25;
        for (let x = ia + 1; x < ib && x < w; x++) cover[x] += 0.25;
        if (ib < w) cover[ib] += (xb - ib) * 0.25;
        any = true;
      }
    }
    if (!any) continue;
    let row = y * w;
    for (let x = 0; x < w; x++) { let c = cover[x]; if (c > 0) { if (c > 1) c = 1; mask[row + x] = (c * value + 0.5) | 0; } }
  }
}
// Combine a new shape mask into the current selection: mode "replace" | "add" | "subtract" | "intersect".
function psCombineMaskRows(current, shape, w, y0, y1, mode) {
  let s = y0 * w, e = y1 * w;
  if (mode === "add") { for (let p = s; p < e; p++) { let v = current[p] + shape[p]; current[p] = v > 255 ? 255 : v; } }
  else if (mode === "subtract") { for (let p = s; p < e; p++) { let v = current[p] - shape[p]; current[p] = v < 0 ? 0 : v; } }
  else if (mode === "intersect") { for (let p = s; p < e; p++) current[p] = (current[p] * shape[p] + 127) / 255 | 0; }
  else { for (let p = s; p < e; p++) current[p] = shape[p]; }
}

// Source-over a solid colour with per-pixel alpha (coverage * opacity * selection) onto a layer. Rows [y0, y1).
// coverageFn(x, y) -> 0..1. Used by shapes, gradients and bucket fills.
function psPaintRows(data, w, y0, y1, rgb, opacity, selection, coverageFn, xs, xe) {
  let cr = rgb[0], cg = rgb[1], cb = rgb[2];
  for (let y = y0; y < y1; y++) {
    for (let x = xs; x <= xe; x++) {
      let cov = coverageFn(x, y);
      if (cov <= 0) continue;
      let p = y * w + x;
      let a = cov * opacity * (selection ? selection[p] / 255 : 1);
      if (a <= 0) continue;
      if (a > 1) a = 1;
      let i = p * 4;
      let da = data[i + 3] / 255;
      let oa = a + da * (1 - a);
      if (oa <= 0) continue;
      let wS = a / oa, wD = 1 - wS;
      data[i] = (cr * wS + data[i] * wD + 0.5) | 0; data[i + 1] = (cg * wS + data[i + 1] * wD + 0.5) | 0; data[i + 2] = (cb * wS + data[i + 2] * wD + 0.5) | 0;
      data[i + 3] = (oa * 255 + 0.5) | 0;
    }
  }
}
// Source-over a per-pixel colour (gradient) onto a layer.
function psGradientRows(data, w, y0, y1, gx0, gy0, gx1, gy1, radial, c0, c1, opacity, selection) {
  let dx = gx1 - gx0, dy = gy1 - gy0;
  let len2 = dx * dx + dy * dy;
  if (len2 < 1) { dx = 1; dy = 0; len2 = 1; }
  let len = Math.sqrt(len2);
  for (let y = y0; y < y1; y++) {
    for (let x = 0; x < w; x++) {
      let px = x + 0.5 - gx0, py = y + 0.5 - gy0;
      let t = radial ? Math.sqrt(px * px + py * py) / len : (px * dx + py * dy) / len2;
      if (t < 0) t = 0; else if (t > 1) t = 1;
      let p = y * w + x;
      let a = opacity * (selection ? selection[p] / 255 : 1);
      if (a <= 0) continue;
      let r = c0[0] + (c1[0] - c0[0]) * t, g = c0[1] + (c1[1] - c0[1]) * t, b = c0[2] + (c1[2] - c0[2]) * t;
      let i = p * 4;
      let da = data[i + 3] / 255;
      let oa = a + da * (1 - a);
      let wS = a / oa, wD = 1 - wS;
      data[i] = (r * wS + data[i] * wD + 0.5) | 0; data[i + 1] = (g * wS + data[i + 1] * wD + 0.5) | 0; data[i + 2] = (b * wS + data[i + 2] * wD + 0.5) | 0;
      data[i + 3] = (oa * 255 + 0.5) | 0;
    }
  }
}
// Erase (destination-out) by a mask with opacity, rows [y0, y1).
function psEraseRows(data, w, y0, y1, mask, opacity) {
  for (let p = y0 * w, end = y1 * w; p < end; p++) {
    let m = mask ? mask[p] : 255;
    if (!m) continue;
    let i = p * 4;
    let a = data[i + 3];
    if (!a) continue;
    let keep = 1 - (m / 255) * opacity;
    data[i + 3] = (a * keep + 0.5) | 0;
    if (data[i + 3] === 0) { data[i] = 0; data[i + 1] = 0; data[i + 2] = 0; }
  }
}
// Apply a layer mask permanently: alpha *= mask/255.
function psApplyMaskRows(data, w, y0, y1, mask) {
  for (let p = y0 * w, end = y1 * w; p < end; p++) {
    let i = p * 4, m = mask[p];
    if (m === 255) continue;
    data[i + 3] = (data[i + 3] * m + 127) / 255 | 0;
    if (data[i + 3] === 0) { data[i] = 0; data[i + 1] = 0; data[i + 2] = 0; }
  }
}

// Distance from point to segment.
function psSegmentDistance(px, py, ax, ay, bx, by) {
  let vx = bx - ax, vy = by - ay, wx = px - ax, wy = py - ay;
  let len2 = vx * vx + vy * vy;
  let t = len2 > 0 ? (wx * vx + wy * vy) / len2 : 0;
  if (t < 0) t = 0; else if (t > 1) t = 1;
  let dx = px - (ax + vx * t), dy = py - (ay + vy * t);
  return Math.sqrt(dx * dx + dy * dy);
}
