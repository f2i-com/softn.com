// Protocol.ui — what actually happens between the text box and the speaker.

<Stack direction=vertical gap=md if={currentPage === "protocol"}>

  <Card className="ww-hard" padding=lg style={{ background: "#fffaf0", borderRadius: "0" }}>
    <Stack direction=vertical gap=md>
      <Text style={{ fontSize: "1.375rem", fontWeight: 700, letterSpacing: "-0.04em", lineHeight: 1.05 }}>
        One message. Many wires.
      </Text>
      <Text style={{ fontSize: "0.875rem", color: "#3d4f58", lineHeight: 1.6 }}>
        QXW is an open experiment in moving the same message across very different
        physical links. WarbleWire is the first of them: it turns protected data into
        an audible synthetic birdsong and reconstructs it at the other end. Radio,
        screen-to-camera, QR and direct local transfer are the wires that would follow.
      </Text>
    </Stack>
  </Card>

  <Grid columns={{ sm: 1, lg: 2 }} gap=md>

    <Card className="ww-hard" padding=lg style={{ background: "#f4eddc", borderRadius: "0" }}>
      <Stack direction=vertical gap=sm>
        <Text className="ww-mono" style={{ fontSize: "0.625rem", color: "#6d7f88" }}>The path down</Text>
        <Stack direction=vertical gap=xs>
          <Text className="ww-mono" style={{ fontSize: "0.6875rem" }}>UTF-8 text, up to 52 bytes</Text>
          <Text style={{ color: "#6d7f88" }}>↓</Text>
          <Text className="ww-mono" style={{ fontSize: "0.6875rem" }}>64-byte frame · mini-header + CRC-32</Text>
          <Text style={{ color: "#6d7f88" }}>↓</Text>
          <Text className="ww-mono" style={{ fontSize: "0.6875rem" }}>rate-½ convolutional code + tail</Text>
          <Text style={{ color: "#6d7f88" }}>↓</Text>
          <Text className="ww-mono" style={{ fontSize: "0.6875rem" }}>28 × 37 block interleave</Text>
          <Text style={{ color: "#6d7f88" }}>↓</Text>
          <Text className="ww-mono" style={{ fontSize: "0.6875rem" }}>259 data + 8 pilot Pip-16 symbols</Text>
          <Text style={{ color: "#6d7f88" }}>↓</Text>
          <Text className="ww-mono" style={{ fontSize: "0.6875rem" }}>48 kHz PCM · a bird that never existed</Text>
        </Stack>
      </Stack>
    </Card>

    <Card className="ww-hard" padding=lg style={{ background: "#f4eddc", borderRadius: "0" }}>
      <Stack direction=vertical gap=md>
        <Text className="ww-mono" style={{ fontSize: "0.625rem", color: "#6d7f88" }}>Pip-16</Text>

        <Stack direction=vertical gap=xs>
          <Text style={{ fontSize: "0.875rem", fontWeight: 700, letterSpacing: "-0.02em" }}>One call, four bits</Text>
          <Text style={{ fontSize: "0.8125rem", color: "#3d4f58", lineHeight: 1.55 }}>
            Every symbol is one short bird call carrying four bits.
          </Text>
        </Stack>

        <Stack direction=vertical gap=xs>
          <Text style={{ fontSize: "0.875rem", fontWeight: 700, letterSpacing: "-0.02em" }}>Register and shape</Text>
          <Text style={{ fontSize: "0.8125rem", color: "#3d4f58", lineHeight: 1.55 }}>
            The low two bits pick the register and the high two pick how the pitch
            moves across it: rising, falling, a peak, or a double warble.
          </Text>
        </Stack>

        <Stack direction=vertical gap=xs>
          <Text style={{ fontSize: "0.875rem", fontWeight: 700, letterSpacing: "-0.02em" }}>Spoken names</Text>
          <Text style={{ fontSize: "0.8125rem", color: "#3d4f58", lineHeight: 1.55 }}>
            Each symbol has a name from a four-by-four table, so a frame can be read
            aloud; the decoder never uses them.
          </Text>
          <Text className="ww-mono" style={{ fontSize: "0.75rem", color: "#18262d" }}>pi te ka wo …</Text>
        </Stack>

        <Stack direction=vertical gap=xs>
          <Text style={{ fontSize: "0.875rem", fontWeight: 700, letterSpacing: "-0.02em" }}>Pilots</Text>
          <Text style={{ fontSize: "0.8125rem", color: "#3d4f58", lineHeight: 1.55 }}>
            Eight of the 267 symbols sit at known positions with known values, which is
            how the decoder finds a burst in a recording that starts with silence.
          </Text>
        </Stack>
      </Stack>
    </Card>
  </Grid>

  // ── The numbers ───────────────────────────────────────────────────────────
  <Card className="ww-hard" padding=lg style={{ background: "#20343d", borderRadius: "0", color: "#f4eddc" }}>
    <Stack direction=vertical gap=sm>
      <Text className="ww-mono" style={{ fontSize: "0.625rem", color: "#a9dce8" }}>By the numbers</Text>

      <Stack direction=vertical gap=none>
        <Box style={{ display: "flex", justifyContent: "space-between", gap: "1rem", padding: "0.5rem 0", borderBottom: "1px solid #3f4f57" }}>
          <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#a9dce8", flexShrink: 0 }}>Payload</Text>
          <Text className="ww-mono" style={{ fontSize: "0.625rem", textAlign: "right" }}>up to 52 bytes in a 64-byte frame · CRC-32</Text>
        </Box>
        <Box style={{ display: "flex", justifyContent: "space-between", gap: "1rem", padding: "0.5rem 0", borderBottom: "1px solid #3f4f57" }}>
          <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#a9dce8", flexShrink: 0 }}>Code</Text>
          <Text className="ww-mono" style={{ fontSize: "0.625rem", textAlign: "right" }}>rate-½ convolutional + tail</Text>
        </Box>
        <Box style={{ display: "flex", justifyContent: "space-between", gap: "1rem", padding: "0.5rem 0", borderBottom: "1px solid #3f4f57" }}>
          <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#a9dce8", flexShrink: 0 }}>Interleave</Text>
          <Text className="ww-mono" style={{ fontSize: "0.625rem", textAlign: "right" }}>28 × 37 block</Text>
        </Box>
        <Box style={{ display: "flex", justifyContent: "space-between", gap: "1rem", padding: "0.5rem 0", borderBottom: "1px solid #3f4f57" }}>
          <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#a9dce8", flexShrink: 0 }}>Frame</Text>
          <Text className="ww-mono" style={{ fontSize: "0.625rem", textAlign: "right" }}>267 symbols · 259 data + 8 pilots</Text>
        </Box>
        <Box style={{ display: "flex", justifyContent: "space-between", gap: "1rem", padding: "0.5rem 0", borderBottom: "1px solid #3f4f57" }}>
          <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#a9dce8", flexShrink: 0 }}>Registers</Text>
          <Text className="ww-mono" style={{ fontSize: "0.625rem", textAlign: "right" }}>875 · 1312.5 · 1750 · 2187.5 Hz</Text>
        </Box>
        #each (choice in speeds)
          <Box style={{ display: "flex", justifyContent: "space-between", gap: "1rem", padding: "0.5rem 0", borderBottom: "1px solid #3f4f57" }}>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#a9dce8", flexShrink: 0 }}>{choice.name}</Text>
            <Text className="ww-mono" style={{ fontSize: "0.625rem", textAlign: "right" }}>
              {choice.symbolMs + " ms symbols · " + choice.rawBitRate + " raw bit/s · " + choice.seconds + " s per frame"}
            </Text>
          </Box>
        #end
        <Box style={{ display: "flex", justifyContent: "space-between", gap: "1rem", padding: "0.5rem 0" }}>
          <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#a9dce8", flexShrink: 0 }}>Sample rate</Text>
          <Text className="ww-mono" style={{ fontSize: "0.625rem", textAlign: "right" }}>48 kHz PCM</Text>
        </Box>
      </Stack>
    </Stack>
  </Card>

  <Text style={{ fontSize: "0.6875rem", color: "#6d7f88", lineHeight: 1.5 }}>
    These constants are provisional lab tempos, not a frozen wire standard, and QXW is an
    experiment rather than a life-safety communications system.
  </Text>
</Stack>
