Options -Indexes -MultiViews
DirectoryIndex index.php
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
# The library is included by index.php; it is not an entry point.
<FilesMatch "^softn-serve\.php$">
    Require all denied
</FilesMatch>
# Nothing of the private directory belongs here, and if it is copied here by
# mistake it must still not be downloadable.
<FilesMatch "\.(softn|key|cache)$">
    Require all denied
</FilesMatch>
AddType application/wasm .wasm
AddType text/javascript .mjs
# The optional backend: /api/... is answered by api.php once backend/ is set
# up, and the Authorization header reaches PHP under CGI and FastCGI.
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^api(?:/.*)?$ api.php [END]
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # The same cross-origin isolation softn.com sends for this shell: it gives
    # the page SharedArrayBuffer, which the CPU language-model provider uses
    # to run on every core instead of one. credentialless rather than
    # require-corp, so images and model files from other origins keep working
    # without CORP headers. An app must behave the same here as on the site.
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "credentialless"
    # The service worker may control the whole directory and must never be stale.
    <FilesMatch "^sw\.js$">
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
