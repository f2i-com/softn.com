// LeaveModal.ui - Confirm leave: unseat or return to lobby

<Modal open={showLeaveModal} onClose={closeLeaveModal} title="Leave Table" size=sm>
  <Stack direction=vertical gap=lg style={{ padding: "1rem 0", alignItems: "center", textAlign: "center" }}>

    <Text style={{ color: "rgba(255,255,255,0.7)", fontSize: "14px", maxWidth: "280px" }}>
      Would you like to leave your seat or return to the lobby?
    </Text>

    <Stack direction=vertical gap=sm style={{ width: "100%" }}>
      <Button @click={leaveUnseat} style={{
        background: "rgba(255,255,255,0.08)",
        color: "rgba(255,255,255,0.8)",
        border: "1px solid rgba(255,255,255,0.15)",
        borderRadius: "8px",
        padding: "12px 20px",
        fontSize: "14px",
        fontWeight: "600",
        cursor: "pointer",
        width: "100%"
      }}>
        Leave Seat
      </Button>
      <Text style={{ color: "rgba(255,255,255,0.4)", fontSize: "11px" }}>
        Stand up but stay in the room to watch or re-sit
      </Text>

      <Box style={{ height: "4px" }} />

      <Button @click={leaveLobby} style={{
        background: "rgba(220,80,80,0.15)",
        color: "#e05555",
        border: "1px solid rgba(220,80,80,0.3)",
        borderRadius: "8px",
        padding: "12px 20px",
        fontSize: "14px",
        fontWeight: "600",
        cursor: "pointer",
        width: "100%"
      }}>
        Return to Lobby
      </Button>
      <Text style={{ color: "rgba(255,255,255,0.4)", fontSize: "11px" }}>
        Disconnect from the room entirely
      </Text>
    </Stack>

    <Button @click={closeLeaveModal} style={{
      background: "none",
      color: "rgba(255,255,255,0.4)",
      border: "none",
      padding: "8px 16px",
      fontSize: "13px",
      cursor: "pointer"
    }}>
      Cancel
    </Button>
  </Stack>
</Modal>
