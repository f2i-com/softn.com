{
  "name": "PhotoStudio",
  "version": "0.2.0",
  "description": "Layered image editor with PNG, JPEG, GIF, BMP and PSD import/export, running entirely inside the Softn sandbox. Brushes, selections, masks, blend modes, adjustments, transforms and bitmap type, with undo history.",
  "author": "Photo Studio contributors",
  "main": "ui/main.ui",
  "icon": "assets/icon.svg",
  "files": {
    "ui": ["ui/main.ui"],
    "logic": [
      "logic/ps_core.logic",
      "logic/ps_inflate.logic",
      "logic/ps_png.logic",
      "logic/ps_gifbmp.logic",
      "logic/ps_jpeg.logic",
      "logic/ps_psd.logic",
      "logic/ps_pixels.logic",
      "logic/ps_fontdata.logic",
      "logic/ps_font.logic",
      "logic/ps_editor.logic",
      "logic/main.logic"
    ],
    "assets": ["assets/icon.svg"],
    "xdb": []
  },
  "config": {
    "window": { "title": "Photo Studio", "width": 1440, "height": 960, "minWidth": 360, "minHeight": 520, "resizable": true },
    "theme": { "mode": "dark", "primary": "#b2a0ff" },
    "execution": "main"
  }
}
