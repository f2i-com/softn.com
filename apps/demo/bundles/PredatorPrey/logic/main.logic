// Predator-Prey Sustainable Ecosystem 3D Simulation Logic

// Simulation State
let isRunning = true;
let simSpeed = 1;
let simTick = 0;
let dayCount = 1;
let season = "Spring";
let ecosystemStatus = "Dynamic Equilibrium";
let statusColor = "#22c55e";

// Selected Entity for Inspector
let selectedId = "";
let selectedEntity = null;
let inspectorOpen = false;

// Camera State
let cameraMode = "overview"; // "overview", "topdown", "follow", "cinematic"
let cameraPos = { x: 0, y: 26.0, z: 28.0 };
let cameraLookAt = { x: 0, y: 0.5, z: 0 };
let cameraFov = 46;
let cinematicAngle = 0.0;

// Collections
let rabbits = [];
let foxes = [];
let grassList = [];
let particlePuffs = [];

// Statistics & Trends
let rabbitCount = 0;
let foxCount = 0;
let grassCount = 0;
let totalPreyBorn = 0;
let totalPredBorn = 0;
let totalHunts = 0;

// Pre-computed visual sparkline bars (14 columns)
let sparkPreyBars = [30, 35, 40, 38, 42, 45, 41, 37, 34, 38, 42, 44, 40, 38];
let sparkFoxBars = [20, 22, 25, 28, 30, 27, 24, 21, 18, 22, 26, 28, 25, 24];
let sparkGrassBars = [60, 58, 55, 52, 50, 54, 58, 62, 65, 61, 57, 54, 56, 58];

// Dynamic Scene collections
let objects = [];
let lights = [];

// Expanded World Bounds: 42.0 x 42.0 Floating Biome Island (-19.0 to +19.0)
const BOUNDS = 18.5;

// River geometry: curved river running diagonally across the island
function isRiver(x, z) {
  let riverCenterZ = x * 0.45 - 2.5;
  let distToCenter = Math.abs(z - riverCenterZ);
  // Footbridge allows crossing at x = 0
  let isBridge = Math.abs(x) < 2.0 && Math.abs(z - (-2.5)) < 1.6;
  if (isBridge) return false;
  return distToCenter < 2.2;
}

// Forest cover detection (Refuges where rabbits are harder to hunt)
function hasForestCover(x, z) {
  // Pine forest in North-West
  let nwForest = x < -6.0 && z < -5.0;
  // Oak grove in South-East
  let seGrove = x > 6.0 && z > 5.0;
  // Rocky crags in South-West
  let swRocks = x < -7.0 && z > 6.0;
  return nwForest || seGrove || swRocks;
}

let nextEntityId = 1;
function genId(prefix) {
  let id = prefix + "-" + nextEntityId;
  nextEntityId = nextEntityId + 1;
  return id;
}

// Build 3D Static Scenery (Expanded 42x42 Floating Island Meadow Reserve)
function buildStaticMeadow() {
  let list = [];

  // 1. Layered Floating Island Deck
  // Top Meadow Turf (Lush green deck with natural bevel)
  list.push({
    id: "meadow-turf",
    type: "box",
    width: 42.0,
    height: 0.6,
    depth: 42.0,
    position: { x: 0, y: 0.3, z: 0 },
    color: "#15803d",
    receiveShadow: true,
    roughness: 0.9
  });
  // Rich Earth Strata
  list.push({
    id: "meadow-earth",
    type: "box",
    width: 41.4,
    height: 1.4,
    depth: 41.4,
    position: { x: 0, y: -0.7, z: 0 },
    color: "#78350f",
    roughness: 0.95
  });
  // Dark Bedrock Cliffs
  list.push({
    id: "meadow-bedrock",
    type: "box",
    width: 40.5,
    height: 3.2,
    depth: 40.5,
    position: { x: 0, y: -3.0, z: 0 },
    color: "#334155",
    roughness: 0.8
  });

  // 2. Winding River Water Channel
  list.push({
    id: "river-water",
    type: "box",
    width: 44.0,
    height: 0.12,
    depth: 4.2,
    position: { x: 0, y: 0.54, z: -2.5 },
    rotation: { x: 0, y: -0.42, z: 0 },
    color: "#0284c7",
    opacity: 0.88,
    metalness: 0.35,
    roughness: 0.1
  });

  // Timber Footbridge across the river at the center
  list.push({
    id: "bridge-deck",
    type: "box",
    width: 3.2,
    height: 0.15,
    depth: 4.8,
    position: { x: 0, y: 0.68, z: -2.5 },
    color: "#92400e",
    castShadow: true,
    receiveShadow: true
  });
  // Bridge handrails
  list.push({
    id: "bridge-rail-l",
    type: "box",
    width: 0.1,
    height: 0.5,
    depth: 4.8,
    position: { x: -1.5, y: 0.95, z: -2.5 },
    color: "#78350f"
  });
  list.push({
    id: "bridge-rail-r",
    type: "box",
    width: 0.1,
    height: 0.5,
    depth: 4.8,
    position: { x: 1.5, y: 0.95, z: -2.5 },
    color: "#78350f"
  });

  // Floating Lily Pads on river
  let lilypads = [
    { x: -7.5, z: -6.2 },
    { x: -5.8, z: -5.0 },
    { x: 5.5, z: -0.2 },
    { x: 8.2, z: 1.2 }
  ];
  for (let l = 0; l < lilypads.length; l = l + 1) {
    list.push({
      id: "lilypad-" + l,
      type: "cylinder",
      radius: 0.35,
      height: 0.04,
      position: { x: lilypads[l].x, y: 0.62, z: lilypads[l].z },
      color: "#22c55e"
    });
    list.push({
      id: "lilypad-flower-" + l,
      type: "sphere",
      radius: 0.09,
      position: { x: lilypads[l].x, y: 0.66, z: lilypads[l].z },
      color: "#ffffff"
    });
  }

  // 3. Dense Pine Forest (North-West) & Deciduous Groves (South-East)
  let treeList = [
    // NW Pine Forest (Prey refuge)
    { x: -14.5, z: -13.5, type: "pine", scale: 1.2 },
    { x: -11.0, z: -15.2, type: "pine", scale: 1.4 },
    { x: -15.2, z: -10.0, type: "pine", scale: 1.1 },
    { x: -10.5, z: -9.5, type: "pine", scale: 1.3 },
    { x: -8.0, z: -13.0, type: "pine", scale: 1.0 },
    { x: -13.0, z: -6.5, type: "pine", scale: 1.1 },

    // SE Oak Grove (Prey refuge)
    { x: 12.0, z: 12.5, type: "oak", scale: 1.3 },
    { x: 15.5, z: 10.2, type: "oak", scale: 1.2 },
    { x: 11.2, z: 15.8, type: "oak", scale: 1.4 },
    { x: 8.5, z: 13.0, type: "oak", scale: 1.1 },
    { x: 14.0, z: 7.5, type: "oak", scale: 1.0 },

    // Perimeter Border Trees
    { x: -17.5, z: 0, type: "pine", scale: 1.2 },
    { x: 17.5, z: -5.0, type: "pine", scale: 1.3 },
    { x: 0, z: 17.5, type: "oak", scale: 1.2 },
    { x: 0, z: -17.5, type: "pine", scale: 1.3 },
    { x: -16.0, z: 15.0, type: "pine", scale: 1.1 },
    { x: 16.0, z: -15.0, type: "pine", scale: 1.2 }
  ];

  for (let t = 0; t < treeList.length; t = t + 1) {
    let tr = treeList[t];
    // Trunk
    list.push({
      id: "tree-trunk-" + t,
      type: "cylinder",
      radius: 0.26 * tr.scale,
      height: 2.0 * tr.scale,
      position: { x: tr.x, y: 0.6 + (2.0 * tr.scale) / 2, z: tr.z },
      color: "#5c3a21"
    });
    if (tr.type === "pine") {
      list.push({
        id: "tree-cone-1-" + t,
        type: "cone",
        radius: 1.4 * tr.scale,
        height: 2.0 * tr.scale,
        position: { x: tr.x, y: 0.6 + 1.8 * tr.scale, z: tr.z },
        color: "#14532d",
        castShadow: true
      });
      list.push({
        id: "tree-cone-2-" + t,
        type: "cone",
        radius: 1.0 * tr.scale,
        height: 1.8 * tr.scale,
        position: { x: tr.x, y: 0.6 + 3.0 * tr.scale, z: tr.z },
        color: "#166534",
        castShadow: true
      });
    } else {
      list.push({
        id: "tree-foliage-" + t,
        type: "sphere",
        radius: 1.5 * tr.scale,
        position: { x: tr.x, y: 0.6 + 2.8 * tr.scale, z: tr.z },
        color: "#15803d",
        castShadow: true
      });
    }
  }

  // 4. Mossy Granite Boulder Outcrops (South-West Rocky Refuge)
  let boulders = [
    { x: -12.5, z: 11.5, r: 1.2 },
    { x: -11.0, z: 13.2, r: 0.85 },
    { x: -14.0, z: 9.8, r: 0.95 },
    { x: 7.5, z: -10.5, r: 1.1 },
    { x: 9.0, z: -9.0, r: 0.75 },
    { x: -3.5, z: 7.5, r: 0.8 }
  ];
  for (let b = 0; b < boulders.length; b = b + 1) {
    list.push({
      id: "boulder-" + b,
      type: "sphere",
      radius: boulders[b].r,
      position: { x: boulders[b].x, y: 0.6 + boulders[b].r * 0.45, z: boulders[b].z },
      color: "#64748b",
      roughness: 0.85,
      castShadow: true
    });
  }

  // 5. Wooden Perimeter Fence Posts around Island Edge
  let fenceSpacing = 3.5;
  let fCount = 0;
  for (let x = -BOUNDS; x <= BOUNDS; x = x + fenceSpacing) {
    list.push({
      id: "fence-n-" + fCount,
      type: "cylinder",
      radius: 0.08,
      height: 0.8,
      position: { x: x, y: 0.9, z: -BOUNDS },
      color: "#78350f"
    });
    list.push({
      id: "fence-s-" + fCount,
      type: "cylinder",
      radius: 0.08,
      height: 0.8,
      position: { x: x, y: 0.9, z: BOUNDS },
      color: "#78350f"
    });
    fCount = fCount + 1;
  }

  return list;
}

const staticObjects = buildStaticMeadow();

// Spawn Rabbit
function addRabbit(x, z, initialEnergy) {
  let posX = x !== undefined ? x : (Math.random() - 0.5) * BOUNDS * 1.8;
  let posZ = z !== undefined ? z : (Math.random() - 0.5) * BOUNDS * 1.8;
  if (isRiver(posX, posZ)) {
    posX = posX + 3.0;
  }
  let id = genId("prey");
  rabbits.push({
    id: id,
    name: "Hare #" + id.split("-")[1],
    x: posX,
    z: posZ,
    y: 0.62,
    vx: (Math.random() - 0.5) * 0.05,
    vz: (Math.random() - 0.5) * 0.05,
    rot: Math.random() * Math.PI * 2,
    energy: initialEnergy || 28,
    maxEnergy: 55,
    age: 0,
    maxAge: 1600 + Math.floor(Math.random() * 400),
    state: "Wandering",
    hopPhase: Math.random() * Math.PI * 2,
    offspringCount: 0
  });
  rabbitCount = rabbits.length;
}

// Spawn Fox
function addFox(x, z, initialEnergy) {
  let posX = x !== undefined ? x : (Math.random() - 0.5) * BOUNDS * 1.8;
  let posZ = z !== undefined ? z : (Math.random() - 0.5) * BOUNDS * 1.8;
  if (isRiver(posX, posZ)) {
    posX = posX - 3.0;
  }
  let id = genId("pred");
  foxes.push({
    id: id,
    name: "Fox #" + id.split("-")[1],
    x: posX,
    z: posZ,
    y: 0.65,
    vx: (Math.random() - 0.5) * 0.06,
    vz: (Math.random() - 0.5) * 0.06,
    rot: Math.random() * Math.PI * 2,
    energy: initialEnergy || 42,
    maxEnergy: 80,
    age: 0,
    maxAge: 2200 + Math.floor(Math.random() * 600),
    state: "Stalking",
    runPhase: Math.random() * Math.PI * 2,
    targetId: null,
    catchCount: 0,
    satiatedTicks: 0,
    offspringCount: 0
  });
  foxCount = foxes.length;
}

// Initialize 110 Grass Patches across the vast 42x42 Meadow
function initGrassGrid() {
  grassList = [];
  let numPatches = 110;
  for (let i = 0; i < numPatches; i = i + 1) {
    let gx = (Math.random() - 0.5) * BOUNDS * 1.9;
    let gz = (Math.random() - 0.5) * BOUNDS * 1.9;
    if (isRiver(gx, gz)) {
      gx = gx + 3.2;
    }
    grassList.push({
      id: "grass-" + i,
      x: gx,
      z: gz,
      nutrition: Math.floor(Math.random() * 3) + 1, // 1 to 3
      maxNutrition: 3,
      regrowTimer: Math.random() * 4.0
    });
  }
  grassCount = grassList.length;
}

// Particle System
function spawnPuff(x, y, z, color, count) {
  let c = count || 6;
  for (let i = 0; i < c; i = i + 1) {
    particlePuffs.push({
      x: x,
      y: y + 0.2,
      z: z,
      vx: (Math.random() - 0.5) * 0.08,
      vy: 0.04 + Math.random() * 0.06,
      vz: (Math.random() - 0.5) * 0.08,
      color: color || "#ffffff",
      life: 0,
      maxLife: 20 + Math.floor(Math.random() * 15)
    });
  }
}

function updateParticles() {
  let kept = [];
  for (let i = 0; i < particlePuffs.length; i = i + 1) {
    let p = particlePuffs[i];
    p.life = p.life + 1;
    if (p.life < p.maxLife) {
      p.x = p.x + p.vx;
      p.y = p.y + p.vy;
      p.z = p.z + p.vz;
      p.vy = p.vy * 0.95;
      kept.push(p);
    }
  }
  particlePuffs = kept;
}

// Reset Ecosystem Scenarios
function resetScenario(type) {
  rabbits = [];
  foxes = [];
  particlePuffs = [];
  simTick = 0;
  dayCount = 1;
  selectedId = "";
  selectedEntity = null;
  inspectorOpen = false;
  initGrassGrid();

  if (type === "rabbit_boom") {
    // Prey explosion scenario
    for (let i = 0; i < 50; i = i + 1) addRabbit();
    for (let i = 0; i < 3; i = i + 1) addFox();
  } else if (type === "predator_pack") {
    // Apex pack scenario
    for (let i = 0; i < 28; i = i + 1) addRabbit();
    for (let i = 0; i < 16; i = i + 1) addFox();
  } else if (type === "sparse") {
    // Sparse survival scenario
    for (let i = 0; i < 18; i = i + 1) addRabbit();
    for (let i = 0; i < 4; i = i + 1) addFox();
  } else {
    // Perfectly Balanced Dynamic Equilibrium Scenario
    for (let i = 0; i < 36; i = i + 1) addRabbit();
    for (let i = 0; i < 8; i = i + 1) addFox();
  }

  updateStats();
}

function dist(x1, z1, x2, z2) {
  return Math.hypot(x1 - x2, z1 - z2);
}

// Sustainable Ecosystem Physics & Agent AI Step
function updateEcosystem(delta) {
  simTick = simTick + 1;
  if (simTick % 200 === 0) {
    dayCount = dayCount + 1;
    let seasons = ["Spring", "Summer", "Autumn", "Winter"];
    season = seasons[Math.floor(dayCount / 6) % 4];
  }

  // 1. Dynamic Grass Growth & Carrying Capacity
  let matureGrassCount = 0;
  for (let g = 0; g < grassList.length; g = g + 1) {
    let grass = grassList[g];
    if (grass.nutrition < grass.maxNutrition) {
      // Regrowth speed modulated by season
      let regrowSpeed = season === "Spring" ? 1.4 : (season === "Winter" ? 0.35 : 1.0);
      grass.regrowTimer = grass.regrowTimer + delta * regrowSpeed;
      if (grass.regrowTimer > 5.5) {
        grass.nutrition = grass.nutrition + 1;
        grass.regrowTimer = 0;
      }
    }
    if (grass.nutrition > 0) matureGrassCount = matureGrassCount + 1;
  }
  grassCount = matureGrassCount;

  // 2. Rabbits (Prey) AI, Foraging & Natural Selection
  let survivingRabbits = [];
  let newRabbits = [];

  for (let r = 0; r < rabbits.length; r = r + 1) {
    let rab = rabbits[r];
    rab.age = rab.age + 1;
    let isFleeing = rab.state === "Fleeing";
    rab.hopPhase = rab.hopPhase + delta * (isFleeing ? 13.0 : 7.0);
    rab.y = 0.62 + Math.abs(Math.sin(rab.hopPhase)) * (isFleeing ? 0.28 : 0.16);

    // Forest cover reduces threat exposure
    let inCover = hasForestCover(rab.x, rab.z);

    // Find nearest predator (Threat Detection)
    let nearestFox = null;
    let detectionRadius = inCover ? 3.5 : 6.8; // Cover protects prey!
    let minFoxDist = detectionRadius;

    for (let f = 0; f < foxes.length; f = f + 1) {
      let fox = foxes[f];
      // Satiated foxes resting don't trigger extreme panic
      if (fox.satiatedTicks <= 0) {
        let d = dist(rab.x, rab.z, fox.x, fox.z);
        if (d < minFoxDist) {
          minFoxDist = d;
          nearestFox = fox;
        }
      }
    }

    if (nearestFox) {
      // FLEE! Sprint directly away from predator
      rab.state = "Fleeing";
      let dx = rab.x - nearestFox.x;
      let dz = rab.z - nearestFox.z;
      let len = Math.hypot(dx, dz) || 1;
      let sprintSpeed = 0.155;
      rab.vx = (dx / len) * sprintSpeed;
      rab.vz = (dz / len) * sprintSpeed;
      rab.rot = Math.atan2(rab.vx, rab.vz);
      rab.energy = rab.energy - 0.065 * delta * 30;
    } else {
      // SAFE: Seek Grass or Wander
      let nearestGrass = null;
      let minGrassDist = 8.5;
      for (let g = 0; g < grassList.length; g = g + 1) {
        if (grassList[g].nutrition > 0) {
          let d = dist(rab.x, rab.z, grassList[g].x, grassList[g].z);
          if (d < minGrassDist) {
            minGrassDist = d;
            nearestGrass = grassList[g];
          }
        }
      }

      if (nearestGrass && rab.energy < 44) {
        rab.state = "Grazing";
        let dx = nearestGrass.x - rab.x;
        let dz = nearestGrass.z - rab.z;
        let len = Math.hypot(dx, dz) || 1;
        if (len < 0.6) {
          // Nibble grass
          rab.energy = Math.min(rab.maxEnergy, rab.energy + 12.0);
          nearestGrass.nutrition = nearestGrass.nutrition - 1;
          spawnPuff(rab.x, rab.y, rab.z, "#22c55e", 4);
          rab.vx = 0;
          rab.vz = 0;
        } else {
          let wanderSpeed = 0.075;
          rab.vx = (dx / len) * wanderSpeed;
          rab.vz = (dz / len) * wanderSpeed;
          rab.rot = Math.atan2(rab.vx, rab.vz);
        }
      } else {
        rab.state = "Wandering";
        if (Math.random() < 0.04) {
          rab.rot = rab.rot + (Math.random() - 0.5) * 1.4;
          let speed = 0.042;
          rab.vx = Math.sin(rab.rot) * speed;
          rab.vz = Math.cos(rab.rot) * speed;
        }
      }
      rab.energy = rab.energy - 0.028 * delta * 30;
    }

    // Apply Velocity
    rab.x = rab.x + rab.vx;
    rab.z = rab.z + rab.vz;

    // Meadow Bounds
    if (rab.x > BOUNDS) { rab.x = BOUNDS; rab.vx = -Math.abs(rab.vx); }
    if (rab.x < -BOUNDS) { rab.x = -BOUNDS; rab.vx = Math.abs(rab.vx); }
    if (rab.z > BOUNDS) { rab.z = BOUNDS; rab.vz = -Math.abs(rab.vz); }
    if (rab.z < -BOUNDS) { rab.z = -BOUNDS; rab.vz = Math.abs(rab.vz); }

    // River avoidance (except bridge at x = 0)
    if (isRiver(rab.x, rab.z)) {
      rab.z = rab.z + (rab.z > -2.5 ? 0.3 : -0.3);
      rab.vz = -rab.vz;
    }

    // Self-Balancing Reproduction (Logistic carrying capacity)
    if (rab.energy > 44 && rab.age > 90 && rabbits.length < 75) {
      rab.energy = rab.energy - 18;
      rab.offspringCount = rab.offspringCount + 1;
      totalPreyBorn = totalPreyBorn + 1;
      spawnPuff(rab.x, rab.y + 0.4, rab.z, "#f43f5e", 7);
      newRabbits.push({
        id: genId("prey"),
        name: "Hare #" + totalPreyBorn,
        x: rab.x + (Math.random() - 0.5) * 0.9,
        z: rab.z + (Math.random() - 0.5) * 0.9,
        y: 0.62,
        vx: (Math.random() - 0.5) * 0.05,
        vz: (Math.random() - 0.5) * 0.05,
        rot: Math.random() * Math.PI * 2,
        energy: 22,
        maxEnergy: 55,
        age: 0,
        maxAge: 1600 + Math.floor(Math.random() * 400),
        state: "Wandering",
        hopPhase: 0,
        offspringCount: 0
      });
    }

    // Natural mortality
    if (rab.energy <= 0 || rab.age > rab.maxAge) {
      spawnPuff(rab.x, rab.y, rab.z, "#cbd5e1", 5);
    } else {
      survivingRabbits.push(rab);
    }
  }

  for (let n = 0; n < newRabbits.length; n = n + 1) {
    survivingRabbits.push(newRabbits[n]);
  }
  rabbits = survivingRabbits;

  // 3. Foxes (Predators) AI, Hunting & Satiation
  let survivingFoxes = [];
  let newFoxes = [];
  let eatenRabbitIds = {};

  for (let f = 0; f < foxes.length; f = f + 1) {
    let fox = foxes[f];
    fox.age = fox.age + 1;

    // Satiation timer (After eating, fox rests and digests before hunting again)
    if (fox.satiatedTicks > 0) {
      fox.satiatedTicks = fox.satiatedTicks - 1;
      fox.state = "Satiated";
      fox.runPhase = fox.runPhase + delta * 3.0;
      // Gentle strolling
      if (Math.random() < 0.03) {
        fox.rot = fox.rot + (Math.random() - 0.5) * 0.8;
        let speed = 0.035;
        fox.vx = Math.sin(fox.rot) * speed;
        fox.vz = Math.cos(fox.rot) * speed;
      }
      fox.energy = fox.energy - 0.025 * delta * 30;
    } else {
      fox.runPhase = fox.runPhase + delta * (fox.state === "Hunting" ? 11.0 : 5.5);

      // Search for prey in sight
      let nearestRab = null;
      let minRabDist = 9.5;
      for (let r = 0; r < rabbits.length; r = r + 1) {
        let rab = rabbits[r];
        if (!eatenRabbitIds[rab.id]) {
          let inCover = hasForestCover(rab.x, rab.z);
          // Forest cover reduces predator detection distance
          let effectiveVision = inCover ? 4.8 : minRabDist;
          let d = dist(fox.x, fox.z, rab.x, rab.z);
          if (d < effectiveVision) {
            minRabDist = d;
            nearestRab = rab;
          }
        }
      }

      if (nearestRab) {
        // HUNT!
        fox.state = "Hunting";
        fox.targetId = nearestRab.id;
        let dx = nearestRab.x - fox.x;
        let dz = nearestRab.z - fox.z;
        let len = Math.hypot(dx, dz) || 1;

        if (len < 0.72) {
          // CATCH PREY!
          eatenRabbitIds[nearestRab.id] = true;
          fox.energy = Math.min(fox.maxEnergy, fox.energy + 32.0);
          fox.catchCount = fox.catchCount + 1;
          totalHunts = totalHunts + 1;
          fox.satiatedTicks = 75; // 2.5 seconds resting cooldown
          fox.state = "Satiated";
          spawnPuff(nearestRab.x, nearestRab.y + 0.3, nearestRab.z, "#fb923c", 9);
          fox.vx = 0;
          fox.vz = 0;
        } else {
          let chaseSpeed = 0.138;
          fox.vx = (dx / len) * chaseSpeed;
          fox.vz = (dz / len) * chaseSpeed;
          fox.rot = Math.atan2(fox.vx, fox.vz);
        }
        fox.energy = fox.energy - 0.075 * delta * 30;
      } else {
        // Stalking / Wandering
        fox.state = "Stalking";
        if (Math.random() < 0.035) {
          fox.rot = fox.rot + (Math.random() - 0.5) * 1.1;
          let speed = 0.052;
          fox.vx = Math.sin(fox.rot) * speed;
          fox.vz = Math.cos(fox.rot) * speed;
        }
        fox.energy = fox.energy - 0.040 * delta * 30;
      }
    }

    // Apply Velocity
    fox.x = fox.x + fox.vx;
    fox.z = fox.z + fox.vz;

    // Meadow Bounds
    if (fox.x > BOUNDS) { fox.x = BOUNDS; fox.vx = -Math.abs(fox.vx); }
    if (fox.x < -BOUNDS) { fox.x = -BOUNDS; fox.vx = Math.abs(fox.vx); }
    if (fox.z > BOUNDS) { fox.z = BOUNDS; fox.vz = -Math.abs(fox.vz); }
    if (fox.z < -BOUNDS) { fox.z = -BOUNDS; fox.vz = Math.abs(fox.vz); }

    // River avoidance
    if (isRiver(fox.x, fox.z)) {
      fox.z = fox.z + (fox.z > -2.5 ? 0.3 : -0.3);
      fox.vz = -fox.vz;
    }

    // Fox Reproduction (Calibrated threshold for ecological stability)
    if (fox.energy > 64 && fox.age > 160 && foxes.length < 24) {
      fox.energy = fox.energy - 30;
      fox.offspringCount = fox.offspringCount + 1;
      totalPredBorn = totalPredBorn + 1;
      spawnPuff(fox.x, fox.y + 0.4, fox.z, "#f97316", 8);
      newFoxes.push({
        id: genId("pred"),
        name: "Fox #" + totalPredBorn,
        x: fox.x + (Math.random() - 0.5) * 1.0,
        z: fox.z + (Math.random() - 0.5) * 1.0,
        y: 0.65,
        vx: (Math.random() - 0.5) * 0.06,
        vz: (Math.random() - 0.5) * 0.06,
        rot: Math.random() * Math.PI * 2,
        energy: 36,
        maxEnergy: 80,
        age: 0,
        maxAge: 2200 + Math.floor(Math.random() * 600),
        state: "Stalking",
        runPhase: 0,
        targetId: null,
        catchCount: 0,
        satiatedTicks: 0,
        offspringCount: 0
      });
    }

    // Fox Starvation / Natural Death
    if (fox.energy <= 0 || fox.age > fox.maxAge) {
      spawnPuff(fox.x, fox.y, fox.z, "#94a3b8", 8);
    } else {
      survivingFoxes.push(fox);
    }
  }

  // Remove caught rabbits
  rabbits = rabbits.filter(function(rab) {
    return !eatenRabbitIds[rab.id];
  });

  for (let n = 0; n < newFoxes.length; n = n + 1) {
    survivingFoxes.push(newFoxes[n]);
  }
  foxes = survivingFoxes;

  // Update Statistics
  updateStats();
}

function updateStats() {
  rabbitCount = rabbits.length;
  foxCount = foxes.length;

  // Sustainable Ecological Health Status
  if (rabbitCount === 0 && foxCount === 0) {
    ecosystemStatus = "Ecological Collapse";
    statusColor = "#ef4444";
  } else if (foxCount === 0) {
    ecosystemStatus = "Prey Boom (No Apex Predators)";
    statusColor = "#f59e0b";
  } else if (rabbitCount === 0) {
    ecosystemStatus = "Predator Starvation (No Prey)";
    statusColor = "#dc2626";
  } else if (foxCount >= 14) {
    ecosystemStatus = "Predator Surplus Phase";
    statusColor = "#fb923c";
  } else if (rabbitCount >= 50) {
    ecosystemStatus = "Abundant Prey Phase";
    statusColor = "#38bdf8";
  } else {
    ecosystemStatus = "Dynamic Equilibrium";
    statusColor = "#22c55e";
  }

  // Update pre-computed sparkline trend bars
  if (simTick % 16 === 0) {
    sparkPreyBars.shift();
    sparkPreyBars.push(Math.min(100, Math.round((rabbitCount / 65) * 100)));

    sparkFoxBars.shift();
    sparkFoxBars.push(Math.min(100, Math.round((foxCount / 20) * 100)));

    sparkGrassBars.shift();
    sparkGrassBars.push(Math.min(100, Math.round((grassCount / 110) * 100)));
  }

  // Sync selected entity details
  if (selectedId) {
    let found = null;
    for (let r = 0; r < rabbits.length; r = r + 1) {
      if (rabbits[r].id === selectedId) found = rabbits[r];
    }
    if (!found) {
      for (let f = 0; f < foxes.length; f = f + 1) {
        if (foxes[f].id === selectedId) found = foxes[f];
      }
    }
    selectedEntity = found;
    inspectorOpen = found !== null;
  } else {
    selectedEntity = null;
    inspectorOpen = false;
  }
}

// Build 3D Dynamic Entities
function buildDynamicObjects() {
  let list = [];

  // 1. Dynamic 3D Grass Tufts with Flowers
  for (let g = 0; g < grassList.length; g = g + 1) {
    let gr = grassList[g];
    if (gr.nutrition > 0) {
      let bladeH = 0.28 + gr.nutrition * 0.16;
      list.push({
        id: gr.id + "-tuft",
        type: "cylinder",
        radius: 0.18 + gr.nutrition * 0.08,
        height: bladeH,
        position: { x: gr.x, y: 0.6 + bladeH / 2, z: gr.z },
        color: gr.nutrition === 3 ? "#16a34a" : "#22c55e",
        castShadow: true
      });
      // Blooming Wildflowers on Lush Patches
      if (gr.nutrition === 3) {
        let flowerColor = (g % 3 === 0) ? "#fbbf24" : ((g % 3 === 1) ? "#f43f5e" : "#38bdf8");
        list.push({
          id: gr.id + "-flower",
          type: "sphere",
          radius: 0.11,
          position: { x: gr.x, y: 0.6 + bladeH + 0.08, z: gr.z },
          color: flowerColor
        });
      }
    }
  }

  // 2. 3D Animated White Rabbits (Prey)
  for (let r = 0; r < rabbits.length; r = r + 1) {
    let rab = rabbits[r];
    let isSel = rab.id === selectedId;

    let rabChildren = [
      // Body
      {
        id: rab.id + "-body",
        type: "capsule",
        radius: 0.20,
        height: 0.28,
        position: { x: 0, y: 0.20, z: 0 },
        color: isSel ? "#fef08a" : "#f8fafc",
        castShadow: true
      },
      // Head
      {
        id: rab.id + "-head",
        type: "sphere",
        radius: 0.15,
        position: { x: 0, y: 0.35, z: 0.20 },
        color: isSel ? "#fef08a" : "#f8fafc"
      },
      // Left Ear
      {
        id: rab.id + "-ear-l",
        type: "capsule",
        radius: 0.038,
        height: 0.24,
        position: { x: -0.07, y: 0.52, z: 0.15 },
        rotation: { x: -0.18, y: 0, z: -0.15 },
        color: "#f8fafc"
      },
      {
        id: rab.id + "-ear-in-l",
        type: "capsule",
        radius: 0.022,
        height: 0.18,
        position: { x: -0.07, y: 0.51, z: 0.17 },
        rotation: { x: -0.18, y: 0, z: -0.15 },
        color: "#fda4af"
      },
      // Right Ear
      {
        id: rab.id + "-ear-r",
        type: "capsule",
        radius: 0.038,
        height: 0.24,
        position: { x: 0.07, y: 0.52, z: 0.15 },
        rotation: { x: -0.18, y: 0, z: 0.15 },
        color: "#f8fafc"
      },
      {
        id: rab.id + "-ear-in-r",
        type: "capsule",
        radius: 0.022,
        height: 0.18,
        position: { x: 0.07, y: 0.51, z: 0.17 },
        rotation: { x: -0.18, y: 0, z: 0.15 },
        color: "#fda4af"
      },
      // Eyes
      {
        id: rab.id + "-eye-l",
        type: "sphere",
        radius: 0.028,
        position: { x: -0.10, y: 0.36, z: 0.29 },
        color: "#09090b"
      },
      {
        id: rab.id + "-eye-r",
        type: "sphere",
        radius: 0.028,
        position: { x: 0.10, y: 0.36, z: 0.29 },
        color: "#09090b"
      },
      // Nose
      {
        id: rab.id + "-nose",
        type: "sphere",
        radius: 0.022,
        position: { x: 0, y: 0.32, z: 0.33 },
        color: "#fb7185"
      },
      // Cotton Tail
      {
        id: rab.id + "-tail",
        type: "sphere",
        radius: 0.08,
        position: { x: 0, y: 0.20, z: -0.24 },
        color: "#ffffff"
      }
    ];

    list.push({
      id: rab.id,
      type: "group",
      position: { x: rab.x, y: rab.y, z: rab.z },
      rotation: { x: 0, y: rab.rot, z: 0 },
      cursor: "pointer",
      interactive: true,
      children: rabChildren
    });

    // Glowing Selection Halo
    if (isSel) {
      list.push({
        id: rab.id + "-halo",
        type: "torus",
        radius: 0.48,
        tube: 0.045,
        position: { x: rab.x, y: 0.65, z: rab.z },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: "#fbbf24",
        emissive: "#fbbf24",
        emissiveIntensity: 2.2
      });
    }
  }

  // 3. 3D Animated Russet Foxes (Predators)
  for (let f = 0; f < foxes.length; f = f + 1) {
    let fox = foxes[f];
    let isSel = fox.id === selectedId;

    let foxChildren = [
      // Body
      {
        id: fox.id + "-body",
        type: "capsule",
        radius: 0.22,
        height: 0.54,
        position: { x: 0, y: 0.28, z: 0 },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: isSel ? "#fef08a" : "#ea580c",
        castShadow: true
      },
      // White Chest/Bib
      {
        id: fox.id + "-chest",
        type: "sphere",
        radius: 0.17,
        position: { x: 0, y: 0.24, z: 0.20 },
        color: "#f8fafc"
      },
      // Pointed Muzzle
      {
        id: fox.id + "-head",
        type: "cone",
        radius: 0.17,
        height: 0.35,
        position: { x: 0, y: 0.35, z: 0.38 },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: "#ea580c"
      },
      // Nose
      {
        id: fox.id + "-nose",
        type: "sphere",
        radius: 0.035,
        position: { x: 0, y: 0.35, z: 0.56 },
        color: "#09090b"
      },
      // Eyes
      {
        id: fox.id + "-eye-l",
        type: "sphere",
        radius: 0.032,
        position: { x: -0.10, y: 0.39, z: 0.38 },
        color: "#09090b"
      },
      {
        id: fox.id + "-eye-r",
        type: "sphere",
        radius: 0.032,
        position: { x: 0.10, y: 0.39, z: 0.38 },
        color: "#09090b"
      },
      // Pointed Ears
      {
        id: fox.id + "-ear-l",
        type: "cone",
        radius: 0.065,
        height: 0.18,
        position: { x: -0.11, y: 0.52, z: 0.28 },
        color: "#9a3412"
      },
      {
        id: fox.id + "-ear-r",
        type: "cone",
        radius: 0.065,
        height: 0.18,
        position: { x: 0.11, y: 0.52, z: 0.28 },
        color: "#9a3412"
      },
      // Bushy Tail
      {
        id: fox.id + "-tail",
        type: "capsule",
        radius: 0.12,
        height: 0.44,
        position: { x: 0, y: 0.32, z: -0.44 },
        rotation: { x: -0.55, y: 0, z: 0 },
        color: "#ea580c"
      },
      // White Tail Tip
      {
        id: fox.id + "-tail-tip",
        type: "sphere",
        radius: 0.10,
        position: { x: 0, y: 0.45, z: -0.60 },
        color: "#ffffff"
      }
    ];

    list.push({
      id: fox.id,
      type: "group",
      position: { x: fox.x, y: fox.y, z: fox.z },
      rotation: { x: 0, y: fox.rot, z: 0 },
      cursor: "pointer",
      interactive: true,
      children: foxChildren
    });

    // Selection Halo
    if (isSel) {
      list.push({
        id: fox.id + "-halo",
        type: "torus",
        radius: 0.58,
        tube: 0.045,
        position: { x: fox.x, y: 0.65, z: fox.z },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: "#f97316",
        emissive: "#f97316",
        emissiveIntensity: 2.2
      });
    }
  }

  // 4. Particle Effects
  let particlePos = [];
  for (let p = 0; p < particlePuffs.length; p = p + 1) {
    let pt = particlePuffs[p];
    particlePos.push(pt.x, pt.y, pt.z);
  }
  if (particlePos.length > 0) {
    list.push({
      id: "sim-particles",
      type: "particles",
      particlePositions: particlePos,
      particleSize: 0.24,
      color: "#fef08a",
      opacity: 0.85
    });
  }

  return list;
}

// Build Nature Lighting
function buildLights() {
  let list = [];

  // High Warm Sun
  list.push({
    id: "sun-light",
    type: "directional",
    color: "#fffbeb",
    intensity: 1.55,
    position: { x: 18, y: 32, z: 20 },
    castShadow: true,
    shadowCameraSize: 32,
    shadowBias: -0.0003
  });

  // Cool Sky Fill
  list.push({
    id: "sky-light",
    type: "directional",
    color: "#bae6fd",
    intensity: 0.65,
    position: { x: -20, y: 22, z: -18 }
  });

  // Soft Ambient Meadow Tone
  list.push({
    id: "ambient-light",
    type: "ambient",
    color: "#dcfce7",
    intensity: 0.65
  });

  return list;
}

// Game Step Hook
function gameStep(dt) {
  let delta = dt ? Math.min(dt, 0.1) : 0.033;

  if (isRunning) {
    for (let s = 0; s < simSpeed; s = s + 1) {
      updateEcosystem(delta);
    }
  }

  updateParticles();

  // Dynamic Camera Modes
  if (cameraMode === "follow" && selectedEntity) {
    cameraPos = {
      x: selectedEntity.x - Math.sin(selectedEntity.rot) * 4.5,
      y: selectedEntity.y + 2.8,
      z: selectedEntity.z - Math.cos(selectedEntity.rot) * 4.5
    };
    cameraLookAt = {
      x: selectedEntity.x + Math.sin(selectedEntity.rot) * 2.5,
      y: selectedEntity.y + 0.6,
      z: selectedEntity.z + Math.cos(selectedEntity.rot) * 2.5
    };
  } else if (cameraMode === "cinematic") {
    cinematicAngle = cinematicAngle + delta * 0.10;
    cameraPos = {
      x: Math.sin(cinematicAngle) * 29.0,
      y: 19.0,
      z: Math.cos(cinematicAngle) * 29.0
    };
    cameraLookAt = { x: 0, y: 0.5, z: 0 };
  }

  objects = buildDynamicObjects();
  lights = buildLights();
}

// User Actions
function togglePlay() {
  isRunning = !isRunning;
}

function stepOnce() {
  updateEcosystem(0.033);
  objects = buildDynamicObjects();
}

function setSimSpeed(sp) {
  simSpeed = sp;
}

function setCameraView(mode) {
  cameraMode = mode;
  if (mode === "overview") {
    cameraPos = { x: 0, y: 26.0, z: 28.0 };
    cameraLookAt = { x: 0, y: 0.5, z: 0 };
    cameraFov = 46;
  } else if (mode === "topdown") {
    cameraPos = { x: 0, y: 36.0, z: 0.1 };
    cameraLookAt = { x: 0, y: 0, z: 0 };
    cameraFov = 50;
  } else if (mode === "cinematic") {
    cameraFov = 42;
  }
}

function triggerSpringBloom() {
  for (let g = 0; g < grassList.length; g = g + 1) {
    grassList[g].nutrition = 3;
    grassList[g].regrowTimer = 0;
  }
  spawnPuff(0, 3.0, 0, "#22c55e", 32);
  updateStats();
}

function triggerColdSnap() {
  for (let g = 0; g < grassList.length; g = g + 1) {
    if (Math.random() < 0.65) {
      grassList[g].nutrition = 0;
    }
  }
  spawnPuff(0, 3.0, 0, "#93c5fd", 32);
  updateStats();
}

function spawnPreyAction() {
  addRabbit();
  spawnPuff(0, 1.5, 0, "#f8fafc", 10);
  updateStats();
}

function spawnPredatorAction() {
  addFox();
  spawnPuff(0, 1.5, 0, "#ea580c", 10);
  updateStats();
}

function plantGrassAction() {
  let gx = (Math.random() - 0.5) * BOUNDS * 1.8;
  let gz = (Math.random() - 0.5) * BOUNDS * 1.8;
  grassList.push({
    id: genId("grass"),
    x: gx,
    z: gz,
    nutrition: 3,
    maxNutrition: 3,
    regrowTimer: 0
  });
  spawnPuff(gx, 1.0, gz, "#22c55e", 12);
  updateStats();
}

function closeInspector() {
  selectedId = "";
  selectedEntity = null;
  inspectorOpen = false;
}

// In-World 3D Raycast Click
function handleSceneClick(hit) {
  if (!hit || !hit.objectId) {
    closeInspector();
    return;
  }
  let id = hit.objectId;
  let targetId = id.split("-tuft")[0].split("-body")[0].split("-head")[0].split("-ear")[0].split("-tail")[0];

  for (let r = 0; r < rabbits.length; r = r + 1) {
    if (rabbits[r].id === targetId || id.indexOf(rabbits[r].id) !== -1) {
      selectedId = rabbits[r].id;
      selectedEntity = rabbits[r];
      inspectorOpen = true;
      return;
    }
  }

  for (let f = 0; f < foxes.length; f = f + 1) {
    if (foxes[f].id === targetId || id.indexOf(foxes[f].id) !== -1) {
      selectedId = foxes[f].id;
      selectedEntity = foxes[f];
      inspectorOpen = true;
      return;
    }
  }

  closeInspector();
}

// Initialize on load
resetScenario("balanced");
gameStep(0.033);
