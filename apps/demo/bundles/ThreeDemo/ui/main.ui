<logic src="../logic/main.logic" />

<style>
.td-root { min-height: 100%; background: radial-gradient(120% 80% at 50% 0%, #1a1636 0%, #0a0a1a 60%); padding: 22px 16px 32px; font-family: "Segoe UI", system-ui, sans-serif; color: #e4e4e7; }
.td-wrap { max-width: 960px; margin: 0 auto; }
.td-holder { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 20px 60px rgba(0,0,0,0.45); background: #0a0a1a; }
.td-scene { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.td-hint { position: absolute; left: 12px; bottom: 10px; font-size: 11px; color: rgba(255,255,255,0.6); background: rgba(0,0,0,0.4); padding: 4px 9px; border-radius: 999px; pointer-events: none; }
</style>

<Box className="td-root">
  <Box className="td-wrap">
    <Stack direction="horizontal" gap={12} style={{ alignItems: "baseline", justifyContent: "space-between", flexWrap: "wrap", marginBottom: "12px" }}>
      <Box>
        <Text style={{ display: "block", fontSize: "26px", fontWeight: 800, letterSpacing: "-0.02em", color: "#ffffff" }}>3D Scene</Text>
        <Text style={{ display: "block", fontSize: "13px", color: "#a1a1aa" }}>Drag to look around. Click a shape to select it.</Text>
      </Box>
      <Text style={{ fontSize: "12px", color: "#a1a1aa", fontFamily: "ui-monospace, monospace" }}>{"shapes " + objectCount + " · selected " + (selectedType !== "" ? selectedType : "none")}</Text>
    </Stack>

    <Box className="td-holder">
      <Box className="td-scene">
        <Scene3D
          fill={true}
          objects={objects}
          lights={lights}
          camera={{ position: cameraPos, fov: 50 }}
          antialias={true}
          shadows={true}
          orbitControls={true}
          autoRotate={true}
          autoRotateSpeed={1}
          maxPixelRatio={1.5}
          background="#0a0a1a"
          @click={handleClick}
        />
      </Box>
      <Box className="td-hint"><Text style={{ fontSize: "11px", color: "rgba(255,255,255,0.7)" }}>drag · click</Text></Box>
    </Box>

    <Stack direction="horizontal" gap={8} style={{ flexWrap: "wrap", justifyContent: "center", marginTop: "14px" }}>
      <Button variant="ghost" @click={addShape} style={{ padding: "9px 18px", fontSize: "14px", background: "#f59e0b", color: "#1a1200", border: "1px solid #f59e0b", borderRadius: "8px", fontWeight: 700 }}>Add a shape</Button>
      <Button variant="ghost" @click={randomizeColors} style={{ padding: "9px 18px", fontSize: "14px", background: "rgba(255,255,255,0.06)", color: "#e4e4e7", border: "1px solid rgba(255,255,255,0.14)", borderRadius: "8px", fontWeight: 600 }}>Recolour</Button>
      <Button variant="ghost" @click={toggleWireframe} style={{ padding: "9px 18px", fontSize: "14px", background: "rgba(255,255,255,0.06)", color: "#e4e4e7", border: "1px solid rgba(255,255,255,0.14)", borderRadius: "8px", fontWeight: 600 }}>{showWireframe ? "Solid" : "Wireframe"}</Button>
      <Button variant="ghost" @click={removeSelected} style={{ padding: "9px 18px", fontSize: "14px", background: "rgba(255,255,255,0.06)", color: "#e4e4e7", border: "1px solid rgba(255,255,255,0.14)", borderRadius: "8px", fontWeight: 600 }}>Remove selected</Button>
      <Button variant="ghost" @click={resetScene} style={{ padding: "9px 18px", fontSize: "14px", background: "transparent", color: "#a1a1aa", border: "1px solid rgba(255,255,255,0.1)", borderRadius: "8px", fontWeight: 600 }}>Reset</Button>
    </Stack>
  </Box>
</Box>
