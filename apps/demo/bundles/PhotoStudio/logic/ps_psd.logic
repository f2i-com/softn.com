    mergedRow = y1;
    if (mergedRow >= h) mergedChannel++;
    return mergedChannel >= 4 ? true : (mergedChannel + mergedRow / h) / 4;
  });
  let result = null;
  steps.push(function () {
    // Layer records.
    let records = new PsWriter(4096);
    let channelBlobs = [];
    let ti = 0;
    for (let i = doc.layers.length - 1; i >= 0; i--) {
      let l = doc.layers[i];
      let chans = [{ id: 0 }, { id: 1 }, { id: 2 }, { id: -1 }];
      if (l.mask) chans.push({ id: -2 });
      let blobs = [];
      for (let c = 0; c < chans.length; c++) {
        let o = outputs[ti++];
        let blob = new PsWriter(o.counts.len + o.rows.len + 2);
        blob.u16be(1).bytes(o.counts.finish()).bytes(o.rows.finish());
        blobs.push(blob.finish());
      }
      let extra = new PsWriter(1024);
      if (l.mask) {
        let mask = new PsWriter(20);
        mask.i32be(0).i32be(0).i32be(h).i32be(w).u8(255).u8(l.mask.disabled ? 2 : 0).u8(0).u8(0);
        let mb = mask.finish();
        extra.u32be(mb.length).bytes(mb);
      } else extra.u32be(0);
      extra.u32be(0);
      let name = String(l.name || "Layer").slice(0, 255);
      let ascii = "";
      for (let k = 0; k < name.length; k++) { let code = name.charCodeAt(k); ascii += code >= 32 && code <= 126 ? name[k] : "?"; }
      extra.u8(ascii.length).str(ascii).zero((4 - ((ascii.length + 1) % 4)) % 4);
      let unicode = new PsWriter(4 + name.length * 2);
      unicode.u32be(name.length);
      for (let k = 0; k < name.length; k++) unicode.u16be(name.charCodeAt(k));
      let ub = unicode.finish();
      extra.str("8BIM").str("luni").u32be(ub.length).bytes(ub);
      if (ub.length % 2) extra.zero(1);
      records.i32be(0).i32be(0).i32be(h).i32be(w).u16be(chans.length);
      for (let c = 0; c < chans.length; c++) { records.i16be(chans[c].id).u32be(blobs[c].length); channelBlobs.push(blobs[c]); }
      records.str("8BIM").str(PS_BLEND_TO_PSD[l.blend] || "norm").u8(Math.round(psClamp(l.opacity === undefined ? 1 : l.opacity, 0, 1) * 255));
      records.u8(0).u8((l.visible === false ? 2 : 0) | (l.locked ? 1 : 0)).u8(0);
      let eb = extra.finish();
      records.u32be(eb.length).bytes(eb);
    }
    let info = new PsWriter(4096);
    info.i16be(-doc.layers.length).bytes(records.finish());
    for (let i = 0; i < channelBlobs.length; i++) info.bytes(channelBlobs[i]);
    if (info.len % 2) info.zero(1);
    let infoBytes = info.finish();
    let out = new PsWriter(infoBytes.length + n * 2 + 1024);
    out.str("8BPS").u16be(1).zero(6).u16be(4).u32be(h).u32be(w).u16be(8).u16be(3);
    out.u32be(0).u32be(0);
    out.u32be(infoBytes.length + 4 + 4).u32be(infoBytes.length).bytes(infoBytes).u32be(0);
    out.u16be(1);
    for (let c = 0; c < 4; c++) out.bytes(mergedOut[c].counts.finish());
    for (let c = 0; c < 4; c++) out.bytes(mergedOut[c].rows.finish());
    result = out.finish();
    return true;
  });
  psEnqueue("Writing PSD", psSequence(steps), function () { done(result); }, fail);
}
