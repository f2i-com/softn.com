  ["crop", "Crop", "C"], ["eyedropper", "Eyedropper", "I"], ["brush", "Brush", "B"], ["pencil", "Pencil", "P"], ["eraser", "Eraser", "E"],
  ["clone", "Clone stamp", "S"], ["blur", "Blur brush", "R"], ["sharpen", "Sharpen brush", "Shift+R"], ["smudge", "Smudge", "J"],
  ["dodge", "Dodge", "O"], ["burn", "Burn", "Shift+O"], ["sponge", "Desaturate sponge", "Shift+J"], ["gradient", "Gradient", "G"],
  ["fill", "Paint bucket", "K"], ["text", "Text", "T"], ["rectangle", "Rectangle", "U"], ["ellipse", "Ellipse", "Shift+U"],
  ["line", "Line", "N"], ["hand", "Hand", "H"], ["zoom", "Zoom", "Z"]];
let psIconPaths = {
