// Dead Hours — the game: waves of the dead come through the gates of a yard
// at night, and you hold it with a pistol and a shotgun until you cannot.
//
// Loop: `gameStep` (never tick/update/animate/render, which the runtime may
// drop). Shooting is a ray against each zombie's head sphere and body box,
// occluded by the arena's blockers; the scene's own pointer-locked click is
// only the trigger.

let TICK_MS = 33
let DT = 0.033
let P_EYE = 1.62
let P_R = 0.42
let WALK = 5.2
let SPRINT = 7.6

// Synced to the UI.
let objects = []
let lights = []
let cameraPos = { x: 0, y: 1.62, z: 0 }
let cameraLookAt = { x: 0, y: 1.62, z: 5 }
let sceneFog = { color: "#0b0f1a", near: 14, far: 72 }
let skyColor = "#070a12"
let started = false
let gameOver = false
let paused = false
let showHelp = false
let touchMode = false
let hud = { hp: 100, ammo: 0, reserve: 0, weapon: "Pistol", wave: 0, kills: 0, score: 0, reloading: false, best: 0 }
let waveBanner = ""
let bannerTicks = 0
let toast = ""
let toastTicks = 0
let hurtFlash = 0
let hitMark = 0
let torchOn = true
let finalName = ""
let boardRows = []
let boardStatus = ""
let scorePosted = false

// Player and world state in the VM.
let px = 0
let pz = 4
let vx = 0
let vz = 0
let yaw = Math.PI
let pitch = 0
let hp = 100
let score = 0
let kills = 0
let wave = 0
let waveTimer = 0
let waveState = "between"     // between | active
let toSpawn = 0
let spawnTimer = 0
let zombies = []
let nextZid = 1
let pickups = []
let nextPid = 1
let particles = []
let rngSeed = 7
let lastLocked = false
let bobPhase = 0
let flashTicks = 0
let recoil = 0
let hurtTicks = 0
let attackFlash = 0

// Weapons: fire rate and reload in ticks, damage per shot, pellets per shot.
let weapons = [
  { name: "Pistol", mag: 12, reserve: -1, dmg: 34, pellets: 1, spread: 0.012, rate: 7, reload: 36, sfx: "assets/sfx/pistol.wav" },
  { name: "Shotgun", mag: 6, reserve: 18, dmg: 16, pellets: 8, spread: 0.075, rate: 24, reload: 60, sfx: "assets/sfx/shotgun.wav" }
]
let weaponIdx = 0
let ammo = [12, 6]
let reserve = [-1, 18]
let fireCooldown = 0
let reloadTicks = 0
let triggerHeld = false

let ZTYPES = [
  { name: "walker", hp: 100, speed: 1.9, scale: 1.0, dmg: 10, body: "#526e4e", head: "#869b7f", cloth: "#333d47", score: 100 },
  { name: "runner", hp: 65, speed: 4.1, scale: 0.92, dmg: 7, body: "#991b1b", head: "#b91c1c", cloth: "#450a0a", score: 140 },
  { name: "brute", hp: 320, speed: 1.35, scale: 1.48, dmg: 22, body: "#3f4a3c", head: "#5f6f5a", cloth: "#1e242b", score: 300 }
]

function myRand() {
  rngSeed = (rngSeed * 48271) % 2147483647
  return rngSeed / 2147483647
}

// ---- Init and input ------------------------------------------------------

function isUiControl(e) {
  let tag = e.targetTag || ""
  return tag === "input" || tag === "textarea" || tag === "select" || tag === "button" || !!e.targetEditable
}

function _init() {
  if (window.__dhCleanup) { window.__dhCleanup() }
  rngSeed = (Date.now() % 100000) + 3
  window.__dhKeys = { w: false, a: false, s: false, d: false, sprint: false, fire: false }
  window.__dhFire = false
  window.__dhReload = false
  window.__dhSwap = -1
  window.__dhTouch = false
  window.__scene3dLocked = false
  window.__scene3dWantLock = false
  window.__scene3dReleaseLock = false

  function onKeyDown(e) {
    if (isUiControl(e)) { return }
    let k = window.__dhKeys
    let key = e.key || ""
    if (key === "w" || key === "W" || key === "ArrowUp") { k.w = true; e.preventDefault() }
    else if (key === "s" || key === "S" || key === "ArrowDown") { k.s = true; e.preventDefault() }
    else if (key === "a" || key === "A" || key === "ArrowLeft") { k.a = true; e.preventDefault() }
    else if (key === "d" || key === "D" || key === "ArrowRight") { k.d = true; e.preventDefault() }
    else if (key === "Shift") { k.sprint = true }
    else if (key === "r" || key === "R") { window.__dhReload = true }
    else if (key === "1") { window.__dhSwap = 0 }
    else if (key === "2") { window.__dhSwap = 1 }
    else if (key === "q" || key === "Q") { window.__dhSwap = 2 }
    else if (key === " ") { window.__dhFire = true; e.preventDefault() }
    else if (key === "h" || key === "H") { window.__dhSwap = 3 }
    else if (key === "f" || key === "F") { if (!e.repeat) { window.__dhSwap = 4 } }
  }
  function onKeyUp(e) {
    let k = window.__dhKeys
    let key = e.key || ""
    if (key === "w" || key === "W" || key === "ArrowUp") { k.w = false }
    else if (key === "s" || key === "S" || key === "ArrowDown") { k.s = false }
    else if (key === "a" || key === "A" || key === "ArrowLeft") { k.a = false }
    else if (key === "d" || key === "D" || key === "ArrowRight") { k.d = false }
    else if (key === "Shift") { k.sprint = false }
  }
  function onBlur() {
    window.__dhKeys = { w: false, a: false, s: false, d: false, sprint: false, fire: false }
  }
  function onTouch(e) { window.__dhTouch = true }
  window.addEventListener("keydown", onKeyDown, true)
  window.addEventListener("keyup", onKeyUp, true)
  window.addEventListener("blur", onBlur)
  window.addEventListener("touchstart", onTouch)
  window.__dhCleanup = function () {
    window.removeEventListener("keydown", onKeyDown, true)
    window.removeEventListener("keyup", onKeyUp, true)
    window.removeEventListener("blur", onBlur)
    window.removeEventListener("touchstart", onTouch)
  }

  let best = 0
  try { best = parseInt(localStorage.getItem("deadhours:best") || "0") || 0 } catch (err) { best = 0 }
  try { finalName = localStorage.getItem("deadhours:name") || "" } catch (err) { finalName = "" }
  hud.best = best
  buildArena()
  loadBoard()
  titleAngle = 0
  titleOrbit()
  buildLights()
  composeObjects()
}

// Before the game starts the camera drifts around the yard.
let titleAngle = 0
function titleOrbit() {
  titleAngle = titleAngle + 0.0016
  px = Math.cos(titleAngle) * 15
  pz = Math.sin(titleAngle) * 15
  yaw = Math.atan2(-px, -pz)
  pitch = -0.1
  window.__scene3dYaw = yaw
  window.__scene3dPitch = pitch
  updateCamera(2.6)
}

// ---- Game flow ------------------------------------------------------------

function startGame() {
  px = 0; pz = 4; vx = 0; vz = 0
  yaw = Math.PI; pitch = 0
  hp = 100; score = 0; kills = 0; wave = 0
  zombies = []; pickups = []; particles = []
  weaponIdx = 0
  ammo = [12, 6]
  reserve = [-1, 18]
  fireCooldown = 0; reloadTicks = 0
  toSpawn = 0; spawnTimer = 0
  hurtTicks = 0; hurtFlash = 0; hitMark = 0; recoil = 0; flashTicks = 0; bobPhase = 0
  toast = ""; toastTicks = 0
  waveState = "between"
  waveTimer = Math.ceil(4000 / TICK_MS)
  scorePosted = false
  gameOver = false
  paused = false
  showHelp = false
  started = true
  // Whatever was pressed on the last card must not fire on the first tick.
  window.__dhFire = false
  window.__dhReload = false
  window.__dhSwap = -1
  window.__scene3dYaw = yaw
  window.__scene3dPitch = pitch
  window.__scene3dWantLock = true
  showBanner("Night falls. They are coming.")
  updateCamera(0)
}

function backToTitle() {
  started = false
  gameOver = false
  paused = false
  showHelp = false
  waveBanner = ""; bannerTicks = 0
  toast = ""; toastTicks = 0
  zombies = []
  pickups = []
  particles = []
  loadBoard()
}

function resumeGame() {
  paused = false
  window.__scene3dWantLock = true
}
function toggleHelp() { showHelp = !showHelp }

function showBanner(text) {
  waveBanner = text
  bannerTicks = Math.ceil(2800 / TICK_MS)
}

function showToast(text) {
  toast = text
  toastTicks = Math.ceil(2200 / TICK_MS)
}

function startWave() {
  wave = wave + 1
  waveState = "active"
  toSpawn = 2 + wave * 2 + Math.floor(wave * wave * 0.35)
  spawnTimer = 0
  showBanner("Wave " + wave)
  softn.audio.play("assets/sfx/wave.wav", { volume: 0.5 })
}

function endWave() {
  waveState = "between"
  waveTimer = Math.ceil(7000 / TICK_MS)
  score = score + wave * 150
  showBanner("Wave " + wave + " cleared  ·  +" + (wave * 150))
  // Something to hold the next wave with.
  if (myRand() < 0.7) { dropPickup(px + (myRand() - 0.5) * 6, pz + (myRand() - 0.5) * 6, "shells") }
  if (hp < 70) { dropPickup(px + (myRand() - 0.5) * 6, pz + (myRand() - 0.5) * 6, "medkit") }
}

function die() {
  gameOver = true
  hud.hp = 0
  // The card that follows wants a name typed and a button clicked.
  window.__scene3dReleaseLock = true
  if (score > hud.best) {
    hud.best = score
    try { localStorage.setItem("deadhours:best", String(score)) } catch (err) {}
  }
  softn.audio.play("assets/sfx/hurt.wav", { volume: 0.7 })
}

// ---- The master step ------------------------------------------------------

function gameStep() {
  if (!started) {
    titleOrbit()
    buildLights()
    composeObjects()
    return
  }
  let locked = !!window.__scene3dLocked
  if (lastLocked && !locked && !touchMode && !gameOver) { paused = true }
  lastLocked = locked
  if (window.__dhTouch) { touchMode = true }
  if (bannerTicks > 0) { bannerTicks = bannerTicks - 1; if (bannerTicks === 0) { waveBanner = "" } }
  if (toastTicks > 0) { toastTicks = toastTicks - 1; if (toastTicks === 0) { toast = "" } }
  if (window.__dhSwap === 3) { window.__dhSwap = -1; showHelp = !showHelp }
  if (window.__dhSwap === 4) { window.__dhSwap = -1; torchOn = !torchOn; showToast(torchOn ? "Torch on" : "Torch off"); softn.audio.play("assets/sfx/click.wav", { volume: 0.3 }) }

  if (!paused && !gameOver) {
    if (window.__scene3dYaw !== undefined) { yaw = window.__scene3dYaw }
    if (window.__scene3dPitch !== undefined) { pitch = window.__scene3dPitch }
    handleWeaponInput()
    movePlayer()
    stepWaves()
    stepZombies()
    stepPickups()
    checkPlayer()
  }
  stepParticles()
  if (fireCooldown > 0) { fireCooldown = fireCooldown - 1 }
  if (flashTicks > 0) { flashTicks = flashTicks - 1 }
  if (recoil > 0) { recoil = recoil * 0.72; if (recoil < 0.004) { recoil = 0 } }
  if (hurtTicks > 0) { hurtTicks = hurtTicks - 1 }
  if (hitMark > 0) { hitMark = hitMark - 1 }
  hurtFlash = hurtTicks > 0 ? Math.min(0.55, hurtTicks / 12 * 0.55) : (hp < 30 ? 0.18 + 0.1 * Math.sin(bobPhase * 0.4) : 0)
  updateCamera(0)
  buildLights()
  composeObjects()
  let w = weapons[weaponIdx]
  hud = { hp: Math.max(0, Math.round(hp)), ammo: ammo[weaponIdx], reserve: reserve[weaponIdx], weapon: w.name, wave: wave, kills: kills, score: score, reloading: reloadTicks > 0, best: hud.best,
    countdown: waveState === "between" ? Math.ceil(waveTimer * TICK_MS / 1000) : 0, left: countAlive() + toSpawn }
}

function countAlive() {
  let n = 0
  let i = 0
  while (i < zombies.length) { if (zombies[i].state !== "dead") { n = n + 1 }; i = i + 1 }
  return n
}

function updateCamera(extraY) {
  let bob = 0
  if ((vx * vx + vz * vz) > 1) { bob = Math.sin(bobPhase) * 0.035 }
  cameraPos = { x: px, y: P_EYE + bob + extraY, z: pz }
  let cp = Math.cos(pitch)
  cameraLookAt = { x: px + Math.sin(yaw) * cp * 5, y: P_EYE + extraY + Math.sin(pitch) * 5, z: pz + Math.cos(yaw) * cp * 5 }
}

function movePlayer() {
  let k = window.__dhKeys
  if (!k) { return }
  let fwd = (k.w ? 1 : 0) - (k.s ? 1 : 0)
  let str = (k.d ? 1 : 0) - (k.a ? 1 : 0)
  let len = Math.sqrt(fwd * fwd + str * str)
  if (len > 0) { fwd = fwd / len; str = str / len }
  let speed = k.sprint ? SPRINT : WALK
  let wx = Math.sin(yaw) * fwd - Math.cos(yaw) * str
  let wz = Math.cos(yaw) * fwd + Math.sin(yaw) * str
  vx = vx + (wx * speed - vx) * 0.32
  vz = vz + (wz * speed - vz) * 0.32
  slide(px, pz, vx * DT, vz * DT, P_R)
  px = moveX
  pz = moveZ
  if ((vx * vx + vz * vz) > 1) { bobPhase = bobPhase + 0.3 } else { bobPhase = bobPhase + 0.05 }
}

// ---- Weapons --------------------------------------------------------------

function handleWeaponInput() {
  if (window.__dhSwap === 0 || window.__dhSwap === 1) { swapWeapon(window.__dhSwap); window.__dhSwap = -1 }
  else if (window.__dhSwap === 2) { swapWeapon(weaponIdx === 0 ? 1 : 0); window.__dhSwap = -1 }
  if (window.__dhReload) { window.__dhReload = false; startReload() }
  if (reloadTicks > 0) {
    reloadTicks = reloadTicks - 1
    if (reloadTicks === 0) { finishReload() }
    window.__dhFire = false
    return
  }
  if (window.__dhFire) {
    window.__dhFire = false
    fire()
  }
}

function swapWeapon(i) {
  if (i === weaponIdx) { return }
  // A swap mid-reload abandons the reload; the rounds stay in the box.
  reloadTicks = 0
  weaponIdx = i
  fireCooldown = 8
  showToast(weapons[i].name)
}

function startReload() {
  let w = weapons[weaponIdx]
  if (reloadTicks > 0 || ammo[weaponIdx] >= w.mag) { return }
  if (reserve[weaponIdx] === 0) { showToast("No shells left. Find a box."); return }
  reloadTicks = w.reload
  softn.audio.play("assets/sfx/reload.wav", { volume: 0.5 })
}

function finishReload() {
  let w = weapons[weaponIdx]
  if (reserve[weaponIdx] < 0) { ammo[weaponIdx] = w.mag; return }
  let need = w.mag - ammo[weaponIdx]
  let take = Math.min(need, reserve[weaponIdx])
  ammo[weaponIdx] = ammo[weaponIdx] + take
  reserve[weaponIdx] = reserve[weaponIdx] - take
}

function fire() {
  if (fireCooldown > 0) { return }
  let w = weapons[weaponIdx]
  if (ammo[weaponIdx] <= 0) {
    fireCooldown = 6
    softn.audio.play("assets/sfx/click.wav", { volume: 0.4 })
    if (reserve[weaponIdx] !== 0) { startReload() } else { showToast("Empty.") }
    return
  }
  ammo[weaponIdx] = ammo[weaponIdx] - 1
  fireCooldown = w.rate
  flashTicks = 2
  recoil = weaponIdx === 1 ? 0.16 : 0.07
  softn.audio.play(w.sfx, { volume: weaponIdx === 1 ? 0.75 : 0.6 })
  let cp = Math.cos(pitch)
  let fx = Math.sin(yaw) * cp
  let fy = Math.sin(pitch)
  let fz = Math.cos(yaw) * cp
  // A right vector and an up vector to spread the pellets around the aim.
  let rx = -Math.cos(yaw)
  let rz = Math.sin(yaw)
  let ux = -Math.sin(yaw) * Math.sin(pitch)
  let uy = Math.cos(pitch)
  let uz = -Math.cos(yaw) * Math.sin(pitch)
  let p = 0
  let hitAny = false
  while (p < w.pellets) {
    let sx = (myRand() - 0.5) * 2 * w.spread
    let sy = (myRand() - 0.5) * 2 * w.spread
    let dx = fx + rx * sx + ux * sy
    let dy = fy + uy * sy
    let dz = fz + rz * sx + uz * sy
    let l = Math.sqrt(dx * dx + dy * dy + dz * dz)
    if (shootRay(px, P_EYE, pz, dx / l, dy / l, dz / l, w.dmg)) { hitAny = true }
    p = p + 1
  }
  if (hitAny) { hitMark = 5 }
  if (ammo[weaponIdx] === 0 && reserve[weaponIdx] !== 0) { startReload() }
}

// One pellet: the nearest zombie part along the ray, unless a blocker is
// closer. Returns whether it hit flesh.
function shootRay(ox, oy, oz, dx, dy, dz, dmg) {
  let wall = rayBlockerDist(ox, oy, oz, dx, dy, dz)
  let best = wall
  let bestZ = null
  let headshot = false
  let i = 0
  while (i < zombies.length) {
    let z = zombies[i]
    if (z.state !== "dead") {
      let s = z.scale
      let th = raySphere(ox, oy, oz, dx, dy, dz, z.x, 1.62 * s, z.z, 0.26 * s)
      if (th >= 0 && th < best) { best = th; bestZ = z; headshot = true }
      let tb = rayAabb(ox, oy, oz, dx, dy, dz, z.x - 0.36 * s, 0, z.z - 0.36 * s, z.x + 0.36 * s, 1.42 * s, z.z + 0.36 * s)
      if (tb >= 0 && tb < best) { best = tb; bestZ = z; headshot = false }
    }
    i = i + 1
  }
  if (bestZ === null) {
    if (wall < 60) { spawnPuff(ox + dx * wall, oy + dy * wall, oz + dz * wall, "#6b6f78", 3) }
    return false
  }
  let dealt = headshot ? dmg * 2.2 : dmg
  bestZ.hp = bestZ.hp - dealt
  bestZ.flash = 4
  // A hit shoves the walker back a touch and slows a runner's charge.
  slide(bestZ.x, bestZ.z, dx * 0.12, dz * 0.12, 0.36 * bestZ.scale)
  bestZ.x = moveX
  bestZ.z = moveZ
  spawnPuff(ox + dx * best, oy + dy * best, oz + dz * best, "#7a1b1b", headshot ? 7 : 4)
  if (bestZ.hp <= 0) { killZombie(bestZ, headshot) }
  else { softn.audio.play("assets/sfx/hit.wav", { volume: 0.35 }) }
  return true
}

function killZombie(z, headshot) {
  z.state = "dead"
  z.deadTicks = 0
  kills = kills + 1
  let t = ZTYPES[z.type]
  let gained = t.score + (headshot ? 50 : 0)
  score = score + gained
  if (headshot) { showToast("Headshot  +" + gained) }
  softn.audio.play("assets/sfx/groan.wav", { volume: 0.45, rate: 0.8 + myRand() * 0.4 })
  let roll = myRand()
  if (roll < 0.22) { dropPickup(z.x, z.z, "shells") }
  else if (roll < 0.30) { dropPickup(z.x, z.z, "medkit") }
}

// ---- The dead -------------------------------------------------------------

function stepWaves() {
  if (waveState === "between") {
    waveTimer = waveTimer - 1
    if (waveTimer <= 0) { startWave() }
    return
  }
  if (toSpawn > 0) {
    spawnTimer = spawnTimer - 1
    if (spawnTimer <= 0) {
      spawnZombie()
      toSpawn = toSpawn - 1
      spawnTimer = Math.max(6, Math.ceil((1400 - wave * 90) / TICK_MS))
    }
  } else {
    let alive = 0
    let i = 0
    while (i < zombies.length) { if (zombies[i].state !== "dead") { alive = alive + 1 }; i = i + 1 }
    if (alive === 0) { endWave() }
  }
}

function spawnZombie() {
  let gi = Math.floor(myRand() * gates.length)
  let g = gates[gi]
  let type = 0
  let r = myRand()
  if (wave >= 5 && r < 0.12 + wave * 0.01) { type = 2 }
  else if (wave >= 2 && r < 0.35 + wave * 0.03) { type = 1 }
  let t = ZTYPES[type]
  let mult = 1 + (wave - 1) * 0.06
  zombies.push({
    id: nextZid, type: type, x: g.x + (myRand() - 0.5) * 2, z: g.z + (myRand() - 0.5) * 2,
    hp: t.hp * mult, speed: t.speed * (0.9 + myRand() * 0.25), scale: t.scale * (0.92 + myRand() * 0.16),
    dir: 0, phase: myRand() * 6.28, state: "walk", flash: 0, attackTicks: 0, deadTicks: 0, groan: Math.floor(myRand() * 200), gate: gi,
    side: (nextZid % 2 === 0) ? 1 : -1, stuck: 0, evade: 0
  })
  nextZid = nextZid + 1
}

function stepZombies() {
  let keep = []
  let i = 0
  while (i < zombies.length) {
    let z = zombies[i]
    if (z.state === "dead") {
      z.deadTicks = z.deadTicks + 1
      if (z.deadTicks < 90) { keep.push(z) }
      i = i + 1
      continue
    }
    if (z.flash > 0) { z.flash = z.flash - 1 }
    let dx = px - z.x
    let dz = pz - z.z
    let dist = Math.sqrt(dx * dx + dz * dz)
    // Outside the fence the only way in is the gate it came from: walk to
    // the inside of that gate first, then hunt.
    let outside = Math.abs(z.x) > ARENA - 0.6 || Math.abs(z.z) > ARENA - 0.6
    let tx = dx
    let tz = dz
    if (outside) {
      z.gate = nearestGate(z.x, z.z)
      let g = gates[z.gate]
      let gx = g.x === 0 ? 0 : (g.x > 0 ? ARENA - 2 : -(ARENA - 2))
      let gz = g.z === 0 ? 0 : (g.z > 0 ? ARENA - 2 : -(ARENA - 2))
      tx = gx - z.x
      tz = gz - z.z
      dist = Math.sqrt(tx * tx + tz * tz) + 10
    }
    z.dir = Math.atan2(tx, tz)
    let t = ZTYPES[z.type]
    let reach = 1.15 + 0.3 * z.scale
    if (dist > reach) {
      z.state = "walk"
      let sp = z.speed
      let tl = Math.sqrt(tx * tx + tz * tz)
      let mx = tx / tl * sp
      let mz = tz / tl * sp
      // Keep the pack from stacking: push away from close neighbours. Not
      // while queueing through a gate, where a push means the fence.
      let j = 0
      while (j < zombies.length && !outside) {
        let o = zombies[j]
        if (o !== z && o.state !== "dead") {
          let ox = z.x - o.x
          let oz = z.z - o.z
          let d2 = ox * ox + oz * oz
          if (d2 < 1.2 && d2 > 0.0001) {
            let d = Math.sqrt(d2)
            mx = mx + ox / d * (1.2 - d) * 2.2
            mz = mz + oz / d * (1.2 - d) * 2.2
          }
        }
        j = j + 1
      }
      let rad = 0.36 * z.scale
      slide(z.x, z.z, mx * DT, mz * DT, rad)
      // Progress along the way it wants to go. A wall it creeps along makes
      // some movement but no progress, and that is being stuck too.
      let want = Math.sqrt(mx * mx + mz * mz)
      let prog = want > 0 ? ((moveX - z.x) * mx + (moveZ - z.z) * mz) / want : 0
      if (z.evade > 0 || prog < want * DT * 0.3) {
        // Sidestep, and stay with it for a while so the obstacle's edge is
        // actually reached; when that way is blocked as well (a corner),
        // try the other side.
        if (z.evade <= 0) { z.evade = 24 }
        let sx = -mz * z.side + mx * 0.3
        let sz = mx * z.side + mz * 0.3
        slide(z.x, z.z, sx * DT, sz * DT, rad)
        if (Math.abs(moveX - z.x) + Math.abs(moveZ - z.z) < 0.004) {
          z.stuck = z.stuck + 1
          if (z.stuck > 3) { z.side = -z.side; z.stuck = 0; z.evade = 24 }
        } else {
          z.stuck = 0
        }
        z.evade = z.evade - 1
      } else {
        z.stuck = 0
      }
      z.x = moveX
      z.z = moveZ
      z.phase = z.phase + sp * 0.5 * DT * 6
      z.groan = z.groan - 1
      if (z.groan <= 0) {
        z.groan = 150 + Math.floor(myRand() * 300)
        if (dist < 16) { softn.audio.play("assets/sfx/groan.wav", { volume: Math.max(0.08, 0.35 - dist * 0.015), rate: 0.7 + myRand() * 0.5 }) }
      }
    } else {
      z.state = "attack"
      z.attackTicks = z.attackTicks + 1
      if (z.attackTicks >= 40) {
        z.attackTicks = 0
        hurtPlayer(t.dmg)
      }
    }
    keep.push(z)
    i = i + 1
  }
  zombies = keep
}

function nearestGate(x, z) {
  let best = 0
  let bestD = 1e9
  let i = 0
  while (i < gates.length) {
    let dx = gates[i].x - x
    let dz = gates[i].z - z
    let d = dx * dx + dz * dz
    if (d < bestD) { bestD = d; best = i }
    i = i + 1
  }
  return best
}

function hurtPlayer(dmg) {
  if (gameOver || hurtTicks > 6) { return }
  hp = hp - dmg
  hurtTicks = 12
  softn.audio.play("assets/sfx/hurt.wav", { volume: 0.5 })
  if (hp <= 0) { hp = 0; die() }
}

function checkPlayer() {
  // The fence line is the edge of the yard: a gate is their way in, not your
  // way out. Past it the dead spawn on top of you and the rest lose the path.
  let lim = ARENA - 0.5
  if (px > lim) { px = lim } else if (px < -lim) { px = -lim }
  if (pz > lim) { pz = lim } else if (pz < -lim) { pz = -lim }
}

// ---- Pickups ----------------------------------------------------------------

function dropPickup(x, z, kind) {
  let lim = ARENA - 1
  if (x > lim) { x = lim } else if (x < -lim) { x = -lim }
  if (z > lim) { z = lim } else if (z < -lim) { z = -lim }
  // Not inside a car or a shed, where it could never be picked up.
  let tries = 0
  while (circleBlocked(x, z, 0.3) && tries < 12) {
    let ang = myRand() * Math.PI * 2
    let r = 1.5 + tries * 0.5
    x = Math.max(-lim, Math.min(lim, x + Math.cos(ang) * r))
    z = Math.max(-lim, Math.min(lim, z + Math.sin(ang) * r))
    tries = tries + 1
  }
  if (circleBlocked(x, z, 0.3)) { x = px; z = pz }
  pickups.push({ id: nextPid, x: x, z: z, kind: kind, age: 0 })
  nextPid = nextPid + 1
}

function stepPickups() {
  let keep = []
  let i = 0
  while (i < pickups.length) {
    let p = pickups[i]
    p.age = p.age + 1
    let dx = px - p.x
    let dz = pz - p.z
    if (dx * dx + dz * dz < 1.1) {
      if (p.kind === "shells") {
        reserve[1] = reserve[1] + 8
        showToast("+8 shells")
      } else {
        hp = Math.min(100, hp + 40)
        showToast("Medkit  +40")
      }
      softn.audio.play("assets/sfx/pickup.wav", { volume: 0.5 })
    } else if (p.age < 1500) {
      keep.push(p)
    }
    i = i + 1
  }
  pickups = keep
}

// ---- Particles ---------------------------------------------------------------

function spawnPuff(x, y, z, color, n) {
  let i = 0
  while (i < n) {
    particles.push({ x: x, y: y, z: z, vx: (myRand() - 0.5) * 3, vy: 1 + myRand() * 2.5, vz: (myRand() - 0.5) * 3, life: 10 + Math.floor(myRand() * 8), color: color, size: 0.06 + myRand() * 0.08 })
    i = i + 1
  }
}

function stepParticles() {
  if (particles.length === 0) { return }
  let keep = []
  let i = 0
  while (i < particles.length) {
    let p = particles[i]
    p.vy = p.vy - 14 * DT
    p.x = p.x + p.vx * DT
    p.y = p.y + p.vy * DT
    p.z = p.z + p.vz * DT
    if (p.y < 0.03) { p.y = 0.03; p.vy = 0; p.vx = 0; p.vz = 0 }
    p.life = p.life - 1
    if (p.life > 0) { keep.push(p) }
    i = i + 1
  }
  particles = keep
}

// ---- Lights and objects ------------------------------------------------------

function buildLights() {
  // The torch rides the camera and flickers a little, as a cheap one would.
  let flicker = 0.9 + 0.1 * Math.sin(bobPhase * 2.3) * Math.sin(bobPhase * 0.7)
  let ls = [
    { id: "torch", type: "spot", attach: "camera", color: flashTicks > 0 ? "#ffd9a0" : "#fff1d0", intensity: (started && torchOn ? 420 * flicker : 0) + (flashTicks > 0 ? 900 : 0), angle: flashTicks > 0 ? 0.55 : 0.36, penumbra: 0.55, distance: 42, decay: 1.6, position: { x: -0.28, y: -0.05, z: 0.05 } },
    { id: "hemi", type: "hemisphere", color: "#4c5f8a", groundColor: "#141a22", intensity: 1.15 },
    { id: "moon", type: "directional", color: "#9db2ea", intensity: 0.9, position: { x: -60, y: 55, z: -90 } }
  ]
  let i = 0
  while (i < lampPosts.length) {
    let lp = lampPosts[i]
    ls.push({ id: "lp" + i, type: "point", color: "#ffd88a", intensity: 260, position: { x: lp.x, y: 4.2, z: lp.z } })
    i = i + 1
  }
  lights = ls
}

// A zombie: stylized menacing creature with type-specific silhouettes, glowing predatory eyes,
// claws, armor plates, and blood pool on death.
function zombieObjs(out, z) {
  let t = ZTYPES[z.type]
  let s = z.scale
  let d = z.dir
  let f = { x: Math.sin(d), z: Math.cos(d) }
  let r = { x: Math.cos(d), z: -Math.sin(d) }
  let swing = Math.sin(z.phase) * 0.55
  let lean = (z.type === 1 ? 0.38 : (z.type === 2 ? 0.18 : 0.14))
  let attackPhase = z.state === "attack" ? z.attackTicks / 40 : 0
  let hue = z.flash > 0 ? "#ffffff" : t.body
  let head = z.flash > 0 ? "#ffffff" : t.head
  let cloth = z.flash > 0 ? "#ffffff" : t.cloth
  let id = "z" + z.id

  if (z.state === "dead") {
    let sinkY = -Math.max(0, (z.deadTicks - 40) / 45) * 1.8
    let poolScale = Math.min(1.0, z.deadTicks / 16) * s
    // Glistening dark blood pool beneath fallen body
    out.push({
      id: id + "pool",
      type: "cylinder",
      position: { x: z.x + f.x * 0.3 * s, y: 0.015, z: z.z + f.z * 0.3 * s },
      radius: 0.75 * poolScale,
      height: 0.01,
      color: "#450a0a",
      opacity: 0.88,
      metalness: 0.3,
      roughness: 0.2
    })
    // Fallen prone torso
    out.push({
      id: id + "t",
      type: "box",
      position: { x: z.x + f.x * 0.4 * s, y: sinkY + 0.18 * s, z: z.z + f.z * 0.4 * s },
      rotation: { x: Math.PI / 2, y: d, z: 0 },
      width: 0.58 * s,
      height: 0.72 * s,
      depth: 0.32 * s,
      color: cloth,
      roughness: 0.95
    })
    // Fallen head
    out.push({
      id: id + "h",
      type: "box",
      position: { x: z.x + f.x * 0.95 * s, y: sinkY + 0.2 * s, z: z.z + f.z * 0.95 * s },
      rotation: { x: Math.PI / 2, y: d, z: 0 },
      width: 0.42 * s,
      height: 0.42 * s,
      depth: 0.42 * s,
      color: head,
      roughness: 0.9
    })
    // Dead outstretched arms
    out.push({
      id: id + "a1",
      type: "box",
      position: { x: z.x + r.x * 0.4 * s + f.x * 0.6 * s, y: sinkY + 0.12 * s, z: z.z + r.z * 0.4 * s + f.z * 0.6 * s },
      rotation: { x: Math.PI / 2, y: d - 0.25, z: 0 },
      width: 0.18 * s,
      height: 0.6 * s,
      depth: 0.18 * s,
      color: hue
    })
    out.push({
      id: id + "a2",
      type: "box",
      position: { x: z.x - r.x * 0.4 * s + f.x * 0.6 * s, y: sinkY + 0.12 * s, z: z.z - r.z * 0.4 * s + f.z * 0.6 * s },
      rotation: { x: Math.PI / 2, y: d + 0.25, z: 0 },
      width: 0.18 * s,
      height: 0.6 * s,
      depth: 0.18 * s,
      color: hue
    })
    // Dead legs
    out.push({
      id: id + "l1",
      type: "box",
      position: { x: z.x + r.x * 0.16 * s - f.x * 0.35 * s, y: sinkY + 0.12 * s, z: z.z + r.z * 0.16 * s - f.z * 0.35 * s },
      rotation: { x: Math.PI / 2, y: d, z: 0 },
      width: 0.22 * s,
      height: 0.65 * s,
      depth: 0.22 * s,
      color: cloth
    })
    out.push({
      id: id + "l2",
      type: "box",
      position: { x: z.x - r.x * 0.16 * s - f.x * 0.35 * s, y: sinkY + 0.12 * s, z: z.z - r.z * 0.16 * s - f.z * 0.35 * s },
      rotation: { x: Math.PI / 2, y: d, z: 0 },
      width: 0.22 * s,
      height: 0.65 * s,
      depth: 0.22 * s,
      color: cloth
    })
    return
  }

  if (z.state === "attack") {
    lean = lean + 0.2 + 0.25 * Math.sin(attackPhase * Math.PI * 2)
  }

  // --- TYPE 1: RUNNER (Feral Crimson Stalker) ---
  if (z.type === 1) {
    let hunchedY = 0.82 * s
    // Spiny hunched torso
    out.push({
      id: id + "t",
      type: "box",
      position: { x: z.x - f.x * 0.1 * s, y: hunchedY, z: z.z - f.z * 0.1 * s },
      rotation: { x: lean, y: d, z: 0 },
      width: 0.48 * s,
      height: 0.65 * s,
      depth: 0.32 * s,
      color: hue,
      roughness: 0.8,
      castShadow: true
    })
    // Dorsal spine ridge
    out.push({
      id: id + "spine",
      type: "prism",
      position: { x: z.x - f.x * 0.28 * s, y: hunchedY + 0.15 * s, z: z.z - f.z * 0.28 * s },
      rotation: { x: lean, y: d, z: 0 },
      width: 0.14 * s,
      height: 0.45 * s,
      depth: 0.2 * s,
      color: "#450a0a"
    })
    // Feral snout skull
    let headX = z.x + f.x * 0.32 * s
    let headY = 1.35 * s
    let headZ = z.z + f.z * 0.32 * s
    out.push({
      id: id + "h",
      type: "box",
      position: { x: headX, y: headY, z: headZ },
      rotation: { x: lean * 1.3, y: d, z: 0 },
      width: 0.38 * s,
      height: 0.36 * s,
      depth: 0.46 * s,
      color: head,
      roughness: 0.75,
      castShadow: true
    })
    // Twin blazing demonic crimson eyes
    out.push({
      id: id + "e1",
      type: "box",
      position: { x: headX + r.x * 0.11 * s + f.x * 0.21 * s, y: headY + 0.05 * s, z: headZ + r.z * 0.11 * s + f.z * 0.21 * s },
      rotation: { x: lean * 1.3, y: d, z: 0 },
      width: 0.08 * s,
      height: 0.06 * s,
      depth: 0.05 * s,
      color: "#ff3333",
      emissive: "#ef4444",
      emissiveIntensity: 3.5
    })
    out.push({
      id: id + "e2",
      type: "box",
      position: { x: headX - r.x * 0.11 * s + f.x * 0.21 * s, y: headY + 0.05 * s, z: headZ - r.z * 0.11 * s + f.z * 0.21 * s },
      rotation: { x: lean * 1.3, y: d, z: 0 },
      width: 0.08 * s,
      height: 0.06 * s,
      depth: 0.05 * s,
      color: "#ff3333",
      emissive: "#ef4444",
      emissiveIntensity: 3.5
    })
    // Fanged maw
    out.push({
      id: id + "jaw",
      type: "box",
      position: { x: headX + f.x * 0.2 * s, y: headY - 0.12 * s, z: headZ + f.z * 0.2 * s },
      rotation: { x: lean * 1.3 + 0.2, y: d, z: 0 },
      width: 0.24 * s,
      height: 0.1 * s,
      depth: 0.24 * s,
      color: "#450a0a"
    })
    // Long reaching feral claw arms
    out.push({
      id: id + "a1",
      type: "box",
      position: { x: z.x + r.x * 0.32 * s + f.x * 0.38 * s, y: 0.95 * s + swing * 0.08, z: z.z + r.z * 0.32 * s + f.z * 0.38 * s },
      rotation: { x: -0.9 + swing * 0.4, y: d, z: 0 },
      width: 0.14 * s,
      height: 0.72 * s,
      depth: 0.14 * s,
      color: hue,
      castShadow: true
    })
    out.push({
      id: id + "a2",
      type: "box",
      position: { x: z.x - r.x * 0.32 * s + f.x * 0.38 * s, y: 0.95 * s - swing * 0.08, z: z.z - r.z * 0.32 * s + f.z * 0.38 * s },
      rotation: { x: -0.9 - swing * 0.4, y: d, z: 0 },
      width: 0.14 * s,
      height: 0.72 * s,
      depth: 0.14 * s,
      color: hue,
      castShadow: true
    })
    // Low leaping crouch legs
    out.push({
      id: id + "l1",
      type: "box",
      position: { x: z.x + r.x * 0.16 * s + f.x * swing * 0.15 * s, y: 0.32 * s, z: z.z + r.z * 0.16 * s + f.z * swing * 0.15 * s },
      rotation: { x: swing * 0.7, y: d, z: 0 },
      width: 0.18 * s,
      height: 0.65 * s,
      depth: 0.2 * s,
      color: cloth,
      castShadow: true
    })
    out.push({
      id: id + "l2",
      type: "box",
      position: { x: z.x - r.x * 0.16 * s - f.x * swing * 0.15 * s, y: 0.32 * s, z: z.z - r.z * 0.16 * s - f.z * swing * 0.15 * s },
      rotation: { x: -swing * 0.7, y: d, z: 0 },
      width: 0.18 * s,
      height: 0.65 * s,
      depth: 0.2 * s,
      color: cloth,
      castShadow: true
    })
    return
  }

  // --- TYPE 2: BRUTE (Armored Behemoth) ---
  if (z.type === 2) {
    let chestY = 1.05 * s
    // Massive armored chest & back
    out.push({
      id: id + "t",
      type: "box",
      position: { x: z.x, y: chestY, z: z.z },
      rotation: { x: lean, y: d, z: 0 },
      width: 0.9 * s,
      height: 0.85 * s,
      depth: 0.52 * s,
      color: cloth,
      roughness: 0.9,
      castShadow: true
    })
    // Heavy steel shoulder armor pauldrons
    out.push({
      id: id + "shL",
      type: "box",
      position: { x: z.x + r.x * 0.54 * s, y: chestY + 0.35 * s, z: z.z + r.z * 0.54 * s },
      rotation: { x: lean, y: d, z: -0.2 },
      width: 0.34 * s,
      height: 0.28 * s,
      depth: 0.44 * s,
      color: "#475569",
      texture: "metal",
      metalness: 0.7,
      roughness: 0.4
    })
    out.push({
      id: id + "shR",
      type: "box",
      position: { x: z.x - r.x * 0.54 * s, y: chestY + 0.35 * s, z: z.z - r.z * 0.54 * s },
      rotation: { x: lean, y: d, z: 0.2 },
      width: 0.34 * s,
      height: 0.28 * s,
      depth: 0.44 * s,
      color: "#475569",
      texture: "metal",
      metalness: 0.7,
      roughness: 0.4
    })
    // Armored skull with metal visor
    let headX = z.x + f.x * 0.1 * s
    let headY = 1.72 * s
    let headZ = z.z + f.z * 0.1 * s
    out.push({
      id: id + "h",
      type: "box",
      position: { x: headX, y: headY, z: headZ },
      rotation: { x: lean, y: d, z: 0 },
      width: 0.5 * s,
      height: 0.46 * s,
      depth: 0.48 * s,
      color: head,
      roughness: 0.85,
      castShadow: true
    })
    // Heavy iron forehead plate
    out.push({
      id: id + "helm",
      type: "box",
      position: { x: headX + f.x * 0.21 * s, y: headY + 0.12 * s, z: headZ + f.z * 0.21 * s },
      rotation: { x: lean, y: d, z: 0 },
      width: 0.46 * s,
      height: 0.14 * s,
      depth: 0.12 * s,
      color: "#1e293b",
      texture: "metal",
      metalness: 0.8
    })
    // Piercing blood red eye slit
    out.push({
      id: id + "e",
      type: "box",
      position: { x: headX + f.x * 0.25 * s, y: headY + 0.02 * s, z: headZ + f.z * 0.25 * s },
      rotation: { x: lean, y: d, z: 0 },
      width: 0.36 * s,
      height: 0.08 * s,
      depth: 0.06 * s,
      color: "#ff2222",
      emissive: "#dc2626",
      emissiveIntensity: 4.0
    })
    // Heavy reinforced club arms with iron knuckle bands
    out.push({
      id: id + "a1",
      type: "box",
      position: { x: z.x + r.x * 0.52 * s + f.x * 0.35 * s, y: 1.15 * s + swing * 0.05, z: z.z + r.z * 0.52 * s + f.z * 0.35 * s },
      rotation: { x: -1.2 + swing * 0.25, y: d, z: 0 },
      width: 0.28 * s,
      height: 0.78 * s,
      depth: 0.28 * s,
      color: hue,
      castShadow: true
    })
    out.push({
      id: id + "a2",
      type: "box",
      position: { x: z.x - r.x * 0.52 * s + f.x * 0.35 * s, y: 1.15 * s - swing * 0.05, z: z.z - r.z * 0.52 * s + f.z * 0.35 * s },
      rotation: { x: -1.2 - swing * 0.25, y: d, z: 0 },
      width: 0.28 * s,
      height: 0.78 * s,
      depth: 0.28 * s,
      color: hue,
      castShadow: true
    })
    // Pillar legs
    out.push({
      id: id + "l1",
      type: "box",
      position: { x: z.x + r.x * 0.24 * s + f.x * swing * 0.1 * s, y: 0.36 * s, z: z.z + r.z * 0.24 * s + f.z * swing * 0.1 * s },
      rotation: { x: swing * 0.45, y: d, z: 0 },
      width: 0.3 * s,
      height: 0.72 * s,
      depth: 0.32 * s,
      color: cloth,
      castShadow: true
    })
    out.push({
      id: id + "l2",
      type: "box",
      position: { x: z.x - r.x * 0.24 * s - f.x * swing * 0.1 * s, y: 0.36 * s, z: z.z - r.z * 0.24 * s - f.z * swing * 0.1 * s },
      rotation: { x: -swing * 0.45, y: d, z: 0 },
      width: 0.3 * s,
      height: 0.72 * s,
      depth: 0.32 * s,
      color: cloth,
      castShadow: true
    })
    return
  }

  // --- TYPE 0: WALKER (Classic Rotting Infected Zombie) ---
  // Torso with torn cloth
  out.push({
    id: id + "t",
    type: "box",
    position: { x: z.x, y: 1.0 * s, z: z.z },
    rotation: { x: lean, y: d, z: 0 },
    width: 0.58 * s,
    height: 0.74 * s,
    depth: 0.34 * s,
    color: cloth,
    roughness: 0.95,
    castShadow: true
  })
  // Exposed chest rot
  out.push({
    id: id + "wound",
    type: "box",
    position: { x: z.x + f.x * 0.18 * s, y: 1.05 * s, z: z.z + f.z * 0.18 * s },
    rotation: { x: lean, y: d, z: 0 },
    width: 0.26 * s,
    height: 0.28 * s,
    depth: 0.04 * s,
    color: "#450a0a"
  })
  // Head
  let headX = z.x + f.x * 0.08 * s
  let headY = 1.64 * s
  let headZ = z.z + f.z * 0.08 * s
  out.push({
    id: id + "h",
    type: "box",
    position: { x: headX, y: headY, z: headZ },
    rotation: { x: lean, y: d, z: 0 },
    width: 0.44 * s,
    height: 0.44 * s,
    depth: 0.44 * s,
    color: head,
    roughness: 0.9,
    castShadow: true
  })
  // Twin glowing zombie eyes
  out.push({
    id: id + "e1",
    type: "box",
    position: { x: headX + r.x * 0.12 * s + f.x * 0.23 * s, y: headY + 0.06 * s, z: headZ + r.z * 0.12 * s + f.z * 0.23 * s },
    rotation: { x: lean, y: d, z: 0 },
    width: 0.08 * s,
    height: 0.06 * s,
    depth: 0.04 * s,
    color: "#fef08a",
    emissive: "#eab308",
    emissiveIntensity: 2.8
  })
  out.push({
    id: id + "e2",
    type: "box",
    position: { x: headX - r.x * 0.12 * s + f.x * 0.23 * s, y: headY + 0.06 * s, z: headZ - r.z * 0.12 * s + f.z * 0.23 * s },
    rotation: { x: lean, y: d, z: 0 },
    width: 0.08 * s,
    height: 0.06 * s,
    depth: 0.04 * s,
    color: "#fef08a",
    emissive: "#eab308",
    emissiveIntensity: 2.8
  })
  // Rotting teeth / jaw
  out.push({
    id: id + "jaw",
    type: "box",
    position: { x: headX + f.x * 0.2 * s, y: headY - 0.13 * s, z: headZ + f.z * 0.2 * s },
    rotation: { x: lean + 0.15, y: d, z: 0 },
    width: 0.28 * s,
    height: 0.12 * s,
    depth: 0.16 * s,
    color: "#2a1515"
  })
  // Reaching arms
  out.push({
    id: id + "a1",
    type: "box",
    position: { x: z.x + r.x * 0.38 * s + f.x * 0.34 * s, y: 1.24 * s + swing * 0.05, z: z.z + r.z * 0.38 * s + f.z * 0.34 * s },
    rotation: { x: -1.35 + swing * 0.3, y: d, z: 0 },
    width: 0.16 * s,
    height: 0.65 * s,
    depth: 0.16 * s,
    color: hue,
    castShadow: true
  })
  out.push({
    id: id + "a2",
    type: "box",
    position: { x: z.x - r.x * 0.38 * s + f.x * 0.34 * s, y: 1.24 * s - swing * 0.05, z: z.z - r.z * 0.38 * s + f.z * 0.34 * s },
    rotation: { x: -1.35 - swing * 0.3, y: d, z: 0 },
    width: 0.16 * s,
    height: 0.65 * s,
    depth: 0.16 * s,
    color: hue,
    castShadow: true
  })
  // Shuffling legs
  out.push({
    id: id + "l1",
    type: "box",
    position: { x: z.x + r.x * 0.15 * s + f.x * swing * 0.12 * s, y: 0.34 * s, z: z.z + r.z * 0.15 * s + f.z * swing * 0.12 * s },
    rotation: { x: swing * 0.6, y: d, z: 0 },
    width: 0.22 * s,
    height: 0.68 * s,
    depth: 0.24 * s,
    color: cloth,
    castShadow: true
  })
  out.push({
    id: id + "l2",
    type: "box",
    position: { x: z.x - r.x * 0.15 * s - f.x * swing * 0.12 * s, y: 0.34 * s, z: z.z - r.z * 0.15 * s - f.z * swing * 0.12 * s },
    rotation: { x: -swing * 0.6, y: d, z: 0 },
    width: 0.22 * s,
    height: 0.68 * s,
    depth: 0.24 * s,
    color: cloth,
    castShadow: true
  })
}

function weaponObjs(out) {
  let kick = recoil
  let sway = Math.sin(bobPhase) * 0.006
  if (weaponIdx === 0) {
    out.push({ id: "gunA", type: "box", attach: "camera", position: { x: 0.27 + sway, y: -0.22 + kick * 0.2, z: -0.55 + kick * 0.6 }, rotation: { x: -kick * 1.4, y: 0, z: 0 }, width: 0.035, height: 0.05, depth: 0.2, color: "#2b2e34", metalness: 0.6, roughness: 0.35 })
    out.push({ id: "gunB", type: "box", attach: "camera", position: { x: 0.27 + sway, y: -0.285 + kick * 0.2, z: -0.48 + kick * 0.6 }, rotation: { x: 0.35 - kick * 1.4, y: 0, z: 0 }, width: 0.032, height: 0.1, depth: 0.05, color: "#4a3626", roughness: 0.8 })
  } else {
    out.push({ id: "gunA", type: "box", attach: "camera", position: { x: 0.26 + sway, y: -0.21 + kick * 0.15, z: -0.62 + kick * 0.6 }, rotation: { x: -kick * 1.1, y: 0, z: 0 }, width: 0.034, height: 0.04, depth: 0.42, color: "#23262b", metalness: 0.6, roughness: 0.3 })
    out.push({ id: "gunB", type: "box", attach: "camera", position: { x: 0.26 + sway, y: -0.245 + kick * 0.15, z: -0.5 + kick * 0.6 }, rotation: { x: -kick * 1.1, y: 0, z: 0 }, width: 0.05, height: 0.06, depth: 0.16, color: "#5c3d24", roughness: 0.8 })
    out.push({ id: "gunC", type: "box", attach: "camera", position: { x: 0.26 + sway, y: -0.3 + kick * 0.15, z: -0.36 + kick * 0.6 }, rotation: { x: 0.5, y: 0, z: 0 }, width: 0.04, height: 0.12, depth: 0.06, color: "#4a3320", roughness: 0.8 })
  }
  if (flashTicks > 0) {
    out.push({ id: "flash", type: "sphere", attach: "camera", position: { x: 0.27, y: -0.2, z: -0.72 }, radius: weaponIdx === 1 ? 0.07 : 0.045, color: "#fff2b0", emissive: "#ffd27a", emissiveIntensity: 3, opacity: 0.9 })
  }
}

function composeObjects() {
  let out = []
  if (started) { weaponObjs(out) }
  let i = 0
  while (i < zombies.length) { zombieObjs(out, zombies[i]); i = i + 1 }
  i = 0
  while (i < pickups.length) {
    let p = pickups[i]
    let bobY = 0.35 + Math.sin(p.age * 0.12) * 0.06
    if (p.kind === "shells") {
      out.push({ id: "pk" + p.id, type: "box", position: { x: p.x, y: bobY, z: p.z }, rotation: { x: 0, y: p.age * 0.03, z: 0 }, width: 0.42, height: 0.28, depth: 0.3, color: "#b23a2a", emissive: "#ff6b3d", emissiveIntensity: 0.35 })
    } else {
      out.push({ id: "pk" + p.id, type: "box", position: { x: p.x, y: bobY, z: p.z }, rotation: { x: 0, y: p.age * 0.03, z: 0 }, width: 0.4, height: 0.24, depth: 0.32, color: "#f2f5f8", emissive: "#4ade80", emissiveIntensity: 0.35 })
      out.push({ id: "pk" + p.id + "x", type: "box", position: { x: p.x, y: bobY + 0.125, z: p.z }, rotation: { x: 0, y: p.age * 0.03, z: 0 }, width: 0.22, height: 0.02, depth: 0.06, color: "#dc2626" })
      out.push({ id: "pk" + p.id + "y", type: "box", position: { x: p.x, y: bobY + 0.125, z: p.z }, rotation: { x: 0, y: p.age * 0.03, z: 0 }, width: 0.06, height: 0.02, depth: 0.22, color: "#dc2626" })
    }
    i = i + 1
  }
  i = 0
  while (i < particles.length) {
    let p = particles[i]
    out.push({ id: "p" + i, type: "box", position: { x: p.x, y: p.y, z: p.z }, width: p.size, height: p.size, depth: p.size, color: p.color, roughness: 1 })
    i = i + 1
  }
  objects = out
}

// ---- Leaderboard and input from the UI --------------------------------------

function onSceneClick(hit) {
  if (!started || paused || gameOver) { return }
  if (hit && hit.locked) {
    if (hit.button === 0) { window.__dhFire = true }
    else if (hit.button === 2) { window.__dhReload = true }
  } else if (touchMode) {
    window.__dhFire = true
  }
}

function padPress(dir) {
  let k = window.__dhKeys
  if (dir === "up") { k.w = true } else if (dir === "down") { k.s = true } else if (dir === "left") { k.a = true } else if (dir === "right") { k.d = true }
}
function padRelease(dir) {
  let k = window.__dhKeys
  if (dir === "up") { k.w = false } else if (dir === "down") { k.s = false } else if (dir === "left") { k.a = false } else if (dir === "right") { k.d = false }
}
function touchFire() { window.__dhFire = true }
function touchReload() { window.__dhReload = true }
function touchSwap() { window.__dhSwap = 2 }
function touchTorch() { window.__dhSwap = 4 }

function setFinalName(v) {
  finalName = String(v).slice(0, 24)
  try { localStorage.setItem("deadhours:name", finalName) } catch (err) {}
}

function postScore() {
  if (scorePosted || score <= 0) { return }
  scorePosted = true
  let name = finalName.trim() === "" ? "Anonymous" : finalName.trim()
  boardStatus = "Posting…"
  softn.storage.insert("scores", { name: name, score: score, wave: wave, kills: kills }, function (r) {
    if (r && r.error) { boardStatus = r.error; scorePosted = false; return }
    loadBoard()
  })
}

function loadBoard() {
  softn.storage.query("scores", { orderBy: ["score", "desc"], limit: 10 }, function (r) {
    if (!r || r.error) {
      boardRows = []
      boardStatus = r && r.error ? r.error : "The leaderboard is not available."
      return
    }
    let rows = []
    let i = 0
    while (i < r.records.length) {
      let rec = r.records[i]
      rows.push({ rank: i + 1, name: rec.data.name, score: rec.data.score, wave: rec.data.wave })
      i = i + 1
    }
    boardRows = rows
    boardStatus = rows.length === 0 ? "No scores yet. Be the first to survive a night." : ""
  })
}
