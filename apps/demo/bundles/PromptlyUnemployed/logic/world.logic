// 3D world: authored grids, first-person movement, scene builders, hotspots,
// confetti, and the dream. Patterns follow MazeEscape3D: axis-separated AABB
// collision over an ASCII grid, camera derived from our own yaw every frame,
// static geometry built once and only dynamic pieces rebuilt per tick.
//
// Look: no engine shadows (the directional shadow frustum is untunable today),
// so depth comes from fog, ceilings, emissive light panels, two-tone walls,
// and a strict colour script per scene.

let CELL = 2
let PLAYER_R = 0.35
let MOVE_SPEED = 0.11
let TURN_SPEED = 0.05

let playerX = 4
let playerZ = 4
let playerAngle = 0
let stepDist = 0
let stepFoot = false
let bobPhase = 0
let bobAmt = 0             // eases toward 1 while walking, 0 while still
let cameraPos = { x: 4, y: 1.6, z: 4 }
let cameraLookAt = { x: 4, y: 1.6, z: 9 }

let objects = []
let lights = []
let sceneFog = { color: "#10141d", near: 18, far: 60 }
let sceneBg = "#0b0f17"

// The office floor. One string per row; width must be uniform.
let OFFICE_ROWS = [
  "################",
  "#....##....#...#",
  "#.S..........B.#",
  "#....##....#...#",
  "#..............#",
  "###..####..##.##",
  "#..............#",
  "#.C........N...#",
  "#....##....#..D#",
  "#....##....#...#",
  "################"
]

let FLAT_ROWS = [
  "##########",
  "#L......P#",
  "#........#",
  "#..##....#",
  "#..##..T.#",
  "#........#",
  "#S.......#",
  "##########"
]

let BAKERY_ROWS = [
  "#############",
  "#..........D#",
  "#.A......B..#",
  "#...####....#",
  "#...#..#..P.#",
  "#.M.####....#",
  "#...........#",
  "#S..........#",
  "#############"
]

let DREAM_ROWS = [
  "############",
  "#..........#",
  "#.S........#",
  "#....W.....#",
  "#..........#",
  "#.........D#",
  "#..........#",
  "############"
]

let grid = []
let gridCols = 0
let gridRows = 0

function loadGrid(rows) {
  gridCols = rows[0].length
  gridRows = rows.length
  grid = []
  for (let r = 0; r < gridRows; r++) {
    if (rows[r].length !== gridCols) { console.error("[PU] grid row " + r + " width mismatch") }
    for (let c = 0; c < gridCols; c++) {
      grid.push(rows[r].charAt(c) === "#" ? 1 : 0)
    }
  }
}

function gridFind(rows, ch) {
  for (let r = 0; r < rows.length; r++) {
    let c = rows[r].indexOf(ch)
    if (c >= 0) { return { x: c * CELL, z: r * CELL } }
  }
  return { x: CELL, z: CELL }
}

function collides(px, pz) {
  let cc = Math.round(px / CELL)
  let cr = Math.round(pz / CELL)
  for (let r = cr - 1; r <= cr + 1; r++) {
    for (let c = cc - 1; c <= cc + 1; c++) {
      if (r < 0 || c < 0 || r >= gridRows || c >= gridCols) { continue }
      if (grid[r * gridCols + c] !== 1) { continue }
      let minX = c * CELL - CELL / 2, maxX = c * CELL + CELL / 2
      let minZ = r * CELL - CELL / 2, maxZ = r * CELL + CELL / 2
      if (px + PLAYER_R > minX && px - PLAYER_R < maxX && pz + PLAYER_R > minZ && pz - PLAYER_R < maxZ) { return true }
    }
  }
  return false
}

// Self-healing spawn: if a scene ever drops the player inside geometry, walk
// them out rather than leaving them wedged with no way to move.
function ensureFree() {
  if (!collides(playerX, playerZ)) { return }
  for (let r = 1; r <= 10; r++) {
    let s = r * 0.4
    let cand = [[s, 0], [-s, 0], [0, s], [0, -s], [s, s], [-s, s], [s, -s], [-s, -s]]
    for (let i = 0; i < cand.length; i++) {
      let nx = playerX + cand[i][0], nz = playerZ + cand[i][1]
      if (!collides(nx, nz)) { playerX = nx; playerZ = nz; updateCamera(); return }
    }
  }
}

function moveTick() {
  ensureFree()
  let keys = window.__puKeys || {}
  if (window.__scene3dYaw !== undefined) { playerAngle = window.__scene3dYaw }
  // Facing +z, screen-right is -x (three.js right-handed), so turning right
  // DECREASES yaw and strafing right subtracts the right-hand vector.
  if (keys.left)  { playerAngle = playerAngle + TURN_SPEED; window.__scene3dYaw = playerAngle }
  if (keys.right) { playerAngle = playerAngle - TURN_SPEED; window.__scene3dYaw = playerAngle }
  let fwd = 0
  if (keys.w) { fwd = fwd + 1 }
  if (keys.s) { fwd = fwd - 1 }
  let strafe = 0
  if (keys.d) { strafe = strafe + 1 }
  if (keys.a) { strafe = strafe - 1 }
  if (fwd !== 0 || strafe !== 0) {
    // Keep diagonal travel at the same speed as a single-axis walk.
    let inputLen = Math.sqrt(fwd * fwd + strafe * strafe)
    fwd = fwd / inputLen
    strafe = strafe / inputLen
    let speed = keys.run ? MOVE_SPEED * 1.6 : MOVE_SPEED
    let dx = (Math.sin(playerAngle) * fwd - Math.cos(playerAngle) * strafe) * speed
    let dz = (Math.cos(playerAngle) * fwd + Math.sin(playerAngle) * strafe) * speed
    let px = playerX, pz = playerZ
    let nx = playerX + dx
    if (!collides(nx, playerZ)) { playerX = nx }
    let nz = playerZ + dz
    if (!collides(playerX, nz)) { playerZ = nz }
    let moved = Math.abs(playerX - px) + Math.abs(playerZ - pz)
    bobPhase = bobPhase + moved * 2.4
    bobAmt = bobAmt + (1 - bobAmt) * 0.18
    stepDist = stepDist + moved
    if (stepDist > 1.15) {
      stepDist = 0
      stepFoot = !stepFoot
      sfx(stepFoot ? "step1" : "step2")
    }
  }
  if (fwd === 0 && strafe === 0) { bobAmt = bobAmt * 0.82 }
  updateCamera()
}

function updateCamera() {
  let sx = 0, sy = 0
  if (shakeAmt > 0.0005) {
    sx = (myRand() - 0.5) * shakeAmt
    sy = (myRand() - 0.5) * shakeAmt
  }
  let bob = Math.sin(bobPhase) * 0.028 * bobAmt
  cameraPos = { x: playerX + sx, y: 1.6 + sy + bob, z: playerZ }
  cameraLookAt = {
    x: playerX + Math.sin(playerAngle) * 5,
    y: 1.55,
    z: playerZ + Math.cos(playerAngle) * 5
  }
}

// ---- Cutscenes ------------------------------------------------------------
// Keyframed camera moves. Direction rides the mouse-look globals, so the same
// path works whether or not the player wiggles the mouse mid-shot.

let cutActive = false
let cutSteps = []
let cutIdx = 0
let cutTickN = 0
let cutEnd = null
let fadeOp = 0
let cutTitle = ""
let cutSub = ""
let shakeAmt = 0

function ease(t) { return t * t * (3 - 2 * t) }
function easeOut(t) { return 1 - (1 - t) * (1 - t) }
function easeIn(t) { return t * t }

// Each step may name a curve: "out" starts fast (arrivals), "in" starts slow
// (departures), default is smoothstep.
function curve(s, t) {
  if (s.e === "out") { return easeOut(t) }
  if (s.e === "in") { return easeIn(t) }
  if (s.e === "hold") { return 0 }
  return ease(t)
}

function shake(amount) { shakeAmt = Math.max(shakeAmt, amount) }

function startCutscene(steps, endX, endZ, endYaw, title, sub) {
  cutSteps = steps
  cutIdx = 0
  cutTickN = 0
  cutEnd = { x: endX, z: endZ, yaw: endYaw }
  cutActive = true
  fadeOp = 0.55
  cutTitle = title || ""
  cutSub = sub || ""
  hsNearId = ""
  hsNearLabel = ""
  applyCutFrame(steps[0], 0)
}

function applyCutFrame(s, t) {
  let e = curve(s, t)
  let sx = 0, sy = 0
  if (shakeAmt > 0.0005) {
    sx = (myRand() - 0.5) * shakeAmt
    sy = (myRand() - 0.5) * shakeAmt
  }
  cameraPos = { x: s.x0 + (s.x1 - s.x0) * e + sx, y: s.y0 + (s.y1 - s.y0) * e + sy, z: s.z0 + (s.z1 - s.z0) * e }
  let yaw = s.yaw0 + (s.yaw1 - s.yaw0) * e
  let pitch = (s.p0 || 0) + ((s.p1 || 0) - (s.p0 || 0)) * e
  window.__scene3dYaw = yaw
  window.__scene3dPitch = pitch
  cameraLookAt = { x: cameraPos.x + Math.sin(yaw) * 5, y: cameraPos.y + Math.sin(pitch) * 5, z: cameraPos.z + Math.cos(yaw) * 5 }
}

function shakeTick() {
  if (shakeAmt > 0) { shakeAmt = Math.max(0, shakeAmt - 0.012) }
}

function cutTickFn() {
  if (!cutActive) { return }
  let s = cutSteps[cutIdx]
  cutTickN = cutTickN + 1
  if (cutTickN >= s.ticks) {
    applyCutFrame(s, 1)
    cutIdx = cutIdx + 1
    cutTickN = 0
    if (cutIdx >= cutSteps.length) { endCutscene() }
    return
  }
  applyCutFrame(s, cutTickN / s.ticks)
}

function endCutscene() {
  cutActive = false
  cutTitle = ""
  cutSub = ""
  if (cutEnd) {
    playerX = cutEnd.x
    playerZ = cutEnd.z
    playerAngle = cutEnd.yaw
    window.__scene3dYaw = playerAngle
    window.__scene3dPitch = 0
  }
  updateCamera()
}

function skipCutscene() { if (cutActive) { endCutscene() } }

// The meeting plays as a directed shot: no free movement, so instead of frozen
// controls the camera drifts toward whoever is speaking. The player can still
// drag to look; the drift gently re-frames rather than fighting them.
function meetingDriftTick() {
  if (scene !== "meeting" || cutActive) { return }
  if (shakeAmt > 0.0005) {
    cameraPos = { x: 6 + (myRand() - 0.5) * shakeAmt, y: 1.6 + (myRand() - 0.5) * shakeAmt, z: 6.6 }
  }
  let tx = 6, ty = 1.7, tz = 0.2
  if (dlgSpeaker === "PAX") { tx = 9.6; ty = 1.9; tz = 0.6 }
  else if (dlgSpeaker === "Clive") { tx = 4.2; ty = 1.4; tz = 4.4 }
  let dx = tx - cameraPos.x, dy = ty - cameraPos.y, dz = tz - cameraPos.z
  let wantYaw = Math.atan2(dx, dz)
  let wantPitch = Math.atan2(dy, Math.sqrt(dx * dx + dz * dz)) * 0.6
  let yaw = window.__scene3dYaw !== undefined ? window.__scene3dYaw : Math.PI
  let d = wantYaw - yaw
  while (d > Math.PI) { d = d - Math.PI * 2 }
  while (d < -Math.PI) { d = d + Math.PI * 2 }
  window.__scene3dYaw = yaw + d * 0.035
  let pitch = window.__scene3dPitch !== undefined ? window.__scene3dPitch : 0
  window.__scene3dPitch = pitch + (wantPitch - pitch) * 0.035
}

// ---- Actors ---------------------------------------------------------------
// Everyone who is not the player. Walkers follow a waypoint ring and pause when
// they arrive; anyone whose speaker name matches the current line moves their
// mouth. Scenes publish sceneStatic once and the tick re-lays only the actors.

let sceneStatic = []
let actors = []
let actorsFor = ""
let actorPhase = 0

// Replace the cast only when the scene actually changes. Builders are re-run
// constantly (every pick, every state change) and must not reset walk cycles.
function ensureActors(tag, list) {
  if (actorsFor === tag) { return }
  actors = list
  actorsFor = tag
}
// Furniture is decoration, not grid, so actors carry their own no-go boxes.
let blockers = []

function actorBlocked(x, z) {
  for (let i = 0; i < blockers.length; i++) {
    let b = blockers[i]
    if (x > b.x - b.hw && x < b.x + b.hw && z > b.z - b.hd && z < b.z + b.hd) { return true }
  }
  return false
}

function actorAt(id, speaker, x, z, dir, body, head, opts) {
  let o = opts || {}
  return { id: id, speaker: speaker || "", x: x, z: z, dir: dir, body: body, head: head,
    hair: o.hair || "", apron: o.apron || "", cap: o.cap || "",
    path: o.path || [], wi: 0, sp: o.sp || 0.028, pause: 0, moving: false, ph: myRand() * 6 }
}

// Send an actor to a spot once, rather than round a ring.
// Send an actor somewhere. faceX/faceZ are optional: on arrival they turn to
// look at that point, so a character who walks over to speak to you ends up
// facing you instead of facing whichever way they happened to be walking.
function actorGoTo(id, x, z, faceX, faceZ) {
  for (let i = 0; i < actors.length; i++) {
    if (actors[i].id !== id) { continue }
    actors[i].path = [[x, z]]
    actors[i].wi = 0
    actors[i].pause = 0
    if (faceX !== undefined) { actors[i].faceAt = [faceX, faceZ] }
    else { actors[i].faceAt = null }
    return
  }
}

function actorObjs() {
  let out = []
  for (let i = 0; i < actors.length; i++) {
    let a = actors[i]
    let talking = 0
    if (dlgActive && a.speaker !== "" && a.speaker === dlgSpeaker) {
      // A crude visime: the jaw opens and closes while the line runs.
      talking = 0.5 + Math.sin(actorPhase * 0.55 + a.ph) * 0.5
    }
    let lift = a.moving ? Math.abs(Math.sin(a.ph * 2)) * 0.035 : 0
    let swing = a.moving ? Math.sin(a.ph * 2) * 0.5 : 0
    out = out.concat(fig(a.id, a.x, a.z, a.dir, a.body, a.head,
      { hair: a.hair, apron: a.apron, cap: a.cap, talk: talking, lift: lift, swing: swing }))
  }
  return out
}

// `objects` carries only what moves. The scenery goes to Scene3D through
// staticObjects, because concatenating it here made every tick rebuild the
// whole room to walk a character across it: 51 KB of scenery through the
// host boundary, ~28 times a second, to move about 8 KB of actors.
function composeScene() {
  let out = actorObjs()
  // Confetti belongs to the meeting alone; it used to follow the player out.
  if (scene === "meeting" && (confettiOn || confetti.length > 0)) { out = out.concat(confettiObjs()) }
  objects = out
}

function clearConfetti() {
  confetti = []
  confettiOn = false
}

function actorTick() {
  if (actors.length === 0) { return }
  actorPhase = actorPhase + 1
  let moved = false
  for (let i = 0; i < actors.length; i++) {
    let a = actors[i]
    if (a.path.length < 1) { continue }
    if (a.pause > 0) {
      a.pause = a.pause - 1
      if (a.moving) { a.moving = false; moved = true }
      continue
    }
    let w = a.path[a.wi]
    let dx = w[0] - a.x, dz = w[1] - a.z
    let d = Math.sqrt(dx * dx + dz * dz)
    if (d < 0.14) {
      if (a.path.length === 1) {
        // Arrived at a one-off destination; stay there, and turn to whoever
        // sent us if the errand named someone to look at.
        if (a.faceAt) {
          let fd = Math.atan2(a.faceAt[0] - a.x, a.faceAt[1] - a.z)
          if (Math.abs(fd - a.dir) > 0.01) { a.dir = fd; moved = true }
        }
        if (a.moving) { a.moving = false; moved = true }
        continue
      }
      a.wi = (a.wi + 1) % a.path.length
      a.pause = 50 + Math.floor(myRand() * 110)
      a.moving = false
    } else {
      let stepX = (dx / d) * a.sp
      let stepZ = (dz / d) * a.sp
      let nx = a.x + stepX, nz = a.z + stepZ
      if (!actorBlocked(nx, nz) && !collides(nx, nz)) {
        a.x = nx; a.z = nz
      } else if (!actorBlocked(nx, a.z) && !collides(nx, a.z)) {
        // Slide along the obstacle rather than through it.
        a.x = nx
      } else if (!actorBlocked(a.x, nz) && !collides(a.x, nz)) {
        a.z = nz
      } else {
        // Boxed in. Rings move on to the next leg; a one-off errand is
        // abandoned after a few tries so the actor never jitters forever.
        a.stuck = (a.stuck || 0) + 1
        if (a.path.length === 1 && a.stuck > 3) { a.path = [] }
        else { a.wi = (a.wi + 1) % a.path.length }
        a.pause = 30
        a.moving = false
        moved = true
        continue
      }
      a.dir = Math.atan2(dx, dz)
      a.moving = true
      a.stuck = 0
      a.ph = a.ph + 0.16
    }
    moved = true
  }
  // Mouths need a redraw even when nobody is walking — but only a mouth that
  // is actually on screen, and only as often as a jaw can be seen to move.
  // This used to rebuild all ~400 objects every frame for the whole of every
  // line, including Alex's, and she has no body in the scene at all: the cost
  // was pure waste and it showed up as the player stuttering while she spoke.
  if (moved || (actorPhase % 3 === 0 && anyoneMouthing())) { composeScene() }
}

function anyoneMouthing() {
  if (!dlgActive) { return false }
  for (let i = 0; i < actors.length; i++) {
    if (actors[i].speaker !== "" && actors[i].speaker === dlgSpeaker) { return true }
  }
  return false
}

// ---- Title diorama --------------------------------------------------------
// A small lit island in the dark, orbited forever. It is the game's whole
// premise in one shot: a desk, a laptop, a duck, and a box you did not pack
// by choice.

let titleAngle = 0.6

function buildTitle() {
  sceneFog = { color: "#0a0d14", near: 6.5, far: 19 }
  sceneBg = "#080b11"
  let objs = [
    { id: "tfloor", type: "plane", position: { x: 0, y: 0, z: 0 }, rotation: { x: -Math.PI / 2, y: 0, z: 0 },
      width: 26, height: 26, color: "#1a212f", roughness: 1 },
    { id: "trug", type: "plane", position: { x: 0, y: 0.01, z: 0.2 }, rotation: { x: -Math.PI / 2, y: 0, z: 0 },
      width: 5.2, height: 4.4, color: "#2b2118" },
    blob("tdesk", 0, 0, 1.5, 0.34)
  ]
  // The desk.
  objs.push({ id: "td_top", type: "box", position: { x: 0, y: 0.74, z: 0 }, width: 2.4, height: 0.07, depth: 1.1, color: "#5c4a3d", roughness: 0.65 })
  objs.push({ id: "td_l1", type: "box", position: { x: -1.05, y: 0.37, z: 0 }, width: 0.09, height: 0.74, depth: 0.95, color: "#41332a" })
  objs.push({ id: "td_l2", type: "box", position: { x: 1.05, y: 0.37, z: 0 }, width: 0.09, height: 0.74, depth: 0.95, color: "#41332a" })
  objs = objs.concat(laptopAt("tlap", -0.15, 0.78, -0.05, Math.PI, "#f59e0b"))
  objs.push({ id: "tmug", type: "cylinder", position: { x: 0.62, y: 0.83, z: 0.22 }, radius: 0.075, height: 0.13, color: "#f8fafc" })
  objs.push({ id: "tmug_h", type: "torus", position: { x: 0.72, y: 0.84, z: 0.22 }, rotation: { x: 0, y: Math.PI / 2, z: 0 }, radius: 0.045, color: "#f8fafc" })
  objs.push({ id: "tduck", type: "sphere", position: { x: -0.95, y: 0.85, z: 0.3 }, radius: 0.11, color: "#facc15", emissive: "#facc15", emissiveIntensity: 0.35 })
  objs.push({ id: "tduck_h", type: "sphere", position: { x: -0.95, y: 0.98, z: 0.28 }, radius: 0.07, color: "#fde047" })
  objs.push({ id: "tduck_b", type: "box", position: { x: -0.95, y: 0.97, z: 0.2 }, width: 0.05, height: 0.03, depth: 0.07, color: "#fb923c" })
  // The lamp that makes the island.
  objs.push({ id: "tlamp_p", type: "cylinder", position: { x: 0.95, y: 1.05, z: -0.32 }, radius: 0.03, height: 0.62, color: "#2a2018" })
  objs.push({ id: "tlamp_h", type: "sphere", position: { x: 0.95, y: 1.42, z: -0.32 }, radius: 0.13, color: "#fbbf6b", emissive: "#fbbf6b", emissiveIntensity: 1.7 })
  // The box. Three items, one box.
  objs.push(blob("tbox", -1.9, 1.1, 0.5, 0.3))
  objs.push({ id: "tbox", type: "box", position: { x: -1.9, y: 0.28, z: 1.1 }, rotation: { x: 0, y: 0.34, z: 0 }, width: 0.9, height: 0.56, depth: 0.7, color: "#8a6f4d" })
  objs.push({ id: "tbox_f", type: "box", position: { x: -1.9, y: 0.57, z: 1.1 }, rotation: { x: 0, y: 0.34, z: 0 }, width: 0.94, height: 0.05, depth: 0.74, color: "#77603f" })
  objs = objs.concat(chairAt("tchair", 0, 1.55, Math.PI, "#2c3547"))
  objs = objs.concat(plantAt("tplant", 2.1, -0.6))
  // Dust in the lamplight.
  for (let i = 0; i < 12; i++) {
    let a = (i / 12) * Math.PI * 2
    objs.push({ id: "tdust" + i, type: "sphere", position: { x: Math.sin(a) * (0.9 + (i % 3) * 0.4), y: 1.0 + (i % 5) * 0.22, z: Math.cos(a) * (0.8 + (i % 4) * 0.35) },
      radius: 0.016, color: "#fde68a", emissive: "#fde68a", emissiveIntensity: 1.2,
      animate: { floatAmplitude: 0.14, floatSpeed: 0.3 + (i % 4) * 0.16 } })
  }
  sceneStatic = objs
  objects = []
  lights = [
    { id: "amb", type: "ambient", color: "#8ea0c4", intensity: 0.5 },
    { id: "lamp", type: "point", color: "#fbbf6b", intensity: 3.2, position: { x: 0.95, y: 1.5, z: -0.32 } },
    { id: "scr", type: "point", color: "#f59e0b", intensity: 1.1, position: { x: -0.15, y: 1.0, z: 0.3 } },
    { id: "rim", type: "directional", color: "#5b7fd4", intensity: 0.85, position: { x: -6, y: 5, z: -7 } }
  ]
  hotspots = []
  titleTick()
}

function titleTick() {
  titleAngle = titleAngle + 0.0022
  let r = 6.1 + Math.sin(titleAngle * 0.7) * 0.45
  cameraPos = { x: Math.sin(titleAngle) * r, y: 2.15 + Math.sin(titleAngle * 0.45) * 0.28, z: Math.cos(titleAngle) * r }
  cameraLookAt = { x: 0, y: 0.62, z: 0.1 }
}

// ---- Hotspots -------------------------------------------------------------

let hotspots = []
let hsNearId = ""
let hsNearLabel = ""

// The hotspot E acts on: within reach, and preferring the one you are facing.
// Distance alone always picked the front row of a cluttered desk — standing
// in front of Doug offered the team photo, and the only way to reach the back
// row was to walk into the furniture. Facing breaks the tie: the score is the
// squared distance scaled by how far off-axis the thing is.
function hotspotTick() {
  let best = ""
  let bestLabel = ""
  let bestScore = 999
  let fx = Math.sin(playerAngle), fz = Math.cos(playerAngle)
  for (let i = 0; i < hotspots.length; i++) {
    let h = hotspots[i]
    if (h.tapOnly) { continue }
    let dx = h.x - playerX, dz = h.z - playerZ
    let d2 = dx * dx + dz * dz
    if (d2 >= h.r * h.r) { continue }
    let d = Math.sqrt(d2)
    let dot = d > 0.05 ? (dx * fx + dz * fz) / d : 1
    let score = d2 * (1.7 - dot)
    if (score < bestScore) { best = h.id; bestLabel = h.label; bestScore = score }
  }
  hsNearId = best
  hsNearLabel = bestLabel
}

function onSceneClick(info) {
  // Tapping the world during a cutscene hands control back, the same as any
  // movement key would.
  if (cutActive) { skipCutscene(); return }
  if (!info || !info.objectId || interactionLocked()) { return }
  for (let i = 0; i < hotspots.length; i++) {
    let h = hotspots[i]
    if (!hotspotObjectMatches(h.id, info.objectId)) { continue }
    let dx = playerX - h.x, dz = playerZ - h.z
    if (dx * dx + dz * dz < h.r * h.r * 2.6) { handleHotspot(h.id) }
    return
  }
}

// Composite props and people have ids such as mabel_chest or window_glass,
// while their logical hotspot is hs_mabel or window. Treat the whole visible
// object (and its beacon) as the tap target instead of requiring one tiny mesh.
function hotspotObjectMatches(hotspotId, objectId) {
  if (objectId === hotspotId || objectId === "mk_" + hotspotId) { return true }
  if (objectId.indexOf(hotspotId + "_") === 0) { return true }
  if (hotspotId.indexOf("hs_") === 0) {
    let bare = hotspotId.slice(3)
    if (objectId === bare || objectId.indexOf(bare + "_") === 0) { return true }
  }
  return false
}

// Traversal-harness teleport: place the player beside a named hotspot.
function warpTo(id) {
  for (let i = 0; i < hotspots.length; i++) {
    if (hotspots[i].id !== id) { continue }
    let h = hotspots[i]
    // Stand inside the hotspot's own radius, or the prompt never appears.
    let d = Math.max(0.55, Math.min(1.2, h.r * 0.6))
    let offs = [[0, d], [0, -d], [d, 0], [-d, 0], [d * 0.7, d * 0.7], [-d * 0.7, d * 0.7]]
    for (let j = 0; j < offs.length; j++) {
      let nx = h.x + offs[j][0], nz = h.z + offs[j][1]
      // Furniture is not in the grid, so check the actor blockers too.
      if (!collides(nx, nz) && !actorBlocked(nx, nz)) { warpLand(nx, nz, h); return }
    }
    for (let j = 0; j < offs.length; j++) {
      let nx = h.x + offs[j][0], nz = h.z + offs[j][1]
      if (!collides(nx, nz)) { warpLand(nx, nz, h); return }
    }
    warpLand(h.x, h.z, h)
  }
}

// Land beside a hotspot facing it, the way a player who walked there would
// be: E picks by facing as well as distance, so a warp that arrived looking
// the other way could be offered a neighbour instead.
function warpLand(nx, nz, h) {
  playerX = nx
  playerZ = nz
  let dx = h.x - nx, dz = h.z - nz
  if (dx * dx + dz * dz > 0.0001) {
    playerAngle = Math.atan2(dx, dz)
    window.__scene3dYaw = playerAngle
  }
  updateCamera()
}

// A slow-turning beacon above every interactive hotspot.
function hotspotMarkers(color) {
  let out = []
  for (let i = 0; i < hotspots.length; i++) {
    let h = hotspots[i]
    if (h.tapOnly) { continue }
    let c = h.minor ? "#5b8db8" : (color || "#fbbf24")
    let my = h.my !== undefined ? h.my : (h.minor ? 1.9 : 2.05)
    // A hotspot's centre is where you stand to use it, which for a desk item
    // is 75cm in front of the item itself. mx/mz let the beacon sit over the
    // object instead of hovering in the air beside it.
    let mx = h.mx !== undefined ? h.mx : h.x
    let mz = h.mz !== undefined ? h.mz : h.z
    out.push({ id: "mk_" + h.id, type: "icosahedron", position: { x: mx, y: my, z: mz }, radius: h.minor ? 0.055 : 0.08,
      color: c, emissive: c, emissiveIntensity: h.minor ? 0.8 : 1.3,
      animate: { rotateY: 0.04, floatAmplitude: 0.06, floatSpeed: 2 } })
  }
  return out
}

// ---- Shared builders ------------------------------------------------------

// Skirting board around a room's perimeter: four thin strips at floor level.
// The cheapest trick in the book for making a box read as a room.
// A rail at chest height. Two strips per room is enough to break up a wall.
function dado(id, w, d, color, y) {
  let o = 1.06
  return [
    { id: id + "_n", type: "box", position: { x: w / 2, y: y, z: o }, width: w - 1.6, height: 0.07, depth: 0.06, color: color },
    { id: id + "_s", type: "box", position: { x: w / 2, y: y, z: d - o }, width: w - 1.6, height: 0.07, depth: 0.06, color: color },
    { id: id + "_w", type: "box", position: { x: o, y: y, z: d / 2 }, width: 0.06, height: 0.07, depth: d - 1.6, color: color },
    { id: id + "_e", type: "box", position: { x: w - o, y: y, z: d / 2 }, width: 0.06, height: 0.07, depth: d - 1.6, color: color }
  ]
}

function skirting(id, w, d, color, h) {
  let t = h || 0.14
  let o = 1.06
  return [
    { id: id + "_n", type: "box", position: { x: w / 2, y: t / 2, z: o }, width: w - 1.6, height: t, depth: 0.1, color: color },
    { id: id + "_s", type: "box", position: { x: w / 2, y: t / 2, z: d - o }, width: w - 1.6, height: t, depth: 0.1, color: color },
    { id: id + "_w", type: "box", position: { x: o, y: t / 2, z: d / 2 }, width: 0.1, height: t, depth: d - 1.6, color: color },
    { id: id + "_e", type: "box", position: { x: w - o, y: t / 2, z: d / 2 }, width: 0.1, height: t, depth: d - 1.6, color: color }
  ]
}

// Ceiling beams: a few long strips read as structure without a full grid.
function ceilingBeams(id, w, d, y, n, color) {
  let out = []
  for (let i = 0; i < n; i++) {
    out.push({ id: id + i, type: "box", position: { x: w / 2, y: y - 0.05, z: (d / (n + 1)) * (i + 1) },
      width: w + 2, height: 0.1, depth: 0.16, color: color })
  }
  return out
}

// A doorway: two jambs and a lintel, optionally with a door leaf hinged on the
// first jamb. openA is the swing in radians — 0 shut, ~1.5 wide open.
function doorwayAt(id, x, z, dir, color, leafColor, openA) {
  let rx = Math.cos(dir), rz = -Math.sin(dir)
  let out = [
    { id: id + "_j1", type: "box", position: { x: x - rx * 0.85, y: 1.1, z: z - rz * 0.85 }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.16, height: 2.2, depth: 0.22, color: color },
    { id: id + "_j2", type: "box", position: { x: x + rx * 0.85, y: 1.1, z: z + rz * 0.85 }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.16, height: 2.2, depth: 0.22, color: color },
    { id: id + "_lin", type: "box", position: { x: x, y: 2.26, z: z }, rotation: { x: 0, y: dir, z: 0 },
      width: 1.86, height: 0.16, depth: 0.22, color: color }
  ]
  if (leafColor) {
    // Hinge the leaf on the first jamb and swing it, instead of floating it
    // across the middle of the opening — a half-open door parked over the
    // threshold is exactly where a visitor ends up standing.
    let th = openA === undefined ? 0.5 : openA
    let phi = dir + th
    let ax = Math.cos(phi), az = -Math.sin(phi)
    let hx = x - rx * 0.85, hz = z - rz * 0.85
    out.push({ id: id + "_leaf", type: "box",
      position: { x: hx + ax * 0.79, y: 1.05, z: hz + az * 0.79 }, rotation: { x: 0, y: phi, z: 0 },
      width: 1.5, height: 2.05, depth: 0.06, color: leafColor })
    out.push({ id: id + "_hnd", type: "sphere",
      position: { x: hx + ax * 1.4, y: 1.0, z: hz + az * 1.4 }, radius: 0.05,
      color: "#cbd5e1", metalness: 0.7, roughness: 0.3 })
  }
  return out
}

// EXIT in neon: a dark panel and four letters built from strokes, because a
// glowing blue slab reads as "a light", not "the way out". `s` scales it.
function neonExit(id, x, y, z, dir, color, s) {
  let rx = Math.cos(dir), rz = -Math.sin(dir)
  let k = s || 1
  let out = [
    { id: id + "_bk", type: "box", position: { x: x, y: y, z: z }, rotation: { x: 0, y: dir, z: 0 },
      width: 1.72 * k, height: 0.66 * k, depth: 0.06, color: "#0a0e17" }
  ]
  // Strokes as [alongWidth, up, width, height, tilt] in the sign's own plane,
  // four letters on even 0.34 centres.
  let strokes = [
    [-0.635, 0.00, 0.055, 0.40, 0],   [-0.49, 0.175, 0.235, 0.06, 0],    // E
    [-0.50, 0.00, 0.215, 0.055, 0],   [-0.49, -0.175, 0.235, 0.06, 0],
    [-0.18, 0.00, 0.06, 0.46, 0.55],  [-0.18, 0.00, 0.06, 0.46, -0.55],  // X
    [0.18, 0.00, 0.06, 0.40, 0],                                          // I
    [0.52, 0.175, 0.30, 0.06, 0],     [0.52, -0.03, 0.06, 0.35, 0]        // T
  ]
  for (let i = 0; i < strokes.length; i++) {
    let st = strokes[i]
    out.push({ id: id + "_s" + i, type: "box",
      position: { x: x + rx * st[0] * k + rx * 0, y: y + st[1] * k, z: z + rz * st[0] * k },
      rotation: { x: 0, y: dir, z: st[4] },
      width: st[2] * k, height: st[3] * k, depth: 0.1,
      color: "#f8fafc", emissive: color, emissiveIntensity: 2.2 })
  }
  return out
}

// A window with mullions: frame, glass, one cross bar. faceZ = faces along z.
function windowAt(id, x, y, z, w, h, faceZ, frameColor, glowColor, glowInt) {
  let rot = faceZ ? 0 : Math.PI / 2
  let out = [
    { id: id + "_f", type: "box", position: { x: x, y: y, z: z }, rotation: { x: 0, y: rot, z: 0 },
      width: w + 0.18, height: h + 0.18, depth: 0.07, color: frameColor },
    { id: id + "_g", type: "box", position: { x: x + (faceZ ? 0 : 0.04), y: y, z: z + (faceZ ? 0.04 : 0) }, rotation: { x: 0, y: rot, z: 0 },
      width: w, height: h, depth: 0.04, color: "#0e1730", emissive: glowColor, emissiveIntensity: glowInt },
    { id: id + "_mv", type: "box", position: { x: x + (faceZ ? 0 : 0.06), y: y, z: z + (faceZ ? 0.06 : 0) }, rotation: { x: 0, y: rot, z: 0 },
      width: 0.05, height: h, depth: 0.03, color: frameColor },
    { id: id + "_mh", type: "box", position: { x: x + (faceZ ? 0 : 0.06), y: y, z: z + (faceZ ? 0.06 : 0) }, rotation: { x: 0, y: rot, z: 0 },
      width: w, height: 0.05, depth: 0.03, color: frameColor }
  ]
  return out
}

// A fake contact shadow: a flat dark disc. Cheaper than a shadow map, and it
// grounds everything that floats one pixel above the floor.
function blob(id, x, z, r, op) {
  return { id: id + "_sh", type: "cylinder", position: { x: x, y: 0.012, z: z },
    radius: r, height: 0.012, color: "#000000", opacity: op || 0.28 }
}

function hexShade(hex, f) {
  let r = Math.round(parseInt(hex.slice(1, 3), 16) * f)
  let g = Math.round(parseInt(hex.slice(3, 5), 16) * f)
  let b = Math.round(parseInt(hex.slice(5, 7), 16) * f)
  let h = (n) => { let s = n.toString(16); return s.length < 2 ? "0" + s : s }
  return "#" + h(r) + h(g) + h(b)
}

function wallsFrom(rows, color, height) {
  let out = []
  let dark = hexShade(color, 0.86)
  for (let r = 0; r < rows.length; r++) {
    for (let c = 0; c < rows[r].length; c++) {
      if (rows[r].charAt(c) !== "#") { continue }
      out.push({
        id: "w" + r + "_" + c, type: "box",
        position: { x: c * CELL, y: height / 2, z: r * CELL },
        width: CELL, height: height, depth: CELL,
        color: (r + c) % 2 === 0 ? color : dark,
        metalness: 0.05, roughness: 0.9
      })
    }
  }
  return out
}

function floorPlane(w, d, color) {
  return {
    id: "floor", type: "plane",
    position: { x: w / 2, y: 0, z: d / 2 },
    rotation: { x: -Math.PI / 2, y: 0, z: 0 },
    width: w + 4, height: d + 4, color: color, roughness: 1
  }
}

function ceilingPlane(w, d, y, color) {
  return {
    id: "ceiling", type: "plane",
    position: { x: w / 2, y: y, z: d / 2 },
    rotation: { x: Math.PI / 2, y: 0, z: 0 },
    width: w + 4, height: d + 4, color: color, roughness: 1
  }
}

function lightPanel(id, x, z, y, tint) {
  return { id: id, type: "box", position: { x: x, y: y, z: z },
    width: 2.6, height: 0.06, depth: 1.1, color: "#f8fafc",
    emissive: tint, emissiveIntensity: 1.4 }
}

// A little person — low-poly but person-shaped: legs, hips, chest, arms, head,
// hair; optional apron and cap. dir turns the whole figure; the same palette in
// near-black makes a dream silhouette.
function fig(id, x, z, dir, bodyColor, headColor, opts) {
  let o = opts || {}
  let fx = Math.sin(dir), fz = Math.cos(dir)      // facing vector
  let rx = Math.cos(dir), rz = -Math.sin(dir)     // right-hand vector
  let pants = o.pants || hexShade(bodyColor, 0.55)
  let hair = o.hair || hexShade(headColor, 0.45)
  let L = o.lift || 0                              // bob while walking
  let swing = o.swing || 0                         // arm swing, radians
  if (o.sit) { L = L - 0.4 }                       // hips at chair height
  let out = [
    blob(id, x, z, o.sit ? 0.3 : 0.34, o.sit ? 0.16 : 0.3),
    { id: id + "_lgL", type: "box",
      position: { x: x - rx * 0.12 + fx * (o.sit ? 0.26 : swing * 0.22), y: (o.sit ? 0.44 : 0.33 + L), z: z - rz * 0.12 + fz * (o.sit ? 0.26 : swing * 0.22) },
      rotation: { x: (o.sit ? 1.35 : swing * 0.5), y: dir, z: 0 },
      width: 0.16, height: 0.62, depth: 0.2, color: pants },
    { id: id + "_lgR", type: "box",
      position: { x: x + rx * 0.12 + fx * (o.sit ? 0.26 : -swing * 0.22), y: (o.sit ? 0.44 : 0.33 + L), z: z + rz * 0.12 + fz * (o.sit ? 0.26 : -swing * 0.22) },
      rotation: { x: (o.sit ? 1.35 : -swing * 0.5), y: dir, z: 0 },
      width: 0.16, height: 0.62, depth: 0.2, color: pants },
    { id: id + "_hip", type: "box", position: { x: x, y: 0.7 + L, z: z }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.44, height: 0.18, depth: 0.26, color: pants },
    { id: id + "_chest", type: "box", position: { x: x, y: 1.0 + L, z: z }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.48, height: 0.46, depth: 0.28, color: bodyColor },
    { id: id + "_armL", type: "box", position: { x: x - rx * 0.32 - fx * swing * 0.26, y: 0.93 + L, z: z - rz * 0.32 - fz * swing * 0.26 }, rotation: { x: -swing * 0.6, y: dir, z: 0.09 },
      width: 0.12, height: 0.5, depth: 0.16, color: bodyColor },
    { id: id + "_armR", type: "box", position: { x: x + rx * 0.32 + fx * swing * 0.26, y: 0.93 + L, z: z + rz * 0.32 + fz * swing * 0.26 }, rotation: { x: swing * 0.6, y: dir, z: -0.09 },
      width: 0.12, height: 0.5, depth: 0.16, color: bodyColor },
    { id: id + "_shL", type: "box", position: { x: x - rx * 0.12 + fx * (o.sit ? 0.5 : 0.03 + swing * 0.24), y: 0.035 + (o.sit ? 0 : L), z: z - rz * 0.12 + fz * (o.sit ? 0.5 : 0.03 + swing * 0.24) }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.17, height: 0.07, depth: 0.26, color: "#1f2430" },
    { id: id + "_shR", type: "box", position: { x: x + rx * 0.12 + fx * (o.sit ? 0.5 : 0.03 - swing * 0.24), y: 0.035 + (o.sit ? 0 : L), z: z + rz * 0.12 + fz * (o.sit ? 0.5 : 0.03 - swing * 0.24) }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.17, height: 0.07, depth: 0.26, color: "#1f2430" },
    { id: id + "_head", type: "sphere", position: { x: x, y: 1.4 + L, z: z }, radius: 0.165, color: headColor },
    { id: id + "_hair", type: "sphere", position: { x: x - fx * 0.05, y: 1.47 + L, z: z - fz * 0.05 }, radius: 0.155, color: hair },
    { id: id + "_eyeL", type: "sphere", position: { x: x + fx * 0.145 - rx * 0.062, y: 1.44 + L, z: z + fz * 0.145 - rz * 0.062 }, radius: 0.022, color: "#1b2130" },
    { id: id + "_eyeR", type: "sphere", position: { x: x + fx * 0.145 + rx * 0.062, y: 1.44 + L, z: z + fz * 0.145 + rz * 0.062 }, radius: 0.022, color: "#1b2130" },
    { id: id + "_mouth", type: "box", position: { x: x + fx * 0.152, y: 1.345 + L - (o.talk || 0) * 0.016, z: z + fz * 0.152 },
      rotation: { x: 0, y: dir, z: 0 },
      width: 0.072, height: 0.014 + (o.talk || 0) * 0.05, depth: 0.02, color: "#2a1d20" }
  ]
  if (o.apron) {
    out.push({ id: id + "_apron", type: "box", position: { x: x + fx * 0.16, y: 0.82, z: z + fz * 0.16 }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.4, height: 0.6, depth: 0.04, color: o.apron })
  }
  if (o.cap) {
    out.push({ id: id + "_cap", type: "cylinder", position: { x: x, y: 1.56, z: z }, radius: 0.17, height: 0.07, color: o.cap })
    out.push({ id: id + "_brim", type: "box", position: { x: x + fx * 0.18, y: 1.53, z: z + fz * 0.18 }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.2, height: 0.03, depth: 0.14, color: o.cap })
  }
  return out
}

function chairAt(id, x, z, dir, color) {
  let bx = Math.sin(dir) * -0.22, bz = Math.cos(dir) * -0.22
  return [
    blob(id, x, z, 0.32, 0.22),
    { id: id + "_s", type: "box", position: { x: x, y: 0.48, z: z }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.5, height: 0.09, depth: 0.5, color: color },
    { id: id + "_b", type: "box", position: { x: x + bx, y: 0.82, z: z + bz }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.5, height: 0.62, depth: 0.09, color: color },
    { id: id + "_col", type: "cylinder", position: { x: x, y: 0.26, z: z }, radius: 0.045, height: 0.4, color: "#565f73", metalness: 0.5, roughness: 0.4 },
    { id: id + "_base", type: "cylinder", position: { x: x, y: 0.04, z: z }, radius: 0.27, height: 0.05, color: "#2a303d" }
  ]
}

// An open laptop: base slab plus a hinged screen tilted back.
function laptopAt(id, x, y, z, dir, screenColor) {
  let fx = Math.sin(dir), fz = Math.cos(dir)
  return [
    { id: id + "_b", type: "box", position: { x: x, y: y + 0.015, z: z }, rotation: { x: 0, y: dir, z: 0 },
      width: 0.5, height: 0.03, depth: 0.36, color: "#334155", metalness: 0.4, roughness: 0.5 },
    { id: id + "_s", type: "box", position: { x: x - fx * 0.17, y: y + 0.17, z: z - fz * 0.17 }, rotation: { x: -0.42, y: dir, z: 0 },
      width: 0.5, height: 0.34, depth: 0.02, color: "#0b1220", emissive: screenColor, emissiveIntensity: screenColor === "#0b1220" ? 0 : 0.9 }
  ]
}

// Pastry prefabs: a croissant is three spheres in an arc; cakes and cupcakes stack.
function croissantAt(id, x, y, z, dir) {
  let rx = Math.cos(dir), rz = -Math.sin(dir)
  let fx = Math.sin(dir), fz = Math.cos(dir)
  return [
    { id: id + "_c", type: "sphere", position: { x: x, y: y, z: z }, radius: 0.1, color: "#dd9a55", roughness: 1 },
    { id: id + "_l", type: "sphere", position: { x: x - rx * 0.13 + fx * 0.05, y: y - 0.01, z: z - rz * 0.13 + fz * 0.05 }, radius: 0.075, color: "#d18f4b", roughness: 1 },
    { id: id + "_r", type: "sphere", position: { x: x + rx * 0.13 + fx * 0.05, y: y - 0.01, z: z + rz * 0.13 + fz * 0.05 }, radius: 0.075, color: "#d18f4b", roughness: 1 }
  ]
}

function cakeAt(id, x, y, z) {
  return [
    { id: id + "_b", type: "cylinder", position: { x: x, y: y + 0.08, z: z }, radius: 0.2, height: 0.16, color: "#f6e7d7", roughness: 1 },
    { id: id + "_t", type: "cylinder", position: { x: x, y: y + 0.21, z: z }, radius: 0.14, height: 0.1, color: "#f4a4c0", roughness: 1 },
    { id: id + "_ch", type: "sphere", position: { x: x, y: y + 0.3, z: z }, radius: 0.045, color: "#dc2626" }
  ]
}

function cupcakeAt(id, x, y, z, frost) {
  return [
    { id: id + "_b", type: "cylinder", position: { x: x, y: y + 0.045, z: z }, radius: 0.075, height: 0.09, color: "#8a5a3a", roughness: 1 },
    { id: id + "_f", type: "icosahedron", position: { x: x, y: y + 0.13, z: z }, radius: 0.085, color: frost, roughness: 1 }
  ]
}

function plantAt(id, x, z) {
  return [
    blob(id, x, z, 0.3, 0.24),
    { id: id + "_pot", type: "cylinder", position: { x: x, y: 0.22, z: z }, radius: 0.22, height: 0.44, color: "#8a5a3a" },
    { id: id + "_soil", type: "cylinder", position: { x: x, y: 0.45, z: z }, radius: 0.19, height: 0.03, color: "#3a2c1c" },
    { id: id + "_trunk", type: "cylinder", position: { x: x, y: 0.62, z: z }, radius: 0.04, height: 0.36, color: "#6b4a2e" },
    { id: id + "_top", type: "icosahedron", position: { x: x, y: 0.95, z: z }, radius: 0.34, color: "#3f8f4f", roughness: 1 },
    { id: id + "_top2", type: "icosahedron", position: { x: x + 0.14, y: 1.16, z: z - 0.06 }, radius: 0.22, color: "#4aa35c", roughness: 1 }
  ]
}

// A water cooler: the most recognisable object in any office.
function waterCoolerAt(id, x, z) {
  return [
    blob(id, x, z, 0.32, 0.24),
    { id: id + "_b", type: "box", position: { x: x, y: 0.5, z: z }, width: 0.42, height: 1.0, depth: 0.42, color: "#e5e7eb", roughness: 0.6 },
    { id: id + "_tapC", type: "box", position: { x: x, y: 0.78, z: z + 0.22 }, width: 0.06, height: 0.06, depth: 0.05, color: "#3b82f6", emissive: "#3b82f6", emissiveIntensity: 0.4 },
    { id: id + "_tapH", type: "box", position: { x: x + 0.1, y: 0.78, z: z + 0.22 }, width: 0.06, height: 0.06, depth: 0.05, color: "#ef4444", emissive: "#ef4444", emissiveIntensity: 0.4 },
    { id: id + "_neck", type: "cylinder", position: { x: x, y: 1.04, z: z }, radius: 0.07, height: 0.08, color: "#cbd5e1" },
    { id: id + "_jug", type: "cylinder", position: { x: x, y: 1.3, z: z }, radius: 0.17, height: 0.44, color: "#a5d8ff", opacity: 0.55 }
  ]
}

function deskAt(id, x, z, screen) {
  let out = [
    blob(id + "_dk", x, z, 0.85, 0.2),
    { id: id, type: "box", position: { x: x, y: 0.72, z: z },
      width: 1.7, height: 0.06, depth: 0.85, color: "#5b6b84", metalness: 0.1, roughness: 0.7 },
    { id: id + "_l1", type: "box", position: { x: x - 0.75, y: 0.36, z: z }, width: 0.08, height: 0.72, depth: 0.7, color: "#3a4356" },
    { id: id + "_l2", type: "box", position: { x: x + 0.75, y: 0.36, z: z }, width: 0.08, height: 0.72, depth: 0.7, color: "#3a4356" }
  ]
  if (screen) {
    out.push({ id: id + "_std", type: "cylinder", position: { x: x, y: 0.82, z: z - 0.22 },
      radius: 0.035, height: 0.16, color: "#3a4356" })
    out.push({ id: id + "_bez", type: "box", position: { x: x, y: 1.08, z: z - 0.235 },
      width: 0.68, height: 0.46, depth: 0.03, color: "#0a0e18" })
    out.push({ id: id + "_scr", type: "box", position: { x: x, y: 1.08, z: z - 0.22 },
      width: 0.6, height: 0.38, depth: 0.03, color: "#0b1220",
      emissive: screen, emissiveIntensity: 1.0 })
    out.push({ id: id + "_kb", type: "box", position: { x: x, y: 0.77, z: z + 0.15 },
      width: 0.5, height: 0.03, depth: 0.2, color: "#232b3b" })
    out.push({ id: id + "_mouse", type: "box", position: { x: x + 0.38, y: 0.77, z: z + 0.15 },
      width: 0.09, height: 0.04, depth: 0.14, color: "#2c3547" })
  } else {
    out.push({ id: id + "_pap", type: "box", position: { x: x + 0.3, y: 0.76, z: z },
      width: 0.3, height: 0.015, depth: 0.4, color: "#d7dce6" })
  }
  return out
}

function posterAt(id, x, z, y, w, h, color, faceZ, sign) {
  let rot = faceZ ? 0 : Math.PI / 2
  let s = sign === undefined ? 1 : sign
  let ax = faceZ ? 1 : 0, az = faceZ ? 0 : 1        // along the poster's width
  let nx = faceZ ? 0 : s, nz = faceZ ? s : 0        // out from the wall face
  let out = [
    { id: id + "_bk", type: "box", position: { x: x, y: y, z: z }, rotation: { x: 0, y: rot, z: 0 },
      width: w + 0.06, height: h + 0.06, depth: 0.03, color: "#0b1120" },
    { id: id, type: "box", position: { x: x + nx * 0.018, y: y, z: z + nz * 0.018 }, rotation: { x: 0, y: rot, z: 0 },
      width: w, height: h, depth: 0.02, color: "#e8eef7" },
    { id: id + "_hd", type: "box", position: { x: x + nx * 0.032, y: y + h * 0.29, z: z + nz * 0.032 }, rotation: { x: 0, y: rot, z: 0 },
      width: w * 0.84, height: h * 0.22, depth: 0.02, color: hexShade(color, 0.55), emissive: color, emissiveIntensity: 0.85 }
  ]
  // Four rules of shrinking width read as a paragraph at this scale.
  let lw = [0.84, 0.7, 0.78, 0.46]
  for (let i = 0; i < 4; i++) {
    let lineW = w * 0.8 * lw[i]
    let off = (w * 0.8 - lineW) / 2
    out.push({ id: id + "_l" + i, type: "box",
      position: { x: x + nx * 0.034 - ax * off, y: y + h * 0.04 - i * (h * 0.125), z: z + nz * 0.034 - az * off },
      rotation: { x: 0, y: rot, z: 0 },
      width: lineW, height: h * 0.045, depth: 0.015, color: "#5b6678" })
  }
  return out
}

// One small object per keepsake, so the box fills with things you recognise.
function itemObj(id, kind, x, y, z) {
  if (kind === "doug") {
    return [
      { id: id, type: "sphere", position: { x: x, y: y + 0.1, z: z }, radius: 0.1, color: "#facc15", emissive: "#facc15", emissiveIntensity: 0.3 },
      { id: id + "_h", type: "sphere", position: { x: x, y: y + 0.22, z: z - 0.02 }, radius: 0.065, color: "#fde047" },
      { id: id + "_b", type: "box", position: { x: x, y: y + 0.21, z: z - 0.1 }, width: 0.05, height: 0.03, depth: 0.07, color: "#fb923c" }
    ]
  }
  if (kind === "plant") {
    return [
      { id: id, type: "cylinder", position: { x: x, y: y + 0.08, z: z }, radius: 0.09, height: 0.16, color: "#a1673a" },
      { id: id + "_g", type: "icosahedron", position: { x: x, y: y + 0.24, z: z }, radius: 0.14, color: "#4b9d5c", roughness: 1 }
    ]
  }
  if (kind === "photo") {
    return [
      { id: id, type: "box", position: { x: x, y: y + 0.12, z: z }, rotation: { x: -0.18, y: 0.2, z: 0 }, width: 0.24, height: 0.2, depth: 0.02, color: "#e8e0d0" },
      { id: id + "_i", type: "box", position: { x: x, y: y + 0.12, z: z - 0.02 }, rotation: { x: -0.18, y: 0.2, z: 0 }, width: 0.19, height: 0.15, depth: 0.01, color: "#6b8bb5" }
    ]
  }
  if (kind === "keyboard") {
    return [
      { id: id, type: "box", position: { x: x, y: y + 0.03, z: z }, rotation: { x: 0, y: 0.12, z: 0 }, width: 0.46, height: 0.05, depth: 0.17, color: "#1f2733" },
      { id: id + "_k", type: "box", position: { x: x, y: y + 0.06, z: z }, rotation: { x: 0, y: 0.12, z: 0 }, width: 0.42, height: 0.015, depth: 0.14, color: "#cbd5e1" }
    ]
  }
  if (kind === "notebook") {
    return [
      { id: id, type: "box", position: { x: x, y: y + 0.03, z: z }, rotation: { x: 0, y: -0.24, z: 0 }, width: 0.24, height: 0.05, depth: 0.32, color: "#e7e2d5" },
      { id: id + "_s", type: "box", position: { x: x - 0.1, y: y + 0.035, z: z }, rotation: { x: 0, y: -0.24, z: 0 }, width: 0.03, height: 0.055, depth: 0.32, color: "#b91c1c" }
    ]
  }
  return [
    { id: id, type: "cylinder", position: { x: x, y: y + 0.07, z: z }, radius: 0.07, height: 0.14, color: "#f8fafc" },
    { id: id + "_h", type: "torus", position: { x: x + 0.09, y: y + 0.08, z: z }, rotation: { x: 0, y: Math.PI / 2, z: 0 }, radius: 0.042, color: "#f8fafc" }
  ]
}

// The desk you are being asked to empty. Items you have taken are drawn inside
// the archive box instead of on the desk, so packing is visible.
// The desk top spans x 7.15..8.85, z 3.58..4.43 — every item must sit inside
// that, or it hangs in the air off the edge.
let ITEM_SPOTS = [
  { id: "doug",     x: 7.45, z: 3.80 },
  { id: "mug",      x: 7.98, z: 3.78 },
  { id: "plant",    x: 8.52, z: 3.78 },
  { id: "photo",    x: 7.48, z: 4.22 },
  { id: "keyboard", x: 8.04, z: 4.20 },
  { id: "notebook", x: 8.56, z: 4.22 }
]

function buildBoxes() {
  buildOffice()
  // Drop the office's own beacons — this scene marks different things.
  let objs = []
  let stripped = ["desk0_std", "desk0_bez", "desk0_scr", "desk0_kb", "desk0_mouse"]
  for (let i = 0; i < officeStatic.length; i++) {
    let oid = String(officeStatic[i].id)
    if (oid.indexOf("mk_") === 0) { continue }
    if (stripped.indexOf(oid) >= 0) { continue }
    objs.push(officeStatic[i])
  }
  let hs = []
  // The archive box, open, on the floor beside the desk.
  objs.push(blob("abox", 8, 6.7, 0.6, 0.3))
  objs.push({ id: "hs_abox", type: "box", position: { x: 8, y: 0.26, z: 6.7 }, width: 1.34, height: 0.52, depth: 0.86, color: "#8a6f4d" })
  objs.push({ id: "abox_f1", type: "box", position: { x: 8, y: 0.55, z: 6.28 }, rotation: { x: -0.9, y: 0, z: 0 }, width: 1.34, height: 0.34, depth: 0.04, color: "#7a6142" })
  objs.push({ id: "abox_f2", type: "box", position: { x: 8, y: 0.55, z: 7.12 }, rotation: { x: 0.9, y: 0, z: 0 }, width: 1.34, height: 0.34, depth: 0.04, color: "#7a6142" })
  objs.push({ id: "abox_lbl", type: "box", position: { x: 8, y: 0.3, z: 6.29 }, width: 0.5, height: 0.16, depth: 0.02, color: "#efe6cf" })
  let inBox = 0
  for (let i = 0; i < ITEM_SPOTS.length; i++) {
    let sp = ITEM_SPOTS[i]
    if (isPicked(sp.id)) {
      // Nestled in the box, in the order they were chosen.
      // Centred in the box (which sits at z 6.7) and proud of the rim.
      let bx = 7.62 + inBox * 0.38
      objs = objs.concat(itemObj("bit_" + sp.id, sp.id, bx, 0.44, 6.7))
      // A packed item can be tapped to put it back. It is tap-only so keyboard
      // / D-pad interaction still prioritises taping the box shut when full.
      hs.push({ id: "bit_" + sp.id, x: 8, z: 6.7, r: 2.0, tapOnly: true,
        label: "Put back " + itemName(sp.id) })
      inBox = inBox + 1
    } else {
      objs = objs.concat(itemObj("it_" + sp.id, sp.id, sp.x, 0.75, sp.z))
      if (picked.length < 3) {
        // One height for all six, clear of the tallest of them (the plant tops
        // out at 1.13), so they read as a row of markers rather than as parts
        // of the objects they sit over.
        hs.push({ id: "it_" + sp.id, x: sp.x, z: sp.z + 0.75, r: 1.0,
          mx: sp.x, mz: sp.z, my: 1.34, label: itemName(sp.id) })
      }
    }
  }
  hs.push({ id: "hs_abox", x: 8, z: 6.7, r: 2.0, my: 0.92,
    label: picked.length >= 3 ? "Tape the box shut" : "Archive box — " + picked.length + " of 3" })
  hotspots = hs
  objs = objs.concat(hotspotMarkers())
  sceneStatic = objs
  objects = actorObjs()
}

// ---- Office ---------------------------------------------------------------

let officeStatic = []

function buildOffice() {
  loadGrid(OFFICE_ROWS)
  sceneFog = { color: "#232d45", near: 26, far: 70 }
  sceneBg = "#111726"
  let objs = [floorPlane(30, 20, "#374260"), ceilingPlane(30, 20, 2.6, "#39435e")]
  objs = objs.concat(wallsFrom(OFFICE_ROWS, "#5a6c92", 2.6))
  objs = objs.concat(skirting("osk", 30, 20, "#33405e"))
  objs = objs.concat(dado("odd", 30, 20, "#46587a", 1.22))
  objs = objs.concat(ceilingBeams("obm", 30, 20, 2.6, 3, "#33405e"))
  // Ceiling light panels.
  objs.push(lightPanel("lp1", 8, 6, 2.56, "#dbe6ff"))
  objs.push(lightPanel("lp2", 22, 12, 2.56, "#dbe6ff"))
  objs.push(lightPanel("lp3", 13, 14, 2.56, "#dbe6ff"))
  objs.push(lightPanel("lp4", 24, 4, 2.56, "#dbe6ff"))
  // Desks — half of them conspicuously cleared — with chairs.
  let desks = [
    [8, 4, "#38bdf8", 0.5], [8, 8, "", -0.4], [18, 4, "#38bdf8", 0.2], [18, 8, "", 0.9],
    [4, 8, "", 0], [24, 6, "#38bdf8", -0.6], [24, 12, "", 0.3], [8, 13, "#38bdf8", 1.2]
  ]
  for (let i = 0; i < desks.length; i++) {
    objs = objs.concat(deskAt("desk" + i, desks[i][0], desks[i][1], desks[i][2]))
    objs = objs.concat(chairAt("chair" + i, desks[i][0], desks[i][1] + 1.0, desks[i][3], "#2c3547"))
  }

  // Plants, posters, and the taped-off Dynamic Collaboration Space.
  objs = objs.concat(plantAt("plant1", 13, 2))
  objs = objs.concat(plantAt("plant2", 2, 17.8))
  objs = objs.concat(posterAt("post1", 5.6, 1.07, 1.62, 1.5, 0.95, "#38bdf8", true))
  objs = objs.concat(posterAt("post2", 17.4, 1.07, 1.62, 1.5, 0.95, "#f472b6", true))
  objs = objs.concat(posterAt("post3", 24.6, 1.07, 1.58, 1.2, 0.8, "#4ade80", true))
  objs = objs.concat(posterAt("post4", 12, 11.07, 1.55, 1.5, 0.95, "#fb923c", true))
  objs = objs.concat(posterAt("post5", 23, 11.07, 1.55, 1.5, 0.95, "#22d3ee", true))
  objs = objs.concat(posterAt("post6", 14, 9.07, 1.55, 1.4, 0.9, "#a78bfa", true, -1))
  // A whiteboard nobody has erased since the reorg before the reorg.
  objs.push({ id: "owb", type: "box", position: { x: 4, y: 1.6, z: 1.07 }, width: 2.2, height: 1.3, depth: 0.05, color: "#eef1f5" })
  objs.push({ id: "owb_f", type: "box", position: { x: 4, y: 1.6, z: 1.04 }, width: 2.34, height: 1.44, depth: 0.04, color: "#5b6678" })
  for (let i = 0; i < 3; i++) {
    objs.push({ id: "owb_l" + i, type: "box", position: { x: 3.6 + (i % 2) * 0.3, y: 1.95 - i * 0.34, z: 1.1 },
      width: 1.4 - (i % 2) * 0.5, height: 0.05, depth: 0.02, color: "#64748b" })
  }
  // Cable tray under the ceiling, because somebody had to.
  objs.push({ id: "otray", type: "box", position: { x: 15, y: 2.42, z: 8 }, width: 26, height: 0.07, depth: 0.3, color: "#39445c" })
  objs.push({ id: "clock_f", type: "cylinder", position: { x: 22.5, y: 2.05, z: 1.06 }, rotation: { x: Math.PI / 2, y: 0, z: 0 },
    radius: 0.3, height: 0.05, color: "#e5e7eb" })
  objs.push({ id: "clock_h1", type: "box", position: { x: 22.5, y: 2.13, z: 1.1 }, width: 0.035, height: 0.18, depth: 0.02, color: "#1f2430" })
  objs.push({ id: "clock_h2", type: "box", position: { x: 22.58, y: 2.05, z: 1.1 }, rotation: { x: 0, y: 0, z: Math.PI / 2 }, width: 0.035, height: 0.14, depth: 0.02, color: "#dc2626" })
  let tape = [[14, 17, 4, 0.08], [14, 18.9, 4, 0.08], [12.05, 18, 0.08, 2], [15.95, 18, 0.08, 2]]
  for (let i = 0; i < tape.length; i++) {
    objs.push({ id: "tape" + i, type: "box", position: { x: tape[i][0], y: 0.02, z: tape[i][1] },
      width: tape[i][2], height: 0.02, depth: tape[i][3], color: "#facc15",
      emissive: "#facc15", emissiveIntensity: 0.5 })
  }
  // Interactive props (ids double as hotspot ids). The coffee machine is an
  // actual machine: body, top, screen, spout, drip tray, cup, bean hopper.
  objs.push({ id: "hs_coffee", type: "box", position: { x: 4, y: 0.62, z: 14.1 },
    width: 0.72, height: 1.24, depth: 0.6, color: "#4b5563", metalness: 0.55, roughness: 0.35 })
  objs.push({ id: "cm_top", type: "box", position: { x: 4, y: 1.31, z: 14.1 }, width: 0.8, height: 0.16, depth: 0.68, color: "#374151", metalness: 0.5, roughness: 0.4 })
  objs.push({ id: "cm_panel", type: "box", position: { x: 4, y: 1.02, z: 13.78 }, width: 0.46, height: 0.26, depth: 0.03,
    color: "#111827", emissive: coffeeFixed ? "#4ade80" : "#f87171", emissiveIntensity: 0.95 })
  objs.push({ id: "cm_spout", type: "cylinder", position: { x: 4, y: 0.8, z: 13.74 }, radius: 0.035, height: 0.16, color: "#1f2430", metalness: 0.6 })
  objs.push({ id: "cm_tray", type: "box", position: { x: 4, y: 0.52, z: 13.76 }, width: 0.4, height: 0.04, depth: 0.22, color: "#1f2430" })
  objs.push({ id: "cm_cup", type: "cylinder", position: { x: 4, y: 0.6, z: 13.74 }, radius: 0.06, height: 0.11, color: "#f8fafc" })
  objs.push({ id: "cm_hopper", type: "cylinder", position: { x: 4.24, y: 1.5, z: 14.15 }, radius: 0.12, height: 0.22, color: "#6b7280", opacity: 0.8 })
  objs = objs.concat(waterCoolerAt("cooler", 12.6, 17.6))
  // The wellbeing kiosk: a pillar with a serene, unreachable screen.
  objs.push({ id: "hs_kiosk", type: "box", position: { x: 15.4, y: 0.7, z: 17.6 }, width: 0.5, height: 1.4, depth: 0.4, color: "#3d4d68" })
  objs.push({ id: "kiosk_scr", type: "box", position: { x: 15.4, y: 1.5, z: 17.42 }, rotation: { x: -0.2, y: 0, z: 0 },
    width: 0.42, height: 0.3, depth: 0.03, color: "#0b1220", emissive: "#4ade80", emissiveIntensity: 0.7 })
  objs.push({ id: "hs_board", type: "box", position: { x: 26, y: 1.4, z: 3.2 },
    width: 2.2, height: 1.3, depth: 0.12, color: "#111827",
    emissive: "#fbbf24", emissiveIntensity: debugDone ? 0.15 : 0.7 })
  let cardCols = ["#f87171", "#fbbf24", "#4ade80"]
  for (let i = 0; i < 3; i++) {
    objs.push({ id: "bcard" + i, type: "box", position: { x: 25.3 + i * 0.7, y: 1.5, z: 3.12 },
      width: 0.5, height: 0.34, depth: 0.03, color: hexShade(cardCols[i], 0.3),
      emissive: cardCols[i], emissiveIntensity: 0.6 })
  }
  objs.push({ id: "hs_desk41", type: "box", position: { x: 22, y: 0.72, z: 14 },
    width: 1.7, height: 0.06, depth: 0.85, color: "#4b5563",
    emissive: "#a78bfa", emissiveIntensity: notebookSeen ? 0.12 : 0.5 })
  objs.push({ id: "d41_l1", type: "box", position: { x: 21.25, y: 0.36, z: 14 }, width: 0.08, height: 0.72, depth: 0.7, color: "#343b4a" })
  objs.push({ id: "d41_l2", type: "box", position: { x: 22.75, y: 0.36, z: 14 }, width: 0.08, height: 0.72, depth: 0.7, color: "#343b4a" })
  objs.push({ id: "notebook41", type: "box", position: { x: 22, y: 0.78, z: 14 }, rotation: { x: 0, y: 0.3, z: 0 },
    width: 0.34, height: 0.05, depth: 0.46, color: "#e7e2d5" })
  objs = objs.concat(doorwayAt("mtgdoor", 28.2, 16, Math.PI / 2, "#2b3550", ""))
  // The guard by the gate, who will open it with a key when the badge fails.

  objs.push({ id: "gate_l", type: "box", position: { x: 27.4, y: 0.55, z: 13.4 }, width: 0.16, height: 1.1, depth: 1.1, color: "#3d4a66", metalness: 0.4 })
  objs.push({ id: "gate_r", type: "box", position: { x: 27.4, y: 0.55, z: 17.2 }, width: 0.16, height: 1.1, depth: 1.1, color: "#3d4a66", metalness: 0.4 })
  objs.push({ id: "gate_led", type: "sphere", position: { x: 27.4, y: 1.16, z: 13.4 }, radius: 0.05, color: "#f87171", emissive: "#f87171", emissiveIntensity: 1.4 })
  objs.push({ id: "hs_meeting", type: "box", position: { x: 28, y: 1.1, z: 16 },
    width: 0.3, height: 2.05, depth: 1.7, color: "#1f2937",
    emissive: "#4ade80", emissiveIntensity: 0.9 })
  objs.push({ id: "lobby_banner", type: "box", position: { x: 13, y: 2.1, z: 1.2 },
    width: 5, height: 0.9, depth: 0.1, color: "#0b1220", emissive: "#38bdf8", emissiveIntensity: 1.2 })
  // Dawn windows along the north wall, and floor tone patches.
  for (let i = 0; i < 3; i++) {
    objs = objs.concat(windowAt("owin" + i, 6 + i * 4, 1.9, 1.06, 2.4, 1.0, true, "#26304a", "#7fa8e8", 0.6))
    objs.push({ id: "osill" + i, type: "box", position: { x: 6 + i * 4, y: 1.35, z: 1.2 }, width: 2.7, height: 0.06, depth: 0.24, color: "#37425f" })
    // A dawn skyline behind the glass.
    for (let k = 0; k < 5; k++) {
      objs.push({ id: "osky" + i + "_" + k, type: "box",
        position: { x: 5.05 + i * 4 + k * 0.48, y: 1.62 + (k % 3) * 0.13, z: 1.115 },
        width: 0.34, height: 0.5 + (k % 3) * 0.26, depth: 0.02, color: "#111a30",
        emissive: "#f0a860", emissiveIntensity: 0.16 })
    }
    objs.push({ id: "owpool" + i, type: "plane", position: { x: 6 + i * 4, y: 0.014, z: 2.6 },
      rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 2.4, height: 2.2, color: "#7fa8e8", opacity: 0.07 })
  }
  // Reception counter by the lobby, and the office printer nobody trusts yet.
  objs.push(blob("recep", 20, 1.6, 1.3, 0.2))
  objs.push({ id: "recep", type: "box", position: { x: 20, y: 0.55, z: 1.9 }, width: 3.2, height: 1.1, depth: 0.7, color: "#54658a", metalness: 0.15, roughness: 0.7 })
  objs.push({ id: "recep_top", type: "box", position: { x: 20, y: 1.13, z: 1.9 }, width: 3.5, height: 0.08, depth: 0.9, color: "#6a7ba3", metalness: 0.2, roughness: 0.55 })
  objs.push(blob("prn", 26, 8, 0.5, 0.24))
  objs.push({ id: "prn_b", type: "box", position: { x: 26, y: 0.34, z: 8 }, width: 0.86, height: 0.68, depth: 0.7, color: "#d7dbe4", roughness: 0.7 })
  objs.push({ id: "prn_t", type: "box", position: { x: 26, y: 0.72, z: 8 }, width: 0.9, height: 0.1, depth: 0.74, color: "#aeb6c4" })
  objs.push({ id: "prn_tray", type: "box", position: { x: 26, y: 0.5, z: 7.62 }, rotation: { x: 0.25, y: 0, z: 0 }, width: 0.7, height: 0.03, depth: 0.3, color: "#f1f3f7" })
  objs.push({ id: "prn_led", type: "sphere", position: { x: 26.3, y: 0.79, z: 7.75 }, radius: 0.035, color: "#4ade80", emissive: "#4ade80", emissiveIntensity: 1.4 })
  objs.push({ id: "fpatch1", type: "plane", position: { x: 9, y: 0.006, z: 7 }, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 8, height: 5, color: "#333e57" })
  objs.push({ id: "fpatch2", type: "plane", position: { x: 22, y: 0.006, z: 13 }, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 7, height: 5, color: "#313b52" })
  officeStatic = objs
  objects = officeStatic
  lights = [
    { id: "amb", type: "ambient", color: "#c4cfe6", intensity: 2.1 },
    { id: "hemi", type: "hemisphere", color: "#e4ebf8", groundColor: "#66739a", intensity: 1.7 },
    { id: "dir", type: "directional", color: "#e2ecff", intensity: 0.9, position: { x: 20, y: 14, z: 8 } },
    { id: "dir2", type: "directional", color: "#c8d4f0", intensity: 0.5, position: { x: -8, y: 12, z: 26 } },
    { id: "p1", type: "point", color: "#e2e8f0", intensity: 2.0, position: { x: 8, y: 2.3, z: 6 } },
    { id: "p2", type: "point", color: "#e2e8f0", intensity: 2.0, position: { x: 22, y: 2.3, z: 12 } },
    { id: "p3", type: "point", color: "#fbe4bb", intensity: 1.6, position: { x: 6, y: 2.3, z: 14 } },
    { id: "p4", type: "point", color: "#e2e8f0", intensity: 1.6, position: { x: 24, y: 2.3, z: 4 } }
  ]
  hotspots = [
    { id: "hs_coffee",  x: 4,  z: 14, r: 1.9, label: coffeeFixed ? "Coffee machine (fixed)" : "Rescue the coffee machine" },
    { id: "hs_board",   x: 26, z: 4,  r: 2.1, label: debugDone ? "Incident board" : "Inspect yesterday's incident" },
    { id: "hs_desk41",  x: 22, z: 14, r: 1.9, label: notebookSeen ? "Desk 41" : "Someone's empty desk" },
    { id: "hs_meeting", x: 28, z: 16, r: 2.2, label: "Meeting room — stand-up" },
    { id: "hs_kiosk",   x: 15.4, z: 17.6, r: 1.8, label: "Wellbeing kiosk", minor: true },
    { id: "plant1_top", x: 13, z: 2, r: 1.7, label: "Office plant", minor: true },
    { id: "lobby_banner", x: 13, z: 1.2, r: 2.4, label: "Lobby screen", minor: true }
  ]
  officeStatic = officeStatic.concat(hotspotMarkers())
  // Two colleagues still doing laps, and the guard by the gate.
  sceneStatic = officeStatic
  blockers = []
  clearConfetti()
  for (let i = 0; i < desks.length; i++) {
    // The desk itself plus the chair tucked behind it.
    blockers.push({ x: desks[i][0], z: desks[i][1] + 0.5, hw: 1.15, hd: 1.35 })
  }
  blockers.push({ x: 20, z: 1.9, hw: 1.9, hd: 0.9 })      // reception
  blockers.push({ x: 26, z: 8, hw: 0.8, hd: 0.8 })        // printer
  blockers.push({ x: 12.6, z: 17.6, hw: 0.6, hd: 0.6 })   // water cooler
  blockers.push({ x: 15.4, z: 17.6, hw: 0.6, hd: 0.6 })   // wellbeing kiosk
  blockers.push({ x: 4, z: 14.1, hw: 0.8, hd: 0.8 })      // coffee machine
  blockers.push({ x: 22, z: 14, hw: 1.15, hd: 0.8 })      // desk 41
  blockers.push({ x: 13, z: 2, hw: 0.6, hd: 0.6 })        // plant
  blockers.push({ x: 8, z: 6.7, hw: 0.9, hd: 0.8 })       // the archive box
  ensureActors("office", [
    actorAt("col1", "", 6, 12, 1.57, "#4f6180", "#d4b394", { hair: "#6b4b2a", path: [[21, 12], [6, 12]], sp: 0.03 }),
    actorAt("col2", "", 14, 16, 1.57, "#5b5470", "#8a5a3a", { hair: "#22262e", path: [[20, 16], [14, 16]], sp: 0.026 }),
    actorAt("guard", "Guard", 26.4, 15.2, -1.5, "#2b3550", "#8a5a3a", { hair: "#1b2130", cap: "#1b2130" })
  ])
  objects = actorObjs()
}

// ---- Meeting --------------------------------------------------------------

let meetingStatic = []
let confetti = []
let confettiOn = false
let slideColor = "#38bdf8"

function buildMeeting() {
  sceneFog = { color: "#232c42", near: 16, far: 44 }
  sceneBg = "#161d2c"
  let objs = [floorPlane(12, 9, "#2b344a"), ceilingPlane(12, 9, 3.0, "#222a3d")]
  objs.push({ id: "rug", type: "plane", position: { x: 6, y: 0.012, z: 3.6 },
    rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 8, height: 4.4, color: "#2a3145" })
  objs.push(lightPanel("mlp1", 6, 3.4, 2.96, "#dbe6ff"))
  // Ceiling projector, aimed at the screen it will shortly betray.
  objs.push({ id: "proj_m", type: "cylinder", position: { x: 6, y: 2.85, z: 3.4 }, radius: 0.03, height: 0.28, color: "#1f2430" })
  objs.push({ id: "proj_b", type: "box", position: { x: 6, y: 2.63, z: 3.4 }, width: 0.34, height: 0.2, depth: 0.44, color: "#2a3245", metalness: 0.3, roughness: 0.6 })
  objs.push({ id: "proj_l", type: "cylinder", position: { x: 6, y: 2.63, z: 3.1 }, rotation: { x: Math.PI / 2, y: 0, z: 0 }, radius: 0.06, height: 0.12,
    color: "#dbe6ff", emissive: slideColor, emissiveIntensity: 1.2 })
  objs.push({ id: "proj_beam", type: "plane", position: { x: 6, y: 2.2, z: 1.6 }, rotation: { x: -0.35, y: 0, z: 0 },
    width: 2.4, height: 3.0, color: slideColor, opacity: 0.06 })
  // Shell walls with glass sides.
  objs.push({ id: "mw_back",  type: "box", position: { x: 6, y: 1.5, z: -0.4 }, width: 13, height: 3.2, depth: 0.6, color: "#2b3550" })
  objs.push({ id: "mw_glassL", type: "box", position: { x: -0.35, y: 1.5, z: 4 }, width: 0.15, height: 3.0, depth: 9.6, color: "#7dd3fc", opacity: 0.16 })
  objs.push({ id: "mw_glassR", type: "box", position: { x: 12.35, y: 1.5, z: 4 }, width: 0.15, height: 3.0, depth: 9.6, color: "#7dd3fc", opacity: 0.16 })
  // The presentation screen in a frame, and PAX.
  objs.push({ id: "mframe", type: "box", position: { x: 6, y: 1.7, z: 0.1 },
    width: 5.8, height: 2.6, depth: 0.08, color: "#0a0e18" })
  objs.push({ id: "mscreen", type: "box", position: { x: 6, y: 1.7, z: 0.16 },
    width: 5.4, height: 2.2, depth: 0.06, color: "#0b1220", emissive: slideColor, emissiveIntensity: 1.25 })
  let slw = [3.6, 4.2, 2.8]
  for (let i = 0; i < 3; i++) {
    objs.push({ id: "sline" + i, type: "box", position: { x: 5.4 + (i % 2) * 0.3, y: 2.15 - i * 0.42, z: 0.21 },
      width: slw[i], height: 0.13, depth: 0.02, color: "#f8fafc", opacity: 0.85 })
  }
  objs.push(blob("pax", 9.6, 0.6, 0.34, 0.2))
  objs.push({ id: "pax", type: "torus", position: { x: 9.6, y: 1.9, z: 0.6 }, radius: 0.42,
    color: "#f8fafc", emissive: "#fb7185", emissiveIntensity: 1.5,
    animate: { rotateY: 0.02, floatAmplitude: 0.08, floatSpeed: 1.4 } })
  objs.push({ id: "pax_core", type: "sphere", position: { x: 9.6, y: 1.9, z: 0.6 }, radius: 0.14,
    color: "#fb7185", emissive: "#fecdd3", emissiveIntensity: 1.8,
    animate: { floatAmplitude: 0.08, floatSpeed: 1.4 } })
  // Table, chairs, colleagues.
  objs.push({ id: "mtable", type: "box", position: { x: 6, y: 0.72, z: 3.4 }, width: 6.4, height: 0.12, depth: 2.2, color: "#7c6f5a", roughness: 0.7 })
  objs.push({ id: "mtleg1", type: "cylinder", position: { x: 3.4, y: 0.36, z: 3.4 }, radius: 0.09, height: 0.72, color: "#4a4336" })
  objs.push({ id: "mtleg2", type: "cylinder", position: { x: 8.6, y: 0.36, z: 3.4 }, radius: 0.09, height: 0.72, color: "#4a4336" })
  // Chairs face wherever their occupant faces — Alex, at (6, 6.6).
  let seats = [[3.4, 2.4], [5.15, 2.4], [6.9, 2.4], [8.65, 2.4], [4.2, 4.6]]
  for (let i = 0; i < seats.length; i++) {
    let sd = Math.atan2(6 - seats[i][0], 6.6 - seats[i][1])
    objs = objs.concat(chairAt("mchair" + i, seats[i][0], seats[i][1], sd, "#2c3547"))
  }
  // Table props: two open laptops, three cups.
  objs = objs.concat(laptopAt("mlap1", 4.6, 0.79, 3.1, 2.9, "#38bdf8"))
  objs = objs.concat(laptopAt("mlap2", 7.4, 0.79, 3.6, -2.8, "#0b1220"))
  for (let i = 0; i < 3; i++) {
    objs.push({ id: "mcup" + i, type: "cylinder", position: { x: 4 + i * 1.7, y: 0.83, z: 3.9 }, radius: 0.06, height: 0.12, color: "#f8fafc" })
  }
  meetingStatic = objs
  objects = meetingStatic
  // The room was lit by three lamps while the office had seven; in fullscreen
  // that read as almost black. Match the office's level.
  lights = [
    { id: "amb", type: "ambient", color: "#b3c0dc", intensity: 1.85 },
    { id: "hemi", type: "hemisphere", color: "#dbe4f5", groundColor: "#525d78", intensity: 1.35 },
    { id: "dirm", type: "directional", color: "#dbe6ff", intensity: 0.6, position: { x: 4, y: 9, z: 8 } },
    { id: "scr", type: "point", color: slideColor, intensity: 2.8, position: { x: 6, y: 2, z: 1.4 } },
    { id: "fill", type: "point", color: "#e2e8f0", intensity: 1.9, position: { x: 6, y: 2.6, z: 5.5 } },
    { id: "fill2", type: "point", color: "#e8eefc", intensity: 1.5, position: { x: 6, y: 2.5, z: 3.2 } }
  ]
  hotspots = [
    { id: "mcol0_t", x: 3.4, z: 2.5, r: 6, label: "", minor: true },
    { id: "mcol2_t", x: 6.9, z: 2.5, r: 6, label: "", minor: true },
    { id: "mcol4_t", x: 4.2, z: 4.4, r: 6, label: "", minor: true }
  ]
  meetingStatic = meetingStatic.concat(hotspotMarkers())
  sceneStatic = meetingStatic
  blockers = []
  // The room, as people: four along the table, one opposite, and Clive standing
  // beside the screen muting himself.
  let mBody = ["#64748b", "#5b6478", "#94a3b8", "#63586e"]
  let mHair = ["#3a2c1c", "#1f2937", "#6b4b2a", "#22262e"]
  let cast = []
  // Everyone turns toward Alex rather than the slide.
  for (let i = 0; i < 4; i++) {
    let ax = 3.4 + i * 1.75, az = 2.4
    cast.push(actorAt("mcol" + i, "", ax, az, Math.atan2(6 - ax, 6.6 - az), mBody[i], "#d4b394", { hair: mHair[i], sit: true }))
  }
  cast.push(actorAt("mcol4", "", 4.2, 4.6, Math.atan2(6 - 4.2, 6.6 - 4.6), "#4f6180", "#8a5a3a", { hair: "#2b2b33", sit: true }))
  cast.push(actorAt("clive", "Clive", 2.6, 1.6, Math.atan2(6 - 2.6, 6.6 - 1.6), "#94a3b8", "#d4b394", { hair: "#3f3f46" }))
  ensureActors("meeting", cast)
  objects = actorObjs()
  if (!cutActive) {
    cameraPos = { x: 6, y: 1.6, z: 6.6 }
    cameraLookAt = { x: 6, y: 1.6, z: 0 }
  }
}

function setSlide(color) {
  slideColor = color
  buildMeeting()
  composeScene()
}

function spawnConfetti() {
  confetti = []
  for (let i = 0; i < 60; i++) {
    confetti.push({
      x: 2 + myRand() * 8, y: 3.1 + myRand() * 0.8, z: 0.8 + myRand() * 3.6,
      vy: 0.018 + myRand() * 0.02, drift: (myRand() - 0.5) * 0.02,
      rot: myRand() * 3.14, color: CONFETTI_COLORS[i % CONFETTI_COLORS.length], frozen: false
    })
  }
  confettiOn = true
}

let CONFETTI_COLORS = ["#f472b6", "#60a5fa", "#facc15", "#4ade80", "#c084fc"]

function confettiObjs() {
  let out = []
  for (let i = 0; i < confetti.length; i++) {
    let f = confetti[i]
    out.push({ id: "cf" + i, type: "box", position: { x: f.x, y: f.y, z: f.z },
      rotation: { x: f.rot, y: f.rot * 1.7, z: 0 },
      width: 0.09, height: 0.02, depth: 0.14, color: f.color,
      emissive: f.color, emissiveIntensity: 0.25 })
  }
  return out
}

function confettiTick() {
  if (!confettiOn) { return }
  let live = false
  for (let i = 0; i < confetti.length; i++) {
    let f = confetti[i]
    if (f.frozen) { continue }
    f.y = f.y - f.vy
    f.x = f.x + f.drift
    f.rot = f.rot + 0.12
    if (f.y <= 0.03) { f.y = 0.03; f.frozen = true } else { live = true }
  }
  composeScene()
  if (!live) { confettiOn = false }
}

// ---- Flat -----------------------------------------------------------------

let flatStatic = []

function buildFlat() {
  loadGrid(FLAT_ROWS)
  sceneFog = { color: "#1c150e", near: 10, far: 32 }
  sceneBg = "#120d08"
  let objs = [floorPlane(18, 14, "#41352a"), ceilingPlane(18, 14, 2.5, "#251d15")]
  objs = objs.concat(wallsFrom(FLAT_ROWS, "#4d3e37", 2.5))
  objs = objs.concat(skirting("fsk", 18, 14, "#33291f"))
  objs = objs.concat(doorwayAt("fdoor", 6, 12.82, 0, "#33291f", "#5c4a3d", priyaHere ? 1.5 : 0.12))
  // Kitchenette: counter, sink, kettle, two mugs. The founder food pyramid.
  objs.push(blob("kit", 3.4, 5.6, 1.1, 0.2))
  objs.push({ id: "kit_c", type: "box", position: { x: 3.4, y: 0.44, z: 5.6 }, width: 2.4, height: 0.88, depth: 0.7, color: "#5a4a3a" })
  objs.push({ id: "kit_t", type: "box", position: { x: 3.4, y: 0.9, z: 5.6 }, width: 2.5, height: 0.06, depth: 0.76, color: "#7d6a55" })
  objs.push({ id: "kit_sink", type: "box", position: { x: 2.8, y: 0.92, z: 5.6 }, width: 0.6, height: 0.05, depth: 0.5, color: "#9aa4b2", metalness: 0.6, roughness: 0.35 })
  objs.push({ id: "kit_tap", type: "cylinder", position: { x: 2.8, y: 1.08, z: 5.85 }, radius: 0.025, height: 0.28, color: "#cbd5e1", metalness: 0.7, roughness: 0.25 })
  objs.push({ id: "kit_ket", type: "cylinder", position: { x: 4.1, y: 1.02, z: 5.5 }, radius: 0.13, height: 0.2, color: "#e5e7eb", metalness: 0.4, roughness: 0.4 })
  objs.push({ id: "kit_m1", type: "cylinder", position: { x: 4.45, y: 0.99, z: 5.75 }, radius: 0.06, height: 0.11, color: "#f8fafc" })
  objs.push({ id: "kit_m2", type: "cylinder", position: { x: 4.62, y: 0.99, z: 5.55 }, radius: 0.06, height: 0.11, color: "#fbbf24" })
  objs.push({ id: "rug", type: "plane", position: { x: 8, y: 0.012, z: 7 },
    rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 6, height: 4.5, color: "#6b4a3a" })
  // Window: night city on the far wall.
  objs.push({ id: "winframe", type: "box", position: { x: 9, y: 1.6, z: 1.03 }, width: 3.0, height: 1.7, depth: 0.07, color: "#2a2018" })
  objs.push({ id: "window", type: "box", position: { x: 9, y: 1.6, z: 1.08 },
    width: 2.6, height: 1.3, depth: 0.05, color: "#0b1026", emissive: "#16204a", emissiveIntensity: 0.9 })
  objs.push({ id: "winsill", type: "box", position: { x: 9, y: 0.9, z: 1.2 }, width: 3.1, height: 0.07, depth: 0.26, color: "#3a2c22" })
  objs.push({ id: "winbar", type: "box", position: { x: 9, y: 1.6, z: 1.15 }, width: 0.05, height: 1.3, depth: 0.03, color: "#2a2018" })
  objs.push({ id: "winbar2", type: "box", position: { x: 9, y: 1.6, z: 1.15 }, width: 2.6, height: 0.05, depth: 0.03, color: "#2a2018" })
  objs.push({ id: "curtainL", type: "box", position: { x: 7.35, y: 1.55, z: 1.2 }, width: 0.5, height: 1.75, depth: 0.1, color: "#6b4a3a" })
  objs.push({ id: "curtainR", type: "box", position: { x: 10.65, y: 1.55, z: 1.2 }, width: 0.5, height: 1.75, depth: 0.1, color: "#6b4a3a" })
  objs.push({ id: "moon", type: "sphere", position: { x: 9.8, y: 2.0, z: 1.11 }, radius: 0.12,
    color: "#f8fafc", emissive: "#e6ecff", emissiveIntensity: 1.6 })
  let cityCols = [8.2, 8.7, 9.1, 9.5, 10.0]
  for (let i = 0; i < cityCols.length; i++) {
    objs.push({ id: "city" + i, type: "box", position: { x: cityCols[i], y: 1.15 + (i % 3) * 0.12, z: 1.11 },
      width: 0.16, height: 0.3 + (i % 2) * 0.2, depth: 0.03, color: "#0b1026",
      emissive: "#f59e0b", emissiveIntensity: 0.55 })
  }
  objs.push({ id: "winpool", type: "plane", position: { x: 9, y: 0.014, z: 2.4 },
    rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 2.6, height: 1.8, color: "#94a8ff", opacity: 0.1 })
  // Bed with mattress, pillow, blanket.
  objs.push({ id: "bed", type: "box", position: { x: 14.5, y: 0.22, z: 10.5 }, width: 2.2, height: 0.44, depth: 3.4, color: "#5c4033" })
  objs.push({ id: "mattress", type: "box", position: { x: 14.5, y: 0.5, z: 10.5 }, width: 2.05, height: 0.18, depth: 3.25, color: "#cbb9a2" })
  objs.push({ id: "pillow", type: "box", position: { x: 14.5, y: 0.63, z: 9.2 }, width: 1.1, height: 0.14, depth: 0.6, color: "#e8ddc9" })
  objs.push({ id: "blanket", type: "box", position: { x: 14.5, y: 0.61, z: 11.3 }, width: 2.06, height: 0.1, depth: 1.6, color: "#7a5c68" })
  // Bookshelf.
  objs.push({ id: "shelf", type: "box", position: { x: 12.5, y: 0.9, z: 12.9 }, width: 2.2, height: 1.8, depth: 0.4, color: "#3a2e24" })
  let bookCols = ["#f87171", "#38bdf8", "#4ade80", "#facc15", "#c084fc", "#fb923c"]
  for (let i = 0; i < 6; i++) {
    objs.push({ id: "book" + i, type: "box", position: { x: 11.7 + i * 0.28, y: 1.35, z: 12.85 },
      width: 0.18, height: 0.52, depth: 0.3, color: bookCols[i], roughness: 1 })
  }
  // Fairy lights along the west wall — they survive every budget cut.
  for (let i = 0; i < 8; i++) {
    objs.push({ id: "fairy" + i, type: "sphere", position: { x: 1.15, y: 2.1 - (i % 2) * 0.14, z: 3 + i * 1.1 },
      radius: 0.045, color: "#fde68a", emissive: "#fde68a", emissiveIntensity: 1.6 })
  }
  // Moving boxes.
  objs = objs.concat(posterAt("fposter", 3.4, 1.07, 1.75, 1.1, 0.75, "#f59e0b", true))
  // The principles, on index cards, in the order they were earned.
  for (let i = 0; i < pinnedCount; i++) {
    let px = 0.9 + i * 0.86
    objs.push({ id: "pcard" + i, type: "box", position: { x: px, y: 1.62, z: 1.09 },
      rotation: { x: 0, y: 0, z: (i % 2 === 0 ? 0.035 : -0.045) },
      width: 0.72, height: 0.5, depth: 0.02, color: "#f6efdc", emissive: "#f6efdc", emissiveIntensity: 0.16 })
    objs.push({ id: "pcard" + i + "_r", type: "box", position: { x: px, y: 1.76, z: 1.1 },
      rotation: { x: 0, y: 0, z: (i % 2 === 0 ? 0.035 : -0.045) },
      width: 0.66, height: 0.035, depth: 0.015, color: "#c2544a" })
    for (let k = 0; k < 2; k++) {
      objs.push({ id: "pcard" + i + "_l" + k, type: "box", position: { x: px - 0.04 + k * 0.03, y: 1.6 - k * 0.11, z: 1.1 },
        rotation: { x: 0, y: 0, z: (i % 2 === 0 ? 0.035 : -0.045) },
        width: 0.52 - k * 0.16, height: 0.03, depth: 0.015, color: "#7d8798" })
    }
    objs.push({ id: "pcard" + i + "_pin", type: "sphere", position: { x: px, y: 1.83, z: 1.12 }, radius: 0.028, color: "#dc2626", emissive: "#dc2626", emissiveIntensity: 0.5 })
  }
  for (let i = 0; i < 3; i++) {
    objs.push({ id: "fphoto" + i, type: "box", position: { x: 5.4 + i * 0.62, y: 1.82 - (i % 2) * 0.12, z: 1.07 },
      rotation: { x: 0, y: 0, z: (i % 2 === 0 ? 0.04 : -0.05) },
      width: 0.44, height: 0.34, depth: 0.03, color: "#dfd6c4" })
  }
  objs.push({ id: "laundry", type: "sphere", position: { x: 11.4, y: 0.22, z: 11.6 }, radius: 0.44, color: "#5b5470", roughness: 1 })
  objs.push({ id: "laundry2", type: "sphere", position: { x: 11.9, y: 0.16, z: 12.1 }, radius: 0.3, color: "#6b6480", roughness: 1 })
  objs.push({ id: "boxpile", type: "box", position: { x: 3, y: 0.55, z: 9.5 }, width: 1.4, height: 1.1, depth: 1.2, color: "#8a6f4d" })
  objs.push({ id: "boxpile2", type: "box", position: { x: 3.5, y: 1.35, z: 9.3 }, width: 0.9, height: 0.5, depth: 0.8, color: "#77603f" })
  // Desk with the laptop (budget) — hotspot — plus lamp.
  objs.push({ id: "hs_laptop", type: "box", position: { x: 2, y: 0.42, z: 2 }, width: 1.8, height: 0.84, depth: 0.9, color: "#5c4a3d" })
  objs = objs.concat(laptopAt("alexlap", 2, 0.85, 1.85, Math.PI, budgetDone ? "#4ade80" : "#f59e0b"))
  objs.push({ id: "lamp_pole", type: "cylinder", position: { x: 1.2, y: 1.0, z: 1.4 }, radius: 0.04, height: 0.9, color: "#2a2018" })
  objs.push({ id: "lamp_head", type: "sphere", position: { x: 1.2, y: 1.5, z: 1.4 }, radius: 0.14,
    color: "#fbbf6b", emissive: "#fbbf6b", emissiveIntensity: 1.4 })
  // The phone, on its little nightstand.
  objs.push({ id: "ph_stand", type: "box", position: { x: 16, y: 0.32, z: 2 }, width: 0.6, height: 0.64, depth: 0.5, color: "#4a3b2e" })
  objs.push({ id: "hs_phone", type: "box", position: { x: 16, y: 0.74, z: 2 }, rotation: { x: -0.18, y: 0.3, z: 0 },
    width: 0.22, height: 0.42, depth: 0.04, color: "#18181b",
    emissive: "#22d3ee", emissiveIntensity: phoneRinging ? 1.6 : 0.15,
    animate: phoneRinging ? { floatAmplitude: 0.05, floatSpeed: 6 } : { rotateY: 0 } })
  // LUMA: a monitor on an arm, with an eye that notices you.
  objs.push({ id: "luma_base", type: "cylinder", position: { x: 14, y: 0.06, z: 8 }, radius: 0.3, height: 0.1, color: "#1f2430" })
  objs.push({ id: "luma_arm", type: "cylinder", position: { x: 14, y: 0.6, z: 8 }, radius: 0.05, height: 1.0, color: "#3a4356", metalness: 0.5 })
  objs.push({ id: "hs_luma", type: "box", position: { x: 14, y: 1.3, z: 7.95 }, rotation: { x: -0.12, y: 0, z: 0 },
    width: 1.05, height: 0.72, depth: 0.07, color: "#1f2937",
    emissive: "#a78bfa", emissiveIntensity: budgetDone ? 1.3 : 0.3 })
  objs.push({ id: "luma_eye", type: "sphere", position: { x: 14, y: 1.32, z: 7.88 }, radius: 0.09,
    color: "#a78bfa", emissive: "#ddd6fe", emissiveIntensity: budgetDone ? 1.8 : 0.4,
    animate: { floatAmplitude: 0.02, floatSpeed: 1.6 } })
  // Gadgets that die as subscriptions are cancelled.
  if (!isCancelled("mindful")) {
    objs.push({ id: "g_speaker", type: "torus", position: { x: 6, y: 1.0, z: 1.4 }, radius: 0.28,
      color: "#0f172a", emissive: "#22d3ee", emissiveIntensity: 1.2, animate: { rotateY: 0.02 } })
  }
  if (!isCancelled("clouds")) {
    objs.push({ id: "g_monitor2", type: "box", position: { x: 3.4, y: 1.12, z: 1.7 }, width: 0.7, height: 0.45, depth: 0.05,
      color: "#0b1220", emissive: "#38bdf8", emissiveIntensity: 1.0 })
  }
  if (!isCancelled("copilot")) {
    objs.push({ id: "g_kbd", type: "box", position: { x: 2, y: 0.87, z: 2.25 }, width: 0.9, height: 0.04, depth: 0.3,
      color: "#111827", emissive: "#e879f9", emissiveIntensity: 1.1 })
  }
  if (!isCancelled("domain")) {
    objs.push({ id: "g_router", type: "box", position: { x: 12.5, y: 0.35, z: 12.6 }, width: 0.6, height: 0.15, depth: 0.4,
      color: "#1f2937", emissive: "#4ade80", emissiveIntensity: 1.3 })
  }
  if (hasItem("plant")) { objs = objs.concat(plantAt("plant", 16.6, 6)) }
  if (hasItem("doug")) {
    objs.push({ id: "doug", type: "sphere", position: { x: 2.6, y: 1.0, z: 1.9 }, radius: 0.14,
      color: "#facc15", emissive: "#facc15", emissiveIntensity: 0.5,
      animate: { floatAmplitude: 0.03, floatSpeed: 1.2 } })
  }
  if (hasItem("mug")) {
    objs.push({ id: "mug", type: "cylinder", position: { x: 1.55, y: 0.92, z: 2.1 }, radius: 0.07, height: 0.12, color: "#f8fafc" })
  }
  if (priyaHere) {
    objs.push({ id: "priya_box", type: "box", position: { x: 6.8, y: 0.25, z: 12.6 }, width: 0.6, height: 0.5, depth: 0.5, color: "#8a6f4d" })
  }
  objs.push({ id: "flpatch", type: "plane", position: { x: 12, y: 0.006, z: 4 }, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 6, height: 4, color: "#463930" })
  flatStatic = objs
  objects = flatStatic
  let ls = [
    { id: "amb", type: "ambient", color: "#d9b38c", intensity: flatAmbient() },
    { id: "hemi", type: "hemisphere", color: "#eed3ac", groundColor: "#4a3a2a", intensity: 1.0 },
    { id: "lamp", type: "point", color: "#fbbf6b", intensity: 2.6, position: { x: 1.4, y: 1.7, z: 1.6 } },
    { id: "dirw", type: "directional", color: "#e8c9a0", intensity: 0.5, position: { x: 14, y: 10, z: 16 } },
    { id: "win", type: "point", color: "#94a8ff", intensity: 0.7, position: { x: 9, y: 1.8, z: 2 } }
  ]
  if (!isCancelled("mindful")) { ls.push({ id: "gl_spk", type: "point", color: "#22d3ee", intensity: 0.8, position: { x: 6, y: 1.4, z: 1.8 } }) }
  if (!isCancelled("clouds"))  { ls.push({ id: "gl_mon", type: "point", color: "#38bdf8", intensity: 0.7, position: { x: 3.4, y: 1.5, z: 2.2 } }) }
  if (!isCancelled("copilot")) { ls.push({ id: "gl_kbd", type: "point", color: "#e879f9", intensity: 0.6, position: { x: 2, y: 1.3, z: 2.6 } }) }
  lights = ls
  hotspots = [
    { id: "hs_laptop", x: 2,  z: 2, r: 2.0, label: budgetDone ? "Laptop — Patchwork notes" : "Laptop — face the numbers" },
    { id: "hs_phone",  x: 16, z: 2, r: 1.9, label: phoneRinging ? "Phone — Mum calling" : "Phone" },
    { id: "hs_luma",   x: 14, z: 8, r: 2.0, label: budgetDone ? "The old LUMA project" : "Old side project (later)" }
  ]
  if (priyaHere) { hotspots.push({ id: "hs_priya", x: 6, z: 12.6, r: 2.2, label: scopeDone ? "Priya" : (priyaMode === "" ? "The door — Priya" : "Priya — the Scope Board") }) }
  if (hasItem("doug")) { hotspots.push({ id: "doug", x: 2.6, z: 1.9, r: 1.8, label: "Doug", minor: true }) }
  hotspots.push({ id: "window", x: 9, z: 1.1, r: 2.0, label: "The window", minor: true })
  hotspots.push({ id: "bed", x: 14.5, z: 10.5, r: 2.2, label: "The bed", minor: true })
  flatStatic = flatStatic.concat(hotspotMarkers())
  sceneStatic = flatStatic
  blockers = []
  clearConfetti()
  let cast = []
  if (priyaHere) {
    cast.push(actorAt("priya", "Priya", 6, 12.6, Math.PI, "#7c3aed", "#8a5a3a", { hair: "#1f2937" }))
  }
  ensureActors(priyaHere ? "flat-priya" : "flat", cast)
  objects = actorObjs()
}

function flatAmbient() {
  let n = 0
  for (let i = 0; i < SUBS.length; i++) { if (!SUBS[i].locked && isCancelled(SUBS[i].id)) { n = n + 1 } }
  return Math.max(0.65, 1.35 - n * 0.11)
}

// ---- Bakery ---------------------------------------------------------------

let bakeryStatic = []

function buildBakery() {
  loadGrid(BAKERY_ROWS)
  sceneFog = { color: "#2b1f14", near: 12, far: 36 }
  sceneBg = "#170f08"
  let objs = [floorPlane(24, 16, "#4a3a29"), ceilingPlane(24, 16, 2.5, "#2b2015")]
  objs = objs.concat(wallsFrom(BAKERY_ROWS, "#54413a", 2.5))
  objs = objs.concat(skirting("bsk", 24, 16, "#3a2c22"))
  objs = objs.concat(dado("bdd", 24, 16, "#4a382c", 1.3))
  objs = objs.concat(ceilingBeams("bbm", 24, 16, 2.5, 2, "#3a2c22"))
  objs = objs.concat(doorwayAt("bdoor", 22, 2, Math.PI / 2, "#3a2c22", "#6b5340", -1.35))
  objs = objs.concat(neonExit("bexit_sign", 21.79, 2.30, 2, -Math.PI / 2, "#4ade80", 0.5))
  // Chequerboard floor in front of the counter — four tiles is enough to read.
  for (let i = 0; i < 8; i++) {
    let tx = 8 + (i % 4) * 2.2
    let tz = 11.2 + Math.floor(i / 4) * 2.2
    objs.push({ id: "tile" + i, type: "plane", position: { x: tx, y: 0.008, z: tz },
      rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 2.1, height: 2.1,
      color: (i + Math.floor(i / 4)) % 2 === 0 ? "#5c4835" : "#4a3a2b" })
  }
  // The till: a small brass box that has heard everything.
  objs.push({ id: "till", type: "box", position: { x: 8.6, y: 1.18, z: 7.4 }, width: 0.5, height: 0.26, depth: 0.42, color: "#8a6a3a", metalness: 0.45, roughness: 0.5 })
  objs.push({ id: "till_k", type: "box", position: { x: 8.6, y: 1.32, z: 7.28 }, rotation: { x: -0.3, y: 0, z: 0 }, width: 0.4, height: 0.03, depth: 0.2, color: "#3a2c1c" })
  // Counter island with warm top and glass front.
  objs.push({ id: "counterTop", type: "box", position: { x: 11, y: 1.02, z: 8 }, width: 8.4, height: 0.1, depth: 4.4, color: "#8a6f4d", roughness: 0.6 })
  objs.push({ id: "glass", type: "box", position: { x: 11, y: 0.6, z: 10.2 }, width: 8.2, height: 0.8, depth: 0.08, color: "#cbd5e1", opacity: 0.22 })
  // Goods on the counter: donuts and buns.
  let donutCols = ["#f4a4c0", "#b8763e", "#f7dba7"]
  for (let i = 0; i < 3; i++) {
    objs.push({ id: "donut" + i, type: "torus", position: { x: 8.6 + i * 1.1, y: 1.16, z: 9.3 },
      rotation: { x: -Math.PI / 2, y: 0, z: 0 }, radius: 0.16, tube: 0.075, color: donutCols[i], roughness: 0.9 })
  }
  for (let i = 0; i < 3; i++) {
    objs.push({ id: "bun" + i, type: "sphere", position: { x: 12.4 + i * 0.8, y: 1.18, z: 9.0 }, radius: 0.16, color: "#d9a05f", roughness: 1 })
  }
  objs.push({ id: "cakebox", type: "box", position: { x: 13.6, y: 1.2, z: 7.2 }, width: 0.6, height: 0.3, depth: 0.6, color: "#f8e8ff" })
  // Actual goods: croissants in a row, a proper cake, cupcakes.
  for (let i = 0; i < 3; i++) {
    objs = objs.concat(croissantAt("cro" + i, 9.2 + i * 0.65, 1.14, 7.4, 0.4 + i * 0.7))
  }
  objs = objs.concat(cakeAt("cake1", 11.8, 1.07, 7.2))
  let frost = ["#f4a4c0", "#a78bfa", "#86efac"]
  for (let i = 0; i < 3; i++) {
    objs = objs.concat(cupcakeAt("cup" + i, 10.6 + i * 0.45, 1.07, 8.6, frost[i]))
  }
  // Shelves along the west wall with loaves.
  objs.push({ id: "shelf1", type: "box", position: { x: 1.4, y: 1.0, z: 8 }, width: 0.6, height: 0.08, depth: 6, color: "#7a5f43" })
  objs.push({ id: "shelf2", type: "box", position: { x: 1.4, y: 1.7, z: 8 }, width: 0.6, height: 0.08, depth: 6, color: "#7a5f43" })
  for (let i = 0; i < 5; i++) {
    objs.push({ id: "loaf" + i, type: "cylinder", position: { x: 1.4, y: 1.16, z: 5.6 + i * 1.2 },
      rotation: { x: Math.PI / 2, y: 0, z: 0 }, radius: 0.16, height: 0.55, color: "#c68b4e", roughness: 1 })
  }
  for (let i = 0; i < 4; i++) {
    objs.push({ id: "loaf2_" + i, type: "sphere", position: { x: 1.4, y: 1.9, z: 6 + i * 1.3 }, radius: 0.17, color: "#e0b078", roughness: 1 })
  }
  // The oven, glowing patiently.
  objs.push({ id: "oven", type: "box", position: { x: 6.5, y: 0.8, z: 13.2 }, width: 1.8, height: 1.6, depth: 1.0, color: "#3a3a40" })
  objs.push({ id: "ovenDoor", type: "box", position: { x: 6.5, y: 0.7, z: 12.68 }, width: 1.2, height: 0.5, depth: 0.06,
    color: "#1a1a1e", emissive: "#f97316", emissiveIntensity: 0.9 })
  // Flour sacks and a menu board.
  objs.push({ id: "sack1", type: "box", position: { x: 21.5, y: 0.4, z: 12.5 }, width: 0.8, height: 0.8, depth: 0.7, color: "#d8cbb4" })
  objs.push({ id: "sack2", type: "box", position: { x: 21.0, y: 0.35, z: 13.4 }, width: 0.7, height: 0.7, depth: 0.6, color: "#c9bca3" })
  objs.push({ id: "menu_f", type: "box", position: { x: 11, y: 1.9, z: 14.94 }, width: 3.4, height: 1.3, depth: 0.09, color: "#5a4028" })
  objs.push({ id: "menu", type: "box", position: { x: 11, y: 1.9, z: 14.88 }, width: 3.15, height: 1.08, depth: 0.06, color: "#20241f" })
  objs.push({ id: "menu_hd", type: "box", position: { x: 11, y: 2.28, z: 14.84 }, width: 1.8, height: 0.07, depth: 0.02, color: "#f5ead2", emissive: "#f5ead2", emissiveIntensity: 0.45 })
  let mlw = [2.2, 1.7, 2.4, 1.5, 2.0]
  for (let i = 0; i < 5; i++) {
    objs.push({ id: "menuline" + i, type: "box", position: { x: 10.5 + (i % 2) * 0.25, y: 2.08 - i * 0.19, z: 14.84 },
      width: mlw[i], height: 0.045, depth: 0.02, color: "#cbb894", emissive: "#cbb894", emissiveIntensity: 0.25 })
  }
  // Hanging greenery over the counter.
  for (let i = 0; i < 2; i++) {
    let hx = 8.4 + i * 5.2
    objs.push({ id: "hang" + i + "_c", type: "cylinder", position: { x: hx, y: 2.3, z: 6.2 }, radius: 0.02, height: 0.42, color: "#3a2c22" })
    objs.push({ id: "hang" + i + "_p", type: "cylinder", position: { x: hx, y: 2.0, z: 6.2 }, radius: 0.15, height: 0.22, color: "#a1673a" })
    objs.push({ id: "hang" + i + "_g", type: "icosahedron", position: { x: hx, y: 1.82, z: 6.2 }, radius: 0.24, color: "#4b9d5c", roughness: 1 })
  }
  // Pendant lamps.
  let pendants = [[6, 8], [16, 5]]
  for (let i = 0; i < pendants.length; i++) {
    objs.push({ id: "pend" + i + "_c", type: "cylinder", position: { x: pendants[i][0], y: 2.3, z: pendants[i][1] }, radius: 0.02, height: 0.4, color: "#26201a" })
    objs.push({ id: "pend" + i + "_b", type: "sphere", position: { x: pendants[i][0], y: 2.0, z: pendants[i][1] }, radius: 0.16,
      color: "#ffca85", emissive: "#ffca85", emissiveIntensity: 1.7 })
  }
  // The duelling tablets, the paper board, and the door.
  objs.push({ id: "tabApost", type: "box", position: { x: 4, y: 0.7, z: 4.05 }, width: 0.1, height: 0.7, depth: 0.1, color: "#26201a" })
  objs.push({ id: "hs_tabA", type: "box", position: { x: 4, y: 1.12, z: 4 }, rotation: { x: -0.28, y: 0, z: 0 },
    width: 0.55, height: 0.4, depth: 0.05, color: "#0b1220", emissive: ordersDone ? "#4ade80" : "#38bdf8", emissiveIntensity: 1.1 })
  objs.push({ id: "tabBpost", type: "box", position: { x: 18, y: 0.7, z: 4.05 }, width: 0.1, height: 0.7, depth: 0.1, color: "#26201a" })
  objs.push({ id: "hs_tabB", type: "box", position: { x: 18, y: 1.12, z: 4 }, rotation: { x: -0.28, y: 0, z: 0 },
    width: 0.55, height: 0.4, depth: 0.05, color: "#0b1220", emissive: ordersDone ? "#4ade80" : "#f87171", emissiveIntensity: 1.1 })
  objs.push({ id: "hs_paper", type: "box", position: { x: 20, y: 1.4, z: 8 }, width: 1.6, height: 1.1, depth: 0.08,
    color: "#efe6cf", emissive: "#efe6cf", emissiveIntensity: ordersDone ? 0.12 : 0.4 })
  for (let i = 0; i < 4; i++) {
    objs.push({ id: "slip" + i, type: "box", position: { x: 19.6 + (i % 2) * 0.7, y: 1.55 - Math.floor(i / 2) * 0.4, z: 7.94 },
      width: 0.4, height: 0.28, depth: 0.02, color: "#fdf6e3", rotation: { x: 0, y: 0, z: (i % 2 === 0 ? 0.06 : -0.08) } })
  }
  objs.push({ id: "hs_exit", type: "box", position: { x: 22, y: 1.1, z: 2 }, width: 0.3, height: 2.2, depth: 1.6,
    color: "#2a2018", emissive: "#f59e0b", emissiveIntensity: pilotPromised ? 1.1 : 0.18 })

  // Steam over the oven, and a warm floor patch behind the counter.
  for (let i = 0; i < 3; i++) {
    objs.push({ id: "steam" + i, type: "sphere", position: { x: 6.1 + i * 0.4, y: 1.8 + i * 0.25, z: 13 }, radius: 0.12 + i * 0.04,
      color: "#f8fafc", opacity: 0.16, animate: { floatAmplitude: 0.1, floatSpeed: 0.8 + i * 0.3 } })
  }
  objs.push({ id: "bpatch", type: "plane", position: { x: 11, y: 0.006, z: 11.5 }, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 9, height: 4, color: "#54432f" })
  if (bakeryDay) {
    objs.push({ id: "doorpool", type: "plane", position: { x: 21, y: 0.014, z: 3.2 },
      rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 2.6, height: 2.6, color: "#ffe9c4", opacity: 0.16 })
  }
  bakeryStatic = objs
  objects = bakeryStatic
  if (bakeryDay) {
    sceneFog = { color: "#443322", near: 16, far: 44 }
    sceneBg = "#241812"
    lights = [
      { id: "amb", type: "ambient", color: "#f5dfc0", intensity: 2.2 },
      { id: "hemi", type: "hemisphere", color: "#fdf0da", groundColor: "#7a6248", intensity: 1.5 },
      { id: "day", type: "directional", color: "#fff2d8", intensity: 0.9, position: { x: 20, y: 12, z: 2 } },
      { id: "warm1", type: "point", color: "#ffd9a0", intensity: 2.2, position: { x: 6, y: 2.0, z: 8 } },
      { id: "warm2", type: "point", color: "#ffd9a0", intensity: 2.0, position: { x: 16, y: 2.0, z: 5 } },
      { id: "ovenGlow", type: "point", color: "#f97316", intensity: 1.2, position: { x: 6.5, y: 0.9, z: 12.2 } }
    ]
  } else {
  lights = [
    { id: "amb", type: "ambient", color: "#eccda6", intensity: 1.9 },
    { id: "hemi", type: "hemisphere", color: "#f7dfc0", groundColor: "#6a543f", intensity: 1.2 },
    { id: "dirb", type: "directional", color: "#f2d3a4", intensity: 0.5, position: { x: 18, y: 10, z: 14 } },
    { id: "warm1", type: "point", color: "#ffca85", intensity: 2.6, position: { x: 6, y: 2.0, z: 8 } },
    { id: "warm2", type: "point", color: "#ffca85", intensity: 2.4, position: { x: 16, y: 2.0, z: 5 } },
    { id: "ovenGlow", type: "point", color: "#f97316", intensity: 1.0, position: { x: 6.5, y: 0.9, z: 12.2 } }
  ]
  }
  hotspots = [
    { id: "hs_tabA",  x: 4,  z: 4,  r: 1.9, label: ordersDone ? "Delivery tablet A (at peace)" : "Delivery tablet A" },
    { id: "hs_tabB",  x: 18, z: 4,  r: 1.9, label: ordersDone ? "Delivery tablet B (at peace)" : "Delivery tablet B" },
    { id: "hs_paper", x: 20, z: 8,  r: 1.9, label: bakeryDay ? (wfDone ? "The policy board" : "The workflow board") : "The paper orders" },
    { id: "hs_mabel", x: 4,  z: 10, r: 2.2, label: "Mabel" },
    { id: "hs_exit",  x: 22, z: 2,  r: 2.0, label: bakeryDay ? (wfDone ? "Home. Tuesday is tomorrow" : "The door (not yet)") : (pilotPromised ? "Head home and build" : "The door") },
    { id: "oven", x: 6.5, z: 13.2, r: 2.0, label: "The oven", minor: true }
  ]
  bakeryStatic = bakeryStatic.concat(hotspotMarkers())
  sceneStatic = bakeryStatic
  blockers = [
    { x: 11, z: 8, hw: 4.5, hd: 2.5 },      // counter island
    { x: 1.4, z: 8, hw: 0.8, hd: 3.2 },     // west shelving
    { x: 6.5, z: 13.2, hw: 1.1, hd: 0.8 },  // oven
    { x: 21.2, z: 13, hw: 1.0, hd: 1.2 },   // flour sacks
    { x: 4, z: 10, hw: 0.7, hd: 0.7 },      // Mabel's spot
    { x: 16.5, z: 5, hw: 0.7, hd: 0.7 }     // Leo's spot
  ]
  clearConfetti()
  let cast = [
    actorAt("mabel", "Mabel", 4, 10, 0, "#b45309", "#8a5a3a", { apron: "#fef3c7", hair: "#3f2d23" }),
    actorAt("leo", "Leo", 16.5, 5, -0.7, "#3f6212", "#a16207", { cap: "#365314", hair: "#1f2937" })
  ]
  if (bakeryDay) {
    cast.push(actorAt("cust1", "", 6, 3, 1.57, "#7a8ba8", "#d4b394", { hair: "#4a3628", path: [[18, 3], [6, 3]], sp: 0.024 }))
    cast.push(actorAt("cust2", "", 19, 12, -1.57, "#a8707a", "#8a5a3a", { hair: "#22262e", path: [[19, 4], [19, 12]], sp: 0.022 }))
    if (priyaMode !== "alone" && priyaMode !== "") {
      cast.push(actorAt("priya2", "Priya", 14, 4.6, -0.6, "#7c3aed", "#8a5a3a", { hair: "#1f2937" }))
    }
  }
  ensureActors(bakeryDay ? "bakeryday" : "bakery", cast)
  objects = actorObjs()
}

// ---- The Infinite Stand-up ------------------------------------------------

let dreamStaticBase = []
let dreamChairAngle = 0
let dreamTickets = []
let dreamTickets2 = 9

function buildDream() {
  loadGrid(DREAM_ROWS)
  if (dreamCalm) {
    // The room the moment it stops asking: cool, clear, quiet.
    sceneFog = { color: "#1b2436", near: 14, far: 52 }
    sceneBg = "#101724"
  } else {
    // Desaturated and foggy, but never black — the joke has to be visible.
    sceneFog = { color: "#38455f", near: 9, far: 34 - Math.min(dreamLoop * 2, 10) }
    sceneBg = "#1c2536"
  }
  let objs = [floorPlane(22, 14, "#36415a"), ceilingPlane(22, 14, 2.8, "#28324a")]
  objs = objs.concat(wallsFrom(DREAM_ROWS, "#44526e", 2.8))
  objs = objs.concat(skirting("dsk", 22, 14, "#232c40"))
  objs = objs.concat(ceilingBeams("dbm", 22, 14, 2.8, 2, "#232c40"))

  // The whiteboard everyone is standing around, with an actual sprint on it.
  objs.push({ id: "wboard", type: "box", position: { x: 10, y: 1.5, z: 6 }, width: 3.0, height: 1.7, depth: 0.1,
    color: "#eef1f5", emissive: "#eef1f5", emissiveIntensity: dreamCalm ? 0.45 : 0.3 })
  objs.push({ id: "wboard_tray", type: "box", position: { x: 10, y: 0.62, z: 6.04 }, width: 3.0, height: 0.06, depth: 0.16, color: "#8892a6" })
  objs.push({ id: "wboard_leg1", type: "cylinder", position: { x: 8.8, y: 0.31, z: 6 }, radius: 0.04, height: 0.62, color: "#5a6377" })
  objs.push({ id: "wboard_leg2", type: "cylinder", position: { x: 11.2, y: 0.31, z: 6 }, radius: 0.04, height: 0.62, color: "#5a6377" })
  if (!dreamCalm) {
    objs.push({ id: "wb_hdr", type: "box", position: { x: 10, y: 2.14, z: 5.93 }, width: 2.4, height: 0.1, depth: 0.02, color: "#dc2626", emissive: "#dc2626", emissiveIntensity: 0.5 })
    // Sticky notes: three columns that never empty.
    for (let i = 0; i < 9; i++) {
      let cx = 9.05 + (i % 3) * 0.95
      let cy = 1.85 - Math.floor(i / 3) * 0.42
      objs.push({ id: "wb_n" + i, type: "box", position: { x: cx, y: cy, z: 5.93 }, rotation: { x: 0, y: 0, z: (i % 2 === 0 ? 0.05 : -0.06) },
        width: 0.6, height: 0.3, depth: 0.02, color: "#fde68a", emissive: "#facc15", emissiveIntensity: 0.35 })
    }
  }

  // Desks, drained of colour, pushed to the edges by the meeting.
  let dDesks = [[3.4, 11.2], [17.6, 11.2], [3.4, 2.4], [17.6, 2.4]]
  for (let i = 0; i < dDesks.length; i++) {
    objs = objs.concat(deskAt("ddesk" + i, dDesks[i][0], dDesks[i][1], ""))
  }

  if (!dreamCalm) {
    // THE STAND-UP: a ring of people standing around the board. This is the
    // shape the scene was missing — it now reads as a meeting on sight.
    let ring = 3 + Math.min(dreamLoop, 5)
    for (let i = 0; i < ring; i++) {
      let a = (i / ring) * Math.PI * 2 + 0.35
      let sx = 10 + Math.sin(a) * 3.1
      let sz = 6 + Math.cos(a) * 2.9
      // Facing inward, toward the board.
      objs = objs.concat(fig("sil" + i, sx, sz, a + Math.PI, "#151c2b", "#1c2437", { hair: "#111825", pants: "#121826" }))
    }
    // PAX presides over the ceremony.
    objs.push({ id: "dpax", type: "torus", position: { x: 10, y: 2.12, z: 7.3 }, radius: 0.34, tube: 0.11,
      color: "#f8fafc", emissive: "#fb7185", emissiveIntensity: 1.5,
      animate: { rotateY: 0.03, floatAmplitude: 0.1, floatSpeed: 1.1 } })
    objs.push({ id: "dpax_core", type: "sphere", position: { x: 10, y: 2.12, z: 7.3 }, radius: 0.11,
      color: "#fb7185", emissive: "#fecdd3", emissiveIntensity: 1.8, animate: { floatAmplitude: 0.1, floatSpeed: 1.1 } })

    // The backlog, as an object: a pile that grows every time you try to leave.
    let stack = Math.min(Math.floor(dreamTickets2 / 3), 14)
    objs.push(blob("pile", 13.6, 8.6, 0.62, 0.3))
    for (let i = 0; i < stack; i++) {
      objs.push({ id: "pile" + i, type: "box", position: { x: 13.6 + (i % 2) * 0.05, y: 0.05 + i * 0.075, z: 8.6 },
        rotation: { x: 0, y: i * 0.16, z: 0 }, width: 0.86, height: 0.07, depth: 0.62,
        color: "#f8fafc", emissive: "#fbbf24", emissiveIntensity: 0.28 })
    }
    // Loose tickets orbiting the room, capped so the frame stays readable.
    let float = Math.min(dreamTickets2, 18)
    for (let i = 0; i < float; i++) {
      let a = (i / float) * Math.PI * 2
      objs.push({ id: "ticket" + i, type: "box",
        position: { x: 10 + Math.sin(a) * (5.2 + (i % 3) * 1.1), y: 1.25 + (i % 4) * 0.42, z: 6 + Math.cos(a) * (3.4 + (i % 2) * 0.9) },
        rotation: { x: 0, y: a, z: 0 }, width: 0.42, height: 0.3, depth: 0.02,
        color: "#fef3c7", emissive: "#f59e0b", emissiveIntensity: 0.95,
        animate: { floatAmplitude: 0.09, floatSpeed: 0.8 + (i % 3) * 0.35 } })
    }
  }

  // The door you keep walking through. Its sign counts your attempts.
  objs = objs.concat(doorwayAt("ddoor", 20, 10, Math.PI / 2, dreamCalm ? "#cbd5e1" : "#2b3550",
    dreamCalm ? "#e8eef8" : "#3d4c6b", -1.5))
  objs.push({ id: "hs_dreamdoor", type: "box", position: { x: 20, y: 1.05, z: 10 }, width: 0.1, height: 2.05, depth: 1.6,
    color: dreamCalm ? "#f8fafc" : "#1b2436",
    emissive: dreamCalm ? "#f8fafc" : "#7dd3fc", emissiveIntensity: dreamCalm ? 1.7 : 0.6 })
  objs = objs.concat(neonExit("ddoor_sign", 19.83, 2.57, 10, -Math.PI / 2, dreamCalm ? "#a5f3fc" : "#f87171", 0.62))
  if (dreamCalm) {
    objs.push({ id: "doorshaft", type: "plane", position: { x: 18.4, y: 1.2, z: 10 },
      rotation: { x: 0, y: Math.PI / 2, z: 0.12 }, width: 3.6, height: 2.6, color: "#f8fafc", opacity: 0.13 })
    objs.push({ id: "doorpool", type: "plane", position: { x: 17.6, y: 0.014, z: 10 },
      rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 5, height: 3.4, color: "#f8fafc", opacity: 0.09 })
  }

  dreamStaticBase = objs
  objects = dreamStaticBase.concat(dreamChairObjs(dreamCalm))
  lights = dreamCalm ? [
    { id: "amb", type: "ambient", color: "#dbe4f5", intensity: 1.7 },
    { id: "hemi", type: "hemisphere", color: "#eaf0fb", groundColor: "#5b6478", intensity: 1.2 },
    { id: "door", type: "point", color: "#f8fafc", intensity: 3.0, position: { x: 18.4, y: 1.7, z: 10 } },
    { id: "board", type: "point", color: "#e5e7eb", intensity: 1.2, position: { x: 10, y: 2.2, z: 6.6 } }
  ] : [
    { id: "amb", type: "ambient", color: "#a7b6d4", intensity: 1.85 },
    { id: "hemi", type: "hemisphere", color: "#c2cee6", groundColor: "#5b6884", intensity: 1.35 },
    { id: "board", type: "point", color: "#eef1f5", intensity: 2.2, position: { x: 10, y: 2.0, z: 6.9 } },
    { id: "red", type: "point", color: "#fb7185", intensity: 1.5, position: { x: 10, y: 2.5, z: 6 } },
    { id: "doorL", type: "point", color: "#7dd3fc", intensity: 1.6, position: { x: 19, y: 1.6, z: 10 } }
  ]
  hotspots = [
    { id: "hs_dreamdoor", x: 20, z: 10, r: 2.3, label: dreamCalm ? "The UNKNOWN door" : (dreamLoop > 0 ? "The exit (again)" : "The exit") },
    { id: "wboard", x: 10, z: 6, r: 2.6, label: "The sprint board", minor: true }
  ]
  if (!dreamCalm) { hotspots.push({ id: "pile0", x: 13.6, z: 8.6, r: 2.0, label: "The backlog", minor: true }) }
  dreamStaticBase = dreamStaticBase.concat(hotspotMarkers(dreamCalm ? "#f8fafc" : "#7dd3fc"))
  sceneStatic = dreamStaticBase
  blockers = []
  ensureActors("dream", [])
  objects = dreamStaticBase.concat(dreamChairObjs(dreamCalm))
}

function dreamChairObjs(frozen) {
  let out = []
  for (let i = 0; i < 5; i++) {
    let a = dreamChairAngle + (i / 5) * Math.PI * 2
    let cx = 10 + Math.sin(a) * 4.7
    let cz = 6 + Math.cos(a) * 4.1
    out = out.concat(chairAt("dchair" + i, cx, cz, a + Math.PI, frozen ? "#3a4356" : "#232b3b"))
  }
  return out
}

function dreamTick() {
  if (dreamCalm) { return }
  dreamChairAngle = dreamChairAngle + 0.01 + dreamLoop * 0.008
  objects = dreamStaticBase.concat(dreamChairObjs(false))
}
