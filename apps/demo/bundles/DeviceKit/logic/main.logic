let currentPage = "api"
let apiUrl = "https://jsonplaceholder.typicode.com/todos/1"
let apiResult = ""
let apiLoading = false
let qrValue = "https://softn.dev"
let scannedCode = ""
let scanning = false
let capturedPhoto = ""
let selectedFiles = []
let fileContent = ""
let fileIsImage = false
let filePreviewUrl = ""

let apiStatus = ""
let apiOk = true
let apiError = ""

function fetchApi() {
  apiLoading = true
  apiError = ""
  softn.net.fetch(apiUrl, { method: "GET" }, function(response) {
    apiLoading = false
    if (!response || response.error) {
      apiResult = ""
      apiError = response && response.error ? response.error : "The request failed."
      return
    }
    apiOk = response.ok !== false
    apiStatus = response.status ? String(response.status) : (apiOk ? "200" : "error")
    apiResult = response.body
  })
}

function setPage(page) {
  currentPage = page
  // The scanner is only mounted while scanning, so leaving the tab releases
  // the camera rather than leaving it open behind another page.
  if (page !== "qr") scanning = false
}

// ── QR scanning ──
// <QRReader> opens the camera the moment it mounts, so it is mounted only
// between Start and Stop instead of on every visit to the tab.

function startScanning() {
  scanning = true
}

function stopScanning() {
  scanning = false
}

function handleScan(data) {
  scannedCode = data
  // One read is the answer; drop the camera instead of keeping it on.
  scanning = false
}

// ── Camera ──

function handleCapture(data) {
  capturedPhoto = data.dataUrl
}

function clearPhoto() {
  capturedPhoto = ""
}

// ── Files ──

function handleFileSelect(files) {
  selectedFiles = files
  fileContent = ""
  fileIsImage = false
  filePreviewUrl = ""
  if (files.length > 0) {
    let type = files[0].type
    if (type.indexOf("image/") === 0) {
      fileIsImage = true
      softn.files.readBase64(files[0].ref, function(dataUrl) {
        filePreviewUrl = dataUrl
      })
    } else {
      softn.files.readText(files[0].ref, function(content) {
        fileContent = content
      })
    }
  }
}

function formatBytes(n) {
  let size = parseInt(n)
  if (isNaN(size) || size < 0) return "0 B"
  if (size < 1024) return size + " B"
  if (size < 1024 * 1024) return (Math.round(size / 1024 * 10) / 10) + " KB"
  if (size < 1024 * 1024 * 1024) return (Math.round(size / (1024 * 1024) * 10) / 10) + " MB"
  return (Math.round(size / (1024 * 1024 * 1024) * 10) / 10) + " GB"
}

function updateQrValue(val) {
  qrValue = val
}

function updateApiUrl(val) {
  apiUrl = val
}

// ── Icons ──
// The built-in <Icon name> set has no camera, file, or shield, so these hand
// <Icon svg> a stroke icon in the same 24-unit grid the built-ins use.

function iconSvg(name, color) {
  let body = ""
  if (name === "camera") {
    body = '<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>'
  } else if (name === "file") {
    body = '<path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/>'
  } else if (name === "file-text") {
    body = '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>'
  } else if (name === "shield") {
    body = '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>'
  } else if (name === "scan") {
    body = '<path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="7" y1="12" x2="17" y2="12"/>'
  }
  return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="100%" height="100%" fill="none" stroke="' + color + '" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + body + '</svg>'
}
