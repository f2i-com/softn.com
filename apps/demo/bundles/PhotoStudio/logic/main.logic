    if (e.shiftKey && tool === "line") { let angle = Math.round(Math.atan2(p.y - gst.start.y, p.x - gst.start.x) / (Math.PI / 4)) * Math.PI / 4, dist = Math.hypot(p.x - gst.start.x, p.y - gst.start.y); ex = gst.start.x + Math.cos(angle) * dist; ey = gst.start.y + Math.sin(angle) * dist; }
