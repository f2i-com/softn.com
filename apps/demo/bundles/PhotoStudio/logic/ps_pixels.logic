// ---------------------------------------------------------------------------
// Resampling: dst rows [y0, y1) from src. mode: "nearest" | "bilinear" | "area".
// Works on premultiplied data for correct edges; caller premultiplies/unpremultiplies.
// ---------------------------------------------------------------------------
function psResampleRows(src, sw, sh, dst, dw, dh, y0, y1, mode) {
  let sxScale = sw / dw, syScale = sh / dh;
  if (mode === "nearest") {
    for (let y = y0; y < y1; y++) {
      let sy = Math.min(sh - 1, Math.floor((y + 0.5) * syScale));
      let srow = sy * sw, drow = y * dw;
      for (let x = 0; x < dw; x++) {
        let sx = Math.min(sw - 1, Math.floor((x + 0.5) * sxScale));
        let si = (srow + sx) * 4, di = (drow + x) * 4;
        dst[di] = src[si]; dst[di + 1] = src[si + 1]; dst[di + 2] = src[si + 2]; dst[di + 3] = src[si + 3];
      }
    }
    return;
  }
  if (mode === "bilinear" || (sxScale <= 1 && syScale <= 1)) {
    for (let y = y0; y < y1; y++) {
      let fy = (y + 0.5) * syScale - 0.5; if (fy < 0) fy = 0;
      let iy = Math.floor(fy); if (iy > sh - 1) iy = sh - 1;
      let iy1 = iy + 1 < sh ? iy + 1 : iy; let wy = fy - iy;
      let r0 = iy * sw, r1 = iy1 * sw, drow = y * dw;
      for (let x = 0; x < dw; x++) {
        let fx = (x + 0.5) * sxScale - 0.5; if (fx < 0) fx = 0;
        let ix = Math.floor(fx); if (ix > sw - 1) ix = sw - 1;
        let ix1 = ix + 1 < sw ? ix + 1 : ix; let wx = fx - ix;
        let a = (r0 + ix) * 4, b = (r0 + ix1) * 4, c = (r1 + ix) * 4, d = (r1 + ix1) * 4;
        let w00 = (1 - wx) * (1 - wy), w01 = wx * (1 - wy), w10 = (1 - wx) * wy, w11 = wx * wy;
        let di = (drow + x) * 4;
        dst[di] = (src[a] * w00 + src[b] * w01 + src[c] * w10 + src[d] * w11 + 0.5) | 0;
        dst[di + 1] = (src[a + 1] * w00 + src[b + 1] * w01 + src[c + 1] * w10 + src[d + 1] * w11 + 0.5) | 0;
        dst[di + 2] = (src[a + 2] * w00 + src[b + 2] * w01 + src[c + 2] * w10 + src[d + 2] * w11 + 0.5) | 0;
        dst[di + 3] = (src[a + 3] * w00 + src[b + 3] * w01 + src[c + 3] * w10 + src[d + 3] * w11 + 0.5) | 0;
      }
    }
