function psIsJpeg(b) { return b.length > 4 && b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff; }

// Huffman table: 9-bit fast lookup + canonical slow path (maxcode/valptr).
function psJpegHuffTable(bits, vals) {
