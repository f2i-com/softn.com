// Sim Lives — the life half. builder.logic (composed before this file)
// owns the house: plan, catalogue, static scene, cameras, tools. This file
// owns the people: avatars, needs, a day clock, pathfinding over the plan,
// interactions with the furniture, chatting, and the free will that keeps a
// household busy while you watch.
//
// Time: at 1x, one real second is one game minute, so a day is 24 minutes.
// Needs are 0..100 and drift down per game minute; interactions push them up.

// ---------------------------------------------------------------------------
// State synced to the UI
// ---------------------------------------------------------------------------
let liveCam = "orbit";          // orbit | follow | top | creator
let liveRoof = false;
let gameSpeed = 1;
let livePaused = false;
let clockText = "Day 1 · 08:00";
let skyName = "day";
let simCards = [];
let activeCard = null;
let menu = null;                // { title, options: [{ id, label }] } while a click menu is open
let creatorOpen = false;
let draft = null;               // the avatar being designed
let liveHint = "";
let householdSize = 0;
let liveStatus = "";

// ---------------------------------------------------------------------------
// VM-owned state
// ---------------------------------------------------------------------------
let sims = [];
let activeSimId = 0;
let nextSimId = 1;
let clockMinutes = 8 * 60;
let dayNumber = 1;
let navCells = null;            // 1 = blocked
let navDirty = true;
let menuTarget = null;          // { kind: "item"|"sim"|"ground", id, x, z }
let liveTick = 0;
let previewSpin = 0;
let doorAngles = {};            // opening id -> current swing angle
let liveHiddenItems = {};       // item id -> 1 while drawn by the live layer instead of the static scene
let orbitSet = false;

