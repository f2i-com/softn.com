let psMenus = {
  File: [["New document...", "new", ""], ["Open image / PSD / project...", "open", ""], ["Place image as layer...", "place", ""], ["-"], ["Save layered PSD...", "psd", ""], ["Save editable .sphoto project", "project", ""], ["Export image...", "export", ""], ["-"], ["Welcome canvas", "demo", ""]],
  Edit: [["Undo", "undo", "Ctrl+Z"], ["Redo", "redo", "Ctrl+Y"], ["-"], ["Clear selected pixels", "clear", "Delete"], ["Duplicate active layer", "Duplicate layer", ""], ["Transform layer...", "transform", ""], ["Flip layer horizontally", "flip-x", ""], ["Flip layer vertically", "flip-y", ""]],
  Image: [["Image size / resample...", "resize", ""], ["Canvas size...", "canvas-size", ""], ["Crop to selection", "crop-selection", ""], ["-"], ["Brightness...", "filter:brightness", ""], ["Contrast...", "filter:contrast", ""], ["Exposure...", "filter:exposure", ""], ["Hue...", "filter:hue", ""], ["Saturation...", "filter:saturation", ""], ["Gamma...", "filter:gamma", ""], ["Grayscale", "filter:grayscale", ""], ["Invert", "filter:invert", ""]],
  Layer: [["New layer", "New layer", ""], ["Duplicate layer", "Duplicate layer", ""], ["Rename layer...", "rename", ""], ["Delete layer", "Delete layer", ""], ["-"], ["Raise layer", "Raise layer", ""], ["Lower layer", "Lower layer", ""], ["Merge down", "Merge down", ""], ["Flatten visible image", "Flatten", ""], ["-"], ["Add / replace mask from selection", "Add mask", ""], ["Edit mask / image", "edit-mask", ""], ["Enable / disable mask", "Toggle mask", ""], ["Apply mask permanently", "Apply mask", ""], ["Delete mask", "Delete mask", ""], ["Edit text layer...", "edit-text", ""]],
  Select: [["Select all", "select-all", "Ctrl+A"], ["Deselect", "deselect", "Esc"], ["Invert selection", "invert-selection", "Ctrl+Shift+I"], ["Feather selection...", "feather", ""]],
  Filter: [["Gaussian blur...", "filter:blur", ""], ["Sharpen...", "filter:sharpen", ""], ["Posterize...", "filter:posterize", ""], ["Threshold...", "filter:threshold", ""], ["Sepia", "filter:sepia", ""]],
  View: [["Fit to workspace", "fit", "Ctrl+0"], ["Actual pixels / 100%", "actual", "Ctrl+1"], ["Zoom in", "zoom-in", "+"], ["Zoom out", "zoom-out", "-"], ["Show / hide rulers", "rulers", ""], ["Show / hide side panel", "toggle-sidebar", ""]],
  Help: [["Tools & shortcuts", "help", ""], ["Compatibility & limits", "compatibility", ""], ["About Photo Studio", "about", ""]],
};
let psFilterDefaults = { brightness: [0, -100, 100, 1], contrast: [0, -100, 100, 1], exposure: [0, -4, 4, 0.1], hue: [0, -180, 180, 1], saturation: [0, -100, 100, 1], gamma: [1, 0.1, 5, 0.1], blur: [3, 0.1, 40, 0.1], sharpen: [1, 0.1, 5, 0.1], posterize: [6, 2, 32, 1], threshold: [128, 0, 255, 1] };
let psFilterKind = "";
let psGesture = null;
let psPolygon = [];
let psSpaceHeld = false;
let psViewRect = null;          // { left, top, width, height } of the viewport, from pointer events
let psZoom = 1;                 // effective zoom in "zoom" mode
let psPanX = 0, psPanY = 0;
let psPendingAction = null;
let psPendingPsd = null;
let psTextPoint = null;
let psEditingText = false;
let psNoticeToken = 0;
let psLastPointer = null;
let psPlacePending = false;
// Older runtimes hand element handlers null instead of the event; window listeners
// then supply the pointer, recognised by the hit overlay's <article> tag.
let psElementEvents = false;
let psWinDown = false;

// ---------------------------------------------------------------------------
// Startup
// ---------------------------------------------------------------------------
function _init() {
  PS_HOOK_ERROR = uiError;
  PS_HOOK_AFTER_STEP = uiAfterStep;
  PS_LISTENER = uiOnDocument;
  toolRows = [];
  for (let i = 0; i < psTools.length; i++) {
    let t = psTools[i];
    let caption = i === 0 ? "SELECT" : i === 8 ? "RETOUCH" : i === 18 ? "CREATE" : i === 24 ? "VIEW" : "";
    toolRows.push({ id: t[0], label: t[1], key: t[2], title: t[1] + " (" + t[2] + ")", caption: caption, svg: psIconSvg(t[0]), active: t[0] === tool });
  }
  helpRows = [];
  for (let i = 0; i < psTools.length; i++) helpRows.push({ key: psTools[i][2], label: psTools[i][1] });
  blendOptions = [];
  for (let i = 0; i < PS_BLEND_MODES.length; i++) { let m = PS_BLEND_MODES[i]; blendOptions.push({ value: m, label: psTitleCase(m) }); }
  fontOptions = [];
  for (let i = 0; i < PS_FONT_FACES.length; i++) fontOptions.push({ value: PS_FONT_FACES[i][0], label: PS_FONT_FACES[i][1] });
  anchorOptions = [];
  let anchors = ["center", "top-left", "top", "top-right", "left", "right", "bottom-left", "bottom", "bottom-right"];
  for (let i = 0; i < anchors.length; i++) anchorOptions.push({ value: anchors[i], label: anchors[i] });
  // Optional host features: an older runtime may lack some of these, and a
  // missing one must never stop the editor from starting.
  try {
    window.addEventListener("keydown", onKeyDown);
    window.addEventListener("keyup", onKeyUp);
    window.addEventListener("blur", onWindowBlur);
    window.addEventListener("wheel", onWheel);
    window.addEventListener("resize", onWindowResize);
    window.addEventListener("pointerdown", winPointerDown);
    window.addEventListener("pointermove", winPointerMove);
    window.addEventListener("pointerup", winPointerUp);
    window.addEventListener("pointercancel", winPointerCancel);
  } catch (e) { console.log("PhotoStudio: window listeners unavailable: " + e.message); }
  try {
    if (typeof softn !== "undefined" && softn.input && typeof softn.input.captureKeys === "function") softn.input.captureKeys(["[", "]", "Delete", "Backspace", " ", "+", "-", "=", "Escape", "Enter"], function () {});
  } catch (e) { console.log("PhotoStudio: key capture unavailable: " + e.message); }
  uiSetTool("brush");
  buildDemoDocument();
}
function psCanPickFiles() { return typeof softn !== "undefined" && softn.files && typeof softn.files.pickFile === "function"; }
function psIconSvg(id) {
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (psIconPaths[id] || psIconPaths.brush) + '</svg>';
}
function psTitleCase(s) { let parts = String(s).split("-"); for (let i = 0; i < parts.length; i++) parts[i] = parts[i].charAt(0).toUpperCase() + parts[i].slice(1); return parts.join(" "); }

// ---------------------------------------------------------------------------
// Notices, errors, guards
// ---------------------------------------------------------------------------
function uiNotify(text, isError) { noticeText = String(text); noticeError = !!isError; psNoticeToken++; }
function dismissNotice() { noticeText = ""; }
function uiError(error) { uiNotify(error && error.message ? error.message : String(error), true); uiOnDocument("change"); }
function uiGuard(fn) { try { fn(); } catch (error) { uiError(error); } }
function uiAfterStep() { busyText = jobActive ? jobLabel + "... " + jobPercent + "%" : ""; if (!jobActive) { psRefreshPanels(); } }
function uiBusy() { return jobActive; }

// ---------------------------------------------------------------------------
// Document listener and panels
// ---------------------------------------------------------------------------
function uiOnDocument(kind) {
  let s = psSummary();
  docName = s.name; docW = s.width; docH = s.height; layerCount = s.layerCount; docDirty = s.dirty; canUndo = s.canUndo; canRedo = s.canRedo;
  layersText = layerCount + (layerCount === 1 ? " layer" : " layers");
  docTitle = docName + (docDirty ? " *" : "") + " - " + docW + " x " + docH + " px - " + layersText;
  maskMode = PS_MASKMODE;
  if (kind === "document") { psGesture = null; psPolygon = []; cropPending = false; polygonPending = false; setFit(); }
  if (kind !== "status" && kind !== "selection") psRefreshPanels();
  psUpdateStatus();
}
function psRefreshPanels() {
  let rows = [];
  let active = psActive();
  for (let i = PS_LAYERS.length - 1; i >= 0; i--) {
    let l = PS_LAYERS[i];
    let isActive = active && l.id === active.id;
    rows.push({ id: l.id, name: l.name, visible: l.visible, locked: l.locked, active: isActive, kind: l.kind, hasMask: !!l.mask, maskEnabled: l.maskEnabled,
      maskActive: isActive && PS_MASKMODE, imageActive: isActive && !PS_MASKMODE,
      typeLabel: l.kind === "text" ? "Editable type" : l.blend === "normal" ? "Pixel layer" : psTitleCase(l.blend),
      maskLabel: l.mask ? (l.maskEnabled ? "mask" : "mask off") : "",
      thumb: psThumbnail(l.data, PS_W, PS_H, 60, 44, 4), maskThumb: l.mask ? psThumbnail(l.mask, PS_W, PS_H, 30, 30, 1) : null,
      eye: l.visible ? "Hide" : "Show", lockGlyph: l.locked ? "◆" : "◇" });
  }
  layerRows = rows;
  let hist = [];
  for (let i = 0; i < PS_HISTORY.length; i++) hist.push({ index: i, number: (i + 1 < 10 ? "0" : "") + (i + 1), label: PS_HISTORY[i].label, current: i === PS_HIST_INDEX, future: i > PS_HIST_INDEX });
  historyRows = hist;
  if (active) { activeBlend = active.blend; activeOpacity = String(Math.round(active.opacity * 100)); }
  navFrame = PS_COMP ? psThumbnail(PS_COMP, PS_W, PS_H, 180, 100, 4) : null;
  warningsText = PS_WARNINGS.join("\n\n");
}
function psUpdateStatus() {
  let entry = null;
  for (let i = 0; i < psTools.length; i++) if (psTools[i][0] === tool) entry = psTools[i];
  if (PS_MASKMODE) statusText = "Editing mask: white reveals, black hides. Click the image thumbnail to return.";
  else if (cropPending) statusText = "Crop ready: press Enter or Apply crop; Escape cancels.";
  else statusText = (entry ? entry[1] : "Ready") + (tool === "clone" ? ": Alt-click to choose a source." : tool === "crop" ? ": drag a rectangle; Enter applies, Esc cancels." : tool === "polygon" ? ": click vertices; double-click or Enter closes the selection." : ". Changes stay on this device.");
}

// ---------------------------------------------------------------------------
// Tools and options
// ---------------------------------------------------------------------------
function setTool(id) { uiSetTool(id); }
function uiSetTool(id) {
  let found = null;
  for (let i = 0; i < psTools.length; i++) if (psTools[i][0] === id) found = psTools[i];
  if (!found) return;
  psEndGesture(true);
  psPolygon = []; polygonPending = false;
  psOverlaySet("gesture", null);
  tool = id; toolName = found[1];
  let rows = toolRows.slice();
  for (let i = 0; i < rows.length; i++) rows[i] = Object.assign({}, rows[i], { active: rows[i].id === id });
  toolRows = rows;
  showBrushOpts = !!PS_BRUSH_TOOLS[id];
  showFloodOpts = id === "wand" || id === "fill";
  showShapeOpts = id === "rectangle" || id === "ellipse" || id === "line";
  showGradientOpts = id === "gradient";
  cursorVisible = false;
  psUpdateStatus();
}
function swapColors() { let t = fgColor; fgColor = bgColor; bgColor = t; }
function defaultColors() { fgColor = "#000000"; bgColor = "#ffffff"; }
function setBrushSize(v) { brushSize = psClamp(Math.round(Number(v) || 1), 1, 512); sizeLabel = String(brushSize); }
function setBrushHardness(v) { brushHardness = psClamp(Math.round(Number(v) || 0), 0, 100); }
function psOptions() {
  return { color: fgColor, background: bgColor, size: brushSize, hardness: brushHardness / 100, opacity: psClamp(Number(toolOpacity) || 100, 1, 100) / 100,
    tolerance: psClamp(Number(wandTolerance) || 0, 0, 255), contiguous: !!wandContiguous, filled: !!shapeFilled, lineWidth: psClamp(Number(shapeLineWidth) || 1, 1, 200), radial: !!gradientRadial, pressure: false };
}

// ---------------------------------------------------------------------------
// View: fit / zoom / pan. Geometry comes from the viewport rectangle the
// pointer events report; PixelCanvas centres the bitmap the same way.
// ---------------------------------------------------------------------------
function psViewSize() { return psViewRect ? { w: psViewRect.width, h: psViewRect.height } : { w: 1000, h: 700 }; }
function psGeometry() {
  let v = psViewSize();
  if (viewMode === "fit") {
    let f = Math.min(v.w / Math.max(1, docW), v.h / Math.max(1, docH));
    let cw = Math.round(docW * f), ch = Math.round(docH * f);
    return { f: f, x: (v.w - cw) / 2, y: (v.h - ch) / 2 };
  }
  return { f: psZoom, x: (v.w - docW * psZoom) / 2 + psPanX, y: (v.h - docH * psZoom) / 2 + psPanY };
}
function psApplyView() {
  if (viewMode === "fit") { artWidth = "100%"; artHeight = "100%"; artTransform = "none"; }
  else { artWidth = Math.max(1, Math.round(docW * psZoom)) + "px"; artHeight = Math.max(1, Math.round(docH * psZoom)) + "px"; artTransform = "translate(" + Math.round(psPanX) + "px," + Math.round(psPanY) + "px)"; }
  let g = psGeometry();
  zoomText = Math.round(g.f * 100) + "%";
  smoothZoom = g.f < 3;
  psUpdateRulers(g);
}
function setFit() { viewMode = "fit"; psPanX = 0; psPanY = 0; psApplyView(); }
function psZoomTo(z, sx, sy) {
  z = psClamp(z, 0.02, 32);
  let g = psGeometry(), v = psViewSize();
  if (sx === undefined) { sx = v.w / 2; sy = v.h / 2; }
  let dx = (sx - g.x) / g.f, dy = (sy - g.y) / g.f;
  viewMode = "zoom"; psZoom = z;
  psPanX = sx - dx * z - (v.w - docW * z) / 2;
  psPanY = sy - dy * z - (v.h - docH * z) / 2;
  psApplyView();
}
function zoomIn() { psZoomTo(psGeometry().f * 1.25); }
function zoomOut() { psZoomTo(psGeometry().f * 0.8); }
function zoomActual() { psZoomTo(1); }
function zoomFit() { setFit(); }
function toggleRulers() { rulersOn = !rulersOn; psApplyView(); }
function toggleSidebar() { sidebarOpen = !sidebarOpen; }
function psUpdateRulers(g) {
  if (!rulersOn) { rulerX = []; rulerY = []; return; }
  let v = psViewSize();
  let step = 5000;
  let candidates = [10, 20, 50, 100, 200, 500, 1000, 2000, 5000];
  for (let i = 0; i < candidates.length; i++) { if (candidates[i] * g.f >= 60) { step = candidates[i]; break; } }
  let xs = [], ys = [];
  let first = Math.floor(-g.x / g.f / step) * step;
  for (let n = first; n * g.f + g.x < v.w && xs.length < 60; n += step) { let px = n * g.f + g.x; if (px >= 0) xs.push({ label: String(n), left: Math.round(px) + "px" }); }
  first = Math.floor(-g.y / g.f / step) * step;
  for (let n = first; n * g.f + g.y < v.h && ys.length < 60; n += step) { let py = n * g.f + g.y; if (py >= 0) ys.push({ label: String(n), top: Math.round(py) + "px" }); }
  rulerX = xs; rulerY = ys;
}

// ---------------------------------------------------------------------------
// Pointer input on the viewport overlay
// ---------------------------------------------------------------------------
function psPoint(e) {
  if (e && typeof e.targetWidth === "number" && e.targetWidth > 0) psViewRect = { left: e.targetLeft, top: e.targetTop, width: e.targetWidth, height: e.targetHeight };
  let r = psViewRect || { left: 0, top: 0, width: 1000, height: 700 };
  let g = psGeometry();
  let sx = e.clientX - r.left, sy = e.clientY - r.top;
  return { x: (sx - g.x) / g.f, y: (sy - g.y) / g.f, sx: sx, sy: sy };
}
function psModeFromEvent(e) { return e.shiftKey ? "add" : e.altKey ? "subtract" : "replace"; }
function onPointerDown(e) { if (e) psElementEvents = true; psPointerDown(e); }
function onPointerMove(e) { if (e) psElementEvents = true; psPointerMove(e); }
function onPointerUp(e) { psPointerUp(e); }
function psPointerDown(e) {
  if (!e || dialog || uiBusy()) return;
  if (typeof e.button === "number" && e.button > 1) return;
  openMenu = "";
  if (psGesture && psGesture.kind === "crop" && cropPending) return;
  let p = psPoint(e);
  psLastPointer = p;
  uiGuard(function () {
    let o = psOptions();
    if (psSpaceHeld || e.button === 1 || tool === "hand") { if (viewMode === "fit") { let g = psGeometry(); viewMode = "zoom"; psZoom = g.f; psPanX = 0; psPanY = 0; psApplyView(); } psGesture = { kind: "pan", start: p, panX: psPanX, panY: psPanY }; return; }
