// Pocket — the cartridge and its mapper.
//
// A transliteration of emulator/src/emulator/core/cartridge.ts. The reference
// is four classes behind an interface; this is one module behind a mapper id in
// GB_CART[GB_K_MBC], because zipp has no cheap virtual dispatch and the ROM read
// is the hottest path in the whole emulator — roughly one per instruction byte,
// four million times a second.
//
// THE OFFSET TRICK
//
// The reference recomputes the effective bank on every read:
//
//     const bank = this.romBank & this.romBankMask
//     return this.rom[bank * 0x4000 + (addr - 0x4000)]
//
// which is a field read, a mask, a multiply and an add, plus — in MBC1 — a
// branch on the mode flag and the bank-0 fixup, every single fetch. None of that
// can change except when the cart writes a bank register, which happens perhaps
// a few thousand times a frame against a few hundred thousand reads. So the
// three window offsets are precomputed into GB_CART by gbCart_remap() and a read
// becomes one add and one typed-array index with no mapper branch at all:
//
//     0000-3FFF   GB_ROM[GB_CART[GB_K_ROMOFF_LO] + addr]
//     4000-7FFF   GB_ROM[GB_CART[GB_K_ROMOFF_HI] + (addr - 0x4000)]
//     A000-BFFF   GB_ERAM[(GB_CART[GB_K_RAMOFF] + (addr - 0xA000)) & rammask]
//
// Every path that changes a bank register ends in gbCart_remap(). If you add a
// register and forget the remap, the picture will keep drawing from the old bank
// and it will look like a PPU bug. It is not a PPU bug.
//
// NO BOUNDS TEST ON THE ROM READ
//
// The reference writes `this.rom[offset] ?? 0xff` because a ROM whose length is
// not a whole number of 16KB banks can be indexed past its end. Rather than pay
// for that test on every read, gbCart_load normalises the image once: the bank
// count is rounded up to a power of two and the image is padded with 0xFF to
// match. After that the mask guarantees every offset is in range, forever.
//
// MAPPERS
//
// CONTRACT.md §3.1 names GB_MBC_NONE (00 08 09), GB_MBC_1 (01-03), GB_MBC_3
// (0F-13) and GB_MBC_5 (19-1E), with anything else falling back to MBC5 and a
// note in gbError. This file adds one mapper the contract does not name: MBC2,
// cartridge types 05 and 06, as gbCart_MBC_2 = 2 — the one value the GB_MBC_*
// numbering leaves free. It is a genuine addition rather than a deviation: an
// MBC2 cart under the MBC5 fallback banks correctly by accident (its bank
// register lives at 2100, which MBC5 reads as a plain bank write) but has no RAM
// at all, because MBC2's 512 x 4 bits are built into the mapper and the header
// reports a RAM size of zero. Every MBC2 game would boot and then fail to save.
// Nothing outside this file can tell the difference: gb_mmu only ever calls
// gbCart_romRead / gbCart_ramRead, and the mapper name comes from
// gbCart_mapperName().
//
// OUT OF SCOPE, per CONTRACT.md §3.1 and §9: the reference's save-event
// heuristic (consumeSaveEvent, ramSnapshot, per-enable write counting). What
// replaces it is gbCart_ramDirty() / gbCart_clearRamDirty(), and main.logic
// persisting on a timer.

// ---------------------------------------------------------------------------
// The one mapper identity gb_state.logic does not declare. Everything else this
// module needs already has a home in GB_CART, GB_RTC and GB_RTC_EPOCH.
// ---------------------------------------------------------------------------

let gbCart_MBC_2 = 2

// Module-private flags. A typed array marshals to an opaque slot and is skipped
// by the state sync entirely, so this costs nothing per host call — unlike a
// plain `let`, which would be read and deep-compared every time.
//
//   [0]  external RAM has been written since the last gbCart_clearRamDirty()
//   [1]  1 once gbCart_load() has succeeded at least once
let gbCart_FLAGS = new Uint8Array(4)

// GB_CART[GB_K_MODE] is the 6000-7FFF register, and it means different things to
// different mappers: for MBC1 it is the banking mode (0 = ROM, 1 = RAM), for
// MBC3 it is the RTC latch-pending flag. They are the same register on the same
// pins; no cart is ever both.
//
// GB_RTC_EPOCH[0] is the millisecond timestamp at which the clock read zero —
// day 0, 00:00:00 — so the live time is simply (now - epoch). Writing an RTC
// register rebases it, which is what makes a written clock stick.
// GB_RTC_EPOCH[1] is the timestamp at which the clock was halted, or 0 when it
// is running.

// ---------------------------------------------------------------------------
// Header
// ---------------------------------------------------------------------------

// 0149. Note 0x05 is 64KB and 0x04 is 128KB — the header is not in size order,
// and getting that pair the wrong way round mis-sizes exactly the MBC5 saves
// that are hardest to notice.
function gbCart_ramSizeFromHeader(code) {
  if (code === 0x00) { return 0 }
  if (code === 0x01) { return 2048 }
  if (code === 0x02) { return 8192 }
  if (code === 0x03) { return 32768 }
  if (code === 0x04) { return 131072 }
  if (code === 0x05) { return 65536 }
  return 0
}

// 0134-0143, stopping at the first NUL and dropping anything unprintable. On a
// CGB cart the last byte of that range is the CGB flag (0x80 or 0xC0) and the
// four before it may be a manufacturer code; the printable filter eats them.
function gbCart_title() {
  if (GB_ROM === null) { return "" }
  let s = ""
  for (let i = 0x134; i <= 0x143; i = i + 1) {
    let c = GB_ROM[i]
    if (c === 0 || c === undefined) { break }
    if (c >= 0x20 && c < 0x7f) { s = s + String.fromCharCode(c) }
  }
  return s.trim()
}

function gbCart_mapperName() {
  if (gbCart_FLAGS[1] === 0) { return "—" }
  let m = GB_CART[GB_K_MBC]
  if (m === GB_MBC_NONE) { return "ROM" }
  if (m === GB_MBC_1) { return "MBC1" }
  if (m === gbCart_MBC_2) { return "MBC2" }
  if (m === GB_MBC_3) { return "MBC3" }
  return "MBC5"
}

function gbCart_hasBattery() {
  return GB_CART[GB_K_BATTERY] === 1
}

function gbCart_hasRtc() {
  return GB_CART[GB_K_HASRTC] === 1
}

function gbCart_romLoaded() {
  return gbCart_FLAGS[1] === 1
}

// ---------------------------------------------------------------------------
// Loading
// ---------------------------------------------------------------------------

// Sets GB_CART[GB_K_MBC], GB_K_BATTERY, GB_K_HASRTC and GB_K_RAMSIZE from the
// cartridge type byte at 0147 and the RAM size byte at 0149. Returns "" when the
// type is known and a note when it is not — the caller puts that note in
// gbError, because a wrong mapper that boots beats a refusal that does not.
function gbCart_classify(cartType, headerRam) {
  let note = ""

  GB_CART[GB_K_BATTERY] = 0
  GB_CART[GB_K_HASRTC] = 0
  GB_CART[GB_K_RAMSIZE] = 0

  if (cartType === 0x00) {
    GB_CART[GB_K_MBC] = GB_MBC_NONE
  } else if (cartType === 0x08) {
    GB_CART[GB_K_MBC] = GB_MBC_NONE
    GB_CART[GB_K_RAMSIZE] = headerRam
  } else if (cartType === 0x09) {
    GB_CART[GB_K_MBC] = GB_MBC_NONE
    GB_CART[GB_K_RAMSIZE] = headerRam
    GB_CART[GB_K_BATTERY] = 1
  } else if (cartType === 0x01) {
    GB_CART[GB_K_MBC] = GB_MBC_1
  } else if (cartType === 0x02) {
    GB_CART[GB_K_MBC] = GB_MBC_1
    GB_CART[GB_K_RAMSIZE] = headerRam
  } else if (cartType === 0x03) {
    GB_CART[GB_K_MBC] = GB_MBC_1
    GB_CART[GB_K_RAMSIZE] = headerRam
    GB_CART[GB_K_BATTERY] = 1
  } else if (cartType === 0x05) {
    // MBC2's RAM is 512 nibbles inside the mapper. The header says zero.
    GB_CART[GB_K_MBC] = gbCart_MBC_2
    GB_CART[GB_K_RAMSIZE] = 512
  } else if (cartType === 0x06) {
    GB_CART[GB_K_MBC] = gbCart_MBC_2
    GB_CART[GB_K_RAMSIZE] = 512
    GB_CART[GB_K_BATTERY] = 1
  } else if (cartType === 0x0f) {
    GB_CART[GB_K_MBC] = GB_MBC_3
    GB_CART[GB_K_HASRTC] = 1
    GB_CART[GB_K_BATTERY] = 1
  } else if (cartType === 0x10) {
    GB_CART[GB_K_MBC] = GB_MBC_3
    GB_CART[GB_K_HASRTC] = 1
    GB_CART[GB_K_RAMSIZE] = headerRam
    GB_CART[GB_K_BATTERY] = 1
  } else if (cartType === 0x11) {
    GB_CART[GB_K_MBC] = GB_MBC_3
  } else if (cartType === 0x12) {
    GB_CART[GB_K_MBC] = GB_MBC_3
    GB_CART[GB_K_RAMSIZE] = headerRam
  } else if (cartType === 0x13) {
    GB_CART[GB_K_MBC] = GB_MBC_3
    GB_CART[GB_K_RAMSIZE] = headerRam
    GB_CART[GB_K_BATTERY] = 1
  } else if (cartType === 0x19 || cartType === 0x1c) {
    GB_CART[GB_K_MBC] = GB_MBC_5
  } else if (cartType === 0x1a || cartType === 0x1d) {
    GB_CART[GB_K_MBC] = GB_MBC_5
    GB_CART[GB_K_RAMSIZE] = headerRam
  } else if (cartType === 0x1b || cartType === 0x1e) {
    GB_CART[GB_K_MBC] = GB_MBC_5
    GB_CART[GB_K_RAMSIZE] = headerRam
    GB_CART[GB_K_BATTERY] = 1
  } else {
    // MMM01, MBC6, MBC7, HuC1, HuC3, Pocket Camera, TAMA5 and the rest. MBC5 is
    // the most permissive of the four — 9-bit bank, 4-bit RAM bank, no mode
    // register — so it is the fallback that gets furthest before it goes wrong.
    GB_CART[GB_K_MBC] = GB_MBC_5
    GB_CART[GB_K_RAMSIZE] = headerRam
    GB_CART[GB_K_BATTERY] = 1
    note = "unsupported cartridge type 0x" + gbCart_hex2(cartType) +
      " — running it as MBC5; banking or saves may misbehave"
  }

  return note
}

// Two hex digits, spelled out rather than via toString(16) — the radix argument
// is not something any shipping .logic leans on, and this runs once per load.
function gbCart_hex2(v) {
  let digits = "0123456789abcdef"
  return digits.charAt((v >>> 4) & 0x0f) + digits.charAt(v & 0x0f)
}

// bytes: Uint8Array holding the whole cartridge image. Parses the header, sizes
// the external RAM, picks the mapper, resets the bank registers and the clock,
// and remaps. Returns true on success; on failure sets gbError and returns
// false, leaving any previously-loaded cart untouched.
function gbCart_load(bytes) {
  gbError = ""

  if (bytes === null || bytes === undefined || bytes.length === undefined) {
    gbError = "no cartridge data"
    return false
  }

  // The header runs to 014F, so anything shorter is not a cartridge ROM. The
  // smallest real cart is 32KB.
  if (bytes.length < 0x150) {
    gbError = "cartridge image is only " + bytes.length + " bytes; not a valid ROM"
    return false
  }

  let src = bytes
  if (src.subarray === undefined) { src = Uint8Array.from(bytes) }

  // Round the bank count up to a power of two so `bank & mask` is a real mask,
  // and pad the image to match so no read can ever fall off the end. A correctly
  // sized ROM — every commercial one — takes neither branch and is used as-is.
  let banks = src.length >>> 14
  if (banks < 2) { banks = 2 }
  let pow = 2
  while (pow < banks) { pow = pow * 2 }
  banks = pow

  let need = banks * 0x4000
  if (src.length === need) {
    GB_ROM = src
  } else {
    let padded = new Uint8Array(need)
    padded.fill(0xff)
    let copy = src.length
    if (copy > need) { copy = need }
    padded.set(src.subarray(0, copy))
    GB_ROM = padded
  }

  GB_CART[GB_K_ROMBANKS] = banks
  GB_CART[GB_K_ROMMASK] = banks - 1

  let note = gbCart_classify(GB_ROM[0x147], gbCart_ramSizeFromHeader(GB_ROM[0x149]))

  // RAM sizes out of the header are powers of two, so the mask is size - 1. A
  // cart with no RAM gets mask 0 and is gated by the RAMSIZE test instead; a
  // negative mask would index backwards out of GB_ERAM.
  if (GB_CART[GB_K_RAMSIZE] > 0) {
    GB_CART[GB_K_RAMMASK] = GB_CART[GB_K_RAMSIZE] - 1
  } else {
    GB_CART[GB_K_RAMMASK] = 0
  }
  GB_ERAM.fill(0)
  gbCart_FLAGS[0] = 0

  // 0143: 0x80 is CGB-enhanced, 0xC0 is CGB-only. Either one puts the machine in
  // colour mode; gb_cpu reads GB_P_GBC for its post-boot register set and gb_ppu
  // for palette handling.
  GB_CART[GB_K_CGBFLAG] = GB_ROM[0x143]
  if ((GB_ROM[0x143] & 0x80) !== 0) {
    GB_CPUF[GB_P_GBC] = 1
  } else {
    GB_CPUF[GB_P_GBC] = 0
  }

  gbCart_resetRtc()
  gbCart_reset()
  gbCart_FLAGS[1] = 1

  if (note !== "") { gbError = note }
  return true
}

// Power-on state of the mapper itself: bank 1 in the upper window, RAM disabled,
// mode 0. Leaves the ROM image, the external RAM and the clock alone, so
// gb_machine can call it from gbMachine_reset() without wiping a save.
function gbCart_reset() {
  GB_CART[GB_K_BANKLO] = 1
  GB_CART[GB_K_BANKHI] = 0
  GB_CART[GB_K_MODE] = 0
  GB_CART[GB_K_RAMBANK] = 0
  GB_RTC[GB_RTC_SEL] = 0

  // A cart with no mapper has no enable register either — its RAM, if it has
  // any, is simply always there.
  if (GB_CART[GB_K_MBC] === GB_MBC_NONE) {
    GB_CART[GB_K_RAMEN] = 1
  } else {
    GB_CART[GB_K_RAMEN] = 0
  }

  gbCart_remap()
}

// ---------------------------------------------------------------------------
// Remap — the only place bank registers become offsets
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// THE PUBLISHED WINDOW BASES
//
// GB_CART[GB_K_ROMOFF_LO] and _HI are canonical and go into save states. These
// three scalars are the same two numbers in the form the bus wants them, and
// exist only because they are read on the hottest path in the bundle:
//
//   gbCart_baseLo   byte offset of the 0000-3FFF window
//   gbCart_baseHi   byte offset of the 4000-7FFF window, ALREADY BIASED by
//                   -0x4000, so a read is GB_ROM[gbCart_baseHi + addr] with no
//                   subtraction
//   gbCart_present  1 once GB_ROM holds a cartridge; the null test, hoisted
//
// A plain scalar reads in ~2ns on the shipping engine against ~22ns for an
// Int32Array element, so gbMmu_read's ROM arm and gbCpu_fetchU8 go from a call
// into this file plus two GB_CART reads to one add and one indexed load.
//
// gbCart_remap is the ONLY writer, and it is already the one place bank
// registers become offsets — every mapper branch below ends in it, and so do
// gbCart_load, gbMachine_reset and gbMachine_loadState.
// ---------------------------------------------------------------------------
let gbCart_baseLo = 0
let gbCart_baseHi = 0
let gbCart_present = 0

function gbCart_remap() {
  gbCart_remapBanks()
  gbCart_baseLo = GB_CART[GB_K_ROMOFF_LO]
  gbCart_baseHi = GB_CART[GB_K_ROMOFF_HI] - 0x4000
  if (GB_ROM === null) { gbCart_present = 0 } else { gbCart_present = 1 }
}

function gbCart_remapBanks() {
  let m = GB_CART[GB_K_MBC]
  let mask = GB_CART[GB_K_ROMMASK]

  if (m === GB_MBC_1) {
    // Low 5 bits select inside a 32-bank group. The bank-0 quirk is on those
    // five bits alone, which is why banks 0x20, 0x40 and 0x60 are unreachable on
    // hardware and read as 0x21, 0x41 and 0x61.
    let hi = GB_CART[GB_K_BANKLO] & 0x1f
    if (hi === 0) { hi = 1 }

    let lo = 0
    if (GB_CART[GB_K_MODE] === 1) {
      // Mode 1 remaps the low window too: the 2-bit register drives A19-A20 for
      // 0000-3FFF as well, which is how the multi-game carts reach their menus.
      lo = ((GB_CART[GB_K_BANKHI] & 0x03) << 5) & mask
    } else {
      hi = hi | ((GB_CART[GB_K_BANKHI] & 0x03) << 5)
    }
    hi = hi & mask

    GB_CART[GB_K_ROMOFF_LO] = lo << 14
    GB_CART[GB_K_ROMOFF_HI] = hi << 14

    // The same two bits are the RAM bank, but only in mode 1.
    if (GB_CART[GB_K_MODE] === 1) {
      GB_CART[GB_K_RAMOFF] = (GB_CART[GB_K_BANKHI] & 0x03) << 13
    } else {
      GB_CART[GB_K_RAMOFF] = 0
    }
    return
  }

  if (m === GB_MBC_3) {
    let b = GB_CART[GB_K_BANKLO] & 0x7f
    if (b === 0) { b = 1 }
    GB_CART[GB_K_ROMOFF_LO] = 0
    GB_CART[GB_K_ROMOFF_HI] = (b & mask) << 14

    // 00-03 is a RAM bank; 08-0C is the clock, which does not live in GB_ERAM at
    // all, so the offset is irrelevant and parked at zero.
    let sel = GB_CART[GB_K_RAMBANK]
    if (sel <= 0x03) {
      GB_CART[GB_K_RAMOFF] = sel << 13
    } else {
      GB_CART[GB_K_RAMOFF] = 0
    }
    return
  }

  if (m === GB_MBC_5) {
    // MBC5 has no bank-0 quirk: bank 0 in the upper window is legal and means
    // bank 0, which is how it addresses 512 banks with a 9-bit register.
    GB_CART[GB_K_ROMOFF_LO] = 0
    GB_CART[GB_K_ROMOFF_HI] = ((GB_CART[GB_K_BANKLO] & 0x1ff) & mask) << 14
    GB_CART[GB_K_RAMOFF] = (GB_CART[GB_K_RAMBANK] & 0x0f) << 13
    return
  }

  if (m === gbCart_MBC_2) {
    let b = GB_CART[GB_K_BANKLO] & 0x0f
    if (b === 0) { b = 1 }
    GB_CART[GB_K_ROMOFF_LO] = 0
    GB_CART[GB_K_ROMOFF_HI] = (b & mask) << 14
    // 512 nibbles, no banking. The mask echoes them across all of A000-BFFF.
    GB_CART[GB_K_RAMOFF] = 0
    return
  }

  // GB_MBC_NONE. The whole 32KB is wired straight through.
  GB_CART[GB_K_ROMOFF_LO] = 0
  GB_CART[GB_K_ROMOFF_HI] = 0x4000
  GB_CART[GB_K_RAMOFF] = 0
}

// The bank actually backing an address, for the debugger. Not used by the bus.
function gbCart_effectiveBank(addr) {
  if (addr < 0x4000) { return GB_CART[GB_K_ROMOFF_LO] >>> 14 }
  return GB_CART[GB_K_ROMOFF_HI] >>> 14
}

// ---------------------------------------------------------------------------
// ROM window — 0000-7FFF
// ---------------------------------------------------------------------------

function gbCart_romRead(addr) {
  if (GB_ROM === null) { return 0xff }
  if (addr < 0x4000) { return GB_ROM[GB_CART[GB_K_ROMOFF_LO] + addr] }
  return GB_ROM[GB_CART[GB_K_ROMOFF_HI] + (addr - 0x4000)]
}

// Writes into the ROM window are mapper control. Every branch that changes a
// bank register ends in gbCart_remap().
function gbCart_romWrite(addr, v) {
  let m = GB_CART[GB_K_MBC]

  if (m === GB_MBC_1) {
    if (addr < 0x2000) {
      // Any value whose low nibble is 0x0A enables RAM; everything else
      // disables it. Carts really do write 0x0A and 0x00, but the nibble test is
      // what the hardware does.
      if ((v & 0x0f) === 0x0a) {
        GB_CART[GB_K_RAMEN] = 1
      } else {
        GB_CART[GB_K_RAMEN] = 0
      }
      return
    }
    if (addr < 0x4000) {
      // The raw five bits are stored; the 0 -> 1 fixup happens in the remap, so
      // a subsequent mode change re-derives it correctly.
      GB_CART[GB_K_BANKLO] = v & 0x1f
      gbCart_remap()
      return
    }
    if (addr < 0x6000) {
      GB_CART[GB_K_BANKHI] = v & 0x03
      gbCart_remap()
      return
    }
    GB_CART[GB_K_MODE] = v & 0x01
    gbCart_remap()
    return
  }

  if (m === GB_MBC_3) {
    if (addr < 0x2000) {
      if ((v & 0x0f) === 0x0a) {
        GB_CART[GB_K_RAMEN] = 1
      } else {
        GB_CART[GB_K_RAMEN] = 0
      }
      return
    }
    if (addr < 0x4000) {
      GB_CART[GB_K_BANKLO] = v & 0x7f
      gbCart_remap()
      return
    }
    if (addr < 0x6000) {
      GB_CART[GB_K_RAMBANK] = v & 0x0f
      // 08-0C map the clock into A000-BFFF instead of the RAM. Anything else
      // puts the RAM back.
      if (GB_CART[GB_K_HASRTC] === 1 && (v & 0x0f) >= 0x08 && (v & 0x0f) <= 0x0c) {
        GB_RTC[GB_RTC_SEL] = v & 0x0f
      } else {
        GB_RTC[GB_RTC_SEL] = 0
      }
      gbCart_remap()
      return
    }
    // 6000-7FFF: the latch. Zero then one copies the running clock into the
    // readable registers; any other sequence rearms from scratch. GB_K_MODE is
    // the pending flag — see the note at the top of the file.
    if (GB_CART[GB_K_MODE] === 0 && v === 0) {
      GB_CART[GB_K_MODE] = 1
    } else if (GB_CART[GB_K_MODE] === 1 && v === 1) {
      gbCart_latchRtc()
    } else {
      GB_CART[GB_K_MODE] = 0
    }
    return
  }

  if (m === GB_MBC_5) {
    if (addr < 0x2000) {
      if ((v & 0x0f) === 0x0a) {
        GB_CART[GB_K_RAMEN] = 1
      } else {
        GB_CART[GB_K_RAMEN] = 0
      }
      return
    }
    if (addr < 0x3000) {
      // Low eight bits of a nine-bit register. The split is the whole point of
      // MBC5: 512 banks is 8MB.
      GB_CART[GB_K_BANKLO] = (GB_CART[GB_K_BANKLO] & 0x100) | (v & 0xff)
      gbCart_remap()
      return
    }
    if (addr < 0x4000) {
      GB_CART[GB_K_BANKLO] = (GB_CART[GB_K_BANKLO] & 0xff) | ((v & 1) << 8)
      gbCart_remap()
      return
    }
    if (addr < 0x6000) {
      // Bit 3 is the rumble motor on rumble carts. It is also a RAM bank bit on
      // carts without one, and no cart has both 64KB of RAM and a motor, so
      // passing it through is safe and rumble is simply not wired to anything.
      GB_CART[GB_K_RAMBANK] = v & 0x0f
      gbCart_remap()
      return
    }
    // 6000-7FFF is ignored on MBC5.
    return
  }

  if (m === gbCart_MBC_2) {
    // One register file, split by address bit 8 rather than by address range:
    // bit clear is the RAM enable, bit set is the ROM bank.
    if (addr < 0x4000) {
      if ((addr & 0x0100) === 0) {
        if ((v & 0x0f) === 0x0a) {
          GB_CART[GB_K_RAMEN] = 1
        } else {
          GB_CART[GB_K_RAMEN] = 0
        }
      } else {
        GB_CART[GB_K_BANKLO] = v & 0x0f
        gbCart_remap()
      }
    }
    return
  }

  // GB_MBC_NONE — no registers to write. Real hardware ignores it too.
}

// ---------------------------------------------------------------------------
// External RAM window — A000-BFFF
// ---------------------------------------------------------------------------

function gbCart_ramRead(addr) {
  if (GB_CART[GB_K_RAMEN] === 0) { return 0xff }

  if (GB_RTC[GB_RTC_SEL] !== 0) { return gbCart_rtcRead() }

  if (GB_CART[GB_K_RAMSIZE] === 0) { return 0xff }

  let v = GB_ERAM[(GB_CART[GB_K_RAMOFF] + (addr - 0xa000)) & GB_CART[GB_K_RAMMASK]]

  // MBC2 stores four bits per cell and the upper four float high.
  if (GB_CART[GB_K_MBC] === gbCart_MBC_2) { return v | 0xf0 }
  return v
}

function gbCart_ramWrite(addr, v) {
  if (GB_CART[GB_K_RAMEN] === 0) { return }

  if (GB_RTC[GB_RTC_SEL] !== 0) {
    gbCart_rtcWrite(v)
    return
  }

  if (GB_CART[GB_K_RAMSIZE] === 0) { return }

  let b = v & 0xff
  if (GB_CART[GB_K_MBC] === gbCart_MBC_2) { b = v & 0x0f }

  let off = (GB_CART[GB_K_RAMOFF] + (addr - 0xa000)) & GB_CART[GB_K_RAMMASK]
  if (GB_ERAM[off] !== b) { gbCart_FLAGS[0] = 1 }
  GB_ERAM[off] = b
}

// Replaces the reference's save-event classifier. main.logic polls this on a
// timer, persists when it is true, and clears it.
function gbCart_ramDirty() {
  return gbCart_FLAGS[0] === 1
}

function gbCart_clearRamDirty() {
  gbCart_FLAGS[0] = 0
}

// ---------------------------------------------------------------------------
// MBC3's clock
//
// The registers hold the LATCHED values the ROM reads. The running clock is not
// counted anywhere — it is derived from GB_RTC_EPOCH[0], the wall-clock moment
// at which the cart's clock read zero. A latch is therefore a subtraction and
// four divisions, and no per-frame work at all.
//
// The reference resets its epoch to Date.now() when the ROM writes a register,
// which loses whatever was written the moment the game latches again — set the
// clock to day 100 and it reads back day 0. Rebasing on the written values
// instead costs nothing and makes a written clock stick, which is what carts
// that let you set the time expect.
// ---------------------------------------------------------------------------

function gbCart_resetRtc() {
  GB_RTC.fill(0)
  GB_RTC_EPOCH[0] = Date.now()
  GB_RTC_EPOCH[1] = 0
}

// Move the epoch so that "now" reads exactly what the registers currently say.
function gbCart_rtcRebase() {
  let days = (GB_RTC[GB_RTC_DL] & 0xff) | ((GB_RTC[GB_RTC_DH] & 0x01) << 8)
  let secs = (GB_RTC[GB_RTC_S] & 0x3f) +
    (GB_RTC[GB_RTC_M] & 0x3f) * 60 +
    (GB_RTC[GB_RTC_H] & 0x1f) * 3600 +
    days * 86400

  let now = Date.now()
  GB_RTC_EPOCH[0] = now - secs * 1000
  if (GB_RTC[GB_RTC_HALT] === 1) {
    GB_RTC_EPOCH[1] = now
  } else {
    GB_RTC_EPOCH[1] = 0
  }
}

function gbCart_latchRtc() {
  GB_CART[GB_K_MODE] = 0

  // A halted clock latches nothing: the registers already hold the frozen time,
  // because halting rebased the epoch onto them.
  if (GB_RTC[GB_RTC_HALT] === 1) { return }

  let elapsed = Math.floor((Date.now() - GB_RTC_EPOCH[0]) / 1000)
  if (elapsed < 0) { elapsed = 0 }

  let days = Math.floor(elapsed / 86400)

  GB_RTC[GB_RTC_S] = elapsed % 60
  GB_RTC[GB_RTC_M] = Math.floor(elapsed / 60) % 60
  GB_RTC[GB_RTC_H] = Math.floor(elapsed / 3600) % 24
  GB_RTC[GB_RTC_DL] = days & 0xff

  // Bit 0 is day bit 8, bit 6 is halt, bit 7 is the day counter carry — sticky
  // once set, and only the ROM can clear it.
  let dh = (days >>> 8) & 0x01
  if (GB_RTC[GB_RTC_CARRY] === 1 || days >= 512) {
    dh = dh | 0x80
    GB_RTC[GB_RTC_CARRY] = 1
  }
  GB_RTC[GB_RTC_DH] = dh
}

function gbCart_rtcRead() {
  let sel = GB_RTC[GB_RTC_SEL]
  if (sel === 0x08) { return GB_RTC[GB_RTC_S] & 0x3f }
  if (sel === 0x09) { return GB_RTC[GB_RTC_M] & 0x3f }
  if (sel === 0x0a) { return GB_RTC[GB_RTC_H] & 0x1f }
  if (sel === 0x0b) { return GB_RTC[GB_RTC_DL] & 0xff }
  if (sel === 0x0c) { return GB_RTC[GB_RTC_DH] & 0xc1 }
  return 0xff
}

function gbCart_rtcWrite(v) {
  let sel = GB_RTC[GB_RTC_SEL]

  if (sel === 0x08) {
    GB_RTC[GB_RTC_S] = v & 0x3f
  } else if (sel === 0x09) {
    GB_RTC[GB_RTC_M] = v & 0x3f
  } else if (sel === 0x0a) {
    GB_RTC[GB_RTC_H] = v & 0x1f
  } else if (sel === 0x0b) {
    GB_RTC[GB_RTC_DL] = v & 0xff
  } else if (sel === 0x0c) {
    GB_RTC[GB_RTC_DH] = v & 0xc1
    GB_RTC[GB_RTC_HALT] = (v >>> 6) & 0x01
    GB_RTC[GB_RTC_CARRY] = (v >>> 7) & 0x01
  } else {
    return
  }

  // Every write rebases, which is what absorbs a halt: the registers hold the
  // frozen time, so clearing the halt bit resumes from there rather than jumping
  // forward by however long the clock was stopped.
  gbCart_rtcRebase()
}

// ---------------------------------------------------------------------------
// Battery-backed RAM
//
// The wire format is the .sav convention: the external RAM verbatim, followed —
// only on a cart that has both a battery and a clock — by the 48-byte RTC
// footer every desktop emulator writes. Twelve little-endian 32-bit fields: the
// running clock, then the latched clock, then the save timestamp as seconds
// since the Unix epoch split low word first.
//
// A save produced without the footer still restores; the tail is optional and
// anything past the RAM is ignored when it is not the right length.
// ---------------------------------------------------------------------------

function gbCart_putU32(buf, off, v) {
  buf[off] = v & 0xff
  buf[off + 1] = (v >>> 8) & 0xff
  buf[off + 2] = (v >>> 16) & 0xff
  buf[off + 3] = (v >>> 24) & 0xff
}

function gbCart_getU32(buf, off) {
  return (buf[off] | (buf[off + 1] << 8) | (buf[off + 2] << 16) | (buf[off + 3] << 24)) >>> 0
}

function gbCart_batteryToBase64() {
  if (GB_CART[GB_K_BATTERY] === 0) { return "" }

  let size = GB_CART[GB_K_RAMSIZE]
  let footer = 0
  if (GB_CART[GB_K_HASRTC] === 1) { footer = 48 }

  if (size === 0 && footer === 0) { return "" }

  // No clock: hand the RAM straight to the encoder. subarray does not copy.
  if (footer === 0) { return GB_ERAM.subarray(0, size).toBase64() }

  let out = new Uint8Array(size + footer)
  if (size > 0) { out.set(GB_ERAM.subarray(0, size)) }

  // Save the RUNNING clock, not the stale latched copy, so the restore picks up
  // where the machine actually is. A halted clock is already frozen onto its
  // registers, so the two are the same thing.
  let s = GB_RTC[GB_RTC_S] & 0x3f
  let m = GB_RTC[GB_RTC_M] & 0x3f
  let h = GB_RTC[GB_RTC_H] & 0x1f
  let dl = GB_RTC[GB_RTC_DL] & 0xff
  let dh = GB_RTC[GB_RTC_DH] & 0xc1

  if (GB_RTC[GB_RTC_HALT] === 0) {
    let elapsed = Math.floor((Date.now() - GB_RTC_EPOCH[0]) / 1000)
    if (elapsed < 0) { elapsed = 0 }
    let days = Math.floor(elapsed / 86400)
    s = elapsed % 60
    m = Math.floor(elapsed / 60) % 60
    h = Math.floor(elapsed / 3600) % 24
    dl = days & 0xff
    dh = (days >>> 8) & 0x01
    if (GB_RTC[GB_RTC_CARRY] === 1 || days >= 512) { dh = dh | 0x80 }
  }

  let base = size
  gbCart_putU32(out, base, s)
  gbCart_putU32(out, base + 4, m)
  gbCart_putU32(out, base + 8, h)
  gbCart_putU32(out, base + 12, dl)
  gbCart_putU32(out, base + 16, dh)
  gbCart_putU32(out, base + 20, GB_RTC[GB_RTC_S] & 0x3f)
  gbCart_putU32(out, base + 24, GB_RTC[GB_RTC_M] & 0x3f)
  gbCart_putU32(out, base + 28, GB_RTC[GB_RTC_H] & 0x1f)
  gbCart_putU32(out, base + 32, GB_RTC[GB_RTC_DL] & 0xff)
  gbCart_putU32(out, base + 36, GB_RTC[GB_RTC_DH] & 0xc1)

  let stamp = Math.floor(Date.now() / 1000)
  gbCart_putU32(out, base + 40, stamp % 4294967296)
  gbCart_putU32(out, base + 44, Math.floor(stamp / 4294967296))

  return out.toBase64()
}

function gbCart_batteryFromBase64(s) {
  if (s === null || s === undefined || s === "") { return false }
  if (GB_CART[GB_K_RAMSIZE] === 0 && GB_CART[GB_K_HASRTC] === 0) { return false }

  let data = null
  try {
    data = gbMachine_decodeBase64(s)
  } catch (e) {
    gbError = "Could not decode the battery save: " + e
    return false
  }

  let size = GB_CART[GB_K_RAMSIZE]
  if (size > 0) {
    let copy = data.length
    if (copy > size) { copy = size }
    // A short save is not an error — a cart whose header grew, or a save taken
    // before the RAM was fully written. Whatever is there lands at the front.
    GB_ERAM.fill(0, 0, size)
    GB_ERAM.set(data.subarray(0, copy))
  }
  gbCart_FLAGS[0] = 0

  if (GB_CART[GB_K_HASRTC] === 1 && data.length >= size + 48) {
    let base = size
    GB_RTC[GB_RTC_S] = gbCart_getU32(data, base) & 0x3f
    GB_RTC[GB_RTC_M] = gbCart_getU32(data, base + 4) & 0x3f
    GB_RTC[GB_RTC_H] = gbCart_getU32(data, base + 8) & 0x1f
    GB_RTC[GB_RTC_DL] = gbCart_getU32(data, base + 12) & 0xff
    let dh = gbCart_getU32(data, base + 16) & 0xc1
    GB_RTC[GB_RTC_DH] = dh
    GB_RTC[GB_RTC_HALT] = (dh >>> 6) & 0x01
    GB_RTC[GB_RTC_CARRY] = (dh >>> 7) & 0x01

    // Rebase onto the restored values, then add the real time that passed while
    // the bundle was closed — that is what the timestamp in the footer is for,
    // and what makes the daily events in Pokemon Crystal fire correctly.
    gbCart_rtcRebase()
    if (GB_RTC[GB_RTC_HALT] === 0) {
      let saved = gbCart_getU32(data, base + 40) + gbCart_getU32(data, base + 44) * 4294967296
      let away = Math.floor(Date.now() / 1000) - saved
      if (away > 0 && saved > 0) { GB_RTC_EPOCH[0] = GB_RTC_EPOCH[0] - away * 1000 }
    }
  }

  return true
}
