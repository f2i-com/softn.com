// Encode job: rgba is straight alpha; it is composited over background [r,g,b] first. done(bytes).
function psJpegEncodeJob(rgba, w, h, quality, background, done, fail) {
  let ql = psJpegQuant(PS_JPEG_QL, quality), qc = psJpegQuant(PS_JPEG_QC, quality);
  let divL = new Float64Array(64), divC = new Float64Array(64);
  for (let r = 0; r < 8; r++) for (let c = 0; c < 8; c++) { let i = r * 8 + c; let s = PS_JPEG_AAN[r] * PS_JPEG_AAN[c] * 8; divL[i] = 1 / (ql[i] * s); divC[i] = 1 / (qc[i] * s); }
  let dcL = psJpegEncTable(PS_JPEG_DC_L_BITS, PS_JPEG_DC_L_VALS), dcC = psJpegEncTable(PS_JPEG_DC_C_BITS, PS_JPEG_DC_C_VALS);
  let acL = psJpegEncTable(PS_JPEG_AC_L_BITS, PS_JPEG_AC_L_VALS), acC = psJpegEncTable(PS_JPEG_AC_C_BITS, PS_JPEG_AC_C_VALS);
  let bg = background || [255, 255, 255];
  let writer = new PsWriter(Math.max(65536, (w * h) >> 2));
  let bw = { bb: 0, bc: 0 };
  let mcusX = Math.ceil(w / 16), mcusY = Math.ceil(h / 16);
  let predY = 0, predCb = 0, predCr = 0;
  let blockY = [new Float64Array(64), new Float64Array(64), new Float64Array(64), new Float64Array(64)];
  let blockCb = new Float64Array(64), blockCr = new Float64Array(64);
  let quant = new Int32Array(64);
  let zz = PS_ZIGZAG;

  function putBits(code, len) {
    bw.bb = ((bw.bb << len) | code) >>> 0; bw.bc += len;
    while (bw.bc >= 8) {
      let byte = (bw.bb >>> (bw.bc - 8)) & 255;
      writer.u8(byte);
      if (byte === 0xff) writer.u8(0);
      bw.bc -= 8;
    }
    bw.bb &= (1 << bw.bc) - 1;
  }
  function category(v) { let a = v < 0 ? -v : v, n = 0; while (a) { n++; a >>= 1; } return n; }
  function encodeBlock(samples, div, dcT, acT, pred) {
    psJpegFdctQuant(samples, div, quant);
    let dc = quant[0], diff = dc - pred;
    let s = category(diff);
    putBits(dcT.code[s], dcT.len[s]);
    if (s) putBits(diff < 0 ? (diff - 1) & ((1 << s) - 1) : diff, s);
    let run = 0;
    for (let k = 1; k < 64; k++) {
      let v = quant[zz[k]];
      if (v === 0) { run++; continue; }
      while (run > 15) { putBits(acT.code[0xf0], acT.len[0xf0]); run -= 16; }
      let sz = category(v);
      let sym = (run << 4) | sz;
      putBits(acT.code[sym], acT.len[sym]);
      putBits(v < 0 ? (v - 1) & ((1 << sz) - 1) : v, sz);
      run = 0;
    }
    if (run > 0) putBits(acT.code[0], acT.len[0]);
    return dc;
  }
  function writeHeader() {
    writer.u16be(0xffd8);
    writer.u16be(0xffe0).u16be(16).str("JFIF").u8(0).u8(1).u8(1).u8(0).u16be(1).u16be(1).u8(0).u8(0);
    writer.u16be(0xffdb).u16be(132);
    writer.u8(0); for (let k = 0; k < 64; k++) writer.u8(ql[zz[k]]);
    writer.u8(1); for (let k = 0; k < 64; k++) writer.u8(qc[zz[k]]);
    writer.u16be(0xffc0).u16be(17).u8(8).u16be(h).u16be(w).u8(3);
    writer.u8(1).u8(0x22).u8(0); writer.u8(2).u8(0x11).u8(1); writer.u8(3).u8(0x11).u8(1);
    let dht = function (tc, th, bits, vals) {
      writer.u16be(0xffc4).u16be(2 + 1 + 16 + vals.length).u8((tc << 4) | th);
      for (let i = 0; i < 16; i++) writer.u8(bits[i]);
      for (let i = 0; i < vals.length; i++) writer.u8(vals[i]);
    };
    dht(0, 0, PS_JPEG_DC_L_BITS, PS_JPEG_DC_L_VALS); dht(1, 0, PS_JPEG_AC_L_BITS, PS_JPEG_AC_L_VALS);
    dht(0, 1, PS_JPEG_DC_C_BITS, PS_JPEG_DC_C_VALS); dht(1, 1, PS_JPEG_AC_C_BITS, PS_JPEG_AC_C_VALS);
    writer.u16be(0xffda).u16be(12).u8(3).u8(1).u8(0x00).u8(2).u8(0x11).u8(3).u8(0x11).u8(0).u8(63).u8(0);
  }
  let started = false;
  let mcuIndex = 0, totalMcus = mcusX * mcusY;
  let mcusPerStep = PS_JPEG_ENC_MCUS;   // ~50K bytecode ops per MCU: gather, six DCTs, Huffman
  psEnqueue("Encoding JPEG", function () {
    if (!started) { writeHeader(); started = true; }
    let endMcu = Math.min(totalMcus, mcuIndex + mcusPerStep);
    let d = rgba, W = w, H = h, br = bg[0], bgG = bg[1], bb = bg[2];
    for (let m = mcuIndex; m < endMcu; m++) {
      let my = (m / mcusX) | 0, mx = m % mcusX;
      {
        // Gather a 16x16 area (edge-clamped), compositing over the background.
        for (let yy = 0; yy < 16; yy++) {
          let sy = my * 16 + yy; if (sy >= H) sy = H - 1;
          for (let xx = 0; xx < 16; xx++) {
            let sx = mx * 16 + xx; if (sx >= W) sx = W - 1;
            let i = (sy * W + sx) * 4;
            let a = d[i + 3], ia = 255 - a;
            let r = (d[i] * a + br * ia + 127) / 255 | 0, g = (d[i + 1] * a + bgG * ia + 127) / 255 | 0, bl = (d[i + 2] * a + bb * ia + 127) / 255 | 0;
            let Y = 0.299 * r + 0.587 * g + 0.114 * bl - 128;
            let bi = ((yy >> 3) << 1) | (xx >> 3);
            blockY[bi][((yy & 7) << 3) | (xx & 7)] = Y;
            // Chroma averaged 2x2 later: accumulate into blockCb/blockCr at half resolution.
            let ci = ((yy >> 1) << 3) | (xx >> 1);
            let cb = -0.168736 * r - 0.331264 * g + 0.5 * bl, cr = 0.5 * r - 0.418688 * g - 0.081312 * bl;
            if ((yy & 1) === 0 && (xx & 1) === 0) { blockCb[ci] = cb; blockCr[ci] = cr; }
            else { blockCb[ci] += cb; blockCr[ci] += cr; }
          }
        }
        for (let k = 0; k < 64; k++) { blockCb[k] *= 0.25; blockCr[k] *= 0.25; }
        predY = encodeBlock(blockY[0], divL, dcL, acL, predY);
        predY = encodeBlock(blockY[1], divL, dcL, acL, predY);
        predY = encodeBlock(blockY[2], divL, dcL, acL, predY);
        predY = encodeBlock(blockY[3], divL, dcL, acL, predY);
        predCb = encodeBlock(blockCb, divC, dcC, acC, predCb);
        predCr = encodeBlock(blockCr, divC, dcC, acC, predCr);
      }
    }
    mcuIndex = endMcu;
    if (mcuIndex >= totalMcus) {
      if (bw.bc > 0) putBits((1 << (8 - bw.bc)) - 1, 8 - bw.bc);   // pad with ones
      writer.u16be(0xffd9);
      return true;
    }
    return mcuIndex / totalMcus;
  }, function () { done(writer.finish()); }, fail);
}
