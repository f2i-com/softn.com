  // tmp[v*N + x] = sum_u m[x][u] * F(v,u)
  for (let v = 0; v < N; v++) {
    for (let x = 0; x < N; x++) {
      let s = 0;
      for (let u = 0; u < N; u++) s += m[x * N + u] * coef[offset + v * 8 + u] * qt[v * 8 + u];
      tmp[v * N + x] = s;
    }
  }
  for (let y = 0; y < N; y++) {
    for (let x = 0; x < N; x++) {
      let s = 0;
      for (let v = 0; v < N; v++) s += m[y * N + v] * tmp[v * N + x];
