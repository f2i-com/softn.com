              let st = { b: b, pos: dataPos, end: r.end, w: width, h: height, comp: 1, out: plane, row: 0, counts: new Int32Array(height), inflater: null, predicted: 0 };
              let total = 0;
              for (let y = 0; y < height; y++) { let cnt = psU16BE(b, tableStart + 2 * (c * height + y)); st.counts[y] = cnt; total += cnt; }
