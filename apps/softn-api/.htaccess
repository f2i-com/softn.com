# Everything under /api/ is answered by index.php. The site's own .htaccess
# routes here too; this one is for a host that applies per-directory rules
# first, and for serving this directory on its own.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # The docs are a route of the API (GET /api/README.md), not the file: as
  # a file the .md refusal below would answer 403 before the rewrite ran.
  RewriteRule ^README\.md$ index.php [L]
  # The library is included by index.php and is never a page of its own.
  # FilesMatch sees only a file's name, never its directory, so lib/ is
  # kept out here.
  RewriteRule ^lib/ - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "\.md$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
