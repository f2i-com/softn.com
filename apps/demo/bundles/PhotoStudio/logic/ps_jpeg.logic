        let m = sc.reader.pos;
        if (m + 1 < n && b[m] === 0xff && b[m + 1] >= 0xd0 && b[m + 1] <= 0xd7) { /* restart marker, keep going */ }
        else { warnings.push("JPEG data ended early; the image may be incomplete."); sc.mcu = sc.total; break; }
      }
    }
    if (sc.mcu >= sc.total) {
      // Find the next marker after the entropy-coded data.
      let p = sc.reader.pos;
      while (p + 1 < n) {
        if (b[p] === 0xff && b[p + 1] !== 0 && !(b[p + 1] >= 0xd0 && b[p + 1] <= 0xd7) && b[p + 1] !== 0xff) break;
        p++;
      }
      markerPos = p;
      scan = null;
      return true;
    }
    return false;
  }

  // Parse markers until a scan begins or the file ends. Returns true when all scans are done.
  function parseStep() {
    if (scan) { runScanStep(); return false; }
    while (markerPos + 3 < n) {
      if (b[markerPos] !== 0xff) { markerPos++; continue; }
      let marker = b[markerPos + 1];
      if (marker === 0xff) { markerPos++; continue; }
      let p = markerPos + 2;
      if (marker === 0xd8 || (marker >= 0xd0 && marker <= 0xd7) || marker === 0x01) { markerPos = p; continue; }
      if (marker === 0xd9) { markerPos = n; break; }
      let len = psU16BE(b, p);
      if (p + len > n) { warnings.push("JPEG file is truncated."); markerPos = n; break; }
      if (marker === 0xdb) {
        let q = p + 2, end = p + len;
        while (q < end) {
          let pq = b[q] >> 4, tq = b[q] & 15; q++;
          if (tq > 3) psFail("Corrupt JPEG quantisation table.");
          let t = new Int32Array(64);
          for (let k = 0; k < 64; k++) { if (pq) { t[PS_ZIGZAG[k]] = psU16BE(b, q); q += 2; } else t[PS_ZIGZAG[k]] = b[q++]; }
          qts[tq] = t;
        }
      } else if (marker === 0xc4) {
        let q = p + 2, end = p + len;
        while (q < end) {
          let tc = b[q] >> 4, th = b[q] & 15; q++;
          let bits = new Uint8Array(16), total = 0;
          for (let i = 0; i < 16; i++) { bits[i] = b[q + i]; total += bits[i]; }
          q += 16;
          let vals = new Uint8Array(total);
          for (let i = 0; i < total; i++) vals[i] = b[q + i];
          q += total;
          let table = psJpegHuffTable(bits, vals);
          if (tc === 0) dcTables[th & 3] = table; else acTables[th & 3] = table;
        }
      } else if (marker === 0xc0 || marker === 0xc1 || marker === 0xc2) {
        if (frame) psFail("JPEG contains more than one frame.");
        frame = psJpegParseFrame(b, p, marker === 0xc2);
        prepareFrame();
      } else if (marker === 0xc3 || (marker >= 0xc5 && marker <= 0xc7) || (marker >= 0xc9 && marker <= 0xcb) || (marker >= 0xcd && marker <= 0xcf)) {
        psFail("Lossless, hierarchical and arithmetic-coded JPEG files are not supported.");
