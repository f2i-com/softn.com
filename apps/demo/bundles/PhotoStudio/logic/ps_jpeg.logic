    return { full: false, plane: c.plane, planeW: c.planeW, planeH: c.planeH, x0: x0, x1: x1, wx: wx, fy: fy,
      hA: new Float32Array(W), hB: new Float32Array(W), rA: -1, rB: -1 };
  }
  function hrow(s, r, protectRow) {
    if (s.rA === r) return s.hA;
    if (s.rB === r) return s.hB;
    let dst;
    if (s.rA !== protectRow) { dst = s.hA; s.rA = r; } else { dst = s.hB; s.rB = r; }
    let plane = s.plane, b = r * s.planeW, x0 = s.x0, x1 = s.x1, wx = s.wx, W = outW;
    for (let x = 0; x < W; x++) { let w = wx[x]; dst[x] = plane[b + x0[x]] * (1 - w) + plane[b + x1[x]] * w; }
