<logic>
  // Chase: drive round the field with W A S D or the arrows and collect the flags. The camera follows the car.
  let pad = { presses: {} }
  let car = { x: 0, z: 0, heading: 0, speed: 0 }
  let flags = []
  let found = 0
  let objects = []

  // The camera keeps behind the car and looks a little ahead of it. The scene works that out on every frame.
  let camera = { follow: { target: "car", distance: 7, height: 3.5, lookAhead: 2 }, fov: 60 }

  // What never changes. One record draws every tree: where each stands (x, y, z, with y half its
  // height so it stands on the ground), how far it is turned, and how big it is.
  let scenery = [
    { id: "ground", type: "plane", width: 80, height: 80, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, color: "#3f6212" },
    {
      id: "trees", type: "instanced", shape: "cone", radius: 1, height: 3, color: "#166534",
      instances: [-12, 1.5, 8,  10, 2.1, 14,  -6, 1.2, -16,  15, 1.8, -9,  -18, 2.4, -4,  4, 1.5, 22],
      instanceRotations: [0, 0.8, 1.6, 2.4, 3.2, 4],
      instanceScales: [1, 1.4, 0.8, 1.2, 1.6, 1]
    }
  ]

  function scatter() {
    flags = [
      { id: "flag-1", x: 0, z: 6 },
      { id: "flag-2", x: -9, z: 3 },
      { id: "flag-3", x: 12, z: -7 },
      { id: "flag-4", x: -5, z: -12 }
    ]
    found = 0
    car = { x: 0, z: 0, heading: 0, speed: 0 }
  }

  // The lists the scene draws from, made again after each step.
  function draw() {
    objects = [
      // The car's front is its +z. Turned by its heading, it faces (sin heading, cos heading) on the ground.
      { id: "car", type: "box", width: 1, height: 0.6, depth: 2, color: "#ef4444", position: { x: car.x, y: 0.3, z: car.z }, rotation: { x: 0, y: car.heading, z: 0 } }
    ].concat(flags.map(flag => ({
      id: flag.id, type: "cylinder", radius: 0.12, height: 2.4, color: "#fde047", emissive: "#facc15", emissiveIntensity: 0.5,
      position: { x: flag.x, y: 1.2, z: flag.z }
    })))
  }

  function _init() {
    scatter()
    draw()
  }

  function step(dt) {
    // Speed builds up and falls away; steering turns the car.
    const drive = (pad.forward ? 1 : 0) - (pad.back ? 1 : 0)
    const turn = (pad.left ? 1 : 0) - (pad.right ? 1 : 0)
    car.speed += (drive * 9 - car.speed) * Math.min(1, 3 * dt)
    car.heading += turn * 1.8 * dt
    car.x += Math.sin(car.heading) * car.speed * dt
    car.z += Math.cos(car.heading) * car.speed * dt
    car.x = Math.max(-38, Math.min(38, car.x))
    car.z = Math.max(-38, Math.min(38, car.z))

    // A flag is taken when the car is within reach of it.
    const before = flags.length
    flags = flags.filter(flag => Math.hypot(flag.x - car.x, flag.z - car.z) > 1.5)
    found += before - flags.length
    draw()
  }

  function again() {
    scatter()
    draw()
  }
</logic>

<style>
  .world { position: relative; height: 480px; }
  .tag { padding: 2px 10px; border-radius: 999px; background: rgba(0, 0, 0, 0.6); color: #fef9c3; font-weight: 600; white-space: nowrap; }
  .done { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(0, 0, 0, 0.45); }
</style>

<App theme="dark">
  <div class="world">
    <Scene3D fill sky="day" transition={34} cameraSmoothing={0.12} objects={objects} staticObjects={scenery} camera={camera}>
      <SceneAnchor object="car" place="above" offset={{ y: 1 }} clickThrough>
        <span class="tag">{found} of 4</span>
      </SceneAnchor>
    </Scene3D>
    #if (flags.length === 0)
      <div class="done">
        <Button variant="primary" @click={again}>Again</Button>
      </div>
    #end
  </div>
  <Controls :bind={pad} enabled={flags.length > 0} keys={{ forward: "w ArrowUp", back: "s ArrowDown", left: "a ArrowLeft", right: "d ArrowRight" }} />
  <Loop frame maxFps={30} running={flags.length > 0} @tick={step} />
</App>
