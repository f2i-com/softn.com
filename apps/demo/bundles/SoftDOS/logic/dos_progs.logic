// Put them on drive C at boot. Uint8Array so they behave like a loaded file.
function dosProgs_install() {
  dosKernel_vfsAdd("HELLO.COM", Uint8Array.from(DOS_PROG_HELLO));
  dosKernel_vfsAdd("PLASMA.COM", Uint8Array.from(DOS_PROG_PLASMA));
  dosKernel_vfsAdd("MANDEL.COM", Uint8Array.from(DOS_PROG_MANDEL));
  dosKernel_vfsAdd("BOXES.COM", Uint8Array.from(DOS_PROG_BOXES));
}
