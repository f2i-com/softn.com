{
  "about": "The arguments softn.crypto.randomInt and randomHex take, as both SoftN backend hosts must take them. Each case is one call, softn.crypto[call](...args), made by `script` in a handler: `below` says the call returns a whole number from 0 up to but not including it, `length` the length of the text it returns, `throws` that it throws. A bound or a count is a whole number, or text that spells one (a value out of a query string); the bound may be anything up to 2^53-1. Read by apps/softn-host-php/tests/route-declarations.test.mjs and apps/softn-host-rust/src/bridges/crypto.rs.",
  "script": "function cryptoCases(req){var out=[];for(var i=0;i<req.body.cases.length;i++){var c=req.body.cases[i];try{out.push({ok:softn.crypto[c.call].apply(null,c.args)});}catch(e){out.push({threw:true});}}return {status:200,rollback:true,body:out};}",
  "cases": [
    {"call": "randomInt", "args": [6], "below": 6},
    {"call": "randomInt", "args": [1], "below": 1},
    {"call": "randomInt", "args": ["6"], "below": 6, "note": "text that spells a whole number is that number"},
    {"call": "randomInt", "args": [281474976710655], "below": 281474976710655},
    {"call": "randomInt", "args": [281474976710656], "below": 281474976710656, "note": "2^48, where the PHP host's Node used to stop"},
    {"call": "randomInt", "args": [9007199254740991], "below": 9007199254740991, "note": "2^53-1, the largest bound"},
    {"call": "randomInt", "args": ["9007199254740991"], "below": 9007199254740991},
    {"call": "randomInt", "args": [0], "throws": true},
    {"call": "randomInt", "args": [-3], "throws": true},
    {"call": "randomInt", "args": [6.5], "throws": true},
    {"call": "randomInt", "args": ["6.5"], "throws": true},
    {"call": "randomInt", "args": ["six"], "throws": true},
    {"call": "randomInt", "args": [""], "throws": true},
    {"call": "randomInt", "args": [" 6"], "throws": true},
    {"call": "randomInt", "args": [null], "throws": true},
    {"call": "randomInt", "args": [true], "throws": true},
    {"call": "randomInt", "args": [], "throws": true},
    {"call": "randomInt", "args": [9007199254740992], "throws": true},
    {"call": "randomInt", "args": ["99999999999999999999999"], "throws": true},
    {"call": "randomHex", "args": [8], "length": 16},
    {"call": "randomHex", "args": ["8"], "length": 16},
    {"call": "randomHex", "args": [1], "length": 2},
    {"call": "randomHex", "args": [64], "length": 128},
    {"call": "randomHex", "args": [0], "throws": true},
    {"call": "randomHex", "args": [65], "throws": true},
    {"call": "randomHex", "args": [2.5], "throws": true},
    {"call": "randomHex", "args": ["many"], "throws": true},
    {"call": "randomHex", "args": [null], "throws": true}
  ]
}
