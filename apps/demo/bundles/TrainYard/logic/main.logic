// Build Lighting based on Day-Night cycle
function buildLights() {
  let list = [];

  let locoPt = getTrackPoint(trainProgress);
  let locoHead = getTrackHeading(trainProgress);

  if (timeProgress >= 0.1 && timeProgress <= 0.42) {
    // Bright Sunny Midday (Cinematic Warm Sunlight + Rich Ambient Fill)
    timeLabel = "12:00 PM (Midday)";
    skyColor = "#60a5fa";

    // Primary High Sun
    list.push({
      id: "sun-main",
      type: "directional",
      color: "#fffbeb",
      intensity: 1.6,
      position: { x: 8, y: 18, z: 12 },
      castShadow: true,
      shadowCameraSize: 20,
      shadowBias: -0.0003
    });

    // Opposite Sky Fill Light
    list.push({
      id: "sky-fill",
      type: "directional",
      color: "#bae6fd",
      intensity: 0.7,
      position: { x: -10, y: 14, z: -10 }
    });

    // Rich Ambient Daylight
    list.push({
      id: "ambient",
      type: "ambient",
      color: "#cbd5e1",
      intensity: 0.65
    });

  } else if (timeProgress > 0.42 && timeProgress <= 0.58) {
    // Golden Hour Sunset
    timeLabel = "06:45 PM (Golden Hour)";
    skyColor = "#fb923c";

    list.push({
      id: "sun-sunset",
      type: "directional",
      color: "#f97316",
      intensity: 1.5,
      position: { x: 16, y: 7, z: 8 },
      castShadow: true,
      shadowCameraSize: 20,
      shadowBias: -0.0003
    });

    list.push({
      id: "sunset-fill",
      type: "directional",
      color: "#a855f7",
      intensity: 0.5,
      position: { x: -12, y: 8, z: -8 }
    });

    list.push({
      id: "ambient",
      type: "ambient",
      color: "#fed7aa",
      intensity: 0.55
    });

  } else {
    // Starry Night
    timeLabel = "11:00 PM (Night)";
    skyColor = "#090d16";

    // Soft cool moonlight
    list.push({
      id: "moon",
      type: "directional",
      color: "#93c5fd",
      intensity: 0.45,
      position: { x: -8, y: 16, z: -6 },
      castShadow: true,
      shadowCameraSize: 20,
      shadowBias: -0.0003
    });

    list.push({
      id: "ambient",
      type: "ambient",
      color: "#1e1b4b",
      intensity: 0.38
    });

    if (lightsEnabled) {
      // Forward Locomotive Headlight Beam
      list.push({
        id: "light-loco-beam",
        type: "point",
        color: "#fef08a",
        intensity: 2.2,
        distance: 7.5,
        position: {
          x: locoPt.x + Math.sin(locoHead) * 1.5,
          y: locoPt.y + 0.9,
          z: locoPt.z + Math.cos(locoHead) * 1.5
        }
      });

      // Warm station platform glow
      list.push({
        id: "light-station",
        type: "point",
        color: "#fef08a",
        intensity: 2.0,
        distance: 8.5,
        position: { x: 0.0, y: 2.0, z: 6.7 }
      });

      // Town street lamp glow
      list.push({
        id: "light-town",
        type: "point",
        color: "#fed7aa",
        intensity: 1.8,
        distance: 7.5,
        position: { x: 3.5, y: 2.4, z: 7.2 }
      });

      // Roundhouse Terminal interior glow
      list.push({
        id: "light-roundhouse",
        type: "point",
        color: "#fbbf24",
        intensity: 2.0,
        distance: 9.0,
        position: { x: -4.5, y: 2.2, z: -3.0 }
      });

      // Yard Floodlight Tower Pool
      list.push({
        id: "light-yard-pool",
        type: "point",
        color: "#fef08a",
        intensity: 2.2,
        distance: 9.5,
        position: { x: -4.5, y: 4.8, z: 1.8 }
      });
    }
  }

  return list;
}

// Game Step Loop
function gameStep(dt) {
  let delta = dt ? Math.min(dt, 0.1) : 0.033;

  // 1. Train speed physics
  let speedDelta = targetSpeed - trainSpeed;
  trainSpeed = trainSpeed + speedDelta * Math.min(1.0, delta * 3.0);
  let speedFactor = 0.030;
  trainProgress = (trainProgress + trainSpeed * trainDirection * delta * speedFactor) % 1.0;
  if (trainProgress < 0) trainProgress = trainProgress + 1.0;

  // 2. Day-Night cycle
  timeProgress = (timeProgress + delta * timeSpeed) % 1.0;
  isNight = timeProgress > 0.58 || timeProgress < 0.1;

  // 3. Turntable rotation
  let turnDelta = targetTurntableAngle - turntableAngle;
  if (Math.abs(turnDelta) > 0.01) {
    turntableAngle = turntableAngle + Math.sign(turnDelta) * Math.min(Math.abs(turnDelta), delta * 0.8);
  }

  // 4. Harbor Crane animation
  cranePhase = cranePhase + delta * 0.4;
  craneAngle = 0.35 + Math.sin(cranePhase) * 0.55;
  craneHoistY = 1.6 + Math.abs(Math.sin(cranePhase * 1.5)) * 0.9;

  // 5. Town road vehicles animation (Cruising in opposite lanes separated by half a lap, zero head-on collisions)
  carProgress1 = (carProgress1 + delta * 0.036) % 1.0;
  carProgress2 = (carProgress1 + 0.50) % 1.0;

  // 6. Whistle timer
  if (whistleActive) {
    whistleTimer = whistleTimer + delta;
    if (whistleTimer > 1.8) {
      whistleActive = false;
      whistleTimer = 0;
    }
  }

  // 7. Dynamic Camera tracking for "cab" ride mode
  if (cameraMode === "cab") {
    let locoPt = getTrackPoint(trainProgress);
    let locoHead = getTrackHeading(trainProgress);
    let backDist = 2.4;
    let eyeH = 1.35;
    cameraPos = {
      x: locoPt.x - Math.sin(locoHead) * backDist,
      y: locoPt.y + eyeH,
      z: locoPt.z - Math.cos(locoHead) * backDist
    };
    cameraLookAt = {
      x: locoPt.x + Math.sin(locoHead) * 5.0,
      y: locoPt.y + 0.8,
      z: locoPt.z + Math.cos(locoHead) * 5.0
    };
  }

  // 8. Rebuild dynamic objects and lights
  objects = buildDynamicObjects();
  lights = buildLights();
}

// User Actions
function setSpeed(sp) {
  targetSpeed = Math.max(0.0, Math.min(1.0, sp));
}

function toggleDirection() {
  trainDirection = trainDirection * -1;
}

function blowWhistle() {
  whistleActive = true;
  whistleTimer = 0.0;
}

function rotateTurntableNext() {
  turntableStall = (turntableStall + 1) % 4;
  let angles = [0.0, 0.28, 0.56, -0.28];
  targetTurntableAngle = angles[turntableStall];
}

function cycleTimeOfDay() {
  if (timeProgress < 0.35) {
    timeProgress = 0.48; // Sunset
  } else if (timeProgress < 0.65) {
    timeProgress = 0.72; // Night
  } else {
    timeProgress = 0.2; // Midday
  }
}

function toggleLights() {
  lightsEnabled = !lightsEnabled;
}

function setCameraView(mode) {
  cameraMode = mode;
  if (mode === "front") {
    cameraPos = { x: 0, y: 7.2, z: 15.5 };
    cameraLookAt = { x: 0, y: 0.8, z: 1.0 };
    cameraFov = 46;
  } else if (mode === "tower") {
    cameraPos = { x: -9.5, y: 8.5, z: 6.5 };
    cameraLookAt = { x: -3.5, y: 1.0, z: -1.0 };
    cameraFov = 50;
  } else if (mode === "harbor") {
    cameraPos = { x: 12.0, y: 4.8, z: 8.5 };
    cameraLookAt = { x: 6.0, y: 1.2, z: 1.8 };
    cameraFov = 45;
  } else if (mode === "overhead") {
    cameraPos = { x: 0, y: 22.0, z: 0.1 };
    cameraLookAt = { x: 0, y: 0, z: 0 };
    cameraFov = 52;
  }
}

// In-World 3D Object Click Handler
function handleSceneClick(hit) {
  if (!hit || !hit.objectId) return;
  let id = hit.objectId;

  if (id.indexOf("ctrl-throttle") !== -1 || id === "ctrl-slot" || id === "ctrl-bezel-throttle" || id.indexOf("ctrl-tick") !== -1) {
    if (trainSpeed < 0.25) {
      setSpeed(0.5);
    } else if (trainSpeed < 0.65) {
      setSpeed(1.0);
    } else {
      setSpeed(0.0);
    }
  } else if (id === "ctrl-switch-dir" || id === "ctrl-bezel-dir") {
    toggleDirection();
  } else if (id === "ctrl-btn-whistle" || id === "ctrl-bezel-whistle") {
    blowWhistle();
  } else if (id.indexOf("ctrl-turntable") !== -1 || id === "ctrl-bezel-turntable") {
    rotateTurntableNext();
  } else if (id === "ctrl-switch-lights" || id === "ctrl-lamp-lights" || id === "ctrl-bezel-lights") {
    toggleLights();
  }
}

// Initialize on load
gameStep(0.033);
