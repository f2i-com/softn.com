// Pocket — the memory bus.
//
// A transliteration of emulator/src/emulator/core/mmu.ts onto the state layout
// declared in gb_state.logic. Owns the address decode, GB_WRAM, GB_HRAM,
// GB_IO, OAM DMA, HDMA/GDMA, the joypad, the serial stub, and the interrupt
// request bookkeeping. Everything else on the bus belongs to another module and
// is reached through that module's accessor.
//
// ---------------------------------------------------------------------------
// WHY IT LOOKS LIKE THIS
// ---------------------------------------------------------------------------
//
// gbMmu_read and gbMmu_write are the second hottest path in the bundle after
// GB_OPS dispatch — every instruction fetch, every LD, every PUSH and POP comes
// through here, four million times a second of emulated time. So:
//
//   * No allocation. Not one array literal, object literal or closure anywhere
//     below. Every scratch value is a local `let` holding a number.
//   * No switch. zipp compiles `switch` to a linear scan (measured 34x between
//     the first and last arm of a 256-arm switch), and CONTRACT.md §1.3 forbids
//     spending any more of the plain-value budget on a dispatch table, so the
//     IO decode is a hand-ordered if-chain instead. It is ordered by measured
//     traffic, not by address: the PPU block is tested first because LY and
//     STAT are the two most-read registers on the bus by a wide margin, and
//     inside that block FF40-FF45 comes before FF46 so LY costs two compares.
//   * No helper calls in the common cases. The WRAM bank arithmetic, the echo
//     fold and the VRAM index are written out at each site rather than routed
//     through a shared function.
//
// The three cross-module calls that DO stay in the hot path — gbCart_romRead,
// gbCart_ramRead, gbCart_ramWrite — stay because gb_cart owns the mapper and
// gb_state.logic already arranged for a ROM read to be one add and one typed
// array index (GB_CART[GB_K_ROMOFF_*] are precomputed byte offsets). Inlining
// them here would duplicate mapper knowledge — MBC3's RTC register file lives
// behind gbCart_ramRead — for the cost of one call.
//
// ---------------------------------------------------------------------------
// VRAM WRITES AND THE TILE CACHE
// ---------------------------------------------------------------------------
//
// CONTRACT.md §4 is the load-bearing bit of this file. Every path that mutates
// GB_VRAM must mark the affected tile row dirty in the PPU's decode cache, or
// the picture goes subtly and intermittently stale. There are three such paths
// here and all three are covered:
//
//   1. gbMmu_write, 8000-9FFF          — inlines the store (see below)
//   2. gbMmu_hblankHdma                — calls gbPpu_dirtyVram per byte
//   3. the general-DMA branch of FF55  — calls gbPpu_dirtyVram per byte
//
// The inline in gbMmu_write is byte-identical to gbPpu_dirtyVram's body, as
// §3.2 requires:
//
//     GB_TILEDIRTY[flat >>> 1] = 1
//
// It is inlined there and only there because that is the path a blit takes.
// The two DMA paths call the function: 16 bytes per HBlank is 2304 calls a
// frame, which is not worth the duplication.
//
// Note that `flat` covers BOTH banks and the tilemap region as well as tile
// data — flat = (bank << 13) | (addr - 0x8000), 0..0x3FFF, so flat >>> 1 lands
// in 0..0x1FFF and needs no bounds test and no branch. See gb_state.logic.
//
// ---------------------------------------------------------------------------
// APU WRITES AND WHEN THEY LAND
// ---------------------------------------------------------------------------
//
// A write to FF10-FF3F is handed to gbApu_writeReg synchronously, inside the
// write that caused it. Nothing is queued or deferred. That matters because
// gb_machine ticks the peripherals in 4-cycle chunks between instructions
// (CONTRACT.md §3.8), so by the time an opcode's store reaches this file the
// APU has already been advanced to the M-cycle boundary before that store —
// the register change therefore takes effect at the right point in the sample
// stream, and a trigger written on one M-cycle does not retroactively alter the
// samples generated for the previous one. Deferring the call to the end of the
// instruction would smear every note onset by up to five M-cycles, which is
// audible on the fast arpeggios DMG sound drivers are built out of.
//
// Wave RAM (FF30-FF3F) goes through gbApu_writeReg too, not straight into
// GB_WAVERAM, because the APU has to honour the "writable while powered off,
// aliased to the current sample position while playing" rules.
//
// ---------------------------------------------------------------------------
// STORAGE THIS FILE USES THAT IS NOT OBVIOUS
// ---------------------------------------------------------------------------
//
// The four HDMA address latches FF51-FF54 are write-only on hardware and read
// back 0xFF, so their last-written bytes are parked in GB_IO[0x51..0x54] where
// nothing can observe them. That avoids claiming four of the eight spare GB_CTR
// slots for what is really just four bytes of register file. The live transfer
// state — snapshotted source, destination, remaining length, HBlank flag —
// is in GB_CTR[GB_C_HDMA_*] as the contract specifies.
//
// Deviation from the reference: mmu.ts initialises those four latches to 0xFF
// and gbState_reset zeroes all of GB_IO, so after a reset Pocket's latches read
// 0x00 rather than 0xFF. This is only observable to a ROM that writes FF55
// without ever writing FF51-FF54, which would be a garbage transfer either way.

// ---------------------------------------------------------------------------
// THE BUSY FLAG
//
// 1 while the serial stub or the OAM DMA is in flight — the only two conditions
// under which gbMmu_stepOamDma does anything. It is a pure function of
//
//     GB_CTR[GB_C_SERIAL_CYCLES] > 0, GB_CTR[GB_C_ODMA_CYCLES] > 0
//
// so it carries nothing of its own and is not saved; gbMachine_loadState
// recomputes it.
//
// It exists for the same reason gbTimer_live does: gb_machine's quiet-span test
// reads it once per instruction, and one scalar read (~2ns on the shipping
// engine) replaces two Int32Array reads (~22ns each) plus their compares.
//
// gb_mmu is the only module that writes it. The three places that can move
// either counter — the FF46 arm, the FF02 arm, and gbMmu_stepOamDma itself —
// all end in a write to it, and gbState_reset calls gbMmu_syncBusy() because it
// clears GB_CTR wholesale.
// ---------------------------------------------------------------------------
let gbMmu_busy = 0

function gbMmu_syncBusy() {
  if (GB_CTR[GB_C_SERIAL_CYCLES] > 0 || GB_CTR[GB_C_ODMA_CYCLES] > 0) {
    gbMmu_busy = 1
  } else {
    gbMmu_busy = 0
  }
}

// ===========================================================================
// Read
// ===========================================================================

// The whole 16-bit space. Honours the OAM-DMA lockout: while the transfer runs
// the CPU sees open bus (0xFF) for everything below FF80, and only HRAM and IE
// answer. Matches mmu.ts read().
function gbMmu_read(addr) {
  let a = addr & 0xffff

  // 0000-7FFF, and nothing on the bus contending. Hottest arm by a distance —
  // this is where PC usually is and where every ROM-resident operand comes
  // from — so it is lifted above the lockout test and answered here rather
  // than in gb_cart.
  //
  // gbCart_baseLo/_HI are gb_cart's published window bases, gbCart_baseHi
  // pre-biased by -0x4000; gbCart_present is its null test, hoisted. All three
  // are plain scalars (~2ns) against the ~22ns an Int32Array element costs on
  // this engine, so what was a call plus two GB_CART reads plus a subtract is
  // now three scalar reads and one indexed load. Measured 55ns a read.
  //
  // gbMmu_busy covers the OAM DMA lockout the two lines below used to test
  // first: it is 1 whenever GB_C_ODMA_CYCLES is, so a locked-out bus falls
  // through to the general path and answers 0xFF there exactly as before. It
  // is also 1 during a serial transfer, which does not lock the bus — that
  // costs the fast path 4096 T-cycles of a transfer and is worth not having a
  // second scalar.
  if (a < 0x8000 && gbMmu_busy === 0 && gbCart_present === 1) {
    if (a < 0x4000) { return GB_ROM[gbCart_baseLo + a] }
    return GB_ROM[gbCart_baseHi + a]
  }

  // The lockout is observable and a surprising number of ROMs sit in a HRAM
  // loop during the transfer precisely because of it. gbMmu_busy is 1 whenever
  // GB_C_ODMA_CYCLES is, so leading with the scalar turns the common case into
  // a ~2ns read and only pays for the Int32Array load when something really is
  // in flight.
  if (gbMmu_busy !== 0 && GB_CTR[GB_C_ODMA_CYCLES] > 0 && a < 0xff80) { return 0xff }

  // 0000-7FFF, reached only when the fast path above declined it.
  if (a < 0x8000) { return gbCart_romRead(a) }

  // 8000-9FFF. Both banks live in one array; a bank switch is an offset.
  if (a < 0xa000) { return GB_VRAM[(GB_CTR[GB_C_VRAM_BANK] << 13) | (a - 0x8000)] }

  // A000-BFFF. gb_cart answers 0xFF when RAM is disabled or absent, and
  // routes MBC3's latched RTC register file.
  if (a < 0xc000) { return gbCart_ramRead(a) }

  // C000-CFFF, bank 0, fixed.
  if (a < 0xd000) { return GB_WRAM[a - 0xc000] }

  // D000-DFFF, bank 1-7 on CGB. GB_C_WRAM_BANK holds the raw SVBK value so
  // FF70 reads back what was written; 0 acts as bank 1. On DMG the register is
  // never written, so it stays 0 and this resolves to bank 1 with no mode test.
  if (a < 0xe000) {
    let bank = GB_CTR[GB_C_WRAM_BANK]
    if (bank < 1) { bank = 1 }
    return GB_WRAM[(bank << 12) + (a - 0xd000)]
  }

  // E000-FDFF, echo of C000-DDFF through the same bank arithmetic.
  if (a < 0xfe00) {
    let e = a - 0x2000
    if (e < 0xd000) { return GB_WRAM[e - 0xc000] }
    let bank = GB_CTR[GB_C_WRAM_BANK]
    if (bank < 1) { bank = 1 }
    return GB_WRAM[(bank << 12) + (e - 0xd000)]
  }

  if (a < 0xfea0) { return GB_OAM[a - 0xfe00] }
  if (a < 0xff00) { return 0xff }               // FEA0-FEFF, unmapped
  if (a < 0xff80) { return gbMmu_readIo(a) }
  if (a < 0xffff) { return GB_HRAM[a - 0xff80] }
  return GB_IO[GB_IO_IE]
}

// Source read for the OAM DMA engine, bypassing the lockout the engine itself
// is holding. Without this every byte of every transfer would come back 0xFF.
// FE00 and above reads open bus, as on hardware. Matches mmu.ts readForDma().
function gbMmu_readDma(addr) {
  let a = addr & 0xffff
  if (a < 0x8000) { return gbCart_romRead(a) }
  if (a < 0xa000) { return GB_VRAM[(GB_CTR[GB_C_VRAM_BANK] << 13) | (a - 0x8000)] }
  if (a < 0xc000) { return gbCart_ramRead(a) }
  if (a < 0xd000) { return GB_WRAM[a - 0xc000] }
  if (a < 0xe000) {
    let bank = GB_CTR[GB_C_WRAM_BANK]
    if (bank < 1) { bank = 1 }
    return GB_WRAM[(bank << 12) + (a - 0xd000)]
  }
  if (a < 0xfe00) {
    let e = a - 0x2000
    if (e < 0xd000) { return GB_WRAM[e - 0xc000] }
    let bank = GB_CTR[GB_C_WRAM_BANK]
    if (bank < 1) { bank = 1 }
    return GB_WRAM[(bank << 12) + (e - 0xd000)]
  }
  return 0xff
}

// ===========================================================================
// Write
// ===========================================================================

function gbMmu_write(addr, v) {
  let a = addr & 0xffff
  let val = v & 0xff

  // Writes outside HRAM are dropped while the OAM DMA runs — except a write to
  // FF46 itself, which restarts the transfer (Pan Docs). Same short-circuit as
  // the read side: gbMmu_busy is a superset of "an OAM DMA is running", so the
  // scalar answers for every write that is not during a transfer.
  if (gbMmu_busy !== 0 && GB_CTR[GB_C_ODMA_CYCLES] > 0 && a < 0xff80 && a !== 0xff46) { return }

  // 0000-7FFF is mapper control, not memory. gb_cart ends with gbCart_remap().
  if (a < 0x8000) { gbCart_romWrite(a, val); return }

  // 8000-9FFF. CONTRACT.md §3.2 spells this case out exactly; the dirty store
  // is gbPpu_dirtyVram's body inlined verbatim, which §3.2 permits and §4
  // requires to be byte-identical. The function still exists and is still
  // called from the two DMA paths below and from the save-state loader.
  if (a < 0xa000) {
    let flat = (GB_CTR[GB_C_VRAM_BANK] << 13) | (a - 0x8000)
    GB_VRAM[flat] = val
    GB_TILEDIRTY[flat >>> 1] = 1
    return
  }

  if (a < 0xc000) { gbCart_ramWrite(a, val); return }
  if (a < 0xd000) { GB_WRAM[a - 0xc000] = val; return }

  if (a < 0xe000) {
    let bank = GB_CTR[GB_C_WRAM_BANK]
    if (bank < 1) { bank = 1 }
    GB_WRAM[(bank << 12) + (a - 0xd000)] = val
    return
  }

  // E000-FDFF echo. Same fold as the read side.
  if (a < 0xfe00) {
    let e = a - 0x2000
    if (e < 0xd000) { GB_WRAM[e - 0xc000] = val; return }
    let bank = GB_CTR[GB_C_WRAM_BANK]
    if (bank < 1) { bank = 1 }
    GB_WRAM[(bank << 12) + (e - 0xd000)] = val
    return
  }

  if (a < 0xfea0) { GB_OAM[a - 0xfe00] = val; return }
  if (a < 0xff00) { return }                      // FEA0-FEFF, dropped
  if (a < 0xff80) { gbMmu_writeIo(a, val); return }
  if (a < 0xffff) { GB_HRAM[a - 0xff80] = val; return }
  GB_IO[GB_IO_IE] = val & 0x1f
  gbMmu_syncIrq()
}

// ===========================================================================
// IO read — FF00-FF7F
//
// Ordered by traffic. The 0x40+ block goes first because a vblank wait loop
// reads FF44 tens of thousands of times a second and a raster effect reads
// FF41 as often; inside it, FF40-FF45 precedes the FF46 special case so LY
// costs exactly two compares. The APU block is second, the FF0F/joypad/timer
// singles third. Everything unclaimed reads open bus.
// ===========================================================================

function gbMmu_readIo(addr) {
  let r = addr & 0x7f

  if (r >= 0x40) {
    // LCDC, STAT, SCY, SCX, LY, LYC — gb_ppu owns all of them.
    if (r <= 0x45) { return gbPpu_readReg(addr) }
    // FF46 DMA is gb_mmu's, canonical in GB_IO, and sits inside the PPU range.
    if (r === 0x46) { return GB_IO[0x46] }
    // BGP, OBP0, OBP1, WY, WX.
    if (r <= 0x4b) { return gbPpu_readReg(addr) }
    // VBK. gb_ppu owns the bank counter and applies the 0xFE readback mask.
    if (r === 0x4f) { return gbPpu_readReg(addr) }
    // BCPS/BCPD, OCPS/OCPD, OPRI.
    if (r >= 0x68 && r <= 0x6c) { return gbPpu_readReg(addr) }

    // KEY1. Bit 7 is the current speed, bit 0 the armed switch; the switch
    // itself happens in STOP, not here.
    if (r === 0x4d) {
      if (GB_CPUF[GB_P_GBC] === 0) { return 0xff }
      return ((gbCpu_double << 7) | gbCpu_speedSw | 0x7e) & 0xff
    }

    // HDMA source/destination are write-only.
    if (r >= 0x51 && r <= 0x54) { return 0xff }

    // HDMA control. While an HBlank transfer runs, the low seven bits are the
    // remaining length in 16-byte blocks minus one and bit 7 is clear. Idle
    // reads 0xFF, which is bit 7 set — "no transfer active".
    if (r === 0x55) {
      if (GB_CPUF[GB_P_GBC] === 0) { return 0xff }
      if (GB_CTR[GB_C_HDMA_ACTIVE] === 1) {
        return ((GB_CTR[GB_C_HDMA_LEFT] / 0x10) - 1) & 0x7f
      }
      return 0xff
    }

    // SVBK.
    if (r === 0x70) {
      if (GB_CPUF[GB_P_GBC] === 0) { return 0xff }
      return 0xf8 | (GB_CTR[GB_C_WRAM_BANK] & 0x07)
    }

    // FF56 RP, FF50 boot-disable, FF6D-FF6F, FF71-FF7F, and the reference's
    // FF7F sprite-overlay extension, which Pocket does not implement.
    return 0xff
  }

  // FF10-FF3F: NRxx and wave RAM. gb_apu applies the per-register readback
  // masks, which are not uniform — NR13 is write-only, NR52 mixes live channel
  // status into the low nibble.
  if (r >= 0x10) {
    if (r <= 0x3f) { return gbApu_readReg(addr) }
    return 0xff
  }

  // FF00-FF0F.
  if (r === 0x0f) { return GB_IO[0x0f] | 0xe0 }
  if (r === 0x00) { return gbMmu_readP1() }
  if (r === 0x04) { return gbTimer_readDiv() }
  // TIMA/TMA/TAC are canonical in GB_IO — gb_timer keeps them there, including
  // zeroing TIMA for the four cycles of the post-overflow reload window, so
  // reading the byte directly is correct and saves three call frames.
  if (r === 0x05) { return GB_IO[0x05] }
  if (r === 0x06) { return GB_IO[0x06] }
  if (r === 0x07) { return GB_IO[0x07] | 0xf8 }
  if (r === 0x01) { return GB_IO[0x01] }
  if (r === 0x02) {
    // SC. Bit 1 is the CGB high-speed clock select and reads back there; on DMG
    // it is unused and reads 1 with the rest.
    if (GB_CPUF[GB_P_GBC] === 1) { return GB_IO[0x02] | 0x7c }
    return GB_IO[0x02] | 0x7e
  }
  // FF03, FF08-FF0E.
  return 0xff
}

// ===========================================================================
// IO write — FF00-FF7F
//
// Same shape and same ordering as the read side, so the two stay legible
// against each other.
// ===========================================================================

function gbMmu_writeIo(addr, v) {
  let r = addr & 0x7f
  let val = v & 0xff

  if (r >= 0x40) {
    if (r <= 0x45) { gbPpu_writeReg(addr, val); return }

    // FF46 — arm the OAM DMA. 644 T-cycles: 4 of start delay, because the
    // cart's write does not act on its own M-cycle, then 640 of streaming at
    // one byte per M-cycle. gbMmu_stepOamDma does the copying; all that
    // happens here is the arming, and writing FF46 again mid-transfer
    // restarts it from the top.
    if (r === 0x46) {
      GB_IO[0x46] = val
      GB_CTR[GB_C_ODMA_SRC] = (val << 8) & 0xffff
      GB_CTR[GB_C_ODMA_BYTES] = 0
      GB_CTR[GB_C_ODMA_DELAY] = 4
      GB_CTR[GB_C_ODMA_CYCLES] = 644
      gbMmu_busy = 1
      return
    }

    if (r <= 0x4b) { gbPpu_writeReg(addr, val); return }
    if (r === 0x4f) { gbPpu_writeReg(addr, val); return }
    if (r >= 0x68 && r <= 0x6c) { gbPpu_writeReg(addr, val); return }

    // KEY1 — arm a speed switch. STOP performs it.
    if (r === 0x4d) {
      if (GB_CPUF[GB_P_GBC] === 1) { gbCpu_speedSw = val & 1 }
      return
    }

    // HDMA source high/low, destination high/low. Write-only latches; parked
    // in GB_IO where the read path cannot see them.
    if (r >= 0x51 && r <= 0x54) {
      if (GB_CPUF[GB_P_GBC] === 1) { GB_IO[r] = val }
      return
    }

    if (r === 0x55) {
      if (GB_CPUF[GB_P_GBC] === 1) { gbMmu_startHdma(val) }
      return
    }

    if (r === 0x70) {
      if (GB_CPUF[GB_P_GBC] === 1) { GB_CTR[GB_C_WRAM_BANK] = val & 0x07 }
      return
    }

    // FF50 boot-ROM disable is ignored: Pocket starts post-boot, so there is
    // no boot ROM mapped over 0000-00FF to unmap. FF56 RP and everything else
    // up here is dropped.
    return
  }

  // FF10-FF3F. Synchronous, straight into gb_apu — see the header comment on
  // why this must not be deferred.
  if (r >= 0x10) {
    if (r <= 0x3f) { gbApu_writeReg(addr, val); return }
    return
  }

  if (r === 0x0f) { GB_IO[0x0f] = val & 0x1f; gbMmu_syncIrq(); return }
  if (r === 0x00) { gbMmu_writeP1(val); return }
  if (r === 0x04) { gbTimer_writeDiv(); return }
  if (r === 0x05) { gbTimer_writeTima(val); return }
  if (r === 0x06) { gbTimer_writeTma(val); return }
  if (r === 0x07) { gbTimer_writeTac(val); return }

  if (r === 0x01) { GB_IO[0x01] = val; return }

  if (r === 0x02) {
    // SC. Bit 7 starts a transfer, bit 0 selects the internal clock. Pocket
    // has no link cable, so the stub self-clocks either way and completes
    // after eight bit periods of 512 T-cycles — 4096 T-cycles — loading 0xFF
    // into SB and raising the serial interrupt. That is enough that a ROM
    // polling SC bit 7, or waiting on the interrupt, does not hang; it is not
    // enough to talk to anything.
    GB_IO[0x02] = val & 0x83
    if ((val & 0x80) !== 0) {
      GB_CTR[GB_C_SERIAL_CYCLES] = 4096
      gbMmu_busy = 1
    }
    return
  }

  // FF03, FF08-FF0E: dropped.
}

// ===========================================================================
// OAM DMA
// ===========================================================================

// Advance the OAM DMA window, and the serial stub's countdown along with it.
//
// The serial rides here because CONTRACT.md §3.8 gives gb_mmu exactly one
// per-cycle hook in gbMachine_tickParts, and growing a second entry point would
// mean changing a contract that is already binding. It is four Int32 operations
// on a counter that is zero almost always.
//
// The DMA itself streams floor(cycles / 4) bytes per call rather than copying
// 160 bytes at the FF46 write, so cart code that reads OAM mid-transfer sees
// the partial state. gb_machine feeds this in 4-cycle chunks, so the floor
// never actually discards anything.
function gbMmu_stepOamDma(cycles) {
  // Neither engine is running: nothing below can do anything. One scalar read
  // for the overwhelming majority of the calls this function ever gets.
  if (gbMmu_busy === 0) { return }

  if (GB_CTR[GB_C_SERIAL_CYCLES] > 0) {
    GB_CTR[GB_C_SERIAL_CYCLES] = GB_CTR[GB_C_SERIAL_CYCLES] - cycles
    if (GB_CTR[GB_C_SERIAL_CYCLES] <= 0) {
      GB_CTR[GB_C_SERIAL_CYCLES] = 0
      GB_IO[0x01] = 0xff
      GB_IO[0x02] = GB_IO[0x02] & 0x7f
      gbMmu_requestIrq(GB_IRQ_SERIAL)
    }
  }

  if (GB_CTR[GB_C_ODMA_CYCLES] <= 0) { gbMmu_syncBusy(); return }

  let left = cycles

  // Pay down the 4-cycle start delay before any byte moves.
  if (GB_CTR[GB_C_ODMA_DELAY] > 0) {
    let used = GB_CTR[GB_C_ODMA_DELAY]
    if (used > left) { used = left }
    GB_CTR[GB_C_ODMA_DELAY] = GB_CTR[GB_C_ODMA_DELAY] - used
    GB_CTR[GB_C_ODMA_CYCLES] = GB_CTR[GB_C_ODMA_CYCLES] - used
    left = left - used
    if (left <= 0) { gbMmu_syncBusy(); return }
  }

  let stream = left
  if (stream > GB_CTR[GB_C_ODMA_CYCLES]) { stream = GB_CTR[GB_C_ODMA_CYCLES] }
  GB_CTR[GB_C_ODMA_CYCLES] = GB_CTR[GB_C_ODMA_CYCLES] - stream

  // One byte per M-cycle. The bus stays locked for the last four cycles after
  // the 160th byte lands, which is spec-correct and cart-irrelevant.
  let want = stream >>> 2
  let written = GB_CTR[GB_C_ODMA_BYTES]
  let src = GB_CTR[GB_C_ODMA_SRC]
  let i = 0
  while (i < want && written < 160) {
    GB_OAM[written] = gbMmu_readDma((src + written) & 0xffff)
    written = written + 1
    i = i + 1
  }
  GB_CTR[GB_C_ODMA_BYTES] = written
  gbMmu_syncBusy()
}

// ===========================================================================
// HDMA / GDMA — CGB only
// ===========================================================================

// FF55. Bit 7 chooses HBlank mode. Writing bit 7 = 0 while an HBlank transfer
// is running cancels it and does nothing else; otherwise the FF51-FF54 latches
// are snapshotted, because the spec allows the cart to reuse them for the next
// transfer while this one is still in flight.
function gbMmu_startHdma(v) {
  let wantHBlank = (v & 0x80) !== 0

  if (GB_CTR[GB_C_HDMA_ACTIVE] === 1 && !wantHBlank) {
    GB_CTR[GB_C_HDMA_ACTIVE] = 0
    return
  }

  // Source is 16-byte aligned and may be anywhere; destination is forced into
  // 8000-9FF0.
  let src = ((GB_IO[0x51] << 8) | (GB_IO[0x52] & 0xf0)) & 0xffff
  let dst = (0x8000 | (((GB_IO[0x53] & 0x1f) << 8) | (GB_IO[0x54] & 0xf0))) & 0xffff
  let length = ((v & 0x7f) + 1) * 0x10

  GB_CTR[GB_C_HDMA_SRC] = src
  GB_CTR[GB_C_HDMA_DST] = dst
  GB_CTR[GB_C_HDMA_LEFT] = length

  if (wantHBlank) {
    GB_CTR[GB_C_HDMA_ACTIVE] = 1
    return
  }

  // General DMA. Hardware stalls the CPU for the duration; Pocket does the
  // work atomically and lets the cycle count catch up, as the reference does.
  let base = GB_CTR[GB_C_VRAM_BANK] << 13
  let i = 0
  while (i < length) {
    let flat = base | ((dst + i) & 0x1fff)
    GB_VRAM[flat] = gbMmu_read((src + i) & 0xffff)
    gbPpu_dirtyVram(flat)
    i = i + 1
  }

  GB_CTR[GB_C_HDMA_SRC] = (src + length) & 0xffff
  GB_CTR[GB_C_HDMA_DST] = (dst + length) & 0xffff
  GB_CTR[GB_C_HDMA_LEFT] = 0
  GB_CTR[GB_C_HDMA_ACTIVE] = 0
}

// Called by gb_ppu on the mode 3 -> mode 0 edge. Sixteen bytes per HBlank,
// which is what makes an HBlank transfer usable for streaming tile data in
// during active display without tearing.
function gbMmu_hblankHdma() {
  if (GB_CTR[GB_C_HDMA_ACTIVE] === 0) { return }

  let src = GB_CTR[GB_C_HDMA_SRC]
  let dst = GB_CTR[GB_C_HDMA_DST]
  let base = GB_CTR[GB_C_VRAM_BANK] << 13
  let i = 0

  while (i < 16) {
    let flat = base | (dst & 0x1fff)
    GB_VRAM[flat] = gbMmu_read(src)
    gbPpu_dirtyVram(flat)
    src = (src + 1) & 0xffff
    dst = (dst + 1) & 0xffff
    i = i + 1
  }

  GB_CTR[GB_C_HDMA_SRC] = src
  GB_CTR[GB_C_HDMA_DST] = dst
  GB_CTR[GB_C_HDMA_LEFT] = GB_CTR[GB_C_HDMA_LEFT] - 16
  if (GB_CTR[GB_C_HDMA_LEFT] <= 0) {
    GB_CTR[GB_C_HDMA_LEFT] = 0
    GB_CTR[GB_C_HDMA_ACTIVE] = 0
  }
}

// ===========================================================================
// Interrupts
//
// IF is GB_IO[0x0F] and IE is GB_IO[GB_IO_IE], both five bits. Everything in
// the bundle raises through here; only gbCpu_serviceIrq clears on dispatch.
// ===========================================================================

// ---------------------------------------------------------------------------
// THE PENDING MIRROR
//
// gbMmu_irqPending is (IE & IF & 0x1F) — the exact expression gbCpu_serviceIrq
// opens with, kept as a plain scalar. It carries nothing of its own and is not
// saved; gbMachine_loadState re-derives it.
//
// It exists because that expression is evaluated once per instruction and
// costs two Uint8Array reads (~22ns each on the shipping engine) plus two ands
// for an answer that is almost always zero. As a scalar it is ~2ns, and
// gbMachine_runSlice can skip the call into gb_cpu entirely.
//
// gb_mmu owns every write to either register, so every one of them ends here.
// ---------------------------------------------------------------------------
let gbMmu_irqPending = 0

function gbMmu_syncIrq() {
  gbMmu_irqPending = GB_IO[GB_IO_IE] & GB_IO[0x0f] & 0x1f
}

function gbMmu_requestIrq(bit) {
  GB_IO[0x0f] = (GB_IO[0x0f] | (1 << bit)) & 0x1f
  gbMmu_irqPending = GB_IO[GB_IO_IE] & GB_IO[0x0f] & 0x1f
}

function gbMmu_clearIrq(bit) {
  GB_IO[0x0f] = GB_IO[0x0f] & ~(1 << bit) & 0x1f
  gbMmu_irqPending = GB_IO[GB_IO_IE] & GB_IO[0x0f] & 0x1f
}

// ===========================================================================
// Joypad — FF00
//
// GB_PAD[0] is the live mask as the host sends it, active HIGH, in the DMG's
// own two-nibble order: bit 0 A, 1 B, 2 Select, 3 Start, 4 Right, 5 Left,
// 6 Up, 7 Down. Hardware is active LOW and both selects can be asserted at
// once, so producing P1 is a shift and two masks rather than eight tests.
// ===========================================================================

function gbMmu_writeP1(v) {
  // Only the two select bits are writable; the low nibble is the input lines.
  GB_IO[0x00] = v & 0x30
}

function gbMmu_readP1() {
  let s = GB_IO[0x00] & 0x30
  let v = 0xcf | s
  if ((s & 0x20) === 0) { v = v & ~(GB_PAD[0] & 0x0f) }
  if ((s & 0x10) === 0) { v = v & ~((GB_PAD[0] >>> 4) & 0x0f) }
  return v & 0xff
}

// The host sends the whole mask every time it changes, never deltas. A bit
// that is newly set is a new press, which is the high-to-low edge on the input
// line that raises the joypad interrupt.
//
// Opposing directions are passed through untouched — real hardware allows
// Left+Right and Up+Down and a few games lean on the glitch. Sanitising is the
// UI's business, not the bus's.
function gbMmu_setButtons(mask) {
  let m = mask & 0xff
  let pressed = m & ~GB_PAD[1] & 0xff
  if (pressed !== 0) { gbMmu_requestIrq(GB_IRQ_JOYPAD) }
  GB_PAD[0] = m
  GB_PAD[1] = m
}
