// ps_pixels.logic - pure pixel algorithms over straight-alpha RGBA8 buffers.
//
// Kernels take explicit row (or column) ranges so the editor can wrap them in
// sliced jobs. Nothing here allocates per pixel or reads a global inside a loop.

// ---------------------------------------------------------------------------
// Flood fill (magic wand, paint bucket). Resumable BFS.
// ---------------------------------------------------------------------------
function psFloodNew(data, w, h, x, y, tolerance, contiguous) {
  let n = w * h;
  let mask = new Uint8Array(n);
  x = Math.floor(x); y = Math.floor(y);
  let st = { data: data, w: w, h: h, mask: mask, tol: psClamp(Math.round(tolerance), 0, 255), contiguous: !!contiguous, queue: null, head: 0, tail: 0, scan: 0, done: false, sr: 0, sg: 0, sb: 0, sa: 0 };
  if (x < 0 || y < 0 || x >= w || y >= h) { st.done = true; return st; }
  let si = (y * w + x) * 4;
  st.sr = data[si]; st.sg = data[si + 1]; st.sb = data[si + 2]; st.sa = data[si + 3];
  if (contiguous) { st.queue = new Int32Array(n); st.queue[0] = y * w + x; st.tail = 1; mask[y * w + x] = 255; }
  return st;
}
function psFloodMatches(data, i, st) {
  let a = data[i + 3];
  let da = a > st.sa ? a - st.sa : st.sa - a;
  if (da > st.tol) return false;
  if (st.sa === 0 && a === 0) return true;
  let dr = data[i] - st.sr, dg = data[i + 1] - st.sg, db = data[i + 2] - st.sb;
  if (dr < 0) dr = -dr; if (dg < 0) dg = -dg; if (db < 0) db = -db;
  let m = dr > dg ? dr : dg; if (db > m) m = db;
  return m <= st.tol;
}
// Returns true when finished; processes at most `budget` pixels per call.
function psFloodRun(st, budget) {
  if (st.done) return true;
  let data = st.data, mask = st.mask, w = st.w, n = st.w * st.h;
  let tol = st.tol, sr = st.sr, sg = st.sg, sb = st.sb, sa = st.sa;
  let work = 0;
  if (!st.contiguous) {
    let end = Math.min(n, st.scan + budget);
    for (let p = st.scan; p < end; p++) {
      let i = p * 4, a = data[i + 3];
      let da = a > sa ? a - sa : sa - a;
      if (da > tol) continue;
      if (sa === 0 && a === 0) { mask[p] = 255; continue; }
      let dr = data[i] - sr, dg = data[i + 1] - sg, db = data[i + 2] - sb;
      if (dr < 0) dr = -dr; if (dg < 0) dg = -dg; if (db < 0) db = -db;
      let m = dr > dg ? dr : dg; if (db > m) m = db;
      if (m <= tol) mask[p] = 255;
    }
    st.scan = end;
    if (end >= n) st.done = true;
    return st.done;
  }
  let queue = st.queue, head = st.head, tail = st.tail;
  while (head < tail && work < budget) {
    let p = queue[head++];
    work++;
    let px = p % w;
    let q;
    if (px > 0) { q = p - 1; if (!mask[q]) { let i = q * 4, a = data[i + 3], da = a > sa ? a - sa : sa - a; if (da <= tol) { let ok = (sa === 0 && a === 0); if (!ok) { let dr = data[i] - sr, dg = data[i + 1] - sg, db = data[i + 2] - sb; if (dr < 0) dr = -dr; if (dg < 0) dg = -dg; if (db < 0) db = -db; let m = dr > dg ? dr : dg; if (db > m) m = db; ok = m <= tol; } if (ok) { mask[q] = 255; queue[tail++] = q; } } } }
    if (px < w - 1) { q = p + 1; if (!mask[q]) { let i = q * 4, a = data[i + 3], da = a > sa ? a - sa : sa - a; if (da <= tol) { let ok = (sa === 0 && a === 0); if (!ok) { let dr = data[i] - sr, dg = data[i + 1] - sg, db = data[i + 2] - sb; if (dr < 0) dr = -dr; if (dg < 0) dg = -dg; if (db < 0) db = -db; let m = dr > dg ? dr : dg; if (db > m) m = db; ok = m <= tol; } if (ok) { mask[q] = 255; queue[tail++] = q; } } } }
    if (p >= w) { q = p - w; if (!mask[q]) { let i = q * 4, a = data[i + 3], da = a > sa ? a - sa : sa - a; if (da <= tol) { let ok = (sa === 0 && a === 0); if (!ok) { let dr = data[i] - sr, dg = data[i + 1] - sg, db = data[i + 2] - sb; if (dr < 0) dr = -dr; if (dg < 0) dg = -dg; if (db < 0) db = -db; let m = dr > dg ? dr : dg; if (db > m) m = db; ok = m <= tol; } if (ok) { mask[q] = 255; queue[tail++] = q; } } } }
    if (p < n - w) { q = p + w; if (!mask[q]) { let i = q * 4, a = data[i + 3], da = a > sa ? a - sa : sa - a; if (da <= tol) { let ok = (sa === 0 && a === 0); if (!ok) { let dr = data[i] - sr, dg = data[i + 1] - sg, db = data[i + 2] - sb; if (dr < 0) dr = -dr; if (dg < 0) dg = -dg; if (db < 0) db = -db; let m = dr > dg ? dr : dg; if (db > m) m = db; ok = m <= tol; } if (ok) { mask[q] = 255; queue[tail++] = q; } } } }
  }
  st.head = head; st.tail = tail;
  if (head >= tail) { st.done = true; st.queue = null; }
