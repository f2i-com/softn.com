// ===========================================================================
// dos_bc.logic — decoded-block cache
//
// A decoded-basic-block cache written entirely in .logic.
//
// Each static x86 instruction is decoded ONCE into a 0-argument closure with
// its register slots, displacement, operand size, segment index and ALU
// function baked in as free variables.  A run of such closures is stored in a
// direct-mapped cache keyed on the physical address of the block entry.
// Replaying a block is: one tag probe, then array-read + 0-arg-call per
// instruction.
//
// Semantics come from the SAME helpers the interpreter uses (dosAlu_*,
// dosOps_shift, dosOps_string, dosMmu_*), so machine state stays bit-exact.
// Anything the decoder does not know ends the block and runs through
// dosCpu_step() unchanged.
// ===========================================================================

let DOS_BC_SLOTS = 8192;
let DOS_BC_TAG = null;
let DOS_BC_FN = null;
let DOS_BC_NUM = null;
let DOS_BC_BYT = null;
let DOS_BC_TERM = null;
let DOS_BC_MAX = 24;
let DOS_BC_ENTRY = 0;
let DOS_BC_EIP0 = 0;
let DOS_BC_BUILT = 0;
let DOS_BC_HITS = 0;
let DOS_BC_INSTR = 0;
let DOS_BC_STEPS = 0;
// One byte per 4 KB page, set when that page holds decoded code. A write to a
// marked page throws the whole cache away: a program that rewrites its own
// instructions (a self-extracting .COM, say) must not go on running the code
// it used to have. Coarse on purpose — self-modifying code is rare, and the
// check costs one array read on a path that runs under once per instruction.
let DOS_BC_CODEPAGE = null;

let DOS_DC = 0;
let DOS_DC_TERM = 0;
let DOS_DM_ISREG = 0;
let DOS_DM_REG = 0;
let DOS_DM_RM = 0;
let DOS_DM_AF = null;

function dosBc_init() {
  DOS_BC_CODEPAGE = new Uint8Array(4096);
  DOS_BC_TAG = new Int32Array(DOS_BC_SLOTS);
  DOS_BC_FN = new Array(DOS_BC_SLOTS);
  DOS_BC_NUM = new Int32Array(DOS_BC_SLOTS);
  DOS_BC_BYT = new Int32Array(DOS_BC_SLOTS);
  DOS_BC_TERM = new Int32Array(DOS_BC_SLOTS);
  dosBc_flush();
}
// Called on reset and whenever code memory is written under a cached block.
function dosBc_flush() {
  if (DOS_BC_TAG === null) return;
  DOS_BC_CODEPAGE.fill(0);
  for (let i = 0; i < DOS_BC_SLOTS; i++) DOS_BC_TAG[i] = -1;
}

// --- decode-time byte reader (does not touch DOS_EIP) ----------------------
function dosDec_u8() {
  let v = DOS_RAM[DOS_DC & 0xFFFFFF];
  DOS_DC = DOS_DC + 1;
  return v;
}
function dosDec_u16() {
  let a = DOS_DC & 0xFFFFFF;
  DOS_DC = DOS_DC + 2;
  return DOS_RAM[a] | (DOS_RAM[(a + 1) & 0xFFFFFF] << 8);
}
function dosDec_s8() {
  let v = dosDec_u8();
  return (v << 24) >> 24;
}

// --- operand closure factories --------------------------------------------
function dosDec_reg8Slot(r) { return (r < 4) ? (r * 4) : ((r - 4) * 4 + 1); }

function dosDec_mkRegGet(r, size) {
  if (size === 1) { let s = dosDec_reg8Slot(r); return function () { return DOS_REGS8[s]; }; }
  let s2 = r * 2;
  return function () { return DOS_REGS16[s2]; };
}
function dosDec_mkRegSet(r, size) {
  if (size === 1) { let s = dosDec_reg8Slot(r); return function (v) { DOS_REGS8[s] = v & 0xFF; }; }
  let s2 = r * 2;
  return function (v) { DOS_REGS16[s2] = v & 0xFFFF; };
}
// A byte access through a decoded block takes the VGA window's planar path
// when the card is unchained; the tiles in Jill of the Jungle reached the
// planes through string instructions the decoder refuses, and its sprites,
// written a byte at a time through decoded blocks, landed in plain RAM
// behind the window instead, invisibly.
function dosDec_mkMemGet(af, size) {
  if (size === 1) return function () {
    let a = af() & 0xFFFFFF;
    if (DOS_VGA_UNCHAINED === 1 && a >= 0xA0000 && a < 0xB0000) return dosVga_readPlanar(a - 0xA0000);
    return DOS_RAM[a];
  };
  return function () { return dosMmu_read16(af()); };
}
// Every write goes past the barrier, including the ones decoded blocks make.
function dosBc_touch(addr) {
  if (DOS_BC_CODEPAGE !== null && DOS_BC_CODEPAGE[(addr >>> 12) & 4095]) dosBc_flush();
  dosJit_touch(addr);
}
function dosDec_mkMemSet(af, size) {
  if (size === 1) return function (v) {
    let a = af() & 0xFFFFFF;
    dosBc_touch(a);
    if (DOS_VGA_UNCHAINED === 1 && a >= 0xA0000 && a < 0xB0000) { dosVga_writePlanar(a - 0xA0000, v); return; }
    DOS_RAM[a] = v & 0xFF;
  };
  return function (v) { dosMmu_write16(af(), v); };
}

function dosDec_mkAddr16(rm, disp, sidx, direct) {
  if (direct === 1) return function () { return (((DOS_SEGS[sidx] << 4) + (disp & 0xFFFF)) >>> 0) & 0xFFFFFF; };
  if (rm === 0) return function () { return (((DOS_SEGS[sidx] << 4) + ((DOS_REGS16[6] + DOS_REGS16[12] + disp) & 0xFFFF)) >>> 0) & 0xFFFFFF; };
  if (rm === 1) return function () { return (((DOS_SEGS[sidx] << 4) + ((DOS_REGS16[6] + DOS_REGS16[14] + disp) & 0xFFFF)) >>> 0) & 0xFFFFFF; };
  if (rm === 2) return function () { return (((DOS_SEGS[sidx] << 4) + ((DOS_REGS16[10] + DOS_REGS16[12] + disp) & 0xFFFF)) >>> 0) & 0xFFFFFF; };
  if (rm === 3) return function () { return (((DOS_SEGS[sidx] << 4) + ((DOS_REGS16[10] + DOS_REGS16[14] + disp) & 0xFFFF)) >>> 0) & 0xFFFFFF; };
  if (rm === 4) return function () { return (((DOS_SEGS[sidx] << 4) + ((DOS_REGS16[12] + disp) & 0xFFFF)) >>> 0) & 0xFFFFFF; };
  if (rm === 5) return function () { return (((DOS_SEGS[sidx] << 4) + ((DOS_REGS16[14] + disp) & 0xFFFF)) >>> 0) & 0xFFFFFF; };
  if (rm === 6) return function () { return (((DOS_SEGS[sidx] << 4) + ((DOS_REGS16[10] + disp) & 0xFFFF)) >>> 0) & 0xFFFFFF; };
  return function () { return (((DOS_SEGS[sidx] << 4) + ((DOS_REGS16[6] + disp) & 0xFFFF)) >>> 0) & 0xFFFFFF; };
}

function dosDec_modrm16(segOvr) {
  let m = dosDec_u8();
  let mod = (m >> 6) & 3;
  DOS_DM_REG = (m >> 3) & 7;
  let rm = m & 7;
  DOS_DM_RM = rm;
  if (mod === 3) { DOS_DM_ISREG = 1; DOS_DM_AF = null; return 1; }
  DOS_DM_ISREG = 0;

  let sidx = 3;
  if (segOvr >= 0) sidx = segOvr;
  else if (rm === 2 || rm === 3 || (rm === 6 && mod !== 0)) sidx = 2;

  let disp = 0;
  let direct = 0;
  if (rm === 6 && mod === 0) { direct = 1; disp = dosDec_u16(); }
  else if (mod === 1) disp = dosDec_s8();
  else if (mod === 2) disp = dosDec_u16();

  DOS_DM_AF = dosDec_mkAddr16(rm, disp, sidx, direct);
  return 1;
}

function dosDec_rmGet(size) {
  if (DOS_DM_ISREG === 1) return dosDec_mkRegGet(DOS_DM_RM, size);
  return dosDec_mkMemGet(DOS_DM_AF, size);
}
function dosDec_rmSet(size) {
  if (DOS_DM_ISREG === 1) return dosDec_mkRegSet(DOS_DM_RM, size);
  return dosDec_mkMemSet(DOS_DM_AF, size);
}

function dosDec_aluFn(op) {
  if (op === 0) return dosAlu_add;
  if (op === 1) return dosAlu_or;
  if (op === 2) return dosAlu_adc;
  if (op === 3) return dosAlu_sbb;
  if (op === 4) return dosAlu_and;
  if (op === 5) return dosAlu_sub;
  if (op === 6) return dosAlu_xor;
  return dosAlu_sub;
}

// --- instruction closure factories ----------------------------------------
function dosDec_mkAluRR16(fn, ds, ss, store, cyc) {
  if (store === 1) return function () { DOS_REGS16[ds] = fn(DOS_REGS16[ds], DOS_REGS16[ss], 2) & 0xFFFF; return cyc; };
  return function () { fn(DOS_REGS16[ds], DOS_REGS16[ss], 2); return cyc; };
}
function dosDec_mkAluRR8(fn, ds, ss, store, cyc) {
  if (store === 1) return function () { DOS_REGS8[ds] = fn(DOS_REGS8[ds], DOS_REGS8[ss], 1) & 0xFF; return cyc; };
  return function () { fn(DOS_REGS8[ds], DOS_REGS8[ss], 1); return cyc; };
}
function dosDec_mkAlu(fn, g1, g2, s1, size, store, cyc) {
  if (store === 1) return function () { s1(fn(g1(), g2(), size)); return cyc; };
  return function () { fn(g1(), g2(), size); return cyc; };
}
function dosDec_mkAluImm16R(fn, ds, imm, store, cyc) {
  if (store === 1) return function () { DOS_REGS16[ds] = fn(DOS_REGS16[ds], imm, 2) & 0xFFFF; return cyc; };
  return function () { fn(DOS_REGS16[ds], imm, 2); return cyc; };
}
function dosDec_mkAluImm(fn, g1, imm, s1, size, store, cyc) {
  if (store === 1) return function () { s1(fn(g1(), imm, size)); return cyc; };
  return function () { fn(g1(), imm, size); return cyc; };
}
function dosDec_mkMov(g1, s1, cyc) { return function () { s1(g1()); return cyc; }; }
function dosDec_mkMovRR16(d, s) { return function () { DOS_REGS16[d] = DOS_REGS16[s]; return 2; }; }
function dosDec_mkMovRR8(d, s) { return function () { DOS_REGS8[d] = DOS_REGS8[s]; return 2; }; }
function dosDec_mkMovImm(s1, imm, cyc) { return function () { s1(imm); return cyc; }; }
function dosDec_mkMovImmR16(d, imm) { return function () { DOS_REGS16[d] = imm; return 2; }; }
function dosDec_mkMovImmR8(d, imm) { return function () { DOS_REGS8[d] = imm; return 2; }; }

function dosDec_mkIncR16(d) { return function () { DOS_REGS16[d] = dosAlu_inc(DOS_REGS16[d], 2) & 0xFFFF; return 2; }; }
function dosDec_mkDecR16(d) { return function () { DOS_REGS16[d] = dosAlu_dec(DOS_REGS16[d], 2) & 0xFFFF; return 2; }; }

function dosDec_mkShiftImm(sop, g1, s1, cnt, size, cyc) {
  return function () { s1(dosOps_shift(sop, g1(), cnt, size)); return cyc; };
}
function dosDec_mkShiftCL(sop, g1, s1, size, cyc) {
  return function () { s1(dosOps_shift(sop, g1(), DOS_REGS8[4], size)); return cyc; };
}
function dosDec_mkTest(g1, g2, size, cyc) { return function () { dosAlu_and(g1(), g2(), size); return cyc; }; }
function dosDec_mkTestImm(g1, imm, size, cyc) { return function () { dosAlu_and(g1(), imm, size); return cyc; }; }
function dosDec_mkPush16(g1) { return function () { dosCpu_push16(g1()); return 2; }; }
function dosDec_mkPop16(s1) { return function () { s1(dosCpu_pop16()); return 2; }; }
function dosDec_mkOut8() { return function () { dosMmu_out8(DOS_REGS16[4], DOS_REGS8[0]); return 5; }; }
function dosDec_mkIn8() { return function () { DOS_REGS8[0] = dosMmu_in8(DOS_REGS16[4]); return 5; }; }
function dosDec_mkOut16() {
  return function () { let v = DOS_REGS16[0]; dosMmu_out8(DOS_REGS16[4], v & 0xFF); dosMmu_out8(DOS_REGS16[4] + 1, (v >> 8) & 0xFF); return 5; };
}
function dosDec_mkIn16() {
  return function () { let p = DOS_REGS16[4]; DOS_REGS16[0] = (dosMmu_in8(p) | (dosMmu_in8(p + 1) << 8)) & 0xFFFF; return 5; };
}
function dosDec_mkString(kind, size) { return function () { return dosOps_string(kind, size, 0); }; }
function dosDec_mkNop() { return function () { return 1; }; }
function dosDec_mkFlagOp(which) {
  if (which === 0) return function () { dosCpu_flushFlags(); DOS_EFLAGS &= ~DOS_FL_DF; return 2; };
  if (which === 1) return function () { dosCpu_flushFlags(); DOS_EFLAGS |= DOS_FL_DF; return 2; };
  if (which === 2) return function () { dosCpu_setCF(false); return 2; };
  return function () { dosCpu_setCF(true); return 2; };
}

// Group 3 (F6/F7) and the two-byte shifts reuse the stock helpers; the only
// thing baked in is the operand location, so the ModR/M globals are restored
// from constants instead of being re-decoded.
function dosDec_mkGrp3Simple(which, size, g1, s1) {
  if (which === 2) return function () { s1(~g1()); return 3; };       // NOT
  return function () { s1(dosAlu_sub(0, g1(), size)); return 3; };    // NEG
}
function dosDec_mkGrp3Test(size, g1, imm) {
  return function () { dosAlu_and(g1(), imm, size); return 3; };
}
function dosDec_mkGrp3Wide(which, size, isreg, rm, af) {
  return function () {
    DOS_MRM_ISREG = isreg;
    DOS_MRM_RM = rm;
    if (isreg === 0) DOS_MRM_ADDR = af();
    if (which === 4) { dosOps_mul(size); return 11; }
    if (which === 5) { dosOps_imul(size); return 11; }
    if (which === 6) { dosOps_div(size); return 17; }
    dosOps_idiv(size);
    return 17;
  };
}
function dosDec_mkShrdImm(size, g1, s1, gsrc, n) {
  if (n === 0) return function () { return 3; };
  let bits = size * 8;
  let mask = (size === 1) ? 0xFF : ((size === 2) ? 0xFFFF : 0xFFFFFFFF);
  return function () {
    let dst = g1();
    let src = gsrc();
    let res = ((dst >>> n) | (src << (bits - n))) & mask;
    s1(res);
    dosCpu_setResultFlags(res, size);
    dosCpu_setCF(((dst >>> (n - 1)) & 1) !== 0);
    return 4;
  };
}
function dosDec_mkIncDecRM(isInc, size, g1, s1) {
  if (isInc === 1) return function () { s1(dosAlu_inc(g1(), size)); return 3; };
  return function () { s1(dosAlu_dec(g1(), size)); return 3; };
}

// Negative cache entry: the decoder does not know this instruction, so the
// block ends by handing exactly one instruction to the stock interpreter.
// Caching this is what keeps a low-coverage program from re-decoding forever.
function dosDec_mkStep(adv) {
  return function () {
    DOS_EIP = (DOS_BC_EIP0 + adv) >>> 0;
    DOS_BC_STEPS++;
    let c = dosCpu_step();
    DOS_TOTAL_CYCLES -= c;   // dosCpu_step already charged them; the block charges once
    return c;
  };
}

// Terminators: they set DOS_EIP themselves, from the block's entry EIP.
function dosDec_mkJcc(cond, rel, adv) {
  return function () {
    let e = (DOS_BC_EIP0 + adv) >>> 0;
    if (dosOps_evalCondition(cond)) { DOS_EIP = (e + rel) & 0xFFFF; return 3; }
    DOS_EIP = e;
    return 1;
  };
}
function dosDec_mkJmp(rel, adv) {
  return function () { DOS_EIP = (((DOS_BC_EIP0 + adv) >>> 0) + rel) & 0xFFFF; return 3; };
}
function dosDec_mkLoop(kind, rel, adv) {
  return function () {
    let e = (DOS_BC_EIP0 + adv) >>> 0;
    if (kind === 3) { if (DOS_REGS16[2] === 0) { DOS_EIP = (e + rel) & 0xFFFF; return 4; } DOS_EIP = e; return 2; }
    let c = (DOS_REGS16[2] - 1) & 0xFFFF;
    DOS_REGS16[2] = c;
    let take = 0;
    if (kind === 0) take = (c !== 0) ? 1 : 0;
    else if (kind === 1) take = (c !== 0 && dosCpu_getZF() === 1) ? 1 : 0;
    else take = (c !== 0 && dosCpu_getZF() === 0) ? 1 : 0;
    if (take === 1) { DOS_EIP = (e + rel) & 0xFFFF; return 4; }
    DOS_EIP = e;
    return 2;
  };
}

// ---------------------------------------------------------------------------
// Decode ONE instruction at the cursor.  null = the decoder does not know it.
// ---------------------------------------------------------------------------
function dosDec_one() {
  DOS_DC_TERM = 0;
  let segOvr = -1;
  let op = dosDec_u8();

  // Segment-override prefixes are FUSED into the following instruction's
  // address closure instead of costing a decode step of their own.
  let guard = 0;
  while (guard < 4) {
    guard++;
    if (op === 0x26) { segOvr = 0; op = dosDec_u8(); }
    else if (op === 0x2E) { segOvr = 1; op = dosDec_u8(); }
    else if (op === 0x36) { segOvr = 2; op = dosDec_u8(); }
    else if (op === 0x3E) { segOvr = 3; op = dosDec_u8(); }
    else break;
  }

  // 0x0F: two-byte opcodes (only the near Jcc forms here)
  if (op === 0x0F) {
    let op2 = dosDec_u8();
    if (op2 >= 0x80 && op2 <= 0x8F) {
      let r = dosDec_u16();
      if (r > 32767) r = r - 65536;
      DOS_DC_TERM = 1;
      return dosDec_mkJcc(op2 & 0x0F, r, DOS_DC - DOS_BC_ENTRY);
    }
    if (op2 === 0xAC) {                      // SHRD r/m, r, imm8
      dosDec_modrm16(segOvr);
      let g1 = dosDec_rmGet(2);
      let s1 = dosDec_rmSet(2);
      let gsrc = dosDec_mkRegGet(DOS_DM_REG, 2);
      let n = dosDec_u8() & 31;
      return dosDec_mkShrdImm(2, g1, s1, gsrc, n);
    }
    return null;
  }

  // 0x00-0x3F: the ALU block
  if (op < 0x40) {
    let lo = op & 7;
    if (lo > 5) return null;
    let aop = (op >> 3) & 7;
    let fn = dosDec_aluFn(aop);
    let store = (aop === 7) ? 0 : 1;
    if (lo === 0 || lo === 1) {
      let size = (lo === 0) ? 1 : 2;
      dosDec_modrm16(segOvr);
      if (DOS_DM_ISREG === 1) {
        if (size === 2) return dosDec_mkAluRR16(fn, DOS_DM_RM * 2, DOS_DM_REG * 2, store, 3);
        return dosDec_mkAluRR8(fn, dosDec_reg8Slot(DOS_DM_RM), dosDec_reg8Slot(DOS_DM_REG), store, 3);
      }
      return dosDec_mkAlu(fn, dosDec_rmGet(size), dosDec_mkRegGet(DOS_DM_REG, size), dosDec_rmSet(size), size, store, 3);
    }
    if (lo === 2 || lo === 3) {
      let size = (lo === 2) ? 1 : 2;
      dosDec_modrm16(segOvr);
      if (DOS_DM_ISREG === 1) {
        if (size === 2) return dosDec_mkAluRR16(fn, DOS_DM_REG * 2, DOS_DM_RM * 2, store, 3);
        return dosDec_mkAluRR8(fn, dosDec_reg8Slot(DOS_DM_REG), dosDec_reg8Slot(DOS_DM_RM), store, 3);
      }
      return dosDec_mkAlu(fn, dosDec_mkRegGet(DOS_DM_REG, size), dosDec_rmGet(size), dosDec_mkRegSet(DOS_DM_REG, size), size, store, 3);
    }
    if (lo === 4) {
      let i8 = dosDec_u8();
      return dosDec_mkAluImm(fn, dosDec_mkRegGet(0, 1), i8, dosDec_mkRegSet(0, 1), 1, store, 2);
    }
    let i16 = dosDec_u16();
    return dosDec_mkAluImm16R(fn, 0, i16, store, 2);
  }

  // 0x40-0x4F: INC / DEC r16
  if (op < 0x50) {
    if (op < 0x48) return dosDec_mkIncR16((op & 7) * 2);
    return dosDec_mkDecR16((op & 7) * 2);
  }

  // 0x50-0x5F: PUSH / POP r16
  if (op < 0x60) {
    if (op < 0x58) return dosDec_mkPush16(dosDec_mkRegGet(op & 7, 2));
    return dosDec_mkPop16(dosDec_mkRegSet(op & 7, 2));
  }

  // 0x70-0x7F: Jcc rel8  (terminator)
  if (op >= 0x70 && op < 0x80) {
    let r = dosDec_s8();
    DOS_DC_TERM = 1;
    return dosDec_mkJcc(op & 0x0F, r, DOS_DC - DOS_BC_ENTRY);
  }

  // 0x80 / 0x81 / 0x83: group 1
  if (op === 0x80 || op === 0x81 || op === 0x83) {
    dosDec_modrm16(segOvr);
    let size = (op === 0x80) ? 1 : 2;
    let aop = DOS_DM_REG;
    let fn = dosDec_aluFn(aop);
    let store = (aop === 7) ? 0 : 1;
    let imm = 0;
    if (op === 0x80) imm = dosDec_u8();
    else if (op === 0x81) imm = dosDec_u16();
    else imm = dosDec_s8() & 0xFFFF;
    if (DOS_DM_ISREG === 1 && size === 2) return dosDec_mkAluImm16R(fn, DOS_DM_RM * 2, imm, store, 3);
    return dosDec_mkAluImm(fn, dosDec_rmGet(size), imm, dosDec_rmSet(size), size, store, 3);
  }

  // 0x84 / 0x85: TEST r/m, r
  if (op === 0x84 || op === 0x85) {
    let size = (op === 0x84) ? 1 : 2;
    dosDec_modrm16(segOvr);
    return dosDec_mkTest(dosDec_rmGet(size), dosDec_mkRegGet(DOS_DM_REG, size), size, 2);
  }

  // 0x88-0x8B: MOV
  if (op >= 0x88 && op <= 0x8B) {
    let size = ((op & 1) === 0) ? 1 : 2;
    dosDec_modrm16(segOvr);
    let toReg = (op >= 0x8A) ? 1 : 0;
    if (DOS_DM_ISREG === 1) {
      let dr = (toReg === 1) ? DOS_DM_REG : DOS_DM_RM;
      let sr = (toReg === 1) ? DOS_DM_RM : DOS_DM_REG;
      if (size === 2) return dosDec_mkMovRR16(dr * 2, sr * 2);
      return dosDec_mkMovRR8(dosDec_reg8Slot(dr), dosDec_reg8Slot(sr));
    }
    if (toReg === 1) return dosDec_mkMov(dosDec_rmGet(size), dosDec_mkRegSet(DOS_DM_REG, size), 2);
    return dosDec_mkMov(dosDec_mkRegGet(DOS_DM_REG, size), dosDec_rmSet(size), 2);
  }

  // 0x90: NOP
  if (op === 0x90) return dosDec_mkNop();

  // 0xA0-0xA3: MOV to/from moffs16
  if (op >= 0xA0 && op <= 0xA3) {
    let disp = dosDec_u16();
    let sidx = (segOvr >= 0) ? segOvr : 3;
    let af = dosDec_mkAddr16(6, disp, sidx, 1);
    let size = ((op & 1) === 0) ? 1 : 2;
    if (op <= 0xA1) return dosDec_mkMov(dosDec_mkMemGet(af, size), dosDec_mkRegSet(0, size), 2);
    return dosDec_mkMov(dosDec_mkRegGet(0, size), dosDec_mkMemSet(af, size), 2);
  }

  // 0xA4-0xAF: string ops (no REP here) and accumulator TEST
  if (op >= 0xA4 && op <= 0xAF) {
    if (op === 0xA8) { let i8 = dosDec_u8(); return dosDec_mkTestImm(dosDec_mkRegGet(0, 1), i8, 1, 2); }
    if (op === 0xA9) { let i16 = dosDec_u16(); return dosDec_mkTestImm(dosDec_mkRegGet(0, 2), i16, 2, 2); }
    if (segOvr >= 0) return null;       // a source-segment override would change DS
    let size = ((op & 1) === 0) ? 1 : 2;
    if (op === 0xA4 || op === 0xA5) return dosDec_mkString(0, size);
    if (op === 0xA6 || op === 0xA7) return dosDec_mkString(4, size);
    if (op === 0xAA || op === 0xAB) return dosDec_mkString(1, size);
    if (op === 0xAC || op === 0xAD) return dosDec_mkString(2, size);
    return dosDec_mkString(3, size);
  }

  // 0xB0-0xBF: MOV r, imm
  if (op >= 0xB0 && op <= 0xBF) {
    if (op < 0xB8) { let i8 = dosDec_u8(); return dosDec_mkMovImmR8(dosDec_reg8Slot(op & 7), i8); }
    let i16 = dosDec_u16();
    return dosDec_mkMovImmR16((op & 7) * 2, i16);
  }

  // 0xC0 / 0xC1: shift group with imm8
  if (op === 0xC0 || op === 0xC1) {
    let size = (op === 0xC0) ? 1 : 2;
    dosDec_modrm16(segOvr);
    let sop = DOS_DM_REG;
    let g1 = dosDec_rmGet(size);
    let s1 = dosDec_rmSet(size);
    let cnt = dosDec_u8();
    return dosDec_mkShiftImm(sop, g1, s1, cnt, size, 3);
  }

  // 0xC6 / 0xC7: MOV r/m, imm
  if (op === 0xC6 || op === 0xC7) {
    let size = (op === 0xC6) ? 1 : 2;
    dosDec_modrm16(segOvr);
    let s1 = dosDec_rmSet(size);
    let imm = (size === 1) ? dosDec_u8() : dosDec_u16();
    return dosDec_mkMovImm(s1, imm, 2);
  }

  // 0xD0-0xD3: shift group by 1 or CL
  if (op >= 0xD0 && op <= 0xD3) {
    let size = ((op & 1) === 0) ? 1 : 2;
    dosDec_modrm16(segOvr);
    let sop = DOS_DM_REG;
    if (op < 0xD2) return dosDec_mkShiftImm(sop, dosDec_rmGet(size), dosDec_rmSet(size), 1, size, 3);
    return dosDec_mkShiftCL(sop, dosDec_rmGet(size), dosDec_rmSet(size), size, 3);
  }

  // 0xE0-0xE3: LOOPNZ / LOOPZ / LOOP / JCXZ  (terminators)
  if (op >= 0xE0 && op <= 0xE3) {
    let r = dosDec_s8();
    DOS_DC_TERM = 1;
    let adv = DOS_DC - DOS_BC_ENTRY;
    if (op === 0xE0) return dosDec_mkLoop(2, r, adv);
    if (op === 0xE1) return dosDec_mkLoop(1, r, adv);
    if (op === 0xE2) return dosDec_mkLoop(0, r, adv);
    return dosDec_mkLoop(3, r, adv);
  }

  // 0xE9 / 0xEB: JMP rel  (terminators)
  if (op === 0xE9) {
    let r = dosDec_u16();
    if (r > 32767) r = r - 65536;
    DOS_DC_TERM = 1;
    return dosDec_mkJmp(r, DOS_DC - DOS_BC_ENTRY);
  }
  if (op === 0xEB) {
    let r = dosDec_s8();
    DOS_DC_TERM = 1;
    return dosDec_mkJmp(r, DOS_DC - DOS_BC_ENTRY);
  }

  // 0xEC-0xEF: IN / OUT via DX
  if (op === 0xEC) return dosDec_mkIn8();
  if (op === 0xED) return dosDec_mkIn16();
  if (op === 0xEE) return dosDec_mkOut8();
  if (op === 0xEF) return dosDec_mkOut16();

  // flag control
  if (op === 0xF8) return dosDec_mkFlagOp(2);
  if (op === 0xF9) return dosDec_mkFlagOp(3);
  if (op === 0xFC) return dosDec_mkFlagOp(0);
  if (op === 0xFD) return dosDec_mkFlagOp(1);

  // 0xF6 / 0xF7: group 3 (TEST / NOT / NEG / MUL / IMUL / DIV / IDIV)
  if (op === 0xF6 || op === 0xF7) {
    let size = (op === 0xF6) ? 1 : 2;
    dosDec_modrm16(segOvr);
    let g3 = DOS_DM_REG;
    let isreg = DOS_DM_ISREG;
    let rm = DOS_DM_RM;
    let af = DOS_DM_AF;
    if (g3 === 0 || g3 === 1) {
      let g1 = dosDec_rmGet(size);
      let imm = (size === 1) ? dosDec_u8() : dosDec_u16();
      return dosDec_mkGrp3Test(size, g1, imm);
    }
    if (g3 === 2 || g3 === 3) return dosDec_mkGrp3Simple(g3, size, dosDec_rmGet(size), dosDec_rmSet(size));
    return dosDec_mkGrp3Wide(g3, size, isreg, rm, af);
  }

  // 0xFE / 0xFF: INC / DEC r/m (the CALL and JMP arms of group 5 are left to
  // the interpreter and simply end the block)
  if (op === 0xFE || op === 0xFF) {
    let size = (op === 0xFE) ? 1 : 2;
    dosDec_modrm16(segOvr);
    let g5 = DOS_DM_REG;
    if (g5 > 1) return null;
    return dosDec_mkIncDecRM((g5 === 0) ? 1 : 0, size, dosDec_rmGet(size), dosDec_rmSet(size));
  }

  return null;
}

function dosBc_build(slot, phys) {
  let ops = new Array(DOS_BC_MAX);
  let n = 0;
  DOS_DC = phys;
  DOS_BC_ENTRY = phys;
  let term = 0;
  while (n < DOS_BC_MAX) {
    let before = DOS_DC;
    let f = dosDec_one();
    if (f === null) {
      DOS_DC = before;
      if (n === 0) {
        // Nothing specialisable here at all: remember that, so this address is
        // never decoded again, and let the interpreter step it directly.
        DOS_BC_TAG[slot] = phys;
        DOS_BC_NUM[slot] = 0;
        DOS_BC_FN[slot] = null;
        DOS_BC_BYT[slot] = 0;
        DOS_BC_TERM[slot] = 1;
        return 1;
      }
      // Otherwise end the block with a cached hand-off to the interpreter.
      ops[n] = dosDec_mkStep(before - phys);
      n++;
      term = 1;
      break;
    }
    ops[n] = f;
    n++;
    if (DOS_DC_TERM === 1) { term = 1; break; }
  }
  if (n === 0) return 0;
  DOS_BC_TAG[slot] = phys;
  DOS_BC_FN[slot] = ops;
  DOS_BC_NUM[slot] = n;
  DOS_BC_BYT[slot] = DOS_DC - phys;
  DOS_BC_TERM[slot] = term;
  DOS_BC_BUILT++;
  // Mark every page this block's bytes span so a later write invalidates it.
  let pFirst = (phys >>> 12) & 4095;
  let pLast = ((DOS_DC - 1) >>> 12) & 4095;
  DOS_BC_CODEPAGE[pFirst] = 1;
  if (pLast !== pFirst) DOS_BC_CODEPAGE[pLast] = 1;
  // Compiled code checks one page map inline, so mark it here as well.
  if (DOS_JIT_CODEPAGE !== null) {
    DOS_JIT_CODEPAGE[pFirst] = 1;
    if (pLast !== pFirst) DOS_JIT_CODEPAGE[pLast] = 1;
  }
  return 1;
}

// ---------------------------------------------------------------------------
// The run loop: one cache probe per BLOCK, then array-read + 0-arg call per
// instruction.  Anything the decoder refused falls through to dosCpu_step().
// ---------------------------------------------------------------------------
function dosCpu_runCycles(budget) {
  let remaining = budget;
  if (DOS_BC_TAG === null) dosBc_init();
  while (remaining > 0 && !DOS_HALTED) {
    // 32-bit code is compiled rather than decoded: dos_jit.logic emits real
    // JavaScript for a run of instructions, which is worth far more here than
    // the closure-per-instruction cache this file builds for 16-bit code.
    if (DOS_IS_32 === 1) { dosJit_run(remaining); return; }
    let eip = DOS_EIP;
    let phys = (((DOS_SEGS[1] << 4) + (eip & 0xFFFF)) >>> 0) & 0xFFFFFF;
    let slot = phys & 8191;
    if (DOS_BC_TAG[slot] !== phys) {
      if (dosBc_build(slot, phys) === 0) { remaining -= dosCpu_step(); DOS_BC_STEPS++; DOS_BC_INSTR++; DOS_INT_CHECK--; if (DOS_INT_CHECK <= 0) { DOS_INT_CHECK = DOS_INT_CHECK_EVERY; dosInt_poll(); } continue; }
    }
    let num = DOS_BC_NUM[slot];
    // A stepped instruction counts toward the interrupt check too: a program
    // parked on an INT the decoder refuses would otherwise never be polled.
    if (num === 0) { remaining -= dosCpu_step(); DOS_BC_STEPS++; DOS_BC_INSTR++; DOS_INT_CHECK--; if (DOS_INT_CHECK <= 0) { DOS_INT_CHECK = DOS_INT_CHECK_EVERY; dosInt_poll(); } continue; }
    DOS_BC_EIP0 = eip;
    DOS_PREFIX_SEG = -1;
    DOS_PREFIX_REP = 0;
    let ops = DOS_BC_FN[slot];
    let cyc = 0;
    let j = 0;
    while (j < num) { cyc = cyc + ops[j](); j++; }
    if (DOS_BC_TERM[slot] === 0) DOS_EIP = (eip + DOS_BC_BYT[slot]) >>> 0;
    DOS_TOTAL_CYCLES += cyc;
    DOS_BC_HITS++;
    DOS_BC_INSTR += num;
    remaining -= cyc;
    // A block runs to completion, so a hardware interrupt is taken at the
    // block boundary rather than part-way through one.
    DOS_INT_CHECK = DOS_INT_CHECK - num;
    if (DOS_INT_CHECK <= 0) { DOS_INT_CHECK = DOS_INT_CHECK_EVERY; dosInt_poll(); }
  }
}

// Test-only: run exactly one block (or one stepped instruction) at a time
// until at least n x86 instructions have retired; returns the exact count.
function dosBcTest_run(n) {
  DOS_BC_INSTR = 0;
  DOS_BC_STEPS = 0;
  while (DOS_BC_INSTR < n && !DOS_HALTED) { dosCpu_runCycles(1); }
  return DOS_BC_INSTR;
}
