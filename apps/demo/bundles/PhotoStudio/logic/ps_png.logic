// ps_png.logic - PNG decoding and encoding as sliced jobs.
//
// Decoding accepts every PNG colour type and bit depth, interlaced or not,
// and always produces straight-alpha RGBA8. Encoding writes colour type 6 (or
// 2 when the image is fully opaque) with per-row adaptive filtering.

function psIsPng(b) { return b.length > 24 && b[0] === 137 && b[1] === 80 && b[2] === 78 && b[3] === 71 && b[4] === 13 && b[5] === 10 && b[6] === 26 && b[7] === 10; }

let PS_ADAM7_XS = [0, 4, 0, 2, 0, 1, 0];
let PS_ADAM7_YS = [0, 0, 4, 0, 2, 0, 1];
let PS_ADAM7_XSTEP = [8, 8, 4, 4, 2, 2, 1];
let PS_ADAM7_YSTEP = [8, 8, 8, 4, 4, 2, 2];

function psPngChannels(ctype) {
  if (ctype === 0) return 1;
  if (ctype === 2) return 3;
  if (ctype === 3) return 1;
  if (ctype === 4) return 2;
  if (ctype === 6) return 4;
  psFail("Unsupported PNG colour type " + ctype + ".");
  return 0;
}

function psPngParse(b) {
  if (!psIsPng(b)) psFail("Not a PNG file.");
  let info = { w: 0, h: 0, depth: 8, ctype: 6, interlace: 0, palette: null, trns: null, idat: [], idatTotal: 0 };
  let p = 8, n = b.length, sawHeader = false;
  while (p + 8 <= n) {
    let len = psU32BE(b, p);
    let type = psLatin1(b, p + 4, p + 8);
    let ds = p + 8, de = ds + len;
    if (len > 0x7fffffff || de + 4 > n) psFail("Truncated PNG chunk (" + type + ").");
    if (type === "IHDR") {
      info.w = psU32BE(b, ds); info.h = psU32BE(b, ds + 4); info.depth = b[ds + 8]; info.ctype = b[ds + 9];
      if (b[ds + 10] !== 0 || b[ds + 11] !== 0) psFail("Unsupported PNG compression or filter method.");
      info.interlace = b[ds + 12];
      sawHeader = true;
    } else if (type === "PLTE") info.palette = b.slice(ds, de);
    else if (type === "tRNS") info.trns = b.slice(ds, de);
    else if (type === "IDAT") { info.idat.push([ds, de]); info.idatTotal += len; }
    else if (type === "IEND") break;
    p = de + 4;
  }
  if (!sawHeader) psFail("PNG is missing its header.");
  if (info.w < 1 || info.h < 1) psFail("PNG has an empty image size.");
  if (info.w > 16384 || info.h > 16384 || info.w * info.h > 16 * 1024 * 1024) psFail("PNG is larger than 16 megapixels, which this edition cannot decode.");
  let d = info.depth, t = info.ctype;
  let okDepth = (t === 0 && (d === 1 || d === 2 || d === 4 || d === 8 || d === 16)) || (t === 3 && (d === 1 || d === 2 || d === 4 || d === 8)) ||
    ((t === 2 || t === 4 || t === 6) && (d === 8 || d === 16));
  if (!okDepth) psFail("Unsupported PNG bit depth " + d + " for colour type " + t + ".");
  if (t === 3 && !info.palette) psFail("Indexed PNG is missing its palette.");
  if (!info.idat.length) psFail("PNG has no image data.");
  if (info.interlace !== 0 && info.interlace !== 1) psFail("Unsupported PNG interlace method.");
  return info;
}

function psPngRowBytes(width, channels, depth) { return Math.ceil(width * channels * depth / 8); }

function psPngPasses(info) {
  let channels = psPngChannels(info.ctype);
  let passes = [];
  if (!info.interlace) {
    passes.push({ x0: 0, y0: 0, xs: 1, ys: 1, w: info.w, h: info.h, rowBytes: psPngRowBytes(info.w, channels, info.depth), offset: 0 });
  } else {
    let offset = 0;
    for (let i = 0; i < 7; i++) {
      let pw = Math.ceil((info.w - PS_ADAM7_XS[i]) / PS_ADAM7_XSTEP[i]);
      let ph = Math.ceil((info.h - PS_ADAM7_YS[i]) / PS_ADAM7_YSTEP[i]);
      if (pw <= 0 || ph <= 0) continue;
      let rb = psPngRowBytes(pw, channels, info.depth);
      passes.push({ x0: PS_ADAM7_XS[i], y0: PS_ADAM7_YS[i], xs: PS_ADAM7_XSTEP[i], ys: PS_ADAM7_YSTEP[i], w: pw, h: ph, rowBytes: rb, offset: offset });
      offset += ph * (rb + 1);
    }
  }
  return passes;
}

// Undo the row filter in place. prevRow is null for the first row of a pass.
function psPngUnfilter(raw, rowStart, prevStart, rowBytes, bpp) {
  let ftype = raw[rowStart];
  let s = rowStart + 1;
  if (ftype === 0) return;
  if (ftype === 1) {
    for (let i = bpp; i < rowBytes; i++) raw[s + i] = (raw[s + i] + raw[s + i - bpp]) & 255;
  } else if (ftype === 2) {
    if (prevStart < 0) return;
    let ps = prevStart + 1;
    for (let i = 0; i < rowBytes; i++) raw[s + i] = (raw[s + i] + raw[ps + i]) & 255;
  } else if (ftype === 3) {
    if (prevStart < 0) { for (let i = bpp; i < rowBytes; i++) raw[s + i] = (raw[s + i] + (raw[s + i - bpp] >> 1)) & 255; return; }
    let ps = prevStart + 1;
    for (let i = 0; i < bpp; i++) raw[s + i] = (raw[s + i] + (raw[ps + i] >> 1)) & 255;
    for (let i = bpp; i < rowBytes; i++) raw[s + i] = (raw[s + i] + ((raw[s + i - bpp] + raw[ps + i]) >> 1)) & 255;
  } else if (ftype === 4) {
    if (prevStart < 0) { for (let i = bpp; i < rowBytes; i++) raw[s + i] = (raw[s + i] + raw[s + i - bpp]) & 255; return; }
    let ps = prevStart + 1;
    for (let i = 0; i < bpp; i++) raw[s + i] = (raw[s + i] + raw[ps + i]) & 255;
    for (let i = bpp; i < rowBytes; i++) {
      let a = raw[s + i - bpp], b = raw[ps + i], c = raw[ps + i - bpp];
      let p = a + b - c, pa = p > a ? p - a : a - p, pb = p > b ? p - b : b - p, pc = p > c ? p - c : c - p;
      let pred = pa <= pb && pa <= pc ? a : pb <= pc ? b : c;
      raw[s + i] = (raw[s + i] + pred) & 255;
    }
  } else psFail("Corrupt PNG filter byte.");
}

// Convert one unfiltered row into RGBA at the pixels (x0 + k*xs, y).
function psPngConvertRow(info, raw, s, pass, y, out) {
  let w = pass.w, xs = pass.xs, x0 = pass.x0, W = info.w;
  let depth = info.depth, ctype = info.ctype;
  let o = (y * W + x0) * 4, stride = xs * 4;
  let trns = info.trns;
  if (ctype === 6) {
    if (depth === 8) { for (let x = 0; x < w; x++) { let i = s + x * 4; out[o] = raw[i]; out[o + 1] = raw[i + 1]; out[o + 2] = raw[i + 2]; out[o + 3] = raw[i + 3]; o += stride; } }
    else { for (let x = 0; x < w; x++) { let i = s + x * 8; out[o] = raw[i]; out[o + 1] = raw[i + 2]; out[o + 2] = raw[i + 4]; out[o + 3] = raw[i + 6]; o += stride; } }
  } else if (ctype === 2) {
    if (depth === 8) {
      let tr = -1, tg = 0, tb = 0;
      if (trns && trns.length >= 6) { tr = trns[1]; tg = trns[3]; tb = trns[5]; }
      for (let x = 0; x < w; x++) { let i = s + x * 3; let r = raw[i], g = raw[i + 1], b = raw[i + 2]; out[o] = r; out[o + 1] = g; out[o + 2] = b; out[o + 3] = (r === tr && g === tg && b === tb) ? 0 : 255; o += stride; }
    } else {
      let has = trns && trns.length >= 6;
      for (let x = 0; x < w; x++) {
        let i = s + x * 6;
        out[o] = raw[i]; out[o + 1] = raw[i + 2]; out[o + 2] = raw[i + 4];
        out[o + 3] = has && raw[i] === trns[0] && raw[i + 1] === trns[1] && raw[i + 2] === trns[2] && raw[i + 3] === trns[3] && raw[i + 4] === trns[4] && raw[i + 5] === trns[5] ? 0 : 255;
        o += stride;
      }
    }
  } else if (ctype === 4) {
    if (depth === 8) { for (let x = 0; x < w; x++) { let i = s + x * 2; let v = raw[i]; out[o] = v; out[o + 1] = v; out[o + 2] = v; out[o + 3] = raw[i + 1]; o += stride; } }
    else { for (let x = 0; x < w; x++) { let i = s + x * 4; let v = raw[i]; out[o] = v; out[o + 1] = v; out[o + 2] = v; out[o + 3] = raw[i + 2]; o += stride; } }
  } else if (ctype === 0) {
    if (depth === 8) {
      let t = trns && trns.length >= 2 ? trns[1] : -1;
      for (let x = 0; x < w; x++) { let v = raw[s + x]; out[o] = v; out[o + 1] = v; out[o + 2] = v; out[o + 3] = v === t ? 0 : 255; o += stride; }
    } else if (depth === 16) {
      let has = trns && trns.length >= 2;
      for (let x = 0; x < w; x++) { let i = s + x * 2; let v = raw[i]; out[o] = v; out[o + 1] = v; out[o + 2] = v; out[o + 3] = has && raw[i] === trns[0] && raw[i + 1] === trns[1] ? 0 : 255; o += stride; }
    } else {
      let max = (1 << depth) - 1, scale = 255 / max, mask = max;
      let t = trns && trns.length >= 2 ? trns[1] : -1;
      for (let x = 0; x < w; x++) {
        let bit = x * depth, byte = raw[s + (bit >> 3)], shift = 8 - depth - (bit & 7);
        let idx = (byte >> shift) & mask, v = Math.round(idx * scale);
        out[o] = v; out[o + 1] = v; out[o + 2] = v; out[o + 3] = idx === t ? 0 : 255; o += stride;
      }
    }
  } else {
    let pal = info.palette, palCount = (pal.length / 3) | 0;
    if (depth === 8) {
      for (let x = 0; x < w; x++) {
        let idx = raw[s + x];
        if (idx >= palCount) idx = 0;
        out[o] = pal[idx * 3]; out[o + 1] = pal[idx * 3 + 1]; out[o + 2] = pal[idx * 3 + 2]; out[o + 3] = trns && idx < trns.length ? trns[idx] : 255; o += stride;
      }
    } else {
      let mask = (1 << depth) - 1;
      for (let x = 0; x < w; x++) {
        let bit = x * depth, byte = raw[s + (bit >> 3)], shift = 8 - depth - (bit & 7);
        let idx = (byte >> shift) & mask;
        if (idx >= palCount) idx = 0;
        out[o] = pal[idx * 3]; out[o + 1] = pal[idx * 3 + 1]; out[o + 2] = pal[idx * 3 + 2]; out[o + 3] = trns && idx < trns.length ? trns[idx] : 255; o += stride;
      }
    }
  }
}

// Decode job. done(result) receives { w, h, data: Uint8Array RGBA, warnings: [] }.
function psPngDecodeJob(bytes, done, fail) {
  let info = null, passes = null, raw = null, out = null, inflater = null, expected = 0, comp = null, compStart = 0, compEnd = 0;
  let steps = [];
  steps.push(function () {
    info = psPngParse(bytes);
    passes = psPngPasses(info);
    expected = 0;
    for (let i = 0; i < passes.length; i++) expected += passes[i].h * (passes[i].rowBytes + 1);
    raw = new Uint8Array(expected);
    if (info.idat.length === 1) { comp = bytes; compStart = info.idat[0][0]; compEnd = info.idat[0][1]; }
    else {
      comp = new Uint8Array(info.idatTotal);
      let at = 0;
      for (let i = 0; i < info.idat.length; i++) { let seg = info.idat[i]; comp.set(bytes.subarray(seg[0], seg[1]), at); at += seg[1] - seg[0]; }
      compStart = 0; compEnd = info.idatTotal;
    }
    inflater = psInflateNew(comp, compStart, compEnd, true, raw);
    return true;
  });
  steps.push(function () {
    let finished = psInflateRun(inflater, inflater.olen + PS_STEP_BYTES);
    if (finished) {
      if (inflater.olen !== expected) psFail("PNG image data is incomplete.");
      out = new Uint8Array(info.w * info.h * 4);
      return true;
    }
    return inflater.olen / expected;
  });
  // One row-stepper per pass, built lazily once the pass geometry is known.
  let passIndex = 0, rowY = 0;
  steps.push(function () {
    if (passIndex >= passes.length) return true;
    let pass = passes[passIndex];
    let channels = psPngChannels(info.ctype);
    let bpp = Math.max(1, (channels * info.depth) >> 3);
    let rowsPerStep = Math.max(1, Math.floor(PS_STEP_PIXELS / Math.max(1, pass.w)));
    let y1 = Math.min(pass.h, rowY + rowsPerStep);
    for (let y = rowY; y < y1; y++) {
      let rowStart = pass.offset + y * (pass.rowBytes + 1);
      psPngUnfilter(raw, rowStart, y > 0 ? rowStart - (pass.rowBytes + 1) : -1, pass.rowBytes, bpp);
      psPngConvertRow(info, raw, rowStart + 1, pass, pass.y0 + y * pass.ys, out);
    }
    rowY = y1;
    if (rowY >= pass.h) { passIndex++; rowY = 0; }
    if (passIndex >= passes.length) return true;
    return (passIndex + rowY / pass.h) / passes.length;
  });
  psEnqueue("Decoding PNG", psSequence(steps), function () {
    raw = null; comp = null; inflater = null;
    done({ w: info.w, h: info.h, data: out, warnings: [] });
  }, fail);
}

// ---------------------------------------------------------------------------
// Encoder
// ---------------------------------------------------------------------------
function psPngChunk(writer, type, data, dataLen) {
  let len = dataLen === undefined ? data.length : dataLen;
  writer.u32be(len);
  let start = writer.len;
  writer.str(type);
  if (len) { writer.ensure(len); writer.buf.set(len === data.length ? data : data.subarray(0, len), writer.len); writer.len += len; }
  writer.u32be(psCrc32(writer.buf, start, writer.len));
}

// Encode job for straight-alpha RGBA8. done(bytes).
function psPngEncodeJob(rgba, w, h, done, fail) {
  let opaque = true, channels = 4, rowBytes = 0, raw = null, deflater = null, writer = null;
  let steps = [];
  // 1. Is the image fully opaque? Then colour type 2 saves a channel.
  steps.push(psRowStepper(h, psRowsFor(w, PS_STEP_PIXELS * 3), function (y0, y1) {
    if (!opaque) return;
    let d = rgba;
    for (let i = y0 * w * 4 + 3, end = y1 * w * 4; i < end; i += 4) { if (d[i] !== 255) { opaque = false; return; } }
  }));
  // 2. Filter rows.
  let filterRows = null;
  steps.push(function () {
    if (!filterRows) {
      channels = opaque ? 3 : 4;
      rowBytes = w * channels;
      raw = new Uint8Array(h * (rowBytes + 1));
      filterRows = psRowStepper(h, Math.max(1, Math.floor(PS_STEP_FILTER_BYTES / rowBytes)), function (y0, y1) { psPngFilterRows(rgba, w, y0, y1, channels, raw); });
    }
    return filterRows();
  });
  // 3. Deflate.
  steps.push(function () {
    if (!deflater) deflater = psDeflateNew(raw, true);
    let r = psDeflateRun(deflater, PS_STEP_DEFLATE_BYTES);
    if (r === true) { raw = null; return true; }
    return r;
  });
  // 4. Assemble chunks, one IDAT per megabyte so each CRC stays a small step.
  let compBytes = null, compAt = 0;
  steps.push(function () {
    if (!writer) {
      compBytes = psDeflateResult(deflater); deflater = null;
      writer = new PsWriter(compBytes.length + 1024);
      writer.bytes(Uint8Array.from([137, 80, 78, 71, 13, 10, 26, 10]));
      let ihdr = new PsWriter(13);
      ihdr.u32be(w).u32be(h).u8(8).u8(opaque ? 2 : 6).u8(0).u8(0).u8(0);
      psPngChunk(writer, "IHDR", ihdr.finish());
    }
    if (compAt < compBytes.length) {
      let n = Math.min(1 << 20, compBytes.length - compAt);
      psPngChunk(writer, "IDAT", compBytes.subarray(compAt, compAt + n));
      compAt += n;
      return compAt >= compBytes.length ? true : compAt / compBytes.length;
    }
    return true;
  });
  steps.push(function () { psPngChunk(writer, "IEND", new Uint8Array(0)); return true; });
  psEnqueue("Encoding PNG", psSequence(steps), function () { let result = writer.finish(); writer = null; compBytes = null; done(result); }, fail);
}

// Adaptive filtering: per row pick the filter (None, Sub, Up, Paeth) whose
// output has the smallest sum of absolute signed values.
function psPngFilterRows(rgba, w, y0, y1, channels, raw) {
  let rowBytes = w * channels, bpp = channels;
  let cur = new Uint8Array(rowBytes), prev = new Uint8Array(rowBytes);
  let cand = new Uint8Array(rowBytes);
  for (let y = y0; y < y1; y++) {
    // Gather the row's samples.
    let src = y * w * 4;
    if (channels === 4) { for (let i = 0; i < rowBytes; i++) cur[i] = rgba[src + i]; }
    else { for (let x = 0, i = 0; x < w; x++, i += 3) { cur[i] = rgba[src + x * 4]; cur[i + 1] = rgba[src + x * 4 + 1]; cur[i + 2] = rgba[src + x * 4 + 2]; } }
    if (y > 0) { let p = (y - 1) * w * 4; if (channels === 4) { for (let i = 0; i < rowBytes; i++) prev[i] = rgba[p + i]; } else { for (let x = 0, i = 0; x < w; x++, i += 3) { prev[i] = rgba[p + x * 4]; prev[i + 1] = rgba[p + x * 4 + 1]; prev[i + 2] = rgba[p + x * 4 + 2]; } } }
    // Choose the filter on a sample of the row (every third byte): the choice
    // is a heuristic anyway, and the interpreter pays for every byte examined.
    let best = 0, bestSum = 0;
    for (let i = bpp; i < rowBytes; i += 3) { let v = cur[i]; bestSum += v < 128 ? v : 256 - v; }
    let sum = 0;
    for (let i = bpp; i < rowBytes; i += 3) { let v = (cur[i] - cur[i - bpp]) & 255; sum += v < 128 ? v : 256 - v; if (sum >= bestSum) break; }
    if (sum < bestSum) { best = 1; bestSum = sum; }
    if (y > 0) {
      sum = 0;
      for (let i = bpp; i < rowBytes; i += 3) { let v = (cur[i] - prev[i]) & 255; sum += v < 128 ? v : 256 - v; if (sum >= bestSum) break; }
      if (sum < bestSum) { best = 2; bestSum = sum; }
      sum = 0;
      for (let i = bpp; i < rowBytes; i += 3) {
        let a = cur[i - bpp], b = prev[i], c = prev[i - bpp];
        let p = a + b - c, pa = p > a ? p - a : a - p, pb = p > b ? p - b : b - p, pc = p > c ? p - c : c - p;
        let pred = pa <= pb && pa <= pc ? a : pb <= pc ? b : c;
        let v = (cur[i] - pred) & 255; sum += v < 128 ? v : 256 - v; if (sum >= bestSum) break;
      }
      if (sum < bestSum) { best = 4; bestSum = sum; }
    }
    let o = y * (rowBytes + 1);
    raw[o] = best;
    o++;
    if (best === 0) { for (let i = 0; i < rowBytes; i++) raw[o + i] = cur[i]; }
    else if (best === 1) { for (let i = 0; i < rowBytes; i++) raw[o + i] = (cur[i] - (i >= bpp ? cur[i - bpp] : 0)) & 255; }
    else if (best === 2) { for (let i = 0; i < rowBytes; i++) raw[o + i] = (cur[i] - prev[i]) & 255; }
    else {
      for (let i = 0; i < rowBytes; i++) {
        let a = i >= bpp ? cur[i - bpp] : 0, b = prev[i], c = i >= bpp ? prev[i - bpp] : 0;
        let p = a + b - c, pa = p > a ? p - a : a - p, pb = p > b ? p - b : b - p, pc = p > c ? p - c : c - p;
        raw[o + i] = (cur[i] - (pa <= pb && pa <= pc ? a : pb <= pc ? b : c)) & 255;
      }
    }
  }
}
