  bookshelf: { label: "Bookshelf", icon: "📚", group: "Living", w: 1.0, d: 0.35, accent: WOOD, build: function (p, c) {
    let out = [bx(p + "s1", -0.49, 0.9, 0, 0.02, 1.8, 0.35, c), bx(p + "s2", 0.49, 0.9, 0, 0.02, 1.8, 0.35, c), bx(p + "bk", 0, 0.9, -0.165, 1.0, 1.8, 0.02, c)];
