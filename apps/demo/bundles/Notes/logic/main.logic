// Client-side logic for the Notes app
// Uses softn.net.fetch() to call the server HTTP API endpoints
// Server handles all CRUD operations via db bridge

let notes = []
let newTitle = ""
let newContent = ""
let noteCount = 0
let searchQuery = ""
let serverUrl = "http://localhost:9876"

function addNote() {
  if (!newTitle) return
  let noteData = {
    title: newTitle,
    content: newContent,
    createdAt: new Date().toISOString()
  }
  softn.net.fetch(serverUrl + "/api/create-note", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: noteData
  }, function(result) {
    if (result.ok) {
      newTitle = ""
      newContent = ""
      refreshNotes()
    }
  })
}

function deleteNote(id) {
  softn.net.fetch(serverUrl + "/api/delete-note", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: { id: id }
  }, function(result) {
    refreshNotes()
  })
}

function refreshNotes() {
  softn.net.fetch(serverUrl + "/api/notes", {}, function(result) {
    if (result.ok) {
      let data = JSON.parse(result.body)
      notes = data.notes
      noteCount = data.count
    }
  })
}

function getFilteredNotes() {
  if (!searchQuery) return notes
  let q = searchQuery.toLowerCase()
  let filtered = []
  for (let i = 0; i < notes.length; i = i + 1) {
    let note = notes[i]
    let title = note.data.title ? note.data.title.toLowerCase() : ""
    let content = note.data.content ? note.data.content.toLowerCase() : ""
    if (title.indexOf(q) >= 0 || content.indexOf(q) >= 0) {
      filtered.push(note)
    }
  }
  return filtered
}

function formatDate(isoString) {
  if (!isoString) return ""
  let d = new Date(isoString)
  let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
  let month = months[d.getMonth()]
  let day = d.getDate()
  let hours = d.getHours()
  let mins = d.getMinutes()
  let ampm = "AM"
  if (hours >= 12) ampm = "PM"
  if (hours > 12) hours = hours - 12
  if (hours === 0) hours = 12
  let minStr = mins < 10 ? "0" + mins : "" + mins
  return month + " " + day + " at " + hours + ":" + minStr + " " + ampm
}

function _init() {
  refreshNotes()
}
