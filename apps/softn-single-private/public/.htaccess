Options -Indexes -MultiViews
DirectoryIndex index.php
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
# The library is included by index.php; it is not an entry point.
<FilesMatch "^softn-serve\.php$">
    Require all denied
</FilesMatch>
# Nothing of the private directory belongs here, and if it is copied here by
# mistake it must still not be downloadable.
<FilesMatch "\.(softn|key|cache)$">
    Require all denied
</FilesMatch>
# FilesMatch sees a file's own name and no folder of its path: it refuses .env
# and not .git/config. /.well-known/ stays, for a certificate's challenge. The
# second line is what a backup leaves here.
<IfModule mod_alias.c>
    RedirectMatch 404 "/\.(?!well-known(?:/|$))"
    RedirectMatch 404 "(?i)(?:/config\.json|\.(?:bak|old|orig|save|sql(?:\.gz)?|sqlite3?(?:-wal|-shm)?|db|tar|tar\.gz|tgz|zip))$"
</IfModule>
AddType application/wasm .wasm
AddType text/javascript .mjs
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # The same cross-origin isolation softn.com sends for this shell.
    # credentialless rather than require-corp, so images and model files from
    # other origins keep working without CORP headers. An app must behave the
    # same here as on the site. index.php sends these itself, for a host that
    # reads no .htaccess, so its copies go first: a browser ignores a policy
    # that arrives twice, and "always" does not replace what PHP sent.
    Header unset Cross-Origin-Opener-Policy
    Header unset Cross-Origin-Embedder-Policy
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "credentialless"
    # Fingerprinted build assets are immutable for a year.
    <FilesMatch "-(?:[A-Za-z0-9_-]{8}|[0-9a-f]{12})\.(?:css|js|mjs|wasm|woff2?|ttf|png|jpe?g|gif|webp|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Content-addressed container runtime folders are immutable for a year.
    <If "%{REQUEST_URI} =~ m#/container-runtime/[0-9a-f]{12}/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    # The service worker may control the whole directory and must never be stale.
    <FilesMatch "^sw\.js$">
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/wasm image/svg+xml
</IfModule>
