function onStart() {
    console.log("TestApp server started!");

    // Test env bridge
    let path = env.get("PATH");
    if (path) {
        console.log("env.get PATH works (length " + path.length + ")");
    }

    // Test fs bridge
    fs.writeFile("test.txt", "hello from FormLogic");
    if (fs.exists("test.txt")) {
        let content = fs.readFile("test.txt");
        console.log("fs roundtrip: " + content);
        fs.deleteFile("test.txt");
        console.log("fs.deleteFile OK");
    }

    // Create some test data
    db.create("notes", '{"title": "Welcome", "body": "First note"}');
    console.log("Created initial note");
}

function hello(request) {
    let name = "world";
    if (request.query && request.query.name) {
        name = request.query.name;
    }
    return { status: 200, body: { message: "Hello " + name + "!" } };
}

function getNotes(request) {
    let notes = db.query("notes");
    return { status: 200, body: notes };
}

function createNote(request) {
    let data = request.body;
    let record = db.create("notes", JSON.stringify(data));
    return { status: 201, body: record };
}

function onBeforeSync(op) {
    console.log("onBeforeSync: " + op.operation + " on " + op.collection);
    if (op.operation === "delete") {
        console.log("Rejecting delete operation");
        return false;
    }
    return true;
}

function onAfterSync(op) {
    console.log("onAfterSync: " + op.operation + " on " + op.collection + " id=" + op.recordId);
}

function errorHandler(request) {
    let x = null;
    return x.foo;
}

function echoQuery(request) {
    return { status: 200, body: request.query };
}
