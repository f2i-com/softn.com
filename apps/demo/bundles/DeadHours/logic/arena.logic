// Dead Hours — the arena: a fenced yard at night, its obstacles as a blocker
// list the player and the dead both slide along, the static scenery those
// blockers are drawn as, and the ray tests a shot needs.

let ARENA = 24            // half-size: the yard runs from -ARENA to +ARENA
let blockers = []         // { x0, z0, x1, z1, h, soft } axis-aligned, in metres; `soft` ones are for walking only
let obbs = []             // { x, z, rot, hl, hw, y0, y1 } turned boxes that shots test against
let gates = []            // { x, z } where the dead come in
let lampPosts = []        // { x, z }
let sceneStatic = []

function addBlocker(x0, z0, x1, z1, h, soft) {
  blockers.push({ x0: x0, z0: z0, x1: x1, z1: z1, h: h, soft: !!soft })
}

// A box turned by `rot` about Y, `hl` half its length along (cos rot, -sin rot)
// and `hw` half its width along (sin rot, cos rot), between heights y0 and y1.
function addObb(x, z, rot, hl, hw, y0, y1) {
  obbs.push({ x: x, z: z, rot: rot, hl: hl, hw: hw, y0: y0, y1: y1, lx: Math.cos(rot), lz: -Math.sin(rot), wx: Math.sin(rot), wz: Math.cos(rot) })
}

function box(id, x, y, z, w, h, d, color, extra) {
  let o = { id: id, type: "box", position: { x: x, y: y, z: z }, width: w, height: h, depth: d, color: color, roughness: 0.85, metalness: 0.05 }
  if (extra) {
    if (extra.rot !== undefined) { o.rotation = { x: 0, y: extra.rot, z: 0 } }
    if (extra.emissive) { o.emissive = extra.emissive; o.emissiveIntensity = extra.emissiveIntensity || 1 }
    if (extra.opacity !== undefined) { o.opacity = extra.opacity }
    if (extra.metal !== undefined) { o.metalness = extra.metal }
    if (extra.rough !== undefined) { o.roughness = extra.rough }
    if (extra.texture) { o.texture = extra.texture }
    if (extra.textureRepeat) { o.textureRepeat = extra.textureRepeat }
    if (extra.bumpScale) { o.bumpScale = extra.bumpScale }
  }
  return o
}

function cyl(id, x, y, z, r, h, color, extra) {
  let o = { id: id, type: "cylinder", position: { x: x, y: y, z: z }, radius: r, height: h, color: color, roughness: 0.8 }
  if (extra) {
    if (extra.texture) { o.texture = extra.texture }
    if (extra.metal !== undefined) { o.metalness = extra.metal }
    if (extra.rough !== undefined) { o.roughness = extra.rough }
  }
  return o
}

// ---- Building the yard ---------------------------------------------------

function crateAt(out, id, x, z, size, rot) {
  let s = size || 1.1
  out.push(box(id, x, s / 2, z, s, s, s, "#7a5a36", { rot: rot || 0, texture: "wood" }))
  out.push(box(id + "b", x, s + 0.01, z, s * 0.82, 0.03, s * 0.82, "#5a3f22", { rot: rot || 0, texture: "wood" }))
  addBlocker(x - s * 0.62, z - s * 0.62, x + s * 0.62, z + s * 0.62, s, true)
  addObb(x, z, rot || 0, s / 2, s / 2, 0, s)
}

function barrelAt(out, id, x, z) {
  out.push(cyl(id, x, 0.55, z, 0.42, 1.1, "#4a4f55", { texture: "rust" }))
  out.push({ id: id + "r", type: "torus", position: { x: x, y: 0.75, z: z }, rotation: { x: Math.PI / 2, y: 0, z: 0 }, radius: 0.43, tube: 0.03, color: "#2f353c", texture: "metal" })
  addBlocker(x - 0.45, z - 0.45, x + 0.45, z + 0.45, 1.1)
}

function carAt(out, id, x, z, rot, color) {
  // The body is turned by `rot` about Y. In world terms its length axis is
  // (cos rot, -sin rot) and its width axis (sin rot, cos rot); every part is
  // placed along those two, so the wheels stay under the car it belongs to.
  let c = Math.cos(rot)
  let s = Math.sin(rot)
  let lx = c
  let lz = -s
  let wx = s
  let wz = c
  out.push(box(id + "b", x, 0.62, z, 4.4, 0.75, 2.0, color, { rot: rot, metal: 0.4, rough: 0.5 }))
  out.push(box(id + "c", x - lx * 0.2, 1.28, z - lz * 0.2, 2.2, 0.62, 1.8, "#1c2026", { rot: rot, metal: 0.2, rough: 0.35 }))
  let wheels = [[1.5, 1.0], [1.5, -1.0], [-1.5, 1.0], [-1.5, -1.0]]
  let i = 0
  while (i < 4) {
    let px = x + lx * wheels[i][0] + wx * wheels[i][1]
    let pz = z + lz * wheels[i][0] + wz * wheels[i][1]
    // A cylinder stands on Y; tipped by x = PI/2 after a turn of -rot about
    // Z, its axle lies along the car's width.
    out.push({ id: id + "w" + i, type: "cylinder", position: { x: px, y: 0.36, z: pz }, rotation: { x: Math.PI / 2, y: 0, z: -rot }, radius: 0.36, height: 0.3, color: "#15181c", roughness: 0.9 })
    i = i + 1
  }
  // Headlights at the front, dead but for a glow.
  out.push(box(id + "h1", x + lx * 2.21 + wx * 0.7, 0.7, z + lz * 2.21 + wz * 0.7, 0.05, 0.2, 0.4, "#ffe9b0", { rot: rot, emissive: "#ffd27a", emissiveIntensity: 0.6 }))
  out.push(box(id + "h2", x + lx * 2.21 - wx * 0.7, 0.7, z + lz * 2.21 - wz * 0.7, 0.05, 0.2, 0.4, "#ffe9b0", { rot: rot, emissive: "#ffd27a", emissiveIntensity: 0.6 }))
  // A car at an angle gets a blocker box big enough to cover its corners.
  let ex = Math.abs(c) * 2.3 + Math.abs(s) * 1.1
  let ez = Math.abs(s) * 2.3 + Math.abs(c) * 1.1
  addBlocker(x - ex, z - ez, x + ex, z + ez, 1.5, true)
  // Shots meet the bodywork itself: the body and the cabin as turned boxes.
  addObb(x, z, rot, 2.2, 1.0, 0.24, 1.0)
  addObb(x - lx * 0.2, z - lz * 0.2, rot, 1.1, 0.9, 0.97, 1.59)
}

function lampAt(out, id, x, z) {
  out.push(cyl(id + "p", x, 2.3, z, 0.08, 4.6, "#3a4048"))
  out.push(box(id + "a", x, 4.5, z, 0.7, 0.12, 0.3, "#3a4048"))
  out.push(box(id + "l", x, 4.38, z, 0.5, 0.14, 0.24, "#fff3c4", { emissive: "#ffe08a", emissiveIntensity: 2.5 }))
  addBlocker(x - 0.15, z - 0.15, x + 0.15, z + 0.15, 4.6)
  lampPosts.push({ x: x, z: z })
}

function shedAt(out, id, x, z, w, d, h, color) {
  out.push(box(id, x, h / 2, z, w, h, d, color, { texture: "wood", textureRepeat: { x: 3, y: 2 } }))
  out.push(box(id + "r", x, h + 0.25, z, w + 0.6, 0.5, d + 0.6, "#2b2f36", { texture: "tile", textureRepeat: { x: 4, y: 4 } }))
  out.push(box(id + "d", x, 1.0, z + d / 2 + 0.02, 1.1, 2.0, 0.06, "#4a3a2a", { texture: "wood" }))
  out.push(box(id + "w", x + w * 0.3, 1.6, z + d / 2 + 0.02, 0.9, 0.7, 0.04, "#1a2130", { emissive: "#243a5a", emissiveIntensity: 0.4 }))
  addBlocker(x - w / 2, z - d / 2, x + w / 2, z + d / 2, h)
}

function graveAt(out, id, x, z, rot) {
  out.push(box(id, x, 0.45, z, 0.6, 0.9, 0.14, "#6b7078", { rot: rot, texture: "stone" }))
  out.push({ id: id + "t", type: "cylinder", position: { x: x, y: 0.9, z: z }, rotation: { x: Math.PI / 2, y: 0, z: rot }, radius: 0.3, height: 0.14, color: "#6b7078", texture: "stone" })
  addBlocker(x - 0.32, z - 0.15, x + 0.32, z + 0.15, 0.9)
}

function fenceRun(out, id, x0, z0, x1, z1) {
  let dx = x1 - x0
  let dz = z1 - z0
  let len = Math.sqrt(dx * dx + dz * dz)
  let n = Math.max(1, Math.round(len / 2.4))
  let rot = Math.atan2(dx, dz)
  let i = 0
  while (i <= n) {
    let t = i / n
    out.push(cyl(id + "p" + i, x0 + dx * t, 0.7, z0 + dz * t, 0.07, 1.4, "#3d3229"))
    i = i + 1
  }
  out.push(box(id + "r1", (x0 + x1) / 2, 1.15, (z0 + z1) / 2, 0.08, 0.1, len, "#4a3d31", { rot: rot }))
  out.push(box(id + "r2", (x0 + x1) / 2, 0.55, (z0 + z1) / 2, 0.08, 0.1, len, "#4a3d31", { rot: rot }))
  // A chain-link mesh between the rails, drawn as a thin translucent sheet.
  out.push(box(id + "m", (x0 + x1) / 2, 0.85, (z0 + z1) / 2, 0.02, 0.62, len, "#8d98a5", { rot: rot, opacity: 0.22 }))
}

function buildArena() {
  blockers = []
  obbs = []
  gates = []
  lampPosts = []
  let out = []
  let A = ARENA
  out.push({ id: "ground", type: "plane", position: { x: 0, y: 0, z: 0 }, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 400, height: 400, color: "#1f2621", texture: "grass", textureRepeat: { x: 130, y: 130 }, roughness: 0.95, bumpScale: 0.03 })
  // Worn paths across the yard.
  out.push({ id: "path1", type: "plane", position: { x: 0, y: 0.01, z: 0 }, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: 3.2, height: A * 2, color: "#383731", texture: "sand", textureRepeat: { x: 2, y: 20 }, roughness: 0.85 })
  out.push({ id: "path2", type: "plane", position: { x: 0, y: 0.01, z: 0 }, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, width: A * 2, height: 3.2, color: "#383731", texture: "sand", textureRepeat: { x: 20, y: 2 }, roughness: 0.85 })

  // Fences with a gate in the middle of each side.
  let g = 3.2
  fenceRun(out, "fN1", -A, -A, -g, -A)
  fenceRun(out, "fN2", g, -A, A, -A)
  fenceRun(out, "fS1", -A, A, -g, A)
  fenceRun(out, "fS2", g, A, A, A)
  fenceRun(out, "fW1", -A, -A, -A, -g)
  fenceRun(out, "fW2", -A, g, -A, A)
  fenceRun(out, "fE1", A, -A, A, -g)
  fenceRun(out, "fE2", A, g, A, A)
  gates.push({ x: 0, z: -A - 2 })
  gates.push({ x: 0, z: A + 2 })
  gates.push({ x: -A - 2, z: 0 })
  gates.push({ x: A + 2, z: 0 })
  // Fence blockers: the four sides minus the gates.
  addBlocker(-A - 0.2, -A - 0.2, -g, -A + 0.2, 1.4)
  addBlocker(g, -A - 0.2, A + 0.2, -A + 0.2, 1.4)
  addBlocker(-A - 0.2, A - 0.2, -g, A + 0.2, 1.4)
  addBlocker(g, A - 0.2, A + 0.2, A + 0.2, 1.4)
  addBlocker(-A - 0.2, -A - 0.2, -A + 0.2, -g, 1.4)
  addBlocker(-A - 0.2, g, -A + 0.2, A + 0.2, 1.4)
  addBlocker(A - 0.2, -A - 0.2, A + 0.2, -g, 1.4)
  addBlocker(A - 0.2, g, A + 0.2, A + 0.2, 1.4)

  // Lamps at the corners of the crossroads and by the shed.
  lampAt(out, "lampA", -6, -6)
  lampAt(out, "lampB", 6, 6)
  lampAt(out, "lampC", 14, -12)
  lampAt(out, "lampD", -14, 12)

  shedAt(out, "shed", -13, -14, 7, 5, 3.2, "#3d4a55")
  carAt(out, "car1", 10, -4, 0.5, "#7a2e2e")
  carAt(out, "car2", -9, 9, -1.2, "#2e4c7a")
  carAt(out, "car3", 15, 14, 2.4, "#6a6f5a")

  crateAt(out, "cr1", 4, -12, 1.2, 0.2)
  crateAt(out, "cr2", 5.3, -12.2, 1.0, -0.3)
  crateAt(out, "cr3", 4.6, -10.9, 1.1, 0.7)
  crateAt(out, "cr4", -4, 14, 1.3, 0.1)

  // The night: a star field and a moon, both beyond the fog's reach and
  // told to ignore it.
  let stars = []
  let sseed = 4242
  let k = 0
  while (k < 420) {
    sseed = (sseed * 48271) % 2147483647
    let u = sseed / 2147483647
    sseed = (sseed * 48271) % 2147483647
    let v = sseed / 2147483647
    let az = u * Math.PI * 2
    let el = 0.08 + v * v * 1.3
    let R = 170
    stars.push(Math.cos(az) * Math.cos(el) * R, Math.sin(el) * R, Math.sin(az) * Math.cos(el) * R)
    k = k + 1
  }
  out.push({ id: "stars", type: "particles", particlePositions: stars, particleSize: 1.1, color: "#dfe7ff", opacity: 0.9, fog: false })
  out.push({ id: "moon2", type: "sphere", position: { x: -95, y: 78, z: -140 }, radius: 7, color: "#0b0f1a", emissive: "#e6ebf8", emissiveIntensity: 2.2, fog: false, castShadow: false })
  crateAt(out, "cr5", 16, 3, 1.1, 0.4)
  crateAt(out, "cr6", -17, -3, 1.2, -0.6)
  barrelAt(out, "br1", 7, 12)
  barrelAt(out, "br2", 7.9, 12.4)
  barrelAt(out, "br3", -12, -6)
  barrelAt(out, "br4", 12, 9)

  graveAt(out, "gv1", -16, 17, 0.1)
  graveAt(out, "gv2", -17.5, 18, -0.2)
  graveAt(out, "gv3", -19, 16.5, 0.3)
  graveAt(out, "gv4", 18, -17, 0.15)
  graveAt(out, "gv5", 19.5, -18.5, -0.1)

  // A scattering of dead trees outside the fence, for the fog to catch.
  let i = 0
  while (i < 18) {
    let ang = i / 18 * Math.PI * 2
    let r = A + 6 + (i % 3) * 3
    let tx = Math.cos(ang) * r
    let tz = Math.sin(ang) * r
    out.push(cyl("tree" + i, tx, 2.2, tz, 0.22, 4.4, "#2a2622"))
    out.push(box("treeb" + i, tx + 0.5, 3.6, tz, 1.4, 0.16, 0.16, "#2a2622", { rot: ang }))
    out.push(box("treec" + i, tx - 0.4, 3.0, tz, 1.1, 0.14, 0.14, "#2a2622", { rot: ang + 1.3 }))
    i = i + 1
  }
  sceneStatic = out
}

// ---- Movement against the blockers ---------------------------------------

function circleBlocked(x, z, r) {
  let i = 0
  while (i < blockers.length) {
    let b = blockers[i]
    if (x + r > b.x0 && x - r < b.x1 && z + r > b.z0 && z - r < b.z1) { return true }
    i = i + 1
  }
  return false
}

// Slide a circle by (dx, dz), one axis at a time. Returns the new position
// through moveX / moveZ.
let moveX = 0
let moveZ = 0
function slide(x, z, dx, dz, r) {
  let nx = x + dx
  if (!circleBlocked(nx, z, r)) { x = nx }
  let nz = z + dz
  if (!circleBlocked(x, nz, r)) { z = nz }
  moveX = x
  moveZ = z
}

// ---- Rays -----------------------------------------------------------------

// The first thing a ray hits, blocker or ground: distance, the face's
// normal, and whether it is the ground. Null when it flies off.
let hitT = 0
let hitNx = 0
let hitNy = 0
let hitNz = 0
let hitGround = false
// A ray against a turned box, in the box's own frame. Sets obbN* to the
// world normal of the face it enters. Returns the distance or -1.
let obbNx = 0
let obbNy = 0
let obbNz = 0
function rayObb(ox, oy, oz, dx, dy, dz, b) {
  let px = ox - b.x
  let pz = oz - b.z
  let ou = px * b.lx + pz * b.lz
  let ov = px * b.wx + pz * b.wz
  let du = dx * b.lx + dz * b.lz
  let dv = dx * b.wx + dz * b.wz
  let t = rayAabb(ou, oy, ov, du, dy, dv, -b.hl, b.y0, -b.hw, b.hl, b.y1, b.hw)
  if (t < 0) { return -1 }
  let hu = ou + du * t
  let hy = oy + dy * t
  let hv = ov + dv * t
  let d1 = Math.abs(hu + b.hl), d2 = Math.abs(hu - b.hl), d3 = Math.abs(hv + b.hw), d4 = Math.abs(hv - b.hw), d5 = Math.abs(hy - b.y1), d6 = Math.abs(hy - b.y0)
  let m = Math.min(d1, Math.min(d2, Math.min(d3, Math.min(d4, Math.min(d5, d6)))))
  let nu = 0, nv = 0
  obbNy = 0
  if (m === d1) { nu = -1 } else if (m === d2) { nu = 1 } else if (m === d3) { nv = -1 } else if (m === d4) { nv = 1 } else if (m === d5) { obbNy = 1 } else { obbNy = -1 }
  obbNx = nu * b.lx + nv * b.wx
  obbNz = nu * b.lz + nv * b.wz
  return t
}

function rayBlockerHit(ox, oy, oz, dx, dy, dz) {
  let best = 1e9
  let bb = null
  let i = 0
  while (i < blockers.length) {
    let b = blockers[i]
    if (!b.soft) {
      let t = rayAabb(ox, oy, oz, dx, dy, dz, b.x0, 0, b.z0, b.x1, b.h, b.z1)
      if (t >= 0 && t < best) { best = t; bb = b }
    }
    i = i + 1
  }
  let onx = 0, ony = 0, onz = 0
  let viaObb = false
  i = 0
  while (i < obbs.length) {
    let t = rayObb(ox, oy, oz, dx, dy, dz, obbs[i])
    if (t >= 0 && t < best) { best = t; bb = null; viaObb = true; onx = obbNx; ony = obbNy; onz = obbNz }
    i = i + 1
  }
  hitGround = false
  if (dy < -0.0001) {
    let tg = -oy / dy
    if (tg >= 0 && tg < best) { best = tg; bb = null; hitGround = true }
  }
  if (best > 1e8) { return false }
  hitT = best
  if (hitGround) { hitNx = 0; hitNy = 1; hitNz = 0; return true }
  if (viaObb) { hitNx = onx; hitNy = ony; hitNz = onz; return true }
  // Which face: the one the hit point is closest to.
  let hx = ox + dx * best
  let hy = oy + dy * best
  let hz = oz + dz * best
  let dl = Math.abs(hx - bb.x0)
  let dr = Math.abs(hx - bb.x1)
  let dn = Math.abs(hz - bb.z0)
  let df = Math.abs(hz - bb.z1)
  let dt = Math.abs(hy - bb.h)
  let m = Math.min(dl, Math.min(dr, Math.min(dn, Math.min(df, dt))))
  hitNx = 0; hitNy = 0; hitNz = 0
  if (m === dl) { hitNx = -1 } else if (m === dr) { hitNx = 1 } else if (m === dn) { hitNz = -1 } else if (m === df) { hitNz = 1 } else { hitNy = 1 }
  return true
}

// Distance along a ray to the first blocker it enters, or a large number.
function rayBlockerDist(ox, oy, oz, dx, dy, dz) {
  let best = 1e9
  let i = 0
  while (i < blockers.length) {
    let b = blockers[i]
    if (!b.soft) {
      let t = rayAabb(ox, oy, oz, dx, dy, dz, b.x0, 0, b.z0, b.x1, b.h, b.z1)
      if (t >= 0 && t < best) { best = t }
    }
    i = i + 1
  }
  i = 0
  while (i < obbs.length) {
    let t = rayObb(ox, oy, oz, dx, dy, dz, obbs[i])
    if (t >= 0 && t < best) { best = t }
    i = i + 1
  }
  return best
}

function rayAabb(ox, oy, oz, dx, dy, dz, x0, y0, z0, x1, y1, z1) {
  let tmin = -1e9
  let tmax = 1e9
  if (dx !== 0) {
    let a = (x0 - ox) / dx
    let b = (x1 - ox) / dx
    if (a > b) { let s = a; a = b; b = s }
    if (a > tmin) { tmin = a }
    if (b < tmax) { tmax = b }
  } else if (ox < x0 || ox > x1) { return -1 }
  if (dy !== 0) {
    let a = (y0 - oy) / dy
    let b = (y1 - oy) / dy
    if (a > b) { let s = a; a = b; b = s }
    if (a > tmin) { tmin = a }
    if (b < tmax) { tmax = b }
  } else if (oy < y0 || oy > y1) { return -1 }
  if (dz !== 0) {
    let a = (z0 - oz) / dz
    let b = (z1 - oz) / dz
    if (a > b) { let s = a; a = b; b = s }
    if (a > tmin) { tmin = a }
    if (b < tmax) { tmax = b }
  } else if (oz < z0 || oz > z1) { return -1 }
  if (tmax < 0 || tmin > tmax) { return -1 }
  return tmin < 0 ? 0 : tmin
}

function raySphere(ox, oy, oz, dx, dy, dz, cx, cy, cz, r) {
  let lx = cx - ox
  let ly = cy - oy
  let lz = cz - oz
  let tca = lx * dx + ly * dy + lz * dz
  if (tca < 0) { return -1 }
  let d2 = lx * lx + ly * ly + lz * lz - tca * tca
  if (d2 > r * r) { return -1 }
  return tca - Math.sqrt(r * r - d2)
}
