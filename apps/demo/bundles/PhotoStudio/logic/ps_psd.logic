}
function psIsPsd(b) { return b.length > 26 && b[0] === 56 && b[1] === 66 && b[2] === 80 && b[3] === 83; }

class PsCursor {
  constructor(bytes, start, end) { this.b = bytes; this.pos = start || 0; this.end = end === undefined ? bytes.length : end; }
  get remaining() { return this.end - this.pos; }
  need(n) { if (!Number.isSafeInteger(n) || n < 0 || n > this.end - this.pos) psFail("Truncated or invalid PSD section length."); }
  u8() { this.need(1); return this.b[this.pos++]; }
  u16() { this.need(2); let v = psU16BE(this.b, this.pos); this.pos += 2; return v; }
  i16() { this.need(2); let v = psI16BE(this.b, this.pos); this.pos += 2; return v; }
  u32() { this.need(4); let v = psU32BE(this.b, this.pos); this.pos += 4; return v; }
  i32() { this.need(4); let v = psI32BE(this.b, this.pos); this.pos += 4; return v; }
