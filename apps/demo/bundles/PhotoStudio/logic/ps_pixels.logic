// Single-channel resample (masks): nearest for speed with bilinear when upscaling.
function psResampleMaskRows(src, sw, sh, dst, dw, dh, y0, y1) {
  let sxScale = sw / dw, syScale = sh / dh;
  for (let y = y0; y < y1; y++) {
    let fy = (y + 0.5) * syScale - 0.5; if (fy < 0) fy = 0;
    let iy = Math.floor(fy); if (iy > sh - 1) iy = sh - 1;
    let iy1 = iy + 1 < sh ? iy + 1 : iy; let wy = fy - iy;
    for (let x = 0; x < dw; x++) {
      let fx = (x + 0.5) * sxScale - 0.5; if (fx < 0) fx = 0;
      let ix = Math.floor(fx); if (ix > sw - 1) ix = sw - 1;
      let ix1 = ix + 1 < sw ? ix + 1 : ix; let wx = fx - ix;
      let v = src[iy * sw + ix] * (1 - wx) * (1 - wy) + src[iy * sw + ix1] * wx * (1 - wy) + src[iy1 * sw + ix] * (1 - wx) * wy + src[iy1 * sw + ix1] * wx * wy;
