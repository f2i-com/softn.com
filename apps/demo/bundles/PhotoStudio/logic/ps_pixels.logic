function psUnpremultiplyRows(data, w, y0, y1) {
  for (let i = y0 * w * 4, end = y1 * w * 4; i < end; i += 4) {
    let a = data[i + 3];
    if (a === 255 || a === 0) continue;
    let r = (data[i] * 255 + (a >> 1)) / a | 0, g = (data[i + 1] * 255 + (a >> 1)) / a | 0, b = (data[i + 2] * 255 + (a >> 1)) / a | 0;
