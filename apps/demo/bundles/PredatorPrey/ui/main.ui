<logic src="../logic/main.logic" />

<style>
.pp-root {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #022c22;
  overflow: hidden;
  user-select: none;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.pp-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 16px;
  background: rgba(2, 44, 34, 0.95);
  border-bottom: 1px solid rgba(52, 211, 153, 0.22);
  z-index: 10;
  flex-shrink: 0;
  gap: 8px;
}

.pp-badge {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #047857;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #34d399;
  box-shadow: 0 0 10px rgba(52, 211, 153, 0.4);
  font-size: 16px;
  flex-shrink: 0;
}

.pp-viewport {
  flex: 1;
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

.pp-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 16px;
  background: rgba(2, 44, 34, 0.95);
  border-top: 1px solid rgba(52, 211, 153, 0.2);
  z-index: 10;
  flex-shrink: 0;
  gap: 8px;
  flex-wrap: wrap;
}

.pp-row {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.pp-card {
  background: rgba(2, 44, 34, 0.88);
  padding: 8px 12px;
  border-radius: 8px;
  border: 1px solid rgba(52, 211, 153, 0.25);
  backdrop-filter: blur(8px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
}

.pp-tip {
  position: absolute;
  top: 12px;
  left: 14px;
  max-width: 480px;
  pointer-events: none;
  z-index: 5;
}

.pp-graph-panel {
  position: absolute;
  bottom: 14px;
  left: 14px;
  width: 290px;
  z-index: 5;
}

.pp-inspector {
  position: absolute;
  top: 12px;
  right: 14px;
  width: 250px;
  z-index: 5;
}

.pp-minimap {
  position: absolute;
  bottom: 14px;
  right: 14px;
  width: 168px;
  padding: 8px;
  z-index: 5;
}

.pp-map {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid rgba(52, 211, 153, 0.35);
  background: #3f8a34;
  background-image: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.08), rgba(0,0,0,0.12));
}

.pp-map-zone {
  position: absolute;
  border-radius: 40%;
}

.pp-map-dot {
  position: absolute;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 2px rgba(0,0,0,0.7);
}

@media (max-width: 860px) {
  .pp-header {
    padding: 6px 10px;
  }
  .pp-sub {
    display: none;
  }
  .pp-bottom {
    padding: 6px 10px;
    justify-content: center;
  }
  .pp-graph-panel {
    display: none;
  }
  .pp-minimap {
    display: none;
  }
}

@media (max-width: 640px) {
  .pp-tip {
    display: none;
  }
  .pp-inspector {
    display: none;
  }
}
</style>

<Box className="pp-root">
  <Loop interval={33} running={true} @tick={gameStep} />

  <!-- Top Header Bar -->
  <Box className="pp-header">
    <!-- Title & Badge -->
    <Box className="pp-row">
      <Box className="pp-badge">🦊</Box>
      <Stack direction="vertical" gap="none">
        <Heading level={5} style={{ margin: 0, color: "#f8fafc", fontSize: "14px", fontWeight: 700 }}>Predator-Prey Ecosystem</Heading>
        <Text size="xs" style={{ color: "#6ee7b7", fontSize: "11px" }} className="pp-sub">Sustainable Lotka-Volterra 3D Reserve</Text>
      </Stack>
    </Box>

    <!-- Population Metric Badges -->
    <Box className="pp-row">
      <Box className="pp-card" style={{ padding: "4px 8px" }}>
        <Stack direction="horizontal" gap="xs" align="center">
          <Text size="xs" style={{ color: "#34d399", fontWeight: 600 }}>🌿 Grass:</Text>
          <Text size="xs" style={{ color: "#f8fafc", fontWeight: 700 }}>{grassCount}</Text>
        </Stack>
      </Box>

      <Box className="pp-card" style={{ padding: "4px 8px" }}>
        <Stack direction="horizontal" gap="xs" align="center">
          <Text size="xs" style={{ color: "#38bdf8", fontWeight: 600 }}>🐰 Prey:</Text>
          <Text size="xs" style={{ color: "#f8fafc", fontWeight: 700 }}>{rabbitCount}</Text>
        </Stack>
      </Box>

      <Box className="pp-card" style={{ padding: "4px 8px" }}>
        <Stack direction="horizontal" gap="xs" align="center">
          <Text size="xs" style={{ color: "#fb923c", fontWeight: 600 }}>🦊 Predators:</Text>
          <Text size="xs" style={{ color: "#f8fafc", fontWeight: 700 }}>{foxCount}</Text>
        </Stack>
      </Box>

      <!-- Status Badge -->
      <Badge style={{ background: "rgba(0,0,0,0.45)", color: statusColor, borderColor: statusColor, fontWeight: 700 }}>
        {ecosystemStatus}
      </Badge>

      <!-- Camera Mode Selector -->
      <Box className="pp-row">
        <Button size="xs" variant={cameraMode === "overview" ? "primary" : "secondary"} @click={() => setCameraView("overview")}>Reserve</Button>
        <Button size="xs" variant={cameraMode === "lake" ? "primary" : "secondary"} @click={() => setCameraView("lake")}>💧 Lake</Button>
        <Button size="xs" variant={cameraMode === "forest" ? "primary" : "secondary"} @click={() => setCameraView("forest")}>🌲 Pine Ridge</Button>
        <Button size="xs" variant={cameraMode === "meadow" ? "primary" : "secondary"} @click={() => setCameraView("meadow")}>🌸 Meadow</Button>
        <Button size="xs" variant={cameraMode === "topdown" ? "primary" : "secondary"} @click={() => setCameraView("topdown")}>Top Map</Button>
        <Button size="xs" variant={cameraMode === "cinematic" ? "primary" : "secondary"} @click={() => setCameraView("cinematic")}>Cinematic</Button>
      </Box>
    </Box>
  </Box>

  <!-- 3D Scene Viewport -->
  <Box className="pp-viewport">
    <Scene3D
      fill={true}
      objects={objects}
      staticObjects={staticObjects}
      lights={lights}
      camera={{ position: cameraPos, lookAt: cameraLookAt, fov: cameraFov }}
      shadows={true}
      toneMapping="aces"
      toneMappingExposure={1.15}
      sky="day"
      fog={{ color: "#c6dcf0", near: 75, far: 190 }}
      orbitControls={cameraMode !== "follow" && cameraMode !== "cinematic"}
      @click={handleSceneClick}
    />

    <!-- Helper Tip Overlay -->
    <Box className="pp-card pp-tip">
      <Text size="xs" style={{ color: "#f8fafc", fontSize: "12px", lineHeight: "1.4" }}>
        💡 <span style={{ color: "#34d399", fontWeight: 700 }}>Pine ridge · Meadow · Crags · Woodland</span> <span style={{ color: "#6ee7b7" }}>•</span> <span style={{ color: "#38bdf8", fontWeight: 700 }}>Dual Needs:</span> Food + Water <span style={{ color: "#6ee7b7" }}>•</span> <span style={{ color: "#fbbf24", fontWeight: 700 }}>Day {dayCount} ({season})</span> <span style={{ color: "#6ee7b7" }}>•</span> Click animal to inspect genetics!
      </Text>
    </Box>

    <!-- Real-time Population Dynamics Card -->
    <Box className="pp-card pp-graph-panel">
      <Stack direction="horizontal" justify="between" align="center" style={{ marginBottom: 4 }}>
        <Text size="xs" style={{ fontWeight: 700, color: "#f8fafc" }}>📈 Population & Evolution</Text>
        <Text size="xs" style={{ color: "#34d399", fontSize: "11px", fontWeight: 600 }}>Max Gen {maxGeneration}</Text>
      </Stack>

      <!-- Legend with Current Counts -->
      <Stack direction="horizontal" gap="xs" style={{ marginBottom: 6 }}>
        <Text size="xs" style={{ color: "#34d399", fontSize: "10px", fontWeight: 600 }}>● Flora ({grassCount})</Text>
        <Text size="xs" style={{ color: "#38bdf8", fontSize: "10px", fontWeight: 600 }}>● Prey ({rabbitCount})</Text>
        <Text size="xs" style={{ color: "#fb923c", fontSize: "10px", fontWeight: 600 }}>● Apex ({foxCount})</Text>
      </Stack>

      <!-- Visual Multi-Bar Sparkline: flora, prey and apex side by side per sample -->
      <Box style={{ width: "100%", height: 64, background: "rgba(0,0,0,0.45)", borderRadius: 4, position: "relative", overflow: "hidden", display: "flex", alignItems: "flex-end", gap: 3, padding: "3px 5px" }}>
        #each (col in sparkCols)
          <Box style={{ flex: 1, height: "100%", display: "flex", alignItems: "flex-end", gap: 1 }}>
            <Box style={{ flex: 1, height: col.g + "%", background: "#34d399", borderRadius: 1, minHeight: 2, opacity: 0.85 }} />
            <Box style={{ flex: 1, height: col.p + "%", background: "#38bdf8", borderRadius: 1, minHeight: 2 }} />
            <Box style={{ flex: 1, height: col.f + "%", background: "#fb923c", borderRadius: 1, minHeight: 2 }} />
          </Box>
        #end
      </Box>
    </Box>

    <!-- Live Reserve Minimap: habitats as zones, animals as dots -->
    <Box className="pp-card pp-minimap">
      <Stack direction="horizontal" justify="between" align="center" style={{ marginBottom: 6 }}>
        <Text size="xs" style={{ fontWeight: 700, color: "#f8fafc" }}>🗺 Reserve Map</Text>
        <Text size="xs" style={{ color: "#6ee7b7", fontSize: "10px" }}>{rabbitCount + foxCount} tracked</Text>
      </Stack>
      <Box className="pp-map">
        <Box className="pp-map-zone" style={{ left: "2%", top: "2%", width: "34%", height: "36%", background: "#2f5a26" }} />
        <Box className="pp-map-zone" style={{ left: "64%", top: "62%", width: "34%", height: "36%", background: "#7a6a35" }} />
        <Box className="pp-map-zone" style={{ left: "2%", top: "65%", width: "31%", height: "33%", background: "#6f7986" }} />
        <Box className="pp-map-zone" style={{ left: "60%", top: "2%", width: "38%", height: "36%", background: "#6cbf46" }} />
        <Box className="pp-map-zone" style={{ left: "40.6%", top: "35.6%", width: "24.6%", height: "24.6%", borderRadius: "50%", background: "#d9b06a" }} />
        <Box className="pp-map-zone" style={{ left: "43.2%", top: "38.2%", width: "19.4%", height: "19.4%", borderRadius: "50%", background: "#38bdf8" }} />
        #each (dot in mapDots)
          <Box className="pp-map-dot" style={{ left: dot.l + "%", top: dot.t + "%", width: dot.s, height: dot.s, background: dot.c }} />
        #end
      </Box>
      <Stack direction="horizontal" gap="xs" style={{ marginTop: 5, justifyContent: "center" }}>
        <Text size="xs" style={{ color: "#f8fafc", fontSize: "10px" }}>● Prey</Text>
        <Text size="xs" style={{ color: "#fb923c", fontSize: "10px" }}>● Fox</Text>
        <Text size="xs" style={{ color: "#38bdf8", fontSize: "10px" }}>● Lake</Text>
      </Stack>
    </Box>

    <!-- Entity Inspector Drawer -->
    #if (inspectorOpen)
      <Box className="pp-card pp-inspector">
        <Stack direction="horizontal" justify="between" align="center" style={{ marginBottom: 6 }}>
          <Stack direction="horizontal" gap="xs" align="center">
            <Text size="md">🔍</Text>
            <Text size="xs" style={{ fontWeight: 700, color: "#f8fafc" }}>{selectedEntity.name}</Text>
          </Stack>
          <Button size="xs" variant="secondary" @click={closeInspector}>✕</Button>
        </Stack>

        <Stack direction="vertical" gap="xs">
          <!-- State & Generation -->
          <Stack direction="horizontal" justify="between" align="center">
            <Badge size="xs" variant="info">Gen {selectedEntity.generation}</Badge>
            <Badge size="xs" variant="warning">{selectedEntity.state}</Badge>
          </Stack>

          <!-- Energy Bar (Food) -->
          <Stack direction="horizontal" justify="between">
            <Text size="xs" style={{ color: "#a7f3d0" }}>Hunger / Energy:</Text>
            <Text size="xs" style={{ fontWeight: 700, color: "#38bdf8" }}>{Math.round(selectedEntity.energy)} / {selectedEntity.maxEnergy}</Text>
          </Stack>
          <Box style={{ width: "100%", height: 6, background: "rgba(0,0,0,0.5)", borderRadius: 3, overflow: "hidden" }}>
            <Box style={{ width: Math.min(100, (selectedEntity.energy / selectedEntity.maxEnergy) * 100) + "%", height: "100%", background: "#34d399" }} />
          </Box>

          <!-- Hydration Bar (Water) -->
          <Stack direction="horizontal" justify="between">
            <Text size="xs" style={{ color: "#a7f3d0" }}>Thirst / Water:</Text>
            <Text size="xs" style={{ fontWeight: 700, color: "#60a5fa" }}>{Math.round(selectedEntity.hydration)} / {selectedEntity.maxHydration}</Text>
          </Stack>
          <Box style={{ width: "100%", height: 6, background: "rgba(0,0,0,0.5)", borderRadius: 3, overflow: "hidden" }}>
            <Box style={{ width: Math.min(100, (selectedEntity.hydration / selectedEntity.maxHydration) * 100) + "%", height: "100%", background: "#38bdf8" }} />
          </Box>

          <!-- Genetic Traits -->
          <Stack direction="horizontal" justify="between">
            <Text size="xs" style={{ color: "#a7f3d0" }}>Speed Gene:</Text>
            <Text size="xs" style={{ color: "#fef08a", fontWeight: 700 }}>{Math.round(selectedEntity.traits.speed * 100)}%</Text>
          </Stack>
          <Stack direction="horizontal" justify="between">
            <Text size="xs" style={{ color: "#a7f3d0" }}>Sight Gene:</Text>
            <Text size="xs" style={{ color: "#fef08a", fontWeight: 700 }}>{Math.round(selectedEntity.traits.sight * 100)}%</Text>
          </Stack>

          <!-- Age & Offspring -->
          <Stack direction="horizontal" justify="between">
            <Text size="xs" style={{ color: "#a7f3d0" }}>Age / Offspring:</Text>
            <Text size="xs" style={{ color: "#f8fafc" }}>{selectedEntity.age}t · {selectedEntity.offspringCount} kits</Text>
          </Stack>

          <Button size="xs" variant="primary" style={{ marginTop: 4 }} @click={() => setCameraView("follow")}>
            🎥 Follow Creature
          </Button>
        </Stack>
      </Box>
    #end
  </Box>

  <!-- Bottom Console Bar (Simulation & Environment Controls) -->
  <Box className="pp-bottom">
    <!-- Simulation Transport -->
    <Box className="pp-row">
      <Button size="xs" variant={isRunning ? "danger" : "primary"} @click={togglePlay}>
        {isRunning ? "⏸ Pause" : "▶ Play"}
      </Button>
      <Button size="xs" variant="secondary" @click={stepOnce}>⏭ Step</Button>

      <Text size="xs" style={{ color: "#a7f3d0", marginLeft: 4 }}>Speed:</Text>
      <Button size="xs" variant={simSpeed === 1 ? "primary" : "secondary"} @click={() => setSimSpeed(1)}>1x</Button>
      <Button size="xs" variant={simSpeed === 2 ? "primary" : "secondary"} @click={() => setSimSpeed(2)}>2x</Button>
      <Button size="xs" variant={simSpeed === 4 ? "primary" : "secondary"} @click={() => setSimSpeed(4)}>4x</Button>
    </Box>

    <!-- Spawn Tools -->
    <Box className="pp-row">
      <Text size="xs" style={{ color: "#a7f3d0" }}>Spawn:</Text>
      <Button size="xs" variant="secondary" @click={spawnPreyAction}>+ 🐰 Prey</Button>
      <Button size="xs" variant="secondary" @click={spawnPredatorAction}>+ 🦊 Predator</Button>
      <Button size="xs" variant="secondary" @click={plantGrassAction}>+ 🌱 Grass</Button>
    </Box>

    <!-- Environmental Events & Scenarios -->
    <Box className="pp-row">
      <Button size="xs" variant="secondary" @click={triggerSpringBloom}>🌸 Spring Bloom</Button>
      <Button size="xs" variant="secondary" @click={triggerColdSnap}>❄️ Cold Snap</Button>

      <Text size="xs" style={{ color: "#a7f3d0", marginLeft: 4 }}>Preset:</Text>
      <Button size="xs" variant="secondary" @click={() => resetScenario("balanced")}>⚖️ Balanced</Button>
      <Button size="xs" variant="secondary" @click={() => resetScenario("rabbit_boom")}>🐰 Haven</Button>
      <Button size="xs" variant="secondary" @click={() => resetScenario("predator_pack")}>🦊 Pack</Button>
    </Box>
  </Box>
</Box>
