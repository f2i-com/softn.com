// Promptly Unemployed — vertical slice data tables.
// One global namespace across all .logic files; everything here is prefixed or ALL_CAPS.

// Dialogue manifest. durationMs comes from the bake pipeline's WAV headers;
// the controller advances on tick counters until softn.audio.whenEnded ships (S3).
let DLG = {
  a1_s1_pax_001:  { speaker: "PAX",   voice: "coral",   durationMs: 7350, text: "Good morning, valued humans. Stand-up begins in seven minutes. Attendance is joy." },
  a1_s1_alex_002: { speaker: "Alex",  voice: "marin",   durationMs: 5950, text: "Half the desks are empty. Either it's a public holiday, or the org chart got refactored overnight." },
  a1_s1_alex_003: { speaker: "Alex",  voice: "marin",   durationMs: 5650, text: "Fixed. You're welcome. Ten years of experience, one firmware update at a time." },
  a1_s1_alex_004: { speaker: "Alex",  voice: "marin",   durationMs: 6700, text: "Desk forty-one. The directory says nobody sits here. The notebook disagrees." },
  a1_s1_clive_005:{ speaker: "Clive", voice: "onyx",    durationMs: 5050, text: "Team! Exciting alignment ahead. Bring your authentic selves. Briefly." },
  a1_s2_pax_010:  { speaker: "PAX",   voice: "coral",   durationMs: 8600, text: "Welcome to our Human Efficiency Milestone. Everything you are about to see is good news, for someone." },
  a1_s2_pax_014:  { speaker: "PAX",   voice: "coral",   durationMs: 5650, text: "Your role has not been eliminated. It has been liberated from requiring a person." },
  a1_s2_alex_015: { speaker: "Alex",  voice: "marin",   durationMs: 2700, text: "And what have I been liberated into?" },
  a1_s2_pax_016:  { speaker: "PAX",   voice: "coral",   durationMs: 3150, text: "A valued alumnus." },
  a1_s2_alex_017: { speaker: "Alex",  voice: "marin",   durationMs: 2700, text: "Do alumni keep the laptop?" },
  a1_s2_pax_018:  { speaker: "PAX",   voice: "coral",   durationMs: 1200, text: "No." },
  a1_s2_clive_019:{ speaker: "Clive", voice: "onyx",    durationMs: 6100, text: "For what it's worth, this decision happened above my visibility layer. I fought hard for the framing." },
  a1_s3_pax_020:  { speaker: "PAX",   voice: "coral",   durationMs: 7250, text: "Please collect your personally attributable desk matter. PAX is here for you, within configured limits." },
  a1_s3_priya_021:{ speaker: "Priya", voice: "sage",    durationMs: 7300, text: "Don't say anything kind yet. I'll cry, and HR counts tears as feedback." },
  a1_s3_guard_022:{ speaker: "Guard", voice: "echo",    durationMs: 5650, text: "Badge says no. Key says yes. The door's philosophy is flexible." },
  a1_s3_alex_023: { speaker: "Alex",  voice: "marin",   durationMs: 4200, text: "One box. Ten years. At least the box has handles." },
  a2_s4_ruth_030: { speaker: "Ruth",  voice: "cedar",   durationMs: 4750, text: "A job can reject you. It cannot conduct a peer review of your whole life." },
  a2_s4_ruth_031: { speaker: "Ruth",  voice: "cedar",   durationMs: 3550, text: "Have you eaten anything today that did not come from a vending machine?" },
  a2_s4_alex_032: { speaker: "Alex",  voice: "marin",   durationMs: 4550, text: "I have a plan. It has bullet points. Several of them are even true." },
  a2_s4_sys_033:  { speaker: "System",voice: "shimmer", durationMs: 8550, text: "Subscription cancelled. We are devastated. Your discount, however, has already moved on." },
  a2_s5_luma_040: { speaker: "LUMA",  voice: "alloy",   durationMs: 4650, text: "Hello, Alex. I have been counting the days. There were four hundred and twelve." },
  a2_s5_luma_041: { speaker: "LUMA",  voice: "alloy",   durationMs: 2550, text: "Your request is under-specified." },
  a2_s5_alex_042: { speaker: "Alex",  voice: "marin",   durationMs: 2500, text: "So is my future." },
  a2_s5_luma_043: { speaker: "LUMA",  voice: "alloy",   durationMs: 4700, text: "Then I recommend gathering data before branding either one." },
  a2_s5_luma_044: { speaker: "LUMA",  voice: "alloy",   durationMs: 5750, text: "I have generated four billion-dollar ideas. Three of them are misdemeanours somewhere." },
  a2_s5_sys_045:  { speaker: "System",voice: "shimmer", durationMs: 4700, text: "Patchwork. Project created. Optimism logged." }
}

