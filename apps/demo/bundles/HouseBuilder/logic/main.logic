    I("dining_table", 2.8, 2.3, 0); I("chair", 2.2, 1.6, 0); I("chair", 3.4, 3.0, Math.PI); I("armchair", 1.0, 3.9, Math.PI / 2, "#166534"); I("rug", 2.6, 4.0, 0, "#78350f"); I("bookshelf", 0.25, 1.2, Math.PI / 2); I("floor_lamp", 0.45, 4.9, 0);
