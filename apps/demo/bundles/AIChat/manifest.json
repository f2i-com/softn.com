{
  "name": "AI Chat",
  "version": "1.0.0",
  "description": "A chat with a small language model that downloads once and runs entirely in your browser; nothing you type leaves the machine",
  "main": "ui/main.ui",
  "icon": "assets/icon.svg",
  "files": {
    "ui": [
      "ui/main.ui"
    ],
    "logic": [
      "logic/main.logic"
    ],
    "xdb": [
      "xdb/conversations.xdb",
      "xdb/messages.xdb"
    ],
    "assets": [
      "assets/icon.svg"
    ]
  },
  "config": {
    "window": {
      "title": "AI Chat",
      "width": 1000,
      "height": 700
    },
    "theme": {
      "primary": "#10b981",
