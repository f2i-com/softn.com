}

// Plane reader state machine: decodes a channel plane of w x h into `out` (Uint8Array w*h).
function psPsdPlaneNew(bytes, start, end, w, h, compression, out) {
  let st = { b: bytes, pos: start, end: end, w: w, h: h, comp: compression, out: out, row: 0, counts: null, inflater: null, predicted: 0 };
  if (compression === 1) {
    if (start + 2 * h > end) psFail("Truncated PSD RLE table.");
    st.counts = new Int32Array(h);
    for (let y = 0; y < h; y++) st.counts[y] = psU16BE(bytes, start + 2 * y);
    st.pos = start + 2 * h;
  } else if (compression === 2 || compression === 3) {
    st.inflater = psInflateNew(bytes, start, end, true, out);
  } else if (compression !== 0) psFail("Unsupported PSD compression " + compression + ".");
  return st;
}
// Returns true when the plane is complete.
function psPsdPlaneRun(st) {
  let w = st.w, h = st.h, out = st.out;
  if (w === 0 || h === 0) return true;
  if (st.comp === 0) {
    if (st.pos + w * h > st.end) psFail("Truncated PSD raw channel.");
    out.set(st.b.subarray(st.pos, st.pos + w * h));
    st.pos += w * h;
    return true;
  }
  if (st.comp === 1) {
    let rows = Math.max(1, Math.floor(PS_STEP_BYTES / 2 / Math.max(1, w)));
    let y1 = Math.min(h, st.row + rows);
    let b = st.b, pos = st.pos, counts = st.counts;
    for (let y = st.row; y < y1; y++) {
      let rowEnd = pos + counts[y];
      if (rowEnd > st.end) psFail("Truncated PSD RLE data.");
      psPackBitsRow(b, pos, rowEnd, out, y * w, w);
      pos = rowEnd;
    }
    st.pos = pos; st.row = y1;
    return st.row >= h;
  }
  // ZIP / ZIP with prediction
  let finished = psInflateRun(st.inflater, st.inflater.olen + PS_STEP_BYTES);
  if (!finished) return false;
  if (st.inflater.olen !== w * h) psFail("PSD ZIP pixel length mismatch.");
  if (st.comp === 3 && !st.predicted) {
    // Undo horizontal delta prediction, sliced by rows.
    let rows = Math.max(1, Math.floor(PS_STEP_BYTES / Math.max(1, w)));
    let y1 = Math.min(h, st.row + rows);
    for (let y = st.row; y < y1; y++) { let o = y * w; for (let x = 1; x < w; x++) out[o + x] = (out[o + x] + out[o + x - 1]) & 255; }
    st.row = y1;
    if (st.row < h) return false;
    st.predicted = 1;
  }
  return true;
}

let PS_PSD_SAFE_BLOCKS = ["luni", "lyid", "lspf", "lclr", "lnsr", "lyvr", "tsly", "infx", "knko", "clbl", "fxrp", "shmd", "iOpa", "lrFX_"];
let PS_PSD_DESCRIPTIONS = {
  TySh: "Text is imported as its cached raster image, not editable Photoshop type.",
  tySh: "Text is imported as its cached raster image.",
  lsct: "Layer groups are flattened into the layer list; group compositing may differ.",
  lsdk: "Layer groups are flattened into the layer list; group compositing may differ.",
  lfx2: "Photoshop layer effects are not rendered.", lrFX: "Photoshop layer effects are not rendered.",
  vmsk: "Vector masks are not rendered.", vsms: "Vector masks are not rendered.",
  SoLd: "Smart objects are imported as cached raster images.", PlLd: "Smart objects are imported as cached raster images.",
  SoCo: "Photoshop fill and adjustment layers are not evaluated.", GdFl: "Photoshop fill and adjustment layers are not evaluated.",
};

// Read job. done(result): { width, height, layers (bottom-to-top), composite, warnings }
function psPsdReadJob(bytes, done, fail) {
  let b = bytes;
  let width = 0, height = 0, channelCount = 0, warnings = [], warnSet = {};
  let records = [], hasMergedAlpha = false, composite = null, compositeInfo = null;
  let planeQueue = [];   // { st, layer, channelId, len }
  let queueIndex = 0, currentPlane = null;
  function warn(msg) { if (!warnSet[msg]) { warnSet[msg] = true; warnings.push(msg); } }
  let steps = [];
  steps.push(function () {
    if (b.length > PS_MAX_FILE_BYTES) psFail("PSD input exceeds the " + (PS_MAX_FILE_BYTES / 1048576) + " MiB file limit.");
    let r = new PsCursor(b);
    if (r.str(4) !== "8BPS") psFail("Not a Photoshop PSD file (missing 8BPS signature).");
    if (r.u16() !== 1) psFail("Large-document PSB is not supported. Save a standard PSD copy.");
    r.skip(6);
