{
  "name": "softn",
  "version": "0.0.9",
  "private": true,
  "description": "SoftN UI Language and Engine",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/@softn/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build -w @softn/core && npm run build -w @softn/components && npm run build -w @softn/vite-plugin",
    "build:apps": "npm run build --workspace=apps --if-present",
    "build:core": "npm run build -w @softn/core",
    "build:components": "npm run build -w @softn/components",
    "build:site": "node scripts/build-site.mjs",
    "apps:fetch": "node scripts/softn-apps/fetch.mjs",
    "apps:screenshot": "node scripts/softn-apps/screenshot.mjs",
    "apps:publish": "node scripts/softn-apps/publish.mjs",
    "apps:build": "node scripts/softn-apps/build.mjs",
    "apps:seed": "node scripts/softn-apps/seed.mjs",
    "package:site": "node scripts/package-site.mjs",
    "build:single": "npm run build:packages && npm run build -w @softn/single",
    "package:single": "node scripts/package-single.mjs",
    "build:single-php-serve": "npm run build:packages && npm run build -w @softn/single-php-serve",
    "package:single-php-serve": "node scripts/package-single-php-serve.mjs",
    "package:private-single-php": "node scripts/package-private-single-php.mjs",
    "licenses:site": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "preview:site": "npm run build:site && node scripts/serve-site.mjs",
    "dev": "node scripts/fetch-demos.mjs && node scripts/dev-all.mjs",
    "dev:site": "npm run dev -w @softn/site",
    "dev:web": "node scripts/fetch-demos.mjs && npm run dev -w @softn/web",
    "dev:builder": "npm run dev -w @softn/builder",
    "dev:studio": "npm run dev -w @softn/studio",
    "dev:desktop": "npm run tauri dev -w @softn/loader",
    "fetch:demos": "node scripts/fetch-demos.mjs",
    "screenshot:demos": "node scripts/fetch-demos.mjs && node scripts/screenshot-demos.mjs",
    "bench": "node scripts/bench/measure.mjs",
    "pretest": "node scripts/fetch-demos.mjs",
    "test": "node --test scripts/fetch-demos.test.mjs scripts/package-site.test.mjs scripts/core-worker-assets.test.mjs && npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:errors": "eslint . --ext .ts,.tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "package:single:backend": "npm run package:single -- --with-backend"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.88",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "kokoro-js": "1.2.1",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.0-next.5"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3",
    "esbuild": "^0.28.1"
  }
}
