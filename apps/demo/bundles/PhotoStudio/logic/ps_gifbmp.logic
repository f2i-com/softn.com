// ps_gifbmp.logic - GIF (first frame) and BMP readers as sliced jobs.

function psIsGif(b) { return b.length > 13 && b[0] === 71 && b[1] === 73 && b[2] === 70 && b[3] === 56 && (b[4] === 55 || b[4] === 57) && b[5] === 97; }
function psIsBmp(b) { return b.length > 26 && b[0] === 66 && b[1] === 77; }

// ---------------------------------------------------------------------------
// GIF
// ---------------------------------------------------------------------------
function psGifSkipSubBlocks(b, p) {
  while (p < b.length) { let n = b[p++]; if (n === 0) return p; p += n; }
  psFail("Truncated GIF block.");
  return p;
}

function psGifDecodeJob(bytes, done, fail) {
  let b = bytes;
  let screenW = 0, screenH = 0, gct = null, frame = null, lct = null, transparent = -1, warnings = [];
  let data = null, indices = null, out = null;
  let lzw = null;
  let steps = [];
  steps.push(function () {
    if (!psIsGif(b)) psFail("Not a GIF file.");
    screenW = psU16LE(b, 6); screenH = psU16LE(b, 8);
    let packed = b[10];
    let p = 13;
    if (packed & 0x80) { let n = 3 * (1 << ((packed & 7) + 1)); gct = b.subarray(p, p + n); p += n; }
    let frames = 0;
    while (p < b.length) {
      let tag = b[p++];
      if (tag === 0x3b) break;
      if (tag === 0x21) {
        let label = b[p++];
        if (label === 0xf9) { let size = b[p]; if (size >= 4 && (b[p + 1] & 1)) transparent = b[p + 4]; p = psGifSkipSubBlocks(b, p); }
        else p = psGifSkipSubBlocks(b, p);
        continue;
      }
      if (tag === 0x2c) {
        frames++;
        if (frame) { warnings.push("Animated GIF: only the first frame was opened."); break; }
        frame = { x: psU16LE(b, p), y: psU16LE(b, p + 2), w: psU16LE(b, p + 4), h: psU16LE(b, p + 6), packed: b[p + 8] };
        p += 9;
        if (frame.packed & 0x80) { let n = 3 * (1 << ((frame.packed & 7) + 1)); lct = b.subarray(p, p + n); p += n; }
        frame.minCode = b[p++];
        frame.dataStart = p;
        p = psGifSkipSubBlocks(b, p);
        frame.dataEnd = p;
        continue;
      }
      psFail("Unrecognised GIF block.");
    }
    if (!frame) psFail("GIF contains no image.");
    if (screenW < 1 || screenH < 1) { screenW = frame.x + frame.w; screenH = frame.y + frame.h; }
    if (screenW > 16384 || screenH > 16384 || screenW * screenH > 16 * 1024 * 1024) psFail("GIF is larger than 16 megapixels.");
    if (frame.w < 1 || frame.h < 1) psFail("GIF frame is empty.");
    // Concatenate the LZW sub-blocks.
    let total = 0, q = frame.dataStart;
    while (q < frame.dataEnd) { let n = b[q++]; if (!n) break; total += n; q += n; }
    data = new Uint8Array(total);
    let at = 0; q = frame.dataStart;
    while (q < frame.dataEnd) { let n = b[q++]; if (!n) break; data.set(b.subarray(q, q + n), at); at += n; q += n; }
    indices = new Uint8Array(frame.w * frame.h);
    lzw = { pos: 0, bb: 0, bc: 0, minCode: frame.minCode, codeSize: frame.minCode + 1, clear: 1 << frame.minCode, eoi: (1 << frame.minCode) + 1,
      next: (1 << frame.minCode) + 2, prevCode: -1, outAt: 0,
      prefix: new Int32Array(4096), suffix: new Uint8Array(4096), length: new Int32Array(4096), stack: new Uint8Array(4097), firstOf: new Uint8Array(4096) };
    for (let i = 0; i < 4096; i++) { lzw.prefix[i] = -1; lzw.suffix[i] = i & 255; lzw.length[i] = 1; lzw.firstOf[i] = i & 255; }
    return true;
  });
  steps.push(function () {
    let st = lzw, n = indices.length;
    let target = Math.min(n, st.outAt + PS_STEP_BYTES);
    let d = data, dn = d.length, outArr = indices;
    let prefix = st.prefix, suffix = st.suffix, length = st.length, stack = st.stack, firstOf = st.firstOf;
    let pos = st.pos, bb = st.bb, bc = st.bc, codeSize = st.codeSize, next = st.next, prevCode = st.prevCode, outAt = st.outAt;
    let clear = st.clear, eoi = st.eoi;
    while (outAt < target) {
      while (bc < codeSize && pos < dn) { bb |= d[pos++] << bc; bc += 8; }
      if (bc < codeSize) { outAt = n; break; }   // truncated: keep what we have
      let code = bb & ((1 << codeSize) - 1); bb >>>= codeSize; bc -= codeSize;
      if (code === clear) { codeSize = st.minCode + 1; next = clear + 2; prevCode = -1; continue; }
      if (code === eoi) { outAt = n; break; }
      let entry;
      if (code < next) {
        entry = code;
        if (prevCode >= 0 && next < 4096) { prefix[next] = prevCode; suffix[next] = firstOf[code]; length[next] = length[prevCode] + 1; firstOf[next] = firstOf[prevCode]; next++; }
      } else if (code === next && prevCode >= 0 && next < 4096) {
        prefix[next] = prevCode; suffix[next] = firstOf[prevCode]; length[next] = length[prevCode] + 1; firstOf[next] = firstOf[prevCode]; next++;
        entry = code;
      } else psFail("Corrupt GIF data.");
      // Emit entry (reverse through prefix chain).
      let len = length[entry], c = entry;
      if (outAt + len > n) len = n - outAt;
      let sp = length[entry];
      for (let k = sp - 1; k >= 0; k--) { stack[k] = suffix[c]; c = prefix[c]; }
      for (let k = 0; k < len; k++) outArr[outAt + k] = stack[k];
      outAt += len;
      if (next === (1 << codeSize) && codeSize < 12) codeSize++;
      prevCode = code;
    }
    st.pos = pos; st.bb = bb; st.bc = bc; st.codeSize = codeSize; st.next = next; st.prevCode = prevCode; st.outAt = outAt;
    if (outAt >= n) { out = new Uint8Array(screenW * screenH * 4); return true; }
    return outAt / n;
  });
  let placeStepper = null;
  steps.push(function () {
    if (placeStepper) return placeStepper();
    let pal = lct || gct;
    if (!pal) psFail("GIF has no colour table.");
    let palCount = (pal.length / 3) | 0;
    let fw = frame.w, fh = frame.h, fx = frame.x, fy = frame.y, W = screenW, H = screenH;
    let interlaced = (frame.packed & 0x40) !== 0;
    let idx = indices, o = out;
    let rowsPerStep = psRowsFor(fw, PS_STEP_PIXELS);
    placeStepper = psRowStepper(fh, rowsPerStep, function (y0, y1) {
      for (let row = y0; row < y1; row++) {
        let y;
        if (!interlaced) y = row;
        else {
          // Rows arrive in four passes: every 8th from 0, every 8th from 4, every 4th from 2, every 2nd from 1.
          let p0 = Math.ceil(fh / 8), p1 = Math.ceil(Math.max(0, fh - 4) / 8), p2 = Math.ceil(Math.max(0, fh - 2) / 4);
          if (row < p0) y = row * 8;
          else if (row < p0 + p1) y = 4 + (row - p0) * 8;
          else if (row < p0 + p1 + p2) y = 2 + (row - p0 - p1) * 4;
          else y = 1 + (row - p0 - p1 - p2) * 2;
        }
        let ty = fy + y;
        if (ty < 0 || ty >= H) continue;
        for (let x = 0; x < fw; x++) {
          let tx = fx + x;
          if (tx < 0 || tx >= W) continue;
          let i = idx[row * fw + x];
          let p = (ty * W + tx) * 4;
          if (i === transparent) { o[p + 3] = 0; continue; }
          if (i >= palCount) i = 0;
          o[p] = pal[i * 3]; o[p + 1] = pal[i * 3 + 1]; o[p + 2] = pal[i * 3 + 2]; o[p + 3] = 255;
        }
      }
    });
    return placeStepper();
  });
  psEnqueue("Decoding GIF", psSequence(steps), function () { data = null; indices = null; lzw = null; done({ w: screenW, h: screenH, data: out, warnings: warnings }); }, fail);
}

// ---------------------------------------------------------------------------
// BMP
// ---------------------------------------------------------------------------
function psBmpMaskShift(mask) {
  if (!mask) return { shift: 0, bits: 0 };
  let shift = 0;
  while (((mask >>> shift) & 1) === 0 && shift < 32) shift++;
  let bits = 0;
  while (((mask >>> (shift + bits)) & 1) === 1 && shift + bits < 32) bits++;
  return { shift: shift, bits: bits };
}

function psBmpDecodeJob(bytes, done, fail) {
  let b = bytes, info = null, out = null;
  let steps = [];
  steps.push(function () {
    if (!psIsBmp(b)) psFail("Not a BMP file.");
    let offBits = psU32LE(b, 10);
    let hdr = psU32LE(b, 14);
    let w, h, bpp, compression = 0, colors = 0, topDown = false;
    let rMask = 0, gMask = 0, bMask = 0, aMask = 0;
    if (hdr === 12) { w = psU16LE(b, 18); h = psU16LE(b, 20); bpp = psU16LE(b, 24); }
    else {
      w = psI32LE(b, 18); h = psI32LE(b, 22); bpp = psU16LE(b, 28); compression = psU32LE(b, 30); colors = psU32LE(b, 46);
      if (h < 0) { h = -h; topDown = true; }
      if (compression === 3 || compression === 6) {
        if (hdr >= 52) { rMask = psU32LE(b, 54); gMask = psU32LE(b, 58); bMask = psU32LE(b, 62); if (hdr >= 56) aMask = psU32LE(b, 66); }
        else { rMask = psU32LE(b, 54); gMask = psU32LE(b, 58); bMask = psU32LE(b, 62); }
      }
    }
    if (compression !== 0 && compression !== 3 && compression !== 6) psFail("Compressed (RLE) BMP files are not supported. Save the image as PNG instead.");
    if (w < 1 || h < 1) psFail("BMP has an empty image size.");
    if (w > 16384 || h > 16384 || w * h > 16 * 1024 * 1024) psFail("BMP is larger than 16 megapixels.");
    if (bpp !== 1 && bpp !== 4 && bpp !== 8 && bpp !== 16 && bpp !== 24 && bpp !== 32) psFail("Unsupported BMP bit depth " + bpp + ".");
    let palette = null;
    if (bpp <= 8) {
      let count = colors || (1 << bpp);
      let entrySize = hdr === 12 ? 3 : 4;
      let pstart = 14 + hdr;
      palette = new Uint8Array(count * 3);
      for (let i = 0; i < count; i++) { let q = pstart + i * entrySize; if (q + 2 >= b.length) break; palette[i * 3] = b[q + 2]; palette[i * 3 + 1] = b[q + 1]; palette[i * 3 + 2] = b[q]; }
    }
    if (bpp === 16 && compression === 0) { rMask = 0x7c00; gMask = 0x03e0; bMask = 0x001f; }
    if (bpp === 32 && compression === 0) { rMask = 0xff0000; gMask = 0xff00; bMask = 0xff; aMask = 0; }
    let stride = ((w * bpp + 31) >> 5) << 2;
    if (offBits + stride * h > b.length) psFail("BMP pixel data is truncated.");
    info = { w: w, h: h, bpp: bpp, stride: stride, offBits: offBits, topDown: topDown, palette: palette,
      r: psBmpMaskShift(rMask), g: psBmpMaskShift(gMask), bl: psBmpMaskShift(bMask), a: psBmpMaskShift(aMask), rMask: rMask, gMask: gMask, bMask: bMask, aMask: aMask };
    out = new Uint8Array(w * h * 4);
    return true;
  });
  let stepper = null;
  steps.push(function () {
    if (!stepper) {
      let w = info.w, h = info.h, bpp = info.bpp, stride = info.stride, off = info.offBits, pal = info.palette;
      stepper = psRowStepper(h, psRowsFor(w, PS_STEP_PIXELS), function (y0, y1) {
        for (let y = y0; y < y1; y++) {
          let srcRow = info.topDown ? y : h - 1 - y;
          let s = off + srcRow * stride, o = y * w * 4;
          if (bpp === 24) { for (let x = 0; x < w; x++) { let i = s + x * 3; out[o] = b[i + 2]; out[o + 1] = b[i + 1]; out[o + 2] = b[i]; out[o + 3] = 255; o += 4; } }
          else if (bpp === 32 || bpp === 16) {
            let rs = info.r, gs = info.g, bs = info.bl, as = info.a;
            let hasAlpha = info.aMask !== 0;
            for (let x = 0; x < w; x++) {
              let v = bpp === 32 ? psU32LE(b, s + x * 4) : psU16LE(b, s + x * 2);
              let r = (v & info.rMask) >>> rs.shift, g = (v & info.gMask) >>> gs.shift, bl = (v & info.bMask) >>> bs.shift;
              out[o] = rs.bits >= 8 ? r >>> (rs.bits - 8) : Math.round(r * 255 / ((1 << rs.bits) - 1 || 1));
              out[o + 1] = gs.bits >= 8 ? g >>> (gs.bits - 8) : Math.round(g * 255 / ((1 << gs.bits) - 1 || 1));
              out[o + 2] = bs.bits >= 8 ? bl >>> (bs.bits - 8) : Math.round(bl * 255 / ((1 << bs.bits) - 1 || 1));
              if (hasAlpha) { let a = (v & info.aMask) >>> as.shift; out[o + 3] = as.bits >= 8 ? a >>> (as.bits - 8) : Math.round(a * 255 / ((1 << as.bits) - 1 || 1)); }
              else out[o + 3] = 255;
              o += 4;
            }
          } else {
            let palCount = (pal.length / 3) | 0;
            for (let x = 0; x < w; x++) {
              let idx;
              if (bpp === 8) idx = b[s + x];
              else if (bpp === 4) idx = (b[s + (x >> 1)] >> ((x & 1) ? 0 : 4)) & 15;
              else idx = (b[s + (x >> 3)] >> (7 - (x & 7))) & 1;
              if (idx >= palCount) idx = 0;
              out[o] = pal[idx * 3]; out[o + 1] = pal[idx * 3 + 1]; out[o + 2] = pal[idx * 3 + 2]; out[o + 3] = 255; o += 4;
            }
          }
        }
      });
    }
    return stepper();
  });
  psEnqueue("Decoding BMP", psSequence(steps), function () { done({ w: info.w, h: info.h, data: out, warnings: [] }); }, fail);
}
