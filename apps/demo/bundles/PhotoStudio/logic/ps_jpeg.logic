            o[p] = (C * K + 127) / 255 | 0; o[p + 1] = (M * K + 127) / 255 | 0; o[p + 2] = (Yc * K + 127) / 255 | 0; o[p + 3] = 255; p += 4;
          }
        }
      }
    });
  }

  psEnqueue("Decoding JPEG", function () {
    if (phase === 0) {
      let doneParsing = parseStep();
      if (!doneParsing) {
        if (scan) return 0.6 * (scan.mcu / scan.total);
        return 0;
      }
      if (frame.comps.length === 4) warnings.push("CMYK JPEG colours are approximated without colour management.");
      startIdct();
      phase = 1;
      return 0.6;
    }
    if (phase === 1) {
      let r = idctStep();
      if (r === true) { startColor(); phase = 2; return 0.8; }
      return 0.6 + 0.2 * r;
    }
    let r = colorState();
    if (r === true) return true;
    return 0.8 + 0.2 * r;
  }, function () {
    for (let i = 0; frame && i < frame.comps.length; i++) { frame.comps[i].plane = null; frame.comps[i].coef = null; }
    done({ w: outW, h: outH, data: out, warnings: warnings, scale: scale });
  }, fail);
}

// ---------------------------------------------------------------------------
// Encoder: baseline, 4:2:0, standard Huffman tables, quality 1..100.
// ---------------------------------------------------------------------------
let PS_JPEG_QL = Int32Array.from([16, 11, 10, 16, 24, 40, 51, 61, 12, 12, 14, 19, 26, 58, 60, 55, 14, 13, 16, 24, 40, 57, 69, 56, 14, 17, 22, 29, 51, 87, 80, 62,
  18, 22, 37, 56, 68, 109, 103, 77, 24, 35, 55, 64, 81, 104, 113, 92, 49, 64, 78, 87, 103, 121, 120, 101, 72, 92, 95, 98, 112, 100, 103, 99]);
let PS_JPEG_QC = Int32Array.from([17, 18, 24, 47, 99, 99, 99, 99, 18, 21, 26, 66, 99, 99, 99, 99, 24, 26, 56, 99, 99, 99, 99, 99, 47, 66, 99, 99, 99, 99, 99, 99,
  99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99]);
