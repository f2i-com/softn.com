// main.ui — WarbleWire
// Quick exchange, any wire. This one is the audible one.

<logic src="../logic/main.logic" />

<import Compose from="./pages/Compose.ui" />
<import Listen from="./pages/Listen.ui" />
<import Protocol from="./pages/Protocol.ui" />

<style>
/* The qxw.org look: paper, ink, and hard offset shadows with no blur. */
.ww-shell {
  --paper: #f4eddc;
  --ink: #18262d;
  --ink-faint: #6d7f88;
  --acid: #c7ee53;
  --cobalt: #3156c9;
  --coral: #f37561;
  --sky: #a9dce8;
  --leaf: #3f7550;
}
.ww-hard {
  box-shadow: 0.25rem 0.25rem 0 #18262d;
  border: 1px solid #18262d;
}
.ww-mono {
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.ww-tab {
  border-radius: 999px !important;
  padding: 0.4rem 1rem !important;
  font-size: 0.75rem !important;
  transition: transform 140ms cubic-bezier(0.16, 1, 0.3, 1) !important;
}
.ww-tab:active { transform: scale(0.96) !important; }
.ww-page > * {
  animation: ww-rise 380ms cubic-bezier(0.16, 1, 0.3, 1) both;
}
@keyframes ww-rise {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  .ww-page > * { animation: none; }
}
</style>

<App theme="light">
  <Box className="ww-shell" style={{
    display: "flex",
    flexDirection: "column",
    width: "100%",
    height: "100%",
    overflow: "hidden",
    background: "#f4eddc",
    color: "#18262d"
  }}>

    // Masthead
    <Box style={{
      display: "flex",
      alignItems: "center",
      gap: "0.875rem",
      padding: "1rem 1.5rem 0.875rem",
      borderBottom: "1px solid #18262d",
      flexShrink: 0
    }}>
      <Box className="ww-hard" style={{
        width: "38px",
        height: "38px",
        borderRadius: "50%",
        background: "#c7ee53",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        flexShrink: 0
      }}>
        <Text className="ww-mono" style={{ fontSize: "0.75rem", fontWeight: 700, color: "#18262d" }}>QX</Text>
      </Box>

      <Stack direction=vertical gap=xs style={{ flex: 1, minWidth: 0 }}>
        <Text style={{ fontSize: "1.125rem", fontWeight: 700, letterSpacing: "-0.03em" }}>WarbleWire</Text>
        <Text className="ww-mono" style={{ fontSize: "0.625rem", color: "#6d7f88" }}>Quick exchange · any wire</Text>
      </Stack>

      <Box style={{ display: "flex", gap: "0.375rem", flexWrap: "wrap" }}>
        <Button className="ww-tab" variant=ghost @click={setPage("compose")} style={{
          background: currentPage === "compose" ? "#18262d" : "transparent",
          color: currentPage === "compose" ? "#f4eddc" : "#18262d",
          border: "1px solid #18262d"
        }}>Compose</Button>
        <Button className="ww-tab" variant=ghost @click={setPage("listen")} style={{
          background: currentPage === "listen" ? "#18262d" : "transparent",
          color: currentPage === "listen" ? "#f4eddc" : "#18262d",
          border: "1px solid #18262d"
        }}>Listen</Button>
        <Button className="ww-tab" variant=ghost @click={setPage("protocol")} style={{
          background: currentPage === "protocol" ? "#18262d" : "transparent",
          color: currentPage === "protocol" ? "#f4eddc" : "#18262d",
          border: "1px solid #18262d"
        }}>Protocol</Button>
      </Box>
    </Box>

    // Pages
    <Box className="ww-page" style={{
      flex: 1,
      overflow: "auto",
      padding: "1.25rem 1.5rem 2rem",
      minHeight: 0
    }}>
      <Compose />
      <Listen />
      <Protocol />
    </Box>
  </Box>
</App>
