<logic src="../logic/main.logic" />

<style>
.bs-root { position: relative; width: 100%; height: 100%; min-height: 480px; overflow: hidden; background: #0b1220; font-family: "Segoe UI", system-ui, sans-serif; color: #f4f6fb; user-select: none; }
.bs-scene { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.bs-ovl { position: absolute; pointer-events: none; }
.bs-cross { top: 50%; left: 50%; width: 22px; height: 22px; margin: -11px 0 0 -11px; }
.bs-cross::before, .bs-cross::after { content: ""; position: absolute; background: rgba(255,255,255,0.9); mix-blend-mode: difference; }
.bs-cross::before { left: 10px; top: 0; width: 2px; height: 22px; }
.bs-cross::after { top: 10px; left: 0; width: 22px; height: 2px; }
.bs-panel { background: rgba(8, 12, 20, 0.62); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; backdrop-filter: blur(8px); }
.bs-hud { top: 14px; left: 14px; padding: 10px 14px; font-size: 12px; line-height: 1.5; letter-spacing: 0.02em; }
.bs-hud-k { color: #8fa0b8; }
.bs-target { top: 14px; left: 50%; transform: translateX(-50%); padding: 6px 14px; font-size: 12px; color: #dbe4f3; border-radius: 999px; }
.bs-toast { bottom: 108px; left: 50%; transform: translateX(-50%); padding: 8px 16px; font-size: 13px; color: #fff; border-radius: 999px; animation: bs-in 240ms ease both; }
@keyframes bs-in { from { opacity: 0; transform: translate(-50%, 6px); } to { opacity: 1; transform: translate(-50%, 0); } }
.bs-hotbar { bottom: 18px; left: 50%; transform: translateX(-50%); display: flex; gap: 6px; padding: 6px; pointer-events: auto; }
.bs-slot { width: 52px; height: 52px; border-radius: 9px; border: 2px solid rgba(255,255,255,0.12); background: rgba(0,0,0,0.35); position: relative; cursor: pointer; padding: 0; display: block; transition: transform 120ms ease, border-color 120ms ease; }
.bs-slot:hover { transform: translateY(-2px); }
.bs-slot-on { border-color: #ffffff; box-shadow: 0 0 0 2px rgba(255,255,255,0.35), 0 6px 18px rgba(0,0,0,0.4); transform: translateY(-4px); }
.bs-slot-on:hover { transform: translateY(-4px); }
.bs-swatch { position: absolute; left: 9px; top: 9px; width: 30px; height: 30px; border-radius: 6px; box-shadow: inset 0 -6px 0 rgba(0,0,0,0.22), inset 2px 2px 0 rgba(255,255,255,0.18); }
.bs-key { position: absolute; right: 4px; top: 2px; font-size: 10px; color: rgba(255,255,255,0.55); font-weight: 600; }
.bs-slotname { bottom: 78px; left: 50%; transform: translateX(-50%); font-size: 13px; font-weight: 600; text-shadow: 0 1px 4px rgba(0,0,0,0.8); letter-spacing: 0.04em; }
.bs-title { top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; pointer-events: auto; background: linear-gradient(180deg, rgba(4,8,16,0.35) 0%, rgba(4,8,16,0.55) 100%); }
.bs-card { width: min(560px, calc(100% - 32px)); padding: 34px 36px 30px; text-align: center; background: rgba(8,12,20,0.78); border: 1px solid rgba(255,255,255,0.1); border-radius: 18px; box-shadow: 0 30px 80px rgba(0,0,0,0.6); backdrop-filter: blur(10px); }
.bs-logo { display: block; font-size: clamp(42px, 8vw, 68px); font-weight: 900; letter-spacing: -0.03em; line-height: 1; background: linear-gradient(180deg, #a8f0a0 0%, #5cae4a 45%, #7b5433 46%, #5b3d25 100%); -webkit-background-clip: text; background-clip: text; color: transparent; filter: drop-shadow(0 6px 0 rgba(0,0,0,0.35)); }
.bs-tag { display: block; margin-top: 10px; font-size: 14px; color: #b8c4d6; }
.bs-btn { display: inline-block; padding: 12px 26px; border-radius: 10px; font-weight: 700; font-size: 15px; cursor: pointer; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.08); color: #fff; transition: transform 140ms ease, background 140ms ease; }
.bs-btn:hover { transform: translateY(-2px); background: rgba(255,255,255,0.16); }
.bs-btn-go { background: #5cae4a; color: #0b1a08; border-color: #5cae4a; box-shadow: 0 10px 30px rgba(92,174,74,0.35); }
.bs-btn-go:hover { background: #6cc45a; }
.bs-keys { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 22px auto 0; text-align: left; font-size: 13px; max-width: 360px; color: #cfd8e6; }
.bs-kbd { display: inline-block; min-width: 26px; padding: 2px 7px; border-radius: 6px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18); font-family: ui-monospace, monospace; font-size: 11px; text-align: center; color: #fff; }
.bs-pause { top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; pointer-events: auto; background: rgba(4,8,16,0.55); }
.bs-touch { position: absolute; left: 14px; bottom: 90px; pointer-events: auto; }
.bs-touch-btns { position: absolute; right: 14px; bottom: 96px; display: flex; flex-direction: column; gap: 10px; pointer-events: auto; }
.bs-round { width: 64px; height: 64px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.2); background: rgba(8,12,20,0.6); color: #fff; font-size: 12px; font-weight: 700; cursor: pointer; }
.bs-corner { top: 14px; right: 14px; display: flex; gap: 6px; pointer-events: auto; }
.bs-mini { padding: 6px 12px; font-size: 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.12); background: rgba(8,12,20,0.6); color: #dbe4f3; cursor: pointer; }
.bs-mini:hover { background: rgba(255,255,255,0.14); }
.bs-water { top: 0; left: 0; right: 0; bottom: 0; background: rgba(30, 90, 190, 0.28); }
.bs-vig { top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(120% 100% at 50% 50%, rgba(0,0,0,0) 55%, rgba(0,0,0,0.35) 100%); }
@media (max-width: 640px) {
  .bs-hud { display: none; }
  .bs-slot { width: 40px; height: 40px; }
  .bs-swatch { left: 6px; top: 6px; width: 24px; height: 24px; }
  .bs-card { padding: 24px 18px; }
}
</style>

<Box className="bs-root">
  <Loop interval={33} running={true} @tick={gameStep} />

  <Box className="bs-scene">
    <Scene3D
      fill={true}
      objects={objects}
      staticObjects={staticObjects}
      lights={lights}
      camera={{ position: cameraPos, lookAt: cameraLookAt, fov: 72 }}
      antialias={true}
      shadows={false}
      pointerLock={true}
      crosshair={true}
      cameraSmoothing={0.4}
      maxPixelRatio={1.5}
      pitchLimit={1.5}
      mouseLookSensitivity={0.0024}
      fog={sceneFog}
      background={skyColor}
      toneMapping="aces"
      toneMappingExposure={1.15}
      @click={onSceneClick}
    />
  </Box>

  <Box if={underwater} className="bs-ovl bs-water" />
  <Box className="bs-ovl bs-vig" />

  <!-- In play: crosshair, readouts, the block in hand -->
  <Box if={started} className="bs-ovl bs-cross" />
  <Box if={started} className="bs-ovl bs-panel bs-hud">
    <Text style={{ display: "block", fontSize: "12px", color: "#f4f6fb" }}><Text style={{ fontSize: "12px", color: "#8fa0b8" }}>xyz </Text>{hudPos}</Text>
    <Text style={{ display: "block", fontSize: "12px", color: "#f4f6fb" }}><Text style={{ fontSize: "12px", color: "#8fa0b8" }}>time </Text>{hudTime}</Text>
    <Text style={{ display: "block", fontSize: "12px", color: "#f4f6fb" }}><Text style={{ fontSize: "12px", color: "#8fa0b8" }}>placed </Text>{hudBlocks + (flying ? " · flying" : "")}</Text>
  </Box>
  <Box if={started && hudTarget !== ""} className="bs-ovl bs-panel bs-target"><Text style={{ fontSize: "12px", color: "#dbe4f3" }}>{hudTarget}</Text></Box>
  <Box if={toast !== ""} className="bs-ovl bs-panel bs-toast"><Text style={{ fontSize: "13px", color: "#ffffff" }}>{toast}</Text></Box>

  <Box if={started} className="bs-ovl bs-corner">
    <Button variant="ghost" className="bs-mini" style={{ padding: "6px 12px", fontSize: "12px", background: "rgba(8,12,20,0.6)", border: "1px solid rgba(255,255,255,0.14)", color: "#dbe4f3", borderRadius: "8px" }} @click={saveNow}>Save</Button>
    <Button variant="ghost" className="bs-mini" style={{ padding: "6px 12px", fontSize: "12px", background: "rgba(8,12,20,0.6)", border: "1px solid rgba(255,255,255,0.14)", color: "#dbe4f3", borderRadius: "8px" }} @click={toggleHelp}>{showHelp ? "Close help" : "Help (H)"}</Button>
  </Box>

  <Box if={started} className="bs-ovl bs-slotname">
    <Text style={{ fontSize: "13px", fontWeight: 600, color: "#ffffff", textShadow: "0 1px 4px rgba(0,0,0,0.8)" }}>{hotbar[slotIdx].name}</Text>
  </Box>
  <Box if={started} className="bs-ovl bs-panel bs-hotbar">
    #each (s, i in hotbar)
      <Button variant="ghost" className="bs-slot" @click={pickSlot(i)} ariaLabel={s.name}
        style={{ width: "52px", height: "52px", padding: 0, borderRadius: "9px", background: "rgba(0,0,0,0.35)", border: i === slotIdx ? "2px solid #ffffff" : "2px solid rgba(255,255,255,0.14)", boxShadow: i === slotIdx ? "0 0 0 2px rgba(255,255,255,0.35), 0 6px 18px rgba(0,0,0,0.4)" : "none", transform: i === slotIdx ? "translateY(-4px)" : "none", position: "relative" }}>
        <Box className="bs-swatch" style={{ background: s.color }} />
        <Text style={{ position: "absolute", right: "4px", top: "2px", fontSize: "10px", color: "rgba(255,255,255,0.6)", fontWeight: 600 }}>{s.key}</Text>
      </Button>
    #end
  </Box>

  <!-- Touch controls: a pad to walk, buttons to jump, mine and build -->
  <Box if={started && touchMode} className="bs-touch">
    <DPad @press={padPress} @release={padRelease} />
  </Box>
  <Box if={started && touchMode} className="bs-touch-btns">
    <Button variant="ghost" style={{ width: "64px", height: "64px", borderRadius: "999px", background: "rgba(8,12,20,0.6)", border: "1px solid rgba(255,255,255,0.2)", color: "#fff", fontSize: "12px", fontWeight: 700 }} @mousedown={touchJumpDown} @mouseup={touchJumpUp} @touchstart={touchJumpDown} @touchend={touchJumpUp}>Jump</Button>
    <Button variant="ghost" style={{ width: "64px", height: "64px", borderRadius: "999px", background: "rgba(8,12,20,0.6)", border: "1px solid rgba(255,255,255,0.2)", color: "#fff", fontSize: "12px", fontWeight: 700 }} @click={touchBreak}>Mine</Button>
    <Button variant="ghost" style={{ width: "64px", height: "64px", borderRadius: "999px", background: "rgba(8,12,20,0.6)", border: "1px solid rgba(255,255,255,0.2)", color: "#fff", fontSize: "12px", fontWeight: 700 }} @click={touchPlace}>Build</Button>
    <Button variant="ghost" style={{ width: "64px", height: "64px", borderRadius: "999px", background: "rgba(8,12,20,0.6)", border: "1px solid rgba(255,255,255,0.2)", color: "#fff", fontSize: "12px", fontWeight: 700 }} @click={touchFly}>Fly</Button>
  </Box>

  <!-- Title -->
  <Box if={!started} className="bs-ovl bs-title">
    <Box className="bs-card">
      <Text style={{ display: "block", fontSize: "64px", fontWeight: 900, letterSpacing: "-0.03em", lineHeight: 1, color: "#8fe07a", textShadow: "0 5px 0 #2d5a24, 0 12px 30px rgba(0,0,0,0.5)" }}>Blockscape</Text>
      <Text style={{ display: "block", marginTop: "12px", fontSize: "15px", color: "#c7d2e2" }}>An island of blocks. Dig it up, build it out, watch the sun go down on it.</Text>
      <Stack direction="horizontal" gap={10} style={{ justifyContent: "center", marginTop: "24px", flexWrap: "wrap" }}>
        <Button if={hasSave} variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "#5cae4a", color: "#0b1a08", border: "1px solid #5cae4a", boxShadow: "0 10px 30px rgba(92,174,74,0.35)" }} @click={continueWorld}>Continue</Button>
        <Button if={hasSave} variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "rgba(255,255,255,0.1)", color: "#ffffff", border: "1px solid rgba(255,255,255,0.2)" }} @click={newWorld}>New island</Button>
        <Button if={!hasSave} variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "#5cae4a", color: "#0b1a08", border: "1px solid #5cae4a", boxShadow: "0 10px 30px rgba(92,174,74,0.35)" }} @click={newWorld}>New island</Button>
      </Stack>
      <Box className="bs-keys">
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>W A S D</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>walk · <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>Shift</Text> sprint</Text>
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>Mouse</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>look · click the world to capture the cursor, <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>Esc</Text> to release</Text>
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>LMB</Text> <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>RMB</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>mine · build</Text>
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>1–9</Text> <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>wheel</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>choose a block · <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>MMB</Text> picks the one you aim at</Text>
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>Space</Text> <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>F</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>jump · fly (then <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>C</Text> to sink)</Text>
      </Box>
    </Box>
  </Box>

  <!-- Paused: the pointer was released -->
  <Box if={started && paused && !showHelp} className="bs-ovl bs-pause">
    <Box className="bs-card">
      <Text style={{ display: "block", fontSize: "26px", fontWeight: 800, color: "#ffffff" }}>Paused</Text>
      <Text style={{ display: "block", marginTop: "10px", fontSize: "14px", color: "#c7d2e2" }}>Click the world to take the cursor back.</Text>
      <Stack direction="horizontal" gap={10} style={{ justifyContent: "center", marginTop: "20px", flexWrap: "wrap" }}>
        <Button variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "#5cae4a", color: "#0b1a08", border: "1px solid #5cae4a", boxShadow: "0 10px 30px rgba(92,174,74,0.35)" }} @click={resumeGame}>Resume</Button>
        <Button variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "rgba(255,255,255,0.1)", color: "#ffffff", border: "1px solid rgba(255,255,255,0.2)" }} @click={saveNow}>Save</Button>
        <Button variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "rgba(255,255,255,0.1)", color: "#ffffff", border: "1px solid rgba(255,255,255,0.2)" }} @click={toggleHelp}>Controls</Button>
        <Button variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "rgba(255,255,255,0.1)", color: "#ffffff", border: "1px solid rgba(255,255,255,0.2)" }} @click={resetWorld}>New island</Button>
      </Stack>
    </Box>
  </Box>

  <Box if={started && showHelp} className="bs-ovl bs-pause">
    <Box className="bs-card">
      <Text style={{ display: "block", fontSize: "22px", fontWeight: 800, color: "#ffffff" }}>Controls</Text>
      <Box className="bs-keys">
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>W A S D</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>walk · <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>Shift</Text> sprint · <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>Space</Text> jump</Text>
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>LMB</Text> <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>RMB</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>mine · build on the face you aim at</Text>
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>1–9</Text> <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>wheel</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>choose a block · <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>MMB</Text> picks the aimed block</Text>
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>F</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>fly: <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>Space</Text> up, <Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>C</Text> down</Text>
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="bs-kbd" style={{ fontSize: "11px", color: "#fff" }}>Esc</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>release the cursor and pause</Text>
      </Box>
      <Text style={{ display: "block", marginTop: "16px", fontSize: "13px", color: "#c7d2e2" }}>The world saves itself every half minute, and when you press Save. H opens and closes this card.</Text>
      <Stack direction="horizontal" gap={10} style={{ justifyContent: "center", marginTop: "20px" }}>
        <Button variant="ghost" style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "#5cae4a", color: "#0b1a08", border: "1px solid #5cae4a", boxShadow: "0 10px 30px rgba(92,174,74,0.35)" }} @click={toggleHelp}>Back</Button>
      </Stack>
    </Box>
  </Box>
</Box>
