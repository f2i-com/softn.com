// dos_ops.logic — SoftDOS Opcode Tables and Execution Dispatch
//
// Builds the 256-entry one-byte and two-byte (0x0F) dispatch tables covering
// the 80386 integer instruction set: the ALU block, the shift and rotate
// groups, multiply and divide, the string instructions with their REP forms,
// stack and flag control, near and far control transfers, and the 386
// additions (MOVZX/MOVSX, SETcc, BT, BSF/BSR, SHLD/SHRD, BSWAP, CMOVcc).
//
// Every entry takes (is32Op, is32Addr) and returns a cycle estimate. The
// tables are dense: an unimplemented opcode is dosOps_illegal, which reports
// itself rather than silently running on through garbage.

let DOS_OPS = null;    // Array of 256 functions
let DOS_OPS_0F = null; // Array of 256 functions

// The last opcode the dispatcher could not handle, for the UI to surface.
let DOS_LAST_ILLEGAL = -1;
let DOS_ILLEGAL_COUNT = 0;

function dosOps_illegal(is32Op, is32Addr) {
  // EIP already stepped past the byte; report where it happened and stop the
  // CPU rather than executing whatever follows as if it were code.
  DOS_LAST_ILLEGAL = DOS_EIP >>> 0;
  DOS_ILLEGAL_COUNT++;
  DOS_HALTED = 1;
  return 4;
}

// ---------------------------------------------------------------------------
// Operand Accessors
// ---------------------------------------------------------------------------
// Byte registers interleave into the 32-bit file: AL/CL/DL/BL are the low
// byte of each of the first four registers, AH/CH/DH/BH the second byte.
function dosOps_reg8Slot(r) {
  return (r < 4) ? (r * 4) : ((r - 4) * 4 + 1);
}

function dosOps_getReg(r, size) {
  if (size === 1) return DOS_REGS8[dosOps_reg8Slot(r)];
  if (size === 2) return DOS_REGS16[r * 2];
  return DOS_REGS32[r] >>> 0;
}

function dosOps_setReg(r, size, v) {
  if (size === 1) { DOS_REGS8[dosOps_reg8Slot(r)] = v & 0xFF; return; }
  if (size === 2) { DOS_REGS16[r * 2] = v & 0xFFFF; return; }
  DOS_REGS32[r] = v >>> 0;
}

function dosOps_getRM(size) {
  if (DOS_MRM_ISREG) return dosOps_getReg(DOS_MRM_RM, size);
  if (size === 1) return DOS_RAM[DOS_MRM_ADDR & 0xFFFFFF];
  if (size === 2) return dosMmu_read16(DOS_MRM_ADDR);
  return dosMmu_read32(DOS_MRM_ADDR);
}

function dosOps_setRM(size, v) {
  if (DOS_MRM_ISREG) { dosOps_setReg(DOS_MRM_RM, size, v); return; }
  if (size === 1) {
    let a = DOS_MRM_ADDR & 0xFFFFFF;
    dosBc_touch(a);
    if (DOS_VGA_UNCHAINED === 1 && a >= 0xA0000 && a < 0xB0000) { dosVga_writePlanar(a - 0xA0000, v); return; }
    DOS_RAM[a] = v & 0xFF;
    return;
  }
  if (size === 2) { dosMmu_write16(DOS_MRM_ADDR, v); return; }
  dosMmu_write32(DOS_MRM_ADDR, v);
}

function dosOps_opSize(is32Op) { return is32Op ? 4 : 2; }

// ---------------------------------------------------------------------------
// ALU Helper Functions
// ---------------------------------------------------------------------------
function dosAlu_add(dst, src, size) {
  let mask = dosCpu_maskFor(size);
  let res = (dst + src) & mask;
  dosCpu_setLazy(1, dst, src, res, size);
  return res;
}

function dosAlu_adc(dst, src, size) {
  let mask = dosCpu_maskFor(size);
  let cin = dosCpu_getCF();
  dosCpu_flushFlags();
  if (cin) DOS_EFLAGS |= DOS_FL_CF; else DOS_EFLAGS &= ~DOS_FL_CF;
  let res = (dst + src + cin) & mask;
  dosCpu_setLazy(8, dst, src, res, size);
  return res;
}

function dosAlu_sub(dst, src, size) {
  let mask = dosCpu_maskFor(size);
  let res = (dst - src) & mask;
  dosCpu_setLazy(2, dst, src, res, size);
  return res;
}

function dosAlu_sbb(dst, src, size) {
  let mask = dosCpu_maskFor(size);
  let cin = dosCpu_getCF();
  dosCpu_flushFlags();
  if (cin) DOS_EFLAGS |= DOS_FL_CF; else DOS_EFLAGS &= ~DOS_FL_CF;
  let res = (dst - src - cin) & mask;
  dosCpu_setLazy(9, dst, src, res, size);
  return res;
}

function dosAlu_and(dst, src, size) {
  let res = (dst & src) & dosCpu_maskFor(size);
  dosCpu_setLazy(3, dst, src, res, size);
  return res;
}

function dosAlu_or(dst, src, size) {
  let res = (dst | src) & dosCpu_maskFor(size);
  dosCpu_setLazy(3, dst, src, res, size);
  return res;
}

function dosAlu_xor(dst, src, size) {
  let res = (dst ^ src) & dosCpu_maskFor(size);
  dosCpu_setLazy(3, dst, src, res, size);
  return res;
}

// The eight ALU operations by their encoding order in the 0x00-0x3F block and
// in group 1 (0x80-0x83): ADD OR ADC SBB AND SUB XOR CMP.
function dosAlu_do(op, dst, src, size) {
  if (op === 0) return dosAlu_add(dst, src, size);
  if (op === 1) return dosAlu_or(dst, src, size);
  if (op === 2) return dosAlu_adc(dst, src, size);
  if (op === 3) return dosAlu_sbb(dst, src, size);
  if (op === 4) return dosAlu_and(dst, src, size);
  if (op === 5) return dosAlu_sub(dst, src, size);
  if (op === 6) return dosAlu_xor(dst, src, size);
  return dosAlu_sub(dst, src, size); // 7 = CMP: computes, discards
}

function dosAlu_inc(dst, size) {
  let res = (dst + 1) & dosCpu_maskFor(size);
  dosCpu_getCF();          // CF survives INC: fold it in before the lazy swap
  dosCpu_flushFlags();
  dosCpu_setLazy(6, dst, 1, res, size);
  return res;
}

function dosAlu_dec(dst, size) {
  let res = (dst - 1) & dosCpu_maskFor(size);
  dosCpu_getCF();
  dosCpu_flushFlags();
  dosCpu_setLazy(7, dst, 1, res, size);
  return res;
}

// ---------------------------------------------------------------------------
// Shifts and Rotates (group 2: ROL ROR RCL RCR SHL SHR SAL SAR)
// ---------------------------------------------------------------------------
function dosOps_shift(op, val, cnt, size) {
  let bits = size * 8;
  let mask = dosCpu_maskFor(size);
  let sign = dosCpu_signFor(size);
  // 386 masks the count to 5 bits; a count of zero leaves the flags alone.
  let n = cnt & 31;
  if (n === 0) return val & mask;

  let v = val & mask;
  let cf = 0;
  let res = v;

  if (op === 0) {          // ROL
    let r = n % bits;
    res = ((v << r) | (v >>> (bits - r))) & mask;
    cf = res & 1;
    dosCpu_setCF(cf);
    if (n === 1) dosCpu_setOF((((res & sign) ? 1 : 0) ^ cf) !== 0);
    return res;
  }
  if (op === 1) {          // ROR
    let r = n % bits;
    res = ((v >>> r) | (v << (bits - r))) & mask;
    cf = (res & sign) ? 1 : 0;
    dosCpu_setCF(cf);
    if (n === 1) {
      let secondTop = (res & (sign >>> 1)) ? 1 : 0;
      dosCpu_setOF((cf ^ secondTop) !== 0);
    }
    return res;
  }
  if (op === 2) {          // RCL: rotate through carry
    let carry = dosCpu_getCF();
    let r = n % (bits + 1);
    let k = 0;
    res = v;
    while (k < r) {
      let top = (res & sign) ? 1 : 0;
      res = ((res << 1) | carry) & mask;
      carry = top;
      k++;
    }
    dosCpu_setCF(carry);
    if (n === 1) dosCpu_setOF(((((res & sign) ? 1 : 0)) ^ carry) !== 0);
    return res;
  }
  if (op === 3) {          // RCR
    let carry = dosCpu_getCF();
    let r = n % (bits + 1);
    let k = 0;
    res = v;
    while (k < r) {
      let bot = res & 1;
      res = ((res >>> 1) | (carry ? sign : 0)) & mask;
      carry = bot;
      k++;
    }
    dosCpu_setCF(carry);
    if (n === 1) {
      let secondTop = (res & (sign >>> 1)) ? 1 : 0;
      dosCpu_setOF(((((res & sign) ? 1 : 0)) ^ secondTop) !== 0);
    }
    return res;
  }
  if (op === 4 || op === 6) { // SHL / SAL
    if (n > bits) { res = 0; cf = 0; }
    else {
      cf = (v >>> (bits - n)) & 1;
      res = (v << n) & mask;
    }
    dosCpu_setResultFlags(res, size);
    dosCpu_setCF(cf);
    if (n === 1) dosCpu_setOF(((((res & sign) ? 1 : 0)) ^ cf) !== 0);
    return res;
  }
  if (op === 5) {          // SHR
    if (n > bits) { res = 0; cf = 0; }
    else {
      cf = (n === 0) ? 0 : ((v >>> (n - 1)) & 1);
      res = (v >>> n) & mask;
    }
    dosCpu_setResultFlags(res, size);
    dosCpu_setCF(cf);
    if (n === 1) dosCpu_setOF((v & sign) !== 0);
    return res;
  }
  // op === 7: SAR, sign-propagating
  let sv = v;
  if (size === 1) sv = (v << 24) >> 24;
  else if (size === 2) sv = (v << 16) >> 16;
  else sv = v | 0;
  let sh = (n > bits) ? bits : n;
  cf = (sv >> (sh - 1)) & 1;
  res = (sv >> sh) & mask;
  dosCpu_setResultFlags(res, size);
  dosCpu_setCF(cf);
  if (n === 1) dosCpu_setOF(false);
  return res;
}

// ---------------------------------------------------------------------------
// Multiply and Divide
// ---------------------------------------------------------------------------
function dosOps_mul(size) {
  if (size === 1) {
    let res = DOS_REGS8[0] * dosOps_getRM(1);
    DOS_REGS16[0] = res & 0xFFFF;
    let upper = (res >> 8) & 0xFF;
    dosCpu_setResultFlags(res & 0xFF, 1);
    dosCpu_setCF(upper !== 0);
    dosCpu_setOF(upper !== 0);
    return;
  }
  if (size === 2) {
    let res = DOS_REGS16[0] * dosOps_getRM(2);
    DOS_REGS16[0] = res & 0xFFFF;          // AX
    DOS_REGS16[4] = (res / 65536) & 0xFFFF; // DX
    let upper = Math.floor(res / 65536);
    dosCpu_setResultFlags(res & 0xFFFF, 2);
    dosCpu_setCF(upper !== 0);
    dosCpu_setOF(upper !== 0);
    return;
  }
  // 32 x 32 -> 64. Doubles hold the product exactly up to 2^53, so split the
  // multiplicand rather than trusting a single 64-bit product.
  let a = DOS_REGS32[0] >>> 0;
  let b = dosOps_getRM(4) >>> 0;
  let aLo = a & 0xFFFF, aHi = a >>> 16;
  let bLo = b & 0xFFFF, bHi = b >>> 16;
  let lolo = aLo * bLo;
  let lohi = aLo * bHi;
  let hilo = aHi * bLo;
  let hihi = aHi * bHi;
  let mid = lohi + hilo + (lolo >>> 16);
  let lo = ((mid & 0xFFFF) * 65536 + (lolo & 0xFFFF)) >>> 0;
  let hi = (hihi + Math.floor(mid / 65536)) >>> 0;
  DOS_REGS32[0] = lo;
  DOS_REGS32[2] = hi;
  dosCpu_setResultFlags(lo, 4);
  dosCpu_setCF(hi !== 0);
  dosCpu_setOF(hi !== 0);
}

// A double is exact only to 2^53, so a 32x32 product and a 64/32 divide both
// have to be done in 16-bit pieces. These write module-level scalars rather
// than returning an object: one allocation per multiply is not affordable.
let DOS_MUL_LO = 0;
let DOS_MUL_HI = 0;
let DOS_DIV_Q = 0;
let DOS_DIV_R = 0;

// Unsigned 32 x 32 -> 64.
function dosOps_umul64(a, b) {
  let aLo = a & 0xFFFF, aHi = a >>> 16;
  let bLo = b & 0xFFFF, bHi = b >>> 16;
  let lolo = aLo * bLo;
  let mid = aLo * bHi + aHi * bLo + (lolo >>> 16);
  DOS_MUL_LO = (((mid & 0xFFFF) * 65536) + (lolo & 0xFFFF)) >>> 0;
  DOS_MUL_HI = ((aHi * bHi) + Math.floor(mid / 65536)) >>> 0;
}

// Unsigned (hi:lo) / d by long division in base 2^16. Every intermediate stays
// below 2^48, so each one is exact. Returns 0 if the quotient will not fit in
// 32 bits, which on x86 is a divide error rather than a truncation.
function dosOps_udiv64(hi, lo, d) {
  if ((hi >>> 0) >= (d >>> 0)) return 0;
  let r = 0;
  let q = 0;
  let digit = 0;
  let cur = 0;
  let qd = 0;
  for (let i = 3; i >= 0; i--) {
    if (i === 3) digit = (hi >>> 16) & 0xFFFF;
    else if (i === 2) digit = hi & 0xFFFF;
    else if (i === 1) digit = (lo >>> 16) & 0xFFFF;
    else digit = lo & 0xFFFF;
    cur = (r * 65536) + digit;
    qd = Math.floor(cur / d);
    r = cur - (qd * d);
    q = ((q * 65536) + qd) >>> 0;
  }
  DOS_DIV_Q = q >>> 0;
  DOS_DIV_R = r >>> 0;
  return 1;
}

// Two's-complement negate of a 64-bit value held as two 32-bit halves.
function dosOps_neg64(hi, lo) {
  DOS_MUL_LO = ((~lo) + 1) >>> 0;
  DOS_MUL_HI = ((~hi) + ((lo >>> 0) === 0 ? 1 : 0)) >>> 0;
}

function dosOps_imul(size) {
  if (size === 1) {
    let a = (DOS_REGS8[0] << 24) >> 24;
    let b = (dosOps_getRM(1) << 24) >> 24;
    let res = a * b;
    DOS_REGS16[0] = res & 0xFFFF;
    let fits = (res >= -128 && res <= 127);
    dosCpu_setResultFlags(res & 0xFF, 1);
    dosCpu_setCF(!fits);
    dosCpu_setOF(!fits);
    return;
  }
  if (size === 2) {
    let a = (DOS_REGS16[0] << 16) >> 16;
    let b = (dosOps_getRM(2) << 16) >> 16;
    let res = a * b;
    DOS_REGS16[0] = res & 0xFFFF;
    DOS_REGS16[4] = (res >> 16) & 0xFFFF;
    let fits = (res >= -32768 && res <= 32767);
    dosCpu_setResultFlags(res & 0xFFFF, 2);
    dosCpu_setCF(!fits);
    dosCpu_setOF(!fits);
    return;
  }
  let a = DOS_REGS32[0] | 0;
  let b = dosOps_getRM(4) | 0;
  let lo = Math.imul(a, b) >>> 0;
  // Signed high half = unsigned high half, corrected once per negative operand.
  dosOps_umul64(a >>> 0, b >>> 0);
  let hi = DOS_MUL_HI;
  if (a < 0) hi = (hi - (b >>> 0)) >>> 0;
  if (b < 0) hi = (hi - (a >>> 0)) >>> 0;
  hi = hi >>> 0;
  DOS_REGS32[0] = lo;
  DOS_REGS32[2] = hi;
  // The product fits in 32 signed bits exactly when the high half is the sign
  // extension of the low half.
  let fits = ((hi === 0) && ((lo | 0) >= 0)) || ((hi === 4294967295) && ((lo | 0) < 0));
  dosCpu_setResultFlags(lo, 4);
  dosCpu_setCF(!fits);
  dosCpu_setOF(!fits);
}

// A divide by zero, or a quotient too large for the destination, raises INT 0
// on real hardware. Here it stops the CPU with a note rather than corrupting
// registers silently.
function dosOps_divideError() {
  DOS_LAST_ILLEGAL = DOS_EIP >>> 0;
  DOS_HALTED = 1;
}

function dosOps_div(size) {
  if (size === 1) {
    let d = dosOps_getRM(1);
    if (d === 0) { dosOps_divideError(); return; }
    let n = DOS_REGS16[0];
    let q = Math.floor(n / d);
    if (q > 0xFF) { dosOps_divideError(); return; }
    DOS_REGS8[0] = q & 0xFF;          // AL
    DOS_REGS8[1] = (n % d) & 0xFF;    // AH
    return;
  }
  if (size === 2) {
    let d = dosOps_getRM(2);
    if (d === 0) { dosOps_divideError(); return; }
    let n = (DOS_REGS16[4] * 65536) + DOS_REGS16[0];
    let q = Math.floor(n / d);
    if (q > 0xFFFF) { dosOps_divideError(); return; }
    DOS_REGS16[0] = q & 0xFFFF;
    DOS_REGS16[4] = (n % d) & 0xFFFF;
    return;
  }
  let d = dosOps_getRM(4) >>> 0;
  if (d === 0) { dosOps_divideError(); return; }
  if (dosOps_udiv64(DOS_REGS32[2] >>> 0, DOS_REGS32[0] >>> 0, d) === 0) {
    dosOps_divideError(); return;
  }
  DOS_REGS32[0] = DOS_DIV_Q >>> 0;
  DOS_REGS32[2] = DOS_DIV_R >>> 0;
}

function dosOps_idiv(size) {
  if (size === 1) {
    let d = (dosOps_getRM(1) << 24) >> 24;
    if (d === 0) { dosOps_divideError(); return; }
    let n = (DOS_REGS16[0] << 16) >> 16;
    let q = (n / d) | 0;
    if (q > 127 || q < -128) { dosOps_divideError(); return; }
    DOS_REGS8[0] = q & 0xFF;
    DOS_REGS8[1] = (n - q * d) & 0xFF;
    return;
  }
  if (size === 2) {
    let d = (dosOps_getRM(2) << 16) >> 16;
    if (d === 0) { dosOps_divideError(); return; }
    let n = ((DOS_REGS16[4] << 16) | DOS_REGS16[0]) | 0;
    let q = (n / d) | 0;
    if (q > 32767 || q < -32768) { dosOps_divideError(); return; }
    DOS_REGS16[0] = q & 0xFFFF;
    DOS_REGS16[4] = (n - q * d) & 0xFFFF;
    return;
  }
  let d = dosOps_getRM(4) | 0;
  if (d === 0) { dosOps_divideError(); return; }
  // Divide the magnitudes, then re-apply the signs: the quotient takes the sign
  // of both operands, the remainder the sign of the dividend.
  let nHi = DOS_REGS32[2] | 0;
  let nLo = DOS_REGS32[0] >>> 0;
  let nNeg = (nHi < 0) ? 1 : 0;
  if (nNeg === 1) { dosOps_neg64(nHi >>> 0, nLo); nHi = DOS_MUL_HI; nLo = DOS_MUL_LO; }
  let dNeg = (d < 0) ? 1 : 0;
  let dAbs = (dNeg === 1) ? ((-d) >>> 0) : (d >>> 0);
  if (dosOps_udiv64(nHi >>> 0, nLo >>> 0, dAbs) === 0) { dosOps_divideError(); return; }
  let q = DOS_DIV_Q >>> 0;
  let r = DOS_DIV_R >>> 0;
  let qNeg = (nNeg !== dNeg) ? 1 : 0;
  if (qNeg === 1) {
    if (q > 2147483648) { dosOps_divideError(); return; }
    q = (-q) >>> 0;
  } else {
    if (q > 2147483647) { dosOps_divideError(); return; }
  }
  if (nNeg === 1) r = (-r) >>> 0;
  DOS_REGS32[0] = q >>> 0;
  DOS_REGS32[2] = r >>> 0;
}

// ---------------------------------------------------------------------------
// String Instructions
// ---------------------------------------------------------------------------
// SI/DI (or ESI/EDI) step by the operand size, forwards or backwards by DF.
// The source segment is overridable, the destination is always ES.
function dosOps_strSrcAddr(is32Addr) {
  let segIdx = (DOS_PREFIX_SEG >= 0) ? DOS_PREFIX_SEG : 3; // DS
  let off = is32Addr ? (DOS_REGS32[6] >>> 0) : DOS_REGS16[12];
  return dosMmu_linear(DOS_SEGS[segIdx], off);
}
function dosOps_strDstAddr(is32Addr) {
  let off = is32Addr ? (DOS_REGS32[7] >>> 0) : DOS_REGS16[14];
  return dosMmu_linear(DOS_SEGS[0], off); // ES
}
function dosOps_strStep(is32Addr, size) {
  let delta = (DOS_EFLAGS & DOS_FL_DF) ? -size : size;
  if (is32Addr) {
    DOS_REGS32[6] = (DOS_REGS32[6] + delta) >>> 0;
    DOS_REGS32[7] = (DOS_REGS32[7] + delta) >>> 0;
  } else {
    DOS_REGS16[12] = (DOS_REGS16[12] + delta) & 0xFFFF;
    DOS_REGS16[14] = (DOS_REGS16[14] + delta) & 0xFFFF;
  }
}
function dosOps_strStepSI(is32Addr, size) {
  let delta = (DOS_EFLAGS & DOS_FL_DF) ? -size : size;
  if (is32Addr) DOS_REGS32[6] = (DOS_REGS32[6] + delta) >>> 0;
  else DOS_REGS16[12] = (DOS_REGS16[12] + delta) & 0xFFFF;
}
function dosOps_strStepDI(is32Addr, size) {
  let delta = (DOS_EFLAGS & DOS_FL_DF) ? -size : size;
  if (is32Addr) DOS_REGS32[7] = (DOS_REGS32[7] + delta) >>> 0;
  else DOS_REGS16[14] = (DOS_REGS16[14] + delta) & 0xFFFF;
}
function dosOps_getCount(is32Addr) {
  return is32Addr ? (DOS_REGS32[1] >>> 0) : DOS_REGS16[2];
}
function dosOps_setCount(is32Addr, v) {
  if (is32Addr) DOS_REGS32[1] = v >>> 0;
  else DOS_REGS16[2] = v & 0xFFFF;
}

function dosOps_readSize(addr, size) {
  if (size === 1) {
    let ra = addr & 0xFFFFFF;
    if (DOS_VGA_UNCHAINED === 1 && ra >= 0xA0000 && ra < 0xB0000) return dosVga_readPlanar(ra - 0xA0000);
    return DOS_RAM[ra];
  }
  if (size === 2) return dosMmu_read16(addr);
  return dosMmu_read32(addr);
}
function dosOps_writeSize(addr, size, v) {
  if (size === 1) {
    let a = addr & 0xFFFFFF;
    dosBc_touch(a);
    if (DOS_VGA_UNCHAINED === 1 && a >= 0xA0000 && a < 0xB0000) { dosVga_writePlanar(a - 0xA0000, v); return; }
    DOS_RAM[a] = v & 0xFF;
    return;
  }
  if (size === 2) { dosMmu_write16(addr, v); return; }
  dosMmu_write32(addr, v);
}

// kind: 0=MOVS 1=STOS 2=LODS 3=SCAS 4=CMPS
function dosOps_string(kind, size, is32Addr) {
  dosCpu_flushFlags();
  let rep = DOS_PREFIX_REP;
  let count = rep ? dosOps_getCount(is32Addr) : 1;
  if (rep && count === 0) return 4;

  let done = 0;
  // A long REP is bounded so one instruction cannot stall the frame; the
  // remainder resumes on the next step. Only a run cut short by that cap may
  // resume: one that stopped on its ZF condition is finished, and rewinding
  // it would restart the scan for ever.
  let limit = 65536;
  let cutShort = 0;
  let stoppedOnZF = 0;

  while (done < count) {
    if (kind === 0) {        // MOVS
      dosOps_writeSize(dosOps_strDstAddr(is32Addr), size, dosOps_readSize(dosOps_strSrcAddr(is32Addr), size));
      dosOps_strStep(is32Addr, size);
    } else if (kind === 1) { // STOS
      dosOps_writeSize(dosOps_strDstAddr(is32Addr), size, dosOps_getReg(0, size));
      dosOps_strStepDI(is32Addr, size);
    } else if (kind === 2) { // LODS
      dosOps_setReg(0, size, dosOps_readSize(dosOps_strSrcAddr(is32Addr), size));
      dosOps_strStepSI(is32Addr, size);
    } else if (kind === 3) { // SCAS: AL/AX/EAX - [ES:DI]
      let v = dosOps_readSize(dosOps_strDstAddr(is32Addr), size);
      dosAlu_sub(dosOps_getReg(0, size), v, size);
      dosOps_strStepDI(is32Addr, size);
    } else {                 // CMPS: [DS:SI] - [ES:DI]
      let a = dosOps_readSize(dosOps_strSrcAddr(is32Addr), size);
      let b = dosOps_readSize(dosOps_strDstAddr(is32Addr), size);
      dosAlu_sub(a, b, size);
      dosOps_strStep(is32Addr, size);
    }
    done++;
    if (rep && (kind === 3 || kind === 4)) {
      // REPE stops when ZF clears, REPNE when it sets.
      let zf = dosCpu_getZF();
      if (rep === 1 && zf === 0) { stoppedOnZF = 1; break; }
      if (rep === 2 && zf === 1) { stoppedOnZF = 1; break; }
    }
    if (done >= limit) { cutShort = 1; break; }
  }

  if (rep) dosOps_setCount(is32Addr, count - done);
  if (rep && cutShort && !stoppedOnZF && (count - done) > 0) {
    // Resume the rest next step, from the instruction's first prefix byte.
    DOS_EIP = DOS_INSN_EIP >>> 0;
  }
  return 4 + done * 2;
}

// ---------------------------------------------------------------------------
// Jcc Condition Evaluator
// ---------------------------------------------------------------------------
function dosOps_evalCondition(cond) {
  let type = cond & 0x0E;
  let invert = cond & 1;
  let met = 0;

  if (type === 0x00) met = dosCpu_getOF();                        // O / NO
  else if (type === 0x02) met = dosCpu_getCF();                   // B / C / NAE
  else if (type === 0x04) met = dosCpu_getZF();                   // Z / E
  else if (type === 0x06) met = (dosCpu_getCF() || dosCpu_getZF()) ? 1 : 0; // BE / NA
  else if (type === 0x08) met = dosCpu_getSF();                   // S / NS
  else if (type === 0x0A) met = dosCpu_getPF();                   // P / NP
  else if (type === 0x0C) met = (dosCpu_getSF() !== dosCpu_getOF()) ? 1 : 0; // L / NGE
  else if (type === 0x0E) met = (dosCpu_getZF() || (dosCpu_getSF() !== dosCpu_getOF())) ? 1 : 0; // LE / NG

  return invert ? (met === 0) : (met !== 0);
}

// A near jump target, wrapped to the code segment's width.
function dosOps_jumpRel(rel, is32Op) {
  if (DOS_IS_32 === 1) DOS_EIP = (DOS_EIP + rel) >>> 0;
  else DOS_EIP = (DOS_EIP + rel) & 0xFFFF;
}

// ---------------------------------------------------------------------------
// Table Initializer
// ---------------------------------------------------------------------------
function dosOps_init() {
  if (DOS_OPS) return;

  DOS_OPS = new Array(256);
  DOS_OPS_0F = new Array(256);

  for (let i = 0; i < 256; i++) {
    DOS_OPS[i] = dosOps_illegal;
    DOS_OPS_0F[i] = dosOps_illegal;
  }

  // -------------------------------------------------------------------------
  // 0x00-0x3F: the ALU block. Eight operations, six forms each.
  // -------------------------------------------------------------------------
  for (let a = 0; a < 8; a++) {
    (function (op) {
      let base = op * 8;
      // op r/m8, r8
      DOS_OPS[base + 0] = function (is32Op, is32Addr) {
        dosCpu_modrm(is32Addr);
        let res = dosAlu_do(op, dosOps_getRM(1), dosOps_getReg(DOS_MRM_REG, 1), 1);
        if (op !== 7) dosOps_setRM(1, res);
        return 3;
      };
      // op r/m16/32, r16/32
      DOS_OPS[base + 1] = function (is32Op, is32Addr) {
        let sz = dosOps_opSize(is32Op);
        dosCpu_modrm(is32Addr);
        let res = dosAlu_do(op, dosOps_getRM(sz), dosOps_getReg(DOS_MRM_REG, sz), sz);
        if (op !== 7) dosOps_setRM(sz, res);
        return 3;
      };
      // op r8, r/m8
      DOS_OPS[base + 2] = function (is32Op, is32Addr) {
        dosCpu_modrm(is32Addr);
        let res = dosAlu_do(op, dosOps_getReg(DOS_MRM_REG, 1), dosOps_getRM(1), 1);
        if (op !== 7) dosOps_setReg(DOS_MRM_REG, 1, res);
        return 3;
      };
      // op r16/32, r/m16/32
      DOS_OPS[base + 3] = function (is32Op, is32Addr) {
        let sz = dosOps_opSize(is32Op);
        dosCpu_modrm(is32Addr);
        let res = dosAlu_do(op, dosOps_getReg(DOS_MRM_REG, sz), dosOps_getRM(sz), sz);
        if (op !== 7) dosOps_setReg(DOS_MRM_REG, sz, res);
        return 3;
      };
      // op AL, imm8
      DOS_OPS[base + 4] = function (is32Op, is32Addr) {
        let res = dosAlu_do(op, DOS_REGS8[0], dosCpu_fetchU8(), 1);
        if (op !== 7) DOS_REGS8[0] = res & 0xFF;
        return 2;
      };
      // op eAX, imm16/32
      DOS_OPS[base + 5] = function (is32Op, is32Addr) {
        let sz = dosOps_opSize(is32Op);
        let res = dosAlu_do(op, dosOps_getReg(0, sz), dosCpu_fetchImm(is32Op), sz);
        if (op !== 7) dosOps_setReg(0, sz, res);
        return 2;
      };
    })(a);
  }

  // Segment pushes and pops that live inside the ALU block's spare slots.
  DOS_OPS[0x06] = function (is32Op) { dosCpu_pushSize(DOS_SEGS[0], is32Op); return 2; }; // PUSH ES
  DOS_OPS[0x07] = function (is32Op) { DOS_SEGS[0] = dosCpu_popSize(is32Op) & 0xFFFF; return 3; }; // POP ES
  DOS_OPS[0x0E] = function (is32Op) { dosCpu_pushSize(DOS_SEGS[1], is32Op); return 2; }; // PUSH CS
  DOS_OPS[0x16] = function (is32Op) { dosCpu_pushSize(DOS_SEGS[2], is32Op); return 2; }; // PUSH SS
  DOS_OPS[0x17] = function (is32Op) { DOS_SEGS[2] = dosCpu_popSize(is32Op) & 0xFFFF; return 3; }; // POP SS
  DOS_OPS[0x1E] = function (is32Op) { dosCpu_pushSize(DOS_SEGS[3], is32Op); return 2; }; // PUSH DS
  DOS_OPS[0x1F] = function (is32Op) { DOS_SEGS[3] = dosCpu_popSize(is32Op) & 0xFFFF; return 3; }; // POP DS

  // Decimal adjust instructions. Rarely seen outside old code, cheap to keep.
  DOS_OPS[0x27] = function () { // DAA
    dosCpu_flushFlags();
    let al = DOS_REGS8[0];
    let cf = (DOS_EFLAGS & DOS_FL_CF) ? 1 : 0;
    let af = (DOS_EFLAGS & DOS_FL_AF) ? 1 : 0;
    let newCf = 0;
    if ((al & 0x0F) > 9 || af) { al = al + 6; newCf = cf | ((al > 0xFF) ? 1 : 0); af = 1; } else af = 0;
    if (((DOS_REGS8[0]) > 0x99) || cf) { al = al + 0x60; newCf = 1; }
    DOS_REGS8[0] = al & 0xFF;
    dosCpu_setResultFlags(al & 0xFF, 1);
    dosCpu_setCF(newCf !== 0);
    if (af) DOS_EFLAGS |= DOS_FL_AF; else DOS_EFLAGS &= ~DOS_FL_AF;
    return 4;
  };
  DOS_OPS[0x2F] = function () { // DAS
    dosCpu_flushFlags();
    let al = DOS_REGS8[0];
    let cf = (DOS_EFLAGS & DOS_FL_CF) ? 1 : 0;
    let af = (DOS_EFLAGS & DOS_FL_AF) ? 1 : 0;
    let newCf = 0;
    let old = al;
    if ((al & 0x0F) > 9 || af) { al = al - 6; newCf = cf | ((al < 0) ? 1 : 0); af = 1; } else af = 0;
    if (old > 0x99 || cf) { al = al - 0x60; newCf = 1; }
    DOS_REGS8[0] = al & 0xFF;
    dosCpu_setResultFlags(al & 0xFF, 1);
    dosCpu_setCF(newCf !== 0);
    if (af) DOS_EFLAGS |= DOS_FL_AF; else DOS_EFLAGS &= ~DOS_FL_AF;
    return 4;
  };
  DOS_OPS[0x37] = function () { // AAA
    dosCpu_flushFlags();
    let af = (DOS_EFLAGS & DOS_FL_AF) ? 1 : 0;
    if ((DOS_REGS8[0] & 0x0F) > 9 || af) {
      DOS_REGS8[0] = (DOS_REGS8[0] + 6) & 0x0F;
      DOS_REGS8[1] = (DOS_REGS8[1] + 1) & 0xFF;
      dosCpu_setCF(true);
      DOS_EFLAGS |= DOS_FL_AF;
    } else {
      DOS_REGS8[0] = DOS_REGS8[0] & 0x0F;
      dosCpu_setCF(false);
      DOS_EFLAGS &= ~DOS_FL_AF;
    }
    return 4;
  };
  DOS_OPS[0x3F] = function () { // AAS
    dosCpu_flushFlags();
    let af = (DOS_EFLAGS & DOS_FL_AF) ? 1 : 0;
    if ((DOS_REGS8[0] & 0x0F) > 9 || af) {
      DOS_REGS8[0] = (DOS_REGS8[0] - 6) & 0x0F;
      DOS_REGS8[1] = (DOS_REGS8[1] - 1) & 0xFF;
      dosCpu_setCF(true);
      DOS_EFLAGS |= DOS_FL_AF;
    } else {
      DOS_REGS8[0] = DOS_REGS8[0] & 0x0F;
      dosCpu_setCF(false);
      DOS_EFLAGS &= ~DOS_FL_AF;
    }
    return 4;
  };

  // -------------------------------------------------------------------------
  // 0x40-0x5F: INC / DEC / PUSH / POP by register
  // -------------------------------------------------------------------------
  for (let r = 0; r < 8; r++) {
    (function (regIdx) {
      DOS_OPS[0x40 + regIdx] = function (is32Op) {
        let sz = dosOps_opSize(is32Op);
        dosOps_setReg(regIdx, sz, dosAlu_inc(dosOps_getReg(regIdx, sz), sz));
        return 2;
      };
      DOS_OPS[0x48 + regIdx] = function (is32Op) {
        let sz = dosOps_opSize(is32Op);
        dosOps_setReg(regIdx, sz, dosAlu_dec(dosOps_getReg(regIdx, sz), sz));
        return 2;
      };
      DOS_OPS[0x50 + regIdx] = function (is32Op) {
        dosCpu_pushSize(dosOps_getReg(regIdx, dosOps_opSize(is32Op)), is32Op);
        return 2;
      };
      DOS_OPS[0x58 + regIdx] = function (is32Op) {
        dosOps_setReg(regIdx, dosOps_opSize(is32Op), dosCpu_popSize(is32Op));
        return 2;
      };
      // XCHG eAX, reg (0x90 + r); 0x90 with r = 0 is NOP
      DOS_OPS[0x90 + regIdx] = function (is32Op) {
        if (regIdx === 0) return 1;
        let sz = dosOps_opSize(is32Op);
        let tmp = dosOps_getReg(0, sz);
        dosOps_setReg(0, sz, dosOps_getReg(regIdx, sz));
        dosOps_setReg(regIdx, sz, tmp);
        return 3;
      };
      // MOV r8, imm8 (0xB0 + r)
      DOS_OPS[0xB0 + regIdx] = function () {
        DOS_REGS8[dosOps_reg8Slot(regIdx)] = dosCpu_fetchU8();
        return 2;
      };
      // MOV r16/r32, imm16/imm32 (0xB8 + r)
      DOS_OPS[0xB8 + regIdx] = function (is32Op) {
        dosOps_setReg(regIdx, dosOps_opSize(is32Op), dosCpu_fetchImm(is32Op));
        return 2;
      };
    })(r);
  }

  // PUSHA / POPA
  DOS_OPS[0x60] = function (is32Op) {
    let sz = dosOps_opSize(is32Op);
    let sp = dosOps_getReg(4, sz);
    for (let i = 0; i < 8; i++) {
      dosCpu_pushSize(i === 4 ? sp : dosOps_getReg(i, sz), is32Op);
    }
    return 9;
  };
  DOS_OPS[0x61] = function (is32Op) {
    let sz = dosOps_opSize(is32Op);
    for (let i = 7; i >= 0; i--) {
      let v = dosCpu_popSize(is32Op);
      if (i !== 4) dosOps_setReg(i, sz, v); // the saved SP slot is discarded
    }
    return 9;
  };

  // PUSH imm16/32 and PUSH imm8 (sign-extended)
  DOS_OPS[0x68] = function (is32Op) { dosCpu_pushSize(dosCpu_fetchImm(is32Op), is32Op); return 2; };
  DOS_OPS[0x6A] = function (is32Op) { dosCpu_pushSize(dosCpu_sext8(dosCpu_fetchU8()), is32Op); return 2; };

  // IMUL r, r/m, imm
  DOS_OPS[0x69] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let a = dosOps_getRM(sz);
    let sa = (sz === 2) ? ((a << 16) >> 16) : (a | 0);
    let imm = dosCpu_fetchImm(is32Op);
    let si = (sz === 2) ? ((imm << 16) >> 16) : (imm | 0);
    let res = sa * si;
    // Only the fits test may look at the double; the stored value has to be the
    // exact wrapping product, which a double has already rounded past 2^53.
    let prod = (sz === 4) ? (Math.imul(sa, si) >>> 0) : res;
    dosOps_setReg(DOS_MRM_REG, sz, prod);
    let fits = (sz === 2) ? (res >= -32768 && res <= 32767) : (res >= -2147483648 && res <= 2147483647);
    dosCpu_setResultFlags(prod, sz);
    dosCpu_setCF(!fits);
    dosCpu_setOF(!fits);
    return 10;
  };
  DOS_OPS[0x6B] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let a = dosOps_getRM(sz);
    let sa = (sz === 2) ? ((a << 16) >> 16) : (a | 0);
    let si = dosCpu_sext8(dosCpu_fetchU8());
    let res = sa * si;
    // Only the fits test may look at the double; the stored value has to be the
    // exact wrapping product, which a double has already rounded past 2^53.
    let prod = (sz === 4) ? (Math.imul(sa, si) >>> 0) : res;
    dosOps_setReg(DOS_MRM_REG, sz, prod);
    let fits = (sz === 2) ? (res >= -32768 && res <= 32767) : (res >= -2147483648 && res <= 2147483647);
    dosCpu_setResultFlags(prod, sz);
    dosCpu_setCF(!fits);
    dosCpu_setOF(!fits);
    return 10;
  };

  // -------------------------------------------------------------------------
  // 0x70-0x7F: Jcc rel8
  // -------------------------------------------------------------------------
  for (let c = 0; c < 16; c++) {
    (function (cond) {
      DOS_OPS[0x70 + cond] = function (is32Op) {
        let rel = dosCpu_sext8(dosCpu_fetchU8());
        if (dosOps_evalCondition(cond)) { dosOps_jumpRel(rel, is32Op); return 3; }
        return 1;
      };
      DOS_OPS_0F[0x80 + cond] = function (is32Op) {
        let rel = is32Op ? (dosCpu_fetchU32() | 0) : dosCpu_sext16(dosCpu_fetchU16());
        if (dosOps_evalCondition(cond)) { dosOps_jumpRel(rel, is32Op); return 3; }
        return 1;
      };
      // SETcc r/m8
      DOS_OPS_0F[0x90 + cond] = function (is32Op, is32Addr) {
        dosCpu_modrm(is32Addr);
        dosOps_setRM(1, dosOps_evalCondition(cond) ? 1 : 0);
        return 3;
      };
      // CMOVcc r, r/m
      DOS_OPS_0F[0x40 + cond] = function (is32Op, is32Addr) {
        let sz = dosOps_opSize(is32Op);
        dosCpu_modrm(is32Addr);
        let v = dosOps_getRM(sz);
        if (dosOps_evalCondition(cond)) dosOps_setReg(DOS_MRM_REG, sz, v);
        return 2;
      };
    })(c);
  }

  // -------------------------------------------------------------------------
  // 0x80-0x83: group 1, ALU r/m with an immediate
  // -------------------------------------------------------------------------
  DOS_OPS[0x80] = function (is32Op, is32Addr) {
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    let res = dosAlu_do(op, dosOps_getRM(1), dosCpu_fetchU8(), 1);
    if (op !== 7) dosOps_setRM(1, res);
    return 3;
  };
  DOS_OPS[0x81] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    let res = dosAlu_do(op, dosOps_getRM(sz), dosCpu_fetchImm(is32Op), sz);
    if (op !== 7) dosOps_setRM(sz, res);
    return 3;
  };
  DOS_OPS[0x82] = DOS_OPS[0x80]; // undocumented alias
  DOS_OPS[0x83] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    let imm = dosCpu_sext8(dosCpu_fetchU8()) & dosCpu_maskFor(sz);
    let res = dosAlu_do(op, dosOps_getRM(sz), imm, sz);
    if (op !== 7) dosOps_setRM(sz, res);
    return 3;
  };

  // TEST and XCHG
  DOS_OPS[0x84] = function (is32Op, is32Addr) {
    dosCpu_modrm(is32Addr);
    dosAlu_and(dosOps_getRM(1), dosOps_getReg(DOS_MRM_REG, 1), 1);
    return 2;
  };
  DOS_OPS[0x85] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    dosAlu_and(dosOps_getRM(sz), dosOps_getReg(DOS_MRM_REG, sz), sz);
    return 2;
  };
  DOS_OPS[0x86] = function (is32Op, is32Addr) {
    dosCpu_modrm(is32Addr);
    let a = dosOps_getRM(1);
    let b = dosOps_getReg(DOS_MRM_REG, 1);
    dosOps_setRM(1, b);
    dosOps_setReg(DOS_MRM_REG, 1, a);
    return 4;
  };
  DOS_OPS[0x87] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let a = dosOps_getRM(sz);
    let b = dosOps_getReg(DOS_MRM_REG, sz);
    dosOps_setRM(sz, b);
    dosOps_setReg(DOS_MRM_REG, sz, a);
    return 4;
  };

  // -------------------------------------------------------------------------
  // 0x88-0x8F: MOV, LEA, segment moves, POP r/m
  // -------------------------------------------------------------------------
  DOS_OPS[0x88] = function (is32Op, is32Addr) {
    dosCpu_modrm(is32Addr);
    dosOps_setRM(1, dosOps_getReg(DOS_MRM_REG, 1));
    return 2;
  };
  DOS_OPS[0x89] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    dosOps_setRM(sz, dosOps_getReg(DOS_MRM_REG, sz));
    return 2;
  };
  DOS_OPS[0x8A] = function (is32Op, is32Addr) {
    dosCpu_modrm(is32Addr);
    dosOps_setReg(DOS_MRM_REG, 1, dosOps_getRM(1));
    return 2;
  };
  DOS_OPS[0x8B] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    dosOps_setReg(DOS_MRM_REG, sz, dosOps_getRM(sz));
    return 2;
  };
  DOS_OPS[0x8C] = function (is32Op, is32Addr) { // MOV r/m16, Sreg
    dosCpu_modrm(is32Addr);
    dosOps_setRM(DOS_MRM_ISREG ? dosOps_opSize(is32Op) : 2, DOS_SEGS[DOS_MRM_REG & 7]);
    return 2;
  };
  DOS_OPS[0x8D] = function (is32Op, is32Addr) { // LEA r, m
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    dosOps_setReg(DOS_MRM_REG, sz, DOS_MRM_OFFSET);
    return 2;
  };
  DOS_OPS[0x8E] = function (is32Op, is32Addr) { // MOV Sreg, r/m16
    dosCpu_modrm(is32Addr);
    DOS_SEGS[DOS_MRM_REG & 7] = dosOps_getRM(2) & 0xFFFF;
    return 2;
  };
  DOS_OPS[0x8F] = function (is32Op, is32Addr) { // POP r/m
    let sz = dosOps_opSize(is32Op);
    let v = dosCpu_popSize(is32Op);
    dosCpu_modrm(is32Addr);
    dosOps_setRM(sz, v);
    return 3;
  };

  // -------------------------------------------------------------------------
  // 0x98-0x9F: conversions, far call, flag transfers
  // -------------------------------------------------------------------------
  DOS_OPS[0x98] = function (is32Op) { // CBW / CWDE
    if (is32Op) DOS_REGS32[0] = ((DOS_REGS16[0] << 16) >> 16) >>> 0;
    else DOS_REGS16[0] = ((DOS_REGS8[0] << 24) >> 24) & 0xFFFF;
    return 2;
  };
  DOS_OPS[0x99] = function (is32Op) { // CWD / CDQ
    if (is32Op) DOS_REGS32[2] = ((DOS_REGS32[0] & 0x80000000) ? 0xFFFFFFFF : 0) >>> 0;
    else DOS_REGS16[4] = (DOS_REGS16[0] & 0x8000) ? 0xFFFF : 0;
    return 2;
  };
  DOS_OPS[0x9A] = function (is32Op) { // CALL far ptr16:16/32
    let off = dosCpu_fetchImm(is32Op);
    let seg = dosCpu_fetchU16();
    dosCpu_pushSize(DOS_SEGS[1], is32Op);
    dosCpu_pushSize(DOS_EIP, is32Op);
    DOS_SEGS[1] = seg;
    DOS_EIP = off >>> 0;
    return 8;
  };
  DOS_OPS[0x9B] = function () { return 1; }; // WAIT
  DOS_OPS[0x9C] = function (is32Op) { // PUSHF / PUSHFD
    dosCpu_flushFlags();
    dosCpu_pushSize(DOS_EFLAGS, is32Op);
    return 3;
  };
  DOS_OPS[0x9D] = function (is32Op) { // POPF / POPFD
    DOS_EFLAGS = (dosCpu_popSize(is32Op) | 0x0002) >>> 0;
    DOS_LAZY_OP = 0;
    return 3;
  };
  DOS_OPS[0x9E] = function () { // SAHF
    dosCpu_flushFlags();
    let ah = DOS_REGS8[1];
    DOS_EFLAGS = ((DOS_EFLAGS & ~0xD5) | (ah & 0xD5)) >>> 0;
    return 2;
  };
  DOS_OPS[0x9F] = function () { // LAHF
    dosCpu_flushFlags();
    DOS_REGS8[1] = (DOS_EFLAGS & 0xD5) | 0x02;
    return 2;
  };

  // -------------------------------------------------------------------------
  // 0xA0-0xA3: MOV between the accumulator and a direct address
  // -------------------------------------------------------------------------
  DOS_OPS[0xA0] = function (is32Op, is32Addr) {
    let off = is32Addr ? dosCpu_fetchU32() : dosCpu_fetchU16();
    let segIdx = (DOS_PREFIX_SEG >= 0) ? DOS_PREFIX_SEG : 3;
    DOS_REGS8[0] = DOS_RAM[dosMmu_linear(DOS_SEGS[segIdx], off) & 0xFFFFFF];
    return 2;
  };
  DOS_OPS[0xA1] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    let off = is32Addr ? dosCpu_fetchU32() : dosCpu_fetchU16();
    let segIdx = (DOS_PREFIX_SEG >= 0) ? DOS_PREFIX_SEG : 3;
    dosOps_setReg(0, sz, dosOps_readSize(dosMmu_linear(DOS_SEGS[segIdx], off), sz));
    return 2;
  };
  DOS_OPS[0xA2] = function (is32Op, is32Addr) {
    let off = is32Addr ? dosCpu_fetchU32() : dosCpu_fetchU16();
    let segIdx = (DOS_PREFIX_SEG >= 0) ? DOS_PREFIX_SEG : 3;
    DOS_RAM[dosMmu_linear(DOS_SEGS[segIdx], off) & 0xFFFFFF] = DOS_REGS8[0];
    return 2;
  };
  DOS_OPS[0xA3] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    let off = is32Addr ? dosCpu_fetchU32() : dosCpu_fetchU16();
    let segIdx = (DOS_PREFIX_SEG >= 0) ? DOS_PREFIX_SEG : 3;
    dosOps_writeSize(dosMmu_linear(DOS_SEGS[segIdx], off), sz, dosOps_getReg(0, sz));
    return 2;
  };

  // -------------------------------------------------------------------------
  // 0xA4-0xAF: string instructions and accumulator TEST
  // -------------------------------------------------------------------------
  DOS_OPS[0xA4] = function (is32Op, is32Addr) { return dosOps_string(0, 1, is32Addr); }; // MOVSB
  DOS_OPS[0xA5] = function (is32Op, is32Addr) { return dosOps_string(0, dosOps_opSize(is32Op), is32Addr); }; // MOVSW/D
  DOS_OPS[0xA6] = function (is32Op, is32Addr) { return dosOps_string(4, 1, is32Addr); }; // CMPSB
  DOS_OPS[0xA7] = function (is32Op, is32Addr) { return dosOps_string(4, dosOps_opSize(is32Op), is32Addr); };
  DOS_OPS[0xA8] = function () { dosAlu_and(DOS_REGS8[0], dosCpu_fetchU8(), 1); return 2; };
  DOS_OPS[0xA9] = function (is32Op) {
    let sz = dosOps_opSize(is32Op);
    dosAlu_and(dosOps_getReg(0, sz), dosCpu_fetchImm(is32Op), sz);
    return 2;
  };
  DOS_OPS[0xAA] = function (is32Op, is32Addr) { return dosOps_string(1, 1, is32Addr); }; // STOSB
  DOS_OPS[0xAB] = function (is32Op, is32Addr) { return dosOps_string(1, dosOps_opSize(is32Op), is32Addr); };
  DOS_OPS[0xAC] = function (is32Op, is32Addr) { return dosOps_string(2, 1, is32Addr); }; // LODSB
  DOS_OPS[0xAD] = function (is32Op, is32Addr) { return dosOps_string(2, dosOps_opSize(is32Op), is32Addr); };
  DOS_OPS[0xAE] = function (is32Op, is32Addr) { return dosOps_string(3, 1, is32Addr); }; // SCASB
  DOS_OPS[0xAF] = function (is32Op, is32Addr) { return dosOps_string(3, dosOps_opSize(is32Op), is32Addr); };

  // -------------------------------------------------------------------------
  // 0xC0-0xCF: shifts by immediate, returns, MOV imm, ENTER/LEAVE, interrupts
  // -------------------------------------------------------------------------
  DOS_OPS[0xC0] = function (is32Op, is32Addr) {
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    let v = dosOps_getRM(1);
    let cnt = dosCpu_fetchU8();
    dosOps_setRM(1, dosOps_shift(op, v, cnt, 1));
    return 3;
  };
  DOS_OPS[0xC1] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    let v = dosOps_getRM(sz);
    let cnt = dosCpu_fetchU8();
    dosOps_setRM(sz, dosOps_shift(op, v, cnt, sz));
    return 3;
  };
  DOS_OPS[0xC2] = function (is32Op) { // RET imm16
    let n = dosCpu_fetchU16();
    DOS_EIP = dosCpu_popSize(is32Op) >>> 0;
    if (DOS_IS_32 === 1) DOS_REGS32[4] = (DOS_REGS32[4] + n) >>> 0;
    else DOS_REGS32[4] = (DOS_REGS32[4] & 0xFFFF0000) | ((DOS_REGS32[4] + n) & 0xFFFF);
    return 5;
  };
  DOS_OPS[0xC3] = function (is32Op) { // RET
    DOS_EIP = dosCpu_popSize(is32Op) >>> 0;
    return 5;
  };
  DOS_OPS[0xC4] = function (is32Op, is32Addr) { // LES r, m16:16
    dosCpu_modrm(is32Addr);
    let sz = dosOps_opSize(is32Op);
    dosOps_setReg(DOS_MRM_REG, sz, dosOps_readSize(DOS_MRM_ADDR, sz));
    DOS_SEGS[0] = dosMmu_read16(DOS_MRM_ADDR + sz);
    return 4;
  };
  DOS_OPS[0xC5] = function (is32Op, is32Addr) { // LDS r, m16:16
    dosCpu_modrm(is32Addr);
    let sz = dosOps_opSize(is32Op);
    dosOps_setReg(DOS_MRM_REG, sz, dosOps_readSize(DOS_MRM_ADDR, sz));
    DOS_SEGS[3] = dosMmu_read16(DOS_MRM_ADDR + sz);
    return 4;
  };
  DOS_OPS[0xC6] = function (is32Op, is32Addr) { // MOV r/m8, imm8
    dosCpu_modrm(is32Addr);
    dosOps_setRM(1, dosCpu_fetchU8());
    return 2;
  };
  DOS_OPS[0xC7] = function (is32Op, is32Addr) { // MOV r/m16/32, imm
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    dosOps_setRM(sz, dosCpu_fetchImm(is32Op));
    return 2;
  };
  DOS_OPS[0xC8] = function (is32Op) { // ENTER imm16, imm8
    let size = dosCpu_fetchU16();
    let level = dosCpu_fetchU8() & 0x1F;
    dosCpu_pushSize(dosOps_getReg(5, dosOps_opSize(is32Op)), is32Op);
    let frame = dosOps_getReg(4, dosOps_opSize(is32Op));
    dosOps_setReg(5, dosOps_opSize(is32Op), frame);
    if (DOS_IS_32 === 1) DOS_REGS32[4] = (DOS_REGS32[4] - size) >>> 0;
    else DOS_REGS32[4] = (DOS_REGS32[4] & 0xFFFF0000) | ((DOS_REGS32[4] - size) & 0xFFFF);
    return 10;
  };
  DOS_OPS[0xC9] = function (is32Op) { // LEAVE
    let sz = dosOps_opSize(is32Op);
    if (DOS_IS_32 === 1) DOS_REGS32[4] = DOS_REGS32[5] >>> 0;
    else DOS_REGS32[4] = (DOS_REGS32[4] & 0xFFFF0000) | (DOS_REGS16[10] & 0xFFFF);
    dosOps_setReg(5, sz, dosCpu_popSize(is32Op));
    return 4;
  };
  DOS_OPS[0xCA] = function (is32Op) { // RETF imm16
    let n = dosCpu_fetchU16();
    DOS_EIP = dosCpu_popSize(is32Op) >>> 0;
    DOS_SEGS[1] = dosCpu_popSize(is32Op) & 0xFFFF;
    if (DOS_IS_32 === 1) DOS_REGS32[4] = (DOS_REGS32[4] + n) >>> 0;
    else DOS_REGS32[4] = (DOS_REGS32[4] & 0xFFFF0000) | ((DOS_REGS32[4] + n) & 0xFFFF);
    return 7;
  };
  DOS_OPS[0xCB] = function (is32Op) { // RETF
    DOS_EIP = dosCpu_popSize(is32Op) >>> 0;
    DOS_SEGS[1] = dosCpu_popSize(is32Op) & 0xFFFF;
    return 7;
  };
  DOS_OPS[0xCC] = function () { dosKernel_handleInt(3); return 5; };
  DOS_OPS[0xCD] = function () { // INT imm8
    let n = dosCpu_fetchU8();
    dosKernel_handleInt(n);
    return 5;
  };
  DOS_OPS[0xCE] = function () { // INTO
    if (dosCpu_getOF()) dosKernel_handleInt(4);
    return 3;
  };
  DOS_OPS[0xCF] = function (is32Op) { // IRET
    DOS_EIP = dosCpu_popSize(is32Op) >>> 0;
    DOS_SEGS[1] = dosCpu_popSize(is32Op) & 0xFFFF;
    DOS_EFLAGS = (dosCpu_popSize(is32Op) | 0x0002) >>> 0;
    DOS_LAZY_OP = 0;
    return 7;
  };

  // -------------------------------------------------------------------------
  // 0xD0-0xD7: shifts by 1 or CL, BCD helpers, XLAT
  // -------------------------------------------------------------------------
  DOS_OPS[0xD0] = function (is32Op, is32Addr) {
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    dosOps_setRM(1, dosOps_shift(op, dosOps_getRM(1), 1, 1));
    return 3;
  };
  DOS_OPS[0xD1] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    dosOps_setRM(sz, dosOps_shift(op, dosOps_getRM(sz), 1, sz));
    return 3;
  };
  DOS_OPS[0xD2] = function (is32Op, is32Addr) {
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    dosOps_setRM(1, dosOps_shift(op, dosOps_getRM(1), DOS_REGS8[4], 1));
    return 3;
  };
  DOS_OPS[0xD3] = function (is32Op, is32Addr) {
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    dosOps_setRM(sz, dosOps_shift(op, dosOps_getRM(sz), DOS_REGS8[4], sz));
    return 3;
  };
  DOS_OPS[0xD4] = function () { // AAM
    let base = dosCpu_fetchU8();
    if (base === 0) { dosOps_divideError(); return 4; }
    let al = DOS_REGS8[0];
    DOS_REGS8[1] = Math.floor(al / base) & 0xFF;
    DOS_REGS8[0] = (al % base) & 0xFF;
    dosCpu_setResultFlags(DOS_REGS8[0], 1);
    return 17;
  };
  DOS_OPS[0xD5] = function () { // AAD
    let base = dosCpu_fetchU8();
    let v = (DOS_REGS8[0] + DOS_REGS8[1] * base) & 0xFF;
    DOS_REGS8[0] = v;
    DOS_REGS8[1] = 0;
    dosCpu_setResultFlags(v, 1);
    return 19;
  };
  DOS_OPS[0xD6] = function () { // SALC (undocumented)
    DOS_REGS8[0] = dosCpu_getCF() ? 0xFF : 0x00;
    return 2;
  };
  DOS_OPS[0xD7] = function (is32Op, is32Addr) { // XLAT
    let segIdx = (DOS_PREFIX_SEG >= 0) ? DOS_PREFIX_SEG : 3;
    let base = is32Addr ? (DOS_REGS32[3] >>> 0) : DOS_REGS16[6];
    DOS_REGS8[0] = DOS_RAM[dosMmu_linear(DOS_SEGS[segIdx], base + DOS_REGS8[0]) & 0xFFFFFF];
    return 4;
  };

  // 0xD8-0xDF: the x87 coprocessor. No FPU here, but the ModR/M byte must be
  // consumed so the instruction stream stays in step.
  for (let f = 0; f < 8; f++) {
    DOS_OPS[0xD8 + f] = function (is32Op, is32Addr) {
      dosCpu_modrm(is32Addr);
      return 4;
    };
  }

  // -------------------------------------------------------------------------
  // 0xE0-0xEF: loops, I/O, near jumps and calls
  // -------------------------------------------------------------------------
  DOS_OPS[0xE0] = function (is32Op, is32Addr) { // LOOPNZ
    let rel = dosCpu_sext8(dosCpu_fetchU8());
    let c = (dosOps_getCount(is32Addr) - 1) >>> 0;
    dosOps_setCount(is32Addr, c);
    if (c !== 0 && dosCpu_getZF() === 0) { dosOps_jumpRel(rel, is32Op); return 4; }
    return 2;
  };
  DOS_OPS[0xE1] = function (is32Op, is32Addr) { // LOOPZ
    let rel = dosCpu_sext8(dosCpu_fetchU8());
    let c = (dosOps_getCount(is32Addr) - 1) >>> 0;
    dosOps_setCount(is32Addr, c);
    if (c !== 0 && dosCpu_getZF() === 1) { dosOps_jumpRel(rel, is32Op); return 4; }
    return 2;
  };
  DOS_OPS[0xE2] = function (is32Op, is32Addr) { // LOOP
    let rel = dosCpu_sext8(dosCpu_fetchU8());
    let c = (dosOps_getCount(is32Addr) - 1) >>> 0;
    dosOps_setCount(is32Addr, c);
    if (c !== 0) { dosOps_jumpRel(rel, is32Op); return 4; }
    return 2;
  };
  DOS_OPS[0xE3] = function (is32Op, is32Addr) { // JCXZ / JECXZ
    let rel = dosCpu_sext8(dosCpu_fetchU8());
    if (dosOps_getCount(is32Addr) === 0) { dosOps_jumpRel(rel, is32Op); return 4; }
    return 2;
  };
  DOS_OPS[0xE4] = function () { DOS_REGS8[0] = dosMmu_in8(dosCpu_fetchU8()); return 5; };
  DOS_OPS[0xE5] = function (is32Op) {
    let port = dosCpu_fetchU8();
    dosOps_setReg(0, dosOps_opSize(is32Op), dosMmu_in8(port) | (dosMmu_in8(port + 1) << 8));
    return 5;
  };
  DOS_OPS[0xE6] = function () { dosMmu_out8(dosCpu_fetchU8(), DOS_REGS8[0]); return 5; };
  DOS_OPS[0xE7] = function (is32Op) {
    let port = dosCpu_fetchU8();
    let v = dosOps_getReg(0, dosOps_opSize(is32Op));
    dosMmu_out8(port, v & 0xFF);
    dosMmu_out8(port + 1, (v >> 8) & 0xFF);
    return 5;
  };
  DOS_OPS[0xE8] = function (is32Op) { // CALL rel
    let rel = is32Op ? (dosCpu_fetchU32() | 0) : dosCpu_sext16(dosCpu_fetchU16());
    dosCpu_pushSize(DOS_EIP, is32Op);
    dosOps_jumpRel(rel, is32Op);
    return 4;
  };
  DOS_OPS[0xE9] = function (is32Op) { // JMP rel
    let rel = is32Op ? (dosCpu_fetchU32() | 0) : dosCpu_sext16(dosCpu_fetchU16());
    dosOps_jumpRel(rel, is32Op);
    return 3;
  };
  DOS_OPS[0xEA] = function (is32Op) { // JMP far ptr16:16/32
    let off = dosCpu_fetchImm(is32Op);
    let seg = dosCpu_fetchU16();
    DOS_SEGS[1] = seg;
    DOS_EIP = off >>> 0;
    return 5;
  };
  DOS_OPS[0xEB] = function (is32Op) { // JMP rel8
    let rel = dosCpu_sext8(dosCpu_fetchU8());
    dosOps_jumpRel(rel, is32Op);
    return 3;
  };
  DOS_OPS[0xEC] = function () { DOS_REGS8[0] = dosMmu_in8(DOS_REGS16[4]); return 5; };
  DOS_OPS[0xED] = function (is32Op) {
    let port = DOS_REGS16[4];
    dosOps_setReg(0, dosOps_opSize(is32Op), dosMmu_in8(port) | (dosMmu_in8(port + 1) << 8));
    return 5;
  };
  DOS_OPS[0xEE] = function () { dosMmu_out8(DOS_REGS16[4], DOS_REGS8[0]); return 5; };
  DOS_OPS[0xEF] = function (is32Op) {
    let port = DOS_REGS16[4];
    let v = dosOps_getReg(0, dosOps_opSize(is32Op));
    dosMmu_out8(port, v & 0xFF);
    dosMmu_out8(port + 1, (v >> 8) & 0xFF);
    return 5;
  };

  // -------------------------------------------------------------------------
  // 0xF4-0xFF: halt, flag control, group 3, group 4/5
  // -------------------------------------------------------------------------
  DOS_OPS[0xF4] = function () { DOS_HALTED = 1; return 1; }; // HLT
  DOS_OPS[0xF5] = function () { dosCpu_setCF(dosCpu_getCF() === 0); return 2; }; // CMC
  DOS_OPS[0xF6] = function (is32Op, is32Addr) { // group 3, byte
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    if (op === 0 || op === 1) { dosAlu_and(dosOps_getRM(1), dosCpu_fetchU8(), 1); return 3; } // TEST
    if (op === 2) { dosOps_setRM(1, (~dosOps_getRM(1)) & 0xFF); return 3; }                   // NOT
    if (op === 3) {                                                                          // NEG
      let v = dosOps_getRM(1);
      dosOps_setRM(1, dosAlu_sub(0, v, 1));
      return 3;
    }
    if (op === 4) { dosOps_mul(1); return 11; }
    if (op === 5) { dosOps_imul(1); return 11; }
    if (op === 6) { dosOps_div(1); return 17; }
    dosOps_idiv(1);
    return 17;
  };
  DOS_OPS[0xF7] = function (is32Op, is32Addr) { // group 3, word/dword
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    if (op === 0 || op === 1) { dosAlu_and(dosOps_getRM(sz), dosCpu_fetchImm(is32Op), sz); return 3; }
    if (op === 2) { dosOps_setRM(sz, (~dosOps_getRM(sz)) & dosCpu_maskFor(sz)); return 3; }
    if (op === 3) {
      let v = dosOps_getRM(sz);
      dosOps_setRM(sz, dosAlu_sub(0, v, sz));
      return 3;
    }
    if (op === 4) { dosOps_mul(sz); return 11; }
    if (op === 5) { dosOps_imul(sz); return 11; }
    if (op === 6) { dosOps_div(sz); return 17; }
    dosOps_idiv(sz);
    return 17;
  };
  DOS_OPS[0xF8] = function () { dosCpu_setCF(false); return 2; }; // CLC
  DOS_OPS[0xF9] = function () { dosCpu_setCF(true); return 2; };  // STC
  DOS_OPS[0xFA] = function () { dosCpu_flushFlags(); DOS_EFLAGS &= ~DOS_FL_IF; return 3; }; // CLI
  DOS_OPS[0xFB] = function () { dosCpu_flushFlags(); DOS_EFLAGS |= DOS_FL_IF; return 3; };  // STI
  DOS_OPS[0xFC] = function () { dosCpu_flushFlags(); DOS_EFLAGS &= ~DOS_FL_DF; return 2; }; // CLD
  DOS_OPS[0xFD] = function () { dosCpu_flushFlags(); DOS_EFLAGS |= DOS_FL_DF; return 2; };  // STD
  DOS_OPS[0xFE] = function (is32Op, is32Addr) { // group 4: INC/DEC r/m8
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    if (op === 0) { dosOps_setRM(1, dosAlu_inc(dosOps_getRM(1), 1)); return 3; }
    if (op === 1) { dosOps_setRM(1, dosAlu_dec(dosOps_getRM(1), 1)); return 3; }
    return dosOps_illegal(is32Op, is32Addr);
  };
  DOS_OPS[0xFF] = function (is32Op, is32Addr) { // group 5
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    if (op === 0) { dosOps_setRM(sz, dosAlu_inc(dosOps_getRM(sz), sz)); return 3; }
    if (op === 1) { dosOps_setRM(sz, dosAlu_dec(dosOps_getRM(sz), sz)); return 3; }
    if (op === 2) { // CALL near r/m
      let target = dosOps_getRM(sz);
      dosCpu_pushSize(DOS_EIP, is32Op);
      DOS_EIP = (DOS_IS_32 === 1) ? (target >>> 0) : (target & 0xFFFF);
      return 5;
    }
    if (op === 3) { // CALL far m16:16/32
      let off = dosOps_readSize(DOS_MRM_ADDR, sz);
      let seg = dosMmu_read16(DOS_MRM_ADDR + sz);
      dosCpu_pushSize(DOS_SEGS[1], is32Op);
      dosCpu_pushSize(DOS_EIP, is32Op);
      DOS_SEGS[1] = seg;
      DOS_EIP = off >>> 0;
      return 8;
    }
    if (op === 4) { // JMP near r/m
      let target = dosOps_getRM(sz);
      DOS_EIP = (DOS_IS_32 === 1) ? (target >>> 0) : (target & 0xFFFF);
      return 4;
    }
    if (op === 5) { // JMP far m16:16/32
      let off = dosOps_readSize(DOS_MRM_ADDR, sz);
      let seg = dosMmu_read16(DOS_MRM_ADDR + sz);
      DOS_SEGS[1] = seg;
      DOS_EIP = off >>> 0;
      return 6;
    }
    if (op === 6) { dosCpu_pushSize(dosOps_getRM(sz), is32Op); return 3; } // PUSH r/m
    return dosOps_illegal(is32Op, is32Addr);
  };

  // -------------------------------------------------------------------------
  // Two-byte opcodes (0x0F ..)
  // -------------------------------------------------------------------------
  // Descriptor table and control register instructions. Enough of a stub that
  // a DOS extender's mode-switch preamble runs instead of stopping the CPU.
  DOS_OPS_0F[0x00] = function (is32Op, is32Addr) { dosCpu_modrm(is32Addr); return 4; };
  DOS_OPS_0F[0x01] = function (is32Op, is32Addr) { dosCpu_modrm(is32Addr); return 4; };
  DOS_OPS_0F[0x06] = function () { return 4; }; // CLTS
  DOS_OPS_0F[0x20] = function (is32Op, is32Addr) { // MOV r32, CRx
    dosCpu_modrm(is32Addr);
    dosOps_setReg(DOS_MRM_RM, 4, (DOS_MRM_REG === 0) ? 0x00000011 : 0);
    return 6;
  };
  DOS_OPS_0F[0x22] = function (is32Op, is32Addr) { dosCpu_modrm(is32Addr); return 6; }; // MOV CRx, r32
  DOS_OPS_0F[0x21] = function (is32Op, is32Addr) { dosCpu_modrm(is32Addr); dosOps_setReg(DOS_MRM_RM, 4, 0); return 6; };
  DOS_OPS_0F[0x23] = function (is32Op, is32Addr) { dosCpu_modrm(is32Addr); return 6; };

  DOS_OPS_0F[0x31] = function () { // RDTSC
    DOS_REGS32[0] = DOS_TOTAL_CYCLES >>> 0;
    DOS_REGS32[2] = Math.floor(DOS_TOTAL_CYCLES / 4294967296) >>> 0;
    return 5;
  };
  DOS_OPS_0F[0xA2] = function () { // CPUID
    let leaf = DOS_REGS32[0] >>> 0;
    if (leaf === 0) {
      DOS_REGS32[0] = 1;
      DOS_REGS32[3] = 0x756E6547; // "Genu"
      DOS_REGS32[2] = 0x49656E69; // "ineI"
      DOS_REGS32[1] = 0x6C65746E; // "ntel"
    } else {
      DOS_REGS32[0] = 0x00000400; // 486-class family
      DOS_REGS32[3] = 0;
      DOS_REGS32[1] = 0;
      DOS_REGS32[2] = 0x00000000; // no FPU: 0xD8-0xDF are decoded but not executed
    }
    return 14;
  };

  DOS_OPS_0F[0xA0] = function (is32Op) { dosCpu_pushSize(DOS_SEGS[4], is32Op); return 2; }; // PUSH FS
  DOS_OPS_0F[0xA1] = function (is32Op) { DOS_SEGS[4] = dosCpu_popSize(is32Op) & 0xFFFF; return 3; };
  DOS_OPS_0F[0xA8] = function (is32Op) { dosCpu_pushSize(DOS_SEGS[5], is32Op); return 2; }; // PUSH GS
  DOS_OPS_0F[0xA9] = function (is32Op) { DOS_SEGS[5] = dosCpu_popSize(is32Op) & 0xFFFF; return 3; };
  DOS_OPS_0F[0xB2] = function (is32Op, is32Addr) { // LSS
    dosCpu_modrm(is32Addr);
    let sz = dosOps_opSize(is32Op);
    dosOps_setReg(DOS_MRM_REG, sz, dosOps_readSize(DOS_MRM_ADDR, sz));
    DOS_SEGS[2] = dosMmu_read16(DOS_MRM_ADDR + sz);
    return 5;
  };
  DOS_OPS_0F[0xB4] = function (is32Op, is32Addr) { // LFS
    dosCpu_modrm(is32Addr);
    let sz = dosOps_opSize(is32Op);
    dosOps_setReg(DOS_MRM_REG, sz, dosOps_readSize(DOS_MRM_ADDR, sz));
    DOS_SEGS[4] = dosMmu_read16(DOS_MRM_ADDR + sz);
    return 5;
  };
  DOS_OPS_0F[0xB5] = function (is32Op, is32Addr) { // LGS
    dosCpu_modrm(is32Addr);
    let sz = dosOps_opSize(is32Op);
    dosOps_setReg(DOS_MRM_REG, sz, dosOps_readSize(DOS_MRM_ADDR, sz));
    DOS_SEGS[5] = dosMmu_read16(DOS_MRM_ADDR + sz);
    return 5;
  };

  // Bit tests: BT/BTS/BTR/BTC, both the r/m,r form and the group-8 immediate.
  function bitOp(mode, addr, isReg, rmReg, bit, sz) {
    let val;
    let byteAddr = 0;
    if (isReg) {
      val = dosOps_getReg(rmReg, sz);
      bit = bit & (sz * 8 - 1);
    } else {
      // A memory bit string is addressed beyond the operand when the index is
      // large: the bit offset selects the byte.
      byteAddr = (addr + (bit >> 3)) & 0xFFFFFF;
      val = DOS_RAM[byteAddr];
      bit = bit & 7;
    }
    let cur = (val >>> bit) & 1;
    dosCpu_setCF(cur !== 0);
    if (mode === 0) return;                       // BT
    let nv = val;
    if (mode === 1) nv = val | (1 << bit);        // BTS
    else if (mode === 2) nv = val & ~(1 << bit);  // BTR
    else nv = val ^ (1 << bit);                   // BTC
    if (isReg) dosOps_setReg(rmReg, sz, nv);
    else { dosBc_touch(byteAddr); DOS_RAM[byteAddr] = nv & 0xFF; }
  }
  let btCodes = [0xA3, 0xAB, 0xB3, 0xBB];
  for (let m = 0; m < 4; m++) {
    (function (mode) {
      DOS_OPS_0F[btCodes[mode]] = function (is32Op, is32Addr) {
        let sz = dosOps_opSize(is32Op);
        dosCpu_modrm(is32Addr);
        bitOp(mode, DOS_MRM_ADDR, DOS_MRM_ISREG, DOS_MRM_RM, dosOps_getReg(DOS_MRM_REG, sz) | 0, sz);
        return 4;
      };
    })(m);
  }
  DOS_OPS_0F[0xBA] = function (is32Op, is32Addr) { // group 8: BT/BTS/BTR/BTC r/m, imm8
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let op = DOS_MRM_REG;
    let bit = dosCpu_fetchU8();
    if (op < 4) return 4; // 0-3 are undefined
    bitOp(op - 4, DOS_MRM_ADDR, DOS_MRM_ISREG, DOS_MRM_RM, bit, sz);
    return 4;
  };

  DOS_OPS_0F[0xA4] = function (is32Op, is32Addr) { // SHLD r/m, r, imm8
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let dst = dosOps_getRM(sz);
    let src = dosOps_getReg(DOS_MRM_REG, sz);
    let n = dosCpu_fetchU8() & 31;
    if (n === 0) return 3;
    let bits = sz * 8;
    let res = ((dst << n) | (src >>> (bits - n))) & dosCpu_maskFor(sz);
    dosOps_setRM(sz, res);
    dosCpu_setResultFlags(res, sz);
    dosCpu_setCF(((dst >>> (bits - n)) & 1) !== 0);
    return 4;
  };
  DOS_OPS_0F[0xA5] = function (is32Op, is32Addr) { // SHLD r/m, r, CL
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let dst = dosOps_getRM(sz);
    let src = dosOps_getReg(DOS_MRM_REG, sz);
    let n = DOS_REGS8[4] & 31;
    if (n === 0) return 3;
    let bits = sz * 8;
    let res = ((dst << n) | (src >>> (bits - n))) & dosCpu_maskFor(sz);
    dosOps_setRM(sz, res);
    dosCpu_setResultFlags(res, sz);
    dosCpu_setCF(((dst >>> (bits - n)) & 1) !== 0);
    return 4;
  };
  DOS_OPS_0F[0xAC] = function (is32Op, is32Addr) { // SHRD r/m, r, imm8
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let dst = dosOps_getRM(sz);
    let src = dosOps_getReg(DOS_MRM_REG, sz);
    let n = dosCpu_fetchU8() & 31;
    if (n === 0) return 3;
    let bits = sz * 8;
    let res = ((dst >>> n) | (src << (bits - n))) & dosCpu_maskFor(sz);
    dosOps_setRM(sz, res);
    dosCpu_setResultFlags(res, sz);
    dosCpu_setCF(((dst >>> (n - 1)) & 1) !== 0);
    return 4;
  };
  DOS_OPS_0F[0xAD] = function (is32Op, is32Addr) { // SHRD r/m, r, CL
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let dst = dosOps_getRM(sz);
    let src = dosOps_getReg(DOS_MRM_REG, sz);
    let n = DOS_REGS8[4] & 31;
    if (n === 0) return 3;
    let bits = sz * 8;
    let res = ((dst >>> n) | (src << (bits - n))) & dosCpu_maskFor(sz);
    dosOps_setRM(sz, res);
    dosCpu_setResultFlags(res, sz);
    dosCpu_setCF(((dst >>> (n - 1)) & 1) !== 0);
    return 4;
  };

  DOS_OPS_0F[0xAF] = function (is32Op, is32Addr) { // IMUL r, r/m
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let a = dosOps_getReg(DOS_MRM_REG, sz);
    let b = dosOps_getRM(sz);
    let sa = (sz === 2) ? ((a << 16) >> 16) : (a | 0);
    let sb = (sz === 2) ? ((b << 16) >> 16) : (b | 0);
    let res = sa * sb;
    let prod = (sz === 4) ? (Math.imul(sa, sb) >>> 0) : res;
    dosOps_setReg(DOS_MRM_REG, sz, prod);
    let fits = (sz === 2) ? (res >= -32768 && res <= 32767) : (res >= -2147483648 && res <= 2147483647);
    dosCpu_setResultFlags(prod, sz);
    dosCpu_setCF(!fits);
    dosCpu_setOF(!fits);
    return 10;
  };

  DOS_OPS_0F[0xB0] = function (is32Op, is32Addr) { // CMPXCHG r/m8, r8
    dosCpu_modrm(is32Addr);
    let dst = dosOps_getRM(1);
    let acc = DOS_REGS8[0];
    dosAlu_sub(acc, dst, 1);
    if (acc === dst) dosOps_setRM(1, dosOps_getReg(DOS_MRM_REG, 1));
    else DOS_REGS8[0] = dst;
    return 6;
  };
  DOS_OPS_0F[0xB1] = function (is32Op, is32Addr) { // CMPXCHG r/m, r
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let dst = dosOps_getRM(sz);
    let acc = dosOps_getReg(0, sz);
    dosAlu_sub(acc, dst, sz);
    if (acc === dst) dosOps_setRM(sz, dosOps_getReg(DOS_MRM_REG, sz));
    else dosOps_setReg(0, sz, dst);
    return 6;
  };
  DOS_OPS_0F[0xC0] = function (is32Op, is32Addr) { // XADD r/m8, r8
    dosCpu_modrm(is32Addr);
    let a = dosOps_getRM(1);
    let b = dosOps_getReg(DOS_MRM_REG, 1);
    dosOps_setReg(DOS_MRM_REG, 1, a);
    dosOps_setRM(1, dosAlu_add(a, b, 1));
    return 4;
  };
  DOS_OPS_0F[0xC1] = function (is32Op, is32Addr) { // XADD r/m, r
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let a = dosOps_getRM(sz);
    let b = dosOps_getReg(DOS_MRM_REG, sz);
    dosOps_setReg(DOS_MRM_REG, sz, a);
    dosOps_setRM(sz, dosAlu_add(a, b, sz));
    return 4;
  };

  DOS_OPS_0F[0xB6] = function (is32Op, is32Addr) { // MOVZX r, r/m8
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    dosOps_setReg(DOS_MRM_REG, sz, dosOps_getRM(1));
    return 3;
  };
  DOS_OPS_0F[0xB7] = function (is32Op, is32Addr) { // MOVZX r32, r/m16
    dosCpu_modrm(is32Addr);
    dosOps_setReg(DOS_MRM_REG, 4, dosOps_getRM(2));
    return 3;
  };
  DOS_OPS_0F[0xBE] = function (is32Op, is32Addr) { // MOVSX r, r/m8
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    dosOps_setReg(DOS_MRM_REG, sz, dosCpu_sext8(dosOps_getRM(1)));
    return 3;
  };
  DOS_OPS_0F[0xBF] = function (is32Op, is32Addr) { // MOVSX r32, r/m16
    dosCpu_modrm(is32Addr);
    dosOps_setReg(DOS_MRM_REG, 4, dosCpu_sext16(dosOps_getRM(2)));
    return 3;
  };
  DOS_OPS_0F[0xBC] = function (is32Op, is32Addr) { // BSF
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let v = dosOps_getRM(sz);
    dosCpu_flushFlags();
    if (v === 0) { DOS_EFLAGS |= DOS_FL_ZF; return 6; }
    DOS_EFLAGS &= ~DOS_FL_ZF;
    let i = 0;
    while (((v >>> i) & 1) === 0) i++;
    dosOps_setReg(DOS_MRM_REG, sz, i);
    return 6;
  };
  DOS_OPS_0F[0xBD] = function (is32Op, is32Addr) { // BSR
    let sz = dosOps_opSize(is32Op);
    dosCpu_modrm(is32Addr);
    let v = dosOps_getRM(sz);
    dosCpu_flushFlags();
    if (v === 0) { DOS_EFLAGS |= DOS_FL_ZF; return 6; }
    DOS_EFLAGS &= ~DOS_FL_ZF;
    let i = sz * 8 - 1;
    while (((v >>> i) & 1) === 0) i--;
    dosOps_setReg(DOS_MRM_REG, sz, i);
    return 6;
  };
  for (let r = 0; r < 8; r++) {
    (function (regIdx) {
      DOS_OPS_0F[0xC8 + regIdx] = function () { // BSWAP
        let v = DOS_REGS32[regIdx] >>> 0;
        DOS_REGS32[regIdx] = (((v & 0xFF) << 24) | ((v & 0xFF00) << 8) | ((v >>> 8) & 0xFF00) | ((v >>> 24) & 0xFF)) >>> 0;
        return 3;
      };
    })(r);
  }
}
