{
  "name": "Texas Hold'em",
  "id": "com.softn.texas-holdem",
  "version": "1.0.0",
  "description": "Texas Hold'em Poker: a peer table for friends who trust each other (every client holds the whole table, hole cards included), or an online table whose deck and cards stay on a server that sends each player only their own",
  "main": "ui/main.ui",
  "icon": "assets/icon.svg",
  "files": {
    "ui": [
      "ui/main.ui",
      "ui/components/CommunityCards.ui",
      "ui/components/ActionPanel.ui",
      "ui/components/PotDisplay.ui",
      "ui/pages/Lobby.ui",
      "ui/pages/Table.ui",
      "ui/modals/SyncModal.ui",
      "ui/modals/ResultsModal.ui",
      "ui/modals/LeaveModal.ui"
    ],
    "logic": [
      "logic/main.logic",
      "logic/cards.logic",
      "logic/engine.logic",
      "logic/game.logic",
      "logic/actions.logic",
      "logic/bot.logic",
      "logic/ui-helpers.logic",
      "logic/authority-client.logic"
    ],
    "xdb": [
      "xdb/poker_table.xdb",
      "xdb/poker_players.xdb",
      "xdb/poker_actions.xdb"
    ],
    "assets": [
      "assets/icon.svg"
    ],
    "server": [
      "server/authority.logic",
      "server/rules.logic"
    ]
  },
  "config": {
    "window": {
      "title": "Texas Hold'em Poker",
      "width": 1100,
      "height": 750
    },
    "theme": {
      "primary": "#c8aa6e",
      "mode": "dark"
    },
    "mobile": {
      "orientation": "landscape"
    }
  },
  "server": {
    "entry": "server/authority.logic",
    "scripts": [
      "logic/cards.logic",
      "server/rules.logic"
    ],
    "routes": [
      {
        "method": "GET",
        "path": "/api/rooms/health",
        "handler": "roomHealth",
        "public": true
      },
      {
        "method": "POST",
        "path": "/api/rooms",
        "handler": "roomCreate",
        "public": true
      },
      {
        "method": "POST",
        "path": "/api/rooms/join",
        "handler": "roomJoin",
        "public": true
      },
      {
        "method": "POST",
        "path": "/api/rooms/view",
        "handler": "roomView",
        "public": true
      },
      {
        "method": "POST",
        "path": "/api/rooms/act",
        "handler": "roomAct",
        "public": true
      },
      {
        "method": "POST",
        "path": "/api/rooms/leave",
        "handler": "roomLeave",
        "public": true
      }
    ]
  }
}
