// ps_psd.logic - bounded Photoshop PSD v1 raster codec, ported from the native
// component's psd.js to run as sliced jobs.
// Scope: 8-bit RGB; raw, PackBits RLE, ZIP and ZIP-with-prediction (read).
// Writes RLE RGBA layers, raster masks, Unicode names and a merged preview.
// This is NOT a preservation codec for arbitrary Photoshop documents.

let PS_BLEND_TO_PSD = { normal: "norm", multiply: "mul ", screen: "scrn", overlay: "over", darken: "dark", lighten: "lite", "color-dodge": "div ", "color-burn": "idiv",
  "hard-light": "hLit", "soft-light": "sLit", difference: "diff", exclusion: "smud", hue: "hue ", saturation: "sat ", color: "colr", luminosity: "lum " };
let PS_PSD_TO_BLEND = null;
let PS_BLEND_MODES = ["normal", "multiply", "screen", "overlay", "darken", "lighten", "color-dodge", "color-burn", "hard-light", "soft-light", "difference", "exclusion", "hue", "saturation", "color", "luminosity"];
function psBlendFromPsd(key) {
