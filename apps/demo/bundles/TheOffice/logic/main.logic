// TheOffice - Local AI Sim Game
// Dynamic tilemap, pathfinding, autonomous AI chat

// Tile indices (from office_32x32.png, 16 cols wide)
let WALL = 1035

// Floor tiles — one per room type, so the rooms read as different rooms.
//
// Each of these is the middle tile of its patch, the one with no edge drawn on
// it. Its neighbours in the sheet are the same colour with a dark seam down one
// side, for finishing the border of a patch; tiled across a whole floor they
// rule the office into graph paper. Depth comes from the light the UI paints
// over the top instead.
let FLOOR_CARPET = 87
let FLOOR_STONE = 93
let FLOOR_WOOD = 82

// Furniture tiles
let DESK_TL = 65
let DESK_TR = 67
let DESK_BL = 97
let DESK_BR = 99
// Office chairs. The direction names the way the person in the seat is
// looking, so a chair tucked under the near side of a desk faces UP, into it.
// CHAIR_U used to be 163/179, which is the front-facing chair with a
// see-through panel cut out of its back — so every desk chair in the building
// sat with its back to the desk.
let CHAIR_U_T = 161
let CHAIR_U_B = 177
let CHAIR_D_T = 162
let CHAIR_D_B = 178
let CHAIR_L_T = 164
let CHAIR_L_B = 180
let CHAIR_R_T = 165
let CHAIR_R_B = 181
let PLANT_T = 166
let PLANT_B = 182

// Wall-mounted decoration, drawn onto the wall row itself
let WINDOW = 205
let WINDOW_WIDE = 206
let PICTURE_A = 192
let PICTURE_B = 193
let WHITEBOARD_L = 169
let WHITEBOARD_R = 170

// Map config
let MAP_W = 28
let MAP_H = 20
let TILE_SZ = 32

// Walk-sheet row order.
//
// Read off the sheets rather than assumed: on eyes_walk.png the pupils are
// centred on row 0, absent on row 1 (that is the back of the head), sit right
// of centre on row 2 and left of centre on row 3. The old code had 1 as left
// and 3 as up, which is why a character walking left turned its back on you
// and one walking up sidled along facing the wrong wall.
let DIR_DOWN = 0
let DIR_UP = 1
let DIR_RIGHT = 2
let DIR_LEFT = 3

// Tilemap layers (set in _init)
let bgLayer = []
let objLayer = []
let collisionGrid = []

// 1 on every tile that is a chair seat. Standing on one is sitting down, and
// the UI nudges the sprite up into the chair when it happens.
let seatGrid = []

// Floor plan — one string per row, each exactly MAP_W wide.
// 0 = wall, C = carpet (open plan), S = stone (break room), W = wood (offices)
//
// This used to be twenty strings concatenated into one, and one of them was 29
// characters long. Everything from that row down was then read one column to
// the left of where it was drawn, so the interior walls stood a tile away from
// where you could walk and the bottom wall ran off the end of the string.
// A row of the wrong width now says so instead of quietly bending the office.
let floorRows = [
  "0000000000000000000000000000",
  "0WWWWWW0CCCCCCCCCC0WWWWWWWW0",
  "0WWWWWW0CCCCCCCCCC0WWWWWWWW0",
  "0WWWWWW0CCCCCCCCCC0WWWWWWWW0",
  "0WWWWWW0CCCCCCCCCCCCCCCCCCC0",
  "0CCCCCCCCCCCCCCCCCCCCCCCCCC0",
  "0CCCCCCCCCCCCCCCCCCCCCCCCCC0",
  "0CCCCCCCCCCCCCCCCCCCCCCCCCC0",
  "0CCCCCCCCCCCCCCCCCCCCCCCCCC0",
  "0CCCCCCCCCCCCCCCCCCC0SSSSSS0",
  "0CCCCCCCCCCCCCCCCCCC0SSSSSS0",
  "0CCCCCCCCCCCCCCCCCCC0SSSSSS0",
  "0CCCCCCCCCCCCCCCCCCCCSSSSSS0",
  "0CCCCCCCCCCCCCCCCCCCCCCCCCC0",
  "0CCCCCCCCCCCCCCCCCCCCCCCCCC0",
  "0CCCCCCCCCCCCCCCCCCCCCCCCCC0",
  "0CCCCCCCCCCCCCCCCCCCCCCCCCC0",
  "0CCCCCCCCCCCCCCCCCCCCCCCCCC0",
  "0CCCCCCCCCCCCCCCCCCCCCCCCCC0",
  "0000000000000000000000000000"
]

// AI / Simulation state
let modelHandle = null
let modelLoaded = false
let modelLoading = false
let simRunning = false
let generating = false
let statusText = "Press Play to start the day"
let messageCount = 0
let speakingCharId = null
let thinkingCharId = null

// The line the speaking character is currently saying, shown in a bubble over
// their head. Cleared with speakingCharId when the bubble times out.
let speechText = ""

// How long a bubble stays up, in 50ms movement ticks — long enough to read a
// couple of sentences.
let SPEECH_TICKS = 130

// Longest line a bubble will show before trailing off.
let BUBBLE_CHARS = 72

// Conversations
//
// Nobody shouts across the office any more: the speaker walks over to whoever
// they want a word with, and only opens their mouth once they are standing
// next to them. While that is happening the listener waits where they are
// rather than wandering off mid-sentence.
let pendingSpeaker = -1
let pendingListener = -1
let approachTicks = 0

// Close enough to talk: two and a half tiles.
let TALK_RANGE = 80

// How long a walk across the office gets before the idea is abandoned. Twenty
// seconds is far longer than any crossing takes; it exists so a speaker who
// cannot reach anyone does not freeze the pair for the rest of the day.
let APPROACH_TICKS = 400

// How much of the conversation is kept in storage.
let CHAT_LOG_LIMIT = 200

// How far the office is zoomed in the viewport. The map is 896x640 map pixels;
// at 1.25 it is comfortably bigger than the panel, which is the point — the
// user pans around it.
let zoom = 1.25
let MIN_ZOOM = 0.6
let MAX_ZOOM = 2.5

// Bumped to ask the viewport to scroll back to the middle of the office.
let recenterKey = 0

// One colour per character, used for their chat avatar and roster dot so a
// glance at the log tells you who is talking without reading the names.
let charColors = ["#f0883e", "#58a6ff", "#3fb950", "#db61a2", "#e3b341", "#a371f7"]

// Small talk, used until the language model is loaded.
//
// The office used to stand completely silent behind a 600 MB download: nothing
// walked, nothing spoke, and the chat panel said "no conversations yet" until
// the model landed. Now the day runs on scripted lines from the moment you
// press Play, and loading the model upgrades the writing rather than switching
// the demo on. Lines are tagged so the log can say which is which.
let smallTalk = [
  ["Did I ever tell you I was almost in a movie? Almost.",
   "This is why I am the boss. Well. One of the reasons.",
   "I declare this meeting officially fun.",
   "Nobody tell HR about the thing. You know the thing."],
  ["I painted the view from the car park at lunch. It is nicer than you think.",
   "Someone left a lovely note by the kettle. That was me.",
   "You are doing great, by the way. I mean it.",
   "I put a plant on reception. Her name is Susan."],
  ["I moved the stapler. Two inches. He has not noticed for a week.",
   "Sure. Great meeting. Really moved the needle.",
   "I am not saying it was me. I am saying nobody can prove it.",
   "That is the fourth email about the fridge."],
  ["The expense forms were filled in wrong. Again. By everyone.",
   "I have logged this conversation for later.",
   "My cat would not tolerate this office culture.",
   "The kitchen rota is not a suggestion."],
  ["Is anyone else thinking about the sandwich place? Just me?",
   "I brought a second lunch. For the afternoon lunch.",
   "I do my best numbers after biscuits.",
   "Nobody beats me at cards. Nobody."],
  ["I was just on a call with someone very senior. Very.",
   "Happy to take that on. Happy to be seen taking it on.",
   "Let me circle back with a deck about the deck.",
   "I have ideas. So many ideas."]
]
let smallTalkNext = []

// Character data
let charNames = []
let charIds = []
let charPersonalities = []
let charPositions = []
let charPaths = []
let charPathSteps = []
let charDirs = []
let charMoving = []
let charBases = []
let charHairs = []
let charHairColors = []
let charClothes = []
let charClothesColors = []

// What each character is currently up to, and how long they will keep at it.
// This is what makes the office read as an office rather than six people
// pacing at random: everyone has a desk they come back to, and errands they
// leave it for.
let charHomes = []
let charGoing = []
let charDoing = []
let charDwell = []

// How many consecutive ticks a character has been stuck behind somebody else,
// which is what triggers asking them to move.
let charBlocked = []

// Movement speed (pixels per tick at 50ms interval)
let MOVE_SPEED = 2.5

// Delay counters (ticks until action)
let charDelays = []
let speakingDelay = 0

// Render tick counter — forces React re-render each movement tick
// (charPositions/charDirs/charMoving are only accessed via sync functions,
// so they don't trigger re-renders on their own)
let renderTick = 0

// Somewhere worth going, and a reason for going there. Movement is chosen from
// this list rather than from a bag of anonymous corridor tiles, so what you
// watch is people running errands instead of people milling about.
let placeX = []
let placeY = []
let placeGoing = []
let placeDoing = []
let placeDwell = []

// Where each character sits. Index-matched to the characters collection, and
// spread across the floor so the pods are not all empty on one side.
let deskSeats = [[2, 4], [9, 4], [4, 8], [10, 12], [15, 8], [9, 18]]

function _init() {
  buildMap()
  setupPlaces()

  let chars = db.query("characters")
  let i = 0
  while (i < chars.length) {
    let c = chars[i]
    charNames.push(c.data.name)
    charIds.push(c.id)
    charPersonalities.push(c.data.personality)
    charPositions.push([c.data.x, c.data.y])
    charPaths.push([])
    charPathSteps.push(0)
    charDirs.push(c.data.row)
    charMoving.push(false)
    charBases.push(c.data.base)
    charHairs.push(c.data.hair)
    charHairColors.push(c.data.hairColor)
    charClothes.push(c.data.clothes)
    charClothesColors.push(c.data.clothesColor)
    charDelays.push(0)
    charBlocked.push(0)
    charHomes.push(deskSeats[i % deskSeats.length])
    charGoing.push("")
    charDoing.push("at their desk")
    charDwell.push(200)
    // Everyone starts at a different point in their own set of lines, so two
    // runs of the demo do not open with the same conversation.
    smallTalkNext.push(Math.floor(Math.random() * 4))
    i = i + 1
  }

  let msgs = db.query("office_chat")
  messageCount = msgs.length

  if (chars.length > 0) {
    statusText = chars.length + " people in the office today"
  }

  // Characters start idle — movement begins when sim is started
}

// What the status line says when nothing more interesting is happening.
//
// Walking no longer waits on the language model: the office runs on its own,
// and loading the model is what gives the people something to say. Before,
// nothing on screen moved at all until a few hundred megabytes had downloaded.
function idleStatus() {
  if (!simRunning) return "Paused — press Play to start the day"
  if (modelLoaded) return "Everyone is going about their day"
  if (modelLoading) return "Fetching the model — the office carries on meanwhile"
  return "Scripted small talk — load the AI model for real conversation"
}

// What is putting words in their mouths, for the chat panel to own up to.
function chatSource() {
  if (modelLoaded) return "Qwen3.5-0.8B"
  if (modelLoading) return "downloading the model"
  return "scripted small talk"
}

// Map Building

function buildMap() {
  // Seats are recorded as the furniture goes down, so this has to be empty and
  // the right shape before any of it is placed.
  seatGrid = []
  let sr = 0
  while (sr < MAP_H) {
    let seatRow = []
    let sc = 0
    while (sc < MAP_W) {
      seatRow.push(0)
      sc = sc + 1
    }
    seatGrid.push(seatRow)
    sr = sr + 1
  }

  let bg = []
  let obj = []
  let col = []
  let r = 0
  while (r < MAP_H) {
    let bgRow = []
    let objRow = []
    let colRow = []
    let planRow = floorRows[r]
    if (planRow.length != MAP_W) {
      console.error("TheOffice: floor plan row " + r + " is " + planRow.length + " tiles, expected " + MAP_W)
    }
    let c = 0
    while (c < MAP_W) {
      let ch = planRow.charAt(c)
      if (ch == "C") {
        bgRow.push(FLOOR_CARPET)
        colRow.push(1)
      } else if (ch == "S") {
        bgRow.push(FLOOR_STONE)
        colRow.push(1)
      } else if (ch == "W") {
        bgRow.push(FLOOR_WOOD)
        colRow.push(1)
      } else {
        bgRow.push(WALL)
        colRow.push(0)
      }
      objRow.push(-1)
      c = c + 1
    }
    bg.push(bgRow)
    obj.push(objRow)
    col.push(colRow)
    r = r + 1
  }

  // === Boss's office (cols 1-6, rows 1-4) ===
  // Desk against the top wall with the chair tucked under it, facing in.
  placeDeskAt(obj, col, 2, 1)
  placeSeatAt(obj, col, 2, 3, CHAIR_U_T, CHAIR_U_B)
  place1x2At(obj, col, 5, 3, PLANT_T, PLANT_B)

  // === Conference room (cols 19-26, rows 1-3) ===
  // Table in the middle with a chair down each side, both facing the table.
  placeDeskAt(obj, col, 22, 1)
  placeSeatAt(obj, col, 21, 1, CHAIR_R_T, CHAIR_R_B)
  placeSeatAt(obj, col, 24, 1, CHAIR_L_T, CHAIR_L_B)
  place1x2At(obj, col, 26, 1, PLANT_T, PLANT_B)

  // === Top wall: windows over the open plan, art over the boss's office, a
  // whiteboard over the conference room ===
  // (These six positions used to hold "blinds", every one of them the wall tile
  // painted over the wall tile.)
  // One window over each workstation, so the desks look placed rather than
  // scattered.
  setTile(obj, col, 9, 0, WINDOW)
  setTile(obj, col, 10, 0, WINDOW_WIDE)
  setTile(obj, col, 14, 0, WINDOW)
  setTile(obj, col, 15, 0, WINDOW_WIDE)
  setTile(obj, col, 3, 0, PICTURE_A)
  setTile(obj, col, 5, 0, PICTURE_B)
  setTile(obj, col, 21, 0, WHITEBOARD_L)
  setTile(obj, col, 22, 0, WHITEBOARD_R)

  // === Open plan ===
  // Columns line up across all three bands, which is what makes an open plan
  // floor look laid out rather than sprinkled: two desks under the windows,
  // three four-person pods through the middle, three more desks along the
  // bottom. Seat tiles stay walkable, so standing on one is sitting at it.
  workstation(obj, col, 9, 1)
  workstation(obj, col, 14, 1)

  deskPod(obj, col, 4, 9)
  deskPod(obj, col, 9, 9)
  deskPod(obj, col, 14, 9)

  workstation(obj, col, 4, 15)
  workstation(obj, col, 9, 15)
  workstation(obj, col, 14, 15)

  // === East side: one more workstation and a small meeting table, so the
  // right-hand third is somewhere to go rather than empty carpet ===
  workstation(obj, col, 23, 5)

  placeDeskAt(obj, col, 23, 15)
  placeSeatAt(obj, col, 22, 15, CHAIR_R_T, CHAIR_R_B)
  placeSeatAt(obj, col, 25, 15, CHAIR_L_T, CHAIR_L_B)

  // === Break room (cols 21-26, rows 9-12) ===
  // A table with a chair either side, both turned in towards it.
  placeDeskAt(obj, col, 22, 10)
  placeSeatAt(obj, col, 21, 10, CHAIR_R_T, CHAIR_R_B)
  placeSeatAt(obj, col, 24, 10, CHAIR_L_T, CHAIR_L_B)
  place1x2At(obj, col, 26, 9, PLANT_T, PLANT_B)

  // === Plants, along the walls and at the ends of the aisles ===
  place1x2At(obj, col, 1, 5, PLANT_T, PLANT_B)
  place1x2At(obj, col, 1, 12, PLANT_T, PLANT_B)
  place1x2At(obj, col, 1, 17, PLANT_T, PLANT_B)
  place1x2At(obj, col, 18, 4, PLANT_T, PLANT_B)
  place1x2At(obj, col, 18, 9, PLANT_T, PLANT_B)
  place1x2At(obj, col, 18, 17, PLANT_T, PLANT_B)
  place1x2At(obj, col, 26, 17, PLANT_T, PLANT_B)
  place1x2At(obj, col, 12, 5, PLANT_T, PLANT_B)

  bgLayer = bg
  objLayer = obj
  collisionGrid = col
}

function setTile(obj, col, x, y, tile) {
  let oRow = obj[y]
  oRow[x] = tile
  let cRow = col[y]
  cRow[x] = 0
}

function placeDeskAt(obj, col, x, y) {
  let oRow1 = obj[y]
  oRow1[x] = DESK_TL
  oRow1[x + 1] = DESK_TR
  let oRow2 = obj[y + 1]
  oRow2[x] = DESK_BL
  oRow2[x + 1] = DESK_BR
  let cRow1 = col[y]
  cRow1[x] = 0
  cRow1[x + 1] = 0
  let cRow2 = col[y + 1]
  cRow2[x] = 0
  cRow2[x + 1] = 0
}

function place1x2At(obj, col, x, y, tileTop, tileBot) {
  let oRow1 = obj[y]
  oRow1[x] = tileTop
  let oRow2 = obj[y + 1]
  oRow2[x] = tileBot
  let cRow1 = col[y]
  cRow1[x] = 0
  let cRow2 = col[y + 1]
  cRow2[x] = 0
}

// A chair. Same shape as any other 1x2 piece except that the lower tile — the
// seat — stays walkable, because that is where the person goes. Characters are
// drawn over the furniture, so someone standing on a seat reads as sitting in
// it, with the chair back showing above their shoulders.
function placeSeatAt(obj, col, x, y, tileTop, tileBot) {
  let oRow1 = obj[y]
  oRow1[x] = tileTop
  let oRow2 = obj[y + 1]
  oRow2[x] = tileBot
  let cRow1 = col[y]
  cRow1[x] = 0
  let sRow = seatGrid[y + 1]
  sRow[x] = 1
}

// A desk with two chairs tucked under the near side, facing in. Occupies
// x..x+1 across and y..y+3 down; the seats are (x, y+3) and (x+1, y+3).
function workstation(obj, col, x, y) {
  placeDeskAt(obj, col, x, y)
  placeSeatAt(obj, col, x, y + 2, CHAIR_U_T, CHAIR_U_B)
  placeSeatAt(obj, col, x + 1, y + 2, CHAIR_U_T, CHAIR_U_B)
}

// Two desks back to back with chairs on both sides — the four-person pod an
// open plan office is actually made of. Occupies x..x+1 across and y-2..y+3
// down; seats are (x, y-1), (x+1, y-1), (x, y+3) and (x+1, y+3).
function deskPod(obj, col, x, y) {
  placeSeatAt(obj, col, x, y - 2, CHAIR_D_T, CHAIR_D_B)
  placeSeatAt(obj, col, x + 1, y - 2, CHAIR_D_T, CHAIR_D_B)
  placeDeskAt(obj, col, x, y)
  placeSeatAt(obj, col, x, y + 2, CHAIR_U_T, CHAIR_U_B)
  placeSeatAt(obj, col, x + 1, y + 2, CHAIR_U_T, CHAIR_U_B)
}

function addPlace(x, y, going, doing, dwell) {
  placeX.push(x)
  placeY.push(y)
  placeGoing.push(going)
  placeDoing.push(doing)
  placeDwell.push(dwell)
}

function setupPlaces() {
  addPlace(24, 11, "off to the break room", "getting a coffee", 260)
  addPlace(22, 12, "off to the break room", "having a biscuit", 220)
  addPlace(25, 2, "off to the conference room", "in the conference room", 300)
  addPlace(21, 2, "off to the conference room", "at the whiteboard", 260)
  addPlace(4, 3, "off to see the boss", "seeing the boss", 240)
  addPlace(12, 4, "off to the window", "looking out of the window", 200)
  addPlace(17, 5, "off to water the plant", "watering the plant", 160)
  addPlace(24, 8, "off to the east desk", "working from the east desk", 260)
  addPlace(22, 16, "off to the meeting table", "at the meeting table", 240)
  addPlace(19, 12, "off for a wander", "stretching their legs", 140)
  addPlace(7, 13, "off for a wander", "stretching their legs", 140)
  addPlace(19, 18, "off to the far corner", "pretending to look busy", 180)
}

// Pathfinding (BFS with front pointer)

// Path from a pixel position to a tile. `avoidX`/`avoidY` mark one extra tile
// as impassable — pass -1, -1 for none. That is how somebody who has been stuck
// behind a colleague for a while goes round them instead of queueing forever.
function findPath(sx, sy, ex, ey, avoidX, avoidY) {
  let startX = Math.floor(sx / TILE_SZ)
  let startY = Math.floor(sy / TILE_SZ)
  let endX = ex
  let endY = ey

  // Clamp to bounds
  if (startX < 0) startX = 0
  if (startX >= MAP_W) startX = MAP_W - 1
  if (startY < 0) startY = 0
  if (startY >= MAP_H) startY = MAP_H - 1
  if (endX < 0 || endX >= MAP_W || endY < 0 || endY >= MAP_H) return []

  let colRowEnd = collisionGrid[endY]
  if (colRowEnd[endX] == 0) return []

  // If start is on a blocked tile, try neighbors
  let colRowStart = collisionGrid[startY]
  if (colRowStart[startX] == 0) {
    let found = false
    let dx2 = [1, -1, 0, 0]
    let dy2 = [0, 0, 1, -1]
    let s = 0
    while (s < 4) {
      let nx2 = startX + dx2[s]
      let ny2 = startY + dy2[s]
      if (nx2 >= 0 && nx2 < MAP_W && ny2 >= 0 && ny2 < MAP_H) {
        let cCheck = collisionGrid[ny2]
        if (cCheck[nx2] == 1) {
          startX = nx2
          startY = ny2
          found = true
          break
        }
      }
      s = s + 1
    }
    if (!found) return []
  }

  if (startX == endX && startY == endY) return []

  // BFS with front pointer (no array copying)
  let queue = []
  let front = 0
  let visited = []
  let parentMap = []
  let r = 0
  while (r < MAP_H) {
    let vRow = []
    let pRow = []
    let c = 0
    while (c < MAP_W) {
      vRow.push(0)
      pRow.push(-1)
      c = c + 1
    }
    visited.push(vRow)
    parentMap.push(pRow)
    r = r + 1
  }

  let vRowS = visited[startY]
  vRowS[startX] = 1
  queue.push(startX + startY * MAP_W)

  let dx = [0, 1, 0, -1]
  let dy = [-1, 0, 1, 0]

  let found2 = false
  while (front < queue.length && front < 3000) {
    let curr = queue[front]
    front = front + 1

    let cx = curr % MAP_W
    let cy = Math.floor(curr / MAP_W)

    if (cx == endX && cy == endY) {
      found2 = true
      break
    }

    let d = 0
    while (d < 4) {
      let nx = cx + dx[d]
      let ny = cy + dy[d]
      if (nx >= 0 && nx < MAP_W && ny >= 0 && ny < MAP_H) {
        let vRow = visited[ny]
        let cRow = collisionGrid[ny]
        let barred = nx == avoidX && ny == avoidY
        if (cRow[nx] == 1 && vRow[nx] == 0 && !barred) {
          vRow[nx] = 1
          let pRow = parentMap[ny]
          pRow[nx] = cx + cy * MAP_W
          queue.push(nx + ny * MAP_W)
        }
      }
      d = d + 1
    }
  }

  if (!found2) return []

  // Trace path back
  let path = []
  let px = endX
  let py = endY
  let pathSafety = 0
  while ((px != startX || py != startY) && pathSafety < 500) {
    pathSafety = pathSafety + 1
    path.push([px, py])
    let pRow = parentMap[py]
    let prev = pRow[px]
    if (prev == -1) break
    px = prev % MAP_W
    py = Math.floor(prev / MAP_W)
  }

  // Reverse
  let reversed = []
  let pi = path.length - 1
  while (pi >= 0) {
    reversed.push(path[pi])
    pi = pi - 1
  }
  return reversed
}

// Character Movement

// Check if a tile is occupied by another character (excludes charIdx)
function tileOccupied(tx, ty, excludeIdx) {
  let j = 0
  while (j < charPositions.length) {
    if (j != excludeIdx) {
      let op = charPositions[j]
      let otx = Math.floor(op[0] / TILE_SZ)
      let oty = Math.floor(op[1] / TILE_SZ)
      if (otx == tx && oty == ty) {
        return true
      }
    }
    j = j + 1
  }
  return false
}

// Turn a character to face along a delta. Every place that used to inline this
// wrote the row numbers out by hand, and two of the four were wrong.
function faceToward(charIdx, dx, dy) {
  // Standing exactly on the spot is not a direction. Falling through to the
  // comparisons would answer "up", so a character who arrived dead on a tile
  // centre would turn its back on the room for one frame.
  if (dx == 0 && dy == 0) return
  if (Math.abs(dx) > Math.abs(dy)) {
    if (dx > 0) {
      charDirs[charIdx] = DIR_RIGHT
    } else {
      charDirs[charIdx] = DIR_LEFT
    }
  } else {
    if (dy > 0) {
      charDirs[charIdx] = DIR_DOWN
    } else {
      charDirs[charIdx] = DIR_UP
    }
  }
}

// Where somebody goes next, and why.
//
// Weighted towards their own desk, because that is where an office worker
// spends most of the day; the rest of the time they run one of the errands the
// building offers. Both the trip and the arrival carry a description, which is
// what the roster in the chat panel reads out.
function chooseNextGoal(charIdx) {
  let home = charHomes[charIdx]
  if (!onTile(charIdx, home[0], home[1]) && Math.random() < 0.55) {
    goTo(charIdx, home[0], home[1], "back to their desk", "at their desk", 320 + Math.floor(Math.random() * 320))
    return
  }
  let attempts = 0
  while (attempts < 6) {
    let p = Math.floor(Math.random() * placeX.length)
    if (!onTile(charIdx, placeX[p], placeY[p])) {
      if (goTo(charIdx, placeX[p], placeY[p], placeGoing[p], placeDoing[p], placeDwell[p])) return
    }
    attempts = attempts + 1
  }
  // Nowhere reachable this moment — somebody is probably standing in the way.
  charDelays[charIdx] = 30 + Math.floor(Math.random() * 60)
}

function goTo(charIdx, tx, ty, going, doing, dwell) {
  let pos = charPositions[charIdx]
  let path = findPath(pos[0], pos[1], tx, ty, -1, -1)
  if (path.length == 0) return false
  charPaths[charIdx] = path
  charPathSteps[charIdx] = 0
  charMoving[charIdx] = true
  charGoing[charIdx] = going
  charDoing[charIdx] = doing
  charDwell[charIdx] = dwell
  charBlocked[charIdx] = 0
  return true
}

function onTile(charIdx, tx, ty) {
  let pos = charPositions[charIdx]
  return Math.floor(pos[0] / TILE_SZ) == tx && Math.floor(pos[1] / TILE_SZ) == ty
}

// Which character is standing on a tile, or -1.
function occupantOf(tx, ty, excludeIdx) {
  let j = 0
  while (j < charPositions.length) {
    if (j != excludeIdx) {
      let op = charPositions[j]
      if (Math.floor(op[0] / TILE_SZ) == tx && Math.floor(op[1] / TILE_SZ) == ty) return j
    }
    j = j + 1
  }
  return -1
}

// Ask whoever is in the way to take one step somewhere else.
//
// Without this, two people who want to pass through the same doorway both stop,
// wait, and try again forever, and a knot of three or four in a corridor never
// comes apart. Anyone mid-conversation is left alone — being shuffled aside
// mid-sentence is worse than the queue.
function stepAside(blockerIdx, forIdx) {
  if (blockerIdx < 0) return false
  if (blockerIdx == pendingSpeaker || blockerIdx == pendingListener) return false
  if (speakingCharId == charIds[blockerIdx] || thinkingCharId == charIds[blockerIdx]) return false

  let pos = charPositions[blockerIdx]
  let bx = Math.floor(pos[0] / TILE_SZ)
  let by = Math.floor(pos[1] / TILE_SZ)
  let other = charPositions[forIdx]
  let ox = Math.floor(other[0] / TILE_SZ)
  let oy = Math.floor(other[1] / TILE_SZ)

  let dx = [1, -1, 0, 0]
  let dy = [0, 0, 1, -1]
  let d = 0
  while (d < 4) {
    let nx = bx + dx[d]
    let ny = by + dy[d]
    if (nx >= 0 && nx < MAP_W && ny >= 0 && ny < MAP_H) {
      let cRow = collisionGrid[ny]
      let intoTheOther = nx == ox && ny == oy
      if (cRow[nx] == 1 && !intoTheOther && occupantOf(nx, ny, blockerIdx) < 0) {
        charPaths[blockerIdx] = [[nx, ny]]
        charPathSteps[blockerIdx] = 0
        charMoving[blockerIdx] = true
        charDelays[blockerIdx] = 0
        charBlocked[blockerIdx] = 0
        charGoing[blockerIdx] = "stepping out of the way"
        return true
      }
    }
    d = d + 1
  }
  return false
}

// Keep the same destination but route around a tile.
function repathAvoiding(charIdx, ax, ay) {
  let p = charPaths[charIdx]
  if (p.length == 0) return false
  let dest = p[p.length - 1]
  let pos = charPositions[charIdx]
  let np = findPath(pos[0], pos[1], dest[0], dest[1], ax, ay)
  if (np.length == 0) return false
  charPaths[charIdx] = np
  charPathSteps[charIdx] = 0
  charMoving[charIdx] = true
  charDelays[charIdx] = 0
  charBlocked[charIdx] = 0
  return true
}

function movementTick() {
  // Handle speaking indicator countdown
  if (speakingDelay > 0) {
    speakingDelay = speakingDelay - 1
    if (speakingDelay == 0) {
      speakingCharId = null
      speechText = ""
      statusText = idleStatus()
    }
  }

  let i = 0
  while (i < charPositions.length) {
    // Handle delay countdown for idle characters
    if (charDelays[i] > 0) {
      charDelays[i] = charDelays[i] - 1
      if (charDelays[i] == 0) {
        // If character still has a path (was waiting for a blocked tile), resume
        let existingPath = charPaths[i]
        if (existingPath.length > 0 && charPathSteps[i] < existingPath.length) {
          charMoving[i] = true
        } else if (i == pendingSpeaker) {
          // Still on their way to have a word with someone.
          walkToListener(i, pendingListener)
        } else {
          chooseNextGoal(i)
        }
      }
      i = i + 1
      continue
    }

    if (charMoving[i]) {
      let curPath = charPaths[i]
      if (curPath.length == 0) {
        // Safety: charMoving but no path — reset to idle
        charMoving[i] = false
        charDelays[i] = 20 + Math.floor(Math.random() * 40)
      } else if (curPath.length > 0) {
        let step = charPathSteps[i]
        if (step >= curPath.length) {
          // Arrived. Settle in and do whatever they came here to do.
          charMoving[i] = false
          charPaths[i] = []
          charBlocked[i] = 0
          charGoing[i] = ""
          if (i == pendingSpeaker) {
            charDelays[i] = 6
          } else {
            charDelays[i] = charDwell[i]
          }
        } else {
          let target = curPath[step]
          let targetTX = target[0]
          let targetTY = target[1]

          let blocker = occupantOf(targetTX, targetTY, i)
          if (blocker >= 0) {
            // Somebody is standing where we were about to step. Wait a moment,
            // then ask them to move, then go round them — in that order, so an
            // ordinary passing gets no more than a pause, and a real jam still
            // comes apart instead of deadlocking two people nose to nose.
            let pos = charPositions[i]
            let bdx = targetTX * TILE_SZ + TILE_SZ / 2 - pos[0]
            let bdy = targetTY * TILE_SZ + TILE_SZ / 2 - pos[1]
            faceToward(i, bdx, bdy)
            charMoving[i] = false
            charBlocked[i] = charBlocked[i] + 1

            if (charBlocked[i] >= 6) {
              charBlocked[i] = 0
              if (!repathAvoiding(i, targetTX, targetTY)) {
                // No way round either. Give up on this errand and find another.
                charPaths[i] = []
                charDelays[i] = 20 + Math.floor(Math.random() * 40)
              }
            } else if (charBlocked[i] >= 3) {
              stepAside(blocker, i)
              charDelays[i] = 8
            } else {
              charDelays[i] = 8 + Math.floor(Math.random() * 16)
            }
          } else {
            let targetPx = targetTX * TILE_SZ + TILE_SZ / 2
            let targetPy = targetTY * TILE_SZ + TILE_SZ / 2
            let pos = charPositions[i]
            let pdx = targetPx - pos[0]
            let pdy = targetPy - pos[1]
            let dist = Math.sqrt(pdx * pdx + pdy * pdy)

            faceToward(i, pdx, pdy)
            charBlocked[i] = 0

            if (dist < MOVE_SPEED + 1) {
              charPositions[i] = [targetPx, targetPy]
              charPathSteps[i] = step + 1
            } else {
              let nx = pos[0] + (pdx / dist) * MOVE_SPEED
              let ny = pos[1] + (pdy / dist) * MOVE_SPEED
              charPositions[i] = [nx, ny]
            }
          }
        }
      }
    }
    i = i + 1
  }

  advanceApproach()

  // Force React re-render by changing a state variable referenced in the template
  renderTick = renderTick + 1
}

// Someone crossing the office for a word: check every tick rather than waiting
// for the next conversation tick, so they speak the moment they arrive instead
// of standing in front of their colleague in silence for several seconds.
function advanceApproach() {
  if (pendingSpeaker < 0) return

  if (withinTalkRange(pendingSpeaker, pendingListener)) {
    beginConversation(pendingSpeaker, pendingListener)
    return
  }

  approachTicks = approachTicks - 1
  if (approachTicks <= 0) {
    cancelApproach()
    return
  }

  // Hold the listener where they are. Re-asserting the wait each tick is what
  // stops them wandering off the moment their own delay runs out — which used
  // to leave the speaker walking to an empty patch of carpet.
  charMoving[pendingListener] = false
  charPaths[pendingListener] = []
  charDelays[pendingListener] = 4
  charGoing[pendingListener] = ""
}

function withinTalkRange(a, b) {
  if (a < 0 || b < 0) return false
  let pa = charPositions[a]
  let pb = charPositions[b]
  let dx = pb[0] - pa[0]
  let dy = pb[1] - pa[1]
  return dx * dx + dy * dy <= TALK_RANGE * TALK_RANGE
}

// Send the speaker to a free tile next to the listener.
function walkToListener(speakerIdx, listenerIdx) {
  if (listenerIdx < 0) return false
  let lp = charPositions[listenerIdx]
  let lx = Math.floor(lp[0] / TILE_SZ)
  let ly = Math.floor(lp[1] / TILE_SZ)

  let dx = [1, -1, 0, 0]
  let dy = [0, 0, 1, -1]
  let d = 0
  while (d < 4) {
    let nx = lx + dx[d]
    let ny = ly + dy[d]
    if (nx >= 0 && nx < MAP_W && ny >= 0 && ny < MAP_H) {
      let cRow = collisionGrid[ny]
      if (cRow[nx] == 1 && occupantOf(nx, ny, speakerIdx) < 0) {
        if (goTo(speakerIdx, nx, ny, "going over for a word", "chatting", 60)) return true
      }
    }
    d = d + 1
  }
  // Ringed in. Wait a beat and try again; the approach timeout is the backstop.
  charDelays[speakerIdx] = 16
  return false
}

function startApproach(speakerIdx, listenerIdx) {
  pendingSpeaker = speakerIdx
  pendingListener = listenerIdx
  approachTicks = APPROACH_TICKS

  charMoving[listenerIdx] = false
  charPaths[listenerIdx] = []
  charDelays[listenerIdx] = 4

  if (!walkToListener(speakerIdx, listenerIdx)) {
    cancelApproach()
    return
  }
  statusText = charNames[speakerIdx] + " is going over to " + charNames[listenerIdx]
}

function cancelApproach() {
  let listener = pendingListener
  pendingSpeaker = -1
  pendingListener = -1
  approachTicks = 0
  if (listener >= 0) charDelays[listener] = 10
  statusText = idleStatus()
}

// AI Model

function loadModel() {
  if (modelLoading || modelLoaded) return
  modelLoading = true
  statusText = "Downloading Qwen3.5-0.8B..."

  softn.ai.model.load("onnx-community/Qwen3.5-0.8B-ONNX", {
    modelClass: "Qwen3_5ForConditionalGeneration",
    dtype: {
      embed_tokens: "q4",
      vision_encoder: "q4",
      decoder_model_merged: "q4"
    }
  }, function(result) {
    modelHandle = result.modelHandle
    modelLoaded = true
    modelLoading = false
    statusText = "Qwen3.5-0.8B is listening in"
  })
}

function toggleSim() {
  simRunning = !simRunning
  if (simRunning) {
    // Kick-start character movement
    let i = 0
    while (i < charIds.length) {
      if (!charMoving[i] && charDelays[i] == 0) {
        charDelays[i] = 10 + Math.floor(Math.random() * 40)
      }
      i = i + 1
    }
  } else {
    speakingCharId = null
    thinkingCharId = null
    speechText = ""
  }
  statusText = idleStatus()
}

// View controls

function zoomIn() {
  zoom = Math.min(MAX_ZOOM, Math.round((zoom + 0.25) * 100) / 100)
}

function zoomOut() {
  zoom = Math.max(MIN_ZOOM, Math.round((zoom - 0.25) * 100) / 100)
}

function recenter() {
  recenterKey = recenterKey + 1
}

function zoomPercent() {
  return Math.round(zoom * 100) + "%"
}

// Every few seconds, decide whether anyone fancies a word with anyone else.
//
// This only ever *starts* things. If the two are already standing together the
// conversation happens now; otherwise the speaker sets off across the office
// and `advanceApproach` opens the conversation when they get there.
function simulationTick() {
  if (generating) return
  if (charIds.length < 2) return
  if (pendingSpeaker >= 0) return
  if (speakingDelay > 0) return

  let pair = pickConversationPair()
  let speakerIdx = pair[0]
  let listenerIdx = pair[1]
  if (speakerIdx < 0 || listenerIdx < 0) return

  if (withinTalkRange(speakerIdx, listenerIdx)) {
    beginConversation(speakerIdx, listenerIdx)
  } else {
    startApproach(speakerIdx, listenerIdx)
  }
}

function beginConversation(speakerIdx, listenerIdx) {
  pendingSpeaker = -1
  pendingListener = -1
  approachTicks = 0
  generating = true

  // Turn to each other
  let speakerPos = charPositions[speakerIdx]
  let listenerPos = charPositions[listenerIdx]
  let dx = listenerPos[0] - speakerPos[0]
  let dy = listenerPos[1] - speakerPos[1]
  faceToward(speakerIdx, dx, dy)
  faceToward(listenerIdx, -dx, -dy)

  // Both stand still for the whole exchange — the one talking and the one
  // being talked to. The listener wandering off mid-sentence was the thing
  // that made these look less like conversations and more like coincidences.
  let hold = SPEECH_TICKS + 30
  charMoving[speakerIdx] = false
  charMoving[listenerIdx] = false
  charPaths[speakerIdx] = []
  charPaths[listenerIdx] = []
  charDelays[speakerIdx] = hold
  charDelays[listenerIdx] = hold
  charGoing[speakerIdx] = ""
  charGoing[listenerIdx] = ""
  charDoing[speakerIdx] = "chatting"
  charDoing[listenerIdx] = "chatting"

  let speakerName = charNames[speakerIdx]
  let listenerName = charNames[listenerIdx]
  let speakerPersonality = charPersonalities[speakerIdx]

  if (!modelLoaded) {
    say(speakerIdx, listenerIdx, nextSmallTalk(speakerIdx), false)
    generating = false
    return
  }

  thinkingCharId = charIds[speakerIdx]
  statusText = speakerName + " is thinking..."

  let recentContext = getRecentContext(speakerName, listenerName, 4)

  let systemPrompt = "You are " + speakerName + " from The Office. " + speakerPersonality + ". You are talking to " + listenerName + " in the office. Keep responses short (1-2 sentences), casual, and in character. Do not use quotation marks."

  let aiMessages = []
  aiMessages.push({ role: "system", content: systemPrompt })

  let c = 0
  while (c < recentContext.length) {
    let ctx = recentContext[c]
    if (ctx.speaker == speakerName) {
      aiMessages.push({ role: "assistant", content: ctx.content })
    } else {
      aiMessages.push({ role: "user", content: ctx.content })
    }
    c = c + 1
  }

  aiMessages.push({ role: "user", content: listenerName + " is nearby. Say something to them." })

  softn.ai.model.generate(modelHandle, aiMessages, {
    max_new_tokens: 64,
    temperature: 0.9,
    top_p: 0.9
  }, function(result) {
    let text = cleanModelOutput(result.text, speakerName)

    thinkingCharId = null
    if (text.length > 0) {
      say(speakerIdx, listenerIdx, text, true)
    } else {
      statusText = idleStatus()
    }

    generating = false
  })
}

// Put a line in the log, in a bubble over the speaker's head, and on the
// status bar. Both the scripted and the generated path end up here.
function say(speakerIdx, listenerIdx, text, fromModel) {
  if (!text || text.length == 0) return
  let speakerName = charNames[speakerIdx]
  let listenerName = charNames[listenerIdx]

  db.create("office_chat", {
    speaker: speakerName,
    listener: listenerName,
    content: text,
    ai: fromModel,
    timestamp: new Date().toISOString()
  })
  messageCount = messageCount + 1
  trimChatLog()

  thinkingCharId = null
  speakingCharId = charIds[speakerIdx]
  speechText = text
  statusText = speakerName + " to " + listenerName
  speakingDelay = SPEECH_TICKS
}

// A line every few seconds for as long as the tab is open would otherwise grow
// the stored log without limit; only the recent history is worth keeping.
function trimChatLog() {
  let all = db.query("office_chat")
  if (all.length <= CHAT_LOG_LIMIT) return
  let extra = all.length - CHAT_LOG_LIMIT
  let i = 0
  while (i < extra) {
    db.delete("office_chat", all[i].id)
    i = i + 1
  }
  messageCount = all.length - extra
}

// Walk each character's own lines in order, so nobody repeats themselves until
// they have used the whole set, and everyone starts somewhere different.
function nextSmallTalk(speakerIdx) {
  let lines = smallTalk[speakerIdx % smallTalk.length]
  let at = smallTalkNext[speakerIdx] % lines.length
  smallTalkNext[speakerIdx] = at + 1
  return lines[at]
}

// Pick who talks to whom.
//
// This used to be two independent random draws, so Michael would routinely
// deliver a line to Angela from the far corner of the building while the two
// of them turned to face each other through three walls. The speaker is still
// random — everyone gets a turn — but the listener is whoever is nearest, so
// the pair you see talking are standing together.
function pickConversationPair() {
  let a = Math.floor(Math.random() * charIds.length)
  let speakerPos = charPositions[a]
  let best = -1
  let bestDist = 0
  let b = 0
  while (b < charIds.length) {
    if (b != a) {
      let p = charPositions[b]
      let dx = p[0] - speakerPos[0]
      let dy = p[1] - speakerPos[1]
      let d = dx * dx + dy * dy
      if (best < 0 || d < bestDist) {
        best = b
        bestDist = d
      }
    }
    b = b + 1
  }
  if (best < 0) best = (a + 1) % charIds.length
  return [a, best]
}

function getRecentContext(speakerName, listenerName, count) {
  let allMsgs = db.query("office_chat")
  let relevant = []
  let i = allMsgs.length - 1
  while (i >= 0 && relevant.length < count) {
    let msg = allMsgs[i]
    if ((msg.data.speaker == speakerName && msg.data.listener == listenerName) || (msg.data.speaker == listenerName && msg.data.listener == speakerName)) {
      relevant.push({ speaker: msg.data.speaker, content: msg.data.content })
    }
    i = i - 1
  }
  let reversed = []
  let ri = relevant.length - 1
  while (ri >= 0) {
    reversed.push(relevant[ri])
    ri = ri - 1
  }
  return reversed
}

function cleanModelOutput(text, speakerName) {
  let cleaned = text
  let prefix1 = speakerName + ":"
  let prefix2 = speakerName + " says"
  if (cleaned.indexOf(prefix1) == 0) {
    cleaned = cleaned.substring(prefix1.length)
  }
  if (cleaned.indexOf(prefix2) == 0) {
    cleaned = cleaned.substring(prefix2.length)
  }
  cleaned = cleaned.trim()
  if (cleaned.length > 0) {
    let first = cleaned.charAt(0)
    if (first == "\"" || first == "'") {
      cleaned = cleaned.substring(1)
    }
  }
  if (cleaned.length > 0) {
    let last = cleaned.charAt(cleaned.length - 1)
    if (last == "\"" || last == "'") {
      cleaned = cleaned.substring(0, cleaned.length - 1)
    }
  }
  cleaned = cleaned.trim()
  let nlIdx = cleaned.indexOf("\n")
  if (nlIdx > 0) {
    cleaned = cleaned.substring(0, nlIdx)
  }
  return cleaned
}

// Helper getters for UI

function getCharX(idx) {
  if (idx < 0 || idx >= charPositions.length) return 0
  let pos = charPositions[idx]
  return pos[0]
}

function getCharY(idx) {
  if (idx < 0 || idx >= charPositions.length) return 0
  let pos = charPositions[idx]
  return pos[1]
}

function getCharDir(idx) {
  if (idx < 0 || idx >= charDirs.length) return 0
  return charDirs[idx]
}

function isCharMoving(idx) {
  if (idx < 0 || idx >= charMoving.length) return false
  return charMoving[idx]
}

function isSpeaking(charId) {
  return speakingCharId == charId && speechText.length > 0
}

// Speech bubbles sit above the head. Near the top wall there is no room above
// the head, and a bubble drawn there is clipped off by the edge of the office —
// so up there it hangs under the character's feet instead.
//
// The threshold has to clear the tallest bubble that can appear, which is why
// the text is capped below: an uncapped model reply can run to a dozen lines,
// and no fixed threshold covers that.
function bubbleBelow(idx) {
  return getCharY(idx) < 140
}

// How far to slide a bubble sideways to keep it inside the office. Centred on
// someone standing by a wall it would hang off the edge of the world and get
// cut in half by the viewport; the tail is shifted back by the same amount so
// it still points at whoever is talking.
function bubbleShift(idx) {
  let half = 125
  let x = getCharX(idx)
  if (x < half) return Math.round(half - x)
  let limit = MAP_W * TILE_SZ - half
  if (x > limit) return Math.round(limit - x)
  return 0
}

// A bubble is for glancing at; the whole line is in the chat log either way.
// Cut on a word so it does not end mid-syllable.
function bubbleText() {
  if (speechText.length <= BUBBLE_CHARS) return speechText
  let cut = speechText.substring(0, BUBBLE_CHARS)
  let space = cut.lastIndexOf(" ")
  if (space > BUBBLE_CHARS - 18) cut = cut.substring(0, space)
  return cut + "..."
}

function charStatus(idx) {
  if (idx < 0 || idx >= charIds.length) return ""
  if (thinkingCharId == charIds[idx]) return "thinking"
  if (speakingCharId == charIds[idx]) return "talking"
  if (idx == pendingListener) return "being talked to"
  if (idx == pendingSpeaker) return "going over for a word"
  if (charMoving[idx] && charGoing[idx]) return charGoing[idx]
  if (charMoving[idx]) return "walking"
  return charDoing[idx] || "at their desk"
}

// Stacking order for a character: how far down the room they are, so whoever
// is nearer the bottom is drawn in front.
//
// The rounding lives here rather than in the template because a template is
// rendered once before this script has loaded, and `Math.round(undefined)`
// there puts a literal NaN into the style. An unloaded function simply has no
// answer yet, which React ignores.
function charDepth(idx) {
  if (idx < 0 || idx >= charPositions.length) return 0
  let pos = charPositions[idx]
  return Math.round(pos[1])
}

// Someone standing still on a chair seat is sitting in it, so their sprite is
// nudged up into the seat. Without it they stand a whole tile in front of the
// chair with the chair back poking out behind their head.
function seatShift(idx) {
  if (idx < 0 || idx >= charPositions.length) return "-75%"
  if (charMoving[idx]) return "-75%"
  let pos = charPositions[idx]
  let tx = Math.floor(pos[0] / TILE_SZ)
  let ty = Math.floor(pos[1] / TILE_SZ)
  if (tx < 0 || tx >= MAP_W || ty < 0 || ty >= MAP_H) return "-75%"
  let row = seatGrid[ty]
  if (row[tx] == 1) return "calc(-75% - 10px)"
  return "-75%"
}

function charName(idx) {
  if (idx < 0 || idx >= charNames.length) return ""
  return charNames[idx]
}

function colorForIndex(idx) {
  if (idx < 0) return "#8b949e"
  return charColors[idx % charColors.length]
}

// The chat log stores the speaker's name, not their index, so colours and
// initials for a message have to be looked up by name.
function colorForName(name) {
  let i = 0
  while (i < charNames.length) {
    if (charNames[i] == name) return colorForIndex(i)
    i = i + 1
  }
  return "#8b949e"
}

function initialOf(name) {
  if (!name) return "?"
  return name.charAt(0)
}

function msgTime(msg) {
  let ts = msg.data.timestamp || ""
  if (!ts) return ""
  try {
    let d = new Date(ts)
    let h = d.getHours()
    let m = d.getMinutes()
    let mStr = m < 10 ? "0" + m : "" + m
    return h + ":" + mStr
  } catch (e) {
    return ""
  }
}

function mapPixelWidth() {
  return MAP_W * TILE_SZ
}

function mapPixelHeight() {
  return MAP_H * TILE_SZ
}
