<logic src="../logic/main.logic" />

<style>
/* In normal flow, not absolutely positioned: the web runtime puts its consent
   bar above the app when a capability is requested, and an inset-0 root would
   sit on top of it and hide the Allow button. */
.hb-root { position: relative; width: 100%; height: 100%; min-height: 560px; display: flex; flex-direction: column; background: #0f172a; color: #e2e8f0; overflow: hidden; user-select: none; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  /* The panels are dark whatever the site theme, so the components inside
     them (Text, Select, Input, Button) read their colours from these. */
  --color-text: #e2e8f0; --color-text-muted: #94a3b8; --color-surface: #1e293b; --color-surface-hover: #273449; --color-border: rgba(148, 163, 184, 0.22); --color-border-hover: rgba(148, 163, 184, 0.4); --color-background: #0f172a; }
.hb-tool .hb-t, .hb-cat-item .hb-t { color: inherit; }
.hb-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 7px 12px; background: rgba(15, 23, 42, 0.98); border-bottom: 1px solid rgba(148, 163, 184, 0.18); flex-shrink: 0; flex-wrap: wrap; z-index: 10; }
.hb-badge { width: 32px; height: 32px; border-radius: 9px; background: linear-gradient(135deg, #f59e0b, #b45309); display: flex; align-items: center; justify-content: center; font-size: 17px; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35); flex-shrink: 0; }
.hb-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.hb-body { flex: 1; display: flex; min-height: 0; }
.hb-side { width: 236px; flex-shrink: 0; background: rgba(15, 23, 42, 0.96); border-right: 1px solid rgba(148, 163, 184, 0.14); overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 10px; }
.hb-inspector { width: 240px; flex-shrink: 0; background: rgba(15, 23, 42, 0.96); border-left: 1px solid rgba(148, 163, 184, 0.14); overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 10px; }
.hb-viewport { flex: 1; position: relative; min-width: 0; min-height: 0; overflow: hidden; background: #cfe3f5; }
.hb-label { font-size: 10px; letter-spacing: 0.12em; color: #94a3b8; font-weight: 700; margin-bottom: 4px; }
.hb-tools { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
.hb-tool { display: flex; align-items: center; gap: 7px; padding: 7px 9px; border-radius: 8px; border: 1px solid rgba(148, 163, 184, 0.16); background: rgba(30, 41, 59, 0.8); color: #e2e8f0; font-size: 12px; cursor: pointer; text-align: left; }
.hb-tool[data-on="true"] { background: #f59e0b; color: #1c1917; border-color: #f59e0b; font-weight: 700; }
.hb-cat { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; }
.hb-cat-item { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 7px 3px; border-radius: 8px; border: 1px solid rgba(148, 163, 184, 0.14); background: rgba(30, 41, 59, 0.8); color: #cbd5e1; font-size: 10px; cursor: pointer; line-height: 1.1; text-align: center; }
.hb-cat-item[data-on="true"] { background: rgba(245, 158, 11, 0.25); border-color: #f59e0b; color: #fde68a; }
.hb-cat-icon { font-size: 18px; }
.hb-card { background: rgba(30, 41, 59, 0.75); border: 1px solid rgba(148, 163, 184, 0.14); border-radius: 10px; padding: 9px 10px; }
.hb-kv { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; padding: 3px 0; color: #cbd5e1; }
.hb-kv b { color: #f8fafc; font-weight: 600; text-align: right; }
.hb-swatches { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 4px; }
.hb-swatch { width: 22px; height: 22px; border-radius: 6px; border: 2px solid rgba(255,255,255,0.15); cursor: pointer; }
.hb-swatch[data-on="true"] { border-color: #ffffff; }
.hb-status { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 5px 12px; background: rgba(15, 23, 42, 0.98); border-top: 1px solid rgba(148, 163, 184, 0.16); font-size: 12px; color: #cbd5e1; flex-shrink: 0; }
.hb-ovl { position: absolute; pointer-events: none; z-index: 5; }
.hb-zoom { top: 12px; right: 12px; display: flex; flex-direction: column; gap: 5px; pointer-events: auto; }
.hb-hint { left: 12px; top: 12px; max-width: 460px; padding: 7px 12px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 8px; font-size: 12px; color: #f8fafc; backdrop-filter: blur(6px); }
.hb-compass { left: 12px; bottom: 12px; padding: 6px 10px; background: rgba(15, 23, 42, 0.75); border-radius: 8px; font-size: 11px; color: #cbd5e1; }
.hb-dialog-wrap { position: absolute; inset: 0; z-index: 20; display: flex; align-items: center; justify-content: center; background: rgba(2, 6, 23, 0.55); }
.hb-dialog { width: min(720px, calc(100% - 40px)); max-height: calc(100% - 40px); overflow: auto; background: #0f172a; border: 1px solid rgba(148, 163, 184, 0.25); border-radius: 14px; padding: 18px 20px; box-shadow: 0 30px 80px rgba(0,0,0,0.6); }
.hb-mono { width: 100%; min-height: 260px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11px; background: #020617; color: #e2e8f0; border: 1px solid rgba(148,163,184,0.25); border-radius: 8px; padding: 8px; }
.hb-slot { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 6px 8px; border-radius: 8px; background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(148, 163, 184, 0.14); font-size: 11px; }
.ll-card { display: flex; flex-direction: column; gap: 6px; padding: 8px 10px; border-radius: 10px; background: rgba(30, 41, 59, 0.75); border: 1px solid rgba(148, 163, 184, 0.14); cursor: pointer; }
.ll-card[data-on="true"] { border-color: #4ade80; box-shadow: 0 0 0 1px rgba(74, 222, 128, 0.35); }
.ll-face { width: 34px; height: 34px; border-radius: 50%; position: relative; flex-shrink: 0; overflow: hidden; }
.ll-face-hair { position: absolute; left: 4px; right: 4px; top: 2px; height: 14px; border-radius: 12px 12px 4px 4px; }
.ll-face-shirt { position: absolute; left: 0; right: 0; bottom: 0; height: 9px; }
.ll-need { display: flex; align-items: center; gap: 6px; font-size: 11px; color: #cbd5e1; }
.ll-need-bar { flex: 1; height: 6px; border-radius: 3px; background: rgba(0,0,0,0.45); overflow: hidden; }
.ll-need-fill { height: 100%; border-radius: 3px; }
.ll-menu-opt { display: block; width: 100%; text-align: left; padding: 8px 10px; border-radius: 8px; background: rgba(30, 41, 59, 0.9); border: 1px solid rgba(148, 163, 184, 0.18); color: #f8fafc; font-size: 12px; cursor: pointer; }
.ll-menu-opt:hover { border-color: #4ade80; }
.ll-clock { padding: 4px 10px; border-radius: 8px; background: rgba(0,0,0,0.4); border: 1px solid rgba(148,163,184,0.2); font-size: 12px; font-weight: 700; color: #fde68a; }
.ll-creator { position: absolute; top: 12px; right: 12px; bottom: 12px; width: min(380px, calc(100% - 24px)); z-index: 20; overflow: auto; background: rgba(15, 23, 42, 0.96); border: 1px solid rgba(148, 163, 184, 0.25); border-radius: 14px; padding: 16px 18px; box-shadow: 0 30px 80px rgba(0,0,0,0.6); }
.ll-chip { display: inline-flex; padding: 5px 9px; border-radius: 8px; border: 1px solid rgba(148, 163, 184, 0.2); background: rgba(30, 41, 59, 0.8); color: #e2e8f0; font-size: 12px; cursor: pointer; }
.ll-chip[data-on="true"] { border-color: #4ade80; color: #bbf7d0; }
@media (max-width: 980px) { .hb-inspector { display: none; } }
@media (max-width: 760px) { .hb-side { display: none; } .hb-hint { display: none; } }
</style>

<Box className="hb-root">
  <Loop interval={33} running={true} @tick={houseStep} />

  <!-- Header -->
  <Box className="hb-header">
    <Box className="hb-row">
      <Box className="hb-badge">🏠</Box>
      <Stack direction="vertical" gap="none">
        <Heading level={5} style={{ margin: 0, color: "#f8fafc", fontSize: "14px", fontWeight: 700 }}>Sim Lives</Heading>
        <Text size="xs" style={{ color: "#94a3b8", fontSize: "11px" }}>Build the house, then live in it</Text>
      </Stack>
    </Box>
    <Box className="hb-row">
      <Button size="xs" variant={appMode === "build" ? "primary" : "secondary"} @click={() => setAppMode("build")}>🔨 Build</Button>
      <Button size="xs" variant={appMode === "live" ? "primary" : "secondary"} @click={() => setAppMode("live")}>▶ Live</Button>
      <Text size="xs" style={{ color: "#475569" }}>|</Text>
      <Box if={appMode === "live"} className="hb-row">
        <Text className="ll-clock">{clockText}</Text>
        <Button size="xs" variant={livePaused ? "primary" : "secondary"} @click={togglePause}>{livePaused ? "▶ Resume" : "⏸"}</Button>
        <Button size="xs" variant={!livePaused && gameSpeed === 1 ? "primary" : "secondary"} @click={() => setGameSpeed(1)}>1x</Button>
        <Button size="xs" variant={!livePaused && gameSpeed === 2 ? "primary" : "secondary"} @click={() => setGameSpeed(2)}>2x</Button>
        <Button size="xs" variant={!livePaused && gameSpeed === 4 ? "primary" : "secondary"} @click={() => setGameSpeed(4)}>4x</Button>
        <Text size="xs" style={{ color: "#475569" }}>|</Text>
        <Button size="xs" variant={liveCam === "orbit" ? "primary" : "secondary"} @click={() => setLiveCam("orbit")}>🏠 Dollhouse</Button>
        <Button size="xs" variant={liveCam === "follow" ? "primary" : "secondary"} @click={() => setLiveCam("follow")}>🎥 Follow</Button>
        <Button size="xs" variant={liveCam === "top" ? "primary" : "secondary"} @click={() => setLiveCam("top")}>🗺 Top</Button>
        <Button size="xs" variant={liveRoof ? "primary" : "secondary"} @click={toggleLiveRoof}>Roof</Button>
      </Box>
      <Box if={appMode === "build"} className="hb-row">
      <Button size="xs" variant={viewMode === "plan" ? "primary" : "secondary"} @click={() => setView("plan")}>📐 Plan</Button>
      <Button size="xs" variant={viewMode === "3d" ? "primary" : "secondary"} @click={() => setView("3d")}>🏡 3D</Button>
      <Button size="xs" variant={viewMode === "walk" ? "primary" : "secondary"} @click={() => setView("walk")}>🚶 Walk</Button>
      <Text size="xs" style={{ color: "#475569" }}>|</Text>
      <Button size="xs" variant="secondary" disabled={!canUndo} @click={undo}>↶ Undo</Button>
      <Button size="xs" variant="secondary" disabled={!canRedo} @click={redo}>↷ Redo</Button>
      <Text size="xs" style={{ color: "#475569" }}>|</Text>
      <Button size="xs" variant="secondary" @click={newHouse}>New</Button>
      <Select size="sm" value={sampleKey} placeholder="Load a sample house…" @change={loadSampleKey} options={samples} style={{ width: 236 }} />
      <Button size="xs" variant="secondary" @click={openImport}>Import</Button>
      <Button size="xs" variant="secondary" @click={openExport}>Export</Button>
      </Box>
    </Box>
  </Box>

  <Box className="hb-body">
    <!-- Left (live): the household -->
    <Box if={appMode === "live"} className="hb-side">
      <Box>
        <Stack direction="horizontal" justify="between" align="center" style={{ marginBottom: 6 }}>
          <Text className="hb-label" style={{ marginBottom: 0 }}>HOUSEHOLD</Text>
          <Button size="xs" variant="primary" @click={openCreator}>＋ New sim</Button>
        </Stack>
        <Stack direction="vertical" gap="xs">
          #each (c in simCards)
            <Box className="ll-card" data-on={c.active} @click={selectSim(c.id)}>
              <Stack direction="horizontal" gap="sm" align="center">
                <Box className="ll-face" style={{ background: c.skin }}>
                  <Box className="ll-face-hair" style={{ background: c.hair }} />
                  <Box className="ll-face-shirt" style={{ background: c.shirt }} />
                </Box>
                <Stack direction="vertical" gap="none" style={{ minWidth: 0 }}>
                  <Text style={{ fontWeight: 700, color: "#f8fafc", fontSize: "13px" }}>{c.name + (c.auto ? " · auto" : "")}</Text>
                  <Text size="xs" style={{ color: "#cbd5e1", fontSize: "11px" }}>{c.action}</Text>
                </Stack>
              </Stack>
              <Box className="ll-need-bar" style={{ height: 4 }}>
                <Box className="ll-need-fill" style={{ width: c.needs[0].v + "%", background: c.needs[0].color }} />
              </Box>
            </Box>
          #end
          <Text if={simCards.length === 0} size="xs" style={{ color: "#94a3b8" }}>Nobody lives here yet.</Text>
        </Stack>
      </Box>

      <Box if={activeCard !== null}>
        <Text className="hb-label">{activeCard.name.toUpperCase()}</Text>
        <Box className="hb-card">
          <Text size="xs" style={{ color: "#fde68a", display: "block", marginBottom: 6 }}>{activeCard.mood}</Text>
          <Stack direction="vertical" gap="xs">
            #each (n in activeCard.needs)
              <Box className="ll-need">
                <Text style={{ width: 18, textAlign: "center" }}>{n.icon}</Text>
                <Text style={{ width: 52 }}>{n.label}</Text>
                <Box className="ll-need-bar"><Box className="ll-need-fill" style={{ width: n.v + "%", background: n.color }} /></Box>
                <Text style={{ width: 26, textAlign: "right", color: "#f8fafc" }}>{n.v}</Text>
              </Box>
            #end
          </Stack>
          <Stack direction="horizontal" gap="xs" style={{ marginTop: 8, flexWrap: "wrap" }}>
            <Button size="xs" variant={activeCard.auto ? "primary" : "secondary"} @click={toggleAuto}>{activeCard.auto ? "🤖 Auto on" : "🎮 You control"}</Button>
            <Button size="xs" variant="secondary" @click={cancelTask}>Stop</Button>
            <Button size="xs" variant="secondary" @click={nextSim}>Next (Tab)</Button>
            <Button size="xs" variant="danger" @click={removeActiveSim}>Move out</Button>
          </Stack>
        </Box>
      </Box>

      <Box>
        <Text className="hb-label">KEYS</Text>
        <Box className="hb-card">
          <Box className="hb-kv"><Text>Pause</Text><b>Space</b></Box>
          <Box className="hb-kv"><Text>Speed</Text><b>1 / 2 / 3</b></Box>
          <Box className="hb-kv"><Text>Next sim</Text><b>Tab</b></Box>
          <Box className="hb-kv"><Text>Auto</Text><b>A</b></Box>
          <Box className="hb-kv"><Text>Follow cam</Text><b>F</b></Box>
          <Box className="hb-kv"><Text>Roof</Text><b>R</b></Box>
          <Box className="hb-kv"><Text>Build mode</Text><b>B</b></Box>
        </Box>
      </Box>
    </Box>

    <!-- Left: tools and catalogue -->
    <Box if={appMode === "build"} className="hb-side">
      <Box>
        <Text className="hb-label">TOOLS</Text>
        <Box className="hb-tools">
          <Box className="hb-tool" data-on={tool === "select"} @click={() => setTool("select")}><Text>🖱</Text><Text className="hb-t">Select</Text></Box>
          <Box className="hb-tool" data-on={tool === "wall"} @click={() => setTool("wall")}><Text>🧱</Text><Text className="hb-t">Wall</Text></Box>
          <Box className="hb-tool" data-on={tool === "room"} @click={() => setTool("room")}><Text>▦</Text><Text className="hb-t">Room</Text></Box>
          <Box className="hb-tool" data-on={tool === "door"} @click={() => setTool("door")}><Text>🚪</Text><Text className="hb-t">Door</Text></Box>
          <Box className="hb-tool" data-on={tool === "window"} @click={() => setTool("window")}><Text>🪟</Text><Text className="hb-t">Window</Text></Box>
          <Box className="hb-tool" data-on={tool === "erase"} @click={() => setTool("erase")}><Text>🗑</Text><Text className="hb-t">Erase</Text></Box>
        </Box>
      </Box>

      <Box>
        <Text className="hb-label">ROOM FLOOR</Text>
        <Select size="sm" fullWidth={true} value={roomFloor} @change={setRoomFloor} options={[{ value: "wood", label: "Timber" }, { value: "tile", label: "Tiles" }, { value: "carpet", label: "Carpet" }, { value: "stone", label: "Stone" }, { value: "concrete", label: "Concrete" }]} />
      </Box>

      <Box>
        <Text className="hb-label">FURNITURE & GARDEN</Text>
        <Box className="hb-cat">
          #each (c in catalogue)
            <Box className="hb-cat-item" data-on={tool === "item" && itemKind === c.kind} title={c.label} @click={pickItem(c.kind)}>
              <Text className="hb-cat-icon">{c.icon}</Text>
              <Text className="hb-t">{c.label}</Text>
            </Box>
          #end
        </Box>
        <Stack direction="horizontal" gap="xs" style={{ marginTop: 6 }}>
          <Button size="xs" variant="secondary" @click={rotatePreview}>⟳ Rotate (R)</Button>
        </Stack>
      </Box>

      <Box>
        <Text className="hb-label">HOUSE</Text>
        <Stack direction="vertical" gap="xs">
          <Select size="sm" fullWidth={true} label="Wall finish" value={wallStyle} @change={setWallStyle} options={[{ value: "plaster", label: "Rendered" }, { value: "brick", label: "Brick" }, { value: "timber", label: "Weatherboard" }, { value: "stone", label: "Stone" }]} />
          <Select size="sm" fullWidth={true} label="Roof" value={roofStyle} @change={setRoofStyle} options={[{ value: "gable_x", label: "Gable, ridge east-west" }, { value: "gable_z", label: "Gable, ridge north-south" }, { value: "flat", label: "Flat" }, { value: "none", label: "None" }]} />
          <Box>
            <Text size="xs" style={{ color: "#94a3b8" }}>Roof colour</Text>
            <Box className="hb-swatches">
              <Box className="hb-swatch" data-on={roofColor === "#7f1d1d"} style={{ background: "#7f1d1d" }} @click={() => setRoofColor("#7f1d1d")} />
              <Box className="hb-swatch" data-on={roofColor === "#374151"} style={{ background: "#374151" }} @click={() => setRoofColor("#374151")} />
              <Box className="hb-swatch" data-on={roofColor === "#78350f"} style={{ background: "#78350f" }} @click={() => setRoofColor("#78350f")} />
              <Box className="hb-swatch" data-on={roofColor === "#1e3a5f"} style={{ background: "#1e3a5f" }} @click={() => setRoofColor("#1e3a5f")} />
              <Box className="hb-swatch" data-on={roofColor === "#4d7c0f"} style={{ background: "#4d7c0f" }} @click={() => setRoofColor("#4d7c0f")} />
              <Box className="hb-swatch" data-on={roofColor === "#9ca3af"} style={{ background: "#9ca3af" }} @click={() => setRoofColor("#9ca3af")} />
            </Box>
          </Box>
          <Input size="sm" type="number" label="Wall height (m)" min={2.2} max={4} step={0.1} value={wallHeightText} @change={setWallHeight} />
          <Stack direction="horizontal" gap="xs">
            <Button size="xs" variant={showRoof ? "primary" : "secondary"} @click={toggleRoof}>Roof in 3D</Button>
            <Button size="xs" variant={showGrid ? "primary" : "secondary"} @click={toggleGrid}>Grid (G)</Button>
          </Stack>
        </Stack>
      </Box>

      <Box>
        <Text className="hb-label">SAVE SLOTS</Text>
        <Stack direction="vertical" gap="xs">
          #each (s in saveSlots)
            <Box className="hb-slot">
              <Text style={{ color: s.used ? "#e2e8f0" : "#64748b" }}>{"Slot " + s.n + ": " + s.label}</Text>
              <Stack direction="horizontal" gap="xs">
                <Button size="xs" variant="secondary" @click={saveSlot(s.n)}>Save</Button>
                <Button size="xs" variant="secondary" disabled={!s.used} @click={loadSlot(s.n)}>Load</Button>
              </Stack>
            </Box>
          #end
        </Stack>
      </Box>
    </Box>

    <!-- Centre: the scene -->
    <Box className="hb-viewport">
      <!-- One Scene3D per view: orbit controls and pointer lock are fixed at
           mount, so each mode gets its own instance with the right ones. -->
      <Scene3D if={appMode === "live" && liveCam === "orbit"}
        fill={true}
        objects={objects}
        staticObjects={staticObjects}
        lights={lights}
        camera={{ position: cameraPos, lookAt: cameraLookAt, fov: cameraFov }}
        shadows={true}
        antialias={true}
        toneMapping="aces"
        toneMappingExposure={1.1}
        sky={skyName}
        fog={sceneFog}
        maxPixelRatio={1.5}
        orbitControls={true}
        @click={onSceneClick}
      />
      <Scene3D if={appMode === "live" && liveCam !== "orbit"}
        fill={true}
        objects={objects}
        staticObjects={staticObjects}
        lights={lights}
        camera={{ position: cameraPos, lookAt: cameraLookAt, fov: cameraFov }}
        shadows={true}
        antialias={true}
        toneMapping="aces"
        toneMappingExposure={1.1}
        sky={skyName}
        fog={sceneFog}
        maxPixelRatio={1.5}
        orbitControls={false}
        @click={onSceneClick}
      />
      <Scene3D if={appMode === "build" && viewMode === "plan"}
        fill={true}
        objects={objects}
        staticObjects={staticObjects}
        lights={lights}
        camera={{ position: cameraPos, lookAt: cameraLookAt, fov: cameraFov }}
        shadows={true}
        antialias={true}
        toneMapping="aces"
        toneMappingExposure={1.1}
        sky="day"
        fog={sceneFog}
        maxPixelRatio={1.5}
        @click={onSceneClick}
        grid={showGrid ? { size: 48, divisions: 96, color: "#1e293b", centerColor: "#f59e0b", position: { x: 0, y: 0.012, z: 0 } } : false}
        orbitControls={false}
        @hover={onHover}
        @pointerdown={onPointerDown}
        @pointermove={onPointerMove}
        @pointerup={onPointerUp}
      />
      <Scene3D if={appMode === "build" && viewMode === "3d"}
        fill={true}
        objects={objects}
        staticObjects={staticObjects}
        lights={lights}
        camera={{ position: cameraPos, lookAt: cameraLookAt, fov: cameraFov }}
        shadows={true}
        antialias={true}
        toneMapping="aces"
        toneMappingExposure={1.1}
        sky="day"
        fog={sceneFog}
        maxPixelRatio={1.5}
        @click={onSceneClick}
        orbitControls={true}
      />
      <Scene3D if={appMode === "build" && viewMode === "walk"}
        fill={true}
        objects={objects}
        staticObjects={staticObjects}
        lights={lights}
        camera={{ position: cameraPos, lookAt: cameraLookAt, fov: cameraFov }}
        shadows={true}
        antialias={true}
        toneMapping="aces"
        toneMappingExposure={1.1}
        sky="day"
        fog={sceneFog}
        maxPixelRatio={1.5}
        @click={onSceneClick}
        pointerLock={true}
        crosshair={false}
        pitchLimit={0.9}
        mouseLookSensitivity={0.0022}
        cameraSmoothing={0.35}
      />
      <Box className="hb-ovl hb-hint"><Text style={{ fontSize: "12px" }}>{appMode === "live" ? liveHint : hint}</Text></Box>
      <Box if={appMode === "build" && viewMode === "plan"} className="hb-ovl hb-zoom">
        <Button size="xs" variant="secondary" @click={zoomIn}>＋</Button>
        <Button size="xs" variant="secondary" @click={zoomOut}>－</Button>
        <Button size="xs" variant="secondary" title="Centre on the house (F)" @click={centreOnHouse}>⌖</Button>
      </Box>
      <Box if={appMode === "build" && viewMode === "plan"} className="hb-ovl hb-compass"><Text>N ↑ · wheel zooms · drag the lawn or use arrows to pan · 1–7 pick tools</Text></Box>

      <!-- Create a sim -->
      <Box if={creatorOpen && draft !== null} className="ll-creator">
        <Stack direction="horizontal" justify="between" align="center" style={{ marginBottom: 10 }}>
          <Heading level={5} style={{ margin: 0, color: "#f8fafc" }}>Create a sim</Heading>
          <Button size="xs" variant="secondary" @click={closeCreator}>✕</Button>
        </Stack>
        <Stack direction="vertical" gap="sm">
          <Input size="sm" label="Name" value={draft.name} @change={setDraftName} />
          <Box>
            <Text size="xs" style={{ color: "#94a3b8" }}>Skin</Text>
            <Box className="hb-swatches">
              <Box className="hb-swatch" data-on={draft.skin === "#f6d5b8"} style={{ background: "#f6d5b8" }} @click={() => setDraftSkin("#f6d5b8")} />
              <Box className="hb-swatch" data-on={draft.skin === "#e8b894"} style={{ background: "#e8b894" }} @click={() => setDraftSkin("#e8b894")} />
              <Box className="hb-swatch" data-on={draft.skin === "#c68642"} style={{ background: "#c68642" }} @click={() => setDraftSkin("#c68642")} />
              <Box className="hb-swatch" data-on={draft.skin === "#8d5524"} style={{ background: "#8d5524" }} @click={() => setDraftSkin("#8d5524")} />
              <Box className="hb-swatch" data-on={draft.skin === "#5b3a1e"} style={{ background: "#5b3a1e" }} @click={() => setDraftSkin("#5b3a1e")} />
            </Box>
          </Box>
          <Box>
            <Text size="xs" style={{ color: "#94a3b8" }}>Hair</Text>
            <Stack direction="horizontal" gap="xs" style={{ flexWrap: "wrap", marginTop: 4 }}>
              <Box className="ll-chip" data-on={draft.hair === "short"} @click={() => setDraftHair("short")}>Short</Box>
              <Box className="ll-chip" data-on={draft.hair === "long"} @click={() => setDraftHair("long")}>Long</Box>
              <Box className="ll-chip" data-on={draft.hair === "bun"} @click={() => setDraftHair("bun")}>Bun</Box>
              <Box className="ll-chip" data-on={draft.hair === "curly"} @click={() => setDraftHair("curly")}>Curly</Box>
              <Box className="ll-chip" data-on={draft.hair === "bald"} @click={() => setDraftHair("bald")}>Bald</Box>
            </Stack>
            <Box className="hb-swatches">
              <Box className="hb-swatch" data-on={draft.hairColor === "#1c1917"} style={{ background: "#1c1917" }} @click={() => setDraftHairColor("#1c1917")} />
              <Box className="hb-swatch" data-on={draft.hairColor === "#5c3a21"} style={{ background: "#5c3a21" }} @click={() => setDraftHairColor("#5c3a21")} />
              <Box className="hb-swatch" data-on={draft.hairColor === "#b45309"} style={{ background: "#b45309" }} @click={() => setDraftHairColor("#b45309")} />
              <Box className="hb-swatch" data-on={draft.hairColor === "#facc15"} style={{ background: "#facc15" }} @click={() => setDraftHairColor("#facc15")} />
              <Box className="hb-swatch" data-on={draft.hairColor === "#9ca3af"} style={{ background: "#9ca3af" }} @click={() => setDraftHairColor("#9ca3af")} />
              <Box className="hb-swatch" data-on={draft.hairColor === "#dc2626"} style={{ background: "#dc2626" }} @click={() => setDraftHairColor("#dc2626")} />
              <Box className="hb-swatch" data-on={draft.hairColor === "#7c3aed"} style={{ background: "#7c3aed" }} @click={() => setDraftHairColor("#7c3aed")} />
            </Box>
          </Box>
          <Box>
            <Text size="xs" style={{ color: "#94a3b8" }}>Top</Text>
            <Box className="hb-swatches">
              <Box className="hb-swatch" data-on={draft.shirt === "#2563eb"} style={{ background: "#2563eb" }} @click={() => setDraftShirt("#2563eb")} />
              <Box className="hb-swatch" data-on={draft.shirt === "#dc2626"} style={{ background: "#dc2626" }} @click={() => setDraftShirt("#dc2626")} />
              <Box className="hb-swatch" data-on={draft.shirt === "#16a34a"} style={{ background: "#16a34a" }} @click={() => setDraftShirt("#16a34a")} />
              <Box className="hb-swatch" data-on={draft.shirt === "#f59e0b"} style={{ background: "#f59e0b" }} @click={() => setDraftShirt("#f59e0b")} />
              <Box className="hb-swatch" data-on={draft.shirt === "#7c3aed"} style={{ background: "#7c3aed" }} @click={() => setDraftShirt("#7c3aed")} />
              <Box className="hb-swatch" data-on={draft.shirt === "#0f172a"} style={{ background: "#0f172a" }} @click={() => setDraftShirt("#0f172a")} />
              <Box className="hb-swatch" data-on={draft.shirt === "#f8fafc"} style={{ background: "#f8fafc" }} @click={() => setDraftShirt("#f8fafc")} />
              <Box className="hb-swatch" data-on={draft.shirt === "#ec4899"} style={{ background: "#ec4899" }} @click={() => setDraftShirt("#ec4899")} />
              <Box className="hb-swatch" data-on={draft.shirt === "#0891b2"} style={{ background: "#0891b2" }} @click={() => setDraftShirt("#0891b2")} />
            </Box>
          </Box>
          <Box>
            <Text size="xs" style={{ color: "#94a3b8" }}>Trousers</Text>
            <Box className="hb-swatches">
              <Box className="hb-swatch" data-on={draft.pants === "#1e3a5f"} style={{ background: "#1e3a5f" }} @click={() => setDraftPants("#1e3a5f")} />
              <Box className="hb-swatch" data-on={draft.pants === "#0f172a"} style={{ background: "#0f172a" }} @click={() => setDraftPants("#0f172a")} />
              <Box className="hb-swatch" data-on={draft.pants === "#57534e"} style={{ background: "#57534e" }} @click={() => setDraftPants("#57534e")} />
              <Box className="hb-swatch" data-on={draft.pants === "#8b5a2b"} style={{ background: "#8b5a2b" }} @click={() => setDraftPants("#8b5a2b")} />
              <Box className="hb-swatch" data-on={draft.pants === "#166534"} style={{ background: "#166534" }} @click={() => setDraftPants("#166534")} />
              <Box className="hb-swatch" data-on={draft.pants === "#7f1d1d"} style={{ background: "#7f1d1d" }} @click={() => setDraftPants("#7f1d1d")} />
              <Box className="hb-swatch" data-on={draft.pants === "#a8a29e"} style={{ background: "#a8a29e" }} @click={() => setDraftPants("#a8a29e")} />
            </Box>
          </Box>
          <Stack direction="horizontal" gap="xs" style={{ marginTop: 6 }}>
            <Button size="sm" variant="primary" @click={confirmDraft}>Move in</Button>
            <Button size="sm" variant="secondary" @click={randomiseDraft}>🎲 Randomise</Button>
          </Stack>
          <Text size="xs" style={{ color: "#94a3b8" }}>The avatar turns on the lawn behind this panel.</Text>
        </Stack>
      </Box>

      <!-- Dialogs -->
      <Box if={dialog === "export"} className="hb-dialog-wrap">
        <Box className="hb-dialog">
          <Stack direction="horizontal" justify="between" align="center" style={{ marginBottom: 8 }}>
            <Heading level={5} style={{ margin: 0, color: "#f8fafc" }}>Export plan</Heading>
            <Button size="xs" variant="secondary" @click={closeDialog}>✕</Button>
          </Stack>
          <Stack direction="horizontal" gap="xs" style={{ marginBottom: 8, flexWrap: "wrap" }}>
            <Button size="xs" variant={exportTab === "json" ? "primary" : "secondary"} @click={() => setExportTab("json")}>Plan JSON</Button>
            <Button size="xs" variant={exportTab === "obj" ? "primary" : "secondary"} @click={() => setExportTab("obj")}>3D model (OBJ)</Button>
            <Button size="xs" variant={exportTab === "mtl" ? "primary" : "secondary"} @click={() => setExportTab("mtl")}>Materials (MTL)</Button>
            <Button size="xs" variant="secondary" @click={copyExport}>📋 Copy</Button>
            <Button if={exportTab === "json"} size="xs" variant="primary" @click={() => downloadExport("json")}>⬇ Download house-plan.json</Button>
            <Button if={exportTab !== "json"} size="xs" variant="primary" @click={downloadModel}>⬇ Download house.obj + house.mtl</Button>
          </Stack>
          <Text if={exportTab === "json"} size="xs" style={{ color: "#94a3b8", display: "block", marginBottom: 8 }}>The plan itself. Import pastes it back in, or pick it from a saved .json file.</Text>
          <Text if={exportTab === "obj"} size="xs" style={{ color: "#94a3b8", display: "block", marginBottom: 8 }}>The whole house as real geometry, metres, Y up. Download gives you house.obj and house.mtl together; keep them in the same folder and open the OBJ in Blender, the three.js editor, SketchUp or any 3D viewer.</Text>
          <Text if={exportTab === "mtl"} size="xs" style={{ color: "#94a3b8", display: "block", marginBottom: 8 }}>The colours for the OBJ, referenced by name from house.obj. Download saves both files.</Text>
          <TextArea className="hb-mono" value={exportText} rows={16} readOnly={true} />
        </Box>
      </Box>
      <Box if={dialog === "import"} className="hb-dialog-wrap">
        <Box className="hb-dialog">
          <Stack direction="horizontal" justify="between" align="center" style={{ marginBottom: 8 }}>
            <Heading level={5} style={{ margin: 0, color: "#f8fafc" }}>Import plan</Heading>
            <Button size="xs" variant="secondary" @click={closeDialog}>✕</Button>
          </Stack>
          <Text size="xs" style={{ color: "#94a3b8", display: "block", marginBottom: 8 }}>Paste plan JSON from an export, or pick a .json file.</Text>
          <TextArea className="hb-mono" value={importText} rows={14} placeholder="{ &quot;walls&quot;: [ ... ] }" @change={setImportText} />
          <Stack direction="horizontal" gap="xs" style={{ marginTop: 10 }}>
            <Button size="sm" variant="primary" @click={doImport}>Import</Button>
            <Button size="sm" variant="secondary" @click={importFromFile}>Choose file…</Button>
          </Stack>
        </Box>
      </Box>
    </Box>

    <!-- Right (live): the click menu -->
    <Box if={appMode === "live"} className="hb-inspector">
      <Box if={menu !== null}>
        <Text className="hb-label">{menu.title.toUpperCase()}</Text>
        <Box className="hb-card">
          <Text size="xs" style={{ color: "#94a3b8", display: "block", marginBottom: 8 }}>{menu.subtitle}</Text>
          <Stack direction="vertical" gap="xs">
            #each (o in menu.options)
              <Box className="ll-menu-opt" @click={chooseOption(o.id)}>{o.label}</Box>
            #end
            <Button size="xs" variant="secondary" @click={closeMenu}>Cancel</Button>
          </Stack>
        </Box>
      </Box>
      <Box if={menu === null}>
        <Text className="hb-label">LIVE</Text>
        <Box className="hb-card">
          <Text size="xs" style={{ color: "#cbd5e1", display: "block", lineHeight: 1.5 }}>Click a piece of furniture for what your sim can do with it, the floor to walk there, or another sim to chat. Turn Auto on and they take care of themselves.</Text>
          <Text size="xs" style={{ color: "#94a3b8", display: "block", marginTop: 8, lineHeight: 1.5 }}>Needs drain through the day and night falls at 8 pm. Beds, fridges, showers, toilets, sofas, TVs, bookshelves, desks and other sims all help.</Text>
        </Box>
      </Box>
      <Box>
        <Text className="hb-label">HOUSE</Text>
        <Box className="hb-card">
          <Box className="hb-kv"><Text>Rooms</Text><b>{roomCount}</b></Box>
          <Box className="hb-kv"><Text>Furniture</Text><b>{itemCount}</b></Box>
          <Box className="hb-kv"><Text>Floor area</Text><b>{floorArea + " m²"}</b></Box>
          <Box className="hb-kv"><Text>Household</Text><b>{householdSize}</b></Box>
        </Box>
        <Button size="xs" variant="secondary" style={{ marginTop: 8 }} @click={() => setAppMode("build")}>🔨 Edit the house</Button>
      </Box>
    </Box>

    <!-- Right: inspector -->
    <Box if={appMode === "build"} className="hb-inspector">
      <Box>
        <Text className="hb-label">SELECTION</Text>
        <Box if={selKind === ""} className="hb-card">
          <Text size="xs" style={{ color: "#94a3b8" }}>Nothing selected. Use the Select tool and click a wall, room, door, window or item.</Text>
        </Box>

        <Box if={selKind === "wall"} className="hb-card">
          <Text style={{ fontWeight: 700, color: "#f8fafc", display: "block", marginBottom: 4 }}>🧱 Wall</Text>
          <Box className="hb-kv"><Text>Length</Text><b>{selInfo.length + " m"}</b></Box>
          <Box className="hb-kv"><Text>Openings</Text><b>{selInfo.openings}</b></Box>
          <Box className="hb-kv"><Text>From</Text><b>{selInfo.from}</b></Box>
          <Box className="hb-kv"><Text>To</Text><b>{selInfo.to}</b></Box>
          <Button size="xs" variant="danger" style={{ marginTop: 6 }} @click={deleteSelected}>Delete wall</Button>
        </Box>

        <Box if={selKind === "room"} className="hb-card">
          <Text style={{ fontWeight: 700, color: "#f8fafc", display: "block", marginBottom: 4 }}>▦ Room</Text>
          <Input size="sm" label="Name" value={selInfo.name} @change={setRoomName} />
          <Box className="hb-kv"><Text>Size</Text><b>{selInfo.size}</b></Box>
          <Box className="hb-kv"><Text>Area</Text><b>{selInfo.area + " m²"}</b></Box>
          <Select size="sm" fullWidth={true} label="Floor" value={selInfo.floor} @change={setRoomFloor} options={[{ value: "wood", label: "Timber" }, { value: "tile", label: "Tiles" }, { value: "carpet", label: "Carpet" }, { value: "stone", label: "Stone" }, { value: "concrete", label: "Concrete" }]} />
          <Button size="xs" variant="danger" style={{ marginTop: 6 }} @click={deleteSelected}>Delete room</Button>
        </Box>

        <Box if={selKind === "opening"} className="hb-card">
          <Text style={{ fontWeight: 700, color: "#f8fafc", display: "block", marginBottom: 4 }}>{selInfo.kind === "door" ? "🚪 Door" : "🪟 Window"}</Text>
          <Input size="sm" type="number" label="Width (m)" min={0.6} max={2.4} step={0.1} value={selInfo.widthText} @change={setOpeningWidth} />
          <Button size="xs" variant="danger" style={{ marginTop: 6 }} @click={deleteSelected}>Remove</Button>
        </Box>

        <Box if={selKind === "item"} className="hb-card">
          <Text style={{ fontWeight: 700, color: "#f8fafc", display: "block", marginBottom: 4 }}>{selInfo.icon + " " + selInfo.title}</Text>
          <Box className="hb-kv"><Text>Footprint</Text><b>{selInfo.footprint}</b></Box>
          <Box className="hb-kv"><Text>Position</Text><b>{selInfo.pos}</b></Box>
          <Box className="hb-kv"><Text>Rotation</Text><b>{selInfo.rot + "°"}</b></Box>
          <Text size="xs" style={{ color: "#94a3b8", display: "block", marginTop: 4 }}>Colour</Text>
          <Box className="hb-swatches">
            <Box className="hb-swatch" data-on={selInfo.color === "#3b82f6"} style={{ background: "#3b82f6" }} @click={() => setItemColor("#3b82f6")} />
            <Box className="hb-swatch" data-on={selInfo.color === "#22c55e"} style={{ background: "#22c55e" }} @click={() => setItemColor("#22c55e")} />
            <Box className="hb-swatch" data-on={selInfo.color === "#ef4444"} style={{ background: "#ef4444" }} @click={() => setItemColor("#ef4444")} />
            <Box className="hb-swatch" data-on={selInfo.color === "#f59e0b"} style={{ background: "#f59e0b" }} @click={() => setItemColor("#f59e0b")} />
            <Box className="hb-swatch" data-on={selInfo.color === "#a855f7"} style={{ background: "#a855f7" }} @click={() => setItemColor("#a855f7")} />
            <Box className="hb-swatch" data-on={selInfo.color === "#475569"} style={{ background: "#475569" }} @click={() => setItemColor("#475569")} />
            <Box className="hb-swatch" data-on={selInfo.color === "#b45309"} style={{ background: "#b45309" }} @click={() => setItemColor("#b45309")} />
            <Box className="hb-swatch" data-on={selInfo.color === "#f8fafc"} style={{ background: "#f8fafc" }} @click={() => setItemColor("#f8fafc")} />
            <Box className="hb-swatch" data-on={selInfo.color === "#8b5a2b"} style={{ background: "#8b5a2b" }} @click={() => setItemColor("#8b5a2b")} />
            <Box className="hb-swatch" data-on={selInfo.color === "#0f172a"} style={{ background: "#0f172a" }} @click={() => setItemColor("#0f172a")} />
          </Box>
          <Stack direction="horizontal" gap="xs" style={{ marginTop: 8, flexWrap: "wrap" }}>
            <Button size="xs" variant="secondary" @click={rotatePreview}>⟳ Rotate</Button>
            <Button size="xs" variant="secondary" @click={duplicateSelected}>Duplicate</Button>
            <Button size="xs" variant="danger" @click={deleteSelected}>Delete</Button>
          </Stack>
        </Box>
      </Box>

      <Box>
        <Text className="hb-label">PLAN</Text>
        <Box className="hb-card">
          <Box className="hb-kv"><Text>Walls</Text><b>{wallCount}</b></Box>
          <Box className="hb-kv"><Text>Rooms</Text><b>{roomCount}</b></Box>
          <Box className="hb-kv"><Text>Items</Text><b>{itemCount}</b></Box>
          <Box className="hb-kv"><Text>Floor area</Text><b>{floorArea + " m²"}</b></Box>
        </Box>
      </Box>

      <Box>
        <Text className="hb-label">KEYS</Text>
        <Box className="hb-card">
          <Box className="hb-kv"><Text>Tools</Text><b>1 – 7</b></Box>
          <Box className="hb-kv"><Text>Zoom</Text><b>Wheel, + / −</b></Box>
          <Box className="hb-kv"><Text>Pan</Text><b>Drag ground, arrows</b></Box>
          <Box className="hb-kv"><Text>Straight wall</Text><b>Hold Shift</b></Box>
          <Box className="hb-kv"><Text>Rotate item</Text><b>R</b></Box>
          <Box className="hb-kv"><Text>Nudge item</Text><b>Shift + arrows</b></Box>
          <Box className="hb-kv"><Text>Delete</Text><b>Del</b></Box>
          <Box className="hb-kv"><Text>Undo / Redo</Text><b>Ctrl Z / Y</b></Box>
          <Box className="hb-kv"><Text>Centre</Text><b>F</b></Box>
          <Box className="hb-kv"><Text>Cancel</Text><b>Esc</b></Box>
        </Box>
      </Box>
    </Box>
  </Box>

  <!-- Status bar -->
  <Box className="hb-status">
    <Text>{appMode === "live" ? liveStatus : statusText}</Text>
    <Text style={{ color: "#94a3b8" }}>{appMode === "live" ? clockText : coordText}</Text>
  </Box>
</Box>
