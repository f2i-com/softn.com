// Dead Hours — the game: waves of the dead come through the gates of a yard
// at night, and you hold it with a pistol and a shotgun until you cannot.
//
// Loop: `gameStep` (never tick/update/animate/render, which the runtime may
// drop). Shooting is a ray against each zombie's head sphere and body box,
// occluded by the arena's blockers; the scene's own pointer-locked click is
// only the trigger.

let TICK_MS = 33
let DT = 0.033
let P_EYE = 1.62
let P_R = 0.42
let WALK = 5.2
let SPRINT = 7.6

// Synced to the UI.
let objects = []
let lights = []
let cameraPos = { x: 0, y: 1.62, z: 0 }
let cameraLookAt = { x: 0, y: 1.62, z: 5 }
let sceneFog = { color: "#0b0f1a", near: 14, far: 72 }
let skyColor = "#070a12"
let started = false
let gameOver = false
let paused = false
let showHelp = false
let touchMode = false
let hud = { hp: 100, ammo: 0, reserve: 0, weapon: "Pistol", wave: 0, kills: 0, score: 0, reloading: false, best: 0 }
let waveBanner = ""
let bannerTicks = 0
let toast = ""
let toastTicks = 0
let hurtFlash = 0
let hitMark = 0
let torchOn = true
let finalName = ""
let boardRows = []
let boardStatus = ""
let scorePosted = false

// Player and world state in the VM.
let px = 0
let pz = 4
let vx = 0
let vz = 0
let yaw = Math.PI
let pitch = 0
let hp = 100
let score = 0
let kills = 0
let wave = 0
let waveTimer = 0
let waveState = "between"     // between | active
let toSpawn = 0
let spawnTimer = 0
let zombies = []
let nextZid = 1
let pickups = []
let nextPid = 1
let particles = []
let rngSeed = 7
let lastLocked = false
let bobPhase = 0
let flashTicks = 0
let recoil = 0
let hurtTicks = 0
let attackFlash = 0
let holes = []            // bullet holes: { x, y, z, nx, ny, nz, rot, size, age, ground }
let bloods = []           // blood on the ground: { x, z, rot, size, age }
let swapTicks = 0         // the new weapon rising into view
let pumpTicks = 0         // a shotgun's fore-end travelling after a shot
let shake = 0             // camera kick

// Weapons: fire rate and reload in ticks, damage per shot, pellets per shot.
let weapons = [
  { name: "Pistol", mag: 12, reserve: -1, dmg: 34, pellets: 1, spread: 0.012, rate: 7, reload: 36, sfx: "assets/sfx/pistol.wav" },
  { name: "Shotgun", mag: 6, reserve: 18, dmg: 16, pellets: 8, spread: 0.075, rate: 24, reload: 60, sfx: "assets/sfx/shotgun.wav" }
]
let weaponIdx = 0
let ammo = [12, 6]
let reserve = [-1, 18]
let fireCooldown = 0
let reloadTicks = 0
let triggerHeld = false

let ZTYPES = [
  { name: "walker", hp: 100, speed: 1.9, scale: 1.0, dmg: 10, body: "#526e4e", head: "#869b7f", cloth: "#333d47", score: 100 },
  { name: "runner", hp: 65, speed: 4.1, scale: 0.92, dmg: 7, body: "#991b1b", head: "#b91c1c", cloth: "#450a0a", score: 140 },
  { name: "brute", hp: 320, speed: 1.35, scale: 1.48, dmg: 22, body: "#3f4a3c", head: "#5f6f5a", cloth: "#1e242b", score: 300 }
]

function myRand() {
  rngSeed = (rngSeed * 48271) % 2147483647
  return rngSeed / 2147483647
}

// ---- Init and input ------------------------------------------------------

function isUiControl(e) {
  let tag = e.targetTag || ""
  return tag === "input" || tag === "textarea" || tag === "select" || tag === "button" || !!e.targetEditable
}

function _init() {
  if (window.__dhCleanup) { window.__dhCleanup() }
  rngSeed = (Date.now() % 100000) + 3
  window.__dhKeys = { w: false, a: false, s: false, d: false, sprint: false, fire: false }
  window.__dhFire = false
  window.__dhReload = false
  window.__dhSwap = -1
  window.__dhTouch = false
  window.__scene3dLocked = false
  window.__scene3dWantLock = false
  window.__scene3dReleaseLock = false

  function onKeyDown(e) {
    if (isUiControl(e)) { return }
    let k = window.__dhKeys
    let key = e.key || ""
    if (key === "w" || key === "W" || key === "ArrowUp") { k.w = true; e.preventDefault() }
    else if (key === "s" || key === "S" || key === "ArrowDown") { k.s = true; e.preventDefault() }
    else if (key === "a" || key === "A" || key === "ArrowLeft") { k.a = true; e.preventDefault() }
    else if (key === "d" || key === "D" || key === "ArrowRight") { k.d = true; e.preventDefault() }
    else if (key === "Shift") { k.sprint = true }
    else if (key === "r" || key === "R") { window.__dhReload = true }
    else if (key === "1") { window.__dhSwap = 0 }
    else if (key === "2") { window.__dhSwap = 1 }
    else if (key === "q" || key === "Q") { window.__dhSwap = 2 }
    else if (key === " ") { window.__dhFire = true; e.preventDefault() }
    else if (key === "h" || key === "H") { window.__dhSwap = 3 }
    else if (key === "f" || key === "F") { if (!e.repeat) { window.__dhSwap = 4 } }
  }
  function onKeyUp(e) {
    let k = window.__dhKeys
    let key = e.key || ""
    if (key === "w" || key === "W" || key === "ArrowUp") { k.w = false }
    else if (key === "s" || key === "S" || key === "ArrowDown") { k.s = false }
    else if (key === "a" || key === "A" || key === "ArrowLeft") { k.a = false }
    else if (key === "d" || key === "D" || key === "ArrowRight") { k.d = false }
    else if (key === "Shift") { k.sprint = false }
  }
  function onBlur() {
    window.__dhKeys = { w: false, a: false, s: false, d: false, sprint: false, fire: false }
  }
  function onTouch(e) { window.__dhTouch = true }
  window.addEventListener("keydown", onKeyDown, true)
  window.addEventListener("keyup", onKeyUp, true)
  window.addEventListener("blur", onBlur)
  window.addEventListener("touchstart", onTouch)
  window.__dhCleanup = function () {
    window.removeEventListener("keydown", onKeyDown, true)
    window.removeEventListener("keyup", onKeyUp, true)
    window.removeEventListener("blur", onBlur)
    window.removeEventListener("touchstart", onTouch)
  }

  let best = 0
  try { best = parseInt(localStorage.getItem("deadhours:best") || "0") || 0 } catch (err) { best = 0 }
  try { finalName = localStorage.getItem("deadhours:name") || "" } catch (err) { finalName = "" }
  hud.best = best
  buildArena()
  loadBoard()
  titleAngle = 0
  titleOrbit()
  buildLights()
  composeObjects()
}

// Before the game starts the camera drifts around the yard, and a few of
// the dead wander the middle of it so the player can see what is coming.
let titleAngle = 0
let showcase = []
function makeShowcase() {
  showcase = []
  let i = 0
  while (i < 3) {
    let t = ZTYPES[i]
    showcase.push({ id: 900 + i, type: i, x: Math.cos(i * 2.1) * 3.5, z: Math.sin(i * 2.1) * 3.5, hp: 1, speed: t.speed * 0.35, scale: t.scale, dir: i * 2.1 + Math.PI / 2, phase: i * 2, state: "walk", flash: 0, attackTicks: 0, deadTicks: 0, stagger: 0, headless: false, fallDir: 1, turn: 0.004 + i * 0.002 })
    i = i + 1
  }
}
function stepShowcase() {
  let i = 0
  while (i < showcase.length) {
    let z = showcase[i]
    z.dir = z.dir + z.turn
    let d2 = z.x * z.x + z.z * z.z
    if (d2 > 30) { z.dir = Math.atan2(-z.x, -z.z) }
    z.x = z.x + Math.sin(z.dir) * z.speed * DT
    z.z = z.z + Math.cos(z.dir) * z.speed * DT
    z.phase = z.phase + z.speed * 0.5 * DT * 6
    i = i + 1
  }
}
function titleOrbit() {
  titleAngle = titleAngle + 0.0016
  px = Math.cos(titleAngle) * 15
  pz = Math.sin(titleAngle) * 15
  yaw = Math.atan2(-px, -pz)
  pitch = -0.1
  window.__scene3dYaw = yaw
  window.__scene3dPitch = pitch
  updateCamera(2.6)
}

// ---- Game flow ------------------------------------------------------------

function startGame() {
  px = 0; pz = 4; vx = 0; vz = 0
  yaw = Math.PI; pitch = 0
  hp = 100; score = 0; kills = 0; wave = 0
  zombies = []; pickups = []; particles = []
  weaponIdx = 0
  ammo = [12, 6]
  reserve = [-1, 18]
  fireCooldown = 0; reloadTicks = 0
  toSpawn = 0; spawnTimer = 0
  hurtTicks = 0; hurtFlash = 0; hitMark = 0; recoil = 0; flashTicks = 0; bobPhase = 0
  holes = []; bloods = []; swapTicks = 0; pumpTicks = 0; shake = 0
  toast = ""; toastTicks = 0
  waveState = "between"
  waveTimer = Math.ceil(4000 / TICK_MS)
  scorePosted = false
  gameOver = false
  paused = false
  showHelp = false
  started = true
  // Whatever was pressed on the last card must not fire on the first tick.
  window.__dhFire = false
  window.__dhReload = false
  window.__dhSwap = -1
  window.__scene3dYaw = yaw
  window.__scene3dPitch = pitch
  window.__scene3dWantLock = true
  showBanner("Night falls. They are coming.")
  updateCamera(0)
}

function backToTitle() {
  started = false
  gameOver = false
  paused = false
  showHelp = false
  waveBanner = ""; bannerTicks = 0
  toast = ""; toastTicks = 0
  zombies = []
  pickups = []
  particles = []
  holes = []
  bloods = []
  loadBoard()
}

function resumeGame() {
  paused = false
  window.__scene3dWantLock = true
}
function toggleHelp() { showHelp = !showHelp }

function showBanner(text) {
  waveBanner = text
  bannerTicks = Math.ceil(2800 / TICK_MS)
}

function showToast(text) {
  toast = text
  toastTicks = Math.ceil(2200 / TICK_MS)
}

function startWave() {
  wave = wave + 1
  waveState = "active"
  toSpawn = 2 + wave * 2 + Math.floor(wave * wave * 0.35)
  spawnTimer = 0
  showBanner("Wave " + wave)
  softn.audio.play("assets/sfx/wave.wav", { volume: 0.5 })
}

function endWave() {
  waveState = "between"
  waveTimer = Math.ceil(7000 / TICK_MS)
  score = score + wave * 150
  showBanner("Wave " + wave + " cleared  ·  +" + (wave * 150))
  // Something to hold the next wave with.
  if (myRand() < 0.7) { dropPickup(px + (myRand() - 0.5) * 6, pz + (myRand() - 0.5) * 6, "shells") }
  if (hp < 70) { dropPickup(px + (myRand() - 0.5) * 6, pz + (myRand() - 0.5) * 6, "medkit") }
}

function die() {
  gameOver = true
  hud.hp = 0
  // The card that follows wants a name typed and a button clicked.
  window.__scene3dReleaseLock = true
  if (score > hud.best) {
    hud.best = score
    try { localStorage.setItem("deadhours:best", String(score)) } catch (err) {}
  }
  softn.audio.play("assets/sfx/hurt.wav", { volume: 0.7 })
}

// ---- The master step ------------------------------------------------------

function gameStep() {
  if (!started) {
    titleOrbit()
    if (showcase.length === 0) { makeShowcase() }
    stepShowcase()
    buildLights()
    composeObjects()
    return
  }
  let locked = !!window.__scene3dLocked
  if (lastLocked && !locked && !touchMode && !gameOver) { paused = true }
  lastLocked = locked
  if (window.__dhTouch) { touchMode = true }
  if (bannerTicks > 0) { bannerTicks = bannerTicks - 1; if (bannerTicks === 0) { waveBanner = "" } }
  if (toastTicks > 0) { toastTicks = toastTicks - 1; if (toastTicks === 0) { toast = "" } }
  if (window.__dhSwap === 3) { window.__dhSwap = -1; showHelp = !showHelp }
  if (window.__dhSwap === 4) { window.__dhSwap = -1; torchOn = !torchOn; showToast(torchOn ? "Torch on" : "Torch off"); softn.audio.play("assets/sfx/click.wav", { volume: 0.3 }) }

  if (!paused && !gameOver) {
    if (window.__scene3dYaw !== undefined) { yaw = window.__scene3dYaw }
    if (window.__scene3dPitch !== undefined) { pitch = window.__scene3dPitch }
    handleWeaponInput()
    movePlayer()
    stepWaves()
    stepZombies()
    stepPickups()
    checkPlayer()
  }
  stepParticles()
  stepDecals()
  if (swapTicks > 0) { swapTicks = swapTicks - 1 }
  if (pumpTicks > 0) { pumpTicks = pumpTicks - 1 }
  if (shake > 0) { shake = shake * 0.8; if (shake < 0.002) { shake = 0 } }
  if (fireCooldown > 0) { fireCooldown = fireCooldown - 1 }
  if (flashTicks > 0) { flashTicks = flashTicks - 1 }
  if (recoil > 0) { recoil = recoil * 0.72; if (recoil < 0.004) { recoil = 0 } }
  if (hurtTicks > 0) { hurtTicks = hurtTicks - 1 }
  if (hitMark > 0) { hitMark = hitMark - 1 }
  hurtFlash = hurtTicks > 0 ? Math.min(0.55, hurtTicks / 12 * 0.55) : (hp < 30 ? 0.18 + 0.1 * Math.sin(bobPhase * 0.4) : 0)
  updateCamera(0)
  buildLights()
  composeObjects()
  let w = weapons[weaponIdx]
  // Shell pips for the ammo panel, and a crosshair that opens with movement and recoil.
  let pips = []
  let pi = 0
  while (pi < w.mag) { pips.push({ on: pi < ammo[weaponIdx] }); pi = pi + 1 }
  let moving = (vx * vx + vz * vz) > 1
  hud = { hp: Math.max(0, Math.round(hp)), ammo: ammo[weaponIdx], reserve: reserve[weaponIdx], weapon: w.name, wave: wave, kills: kills, score: score, reloading: reloadTicks > 0, best: hud.best,
    countdown: waveState === "between" ? Math.ceil(waveTimer * TICK_MS / 1000) : 0, left: countAlive() + toSpawn,
    pips: pips, reloadPct: reloadTicks > 0 ? Math.round((1 - reloadTicks / w.reload) * 100) : 0,
    spread: Math.round(6 + (moving ? 6 : 0) + recoil * 90 + (weaponIdx === 1 ? 6 : 0)), lowAmmo: ammo[weaponIdx] <= Math.ceil(w.mag / 4) }
}

function countAlive() {
  let n = 0
  let i = 0
  while (i < zombies.length) { if (zombies[i].state !== "dead") { n = n + 1 }; i = i + 1 }
  return n
}

function updateCamera(extraY) {
  let bob = 0
  if ((vx * vx + vz * vz) > 1) { bob = Math.sin(bobPhase) * 0.035 }
  let kx = shake > 0 ? Math.sin(bobPhase * 9.1) * shake : 0
  let ky = shake > 0 ? Math.cos(bobPhase * 7.3) * shake * 0.6 : 0
  cameraPos = { x: px + kx, y: P_EYE + bob + extraY + ky, z: pz }
  let cp = Math.cos(pitch)
  cameraLookAt = { x: px + Math.sin(yaw) * cp * 5, y: P_EYE + extraY + Math.sin(pitch) * 5, z: pz + Math.cos(yaw) * cp * 5 }
}

function movePlayer() {
  let k = window.__dhKeys
  if (!k) { return }
  let fwd = (k.w ? 1 : 0) - (k.s ? 1 : 0)
  let str = (k.d ? 1 : 0) - (k.a ? 1 : 0)
  let len = Math.sqrt(fwd * fwd + str * str)
  if (len > 0) { fwd = fwd / len; str = str / len }
  let speed = k.sprint ? SPRINT : WALK
  let wx = Math.sin(yaw) * fwd - Math.cos(yaw) * str
  let wz = Math.cos(yaw) * fwd + Math.sin(yaw) * str
  vx = vx + (wx * speed - vx) * 0.32
  vz = vz + (wz * speed - vz) * 0.32
  slide(px, pz, vx * DT, vz * DT, P_R)
  px = moveX
  pz = moveZ
  if ((vx * vx + vz * vz) > 1) { bobPhase = bobPhase + 0.3 } else { bobPhase = bobPhase + 0.05 }
}

// ---- Weapons --------------------------------------------------------------

function handleWeaponInput() {
  if (window.__dhSwap === 0 || window.__dhSwap === 1) { swapWeapon(window.__dhSwap); window.__dhSwap = -1 }
  else if (window.__dhSwap === 2) { swapWeapon(weaponIdx === 0 ? 1 : 0); window.__dhSwap = -1 }
  if (window.__dhReload) { window.__dhReload = false; startReload() }
  if (reloadTicks > 0) {
    reloadTicks = reloadTicks - 1
    if (reloadTicks === 0) { finishReload() }
    window.__dhFire = false
    return
  }
  if (window.__dhFire) {
    window.__dhFire = false
    fire()
  }
}

function swapWeapon(i) {
  if (i === weaponIdx) { return }
  // A swap mid-reload abandons the reload; the rounds stay in the box.
  reloadTicks = 0
  weaponIdx = i
  fireCooldown = 10
  swapTicks = 10
  pumpTicks = 0
  showToast(weapons[i].name)
}

function startReload() {
  let w = weapons[weaponIdx]
  if (reloadTicks > 0 || ammo[weaponIdx] >= w.mag) { return }
  if (reserve[weaponIdx] === 0) { showToast("No shells left. Find a box."); return }
  reloadTicks = w.reload
  softn.audio.play("assets/sfx/reload.wav", { volume: 0.5 })
}

function finishReload() {
  let w = weapons[weaponIdx]
  if (reserve[weaponIdx] < 0) { ammo[weaponIdx] = w.mag; return }
  let need = w.mag - ammo[weaponIdx]
  let take = Math.min(need, reserve[weaponIdx])
  ammo[weaponIdx] = ammo[weaponIdx] + take
  reserve[weaponIdx] = reserve[weaponIdx] - take
}

function fire() {
  if (fireCooldown > 0) { return }
  let w = weapons[weaponIdx]
  if (ammo[weaponIdx] <= 0) {
    fireCooldown = 6
    softn.audio.play("assets/sfx/click.wav", { volume: 0.4 })
    if (reserve[weaponIdx] !== 0) { startReload() } else { showToast("Empty.") }
    return
  }
  ammo[weaponIdx] = ammo[weaponIdx] - 1
  fireCooldown = w.rate
  flashTicks = 2
  recoil = weaponIdx === 1 ? 0.16 : 0.07
  shake = weaponIdx === 1 ? 0.035 : 0.012
  if (weaponIdx === 1) { pumpTicks = 18 }
  softn.audio.play(w.sfx, { volume: weaponIdx === 1 ? 0.75 : 0.6 })
  ejectCasing()
  let cp = Math.cos(pitch)
  let fx = Math.sin(yaw) * cp
  let fy = Math.sin(pitch)
  let fz = Math.cos(yaw) * cp
  // A right vector and an up vector to spread the pellets around the aim.
  let rx = -Math.cos(yaw)
  let rz = Math.sin(yaw)
  let ux = -Math.sin(yaw) * Math.sin(pitch)
  let uy = Math.cos(pitch)
  let uz = -Math.cos(yaw) * Math.sin(pitch)
  let p = 0
  let hitAny = false
  while (p < w.pellets) {
    let sx = (myRand() - 0.5) * 2 * w.spread
    let sy = (myRand() - 0.5) * 2 * w.spread
    let dx = fx + rx * sx + ux * sy
    let dy = fy + uy * sy
    let dz = fz + rz * sx + uz * sy
    let l = Math.sqrt(dx * dx + dy * dy + dz * dz)
    if (shootRay(px, P_EYE, pz, dx / l, dy / l, dz / l, w.dmg)) { hitAny = true }
    p = p + 1
  }
  if (hitAny) { hitMark = 5 }
  if (ammo[weaponIdx] === 0 && reserve[weaponIdx] !== 0) { startReload() }
}

// One pellet: the nearest zombie part along the ray, unless a blocker is
// closer. Returns whether it hit flesh.
function shootRay(ox, oy, oz, dx, dy, dz, dmg) {
  let wall = rayBlockerDist(ox, oy, oz, dx, dy, dz)
  let best = wall
  let bestZ = null
  let headshot = false
  let i = 0
  while (i < zombies.length) {
    let z = zombies[i]
    if (z.state !== "dead") {
      let s = z.scale
      let th = raySphere(ox, oy, oz, dx, dy, dz, z.x, 1.62 * s, z.z, 0.26 * s)
      if (th >= 0 && th < best) { best = th; bestZ = z; headshot = true }
      let tb = rayAabb(ox, oy, oz, dx, dy, dz, z.x - 0.36 * s, 0, z.z - 0.36 * s, z.x + 0.36 * s, 1.42 * s, z.z + 0.36 * s)
      if (tb >= 0 && tb < best) { best = tb; bestZ = z; headshot = false }
    }
    i = i + 1
  }
  if (bestZ === null) {
    if (rayBlockerHit(ox, oy, oz, dx, dy, dz) && hitT < 60) {
      let hx = ox + dx * hitT
      let hy = oy + dy * hitT
      let hz = oz + dz * hitT
      spawnPuff(hx, hy, hz, hitGround ? "#5a5548" : "#6b6f78", 3)
      addHole(hx, hy, hz, hitNx, hitNy, hitNz, hitGround)
    }
    return false
  }
  let dealt = headshot ? dmg * 2.2 : dmg
  bestZ.hp = bestZ.hp - dealt
  bestZ.flash = 4
  // A hit shoves the walker back a touch and slows a runner's charge.
  slide(bestZ.x, bestZ.z, dx * 0.12, dz * 0.12, 0.36 * bestZ.scale)
  bestZ.x = moveX
  bestZ.z = moveZ
  spawnPuff(ox + dx * best, oy + dy * best, oz + dz * best, "#7a1b1b", headshot ? 7 : 4)
  bestZ.stagger = headshot ? 10 : 6
  addBlood(bestZ.x + dx * 0.5 + (myRand() - 0.5) * 0.4, bestZ.z + dz * 0.5 + (myRand() - 0.5) * 0.4, 0.35 + myRand() * 0.35)
  // A shot that goes on through the body marks whatever is behind.
  if (myRand() < 0.5 && rayBlockerHit(ox, oy, oz, dx, dy, dz) && hitT < 30 && hitT > best) {
    addHole(ox + dx * hitT, oy + dy * hitT, oz + dz * hitT, hitNx, hitNy, hitNz, hitGround)
  }
  if (bestZ.hp <= 0) { killZombie(bestZ, headshot) }
  else { softn.audio.play("assets/sfx/hit.wav", { volume: 0.35 }) }
  return true
}

function killZombie(z, headshot) {
  z.state = "dead"
  z.deadTicks = 0
  z.headless = headshot
  z.fallDir = myRand() < 0.5 ? 1 : -1
  addBlood(z.x, z.z, 0.9 + myRand() * 0.5)
  if (headshot) {
    // The head comes away: a chunk of it flies, and a lot of the rest.
    spawnPuff(z.x, 1.62 * z.scale, z.z, "#7a1b1b", 14)
    particles.push({ x: z.x, y: 1.66 * z.scale, z: z.z, vx: -Math.sin(z.dir) * 2.5 + (myRand() - 0.5) * 2, vy: 3.5, vz: -Math.cos(z.dir) * 2.5 + (myRand() - 0.5) * 2, life: 70, color: ZTYPES[z.type].head, size: 0.34 * z.scale, spin: 0.3, chunk: true })
  }
  kills = kills + 1
  let t = ZTYPES[z.type]
  let gained = t.score + (headshot ? 50 : 0)
  score = score + gained
  if (headshot) { showToast("Headshot  +" + gained) }
  softn.audio.play("assets/sfx/groan.wav", { volume: 0.45, rate: 0.8 + myRand() * 0.4 })
  let roll = myRand()
  if (roll < 0.22) { dropPickup(z.x, z.z, "shells") }
  else if (roll < 0.30) { dropPickup(z.x, z.z, "medkit") }
}

// ---- The dead -------------------------------------------------------------

function stepWaves() {
  if (waveState === "between") {
    waveTimer = waveTimer - 1
    if (waveTimer <= 0) { startWave() }
    return
  }
  if (toSpawn > 0) {
    spawnTimer = spawnTimer - 1
    if (spawnTimer <= 0) {
      spawnZombie()
      toSpawn = toSpawn - 1
      spawnTimer = Math.max(6, Math.ceil((1400 - wave * 90) / TICK_MS))
    }
  } else {
    let alive = 0
    let i = 0
    while (i < zombies.length) { if (zombies[i].state !== "dead") { alive = alive + 1 }; i = i + 1 }
    if (alive === 0) { endWave() }
  }
}

function spawnZombie() {
  let gi = Math.floor(myRand() * gates.length)
  let g = gates[gi]
  let type = 0
  let r = myRand()
  if (wave >= 5 && r < 0.12 + wave * 0.01) { type = 2 }
  else if (wave >= 2 && r < 0.35 + wave * 0.03) { type = 1 }
  let t = ZTYPES[type]
  let mult = 1 + (wave - 1) * 0.06
  zombies.push({
    id: nextZid, type: type, x: g.x + (myRand() - 0.5) * 2, z: g.z + (myRand() - 0.5) * 2,
    hp: t.hp * mult, speed: t.speed * (0.9 + myRand() * 0.25), scale: t.scale * (0.92 + myRand() * 0.16),
    dir: 0, phase: myRand() * 6.28, state: "walk", flash: 0, attackTicks: 0, deadTicks: 0, groan: Math.floor(myRand() * 200), gate: gi,
    side: (nextZid % 2 === 0) ? 1 : -1, stuck: 0, evade: 0, stagger: 0, headless: false, fallDir: 1
  })
  nextZid = nextZid + 1
}

function stepZombies() {
  let keep = []
  let i = 0
  while (i < zombies.length) {
    let z = zombies[i]
    if (z.state === "dead") {
      z.deadTicks = z.deadTicks + 1
      if (z.deadTicks < 90) { keep.push(z) }
      i = i + 1
      continue
    }
    if (z.flash > 0) { z.flash = z.flash - 1 }
    if (z.stagger > 0) { z.stagger = z.stagger - 1 }
    let dx = px - z.x
    let dz = pz - z.z
    let dist = Math.sqrt(dx * dx + dz * dz)
    // Outside the fence the only way in is the gate it came from: walk to
    // the inside of that gate first, then hunt.
    let outside = Math.abs(z.x) > ARENA - 0.6 || Math.abs(z.z) > ARENA - 0.6
    let tx = dx
    let tz = dz
    if (outside) {
      z.gate = nearestGate(z.x, z.z)
      let g = gates[z.gate]
      let gx = g.x === 0 ? 0 : (g.x > 0 ? ARENA - 2 : -(ARENA - 2))
      let gz = g.z === 0 ? 0 : (g.z > 0 ? ARENA - 2 : -(ARENA - 2))
      tx = gx - z.x
      tz = gz - z.z
      dist = Math.sqrt(tx * tx + tz * tz) + 10
    }
    z.dir = Math.atan2(tx, tz)
    let t = ZTYPES[z.type]
    let reach = 1.15 + 0.3 * z.scale
    if (dist > reach) {
      z.state = "walk"
      let sp = z.speed
      let tl = Math.sqrt(tx * tx + tz * tz)
      let mx = tx / tl * sp
      let mz = tz / tl * sp
      // Keep the pack from stacking: push away from close neighbours. Not
      // while queueing through a gate, where a push means the fence.
      let j = 0
      while (j < zombies.length && !outside) {
        let o = zombies[j]
        if (o !== z && o.state !== "dead") {
          let ox = z.x - o.x
          let oz = z.z - o.z
          let d2 = ox * ox + oz * oz
          if (d2 < 1.2 && d2 > 0.0001) {
            let d = Math.sqrt(d2)
            mx = mx + ox / d * (1.2 - d) * 2.2
            mz = mz + oz / d * (1.2 - d) * 2.2
          }
        }
        j = j + 1
      }
      let rad = 0.36 * z.scale
      slide(z.x, z.z, mx * DT, mz * DT, rad)
      // Progress along the way it wants to go. A wall it creeps along makes
      // some movement but no progress, and that is being stuck too.
      let want = Math.sqrt(mx * mx + mz * mz)
      let prog = want > 0 ? ((moveX - z.x) * mx + (moveZ - z.z) * mz) / want : 0
      if (z.evade > 0 || prog < want * DT * 0.3) {
        // Sidestep, and stay with it for a while so the obstacle's edge is
        // actually reached; when that way is blocked as well (a corner),
        // try the other side.
        if (z.evade <= 0) { z.evade = 24 }
        let sx = -mz * z.side + mx * 0.3
        let sz = mx * z.side + mz * 0.3
        slide(z.x, z.z, sx * DT, sz * DT, rad)
        if (Math.abs(moveX - z.x) + Math.abs(moveZ - z.z) < 0.004) {
          z.stuck = z.stuck + 1
          if (z.stuck > 3) { z.side = -z.side; z.stuck = 0; z.evade = 24 }
        } else {
          z.stuck = 0
        }
        z.evade = z.evade - 1
      } else {
        z.stuck = 0
      }
      z.x = moveX
      z.z = moveZ
      z.phase = z.phase + sp * 0.5 * DT * 6
      z.groan = z.groan - 1
      if (z.groan <= 0) {
        z.groan = 150 + Math.floor(myRand() * 300)
        if (dist < 16) { softn.audio.play("assets/sfx/groan.wav", { volume: Math.max(0.08, 0.35 - dist * 0.015), rate: 0.7 + myRand() * 0.5 }) }
      }
    } else {
      z.state = "attack"
      z.attackTicks = z.attackTicks + 1
      if (z.attackTicks >= 40) {
        z.attackTicks = 0
        hurtPlayer(t.dmg)
      }
    }
    keep.push(z)
    i = i + 1
  }
  zombies = keep
}

function nearestGate(x, z) {
  let best = 0
  let bestD = 1e9
  let i = 0
  while (i < gates.length) {
    let dx = gates[i].x - x
    let dz = gates[i].z - z
    let d = dx * dx + dz * dz
    if (d < bestD) { bestD = d; best = i }
    i = i + 1
  }
  return best
}

function hurtPlayer(dmg) {
  if (gameOver || hurtTicks > 6) { return }
  hp = hp - dmg
  hurtTicks = 12
  softn.audio.play("assets/sfx/hurt.wav", { volume: 0.5 })
  if (hp <= 0) { hp = 0; die() }
}

function checkPlayer() {
  // The fence line is the edge of the yard: a gate is their way in, not your
  // way out. Past it the dead spawn on top of you and the rest lose the path.
  let lim = ARENA - 0.5
  if (px > lim) { px = lim } else if (px < -lim) { px = -lim }
  if (pz > lim) { pz = lim } else if (pz < -lim) { pz = -lim }
}

// ---- Pickups ----------------------------------------------------------------

function dropPickup(x, z, kind) {
  let lim = ARENA - 1
  if (x > lim) { x = lim } else if (x < -lim) { x = -lim }
  if (z > lim) { z = lim } else if (z < -lim) { z = -lim }
  // Not inside a car or a shed, where it could never be picked up.
  let tries = 0
  while (circleBlocked(x, z, 0.3) && tries < 12) {
    let ang = myRand() * Math.PI * 2
    let r = 1.5 + tries * 0.5
    x = Math.max(-lim, Math.min(lim, x + Math.cos(ang) * r))
    z = Math.max(-lim, Math.min(lim, z + Math.sin(ang) * r))
    tries = tries + 1
  }
  if (circleBlocked(x, z, 0.3)) { x = px; z = pz }
  pickups.push({ id: nextPid, x: x, z: z, kind: kind, age: 0 })
  nextPid = nextPid + 1
}

function stepPickups() {
  let keep = []
  let i = 0
  while (i < pickups.length) {
    let p = pickups[i]
    p.age = p.age + 1
    let dx = px - p.x
    let dz = pz - p.z
    if (dx * dx + dz * dz < 1.1) {
      if (p.kind === "shells") {
        reserve[1] = reserve[1] + 8
        showToast("+8 shells")
      } else {
        hp = Math.min(100, hp + 40)
        showToast("Medkit  +40")
      }
      softn.audio.play("assets/sfx/pickup.wav", { volume: 0.5 })
    } else if (p.age < 1500) {
      keep.push(p)
    }
    i = i + 1
  }
  pickups = keep
}

// ---- Particles ---------------------------------------------------------------

function spawnPuff(x, y, z, color, n) {
  let i = 0
  while (i < n) {
    particles.push({ x: x, y: y, z: z, vx: (myRand() - 0.5) * 3, vy: 1 + myRand() * 2.5, vz: (myRand() - 0.5) * 3, life: 10 + Math.floor(myRand() * 8), color: color, size: 0.06 + myRand() * 0.08 })
    i = i + 1
  }
}

// A spent case out of the ejection port: brass for the pistol, a red hull
// for the shotgun, tumbling off to the right and down.
function ejectCasing() {
  let cp = Math.cos(pitch)
  let fx = Math.sin(yaw) * cp
  let fz = Math.cos(yaw) * cp
  let rx = -Math.cos(yaw)
  let rz = Math.sin(yaw)
  let ox = px + fx * 0.45 + rx * 0.3
  let oz = pz + fz * 0.45 + rz * 0.3
  let shotgun = weaponIdx === 1
  particles.push({ x: ox, y: P_EYE - 0.18, z: oz, vx: rx * (1.6 + myRand()) + fx * 0.3, vy: 2.2 + myRand() * 0.8, vz: rz * (1.6 + myRand()) + fz * 0.3, life: 50, color: shotgun ? "#b91c1c" : "#d4a72c", size: shotgun ? 0.055 : 0.03, spin: 0.5 + myRand() * 0.4, casing: true, tall: shotgun ? 2.2 : 1.8 })
}

function stepParticles() {
  if (particles.length === 0) { return }
  let keep = []
  let i = 0
  while (i < particles.length) {
    let p = particles[i]
    p.vy = p.vy - 14 * DT
    p.x = p.x + p.vx * DT
    p.y = p.y + p.vy * DT
    p.z = p.z + p.vz * DT
    if (p.spin) { p.rot = (p.rot || 0) + p.spin }
    let floor = p.chunk ? p.size / 2 : (p.casing ? 0.02 : 0.03)
    if (p.y < floor) {
      p.y = floor
      if (p.casing && p.vy < -0.8) { p.vy = -p.vy * 0.35; p.vx = p.vx * 0.5; p.vz = p.vz * 0.5 }
      else { p.vy = 0; p.vx = 0; p.vz = 0; p.spin = 0 }
    }
    p.life = p.life - 1
    if (p.life > 0) { keep.push(p) }
    i = i + 1
  }
  particles = keep
}

// ---- Decals ------------------------------------------------------------------

function addHole(x, y, z, nx, ny, nz, ground) {
  holes.push({ x: x + nx * 0.012, y: y + ny * (ground ? 0.025 : 0.012), z: z + nz * 0.012, nx: nx, ny: ny, nz: nz, rot: myRand() * 6.28, size: (ground ? 0.2 : 0.16) + myRand() * 0.08, age: 0, ground: ground })
  if (holes.length > 48) { holes.shift() }
}

function addBlood(x, z, size) {
  bloods.push({ x: x, z: z, rot: myRand() * 6.28, size: size, age: 0 })
  if (bloods.length > 40) { bloods.shift() }
}

function stepDecals() {
  let i = 0
  while (i < holes.length) { holes[i].age = holes[i].age + 1; i = i + 1 }
  i = 0
  while (i < bloods.length) { bloods[i].age = bloods[i].age + 1; i = i + 1 }
  while (holes.length > 0 && holes[0].age > 2400) { holes.shift() }
  while (bloods.length > 0 && bloods[0].age > 3600) { bloods.shift() }
}

function decalObjs(out) {
  let i = 0
  while (i < holes.length) {
    let h = holes[i]
    let fade = h.age > 2200 ? 1 - (h.age - 2200) / 200 : 1
    let rot
    if (h.ny > 0.5) { rot = { x: -Math.PI / 2, y: 0, z: h.rot } }
    else { rot = { x: 0, y: Math.atan2(h.nx, h.nz), z: h.rot } }
    out.push({ id: "hole" + i, type: "plane", position: { x: h.x, y: h.y, z: h.z }, rotation: rot, width: h.size, height: h.size, texture: "bullethole", opacity: fade, castShadow: false, receiveShadow: false })
    i = i + 1
  }
  i = 0
  while (i < bloods.length) {
    let b = bloods[i]
    let grow = Math.min(1, 0.4 + b.age / 20)
    let fade = b.age > 3300 ? 1 - (b.age - 3300) / 300 : 1
    out.push({ id: "blood" + i, type: "plane", position: { x: b.x, y: 0.028 + (i % 5) * 0.002, z: b.z }, rotation: { x: -Math.PI / 2, y: 0, z: b.rot }, width: b.size * grow, height: b.size * grow, texture: "blood", opacity: fade, castShadow: false, receiveShadow: false })
    i = i + 1
  }
}

// ---- Lights and objects ------------------------------------------------------

function buildLights() {
  // The torch rides the camera and flickers a little, as a cheap one would.
  let flicker = 0.9 + 0.1 * Math.sin(bobPhase * 2.3) * Math.sin(bobPhase * 0.7)
  let ls = [
    { id: "torch", type: "spot", attach: "camera", color: flashTicks > 0 ? "#ffd9a0" : "#fff1d0", intensity: (started && torchOn ? 70 * flicker : 0) + (flashTicks > 0 ? 160 : 0), angle: flashTicks > 0 ? 0.62 : 0.4, penumbra: 0.7, distance: 46, decay: 2, position: { x: -0.28, y: -0.05, z: 0.05 } },
    { id: "hemi", type: "hemisphere", color: "#52679a", groundColor: "#161c26", intensity: 1.25 },
    { id: "moon", type: "directional", color: "#9db2ea", intensity: 0.85, position: { x: -60, y: 55, z: -90 } }
  ]
  let i = 0
  while (i < lampPosts.length) {
    let lp = lampPosts[i]
    ls.push({ id: "lp" + i, type: "point", color: "#ffd88a", intensity: 150, decay: 2, position: { x: lp.x, y: 4.2, z: lp.z } })
    i = i + 1
  }
  lights = ls
}

// ---- Bodies ----------------------------------------------------------------------
// Everything below builds in world space from a facing `d`: `f` is forward,
// `r` is right. A part tilted forward by `a` about the creature's own right
// axis needs the XYZ Euler of Ry(d)·Rx(a); `tiltRot` works it out. A limb
// capsule just takes the direction it points along.

function tiltRot(d, a) {
  let sd = Math.sin(d), cd = Math.cos(d), sa = Math.sin(a), ca = Math.cos(a)
  return { x: Math.atan2(sa, cd * ca), y: Math.asin(Math.max(-1, Math.min(1, sd * ca))), z: Math.atan2(-sd * sa, cd) }
}

function dirRot(dx, dy, dz) {
  let l = Math.sqrt(dx * dx + dy * dy + dz * dz) || 1
  let sx = Math.max(-1, Math.min(1, dx / l))
  return { x: Math.atan2(-dz / l, -dy / l), y: 0, z: Math.asin(sx) }
}

// A two-part limb hanging from (x, y, z): the upper part swings forward by
// `a`, the lower part bends on by `e`. Pushes two capsules; returns the end.
function limbObjs(out, id, x, y, z, f, r, side, a, e, len1, len2, rad, color, spread) {
  let sp = spread || 0
  let d1x = f.x * Math.sin(a) + r.x * sp * side
  let d1y = -Math.cos(a)
  let d1z = f.z * Math.sin(a) + r.z * sp * side
  let l1 = Math.sqrt(d1x * d1x + d1y * d1y + d1z * d1z)
  d1x = d1x / l1; d1y = d1y / l1; d1z = d1z / l1
  let a2 = a + e
  let d2x = f.x * Math.sin(a2) + r.x * sp * side
  let d2y = -Math.cos(a2)
  let d2z = f.z * Math.sin(a2) + r.z * sp * side
  let l2 = Math.sqrt(d2x * d2x + d2y * d2y + d2z * d2z)
  d2x = d2x / l2; d2y = d2y / l2; d2z = d2z / l2
  let kx = x + d1x * len1, ky = y + d1y * len1, kz = z + d1z * len1
  let ex = kx + d2x * len2, ey = ky + d2y * len2, ez = kz + d2z * len2
  out.push({ id: id + "u", type: "capsule", position: { x: (x + kx) / 2, y: (y + ky) / 2, z: (z + kz) / 2 }, rotation: dirRot(d1x, d1y, d1z), radius: rad, height: len1 + rad * 2, color: color, roughness: 0.9, castShadow: true })
  out.push({ id: id + "l", type: "capsule", position: { x: (kx + ex) / 2, y: (ky + ey) / 2, z: (kz + ez) / 2 }, rotation: dirRot(d2x, d2y, d2z), radius: rad * 0.85, height: len2 + rad * 1.7, color: color, roughness: 0.9, castShadow: true })
  return { x: ex, y: ey, z: ez, dx: d2x, dy: d2y, dz: d2z }
}

// A zombie. Three builds share one skeleton: a hunched torso, a head that
// lolls, two-part arms that reach, legs that shuffle or drive, and the
// tatters and wounds of a thing that has been dead for a while. Death is a
// fall, not a cut: the body tips forward over a second, then sinks away.
function zombieObjs(out, z) {
  let t = ZTYPES[z.type]
  let s = z.scale
  let d = z.dir
  let f = { x: Math.sin(d), z: Math.cos(d) }
  let r = { x: Math.cos(d), z: -Math.sin(d) }
  let id = "z" + z.id
  let skin = z.flash > 0 ? "#ffffff" : t.body
  let head = z.flash > 0 ? "#ffffff" : t.head
  let cloth = z.flash > 0 ? "#ffffff" : t.cloth
  let runner = z.type === 1
  let brute = z.type === 2
  let swing = Math.sin(z.phase) * (runner ? 0.9 : (brute ? 0.5 : 0.6))
  let bob = Math.abs(Math.sin(z.phase)) * (runner ? 0.06 : 0.025)
  let lean = runner ? 0.55 : (brute ? 0.22 : 0.2)
  let attackPhase = z.state === "attack" ? z.attackTicks / 40 : 0
  if (z.state === "attack") { lean = lean + 0.15 + 0.3 * Math.sin(attackPhase * Math.PI * 2) }
  if (z.stagger > 0) { lean = lean - 0.35 * (z.stagger / 10) }

  // Proportions.
  let hipY = (brute ? 0.95 : 0.85) * s
  let torsoH = (brute ? 0.95 : 0.7) * s
  let torsoW = (brute ? 0.86 : (runner ? 0.44 : 0.52)) * s
  let torsoD = (brute ? 0.5 : 0.3) * s
  let legLen = hipY
  let armRad = (brute ? 0.12 : 0.075) * s
  let legRad = (brute ? 0.14 : 0.095) * s

  // Falling: the whole upper body pivots about the hips toward the ground.
  let fall = 0
  let sink = 0
  if (z.state === "dead") {
    fall = Math.min(1, z.deadTicks / 22)
    sink = Math.max(0, (z.deadTicks - 45) / 45) * 1.6
    lean = lean + (Math.PI / 2 - lean) * (1 - Math.pow(1 - fall, 2.2))
    hipY = hipY * (1 - fall * 0.72)
    bob = 0
    swing = swing * (1 - fall)
  }
  let sy = -sink

  // Torso: hips at (z.x, hipY), chest up and forward by the lean.
  let cx = z.x + f.x * Math.sin(lean) * torsoH * 0.5
  let cy = hipY + Math.cos(lean) * torsoH * 0.5 + bob + sy
  let cz = z.z + f.z * Math.sin(lean) * torsoH * 0.5
  out.push({ id: id + "t", type: "box", position: { x: cx, y: cy, z: cz }, rotation: tiltRot(d, lean), width: torsoW, height: torsoH, depth: torsoD, color: cloth, roughness: 0.95, castShadow: true })
  // Torn shirt hem and a rotten patch through it.
  out.push({ id: id + "w", type: "box", position: { x: cx + f.x * torsoD * 0.52 + r.x * 0.08 * s, y: cy + 0.05 * s, z: cz + f.z * torsoD * 0.52 + r.z * 0.08 * s }, rotation: tiltRot(d, lean), width: torsoW * 0.42, height: torsoH * 0.4, depth: 0.03 * s, color: z.flash > 0 ? "#ffffff" : "#3b0d0d", roughness: 1 })
  if (!runner) {
    out.push({ id: id + "rib", type: "box", position: { x: cx + f.x * torsoD * 0.53 - r.x * 0.12 * s, y: cy + 0.12 * s, z: cz + f.z * torsoD * 0.53 - r.z * 0.12 * s }, rotation: tiltRot(d, lean), width: torsoW * 0.22, height: torsoH * 0.28, depth: 0.025 * s, color: z.flash > 0 ? "#ffffff" : "#c9b8a0", roughness: 1 })
  }
  // Shoulders sit on top of the chest.
  let shY = hipY + Math.cos(lean) * torsoH + bob + sy
  let shX = z.x + f.x * Math.sin(lean) * torsoH
  let shZ = z.z + f.z * Math.sin(lean) * torsoH
  if (brute) {
    // A hump of muscle behind the shoulders, a gut, a rusted breastplate
    // with a chain across it, and spiked pauldrons.
    out.push({ id: id + "hump", type: "sphere", position: { x: shX - f.x * torsoD * 0.35, y: shY - 0.12 * s, z: shZ - f.z * torsoD * 0.35 }, radius: torsoW * 0.42, color: skin, roughness: 0.95, castShadow: true })
    out.push({ id: id + "gut", type: "sphere", position: { x: cx + f.x * torsoD * 0.35, y: cy - torsoH * 0.22, z: cz + f.z * torsoD * 0.35 }, radius: torsoW * 0.36, color: skin, roughness: 0.95, castShadow: true })
    out.push({ id: id + "plate", type: "box", position: { x: cx + f.x * torsoD * 0.6, y: cy + torsoH * 0.12, z: cz + f.z * torsoD * 0.6 }, rotation: tiltRot(d, lean), width: torsoW * 0.8, height: torsoH * 0.5, depth: 0.05 * s, color: "#3f444c", texture: "rust", metalness: 0.7, roughness: 0.45, castShadow: true })
    out.push({ id: id + "strap", type: "box", position: { x: cx - r.x * torsoW * 0.2, y: cy + torsoH * 0.05, z: cz - r.z * torsoW * 0.2 }, rotation: { x: tiltRot(d, lean).x, y: tiltRot(d, lean).y, z: tiltRot(d, lean).z + 0.6 }, width: 0.08 * s, height: torsoH * 1.05, depth: torsoD * 1.06, color: "#1f1a17", roughness: 1 })
    out.push({ id: id + "chain", type: "torus", position: { x: cx + f.x * torsoD * 0.62, y: cy + 0.05 * s, z: cz + f.z * torsoD * 0.62 }, rotation: { x: 0, y: d, z: 0.3 }, radius: 0.22 * s, tube: 0.028 * s, color: "#8b939e", metalness: 0.85, roughness: 0.35 })
    let side = -1
    while (side <= 1) {
      let pxs = shX + r.x * torsoW * 0.62 * side, pzs = shZ + r.z * torsoW * 0.62 * side
      out.push({ id: id + "pl" + side, type: "box", position: { x: pxs, y: shY - 0.02 * s, z: pzs }, rotation: tiltRot(d, lean), width: 0.4 * s, height: 0.24 * s, depth: 0.52 * s, color: "#4b5563", texture: "rust", metalness: 0.65, roughness: 0.5, castShadow: true })
      out.push({ id: id + "sp" + side + "a", type: "cone", position: { x: pxs + r.x * 0.06 * s * side, y: shY + 0.2 * s, z: pzs + r.z * 0.06 * s * side }, rotation: { x: 0, y: 0, z: -0.35 * side }, radius: 0.05 * s, height: 0.24 * s, color: "#2b2f36", metalness: 0.8, roughness: 0.35 })
      out.push({ id: id + "sp" + side + "b", type: "cone", position: { x: pxs + f.x * 0.16 * s, y: shY + 0.16 * s, z: pzs + f.z * 0.16 * s }, rotation: { x: 0, y: 0, z: -0.2 * side }, radius: 0.04 * s, height: 0.18 * s, color: "#2b2f36", metalness: 0.8, roughness: 0.35 })
      side = side + 2
    }
  }

  // Head: forward of the shoulders, hanging a little; a sphere for the
  // walker, a long muzzle for the runner, a heavy jaw for the brute.
  let hn = 0.22 * s
  let hx = shX + f.x * (Math.sin(lean) * hn + (runner ? 0.16 : 0.05) * s)
  let hy = shY + Math.cos(lean) * hn + (runner ? -0.05 : 0.08) * s
  let hz = shZ + f.z * (Math.sin(lean) * hn + (runner ? 0.16 : 0.05) * s)
  let hr = (brute ? 0.26 : (runner ? 0.2 : 0.23)) * s
  if (brute) { hy = hy - 0.1 * s }
  let headTilt = lean * 1.2 + (z.state === "attack" ? -0.2 : 0.15)
  if (!z.headless) {
    out.push({ id: id + "n", type: "cylinder", position: { x: (shX + hx) / 2, y: (shY + hy) / 2, z: (shZ + hz) / 2 }, rotation: tiltRot(d, lean), radius: 0.07 * s, height: hn * 1.2, color: skin, roughness: 0.9 })
    out.push({ id: id + "h", type: "sphere", position: { x: hx, y: hy, z: hz }, rotation: tiltRot(d, headTilt), radius: hr, color: head, roughness: 0.85, castShadow: true })
    if (runner) {
      out.push({ id: id + "mz", type: "box", position: { x: hx + f.x * hr * 0.9, y: hy - hr * 0.25, z: hz + f.z * hr * 0.9 }, rotation: tiltRot(d, headTilt), width: hr * 1.1, height: hr * 0.7, depth: hr * 1.2, color: head, roughness: 0.85 })
      out.push({ id: id + "jaw", type: "box", position: { x: hx + f.x * hr * 0.9, y: hy - hr * 0.62 - 0.02 * Math.sin(z.phase * 2) * s, z: hz + f.z * hr * 0.9 }, rotation: tiltRot(d, headTilt + 0.35), width: hr * 0.9, height: hr * 0.3, depth: hr * 1.1, color: "#3b0d0d", roughness: 1 })
    } else {
      out.push({ id: id + "jaw", type: "box", position: { x: hx + f.x * hr * 0.55, y: hy - hr * 0.72, z: hz + f.z * hr * 0.55 }, rotation: tiltRot(d, headTilt + 0.3 + 0.1 * Math.sin(z.phase * 1.7)), width: hr * 1.2, height: hr * 0.45, depth: hr * 0.9, color: "#2a1515", roughness: 1 })
      out.push({ id: id + "teeth", type: "box", position: { x: hx + f.x * hr * 0.95, y: hy - hr * 0.42, z: hz + f.z * hr * 0.95 }, rotation: tiltRot(d, headTilt), width: hr * 0.8, height: hr * 0.12, depth: 0.03 * s, color: "#e7dcc8" })
    }
    if (brute) {
      // A heavy brow over the eyes, an iron skullcap, and tusks from the jaw.
      out.push({ id: id + "brow", type: "box", position: { x: hx + f.x * hr * 0.55, y: hy + hr * 0.42, z: hz + f.z * hr * 0.55 }, rotation: tiltRot(d, headTilt + 0.2), width: hr * 1.9, height: hr * 0.45, depth: hr * 0.7, color: head, roughness: 0.9, castShadow: true })
      out.push({ id: id + "helm", type: "box", position: { x: hx - f.x * hr * 0.1, y: hy + hr * 0.7, z: hz - f.z * hr * 0.1 }, rotation: tiltRot(d, headTilt), width: hr * 2.1, height: hr * 0.6, depth: hr * 1.9, color: "#1f2937", texture: "rust", metalness: 0.8, roughness: 0.4, castShadow: true })
      out.push({ id: id + "tk1", type: "cone", position: { x: hx + f.x * hr * 0.95 + r.x * hr * 0.4, y: hy - hr * 0.25, z: hz + f.z * hr * 0.95 + r.z * hr * 0.4 }, rotation: { x: 0, y: 0, z: 0 }, radius: hr * 0.12, height: hr * 0.55, color: "#e7dcc8" })
      out.push({ id: id + "tk2", type: "cone", position: { x: hx + f.x * hr * 0.95 - r.x * hr * 0.4, y: hy - hr * 0.25, z: hz + f.z * hr * 0.95 - r.z * hr * 0.4 }, rotation: { x: 0, y: 0, z: 0 }, radius: hr * 0.12, height: hr * 0.55, color: "#e7dcc8" })
    } else if (z.id % 3 === 0) {
      // Hair, what is left of it.
      out.push({ id: id + "hair", type: "sphere", position: { x: hx - f.x * hr * 0.2, y: hy + hr * 0.35, z: hz - f.z * hr * 0.2 }, radius: hr * 0.8, color: z.flash > 0 ? "#ffffff" : "#1c1917", roughness: 1 })
    }
    // Eyes: two coals that catch the torch.
    let ec = runner ? "#ff3b3b" : (brute ? "#ff2a2a" : "#f5e663")
    let ee = runner ? "#ef4444" : (brute ? "#dc2626" : "#eab308")
    let eo = brute ? 0.3 : 0.4
    out.push({ id: id + "e1", type: "sphere", position: { x: hx + f.x * hr * 0.82 + r.x * hr * eo, y: hy + hr * 0.15, z: hz + f.z * hr * 0.82 + r.z * hr * eo }, radius: hr * 0.16, color: ec, emissive: ee, emissiveIntensity: 3.2, castShadow: false })
    out.push({ id: id + "e2", type: "sphere", position: { x: hx + f.x * hr * 0.82 - r.x * hr * eo, y: hy + hr * 0.15, z: hz + f.z * hr * 0.82 - r.z * hr * eo }, radius: hr * 0.16, color: ec, emissive: ee, emissiveIntensity: 3.2, castShadow: false })
  } else {
    // A ragged stump.
    out.push({ id: id + "n", type: "cylinder", position: { x: shX, y: shY + 0.06 * s, z: shZ }, radius: 0.08 * s, height: 0.12 * s, color: "#5a0f12", roughness: 1 })
  }

  // Arms reach for you: raised and forward, the elbows a little bent, the
  // hands opening and closing. The brute's hang heavy and swing.
  let reach = z.state === "attack" ? 1.35 + 0.5 * Math.sin(attackPhase * Math.PI * 2) : (runner ? 1.05 : (brute ? 0.9 : 1.3))
  let bend = runner ? 0.35 : (brute ? 0.55 : 0.25)
  let armL = (brute ? 0.52 : 0.36) * s
  if (brute) { armRad = 0.15 * s }
  let handL = limbObjs(out, id + "aL", shX + r.x * torsoW * 0.5, shY - 0.04 * s, shZ + r.z * torsoW * 0.5, f, r, 1, reach + swing * 0.15 - fall * 0.4, bend + (z.state === "attack" ? 0.2 * Math.sin(attackPhase * 6.28) : 0), armL, armL * 0.95, armRad, skin, 0.12)
  let handR = limbObjs(out, id + "aR", shX - r.x * torsoW * 0.5, shY - 0.04 * s, shZ - r.z * torsoW * 0.5, f, r, -1, reach - swing * 0.15 - fall * 0.4, bend, armL, armL * 0.95, armRad, skin, 0.12)
  if (brute) {
    // Fists like hams, bandaged, and a length of rebar in the right one.
    out.push({ id: id + "fistL", type: "sphere", position: { x: handL.x, y: handL.y, z: handL.z }, radius: 0.13 * s, color: skin, roughness: 0.95, castShadow: true })
    out.push({ id: id + "fistR", type: "sphere", position: { x: handR.x, y: handR.y, z: handR.z }, radius: 0.13 * s, color: skin, roughness: 0.95, castShadow: true })
    out.push({ id: id + "wrapL", type: "cylinder", position: { x: handL.x - handL.dx * 0.16 * s, y: handL.y - handL.dy * 0.16 * s, z: handL.z - handL.dz * 0.16 * s }, rotation: dirRot(handL.dx, handL.dy, handL.dz), radius: 0.135 * s, height: 0.12 * s, color: "#a8a29e", roughness: 1 })
    let cdx = f.x * 0.55 + r.x * 0.2, cdy = 0.8, cdz = f.z * 0.55 + r.z * 0.2
    let cl = Math.sqrt(cdx * cdx + cdy * cdy + cdz * cdz)
    cdx = cdx / cl; cdy = cdy / cl; cdz = cdz / cl
    out.push({ id: id + "club", type: "cylinder", position: { x: handR.x + cdx * 0.3 * s, y: handR.y + cdy * 0.3 * s, z: handR.z + cdz * 0.3 * s }, rotation: dirRot(cdx, cdy, cdz), radius: 0.035 * s, height: 1.1 * s, color: "#5b4a3a", texture: "rust", metalness: 0.7, roughness: 0.6, castShadow: true })
    out.push({ id: id + "clubk", type: "box", position: { x: handR.x + cdx * 0.8 * s, y: handR.y + cdy * 0.8 * s, z: handR.z + cdz * 0.8 * s }, rotation: dirRot(cdx, cdy, cdz), width: 0.16 * s, height: 0.22 * s, depth: 0.16 * s, color: "#3f444c", texture: "rust", metalness: 0.7, roughness: 0.5, castShadow: true })
  }
  // Claws: three small cones off each hand.
  let ci = 0
  while (ci < 3 && !brute) {
    let off = (ci - 1) * 0.045 * s
    out.push({ id: id + "cL" + ci, type: "cone", position: { x: handL.x + handL.dx * 0.06 * s + r.x * off, y: handL.y + handL.dy * 0.06 * s, z: handL.z + handL.dz * 0.06 * s + r.z * off }, rotation: dirRot(-handL.dx, -handL.dy, -handL.dz), radius: 0.012 * s, height: 0.07 * s, color: "#1f1a17" })
    out.push({ id: id + "cR" + ci, type: "cone", position: { x: handR.x + handR.dx * 0.06 * s - r.x * off, y: handR.y + handR.dy * 0.06 * s, z: handR.z + handR.dz * 0.06 * s - r.z * off }, rotation: dirRot(-handR.dx, -handR.dy, -handR.dz), radius: 0.012 * s, height: 0.07 * s, color: "#1f1a17" })
    ci = ci + 1
  }

  // Legs: the walker drags one, the runner drives, the brute stomps.
  let drag = (!runner && !brute) ? 0.25 : 0
  let stride = runner ? 0.85 : (brute ? 0.4 : 0.45)
  let kneeL = Math.max(0, -Math.cos(z.phase)) * (runner ? 1.1 : 0.6)
  let kneeR = Math.max(0, Math.cos(z.phase)) * (runner ? 1.1 : 0.6) + drag
  let legY = hipY + sy
  let legLenU = legLen * 0.52, legLenL = legLen * 0.48
  let footL = limbObjs(out, id + "lL", z.x + r.x * torsoW * 0.28, legY, z.z + r.z * torsoW * 0.28, f, r, 1, swing * stride * (1 - fall) + fall * 0.2, -kneeL * (1 - fall), legLenU, legLenL, legRad, cloth, 0.02)
  let footR = limbObjs(out, id + "lR", z.x - r.x * torsoW * 0.28, legY, z.z - r.z * torsoW * 0.28, f, r, -1, -swing * stride * (1 - fall) + fall * 0.2 - drag * 0.5, -kneeR * (1 - fall), legLenU, legLenL, legRad, cloth, 0.02)
  out.push({ id: id + "fL", type: "box", position: { x: footL.x + f.x * 0.06 * s, y: Math.max(0.04 * s + sy, footL.y - 0.02 * s), z: footL.z + f.z * 0.06 * s }, rotation: { x: 0, y: d, z: 0 }, width: 0.16 * s, height: 0.08 * s, depth: 0.3 * s, color: "#1c1917", roughness: 1 })
  out.push({ id: id + "fR", type: "box", position: { x: footR.x + f.x * 0.06 * s, y: Math.max(0.04 * s + sy, footR.y - 0.02 * s), z: footR.z + f.z * 0.06 * s }, rotation: { x: 0, y: d, z: 0 }, width: 0.16 * s, height: 0.08 * s, depth: 0.3 * s, color: "#1c1917", roughness: 1 })
  if (brute) {
    out.push({ id: id + "shinL", type: "cylinder", position: { x: (footL.x + (z.x + r.x * torsoW * 0.28)) / 2, y: legY * 0.28 + sy, z: (footL.z + (z.z + r.z * torsoW * 0.28)) / 2 }, radius: legRad * 1.15, height: legLen * 0.3, color: "#a8a29e", roughness: 1 })
    out.push({ id: id + "shinR", type: "cylinder", position: { x: (footR.x + (z.x - r.x * torsoW * 0.28)) / 2, y: legY * 0.28 + sy, z: (footR.z + (z.z - r.z * torsoW * 0.28)) / 2 }, radius: legRad * 1.15, height: legLen * 0.3, color: "#a8a29e", roughness: 1 })
  }
  // Rags: a strip of cloth off the hip that swings.
  if (!brute) {
    out.push({ id: id + "rag", type: "box", position: { x: z.x - r.x * torsoW * 0.4 - f.x * 0.05 * s, y: legY - 0.25 * s, z: z.z - r.z * torsoW * 0.4 - f.z * 0.05 * s }, rotation: tiltRot(d, -0.3 + swing * 0.3), width: 0.12 * s, height: 0.5 * s, depth: 0.02 * s, color: cloth, roughness: 1, doubleSided: true })
  }
}

// ---- Weapons in hand ------------------------------------------------------------
// Camera space: x right, y up, z toward the eye (negative is ahead). Both
// guns are held in a right hand with a left hand for support; the parts
// that move (a slide, a magazine, a fore-end, shells) move for real.

function gpart(out, id, x, y, z, w, h, dp, color, extra) {
  let o = { id: id, type: "box", attach: "camera", position: { x: x, y: y, z: z }, width: w, height: h, depth: dp, color: color, roughness: 0.4, metalness: 0.6 }
  if (extra) {
    if (extra.rot) { o.rotation = extra.rot }
    if (extra.type) { o.type = extra.type }
    if (extra.radius !== undefined) { o.radius = extra.radius }
    if (extra.height !== undefined) { o.height = extra.height }
    if (extra.tube !== undefined) { o.tube = extra.tube }
    if (extra.rough !== undefined) { o.roughness = extra.rough }
    if (extra.metal !== undefined) { o.metalness = extra.metal }
    if (extra.texture) { o.texture = extra.texture }
    if (extra.emissive) { o.emissive = extra.emissive; o.emissiveIntensity = extra.emissiveIntensity || 1 }
    if (extra.opacity !== undefined) { o.opacity = extra.opacity }
  }
  out.push(o)
}

// XYZ Euler <-> quaternion, the same conventions as the renderer.
function eulerQuat(x, y, z) {
  let c1 = Math.cos(x / 2), c2 = Math.cos(y / 2), c3 = Math.cos(z / 2)
  let s1 = Math.sin(x / 2), s2 = Math.sin(y / 2), s3 = Math.sin(z / 2)
  return { x: s1 * c2 * c3 + c1 * s2 * s3, y: c1 * s2 * c3 - s1 * c2 * s3, z: c1 * c2 * s3 + s1 * s2 * c3, w: c1 * c2 * c3 - s1 * s2 * s3 }
}
function quatMul(a, b) {
  return { x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y, y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x, z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w, w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z }
}
function quatEuler(q) {
  let x = q.x, y = q.y, z = q.z, w = q.w
  let m11 = 1 - 2 * (y * y + z * z), m12 = 2 * (x * y - w * z), m13 = 2 * (x * z + w * y)
  let m22 = 1 - 2 * (x * x + z * z), m23 = 2 * (y * z - w * x)
  let m32 = 2 * (y * z + w * x), m33 = 1 - 2 * (x * x + y * y)
  let ey = Math.asin(Math.max(-1, Math.min(1, m13)))
  if (Math.abs(m13) < 0.9999999) { return { x: Math.atan2(-m23, m33), y: ey, z: Math.atan2(-m12, m11) } }
  return { x: Math.atan2(m32, m22), y: ey, z: 0 }
}

let SKIN = "#c99a76"
let SLEEVE = "#2f3a33"
let GUNMETAL = "#2c3037"
let GUNDARK = "#16181c"
let WOOD = "#4a2f1a"

// A hand: a rounded palm, a knuckle ridge, three capsule fingers curled
// round whatever is held, a thumb, a wrist and a forearm in a sleeve.
// `curl` 0..1 closes the fingers; `dir` mirrors the thumb for the left hand.
function handObjs(part, id, x, y, z, rot, curl, dir) {
  let sgn = dir || 1
  part(id + "p", x, y, z, 0.048, 0.058, 0.05, SKIN, { rot: rot, rough: 0.85, metal: 0 })
  part(id + "k", x - 0.01 * sgn, y + 0.022, z - 0.02, 0.02, 0.02, 0.02, SKIN, { type: "sphere", radius: 0.017, rot: rot, rough: 0.85, metal: 0 })
  let k = 0
  while (k < 3) {
    part(id + "f" + k, x - 0.026 * sgn, y + 0.02 - k * 0.018, z - 0.022 + curl * 0.008, 0.012, 0.012, 0.012, SKIN, { type: "capsule", radius: 0.0075, height: 0.05, rot: { x: rot.x + 0.2 + 0.5 * curl, y: rot.y, z: rot.z + (1.35 * sgn) }, rough: 0.85, metal: 0 })
    k = k + 1
  }
  part(id + "t", x + 0.022 * sgn, y + 0.03, z - 0.004, 0.012, 0.012, 0.012, SKIN, { type: "capsule", radius: 0.0075, height: 0.04, rot: { x: rot.x + 0.4, y: rot.y, z: rot.z - 0.6 * sgn }, rough: 0.85, metal: 0 })
  part(id + "w", x, y - 0.03, z + 0.03, 0.02, 0.02, 0.02, SKIN, { type: "sphere", radius: 0.019, rot: rot, rough: 0.85, metal: 0 })
}
function armObjs(part, id, x, y, z, rot) {
  part(id, x, y, z, 0.06, 0.06, 0.06, SLEEVE, { type: "capsule", radius: 0.036, height: 0.26, rot: rot, rough: 0.95, metal: 0 })
  part(id + "c", x, y, z, 0.06, 0.06, 0.06, "#1f2724", { type: "cylinder", radius: 0.04, height: 0.03, rot: rot, rough: 1, metal: 0 })
}

function weaponObjs(out) {
  let kick = recoil
  let w = weapons[weaponIdx]
  let rp = reloadTicks > 0 ? 1 - reloadTicks / w.reload : -1
  let moving = (vx * vx + vz * vz) > 1
  let sprinting = moving && !!(window.__dhKeys && window.__dhKeys.sprint)
  // Breathing: a slow figure of eight; walking: a bob in time with the feet.
  let swayX = Math.sin(bobPhase * 0.35) * 0.004 + (moving ? Math.sin(bobPhase) * 0.012 : 0)
  let swayY = Math.sin(bobPhase * 0.7) * 0.003 + (moving ? -Math.abs(Math.cos(bobPhase)) * 0.012 : 0)
  // Swapping: the old one drops out, the new one comes up.
  let rise = 0
  if (swapTicks > 0) { rise = -0.45 * Math.sin((swapTicks / 10) * Math.PI * 0.5) }
  // Whole-gun pose: held low and to the right, turned a touch inward, with
  // recoil (back, up, a twist), a sprint carry, and a tilt while reloading.
  let big = weaponIdx === 1
  let bx = (big ? 0.2 : 0.23) + swayX
  let by = (big ? -0.23 : -0.21) + swayY + kick * 0.14 + rise
  let bz = (big ? -0.5 : -0.46) + kick * 0.45
  let rx = -kick * 1.6
  let ry = (big ? -0.16 : -0.1) + kick * 0.35
  let rz = -0.04 - kick * 0.5
  if (sprinting) { rx = rx + 0.35; ry = ry - 0.3; by = by - 0.06; bx = bx + 0.02 }
  if (rp >= 0) {
    let tilt = Math.sin(Math.min(1, rp * 1.25) * Math.PI)
    rx = rx + (big ? 0.12 : 0.28) * tilt
    ry = ry - (big ? 0.25 : 0.3) * tilt
    rz = rz - (big ? 0.85 : 0.5) * tilt
    by = by + (big ? 0.02 : -0.06) * tilt
    bx = bx - (big ? 0.05 : 0.03) * tilt
  }
  let rot = { x: rx, y: ry, z: rz }
  // Parts are placed in the gun's own frame and rotated by the gun pose, so
  // a tilted gun keeps its slide on top.
  function P(lx, ly, lz) {
    let x1 = lx * Math.cos(rz) - ly * Math.sin(rz), y1 = lx * Math.sin(rz) + ly * Math.cos(rz), z1 = lz
    let x2 = x1 * Math.cos(ry) + z1 * Math.sin(ry), z2 = -x1 * Math.sin(ry) + z1 * Math.cos(ry), y2 = y1
    let y3 = y2 * Math.cos(rx) - z2 * Math.sin(rx), z3 = y2 * Math.sin(rx) + z2 * Math.cos(rx)
    return { x: bx + x2, y: by + y3, z: bz + z3 }
  }
  function part(id, lx, ly, lz, pw, ph, pd, color, extra) {
    let p = P(lx, ly, lz)
    let ex = extra || {}
    if (!ex.rot) { ex.rot = rot }
    gpart(out, id, p.x, p.y, p.z, pw, ph, pd, color, ex)
  }
  // A part turned within the gun's frame: the gun pose times the local turn,
  // composed as quaternions and handed back as the XYZ Euler the engine
  // reads. Adding the angles only works while the gun is level.
  let gq = eulerQuat(rx, ry, rz)
  function R(ax, ay, az) { return quatEuler(quatMul(gq, eulerQuat(ax, ay, az))) }
  // Along the barrel: a cylinder's axis is y, so it lies along z when turned
  // by a quarter turn about x; a ring (torus) around the barrel the same way.
  let ALONG = R(Math.PI / 2, 0, 0)

  if (weaponIdx === 0) {
    // ---- Pistol. Slide with a rounded top rib, rear cocking grooves and an
    // ejection port; frame with a rail and a rounded trigger guard; a grip
    // raked back with chequered panels; a magazine with a baseplate.
    let slideBack = kick * 0.34
    if (rp >= 0 && rp > 0.74) { slideBack = 0.036 * Math.sin((rp - 0.74) / 0.26 * Math.PI) }
    let magY = 0
    let magTilt = 0
    let handDown = 0
    if (rp >= 0) {
      if (rp < 0.32) { let u = rp / 0.32; magY = -0.32 * u * u; magTilt = 0.6 * u; handDown = u }
      else if (rp < 0.68) { let u = (rp - 0.32) / 0.36; magY = -0.32 * (1 - u) * (1 - u); handDown = 1 - u }
      else if (rp < 0.74) { magY = 0.006 * Math.sin((rp - 0.68) / 0.06 * Math.PI) }
    }
    let sb = slideBack
    part("gSlide", 0, 0.03, -0.045 + sb, 0.036, 0.03, 0.21, GUNMETAL, { rough: 0.35, metal: 0.8, texture: "metal" })
    part("gSlideRib", 0, 0.047, -0.045 + sb, 0.02, 0.02, 0.2, GUNMETAL, { type: "cylinder", height: 0.2, radius: 0.011, rot: ALONG, rough: 0.3, metal: 0.85 })
    part("gSlideNose", 0, 0.03, -0.152 + sb, 0.03, 0.03, 0.012, GUNDARK, { type: "cylinder", radius: 0.0125, height: 0.012, rot: ALONG, rough: 0.4, metal: 0.8 })
    part("gPort", 0.0185, 0.036, -0.005 + sb, 0.002, 0.014, 0.04, "#090a0c")
    let k = 0
    while (k < 6) {
      part("gSer" + k, 0.0182, 0.028, 0.02 + k * 0.007 + sb, 0.001, 0.022, 0.0025, "#0c0e11")
      part("gSel" + k, -0.0182, 0.028, 0.02 + k * 0.007 + sb, 0.001, 0.022, 0.0025, "#0c0e11")
      k = k + 1
    }
    part("gBarrel", 0, 0.03, -0.165 + sb * 0.25, 0.014, 0.014, 0.03, "#3b3f47", { type: "cylinder", height: 0.03, radius: 0.0075, rot: ALONG, metal: 0.9, rough: 0.25 })
    part("gMuzzle", 0, 0.03, -0.172, 0.01, 0.01, 0.006, "#050607", { type: "cylinder", height: 0.006, radius: 0.005, rot: ALONG })
    part("gSightF", 0, 0.058, -0.14 + sb, 0.004, 0.008, 0.006, "#4ade80", { emissive: "#22c55e", emissiveIntensity: 1.2, metal: 0 })
    part("gSightR", 0, 0.056, 0.05 + sb, 0.02, 0.006, 0.008, GUNDARK, { metal: 0.8 })
    part("gSightR1", -0.007, 0.06, 0.05 + sb, 0.004, 0.004, 0.004, "#4ade80", { emissive: "#22c55e", emissiveIntensity: 0.8, metal: 0 })
    part("gSightR2", 0.007, 0.06, 0.05 + sb, 0.004, 0.004, 0.004, "#4ade80", { emissive: "#22c55e", emissiveIntensity: 0.8, metal: 0 })
    part("gHammer", 0, 0.03, 0.064 + sb * 0.6, 0.01, 0.01, 0.01, GUNDARK, { type: "capsule", radius: 0.005, height: 0.024, rot: R(-0.4 - sb * 8, 0, 0), metal: 0.8 })
    part("gFrame", 0, 0.004, -0.04, 0.032, 0.024, 0.19, GUNDARK, { rough: 0.55, metal: 0.4 })
    part("gRail", 0, -0.012, -0.1, 0.028, 0.01, 0.06, GUNDARK, { metal: 0.6 })
    part("gRailA", 0, -0.019, -0.115, 0.028, 0.004, 0.006, "#3b3f47", { metal: 0.7 })
    part("gRailB", 0, -0.019, -0.1, 0.028, 0.004, 0.006, "#3b3f47", { metal: 0.7 })
    part("gRailC", 0, -0.019, -0.085, 0.028, 0.004, 0.006, "#3b3f47", { metal: 0.7 })
    part("gGuard", 0, -0.028, 0.0, 0.02, 0.02, 0.02, GUNDARK, { type: "torus", radius: 0.02, tube: 0.004, rot: R(0, Math.PI / 2, 0), metal: 0.5, rough: 0.5 })
    part("gTrig", 0, -0.026, 0.008, 0.005, 0.005, 0.005, "#b8bec8", { type: "capsule", radius: 0.003, height: 0.02, rot: R(0.25 + kick * 3, 0, 0), metal: 0.9, rough: 0.3 })
    part("gGrip", 0, -0.058, 0.048, 0.03, 0.1, 0.044, GUNDARK, { rot: R(0.3, 0, 0), rough: 0.6, metal: 0.3 })
    part("gGripL", -0.0165, -0.056, 0.052, 0.003, 0.078, 0.034, "#3f3a33", { rot: R(0.3, 0, 0), rough: 1, metal: 0, texture: "dots" })
    part("gGripR", 0.0165, -0.056, 0.052, 0.003, 0.078, 0.034, "#3f3a33", { rot: R(0.3, 0, 0), rough: 1, metal: 0, texture: "dots" })
    part("gBeaver", 0, -0.014, 0.08, 0.03, 0.012, 0.028, GUNDARK, { rot: R(0.3, 0, 0), metal: 0.5 })
    // The magazine: seated, falling out, or on its way back in.
    let mz = 0.066 + Math.max(0, -magY) * 0.4
    part("gMag", 0, -0.11 + magY, mz, 0.024, 0.05, 0.036, "#1c1f24", { rot: R(0.3 + magTilt, 0, 0), metal: 0.7, rough: 0.35, texture: "metal" })
    part("gMagB", 0, -0.137 + magY, mz + 0.01, 0.03, 0.008, 0.044, GUNDARK, { rot: R(0.3 + magTilt, 0, 0), metal: 0.6 })
    // Right hand round the grip, forearm off to the lower right.
    handObjs(part, "hR", 0.0, -0.072, 0.062, R(0.3, 0, 0), 1, 1)
    armObjs(part, "aR", 0.045, -0.2, 0.2, R(1.0, -0.2, 0.15))
    // Left hand: cupping the grip, fetching the magazine, or racking the slide.
    if (rp >= 0 && rp < 0.68) {
      let lx = -0.03 - 0.03 * handDown, ly = -0.118 + magY - 0.05 * handDown, lz = 0.07 + 0.05 * handDown
      handObjs(part, "hL", lx, ly, lz, R(0.3 + magTilt * 0.5, 0.3 * handDown, 0.4), 0.6, -1)
      armObjs(part, "aL", lx - 0.07, ly - 0.16, lz + 0.14, R(1.0, 0.3, 0.55))
    } else if (rp >= 0.74) {
      handObjs(part, "hL", -0.012, 0.062, 0.03 + sb, R(0.1, 0, 1.3), 0.9, -1)
      armObjs(part, "aL", -0.09, -0.09, 0.15 + sb, R(0.9, 0.2, 0.7))
    } else {
      handObjs(part, "hL", -0.034, -0.086, 0.066, R(0.3, 0.1, 0.4), 0.8, -1)
      armObjs(part, "aL", -0.11, -0.22, 0.2, R(1.0, 0.1, 0.55))
    }
  } else {
    // ---- Pump shotgun. A rounded receiver with a loading port and ejection
    // port, a barrel under a ringed heat shield, a magazine tube, a ribbed
    // pump, a raked grip and a stock with a side-saddle of hulls.
    let pump = 0
    if (pumpTicks > 0) { pump = 0.085 * Math.sin((1 - pumpTicks / 18) * Math.PI) }
    let need = w.mag - ammo[weaponIdx]
    let total = Math.max(1, Math.min(need, reserve[weaponIdx] > 0 ? reserve[weaponIdx] : 1))
    let shellProg = -1
    if (rp >= 0) {
      let loadSpan = 0.78
      if (rp < loadSpan) { shellProg = (rp / loadSpan * total) % 1 }
      else { pump = 0.085 * Math.sin((rp - loadSpan) / 0.22 * Math.PI) }
    }
    part("sRecv", 0, 0.0, 0.03, 0.046, 0.056, 0.22, GUNMETAL, { rough: 0.35, metal: 0.8, texture: "metal" })
    part("sRecvTop", 0, 0.02, 0.05, 0.02, 0.02, 0.16, GUNMETAL, { type: "cylinder", height: 0.16, radius: 0.017, rot: ALONG, rough: 0.3, metal: 0.85 })
    part("sEject", 0.0235, 0.008, -0.02, 0.002, 0.026, 0.06, "#090a0c")
    part("sLoad", 0, -0.029, 0.0, 0.026, 0.002, 0.06, "#090a0c")
    part("sBarrel", 0, 0.026, -0.33, 0.02, 0.02, 0.5, "#23262b", { type: "cylinder", height: 0.5, radius: 0.011, rot: ALONG, metal: 0.85, rough: 0.3 })
    part("sMuzzle", 0, 0.026, -0.582, 0.02, 0.02, 0.012, GUNDARK, { type: "cylinder", height: 0.012, radius: 0.0125, rot: ALONG, metal: 0.8 })
    part("sBore", 0, 0.026, -0.589, 0.01, 0.01, 0.004, "#050607", { type: "cylinder", height: 0.004, radius: 0.0085, rot: ALONG })
    let k = 0
    part("sShield", 0, 0.026, -0.27, 0.02, 0.02, 0.22, "#33373e", { type: "cylinder", height: 0.22, radius: 0.0145, rot: ALONG, metal: 0.8, rough: 0.35 })
    while (k < 6) { part("sSlot" + k, 0, 0.042, -0.19 - k * 0.03, 0.007, 0.004, 0.016, "#0a0b0d"); part("sSlotR" + k, 0.0125, 0.03, -0.19 - k * 0.03, 0.004, 0.006, 0.016, "#0a0b0d"); k = k + 1 }
    part("sTube", 0, -0.008, -0.3, 0.02, 0.02, 0.44, "#2a2d33", { type: "cylinder", height: 0.44, radius: 0.0115, rot: ALONG, metal: 0.8, rough: 0.35 })
    part("sTubeCap", 0, -0.008, -0.522, 0.02, 0.02, 0.014, "#3b3f47", { type: "cylinder", height: 0.014, radius: 0.014, rot: ALONG, metal: 0.85 })
    part("sFore", 0, -0.008, -0.24 + pump, 0.05, 0.05, 0.16, WOOD, { type: "cylinder", radius: 0.024, height: 0.15, rot: ALONG, rough: 0.8, metal: 0.05, texture: "wood" })
    k = 0
    while (k < 5) { part("sRib" + k, 0, -0.008, -0.29 + k * 0.025 + pump, 0.02, 0.02, 0.02, "#2a1a0e", { type: "torus", radius: 0.024, tube: 0.0025, rot: R(0, 0, 0), rough: 0.9, metal: 0 }); k = k + 1 }
    part("sBead", 0, 0.04, -0.575, 0.006, 0.006, 0.006, "#fbbf24", { type: "sphere", radius: 0.004, emissive: "#fbbf24", emissiveIntensity: 1.2, metal: 0 })
    part("sGuard", 0, -0.036, 0.055, 0.02, 0.02, 0.02, GUNDARK, { type: "torus", radius: 0.022, tube: 0.004, rot: R(0, Math.PI / 2, 0), metal: 0.5, rough: 0.5 })
    part("sTrig", 0, -0.03, 0.06, 0.005, 0.005, 0.005, "#b8bec8", { type: "capsule", radius: 0.003, height: 0.022, rot: R(0.25 + kick * 3, 0, 0), metal: 0.9, rough: 0.3 })
    part("sGripW", 0, -0.046, 0.125, 0.038, 0.075, 0.06, WOOD, { rot: R(0.55, 0, 0), rough: 0.8, metal: 0.05, texture: "wood" })
    part("sStock", 0, -0.03, 0.245, 0.04, 0.078, 0.2, WOOD, { rot: R(0.16, 0, 0), rough: 0.8, metal: 0.05, texture: "wood" })
    part("sStockTop", 0, 0.008, 0.2, 0.038, 0.02, 0.12, WOOD, { rot: R(0.05, 0, 0), rough: 0.8, metal: 0.05, texture: "wood" })
    part("sPad", 0, -0.04, 0.35, 0.042, 0.09, 0.018, "#1c1917", { rot: R(0.16, 0, 0), rough: 1, metal: 0 })
    part("sSaddle", 0.024, -0.02, 0.24, 0.006, 0.03, 0.14, GUNDARK, { rot: R(0.16, 0, 0), metal: 0.6 })
    let held = Math.min(4, Math.max(0, reserve[weaponIdx]))
    k = 0
    while (k < 4) {
      let col = k < held ? "#b91c1c" : "#2a2d33"
      part("sSad" + k, 0.03, -0.02, 0.195 + k * 0.03, 0.02, 0.02, 0.02, col, { type: "cylinder", radius: 0.0095, height: 0.058, rot: R(Math.PI / 2 + 0.16, 0, 0), rough: 0.6, metal: 0.2 })
      if (k < held) { part("sSadB" + k, 0.03, -0.02, 0.222 + k * 0.03, 0.02, 0.02, 0.02, "#d4a72c", { type: "cylinder", radius: 0.0098, height: 0.012, rot: R(Math.PI / 2 + 0.16, 0, 0), rough: 0.3, metal: 0.8 }) }
      k = k + 1
    }
    // Right hand on the grip, forearm off to the lower right; left hand on
    // the pump, or bringing a hull up in an arc and pushing it into the port.
    handObjs(part, "hR", 0.0, -0.064, 0.118, R(0.55, 0, 0), 1, 1)
    armObjs(part, "aR", 0.05, -0.19, 0.27, R(0.95, -0.2, 0.15))
    if (shellProg >= 0) {
      let lift = Math.min(1, shellProg / 0.55)
      let push = Math.max(0, (shellProg - 0.55) / 0.45)
      let sy0 = -0.2 + 0.15 * Math.sin(lift * Math.PI * 0.5) + push * 0.02
      let sx0 = 0.075 - push * 0.075
      let sz0 = 0.02
      if (push < 0.95) {
        part("sShell", sx0, sy0, sz0, 0.02, 0.02, 0.02, "#b91c1c", { type: "cylinder", radius: 0.0095, height: 0.058, rot: ALONG, rough: 0.6, metal: 0.2 })
        part("sShellB", sx0, sy0, sz0 + 0.028, 0.02, 0.02, 0.02, "#d4a72c", { type: "cylinder", radius: 0.0098, height: 0.012, rot: ALONG, rough: 0.3, metal: 0.8 })
      }
      handObjs(part, "hL", sx0 + 0.006, sy0 - 0.036, sz0 - 0.03, R(0.2, 0, 0.5), 0.7, -1)
      armObjs(part, "aL", sx0 - 0.06, sy0 - 0.19, sz0 + 0.1, R(1.0, 0.2, 0.5))
    } else {
      handObjs(part, "hL", -0.004, -0.046, -0.235 + pump, R(0.15, 0, 0.15), 0.9, -1)
      armObjs(part, "aL", -0.07, -0.17, -0.09 + pump, R(0.8, 0, 0.4))
    }
  }
  if (flashTicks > 0) {
    let m = P(0, big ? 0.026 : 0.03, big ? -0.6 : -0.19)
    out.push({ id: "flash", type: "sphere", attach: "camera", position: { x: m.x, y: m.y, z: m.z }, radius: big ? 0.09 : 0.05, color: "#fff2b0", emissive: "#ffd27a", emissiveIntensity: 4, opacity: 0.9 })
    out.push({ id: "flash2", type: "cone", attach: "camera", position: { x: m.x, y: m.y, z: m.z - (big ? 0.12 : 0.08) }, rotation: { x: -Math.PI / 2 + rx, y: ry, z: rz }, radius: big ? 0.06 : 0.035, height: big ? 0.26 : 0.16, color: "#ffe28a", emissive: "#ffb347", emissiveIntensity: 3, opacity: 0.7 })
    out.push({ id: "flash3", type: "sphere", attach: "camera", position: { x: m.x, y: m.y, z: m.z - 0.02 }, radius: big ? 0.16 : 0.1, color: "#ffb347", emissive: "#ff8c2a", emissiveIntensity: 1.5, opacity: 0.25 })
  }
}

function composeObjects() {
  let out = []
  if (started) { weaponObjs(out) }
  decalObjs(out)
  let i = 0
  while (i < zombies.length) { zombieObjs(out, zombies[i]); i = i + 1 }
  if (!started) { i = 0; while (i < showcase.length) { zombieObjs(out, showcase[i]); i = i + 1 } }
  i = 0
  while (i < pickups.length) {
    let p = pickups[i]
    let bobY = 0.35 + Math.sin(p.age * 0.12) * 0.06
    if (p.kind === "shells") {
      out.push({ id: "pk" + p.id, type: "box", position: { x: p.x, y: bobY, z: p.z }, rotation: { x: 0, y: p.age * 0.03, z: 0 }, width: 0.42, height: 0.28, depth: 0.3, color: "#b23a2a", emissive: "#ff6b3d", emissiveIntensity: 0.5, texture: "wood" })
      out.push({ id: "pk" + p.id + "l", type: "box", position: { x: p.x, y: bobY + 0.02, z: p.z }, rotation: { x: 0, y: p.age * 0.03, z: 0 }, width: 0.44, height: 0.06, depth: 0.32, color: "#fde68a", emissive: "#fbbf24", emissiveIntensity: 0.8 })
    } else {
      out.push({ id: "pk" + p.id, type: "box", position: { x: p.x, y: bobY, z: p.z }, rotation: { x: 0, y: p.age * 0.03, z: 0 }, width: 0.4, height: 0.24, depth: 0.32, color: "#f2f5f8", emissive: "#4ade80", emissiveIntensity: 0.45 })
      out.push({ id: "pk" + p.id + "x", type: "box", position: { x: p.x, y: bobY + 0.125, z: p.z }, rotation: { x: 0, y: p.age * 0.03, z: 0 }, width: 0.22, height: 0.02, depth: 0.06, color: "#dc2626", emissive: "#dc2626", emissiveIntensity: 0.8 })
      out.push({ id: "pk" + p.id + "y", type: "box", position: { x: p.x, y: bobY + 0.125, z: p.z }, rotation: { x: 0, y: p.age * 0.03, z: 0 }, width: 0.06, height: 0.02, depth: 0.22, color: "#dc2626", emissive: "#dc2626", emissiveIntensity: 0.8 })
    }
    // A soft ring of light on the ground under it.
    out.push({ id: "pk" + p.id + "r", type: "ring", position: { x: p.x, y: 0.03, z: p.z }, rotation: { x: -Math.PI / 2, y: 0, z: 0 }, radius: 0.5 + 0.05 * Math.sin(p.age * 0.12), color: p.kind === "shells" ? "#ff6b3d" : "#4ade80", emissive: p.kind === "shells" ? "#ff6b3d" : "#4ade80", emissiveIntensity: 0.9, opacity: 0.35, castShadow: false })
    i = i + 1
  }
  i = 0
  while (i < particles.length) {
    let p = particles[i]
    if (p.casing) {
      out.push({ id: "p" + i, type: "cylinder", position: { x: p.x, y: p.y, z: p.z }, rotation: { x: Math.PI / 2 + (p.rot || 0), y: (p.rot || 0) * 0.7, z: 0 }, radius: p.size * 0.5, height: p.size * p.tall, color: p.color, metalness: 0.8, roughness: 0.3 })
    } else if (p.chunk) {
      out.push({ id: "p" + i, type: "sphere", position: { x: p.x, y: p.y, z: p.z }, rotation: { x: (p.rot || 0), y: (p.rot || 0) * 1.3, z: 0 }, radius: p.size * 0.5, color: p.color, roughness: 0.9, castShadow: true })
    } else {
      out.push({ id: "p" + i, type: "box", position: { x: p.x, y: p.y, z: p.z }, width: p.size, height: p.size, depth: p.size, color: p.color, roughness: 1 })
    }
    i = i + 1
  }
  objects = out
}

// ---- Leaderboard and input from the UI --------------------------------------

function onSceneClick(hit) {
  if (!started || paused || gameOver) { return }
  if (hit && hit.locked) {
    if (hit.button === 0) { window.__dhFire = true }
    else if (hit.button === 2) { window.__dhReload = true }
  } else if (touchMode) {
    window.__dhFire = true
  }
}

function padPress(dir) {
  let k = window.__dhKeys
  if (dir === "up") { k.w = true } else if (dir === "down") { k.s = true } else if (dir === "left") { k.a = true } else if (dir === "right") { k.d = true }
}
function padRelease(dir) {
  let k = window.__dhKeys
  if (dir === "up") { k.w = false } else if (dir === "down") { k.s = false } else if (dir === "left") { k.a = false } else if (dir === "right") { k.d = false }
}
function touchFire() { window.__dhFire = true }
function touchReload() { window.__dhReload = true }
function touchSwap() { window.__dhSwap = 2 }
function touchTorch() { window.__dhSwap = 4 }

function setFinalName(v) {
  finalName = String(v).slice(0, 24)
  try { localStorage.setItem("deadhours:name", finalName) } catch (err) {}
}

function postScore() {
  if (scorePosted || score <= 0) { return }
  scorePosted = true
  let name = finalName.trim() === "" ? "Anonymous" : finalName.trim()
  boardStatus = "Posting…"
  softn.storage.insert("scores", { name: name, score: score, wave: wave, kills: kills }, function (r) {
    if (r && r.error) { boardStatus = r.error; scorePosted = false; return }
    loadBoard()
  })
}

function loadBoard() {
  softn.storage.query("scores", { orderBy: ["score", "desc"], limit: 10 }, function (r) {
    if (!r || r.error) {
      boardRows = []
      boardStatus = r && r.error ? r.error : "The leaderboard is not available."
      return
    }
    let rows = []
    let i = 0
    while (i < r.records.length) {
      let rec = r.records[i]
      rows.push({ rank: i + 1, name: rec.data.name, score: rec.data.score, wave: rec.data.wave })
      i = i + 1
    }
    boardRows = rows
    boardStatus = rows.length === 0 ? "No scores yet. Be the first to survive a night." : ""
  })
}
